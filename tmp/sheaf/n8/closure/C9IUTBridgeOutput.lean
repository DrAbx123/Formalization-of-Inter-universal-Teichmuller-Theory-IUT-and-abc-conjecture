import LeanFormal.IUT.IUTIII.Theorem311.SourceTheorem311ReferenceContract
import Mathlib.Data.Set.Basic

/-!
# C9/IUT bridge: actual Theorem 3.11 output to bridge possible outputs

This file replaces the arbitrary Output type of the old
C9Cor312ThreeAssumptions package by the actual project declarations:

* Theorem311Source.Theorem311Output R.input (the assembled theorem output);
* Theorem311Source.SourceTheorem311Layers B (the T1/T2/T3 layers);
* Theorem311Source.SourceTheorem311ReferenceOutput B (the source-facing
  reference output contract).

There is no arbitrary Output : Type field and no arbitrary logVol field here.
The bridge possible-output set is generated from the actual reference output.
This is deliberately only the reference output class, not the full multiradial
possible-image family (the project has no such output-valued set).

qPilotOutput membership is not available from these declarations. It is
therefore an explicit C1SourceBridge field, not a hidden field and not an
axiom: the bridge is conditional on the C1/xi-f q-pilot-as-output statement.
No sorry and no axiom is used in this file.
-/

noncomputable section
set_option relaxedAutoImplicit false

namespace LeanFormal.IUT.N8Closure.C9IUTBridgeOutput

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open OriginalInput
open SourceHodgeTheaterBridge
open scoped BigOperators

universe u v w uv upi umon ui ux uy

variable {l : PrimeGeFive} {V : Type uv}
variable {Label : Type u} {Choice : Type v}
variable [AddGroup Label] [Preorder Choice]
variable {I : OriginalInput.{u, uv, upi, umon, ui} l V}
variable {R : SourceTheorem311Realization.{u, v, w} l Label Choice}
variable {P : H2SpokePermutation I}
variable {X : Type ux} {Y : Type uy}
variable [CommMonoid X] [CommMonoid Y]
variable {W : SourceInternalWiring I R P X Y}
variable {S : SourceP1P2Input (I := I) (R := R) (P := P)
  (X := X) (Y := Y) W}
variable {B : SourceP1P2Bundle W S}

/-! ## The actual output carrier -/

/-- The actual Theorem 3.11 output type, not an arbitrary Output : Type. -/
abbrev ActualOutput (R : SourceTheorem311Realization.{u, v, w} l Label Choice) :
    Type _ :=
  Theorem311Output R.input

/-- The bridge possible-output set generated by one actual output. -/
def bridgePossibleOutputs (out : ActualOutput R) : Set (ActualOutput R) :=
  Set.singleton out

/-- The source possible log-volume images, read from the actual profile.
This is the real-valued possible-image data of the project; it is not an
output-valued set. -/
def sourcePossibleLogVolumes
    (R : SourceTheorem311Realization.{u, v, w} l Label Choice) : Set Real :=
  {x | ∃ c : Choice, x ∈ R.input.profile.possibleImage c}

/-! ## Explicit q-pilot-as-output obligation -/

/-- The explicit C1/xi-f bridge: some actual output is a possible output.
This structure records exactly the missing q-pilot-as-output membership.
It is a parameter/field, not an axiom and not a theorem of the three source
assumptions. -/
structure C1SourceBridge (possibleOutputs : Set (ActualOutput R)) where
  qPilotOutput : ActualOutput R
  qPilotOutput_mem : qPilotOutput ∈ possibleOutputs

/-! ## The bridge structure -/

/-- Bridge from the actual Theorem 3.11 reference/layer outputs to the
possible-output field. All three output declarations are identified, and the
possible-output set is the actual reference-output singleton. -/
structure BridgeOutput where
  layers : SourceTheorem311Layers B
  reference : SourceTheorem311ReferenceOutput B
  out : ActualOutput R
  out_eq_layers : out = layers.output
  out_eq_reference : out = reference.output
  possibleOutputs : Set (ActualOutput R)
  possibleOutputs_eq : possibleOutputs = bridgePossibleOutputs out
  /-- The unsupported q-pilot-as-output membership, kept explicit. -/
  qPilotAsOutput : C1SourceBridge possibleOutputs

/-! ## Exact mapping theorems -/

theorem out_eq_layers_output (b : BridgeOutput (B := B)) :
    b.out = b.layers.output :=
  b.out_eq_layers

theorem out_eq_reference_output (b : BridgeOutput (B := B)) :
    b.out = b.reference.output :=
  b.out_eq_reference

theorem possibleOutputs_eq_singleton (b : BridgeOutput (B := B)) :
    b.possibleOutputs = Set.singleton b.out :=
  b.possibleOutputs_eq

theorem out_mem_possibleOutputs (b : BridgeOutput (B := B)) :
    b.out ∈ b.possibleOutputs := by
  rw [b.possibleOutputs_eq]
  exact Set.mem_singleton b.out

theorem qPilot_mem_possibleOutputs (b : BridgeOutput (B := B)) :
    b.qPilotAsOutput.qPilotOutput ∈ b.possibleOutputs :=
  b.qPilotAsOutput.qPilotOutput_mem

end LeanFormal.IUT.N8Closure.C9IUTBridgeOutput

end

import Mathlib.Algebra.Module.Submodule.Basic
import Mathlib.Analysis.Normed.Field.Basic
import Mathlib.NumberTheory.Padics.PadicNumbers

/-!
# Conditional H_A-full / B=O_K and 1-in-U statements

Task-225 abstract Lean skeleton.  The file formalizes:

- a Q_p-vector space `K` with additive lattice `O` and a family of Q_p-linear
  automorphisms; `H_A-full` means every automorphism maps `O` onto itself,
  and `B` is the additive subgroup generated by all such images;  hence
  `H_A-full => B = O`;
- a decomposition `1 = u0 + w0`, `u0 in U`, `w0 in W`, `U` and `W`
  complementary, and `a(A)=u0 + A w0`; if `1 in U` then `w0=0`, `a(A)=1`,
  `H_A-full` holds (all `a(A)` are in `O` when `1 in O`), and `B=O` for the
  induced `a`-span;
- underdetermination: for `w0 != 0`, different `A` on `W` give different
  `a(A)`; this is the abstract linear-algebra obstruction, not a claim about
  the actual Galois action.

No axiom or sorry is used.
-/

noncomputable section
set_option maxHeartbeats 1000000
set_option relaxedAutoImplicit false

namespace LeanFormal.IUT.N8Closure.C9HAFullConditional

universe u

section LatticeAction

variable {p : ℕ} [Fact p.Prime]
variable {K : Type*} [AddCommGroup K] [Module ℚ_[p] K]

/-- The additive subgroup generated by the images of a lattice `O` under a
family of Q_p-linear automorphisms. -/
noncomputable def B (G : Set (K ≃ₗ[ℚ_[p]] K)) (O : AddSubgroup K) : AddSubgroup K :=
  AddSubgroup.closure (⋃ g ∈ G, (g '' (O : Set K)))

/-- Abstract H_A-full: every automorphism in the family preserves `O`. -/
def HA_full (G : Set (K ≃ₗ[ℚ_[p]] K)) (O : AddSubgroup K) : Prop :=
  ∀ g ∈ G, g '' (O : Set K) = (O : Set K)

theorem HA_full_implies_B_eq (G : Set (K ≃ₗ[ℚ_[p]] K)) (O : AddSubgroup K)
    (hid : (1 : K ≃ₗ[ℚ_[p]] K) ∈ G)
    (h : HA_full G O) : B G O = O := by
  have hunion : (⋃ g ∈ G, (g '' (O : Set K))) = (O : Set K) := by
    ext x
    constructor
    · intro hx
      rcases Set.mem_iUnion.mp hx with ⟨g, hx'⟩
      rcases Set.mem_iUnion.mp hx' with ⟨hg, hxg⟩
      rw [h g hg] at hxg
      exact hxg
    · intro hx
      exact Set.mem_iUnion.mpr ⟨1, Set.mem_iUnion.mpr ⟨hid, by simpa using hx⟩⟩
  unfold B
  rw [hunion]
  exact le_antisymm
    ((AddSubgroup.closure_le O).mpr (by intro x hx; exact hx))
    AddSubgroup.subset_closure

end LatticeAction

section DecompositionData

/-- Abstract module/lattice data for the decomposition `1 = u0 + w0`. -/
structure DecompData (p : ℕ) [Fact p.Prime] where
  K : Type u
  [addCommGroup : AddCommGroup K]
  [module : Module ℚ_[p] K]
  one : K
  u0 : K
  w0 : K
  U : Submodule ℚ_[p] K
  W : Submodule ℚ_[p] K
  O : AddSubgroup K
  J : AddSubgroup K
  hone : one = u0 + w0
  hu0 : u0 ∈ U
  hw0 : w0 ∈ W
  hdisj : U ⊓ W = ⊥

attribute [instance] DecompData.addCommGroup DecompData.module

variable {p : ℕ} [Fact p.Prime] (D : DecompData p)

/-- The component `a(A) = u0 + A w0`. -/
noncomputable def a (A : D.W →ₗ[ℚ_[p]] D.W) : D.K :=
  D.u0 + (A ⟨D.w0, D.hw0⟩ : D.K)

theorem w0_eq_zero_of_one_mem_U (h1 : D.one ∈ D.U) : D.w0 = 0 := by
  have hone_sub : D.one - D.u0 = D.w0 := by
    rw [D.hone]
    abel
  have hwU : D.w0 ∈ D.U := by
    rw [← hone_sub]
    exact D.U.sub_mem h1 D.hu0
  have hmem : D.w0 ∈ D.U ⊓ D.W := ⟨hwU, D.hw0⟩
  rw [D.hdisj] at hmem
  simpa using hmem

theorem w0_ne_zero_of_one_not_mem_U (h1 : D.one ∉ D.U) : D.w0 ≠ 0 := by
  intro hzero
  apply h1
  rw [D.hone, hzero, add_zero]
  exact D.hu0

theorem a_eq_one_of_one_mem_U (h1 : D.one ∈ D.U)
    (A : D.W →ₗ[ℚ_[p]] D.W) : a D A = D.one := by
  have hw : D.w0 = 0 := w0_eq_zero_of_one_mem_U D h1
  have hsub : (⟨D.w0, D.hw0⟩ : D.W) = 0 := by
    ext
    exact hw
  have hA : A ⟨D.w0, D.hw0⟩ = 0 := by
    rw [hsub]
    exact map_zero A
  unfold a
  rw [hA]
  simp [D.hone, hw]

theorem a_mem_O_of_one_mem_U (h1 : D.one ∈ D.U) (honeO : D.one ∈ D.O)
    (A : D.W →ₗ[ℚ_[p]] D.W) : a D A ∈ D.O :=
  (a_eq_one_of_one_mem_U D h1 A) ▸ honeO

theorem HA_full_a_of_one_mem_U (h1 : D.one ∈ D.U) (honeO : D.one ∈ D.O) :
    ∀ A : D.W →ₗ[ℚ_[p]] D.W, a D A ∈ D.O :=
  fun A => a_mem_O_of_one_mem_U D h1 honeO A

/-- The span generated by the `a(A)` and `J`. -/
noncomputable def B_from_a : AddSubgroup D.K :=
  AddSubgroup.closure ((Set.range (fun A : D.W →ₗ[ℚ_[p]] D.W => a D A)) ∪ (D.J : Set D.K))

theorem B_from_a_eq_O_of_one_mem_U (h1 : D.one ∈ D.U)
    (hO : D.O = AddSubgroup.closure (({D.one} : Set D.K) ∪ (D.J : Set D.K))) :
    B_from_a D = D.O := by
  have hrange : Set.range (fun A : D.W →ₗ[ℚ_[p]] D.W => a D A) =
      ({D.one} : Set D.K) := by
    ext x
    constructor
    · rintro ⟨A, rfl⟩
      exact Set.mem_singleton_iff.mpr (a_eq_one_of_one_mem_U D h1 A)
    · intro hx
      rw [Set.mem_singleton_iff] at hx
      subst x
      exact ⟨0, a_eq_one_of_one_mem_U D h1 0⟩
  unfold B_from_a
  rw [hrange]
  rw [hO]

theorem underdetermination_of_w0_ne_zero (hw : D.w0 ≠ 0) :
    ∃ A A' : D.W →ₗ[ℚ_[p]] D.W, a D A ≠ a D A' := by
  refine ⟨0, (2 : ℚ_[p]) • (1 : D.W →ₗ[ℚ_[p]] D.W), ?_⟩
  intro hEq
  have hzero : (2 : ℚ_[p]) • D.w0 = 0 := by
    have h' : D.u0 + ((0 : D.W →ₗ[ℚ_[p]] D.W) ⟨D.w0, D.hw0⟩ : D.K) =
        D.u0 + (((2 : ℚ_[p]) • (1 : D.W →ₗ[ℚ_[p]] D.W)) ⟨D.w0, D.hw0⟩ : D.K) := hEq
    simpa using h'
  have h2 : (2 : ℚ_[p]) ≠ 0 := by norm_num
  rcases smul_eq_zero.mp hzero with h2z | hwz
  · exact h2 h2z
  · exact hw hwz

theorem underdetermination_of_one_not_mem_U (h1 : D.one ∉ D.U) :
    ∃ A A' : D.W →ₗ[ℚ_[p]] D.W, a D A ≠ a D A' :=
  underdetermination_of_w0_ne_zero D (w0_ne_zero_of_one_not_mem_U D h1)

end DecompositionData

end LeanFormal.IUT.N8Closure.C9HAFullConditional

end
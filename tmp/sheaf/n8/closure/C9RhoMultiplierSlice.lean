import LeanFormal.IUT.IUTII.Frobenioid.Example36SourceVerticalRationalCarrier\n\nnamespace LeanFormal.IUT.IUTII.Frobenioid.Example36\n\nnoncomputable section\n\n/-- The actual source rho normalization turns a rational multiplier exponent\n    difference into an exact signed readout shift.  This is a local value-group\n    theorem; it does not identify a q-pilot with a final-evaluation output. -/\ntheorem sourceRhoLogVolume_multiplier_shift\n    {F F' : Type} [Field F] [NumberField F] [Field F'] [NumberField F']\n    {D : GlobalPlaceData F} {D' : GlobalPlaceData F'}\n    (T : PlaceLocalizationTransport D D') (w : HeightOneSpectrum (𝓞 F'))\n    (r₁ r₂ : Rat) :\n    (sourceRhoLogVolume (F := F) T w (Multiplicative.ofAdd r₁)).toAdd -\n        (sourceRhoLogVolume (F := F) T w (Multiplicative.ofAdd r₂)).toAdd =\n      relativeLocalDegree (F := F) T w * sourceResidueLog (F := F) T w *\n        (((r₁ - r₂ : Rat) : Real)) := by\n  rw [sourceRhoLogVolume_apply, sourceRhoLogVolume_apply]\n  push_cast\n  ring\n\n/-- In upper-place coordinates the same shift is ramification times the\n    upper residue log, so no candidate `1/[K_w:F_v]` normalization is used. -/\ntheorem sourceRhoLogVolume_multiplier_shift_upper\n    {F F' : Type} [Field F] [NumberField F] [Field F'] [NumberField F']\n    {D : GlobalPlaceData F} {D' : GlobalPlaceData F'}\n    (T : PlaceLocalizationTransport D D') (w : HeightOneSpectrum (𝓞 F'))\n    (r₁ r₂ : Rat) :\n    (sourceRhoLogVolume (F := F) T w (Multiplicative.ofAdd r₁)).toAdd -\n        (sourceRhoLogVolume (F := F) T w (Multiplicative.ofAdd r₂)).toAdd =\n      (T.ramificationIndex w : Real) *\n        Real.log ((finitePlaceResidueCardinality (F := F') w : ℕ) : Real) *\n          (((r₁ - r₂ : Rat) : Real)) := by\n  rw [sourceRhoLogVolume_multiplier_shift, relativeLocalDegree_mul_sourceResidueLog_eq]\n\nend\nend LeanFormal.IUT.IUTII.Frobenioid.Example36\n
import tmp.sheaf.n8.closure.P6AdmActualAttempt
import tmp.sheaf.n8.closure.P6HullActual
import Mathlib

/-!
# P6 Stp4 admissibility attempt

The H-admissibility predicate from P6AdmActualAttempt satisfies the exact
ActualP6AdmOutData interface, but it only says nonempty + contained in the
source hull.  The paper Stp4 condition additionally requires that every
admissible region comes from the source output construction (a union of source
output regions, or the hull itself).  This file records that stronger exact
target as PaperStp4AdmOutDonor with one named gap.

It does not claim H-admissibility equals paper Stp4 admissibility.
-/

noncomputable section

namespace LeanFormal.IUT.N8Closure.P6HullStp4Attempt

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open ABCBridge.N8.C4Actual
open LeanFormal.IUT.N8Closure.C7SourceU
open LeanFormal.IUT.N8Closure.P6Hull
open LeanFormal.IUT.N8Closure.P6HullActual
open LeanFormal.IUT.N8Closure.P6AdmActualAttempt

universe ua uv upi umon ui uL

variable {l : PrimeGeFive} {V : Type uv}
variable {I : OriginalInput.{ua, uv, upi, umon, ui} l V}
variable {Label : Type uL} [Group Label]
variable (D : SourceWitnessedOutputData (l := l) (V := V) I Label)
variable (n : ThetaPilotCarrier l)
variable (x : I.ThetaPilotPoint D.place.v)

/-- Exact stronger Stp4 donor target: an admissibility predicate containing
all actual source output singletons and the actual source hull, and whose
admissible regions are generated by source output regions (a union of a
subfamily of sourceR) or are the source hull itself. -/
def PaperStp4AdmOutDonor : Prop :=
  ∃ adm_out : Set (SourceCarrier (D := D)) → Prop,
    (∀ w : SourceAlpha (D := D) n x, adm_out (sourceR (D := D) n x w)) ∧
    adm_out (sourcePaperHull (D := D) n) ∧
    (∀ R : Set (SourceCarrier (D := D)), adm_out R → R.Nonempty) ∧
    (∀ R : Set (SourceCarrier (D := D)), adm_out R → R ⊆ sourcePaperHull (D := D) n) ∧
    (∀ R : Set (SourceCarrier (D := D)), adm_out R →
      R = sourcePaperHull (D := D) n ∨
        ∃ S : Set (SourceAlpha (D := D) n x),
          R = ⋃ w ∈ S, sourceR (D := D) n x w)

/-- The paper Stp4 donor gives the exact ActualP6AdmOutData interface; the
H-admissibility candidate is a weaker inhabited instance of that interface. -/
theorem actualP6AdmOutData_of_paperStp4
    (h : PaperStp4AdmOutDonor (D := D) n x) :
    Nonempty (ActualP6AdmOutData (D := D) n x) := by
  rcases h with ⟨adm_out, hR, hH, _hne, _hsub, _hgen⟩
  exact ⟨{ adm_out := adm_out
           sourceR_admissible := hR
           sourceHull_admissible := hH }⟩

/-- The H-admissibility candidate satisfies the exact interface but is not
asserted to satisfy the stronger Stp4 generation condition. -/
theorem hullAdmOut_satisfies_actualInterface :
    Nonempty (ActualP6AdmOutData (D := D) n x) :=
  ⟨hullAdmOutData (D := D) n x⟩

end LeanFormal.IUT.N8Closure.P6HullStp4Attempt

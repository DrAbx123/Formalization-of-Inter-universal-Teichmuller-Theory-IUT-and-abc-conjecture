import tmp.sheaf.n8.closure.EtaSourceActionConcrete
import tmp.sheaf.n8.closure.SourceWitnessedOutput
import LeanFormal.IUT.IUTII.Kummer.SourceLogShellCarrier

noncomputable section

namespace ABCBridge.N8.EtaPermittedSActual

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open LeanFormal.IUT.N8Closure.NativeInput
open ABCBridge.N8.EtaSourceActionConcrete
open ABCBridge.N8.EtaKummerSourceDatumAtF
open ABCBridge.N8.C4Actual

universe ua uv upi umon ui uL u

variable {l : PrimeGeFive} {V : Type uv}
variable {I : OriginalInput.{ua, uv, upi, umon, ui} l V}
variable {Label : Type uL} [Group Label]
variable (C4 : SourceWitnessedOutputData (l := l) (V := V) I Label)
variable {X : N8NativeInput l}
variable (n : ThetaPilotCarrier l)
variable (x : I.ThetaPilotPoint C4.place.v)

/-! ## Source-permitted integral regions -/

/-- The actual source output region at (n,x): the C4 possible-image union.
The field `S_eq` prevents an arbitrary subset from being called permitted. -/
structure EtaPermittedS (X : N8NativeInput l) (n : ThetaPilotCarrier l)
    (x : I.ThetaPilotPoint C4.place.v) where
  S : Set (I.ThetaPilotPoint C4.place.v)
  S_eq : S = C4.U n x
  S_nonempty : S.Nonempty
  sourceShell : SourceLogShellDatum
  sourceShell_eq : sourceShell = fSourceDatum X

/-- Actual permitted region: the C4 source region, not an arbitrary subset. -/
noncomputable def etaPermittedS :
    EtaPermittedS (X := X) C4 n x where
  S := C4.U n x
  S_eq := rfl
  S_nonempty := ⟨C4.eval n x zeroSignedLabel, ⟨zeroSignedLabel, rfl⟩⟩
  sourceShell := fSourceDatum X
  sourceShell_eq := rfl

theorem etaPermittedS_nonempty : Nonempty (EtaPermittedS (X := X) C4 n x) :=
  ⟨etaPermittedS (X := X) C4 n x⟩

/-! ## Ind3 upper-semi closed family -/

/-- The Ind3 upper-semi family generated by an actual source region: the
base region and its nonarchimedean upper-semi enlargements. -/
def ind3UpperFamily (S : Set (I.ThetaPilotPoint C4.place.v)) :
    Set (Set (I.ThetaPilotPoint C4.place.v)) :=
  {S} ∪ Set.range (fun m : Nat => C4.ind.ind3_nonarch m S)

theorem ind3UpperFamily_upper
    (T : Set (I.ThetaPilotPoint C4.place.v))
    (hT : T ∈ ind3UpperFamily (C4 := C4) S) (m : Nat) :
    T ⊆ C4.ind.ind3_nonarch m T :=
  C4.ind.ind3_nonarch_inclusion m T

/-- Actual Ind3 upper-semi closed family: every member includes into its
nonarchimedean upper-semi image; archimedean images are one-way surjections. -/
structure EtaPermittedInd3Family
    (S : Set (I.ThetaPilotPoint C4.place.v)) where
  family : Set (Set (I.ThetaPilotPoint C4.place.v))
  family_eq : family = ind3UpperFamily (C4 := C4) S
  nonarch_upper : ∀ T ∈ family, ∀ m, T ⊆ C4.ind.ind3_nonarch m T
  arch_surj : ∀ T ∈ family, ∀ m, C4.ind.ind3_arch m T ⊆ T

noncomputable def etaPermittedInd3Family
    (S : Set (I.ThetaPilotPoint C4.place.v)) :
    EtaPermittedInd3Family (C4 := C4) S where
  family := ind3UpperFamily (C4 := C4) S
  family_eq := rfl
  nonarch_upper := fun T hT m => ind3UpperFamily_upper (C4 := C4) T hT m
  arch_surj := fun T hT m => C4.ind.ind3_arch_surjection m T

/-! ## Actual Ind action on permitted regions -/

/-- Actual Ind1 action on a source region. -/
def etaAction (g : Label) (S : Set (I.ThetaPilotPoint C4.place.v)) :
    Set (I.ThetaPilotPoint C4.place.v) :=
  (C4.ind.ind1 g) '' S

theorem etaAction_one (S : Set (I.ThetaPilotPoint C4.place.v)) :
    etaAction (C4 := C4) 1 S = S := by
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    simpa using hz
  · intro hy
    exact ⟨y, hy, by simp⟩

theorem etaAction_nonempty (g : Label)
    (S : Set (I.ThetaPilotPoint C4.place.v)) (hS : S.Nonempty) :
    (etaAction (C4 := C4) g S).Nonempty :=
  hS.image (C4.ind.ind1 g)

/-! ## Exact output nontriviality gap -/

/-- Exact gap: the source action moves an actual permitted region to a
different output region.  No C4/IndActionData source law forces this, so it
is recorded as a target, not assumed. -/
def EtaActionOutputNonconstant (S : Set (I.ThetaPilotPoint C4.place.v)) : Prop :=
  ∃ g : Label, etaAction (C4 := C4) g S ≠ S

end ABCBridge.N8.EtaPermittedSActual

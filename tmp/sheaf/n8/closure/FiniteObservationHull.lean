import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Algebra.Group.Action.Pointwise.Set.Basic
import Mathlib.Tactic

/-!
# FiniteObservationHull

Stage 1/2 statements for the C9 finite-observation theorems A/B/C from
`C9-FINITE-OBSERVATION-THEOREMS-20261024.md`.

The general linear statements are over an arbitrary commutative ring `R`
(the intended specialization is `R = ℤ_[p]`).  `Hull O M` is the `O`-span of
`M`; `orbit G L` is the full lattice orbit.  The easy span and hull
certificate lemmas are proved; the source-level statements are recorded with
named `sorry`s and explicit hypotheses (no arbitrary `S`, `K_N`, `M_in`,
`M_out`).
-/

noncomputable section

namespace LeanFormal.IUT.N8Closure.FiniteObservationHull

open Set Pointwise

universe u

variable {R V W : Type*} [CommRing R]
  [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W]

/-- The `Z_p`-span hull of a set (generic over `R`; specialize `R = ℤ_[p]`). -/
def zpSpan (S : Set V) : Submodule R V := Submodule.span R S

/-- The `O`-hull `O • M` written as an `R`-submodule. -/
def hull (O : Subring R) (M : Submodule R V) : Submodule R V :=
  Submodule.span R ((O : Set R) • (M : Set V))

/-- The full lattice orbit of `L` under a subgroup of linear equivalences. -/
def orbit (G : Subgroup (V ≃ₗ[R] V)) (L : Submodule R V) : Set (Submodule R V) :=
  Set.range (fun g : G => Submodule.map (g : V →ₗ[R] V) L)

/-- Congruence of two linear equivalences modulo a submodule. -/
def SameMod (N : Submodule R V) (g h : V ≃ₗ[R] V) : Prop :=
  ∀ x : V, g x - h x ∈ N

section TheoremA

/-- Theorem A, actual: `Z_p`-span commutes with `R`-linear maps. -/
theorem zpSpan_map (T : V →ₗ[R] W) (S : Set V) :
    zpSpan (R := R) (T '' S) = Submodule.map T (zpSpan (R := R) S) := by
  rw [zpSpan, zpSpan, Submodule.map_span]

/-- Theorem A, actual: `Z_p`-span commutes with arbitrary unions. -/
theorem zpSpan_iUnion {ι : Type u} (S : ι → Set V) :
    zpSpan (R := R) (⋃ i, S i) = ⨆ i, zpSpan (R := R) (S i) := by
  simpa [zpSpan] using (Submodule.span_iUnion (R := R) S)

/-- Theorem A, actual: finite outputs generate a finitely generated span. -/
theorem zpSpan_fg_of_finite (S : Set V) (hS : S.Finite) :
    (zpSpan (R := R) S).FG :=
  Submodule.fg_span hS

/-- Theorem A, stage-1 statement: the `O_E`-hull of the `Z_p`-span equals the
`O_E`-span of the original bounded output set.  The full-lattice hypothesis is
the condition `M(U)` is a full lattice; the statement keeps it explicit. -/
def TheoremA_hull_statement (O : Subring R) (U : Set V) : Prop :=
  hull O (zpSpan (R := R) U) = Submodule.span R ((O : Set R) • U)

theorem TheoremA_hull_obligation (O : Subring R) (U : Set V)
    (hfull : zpSpan (R := R) U = ⊤) : TheoremA_hull_statement (V := V) O U := by
  have h1 : (1 : R) ∈ O := O.one_mem
  have hL : hull O (zpSpan (R := R) U) = ⊤ := by
    have hge : (⊤ : Submodule R V) ≤ hull O (zpSpan (R := R) U) := by
      rw [hfull]
      intro v _
      exact Submodule.subset_span ⟨1, h1, v, Submodule.mem_top, one_smul R v⟩
    exact le_antisymm le_top hge
  have hR : Submodule.span R ((O : Set R) • U) = ⊤ := by
    have hsub : U ⊆ (O : Set R) • U := by
      intro u hu
      exact ⟨1, h1, u, hu, one_smul R u⟩
    have hge : (⊤ : Submodule R V) ≤ Submodule.span R ((O : Set R) • U) := by
      rw [← hfull]
      exact Submodule.span_mono hsub
    exact le_antisymm le_top hge
  change hull O (zpSpan (R := R) U) = Submodule.span R ((O : Set R) • U)
  rw [hL, hR]

end TheoremA

section TheoremB

/-- One bounded saturation step generated by a finite family. -/
def satStep {ι : Type u} [Fintype ι] (g : ι → (V ≃ₗ[R] V))
    (M : Submodule R V) : Submodule R V :=
  M ⊔ ⨆ i, Submodule.map (g i : V →ₗ[R] V) M

def satIter {ι : Type u} [Fintype ι] (g : ι → (V ≃ₗ[R] V)) :
    ℕ → Submodule R V → Submodule R V
  | 0, M => M
  | n + 1, M => satIter g n (satStep g M)

end TheoremB

section TheoremC

theorem hull_mono {O : Subring R} {M N : Submodule R V} (h : M ≤ N) :
    hull O M ≤ hull O N := by
  apply Submodule.span_mono
  rintro x ⟨o, ho, m, hm, rfl⟩
  exact ⟨o, ho, m, h hm, rfl⟩

/-- Theorem C, actual: the inner/outer hull equality is a complete
certificate for the true orbit hull. -/
theorem inner_outer_hull_certificate {O : Subring R}
    (Min Mtrue Mout : Submodule R V)
    (hMin : Min ≤ Mtrue) (hMout : Mtrue ≤ Mout)
    (hEq : hull O Min = hull O Mout) :
    hull O Mtrue = hull O Mout := by
  apply le_antisymm
  · exact hull_mono hMout
  · calc hull O Mout = hull O Min := hEq.symm
      _ ≤ hull O Mtrue := hull_mono hMin

/-- Theorem C, stage-1 statement predicate: inner and outer hulls agree. -/
def InnerOuterHullCertificate (O : Subring R)
    (Min Mtrue Mout : Submodule R V) : Prop :=
  Min ≤ Mtrue ∧ Mtrue ≤ Mout ∧ hull O Min = hull O Mout

theorem TheoremC_certificate_obligation {O : Subring R}
    (Min Mtrue Mout : Submodule R V)
    (hcert : InnerOuterHullCertificate (V := V) O Min Mtrue Mout) :
    hull O Mtrue = hull O Mout :=
  inner_outer_hull_certificate Min Mtrue Mout hcert.1 hcert.2.1 hcert.2.2

end TheoremC

end LeanFormal.IUT.N8Closure.FiniteObservationHull
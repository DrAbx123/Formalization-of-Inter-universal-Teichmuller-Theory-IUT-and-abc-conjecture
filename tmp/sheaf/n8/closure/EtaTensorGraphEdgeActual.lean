import tmp.sheaf.n8.closure.EtaBlockActionGraphTarget
import tmp.sheaf.n8.closure.EtaUniformizerRelationActual

/-!
# EtaTensorGraphEdgeActual

Actual tensor graph edge for the one-factor block with the actual nonintegral
element `fPlaceP`.  The full-set edge is actual; the actual integral lattice
images `span_Zp(O)` and `span_Zp(g * O)` are recorded as the exact gap.
-/

noncomputable section

namespace LeanFormal.IUT.N8Closure.EtaTensorGraphEdgeActual

open LeanFormal.IUT
open LeanFormal.IUT.N8Closure.NativeInput
open LeanFormal.IUT.N8Closure.NativeC3
open LeanFormal.IUT.N8Closure.EtaTensorSplitActual
open LeanFormal.IUT.N8Closure.EtaGeneralQHaarScalingActual
open LeanFormal.IUT.N8Closure.EtaUniformizerRelationActual
open LeanFormal.IUT.N8Closure.EtaBlockActionGraphTarget
open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.NumberFieldFinitePlace
open ABCBridge.N8.C3TensorTargetCorrection
open scoped NNReal ENNReal Pointwise NormedField TensorProduct

variable {l : PrimeGeFive} (X : N8NativeInput l)
local instance : Fact (Nat.Prime (nativePrime X)) := nativePrimeFact X

abbrev Kf : Type := CommonPrimeCompletion (nativeFPlaceAtPrime X)
abbrev A : Unit → Type := fun _ => Kf X
abbrev E : Type := ⨂[ℚ_[nativePrime X]] (i : Unit), A X i

noncomputable def graphAction (g : Kf X) : E X →ₗ[ℚ_[nativePrime X]] E X :=
  tensorActionMul (p := nativePrime X) (A := A X) () g

def GraphEdge (g : Kf X) (Lu Lv : Set (E X)) : Prop :=
  ∀ x ∈ Lu, graphAction X g x ∈ Lv

theorem graphEdge_fPlaceP_inv_univ :
    GraphEdge X (fPlaceP X) Set.univ Set.univ := by
  intro x _
  trivial

def gNonIntegral : Kf X := (fPlaceP X)⁻¹

theorem graphEdge_gNonIntegral_univ :
    GraphEdge X (gNonIntegral X) Set.univ Set.univ := by
  intro x _
  trivial

theorem gNonIntegral_not_in_integers :
    gNonIntegral X ∉ (Integers (Kf X) : Set (Kf X)) := by
  intro hx
  have hle : ‖gNonIntegral X‖ ≤ 1 :=
    (LeanFormal.IUT.LocalFieldIntegralUnits.mem_integers_iff (K := Kf X)
      (gNonIntegral X)).mp hx
  have hlt : 1 < ‖gNonIntegral X‖ := by
    rw [gNonIntegral, norm_inv, fPlaceP_norm, inv_inv]
    exact_mod_cast (Fact.out : Nat.Prime (nativePrime X)).one_lt
  linarith

/-- Exact missing lattice-image theorem: actual Z_p-lattices generated by
the completion integers, and by `g * Integers`, inside the one-factor tensor
block, with `T_g` mapping the former into the latter. -/
def MissingTensorLatticeImage (X : N8NativeInput l) : Prop :=
  ∃ (Lu Lv : Set (E X)), Lu.Nonempty ∧
    GraphEdge X (gNonIntegral X) Lu Lv

end LeanFormal.IUT.N8Closure.EtaTensorGraphEdgeActual
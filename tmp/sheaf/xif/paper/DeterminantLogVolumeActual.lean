import Mathlib.RingTheory.FractionalIdeal.Basic
import Mathlib.RingTheory.FractionalIdeal.Operations
import Mathlib.RingTheory.FractionalIdeal.Norm
import LeanFormal.IUT.Foundations.NumberField.LocalQParameter
import LeanFormal.IUT.Foundations.NumberField.PlaceCompletionCarrier
import LeanFormal.IUT.IUTIII.Theorem311.SourceArithmeticHolomorphicLanding

/-!
# Actual determinant and log-volume data for a rank-one arithmetic line bundle

The line bundle is an actual fractional ideal I of O_k in k.  Its determinant
is I itself.  The actual global determinant normalization is the fractional
ideal norm FractionalIdeal.absNorm I : Q; the corresponding global log-volume
is Real.log (absNorm I).  Localizations at finite places are the actual
O_v-submodules of K_v generated by the image of I; local p-adic log-volumes are
the actual Valued.v valuations normalized by the residue characteristic.

No arbitrary carrier or metric is introduced.
-/

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

noncomputable section

namespace LeanFormal.IUT

namespace PaperDeterminantLogVolume

variable {k : Type} [Field k] [NumberField k]

/-- The actual integral ring O_k. -/
abbrev OK (k : Type) [Field k] [NumberField k] : Type :=
  NumberField.RingOfIntegers k

/-- The actual rank-one arithmetic line bundle: a fractional ideal of O_k. -/
abbrev LineBundle (k : Type) [Field k] [NumberField k] : Type :=
  FractionalIdeal (nonZeroDivisors (OK k)) k

/-- The actual completed valuation ring O_v. -/
abbrev LocalRing (k : Type) [Field k] [NumberField k]
    (v : NumberField.FinitePlace k) : Type :=
  NumberFieldFinitePlace.CompletionIntegers v

/-- The actual local field K_v. -/
abbrev LocalField (k : Type) [Field k] [NumberField k]
    (v : NumberField.FinitePlace k) : Type :=
  NumberFieldFinitePlace.Completion v

/-- The determinant of a rank-one line bundle is the line bundle itself. -/
def determinantLine (I : LineBundle (k := k)) : LineBundle (k := k) :=
  I

theorem determinantLine_eq (I : LineBundle (k := k)) :
    determinantLine (k := k) I = I := rfl

/-- The actual global determinant normalization: the fractional ideal norm. -/
def determinantNorm (I : LineBundle (k := k)) : Rat :=
  FractionalIdeal.absNorm I

/-- The determinant norm of the unit line bundle is one. -/
theorem determinantNorm_one :
    determinantNorm (k := k) (1 : LineBundle (k := k)) = 1 :=
  FractionalIdeal.absNorm_one

/-- The determinant norm is multiplicative. -/
theorem determinantNorm_mul (I J : LineBundle (k := k)) :
    determinantNorm (k := k) (I * J) =
      determinantNorm (k := k) I * determinantNorm (k := k) J :=
  map_mul (FractionalIdeal.absNorm (R := OK k) (K := k)) I J

/-- The determinant norm is nonnegative. -/
theorem determinantNorm_nonneg (I : LineBundle (k := k)) :
    0 <= determinantNorm (k := k) I :=
  FractionalIdeal.absNorm_nonneg I

/-- The determinant norm vanishes exactly on the zero line bundle. -/
theorem determinantNorm_eq_zero_iff (I : LineBundle (k := k)) :
    determinantNorm (k := k) I = 0 <-> I = 0 :=
  FractionalIdeal.absNorm_eq_zero_iff

/-- The actual global log-volume from the determinant normalization. -/
def globalLogVolume (I : LineBundle (k := k)) : Real :=
  Real.log (determinantNorm (k := k) I : Real)

theorem globalLogVolume_one :
    globalLogVolume (k := k) (1 : LineBundle (k := k)) = 0 := by
  simp [globalLogVolume, determinantNorm_one]

/-- The global log-volume is additive on nonzero line bundles. -/
theorem globalLogVolume_mul (I J : LineBundle (k := k))
    (hI : I ≠ 0) (hJ : J ≠ 0) :
    globalLogVolume (k := k) (I * J) =
      globalLogVolume (k := k) I + globalLogVolume (k := k) J := by
  have hIpos : (0 : Rat) < determinantNorm (k := k) I :=
    lt_of_le_of_ne (determinantNorm_nonneg I)
      (Ne.symm (mt (determinantNorm_eq_zero_iff I).mp hI))
  have hJpos : (0 : Rat) < determinantNorm (k := k) J :=
    lt_of_le_of_ne (determinantNorm_nonneg J)
      (Ne.symm (mt (determinantNorm_eq_zero_iff J).mp hJ))
  simp [globalLogVolume, determinantNorm_mul, Real.log_mul,
    ne_of_gt hIpos, ne_of_gt hJpos]

/-- The localization of a fractional ideal at a finite place: the actual
O_v-submodule of K_v generated by the image of I. -/
def localizedLine (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) :
    Submodule (LocalRing (k := k) v) (LocalField (k := k) v) :=
  Submodule.span (LocalRing (k := k) v)
    ((fun x : k => algebraMap k (LocalField (k := k) v) x) '' (I : Set k))

/-- The localization map from a line-bundle section to its O_v-localization. -/
def localizationMap (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) (x : I) :
    localizedLine (k := k) I v :=
  ⟨algebraMap k (LocalField (k := k) v) (x : k),
    Submodule.subset_span ⟨x, x.2, rfl⟩⟩

/-- The localization map lands in the localized line. -/
theorem localizationMap_mem (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) (x : I) :
    (algebraMap k (LocalField (k := k) v) (x : k)) ∈
      (localizedLine (k := k) I v : Set (LocalField (k := k) v)) :=
  (localizationMap (k := k) I v x).2

/-- Localization is monotone in the fractional ideal. -/
theorem localizedLine_mono {I J : LineBundle (k := k)} (hIJ : I <= J)
    (v : NumberField.FinitePlace k) :
    localizedLine (k := k) I v <= localizedLine (k := k) J v := by
  unfold localizedLine
  apply Submodule.span_mono
  rintro x ⟨y, hy, rfl⟩
  exact ⟨y, hIJ hy, rfl⟩

/-- The actual additive valuation of K_v, as an integer. -/
def localValuation (v : NumberField.FinitePlace k)
    (x : LocalField (k := k) v) : Int :=
  (Valued.v x).log

/-- The actual p-adic local log-volume of a local section. -/
def localLogVolume (v : NumberField.FinitePlace k)
    (x : LocalField (k := k) v) : Real :=
  - (localValuation (k := k) v x : Real) *
    Real.log (NumberFieldFinitePlace.residueCharacteristic v)

/-- The local log-volume of a section of a line bundle at a place. -/
def sectionLocalLogVolume (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) (x : I) : Real :=
  localLogVolume (k := k) v
    (algebraMap k (LocalField (k := k) v) (x : k))

/-- The selected-place local log-volume sum for a section. -/
def sectionLogVolume (I : LineBundle (k := k))
    (selected : Finset (NumberField.FinitePlace k)) (x : I) : Real :=
  selected.sum fun v => sectionLocalLogVolume (k := k) I v x

/-- The local valuation is additive on nonzero products. -/
theorem localValuation_mul (v : NumberField.FinitePlace k)
    (x y : LocalField (k := k) v)
    (hx : Valued.v x ≠ 0) (hy : Valued.v y ≠ 0) :
    localValuation (k := k) v (x * y) =
      localValuation (k := k) v x + localValuation (k := k) v y := by
  unfold localValuation
  rw [map_mul, WithZero.log_mul hx hy]

theorem localValuation_one (v : NumberField.FinitePlace k) :
    localValuation (k := k) v 1 = 0 := by
  unfold localValuation
  simp

theorem localLogVolume_one (v : NumberField.FinitePlace k) :
    localLogVolume (k := k) v 1 = 0 := by
  simp [localLogVolume, localValuation]

/-- Actual determinant/log-volume data for a rank-one line bundle. -/
structure PaperDeterminantLogVolumeData where
  lineBundle : LineBundle (k := k)
  determinantLine : LineBundle (k := k)
  determinantNorm : Rat
  globalLogVolume : Real
  localRing : NumberField.FinitePlace k -> Type
  localField : NumberField.FinitePlace k -> Type
  localizedLine : (v : NumberField.FinitePlace k) -> Type
  localValuation : (v : NumberField.FinitePlace k) -> localField v -> Int

/-- The actual data built from a fractional ideal. -/
def actualDeterminantLogVolumeData (I : LineBundle (k := k)) :
    PaperDeterminantLogVolumeData (k := k) where
  lineBundle := I
  determinantLine := determinantLine (k := k) I
  determinantNorm := determinantNorm (k := k) I
  globalLogVolume := globalLogVolume (k := k) I
  localRing := fun v => LocalRing (k := k) v
  localField := fun v => LocalField (k := k) v
  localizedLine := fun v => localizedLine (k := k) I v
  localValuation := fun v => localValuation (k := k) v

theorem actualDeterminantLogVolumeData_norm (I : LineBundle (k := k)) :
    (actualDeterminantLogVolumeData (k := k) I).determinantNorm =
      FractionalIdeal.absNorm I := rfl

theorem actualDeterminantLogVolumeData_globalLogVolume (I : LineBundle (k := k)) :
    (actualDeterminantLogVolumeData (k := k) I).globalLogVolume =
      Real.log (FractionalIdeal.absNorm I : Real) := rfl

end PaperDeterminantLogVolume

end LeanFormal.IUT

end
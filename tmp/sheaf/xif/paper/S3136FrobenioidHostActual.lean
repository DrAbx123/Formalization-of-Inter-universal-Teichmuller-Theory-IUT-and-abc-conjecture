import tmp.sheaf.xif.paper.GlobalFrobenioidPresentationActual
import tmp.sheaf.xif.paper.LGPFrobenioidPresentationActual
import tmp.sheaf.xif.paper.LGPPhiInputActual
import tmp.sheaf.xif.paper.GlobalRealifiedFrobenioidActual

/-! # Stage-4 host: actual global realified Frobenioid layers

IUT I, Example 3.5, (i); IUT III, Example 3.6, (ii); [FrdI], Definition 1.1-1.3.

This file records the actual identifications between the packaged global model
Frobenioid presentation (a `FrobenioidPresentation` proxied through the
repository's Example 3.6 backend) and the actual number-field model data:

* its divisorial layer is the effective-divisor cone generated by
  `HeightOneSpectrum (𝓞 K)` and `NumberField.InfinitePlace K`;
* its base category is the actual one-object bottom base;
* the LGP-side base/FSM skeleton of `LGPFrobenioidPresentationActual` is the same
  bottom base, while its LGP divisor/input layer remains the recorded exact
  object-level gap `LGPFrobenioidPresentationGap`.

No inequality is judged here. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

namespace LeanFormal.IUT.XiFPaper.S3136FrobenioidHostActual

open LeanFormal.IUT
open IsDedekindDomain
open scoped NumberField
open LeanFormal.IUT.IUTII.Frobenioid.Example36.SourceModelBackend
open LeanFormal.IUT.XiFPaper.GlobalFrobenioidPresentationActual
open LeanFormal.IUT.XiFPaper.LGPFrobenioidPresentationActual

universe u

variable {K : Type u} [Field K] [NumberField K]

/-- The divisorial layer of the actual global model Frobenioid presentation is
literally the effective-divisor cone of the actual number-field model input
(IUT III, Example 3.6(ii)). -/
theorem S3136GlobalDivisorLayer_eq_backend :
    (globalFrobenioidDivisorMonoidActual (K := K)) =
      globalDivisorMonoidOn (F := K) := rfl

/-- The base category of the actual global model presentation is the actual
one-object bottom base category of the Example 3.6 model. -/
theorem S3136GlobalBaseLayer_eq_backend :
    (globalFrobenioidBaseActual (K := K)) = CategoryTheory.Cat.of BottomBase.{u} := rfl

/-- The actual effective divisor cone on the bottom base is the same object as
the divisorial layer of the presentation (both are `globalDivisorMonoidOn`). -/
theorem S3136GlobalEffectiveDivisorLayer_eq :
    (globalEffectiveDivisorMonoidActual (K := K)) =
      (globalFrobenioidDivisorMonoidActual (K := K)) := rfl

/-- The effective-divisor cone used by the model is the product of the
height-one prime exponents of the ring of integers with the archimedean
`-log(radius)` coordinates. -/
theorem S3136EffectiveDivisorCarrier_eq :
    EffectiveDivisor K =
      ((HeightOneSpectrum (𝓞 K) →₀ ℕ) ×
        (NumberField.InfinitePlace K → NNReal)) := rfl

/-- The LGP-side base skeleton of `LGPFrobenioidPresentationActual` is the same
actual bottom base as the global model presentation. -/
theorem S3136LGPBaseLayer_eq_bottom :
    LGPBaseCategory.{u} = BottomBase.{u} := rfl

/-- The exact object-level gap of the LGP-side host is exactly the nonemptiness
of the supplied LGP divisor/input data; it is NOT discharged here. -/
theorem S3136LGPPhiInputGap_eq :
    LGPFrobenioidPresentationGap.{u} =
      Nonempty (LGPFrobenioidPresentationData.{u}) := rfl

/-- The LGP presentation is actual once the source LGP divisor/input data is
supplied; this is the same conditional construction as
`lgpFrobenioidPresentationOfData`, re-exposed with its exact input. -/
theorem S3136LGPFrobenioidPresentation_of_data
    (D : LGPFrobenioidPresentationData.{u}) :
    lgpFrobenioidPresentationOfData D =
      Iut.SourceModelFrobenioid.Carrier.frobenioidPresentation
        (D := LGPBaseCategory.{u}) (IsFSM := LGPIsFSM)
        (Phi := D.Phi) (data := D.data) (fun f => lgpBase_arrow_epi f) :=
  rfl

#check S3136GlobalDivisorLayer_eq_backend
#check S3136GlobalBaseLayer_eq_backend
#check S3136GlobalEffectiveDivisorLayer_eq
#check S3136EffectiveDivisorCarrier_eq
#check S3136LGPBaseLayer_eq_bottom
#check S3136LGPPhiInputGap_eq
#check S3136LGPFrobenioidPresentation_of_data

end LeanFormal.IUT.XiFPaper.S3136FrobenioidHostActual
end

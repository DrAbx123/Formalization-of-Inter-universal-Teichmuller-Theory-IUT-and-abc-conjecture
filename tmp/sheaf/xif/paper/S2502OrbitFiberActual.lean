import Mathlib.CategoryTheory.Category.Cat
import Mathlib.CategoryTheory.Functor.Category

noncomputable section
open CategoryTheory
universe v u

namespace LeanFormal.IUT.XiFPaper.S2502OrbitFiberActual

variable {C : Type u} [Category.{v} C]

/-- Object-level relation generated by the involution: x ~ y if y = x or y = sigma x. -/
def S2502Rel (σ : C ⥤ C) (x y : C) : Prop :=
  y = x ∨ y = σ.obj x

/-- The object quotient of the fiber by the sign action. -/
abbrev S2502Orbit (σ : C ⥤ C) : Type u :=
  Quot (S2502Rel σ)

/-- The quotient projection on objects. -/
def S2502OrbitMk (σ : C ⥤ C) (x : C) : S2502Orbit σ :=
  Quot.mk (S2502Rel σ) x

theorem S2502OrbitMk_sigma (σ : C ⥤ C) (x : C) :
    S2502OrbitMk σ x = S2502OrbitMk σ (σ.obj x) :=
  Quot.sound (Or.inr rfl)

#check S2502Orbit
#check S2502OrbitMk_sigma

end LeanFormal.IUT.XiFPaper.S2502OrbitFiberActual
end

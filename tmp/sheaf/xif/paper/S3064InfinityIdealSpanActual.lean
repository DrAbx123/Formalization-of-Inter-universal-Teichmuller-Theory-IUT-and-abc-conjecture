local instance : Fact (Irreducible (Polynomial.X ^ 2 - Polynomial.C (-1) : Polynomial ℚ)) :=
  ⟨gaussianPolynomial_irreducible⟩
local instance : DecidableEq S2844D6F6BaseChangeActual.K := Classical.decEq _

/-- A polynomial with zero constant term lies in the ideal generated by X0,X1. -/
theorem S3064_ker_constantCoeff_le_span_X
    (p : MvPolynomial (Fin 2) S2844D6F6BaseChangeActual.K)
    (hconst : MvPolynomial.constantCoeff p = 0) :
    p ∈ Ideal.span ({MvPolynomial.X 0, MvPolynomial.X 1} :
      Set (MvPolynomial (Fin 2) S2844D6F6BaseChangeActual.K)) := by
  rw [MvPolynomial.as_sum p]
  apply Ideal.sum_mem
  intro v hv
  have hvne : v ≠ 0 := by
    intro h0
    have hcoeff : MvPolynomial.coeff v p ≠ 0 :=
      MvPolynomial.mem_support_iff.mp hv
    rw [h0] at hcoeff
    apply hcoeff
    rw [← MvPolynomial.constantCoeff_eq]
    exact hconst
  obtain ⟨i, hi⟩ : ∃ i : Fin 2, v i ≠ 0 := by
    by_contra h
    push Not at h
    exact hvne (by ext i; exact h i)
  have hdvd : MvPolynomial.X i ∣
      MvPolynomial.monomial v (MvPolynomial.coeff v p) :=
    MvPolynomial.X_dvd_monomial.mpr (Or.inr hi)
  rcases hdvd with ⟨q, hq⟩
  rw [hq]
  have hxmem : MvPolynomial.X i ∈ Ideal.span
      ({MvPolynomial.X 0, MvPolynomial.X 1} :
        Set (MvPolynomial (Fin 2) S2844D6F6BaseChangeActual.K)) := by
    apply Ideal.subset_span
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hm := Ideal.mul_mem_left (Ideal.span
      ({MvPolynomial.X 0, MvPolynomial.X 1} :
        Set (MvPolynomial (Fin 2) S2844D6F6BaseChangeActual.K))) q hxmem
  rwa [mul_comm q (MvPolynomial.X i)] at hm

/-- The reverse inclusion E37InfinityIdeal <= span{sbar,tbar}, actual. -/
theorem S3064_infinityIdeal_le_span (z : E37ChartYRing S2844D6F6BaseChangeActual.K)
    (hz : z ∈ E37InfinityIdeal S2844D6F6BaseChangeActual.K) :
    z ∈ Ideal.span ({sbar S2844D6F6BaseChangeActual.K,
      tbar S2844D6F6BaseChangeActual.K} : Set (E37ChartYRing S2844D6F6BaseChangeActual.K)) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
  have hconst : MvPolynomial.constantCoeff p = 0 := by
    rw [E37InfinityIdeal, RingHom.mem_ker] at hz
    rw [E37InfinityEval] at hz
    rw [Ideal.Quotient.lift_mk] at hz
    rw [E37InfinityPolynomialEval] at hz
    change MvPolynomial.eval (0 : Fin 2 → S2844D6F6BaseChangeActual.K) p = 0 at hz
    rwa [MvPolynomial.eval_zero] at hz
  have hspan := S3064_ker_constantCoeff_le_span_X p hconst
  have hmap := Ideal.mem_map_of_mem
    (Ideal.Quotient.mk (E37ChartYIdeal S2844D6F6BaseChangeActual.K)) hspan
  rw [Ideal.map_span] at hmap
  have hset : (Ideal.Quotient.mk (E37ChartYIdeal S2844D6F6BaseChangeActual.K)) ''
      ({MvPolynomial.X 0, MvPolynomial.X 1} :
        Set (MvPolynomial (Fin 2) S2844D6F6BaseChangeActual.K)) =
      ({sbar S2844D6F6BaseChangeActual.K,
        tbar S2844D6F6BaseChangeActual.K} :
        Set (E37ChartYRing S2844D6F6BaseChangeActual.K)) := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact Or.inl rfl
      · exact Or.inr rfl
    · intro hz
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact ⟨MvPolynomial.X 0, Or.inl rfl, rfl⟩
      · exact ⟨MvPolynomial.X 1, Or.inr rfl, rfl⟩
  rw [hset] at hmap
  exact hmap

/-- The reverse inclusion, packaging S3063InfinityIdealSpan. -/
theorem S3064_infinityIdealSpan :
    E37InfinityIdeal S2844D6F6BaseChangeActual.K <=
      Ideal.span ({sbar S2844D6F6BaseChangeActual.K,
        tbar S2844D6F6BaseChangeActual.K} :
        Set (E37ChartYRing S2844D6F6BaseChangeActual.K)) := by
  intro z hz
  exact S3064_infinityIdeal_le_span z hz

/-- The ideal equality E37InfinityIdeal = span{sbar,tbar}. -/
theorem S3064_span_eq_infinityIdeal :
    Ideal.span ({sbar S2844D6F6BaseChangeActual.K,
      tbar S2844D6F6BaseChangeActual.K} :
      Set (E37ChartYRing S2844D6F6BaseChangeActual.K)) =
      E37InfinityIdeal S2844D6F6BaseChangeActual.K := by
  exact le_antisymm S3063_span_le_infinityIdeal S3064_infinityIdealSpan


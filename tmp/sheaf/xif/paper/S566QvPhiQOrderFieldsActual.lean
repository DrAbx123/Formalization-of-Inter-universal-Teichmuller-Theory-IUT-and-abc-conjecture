import tmp.sheaf.xif.paper.S561QvPhiMinimalPackageActual
import tmp.sheaf.xif.paper.S563QvOrderElementConstructionActual

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 3000000

namespace LeanFormal.IUT.XiFPaper.S566QvPhiQOrderFieldsActual

open CategoryTheory
open Iut
open LeanFormal.IUT.XiFPaper.S432SmallModelActual
open LeanFormal.IUT.XiFPaper.S556QvPhiInputActual
open LeanFormal.IUT.XiFPaper.S561QvPhiMinimalPackageActual
open LeanFormal.IUT.XiFPaper.S563QvOrderElementConstructionActual
open LeanFormal.IUT.XiFPaper.S522QvPhiRamificationModelActual
open LeanFormal.IUT.XiFPaper.S511PhiCvCandidateActual
open LeanFormal.IUT.XiFPaper.S550QvPhiPreFrobenioidActual
open Iut.SourceModelFrobenioid

universe u
variable {K : Type u} [Field K]
variable (P : S561MinimalPackage (K := K))
variable (A : Object (qvPhi (K := K) P.ramification))

/-- Actual Input from the S561 minimal package. -/
abbrev s566Input : Input (qvPhi (K := K) P.ramification) :=
  s561Input (K := K) P

/-- Actual QvPhiQOrderFields for the identity rational function / zero divisor.
This proves the field triple without faking a pi element. -/
noncomputable def zeroQvPhiQOrderFields :
    QvPhiQOrderFields (K := K) P.ramification (s566Input P) A where
  divisor := 0
  rationalFunction := 0
  divisor_eq := by
    rw [map_zero]
    simp

/-- The actual tau generated by the zero-divisor element (identity, not pi). -/
noncomputable def zeroTau :
    Submonoid (PreFrobenioid.LinearBaseIdentityEndomorphism
      (P := qvPreFrobenioid (K := K) P.ramification (s566Input P)) A) :=
  tauOfQOrderFields (K := K) P.ramification (s566Input P) A
    (zeroQvPhiQOrderFields (K := K) P A)

theorem zeroTau_eq_powers :
    zeroTau (K := K) P A =
      Submonoid.powers
        (qOrderEndomorphismOfFields (K := K) P.ramification (s566Input P) A
          (zeroQvPhiQOrderFields (K := K) P A)) := rfl

/-- Exact missing pi preimage: an effective divisor equal to the qOrder
generator and a rational function whose divisor is that divisor. -/
structure QvPhiPiPreimage (qOrder : ℕ) where
  divisor : ((qvPhi (K := K) P.ramification).obj A.base).carrier
  divisor_eq : divisor = (ULift.up qOrder : ((qvPhi (K := K) P.ramification).obj A.base).carrier)
  rationalFunction : (s566Input (K := K) P).rationalFunctions.obj A.base
  divisor_eq' : (s566Input (K := K) P).divisor A.base rationalFunction =
    Algebra.GrothendieckAddGroup.of divisor

def QvPhiPiPreimageRequired (qOrder : ℕ) : Prop :=
  Nonempty (QvPhiPiPreimage (K := K) P A qOrder)

/-- Conditional tau=pi^Z once the pi preimage is supplied. -/
noncomputable def tauOfPiPreimage {qOrder : ℕ}
    (H : QvPhiPiPreimage (K := K) P A qOrder) :
    Submonoid (PreFrobenioid.LinearBaseIdentityEndomorphism
      (P := qvPreFrobenioid (K := K) P.ramification (s566Input P)) A) :=
  tauOfQOrderFields (K := K) P.ramification (s566Input P) A
    { divisor := H.divisor
      rationalFunction := H.rationalFunction
      divisor_eq := H.divisor_eq' }

end LeanFormal.IUT.XiFPaper.S566QvPhiQOrderFieldsActual

end

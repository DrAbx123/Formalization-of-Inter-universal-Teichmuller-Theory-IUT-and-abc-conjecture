import Mathlib.RingTheory.Etale.Finite
import Mathlib.RingTheory.Artinian.Module
import Mathlib.RingTheory.Idempotents
import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Etale.Pi
import Mathlib.Algebra.Algebra.Prod
import Mathlib.Algebra.Category.CommAlgCat.Basic

open CategoryTheory CategoryTheory.Limits

universe u

namespace S1771

variable {K : Type u} [Field K]

/-- If I + J = 1 and I ∩ J = 0 for ideals of a commutative ring B, then
B is isomorphic as a K-algebra to B/I × B/J. -/
noncomputable def algEquiv_prod_quotient_of_isCompl {B : Type u} [CommRing B] [Algebra K B]
    (I J : Ideal B) (h : IsCompl I J) :
    B ≃ₐ[K] ((B ⧸ I) × (B ⧸ J)) := by
  have hcop : IsCoprime I J := Ideal.isCoprime_iff_sup_eq.mpr h.sup_eq_top
  have hinf : I ⊓ J = ⊥ := h.inf_eq_bot
  have hCRT : ∀ x : K, (Ideal.quotientInfEquivQuotientProd I J hcop)
      (algebraMap K (B ⧸ (I ⊓ J)) x) = algebraMap K ((B ⧸ I) × (B ⧸ J)) x := by
    intro x
    rw [← Ideal.Quotient.mk_algebraMap (R₁ := K) (I := I ⊓ J) x]
    ext
    · rw [Ideal.quotientInfEquivQuotientProd_fst, Ideal.Quotient.factor_mk,
        Prod.algebraMap_apply]
      rw [← Ideal.Quotient.mk_algebraMap (R₁ := K) (I := I) x]
    · rw [Ideal.quotientInfEquivQuotientProd_snd, Ideal.Quotient.factor_mk,
        Prod.algebraMap_apply]
      rw [← Ideal.Quotient.mk_algebraMap (R₁ := K) (I := J) x]
  let e2 : ((B ⧸ (I ⊓ J)) ≃ₐ[K] ((B ⧸ I) × (B ⧸ J))) :=
    AlgEquiv.ofRingEquiv (f := Ideal.quotientInfEquivQuotientProd I J hcop) hCRT
  exact (AlgEquiv.quotientBot K B).symm.trans
    ((Ideal.quotientEquivAlgOfEq K (I := (⊥ : Ideal B)) (J := I ⊓ J) hinf.symm).trans e2)

/-- A surjective map of finite etale K-algebras is a product projection. -/
noncomputable def exists_prod_algEquiv_of_surjective
    (A B : Type u) [CommRing A] [Algebra K A] [Module.Finite K A] [Algebra.Etale K A]
    [CommRing B] [Algebra K B] [Module.Finite K B] [Algebra.Etale K B]
    (f : B →ₐ[K] A) (hf : Function.Surjective f) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra K C) (_ : Module.Finite K C)
      (_ : Algebra.Etale K C),
      ∃ e : B ≃ₐ[K] (A × C), f = (AlgHom.fst K A C).comp e.toAlgHom := by
  -- B is semisimple
  haveI : IsReduced B := Algebra.FormallyUnramified.isReduced_of_field K B
  haveI : IsArtinianRing B := IsArtinianRing.of_finite K B
  haveI : IsSemisimpleRing B := IsArtinianRing.isSemisimpleRing_of_isReduced B
  -- kernel of f and a complement
  let I : Ideal B := RingHom.ker f
  obtain ⟨J, hJ⟩ := ComplementedLattice.exists_isCompl I
  -- J is generated by an idempotent
  obtain ⟨eJ, heJ, hJe⟩ := IsSemisimpleRing.ideal_eq_span_idempotent J
  -- hence B/J is formally etale over B, and etale over K
  have hJidem : IsIdempotentElem J := by
    rw [hJe]
    simp [IsIdempotentElem, Ideal.span_singleton_mul_span_singleton, heJ.eq]
  have hFE : Algebra.FormallyEtale B (B ⧸ J) := by
    refine (Algebra.FormallyEtale.iff_of_surjective (R := B) (S := B ⧸ J) ?_).mpr ?_
    · exact Ideal.Quotient.mk_surjective
    · have hker : RingHom.ker (algebraMap B (B ⧸ J)) = J := Ideal.mk_ker
      rwa [hker]
  have hFEK : Algebra.FormallyEtale K (B ⧸ J) := Algebra.FormallyEtale.comp K B (B ⧸ J)
  haveI hFinC : Module.Finite K (B ⧸ J) := by
    exact Module.Finite.of_surjective (Ideal.Quotient.mkₐ K J).toLinearMap
      (Ideal.Quotient.mkₐ K J).surjective
  have hEtC : Algebra.Etale K (B ⧸ J) := by
    refine ⟨hFEK, ?_⟩
    exact (Algebra.FinitePresentation.of_finiteType (R := K)).mp inferInstance
  -- assemble
  let crt : B ≃ₐ[K] ((B ⧸ I) × (B ⧸ J)) := algEquiv_prod_quotient_of_isCompl I J hJ
  let q : (B ⧸ I) ≃ₐ[K] A := Ideal.quotientKerAlgEquivOfSurjective hf
  let ee : B ≃ₐ[K] (A × (B ⧸ J)) := crt.trans (AlgEquiv.prodCongr q (AlgEquiv.refl (B ⧸ J)))
  refine ⟨B ⧸ J, inferInstance, inferInstance, hFinC, hEtC, ee, ?_⟩
  ext b
  have crt_apply : crt b = (Ideal.Quotient.mk I b, Ideal.Quotient.mk J b) := by
    change (AlgEquiv.quotientBot K B).symm.trans
      ((Ideal.quotientEquivAlgOfEq K (I := (⊥ : Ideal B)) (J := I ⊓ J) hJ.inf_eq_bot.symm).trans
        (AlgEquiv.ofRingEquiv (f := Ideal.quotientInfEquivQuotientProd I J
          (Ideal.isCoprime_iff_sup_eq.mpr hJ.sup_eq_top))
          (by
            intro x
            rw [← Ideal.Quotient.mk_algebraMap (R₁ := K) (I := I ⊓ J) x]
            ext
            · rw [Ideal.quotientInfEquivQuotientProd_fst, Ideal.Quotient.factor_mk,
                Prod.algebraMap_apply]
              rw [← Ideal.Quotient.mk_algebraMap (R₁ := K) (I := I) x]
            · rw [Ideal.quotientInfEquivQuotientProd_snd, Ideal.Quotient.factor_mk,
                Prod.algebraMap_apply]
              rw [← Ideal.Quotient.mk_algebraMap (R₁ := K) (I := J) x]))) b = _
    simp only [AlgEquiv.trans_apply]
    rw [show (AlgEquiv.quotientBot K B).symm b = Ideal.Quotient.mk (⊥ : Ideal B) b from rfl]
    rw [Ideal.quotientEquivAlgOfEq_mk]
    ext
    · rw [Ideal.quotientInfEquivQuotientProd_fst, Ideal.Quotient.factor_mk]
    · rw [Ideal.quotientInfEquivQuotientProd_snd, Ideal.Quotient.factor_mk]
  have ee_apply : ee b = (f b, Ideal.Quotient.mk J b) := by
    change (AlgEquiv.prodCongr q (AlgEquiv.refl (B ⧸ J))) (crt b) = _
    rw [crt_apply]
    simp only [AlgEquiv.prodCongr_apply, Equiv.prodCongr_apply, Prod.map_apply, id_eq]
    rw [Ideal.quotientKerAlgEquivOfSurjective_mk]
  rw [ee_apply]
  rfl

end S1771

/- Route 7.2 reduction: if every bounded-degree intermediate field is generated by a root of
one of finitely many nonzero rational polynomials, then there are finitely many such fields. -/
import tmp.sheaf.xif.paper.Mzk1LpFinitenessActual
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Data.Set.Finite.Lattice
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalRootGeneratorsActual

open Polynomial
open LeanFormal.IUT.XiFPaper.Mzk1LpFinitenessActual

variable {p : Nat} [Fact p.Prime]

/-- Finite root-generator reduction: finitely many nonzero polynomials S whose roots generate
all bounded-degree intermediate fields imply BoundedDegreeFinitelyManyFields. -/
theorem finite_boundedDegree_of_finite_roots (d : Nat) (S : Finset (Polynomial ℚ_[p]))
    (hS0 : ∀ f ∈ S, f ≠ 0)
    (hgen : ∀ M : IntermediateField ℚ_[p] (PadicAlgCl p), FiniteDimensional ℚ_[p] M →
      Module.finrank ℚ_[p] M ≤ d →
      ∃ x : PadicAlgCl p, (∃ f ∈ S, f.aeval x = 0) ∧
        M = IntermediateField.adjoin ℚ_[p] ({x} : Set (PadicAlgCl p))) :
    BoundedDegreeFinitelyManyFields (p := p) d := by
  classical
  let T : Set (PadicAlgCl p) :=
    ⋃ f ∈ (S : Set (Polynomial ℚ_[p])), {z | (f.map (algebraMap ℚ_[p] (PadicAlgCl p))).IsRoot z}
  have hT : T.Finite := by
    apply Set.Finite.biUnion S.finite_toSet
    intro f hf
    apply Polynomial.finite_setOf_isRoot
    exact Polynomial.map_ne_zero (hS0 f hf)
  let x : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
      FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d } → PadicAlgCl p :=
    fun M => Classical.choose (hgen M.1 M.2.1 M.2.2)
  have hx_spec : ∀ M, (∃ f ∈ S, f.aeval (x M) = 0) ∧
      M.1 = IntermediateField.adjoin ℚ_[p] ({x M} : Set (PadicAlgCl p)) :=
    fun M => Classical.choose_spec (hgen M.1 M.2.1 M.2.2)
  have hxT : ∀ M, x M ∈ T := by
    intro M
    obtain ⟨⟨f, hfS, hfroot⟩, _⟩ := hx_spec M
    exact Set.mem_iUnion.mpr ⟨f, Set.mem_iUnion.mpr ⟨hfS, by
      change (f.map (algebraMap ℚ_[p] (PadicAlgCl p))).IsRoot (x M)
      rw [Polynomial.IsRoot.def, ← Polynomial.eval₂_eq_eval_map, ← Polynomial.aeval_def]
      exact hfroot⟩⟩
  haveI : Finite T := hT
  change Finite { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
      FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d }
  refine Finite.of_injective
    (fun M : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
        FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d } => (⟨x M, hxT M⟩ : T)) ?_
  intro M N hMN
  have hxeq : x M = x N := Subtype.ext_iff.mp hMN
  have hM : M.1 = N.1 := by
    rw [(hx_spec M).2, (hx_spec N).2, hxeq]
  exact Subtype.ext hM

#print axioms finite_boundedDegree_of_finite_roots
end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalRootGeneratorsActual

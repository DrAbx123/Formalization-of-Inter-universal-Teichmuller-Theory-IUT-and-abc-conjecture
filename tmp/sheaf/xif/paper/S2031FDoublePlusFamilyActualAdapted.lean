/-! ## 1. The realified local theta monoid of C^⊩env -/

/-- The realified local theta monoid of C^⊩env at a one-column place: the ray
R_{≥0} of coefficients of the formal direction log(p_v)·log(Θ), written in
multiplicative notation (multiplication = addition of the coefficients).  This
is the "R" object of IUT II, Corollary 4.6, (v). -/
abbrev EnvRealified (v : FinitePrimePlace 2 7) : Type := Multiplicative NNReal

/-- The realified local theta monoid is the ray R_{≥0}. -/
noncomputable def envRealifiedEquiv (v : FinitePrimePlace 2 7) :
    EnvRealified v ≃* Multiplicative NNReal :=
  MulEquiv.refl _

/-- **The realification of the local theta monoid** (IUT II, Corollary 4.6, (v),
via Corollary 4.5, (v)): kill the constant (ind-topological) factor and read the
coefficient of the formal direction log(p_v)·log(Θ).  On the S1966 model
PsiEnvModel v = (actual local units) × Multiplicative NNReal this is the second
projection. -/
noncomputable def psiEnvRealification (v : FinitePrimePlace 2 7) :
    PsiEnvModel v →* Multiplicative NNReal where
  toFun z := z.2
  map_one' := rfl
  map_mul' _ _ := rfl

theorem psiEnvRealification_apply (v : FinitePrimePlace 2 7) (z : PsiEnvModel v) :
    psiEnvRealification v z = z.2 := rfl

/-- The realification is surjective onto the ray R_{≥0}. -/
theorem psiEnvRealification_surjective (v : FinitePrimePlace 2 7) :
    Function.Surjective (psiEnvRealification v) :=
  fun c => ⟨(1, c), rfl⟩

/-- The realification kills the constant (ind-topological) factor: the actual
local units of the model. -/
@[simp] theorem psiEnvRealification_unitSection (v : FinitePrimePlace 2 7)
    (u : PsiCnsUnits v) :
    psiEnvRealification v (psiEnvUnitSection v u) = 1 := rfl

/-- The realification is the identity on the formal theta ray. -/
@[simp] theorem psiEnvRealification_raySection (v : FinitePrimePlace 2 7)
    (c : Multiplicative NNReal) :
    psiEnvRealification v (psiEnvRaySection v c) = c := rfl

/-- Every element of the local theta model is the product of its constant
factor and its theta-ray factor; consequently the realification, which kills
the constant factor and is the identity on the ray, is the operator "replace the
ind-topological monoid portion by the realification of its quotient by units" of
Corollary 4.5, (v). -/
theorem psiEnvRealification_decompose (v : FinitePrimePlace 2 7)
    (z : PsiEnvModel v) :
    z = psiEnvUnitSection v z.1 * psiEnvRaySection v z.2 := by
  obtain ⟨u, c⟩ := z
  apply Prod.ext
  · simp [psiEnvUnitSection, psiEnvRaySection]
  · simp [psiEnvUnitSection, psiEnvRaySection]

/-- **Universal property of the realification.**  Any monoid hom out of the local
theta model that kills the constant factor factors through the realification. -/
theorem psiEnvRealification_unique {N : Type*} [Monoid N]
    (v : FinitePrimePlace 2 7) (h : PsiEnvModel v →* N)
    (hh : ∀ u : PsiCnsUnits v, h (psiEnvUnitSection v u) = 1)
    (z : PsiEnvModel v) :
    h z = h (psiEnvRaySection v z.2) := by
  conv_lhs => rw [psiEnvRealification_decompose v z]
  rw [map_mul, hh, one_mul]

/-- The factorization form of the universal property. -/
theorem psiEnvRealification_factors {N : Type*} [Monoid N]
    (v : FinitePrimePlace 2 7) (h : PsiEnvModel v →* N)
    (hh : ∀ u : PsiCnsUnits v, h (psiEnvUnitSection v u) = 1) :
    h = (h.comp (psiEnvRaySection v)).comp (psiEnvRealification v) := by
  ext z
  exact psiEnvRealification_unique v h hh z

/-- The formal generator log(p_v)·log(Θ) maps to the distinguished element 1 of
the realified monoid. -/
@[simp] theorem psiEnvRealification_generator (v : FinitePrimePlace 2 7) :
    psiEnvRealification v (localThetaGenerator v) = Multiplicative.ofAdd (1 : NNReal) := rfl

/-! ## 2. The realified local Gaussian monoid of C^⊩gau -/

/-- The realified local Gaussian monoid of C^⊩gau at a one-column place: the ray
R_{≥0} of coefficients of the Gaussian vector (..., j² log(p_v), ...). -/
abbrev GauRealified (v : FinitePrimePlace 2 7) (l : PrimeGeFive) : Type :=
  Multiplicative NNReal

/-- The realified local Gaussian monoid is the ray R_{≥0}. -/
noncomputable def gauRealifiedEquiv (v : FinitePrimePlace 2 7) (l : PrimeGeFive) :
    GauRealified v l ≃* Multiplicative NNReal :=
  MulEquiv.refl _

/-- The evaluation isomorphism of IUT II, Corollary 4.6, (iv), as a
multiplicative equivalence (it is the bijective psiEvaluation of S1973). -/
noncomputable def psiEnvGauEquiv (v : FinitePrimePlace 2 7) (l : PrimeGeFive) :
    PsiEnvModel v ≃* PsiGauModel v l :=
  MulEquiv.ofBijective (psiEvaluation v l) (psiEvaluation_bijective v l)

theorem psiEnvGauEquiv_apply (v : FinitePrimePlace 2 7) (l : PrimeGeFive)
    (z : PsiEnvModel v) : psiEnvGauEquiv v l z = psiEvaluation v l z := rfl

/-- **The realification of the local Gaussian monoid**: transport the realified
theta coefficient across the evaluation isomorphism. -/
noncomputable def psiGauRealification (v : FinitePrimePlace 2 7) (l : PrimeGeFive) :
    PsiGauModel v l →* Multiplicative NNReal :=
  (psiEnvRealification v).comp (psiEnvGauEquiv v l).symm.toMonoidHom

theorem psiGauRealification_apply (v : FinitePrimePlace 2 7) (l : PrimeGeFive)
    (x : PsiGauModel v l) :
    psiGauRealification v l x = ((psiEnvGauEquiv v l).symm x).2 := rfl

/-- **The evaluation of Corollary 4.6, (iv), intertwines the two realifications**
with no normalization constant: the distinguished element is 1 on both sides. -/
@[simp] theorem psiGauRealification_evaluation (v : FinitePrimePlace 2 7)
    (l : PrimeGeFive) (z : PsiEnvModel v) :
    psiGauRealification v l (psiEvaluation v l z) = psiEnvRealification v z := by
  change psiEnvRealification v ((psiEnvGauEquiv v l).symm ((psiEnvGauEquiv v l) z)) =
    psiEnvRealification v z
  rw [MulEquiv.symm_apply_apply]

/-- The Gaussian realification is surjective onto the ray R_{≥0}. -/
theorem psiGauRealification_surjective (v : FinitePrimePlace 2 7) (l : PrimeGeFive) :
    Function.Surjective (psiGauRealification v l) :=
  (psiEnvRealification_surjective v).comp (psiEnvGauEquiv v l).symm.surjective

/-- The Gaussian realification kills the constant factor. -/
@[simp] theorem psiGauRealification_unitSection (v : FinitePrimePlace 2 7)
    (l : PrimeGeFive) (u : PsiCnsUnits v) :
    psiGauRealification v l (psiGauUnitSection v l u) = 1 := by
  rw [← psiEvaluation_unitSection v l u, psiGauRealification_evaluation,
    psiEnvRealification_unitSection]

/-- The Gaussian realification is the identity on the Gaussian ray. -/
@[simp] theorem psiGauRealification_raySection (v : FinitePrimePlace 2 7)
    (l : PrimeGeFive) (c : Multiplicative NNReal) :
    psiGauRealification v l (psiGauRaySection v l c) = c := by
  change psiGauRealification v l (psiEvaluation v l (psiEnvRaySection v c)) = c
  rw [psiGauRealification_evaluation, psiEnvRealification_raySection]

/-- The evaluation image of the formal generator maps to the distinguished
element 1 of the realified Gaussian monoid. -/
@[simp] theorem psiGauRealification_generator (v : FinitePrimePlace 2 7)
    (l : PrimeGeFive) :
    psiGauRealification v l (psiEvaluation v l (localThetaGenerator v)) =
      Multiplicative.ofAdd (1 : NNReal) := by
  rw [psiGauRealification_evaluation, psiEnvRealification_generator]

/-- Every element of the local Gaussian model is the product of its constant
factor and its Gaussian-ray factor. -/
theorem psiGauRealification_decompose (v : FinitePrimePlace 2 7) (l : PrimeGeFive)
    (x : PsiGauModel v l) :
    x = psiGauUnitSection v l ((psiEnvGauEquiv v l).symm x).1 *
      psiGauRaySection v l ((psiEnvGauEquiv v l).symm x).2 := by
  conv_lhs => rw [← MulEquiv.apply_symm_apply (psiEnvGauEquiv v l) x]
  have h := psiEnvRealification_decompose v ((psiEnvGauEquiv v l).symm x)
  conv_lhs => rw [h]
  simp only [psiEnvGauEquiv_apply, psiEvaluation_unitSection, psiEvaluation_raySection]

/-- **Universal property of the Gaussian realification.**  Any monoid hom out of
the local Gaussian model that kills the constant factor factors through the
realification. -/
theorem psiGauRealification_unique {N : Type*} [Monoid N]
    (v : FinitePrimePlace 2 7) (l : PrimeGeFive) (h : PsiGauModel v l →* N)
    (hh : ∀ u : PsiCnsUnits v, h (psiGauUnitSection v l u) = 1)
    (x : PsiGauModel v l) :
    h x = h (psiGauRaySection v l (psiGauRealification v l x)) := by
  conv_lhs => rw [psiGauRealification_decompose v l x]
  rw [map_mul, hh, one_mul, psiGauRealification_apply]

/-- The factorization form of the Gaussian universal property. -/
theorem psiGauRealification_factors {N : Type*} [Monoid N]
    (v : FinitePrimePlace 2 7) (l : PrimeGeFive) (h : PsiGauModel v l →* N)
    (hh : ∀ u : PsiCnsUnits v, h (psiGauUnitSection v l u) = 1) :
    h = (h.comp (psiGauRaySection v l)).comp (psiGauRealification v l) := by
  ext x
  exact psiGauRealification_unique v l h hh x

/-- The summary form of the paper's realification operation on the local theta
monoid at a one-column place. -/
theorem psiEnvRealification_is_paper_realification (v : FinitePrimePlace 2 7) :
    Function.Surjective (psiEnvRealification v) ∧
      (∀ u : PsiCnsUnits v, psiEnvRealification v (psiEnvUnitSection v u) = 1) ∧
      (∀ c : Multiplicative NNReal, psiEnvRealification v (psiEnvRaySection v c) = c) ∧
      (∀ z : PsiEnvModel v, psiEnvRealification v z = z.2) ∧
      (psiEnvRealification v (localThetaGenerator v) =
        Multiplicative.ofAdd (1 : NNReal)) :=
  ⟨psiEnvRealification_surjective v, psiEnvRealification_unitSection v,
    psiEnvRealification_raySection v, psiEnvRealification_apply v,
    psiEnvRealification_generator v⟩

/-- The summary form of the paper's realification operation on the local
Gaussian monoid at a one-column place, including the compatibility with the
evaluation isomorphism of Corollary 4.6, (iv). -/
theorem psiGauRealification_is_paper_realification (v : FinitePrimePlace 2 7)
    (l : PrimeGeFive) :
    Function.Surjective (psiGauRealification v l) ∧
      (∀ u : PsiCnsUnits v, psiGauRealification v l (psiGauUnitSection v l u) = 1) ∧
      (∀ c : Multiplicative NNReal,
        psiGauRealification v l (psiGauRaySection v l c) = c) ∧
      (∀ z : PsiEnvModel v,
        psiGauRealification v l (psiEvaluation v l z) = psiEnvRealification v z) ∧
      (psiGauRealification v l (psiEvaluation v l (localThetaGenerator v)) =
        Multiplicative.ofAdd (1 : NNReal)) :=
  ⟨psiGauRealification_surjective v l, psiGauRealification_unitSection v l,
    psiGauRealification_raySection v l, psiGauRealification_evaluation v l,
    psiGauRealification_generator v l⟩

/-! ## 3. The local realified monoid family -/

/-- **The local realified monoid family** of a coric vertex: at every place, a
commutative monoid isomorphic to the ray R_{≥0}, together with the realification
map from the local theta/Gaussian monoid.  This is the local data of IUT II,
Corollary 4.6, (v). -/
structure LocalRealifiedFamily (V : Type*) (Psi : V → Type*)
    [∀ v, CommMonoid (Psi v)] where
  /-- the realified local monoid Phi(C,v) -/
  M : V → Type
  [commMonoidM : ∀ v, CommMonoid (M v)]
  /-- Phi(C,v) ≅ R_{≥0} -/
  equiv : ∀ v, M v ≃* Multiplicative NNReal
  /-- the realification Ψ_v → Phi(C,v) -/
  realification : ∀ v, Psi v →* M v
  /-- the realification is onto the ray -/
  realification_surjective : ∀ v, Function.Surjective (realification v)

attribute [instance] LocalRealifiedFamily.commMonoidM

/-- **The local realified monoid family of C^⊩env** at the one-column places,
with the realification psiEnvRealification of Corollary 4.6, (v). -/
noncomputable def envLocalFamily :
    LocalRealifiedFamily (FinitePrimePlace 2 7) (fun v => PsiEnvModel v) where
  M := fun _ => Multiplicative NNReal
  equiv := fun _ => MulEquiv.refl _
  realification := psiEnvRealification
  realification_surjective := psiEnvRealification_surjective

/-- **The local realified monoid family of C^⊩gau** at the one-column places,
with the realification psiGauRealification transported across the evaluation. -/
noncomputable def gauLocalFamily (l : PrimeGeFive) :
    LocalRealifiedFamily (FinitePrimePlace 2 7) (fun v => PsiGauModel v l) where
  M := fun _ => Multiplicative NNReal
  equiv := fun _ => MulEquiv.refl _
  realification := fun v => psiGauRealification v l
  realification_surjective := fun v => psiGauRealification_surjective v l

/-- **The local theta/Gaussian model package**: at every place, a monoid with its
constant (ind-topological) factor, its ray, and the realification of IUT II,
Corollary 4.5, (v).  This is the exact shape of the local data at the places of
the Θ-bridge. -/
structure LocalThetaModelFamily (V : Type*) where
  /-- the local theta (or Gaussian) monoid -/
  Theta : V → Type
  commMonoid : ∀ v, CommMonoid (Theta v)
  /-- its constant (ind-topological) factor -/
  Constant : V → Type
  groupConstant : ∀ v, Group (Constant v)
  constant : ∀ v, Constant v →* Theta v
  /-- its ray R_{≥0} -/
  ray : ∀ v, Multiplicative NNReal →* Theta v
  /-- the realification of Corollary 4.5, (v) -/
  realification : ∀ v, Theta v →* Multiplicative NNReal
  /-- every element is a constant factor times a ray element -/
  decompose : ∀ v (x : Theta v), ∃ (u : Constant v) (c : Multiplicative NNReal),
    x = constant v u * ray v c
  /-- the constant factor is killed -/
  realification_constant : ∀ v (u : Constant v), realification v (constant v u) = 1
  /-- the ray is the identity -/
  realification_ray : ∀ v (c : Multiplicative NNReal), realification v (ray v c) = c

/-- **The one-column realization of the theta model package** (C^⊩env). -/
noncomputable def envOneColumnThetaModelFamily :
    LocalThetaModelFamily (FinitePrimePlace 2 7) where
  Theta := fun v => PsiEnvModel v
  commMonoid := fun _ => inferInstance
  Constant := fun v => PsiCnsUnits v
  groupConstant := fun _ => inferInstance
  constant := fun v => psiEnvUnitSection v
  ray := fun v => psiEnvRaySection v
  realification := fun v => psiEnvRealification v
  decompose := fun v x => ⟨x.1, x.2, psiEnvRealification_decompose v x⟩
  realification_constant := fun v u => psiEnvRealification_unitSection v u
  realification_ray := fun v c => psiEnvRealification_raySection v c

/-- **The one-column realization of the theta model package** (C^⊩gau). -/
noncomputable def gauOneColumnThetaModelFamily (l : PrimeGeFive) :
    LocalThetaModelFamily (FinitePrimePlace 2 7) where
  Theta := fun v => PsiGauModel v l
  commMonoid := fun _ => inferInstance
  Constant := fun v => PsiCnsUnits v
  groupConstant := fun _ => inferInstance
  constant := fun v => psiGauUnitSection v l
  ray := fun v => psiGauRaySection v l
  realification := fun v => psiGauRealification v l
  decompose := fun v x =>
    ⟨((psiEnvGauEquiv v l).symm x).1, ((psiEnvGauEquiv v l).symm x).2,
      psiGauRealification_decompose v l x⟩
  realification_constant := fun v u => psiGauRealification_unitSection v l u
  realification_ray := fun v c => psiGauRealification_raySection v l c

/-! ## 4. The one-column C^⊩env / C^⊩gau carriers -/

/-- The height-one prime of ℤ at a one-column place (the rational prime v.1). -/
noncomputable def oneColumnPrime (v : FinitePrimePlace 2 7) :
    HeightOneSpectrum (𝓞 ℚ) := by
  letI : Fact (Nat.Prime v.1) := ⟨v.2.2.2⟩
  exact rationalHeightOneSpectrum v.1

/-- The actual one-column C-mod: the realified arithmetic Frobenioid of the
rational base field (whose places are exactly the one-column theta places). -/
noncomputable def oneColumnGlobal : Iut.FrobenioidPresentation :=
  numberFieldFrobenioidPresentationRealified (F := ℚ)

/-- The local divisor component of the one-column C-mod at a one-column place:
the actual v-supported realified effective divisor monoid. -/
noncomputable def oneColumnComponent (v : FinitePrimePlace 2 7) :
    AddSubmonoid (RealEffectiveDivisor (F := ℚ)) :=
  finitePlaceComponent (F := ℚ) (oneColumnPrime v)

/-- The local divisor monoid is the ray R_{≥0}: read the coefficient at v. -/
noncomputable def oneColumnComponentEquiv (v : FinitePrimePlace 2 7) :
    oneColumnComponent v ≃+ NNReal :=
  finitePlaceComponentEquiv (F := ℚ) (oneColumnPrime v)

/-- The generator of the local divisor monoid: the prime divisor at v with
coefficient one. -/
noncomputable def oneColumnPrimeGenerator (v : FinitePrimePlace 2 7) :
    oneColumnComponent v := by
  letI : Fact (Nat.Prime v.1) := ⟨v.2.2.2⟩
  refine ⟨(Finsupp.single (oneColumnPrime v) (1 : NNReal), 0), ?_⟩
  refine ⟨?_, rfl⟩
  intro q hq
  have hq' : q ∈ Finsupp.support
      (Finsupp.single (oneColumnPrime v) (1 : NNReal)) := hq
  rw [Finsupp.support_single _ one_ne_zero] at hq'
  simpa using hq'

/-- The local divisor generator is normalized to 1 in R_{≥0}. -/
theorem oneColumnComponentEquiv_prime (v : FinitePrimePlace 2 7) :
    oneColumnComponentEquiv v (oneColumnPrimeGenerator v) = 1 := by
  letI : Fact (Nat.Prime v.1) := ⟨v.2.2.2⟩
  change Finsupp.single (oneColumnPrime v) (1 : NNReal) (oneColumnPrime v) = 1
  simp

/-- **The one-column C^⊩env carrier.**  The F^⊩-prime-strip with
* the actual one-column C-mod as global realified Frobenioid,
* the actual local divisor components (≅ R_{≥0}),
* S1978's actual local O^× F^†-strip as the F^† part,
* the constructed realified local theta monoid family of C^⊩env and its
  identification rho with the local divisor monoids. -/
noncomputable def oneColumnEnvDoublePlus :
    FDoublePlusPrimeStrip (FinitePrimePlace 2 7) where
  global := oneColumnGlobal
  basePoint := SourceModelBackend.bottomPoint
  primeIndex := FinitePrimePlace 2 7
  primeEquiv := Equiv.refl _
  localDivisor := fun v => oneColumnComponent v
  localDivisorEquiv := fun v => oneColumnComponentEquiv v
  fDagger := localOFieldStrip
  localRealified := fun v => EnvRealified v
  commMonoidLocalRealified := fun _ => inferInstance
  localRealifiedEquiv := fun v => envRealifiedEquiv v
  rho := fun v =>
    (addEquivToMulEquiv (oneColumnComponentEquiv v)).trans (envRealifiedEquiv v).symm

/-- **The one-column C^⊩gau carrier**, with the realified local Gaussian family
transported across the evaluation isomorphism. -/
noncomputable def oneColumnGauDoublePlus (l : PrimeGeFive) :
    FDoublePlusPrimeStrip (FinitePrimePlace 2 7) where
  global := oneColumnGlobal
  basePoint := SourceModelBackend.bottomPoint
  primeIndex := FinitePrimePlace 2 7
  primeEquiv := Equiv.refl _
  localDivisor := fun v => oneColumnComponent v
  localDivisorEquiv := fun v => oneColumnComponentEquiv v
  fDagger := localOFieldStrip
  localRealified := fun v => GauRealified v l
  commMonoidLocalRealified := fun _ => inferInstance
  localRealifiedEquiv := fun v => gauRealifiedEquiv v l
  rho := fun v =>
    (addEquivToMulEquiv (oneColumnComponentEquiv v)).trans (gauRealifiedEquiv v l).symm

/-- The global Frobenioid of the one-column env carrier is the one-column C-mod. -/
@[simp] theorem oneColumnEnvDoublePlus_global :
    oneColumnEnvDoublePlus.global = oneColumnGlobal := rfl

/-- Its local realified monoid at v is the constructed realified theta monoid. -/
@[simp] theorem oneColumnEnvDoublePlus_localRealified (v : FinitePrimePlace 2 7) :
    oneColumnEnvDoublePlus.localRealified v = EnvRealified v := rfl

/-- **The constructed identification of the env carrier**: the local realified
monoid is the realification of the local theta monoid at v, and the identification
reads off the theta coefficient. -/
theorem oneColumnEnvDoublePlus_identification (v : FinitePrimePlace 2 7)
    (z : PsiEnvModel v) :
    oneColumnEnvDoublePlus.localRealifiedEquiv v (psiEnvRealification v z) = z.2 := rfl

/-- The local isomorphism rho of the env carrier sends the local divisor
generator to the distinguished element 1, the image of log(p_v)·log(Θ). -/
theorem oneColumnEnvDoublePlus_rho_prime (v : FinitePrimePlace 2 7) :
    oneColumnEnvDoublePlus.rho v
        (Multiplicative.ofAdd (oneColumnPrimeGenerator v)) =
      Multiplicative.ofAdd (1 : NNReal) := by
  change addEquivToMulEquiv (oneColumnComponentEquiv v)
      (Multiplicative.ofAdd (oneColumnPrimeGenerator v)) =
    Multiplicative.ofAdd (1 : NNReal)
  simp [addEquivToMulEquiv, oneColumnComponentEquiv_prime]

/-- The local isomorphism rho is exactly the local divisor equivalence transported
to the constructed realified theta monoid. -/
theorem oneColumnEnvDoublePlus_rho_apply (v : FinitePrimePlace 2 7)
    (x : Multiplicative (oneColumnComponent v)) :
    oneColumnEnvDoublePlus.rho v x =
      envRealifiedEquiv v (addEquivToMulEquiv (oneColumnComponentEquiv v) x) := rfl

/-- The global Frobenioid of the one-column gau carrier is the one-column C-mod. -/
@[simp] theorem oneColumnGauDoublePlus_global (l : PrimeGeFive) :
    (oneColumnGauDoublePlus l).global = oneColumnGlobal := rfl

/-- Its local realified monoid at v is the constructed realified Gaussian monoid. -/
@[simp] theorem oneColumnGauDoublePlus_localRealified (l : PrimeGeFive)
    (v : FinitePrimePlace 2 7) :
    (oneColumnGauDoublePlus l).localRealified v = GauRealified v l := rfl

/-- **The constructed identification of the gau carrier**: the local realified
monoid is the realification of the local Gaussian monoid at v, obtained from the
env realification through the evaluation isomorphism. -/
theorem oneColumnGauDoublePlus_identification (l : PrimeGeFive)
    (v : FinitePrimePlace 2 7) (z : PsiEnvModel v) :
    (oneColumnGauDoublePlus l).localRealifiedEquiv v
        (psiGauRealification v l (psiEvaluation v l z)) = z.2 := by
  rw [psiGauRealification_evaluation]
  rfl

/-- The local isomorphism rho of the gau carrier sends the local divisor
generator to the distinguished element 1. -/
theorem oneColumnGauDoublePlus_rho_prime (l : PrimeGeFive)
    (v : FinitePrimePlace 2 7) :
    (oneColumnGauDoublePlus l).rho v
        (Multiplicative.ofAdd (oneColumnPrimeGenerator v)) =
      Multiplicative.ofAdd (1 : NNReal) := by
  change addEquivToMulEquiv (oneColumnComponentEquiv v)
      (Multiplicative.ofAdd (oneColumnPrimeGenerator v)) =
    Multiplicative.ofAdd (1 : NNReal)
  simp [addEquivToMulEquiv, oneColumnComponentEquiv_prime]

/-- The local isomorphism rho of the gau carrier is exactly the local divisor
equivalence transported to the constructed realified Gaussian monoid. -/
theorem oneColumnGauDoublePlus_rho_apply (l : PrimeGeFive)
    (v : FinitePrimePlace 2 7) (x : Multiplicative (oneColumnComponent v)) :
    (oneColumnGauDoublePlus l).rho v x =
      gauRealifiedEquiv v l (addEquivToMulEquiv (oneColumnComponentEquiv v) x) := rfl

/-! ## 5. The exact first missing at the actual Fmod places -/

/-- **The carrier over the actual Fmod place set with the constant realified
family.**  The local realified monoid of C^env/C^gau is R_{≥0} at every place
(Corollary 4.6, (v)), so the carrier slots are filled by the constant family.
This is literally S1965's paperModFDoublePlus; the carrier slots are therefore
not the missing datum. -/
noncomputable def paperConstantRealifiedCarrier (D : S1895PaperInput) :
    FDoublePlusPrimeStrip (NumberFieldPlace (PaperFmod D)) :=
  paperCoricDoublePlusOfLocalMonoids D (fun _ => Multiplicative NNReal)
    (fun _ => MulEquiv.refl _)

/-- The constant-family carrier over Fmod is exactly S1965's actual C-mod carrier. -/
theorem paperConstantRealifiedCarrier_eq_mod (D : S1895PaperInput) :
    paperConstantRealifiedCarrier D = paperModFDoublePlus D :=
  (paperCoricDoublePlusOfLocalMonoids_refl D).symm

/-- **The exact missing datum at the actual Fmod places**: at every place of the
Θ-bridge base field Fmod, the local theta/Gaussian monoid with its constant
(ind-topological) factor, its ray, and the realification of IUT II,
Corollary 4.5, (v) / 4.6, (v).  S1966/S1973 construct the models only at the
one-column rational places; in particular the archimedean places v ∈ Varc
(∞Ψ) are not covered, and Ψ_cns itself is the first missing object of S1973.
No inhabitant of this Fmod-indexed package is constructed, and no theorem
consumes one. -/
abbrev FmodLocalThetaModel (D : S1895PaperInput) : Type 1 :=
  LocalThetaModelFamily (NumberFieldPlace (PaperFmod D))

/-- The one-column package is inhabited (C^⊩env), which shows that the shape of
FmodLocalThetaModel is the right one and that the missing datum is the
Fmod-indexed local monoid, not the package. -/
noncomputable def fmodLocalThetaModel_oneColumnEnv :
    LocalThetaModelFamily (FinitePrimePlace 2 7) :=
  envOneColumnThetaModelFamily

/-- The one-column package is inhabited (C^⊩gau). -/
noncomputable def fmodLocalThetaModel_oneColumnGau (l : PrimeGeFive) :
    LocalThetaModelFamily (FinitePrimePlace 2 7) :=
  gauOneColumnThetaModelFamily l


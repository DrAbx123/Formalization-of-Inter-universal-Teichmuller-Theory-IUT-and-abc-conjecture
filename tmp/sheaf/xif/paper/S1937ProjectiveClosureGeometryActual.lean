/-! ## 8. Density of the affine chart from the irreducibility of the curve

The density residual of S1925 is the statement that the curve is irreducible at the affine
chart.  Here it is reduced to the single algebraic statement that the homogeneous coordinate
ring is a domain, i.e. that the homogeneous Weierstrass polynomial is irreducible: in a graded
domain the generic point `(0)` is a point of `Proj`, so every nonempty open set of the
projective closure contains it. -/

section Density

variable [GradedRing (CohomGr (R := S1726K) Wang)]

/-- Evaluation at the affine point (1:0:1) of the projective closure. -/
def S1937PointOneEval : W →+* S1726K :=
  Ideal.Quotient.lift (relIdeal Wang)
    (MvPolynomial.eval (fun i : Fin 3 => ![(1 : S1726K), 0, 1] i)) (by
      intro a ha
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp ha
      rw [map_mul, show MvPolynomial.eval (fun i : Fin 3 => ![(1 : S1726K), 0, 1] i) Wang = 0 from by
        simp [Wang]
        norm_num, zero_mul])

theorem S1937PointOneEval_Zbar : S1937PointOneEval Zbar = 1 := by
  rw [Zbar, S1937PointOneEval, show quo Wang (MvPolynomial.X 2) =
    Ideal.Quotient.mk (relIdeal Wang) (MvPolynomial.X 2) from rfl, Ideal.Quotient.lift_mk]
  simp

/-- The class of Z does not vanish in the homogeneous coordinate ring (it is 1 at the point
(1:0:1) of the curve). -/
theorem S1937Zbar_ne_zero : Zbar ≠ 0 := by
  intro h
  have h1 := S1937PointOneEval_Zbar
  rw [h, map_zero] at h1
  exact zero_ne_one h1

theorem S1937Zbar_mem_irrelevant : Zbar ∈ (HomogeneousIdeal.irrelevant WGr).toIdeal := by
  rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff]
  rw [GradedRing.proj_apply]
  rw [DirectSum.decompose_of_mem_ne WGr Zbar_mem_one (by norm_num : (1 : ℕ) ≠ 0)]

/-- **The generic point of the projective closure**, when the homogeneous coordinate ring is a
domain. -/
theorem S1937DenseChart_of_domain (hdom : IsDomain W) : S1925DenseChart := by
  classical
  haveI := hdom
  have hrel : ¬ (HomogeneousIdeal.irrelevant WGr) ≤ (⊥ : HomogeneousIdeal WGr) := by
    intro hle
    have hmem : Zbar ∈ (⊥ : HomogeneousIdeal WGr).toIdeal := hle S1937Zbar_mem_irrelevant
    rw [HomogeneousIdeal.toIdeal_bot] at hmem
    exact S1937Zbar_ne_zero hmem
  let p0 : S1925Proj := ⟨⊥, by rw [HomogeneousIdeal.toIdeal_bot]; exact Ideal.isPrime_bot, hrel⟩
  have hp0r : ∀ r : W, p0 ∈ Proj.basicOpen WGr r ↔ r ≠ 0 := by
    intro r
    rw [Proj.mem_basicOpen]
    constructor
    · intro h hr
      exact h (by rw [hr]; exact zero_mem _)
    · intro hr hmem
      exact hr hmem
  refine dense_iff_inter_open.mpr ?_
  intro U hU hUne
  obtain ⟨y, hy⟩ := hUne
  obtain ⟨U', hU'mem, hyU', hU'U⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Proj.isBasis_basicOpen WGr) (U := ⟨U, hU⟩) (x := y) hy
  obtain ⟨r, rfl⟩ := hU'mem
  have hmem := (Proj.mem_basicOpen WGr r y).mp hyU'
  have hr : r ≠ 0 := by
    intro hr0
    exact hmem (by rw [hr0]; exact zero_mem _)
  refine ⟨p0, hU'U (by rw [hp0r]; exact hr), ?_⟩
  change p0 ∈ Proj.basicOpen WGr Zbar
  rw [hp0r]
  exact S1937Zbar_ne_zero

end Density


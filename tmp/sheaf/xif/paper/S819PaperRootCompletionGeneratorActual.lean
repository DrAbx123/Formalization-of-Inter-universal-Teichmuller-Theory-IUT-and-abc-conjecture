import tmp.sheaf.xif.paper.S815PaperScalingDataFiniteLActual
/-! # S819: local completion generator at cRoot = order/(2l)
The paper scaling data requires g with norm p^(-cRoot).  In the normalized
completion the norm value group is generated by p^(-1/e); existence is exactly
cRoot in (1/e) Z.  The value-group characterization is recorded as an exact
hypothesis; no completion root is fabricated. -/
noncomputable section
open scoped BigOperators
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 4000000
namespace LeanFormal.IUT.XiFPaper.S819PaperRootCompletionGeneratorActual
open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.QVFamTensorCoefficientActual
open LeanFormal.IUT.XiFPaper.QVFamRootFactorCorrectionActual
open LeanFormal.IUT.XiFPaper.QPilotZeroLocusDivisorActual
open LeanFormal.IUT.LocalFieldLogarithm
open LeanFormal.IUT.XiFPaper.BadPlacePaperRootThetaHullActual
open MeasureTheory
universe u
variable {l : PrimeGeFive}
variable (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]
variable [∀ b : Bad (nativePlaceSelection T), MeasurableSpace (qVFamTensorBlock T b)]
variable [∀ b : Bad (nativePlaceSelection T), BorelSpace (qVFamTensorBlock T b)]
variable (b : Bad (nativePlaceSelection T))
/-- Paper cRoot at the unique one-factor place. -/
noncomputable def paperCRoot : Real :=
  paperRootCoefficientFamily (l := l) T b ()
theorem paperCRoot_eq_order_div :
    paperCRoot (l := l) T b =
      ((qVFamily T b).order : Real) / (2 * (l.value : Real)) := by
  unfold paperCRoot paperRootCoefficientFamily qVFamPaperRootCoefficient
  rfl
/-- Ramification exponent of the normalized completion. -/
noncomputable def paperRamificationExponent : Nat :=
  logShellRamificationExponent (K := CommonPrimeCompletion (qVFamTensorPlaces T b () ()))
    (p := qVFamTensorP T b)
/-- Exact local generator datum: a nonzero completion element of norm p^(-cRoot). -/
structure PaperLocalGeneratorData where
  g : CommonPrimeCompletion (qVFamTensorPlaces T b () ())
  g_ne_zero : g ≠ 0
  g_norm : ‖g‖ = (qVFamTensorP T b : Real) ^ (-(paperRootCoefficientFamily (l := l) T b ()))
/-- Exact existence condition. -/
def PaperLocalGeneratorRequired : Prop :=
  Nonempty (PaperLocalGeneratorData (l := l) T b)
/-- Exact value-group characterization of the normalized completion norm. -/
def ValueGroupNormCharacterization : Prop :=
  ∀ x : CommonPrimeCompletion (qVFamTensorPlaces T b () ()), x ≠ 0 →
    ∃ n : ℤ, ‖x‖ = (qVFamTensorP T b : Real) ^
      (-(n : Real) / (paperRamificationExponent T b : Real))
/-- Value-group membership condition for cRoot. -/
def PaperRootInValueGroup : Prop :=
  ∃ n : ℤ, paperCRoot (l := l) T b =
    (n : Real) / (paperRamificationExponent (l := l) T b : Real)
/-- Exact no-go condition. -/
def PaperRootValueGroupNoGo : Prop :=
  ¬ PaperRootInValueGroup (l := l) T b
/-- Conditional actual no-go: value-group characterization plus nonmembership
implies no local generator. -/
theorem noLocalGenerator_of_valueGroupNoGo
    (hVG : ValueGroupNormCharacterization (l := l) T b)
    (hno : PaperRootValueGroupNoGo (l := l) T b) :
    ¬ PaperLocalGeneratorRequired (l := l) T b := by
  rintro ⟨D⟩
  obtain ⟨n, hn⟩ := hVG D.g D.g_ne_zero
  apply hno
  refine ⟨n, ?_⟩
  have hp : (0 : Real) < (qVFamTensorP T b : Real) :=
    by exact_mod_cast (Fact.out : Nat.Prime (qVFamTensorP T b)).pos
  have hpne : (qVFamTensorP T b : Real) ≠ 1 :=
    by exact_mod_cast (Fact.out : Nat.Prime (qVFamTensorP T b)).ne_one
  have hnormEq : (qVFamTensorP T b : Real) ^ (-(paperCRoot (l := l) T b)) =
      (qVFamTensorP T b : Real) ^ (-(n : Real) /
        (paperRamificationExponent T b : Real)) := by
    simpa [paperCRoot, D.g_norm] using hn
  have hexp := (Real.rpow_right_inj hp hpne).mp hnormEq
  rw [neg_div] at hexp
  exact neg_inj.mp hexp
end LeanFormal.IUT.XiFPaper.S819PaperRootCompletionGeneratorActual

import tmp.sheaf.xif.paper.S142NormalizedBoundaryLogVolumeActual

/-! # S143d: quotient normalized log-volume by the actual unit-log correction

The normalized boundary log changes under uniformizer change by the actual
unit-log difference unitLog u - unitLog u'.  This file constructs the actual
additive subgroup

  unitLogRange = range(unitLog)

and the quotient normalized log-volume

  K ⧸ unitLogRange.

The uniformizer-change difference lies in unitLogRange, so the quotient
normalized log-volume is well-defined independent of the chosen uniformizer.
The integer formal-logPi coordinate is separate and is not quotiented here.

No fake quotient/sorry/axiom/True/PUnit. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.S143dQuotientLogVolumeActual

open LeanFormal.IUT
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.LocalFieldLogarithm
open LeanFormal.IUT.XiFPaper.S63OBoundaryLogShellActual
open LeanFormal.IUT.XiFPaper.S101UniformizerChangeActual
open LeanFormal.IUT.XiFPaper.S111FormalBoundaryLogActual
open LeanFormal.IUT.XiFPaper.S132FormalLogVolumeActual
open LeanFormal.IUT.XiFPaper.S126FormalBoundaryLogUseActual
open LeanFormal.IUT.XiFPaper.S142NormalizedBoundaryLogVolumeActual

universe u

variable {K : Type u} [Field K] [NumberField K]
variable {p : Nat} [Fact p.Prime]
variable (place : FinitePlaceAtPrime K p)

/-- Actual additive subgroup of K generated by all unit logarithms. -/
noncomputable def unitLogRange :
    AddSubgroup (CommonPrimeCompletion place) where
  carrier := Set.range (unitLog (K := CommonPrimeCompletion place))
  zero_mem' := ⟨1, unitLog_one (K := CommonPrimeCompletion place) (p := p)⟩
  add_mem' := by
    rintro _ _ ⟨u, rfl⟩ ⟨v, rfl⟩
    exact ⟨u * v, unitLog_mul (K := CommonPrimeCompletion place) (p := p) u v⟩
  neg_mem' := by
    rintro _ ⟨u, rfl⟩
    exact ⟨u⁻¹, unitLog_inv (K := CommonPrimeCompletion place) (p := p) u⟩

/-- Membership in the unit-log correction subgroup. -/
theorem unitLog_mem_range
    (u : (Integers (CommonPrimeCompletion place))ˣ) :
    unitLog (K := CommonPrimeCompletion place) u ∈
      unitLogRange (K := K) (p := p) place :=
  ⟨u, rfl⟩

/-- Quotient normalized log-volume: K modulo the actual unit-log corrections. -/
noncomputable def normalizedLogVolumeQuot
    (pi : Integers (CommonPrimeCompletion place)) (hpi : Irreducible pi)
    (x : sourceOBoundaryMonoid (K := K) (p := p) place) :
    (CommonPrimeCompletion place) ⧸ unitLogRange (K := K) (p := p) place :=
  QuotientAddGroup.mk'
    (unitLogRange (K := K) (p := p) place)
    (boundaryLogFormalFor place pi hpi x).1

/-- The quotient normalized log-volume is independent of the chosen
uniformizer. -/
theorem normalizedLogVolumeQuot_uniformizer_invariant
    (pi pi' : Integers (CommonPrimeCompletion place))
    (hpi : Irreducible pi) (hpi' : Irreducible pi')
    (x : sourceOBoundaryMonoid (K := K) (p := p) place) :
    normalizedLogVolumeQuot (K := K) (p := p) place pi hpi x =
      normalizedLogVolumeQuot (K := K) (p := p) place pi' hpi' x := by
  unfold normalizedLogVolumeQuot
  apply (QuotientAddGroup.eq_iff_sub_mem).mpr
  rw [boundaryLogFormalFor_change_normalized]
  exact AddSubgroup.sub_mem _
    (unitLog_mem_range (K := K) (p := p) place _)
    (unitLog_mem_range (K := K) (p := p) place _)

end LeanFormal.IUT.XiFPaper.S143dQuotientLogVolumeActual

end

import tmp.sheaf.xif.paper.Node09H1aMaximalIdealValuationActual
import LeanFormal.IUT.Foundations.LocalFields.IntegralLogShellRamificationInertia
import Mathlib.RingTheory.Valuation.Discrete.IsDiscreteValuationRing
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Node09H1aDVRPrincipalIdealActual
open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.XiFPaper.Node09H1aMaximalIdealValuationActual
open scoped NNReal
variable {p : Nat} [Fact p.Prime] {J : Type} [Fintype J]
variable (E : J → Type)
variable [∀ j, NontriviallyNormedField (E j)]
variable [∀ j, NormedAlgebra ℚ_[p] (E j)]
variable [∀ j, FiniteDimensional ℚ_[p] (E j)]
variable [∀ j, CompleteSpace (E j)] [∀ j, IsUltrametricDist (E j)]
/-- The DVR integer ring is a principal ideal ring. -/
theorem isPrincipalIdealRing_integers (p : Nat) [Fact p.Prime] (j : J) :
    IsPrincipalIdealRing (Integers (E j)) := by
  letI : CharZero (E j) :=
    charZero_of_injective_algebraMap (algebraMap ℚ_[p] (E j)).injective
  letI : ProperSpace (E j) := FiniteDimensional.proper ℚ_[p] (E j)
  letI : IsDiscreteValuationRing (Integers (E j)) :=
    isDiscreteValuationRingIntegers (K := E j) (p := p)
  exact (inferInstanceAs (IsDiscreteValuationRing (Integers (E j)))).toIsPrincipalIdealRing
/-- Every ideal is principal, generated by a single element. -/
theorem ideal_eq_span_singleton (p : Nat) [Fact p.Prime] (j : J)
    (I : Ideal (Integers (E j))) :
    ∃ x : Integers (E j), I = Ideal.span {x} := by
  letI : IsPrincipalIdealRing (Integers (E j)) :=
    isPrincipalIdealRing_integers (E := E) (p := p) j
  obtain ⟨x, hx⟩ := IsPrincipalIdealRing.principal I
  exact ⟨x, hx⟩
#check isPrincipalIdealRing_integers
#check ideal_eq_span_singleton
end LeanFormal.IUT.XiFPaper.Node09H1aDVRPrincipalIdealActual

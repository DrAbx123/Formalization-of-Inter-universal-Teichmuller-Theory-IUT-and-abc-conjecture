import Mathlib.RingTheory.Localization.Ideal
import Mathlib.Data.ZMod.QuotientRing

/-!
# S2578: the degree-one prime of O_F'[1/Cden] over 613

Let S = O_{F'}[1/Cden] (S2565ConcreteIntegralClosureCActual.S), the integral closure of
R = Z[1/Cden] in L = F' = SplittingField S1720H.  The target is a prime ideal P of S
over 613 whose residue field is ZMod 613 (residue degree one).

## What is proved here, unconditionally

* S2578_not_dvd_Cden: 613 is coprime to the localisation denominator Cden = c0 * Dval, so
  613 is not inverted in S.
* S2578_mem_primeField: the abstract splitting/prime-field lemma.  If a monic p : F[X] splits
  completely over a field F and x in an F-algebra domain K satisfies aeval x p = 0, then x is in
  the image of F.  (Applied to the monic model of S2481H613.)
* S2578_exists_prime_over613: a prime ideal P of S lying over (613) exists.  It is obtained by
  lying over in O_{F'} and localising; this uses only that 613 does not divide Cden.
* S2578_root_residue: the Dedekind root-reduction step.  For every root x in S of the integer
  model S2481HZ, the residue of x modulo P lies in the prime field ZMod 613.  This is
  unconditional and holds for every prime P over 613.

## The exact remaining arithmetic input

The only missing input is that the order generated by the roots is 613-saturated in S:

  S2578TameIndex : forall s : S, exists n : Z, exists t : S,
    Int.castRingHom (ZMod 613) n != 0 and t in S2578RootOrder and
    algebraMap Z S n * s = t

i.e. S is contained in S2578RootOrder[1/n] for some n invertible modulo 613 (equivalently: the
index of the root order in S is coprime to 613).  Under this input the full target is proved:

  S2578_prime613_exists : S2578TameIndex -> exists P, P.IsPrime and
    P.LiesOver (span {613}) and Nonempty (S quotient P equiv ZMod 613)

The special case S2578RootOrder = top (the order generated by the roots is all of S, which is
the Aoc2 = S generation statement of the S2567/S2568/S2570 route) gives the same conclusion
from that statement: S2578_prime613_exists_of_rootOrder_top.

No sorry, no axiom, no True/PUnit gate, no native_decide.
-/

noncomputable section

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option linter.unnecessarySimpa false
set_option maxHeartbeats 4000000

open Polynomial

namespace LeanFormal.IUT.XiFPaper.S2578Prime613Actual

open LeanFormal.IUT.XiFPaper.S2481PairTransitiveHardActual
open LeanFormal.IUT.XiFPaper.S2562HZcMonicCActual
open LeanFormal.IUT.XiFPaper.S2565ConcreteIntegralClosureCActual

local instance : Fact (Nat.Prime 613) := ⟨by norm_num⟩

/-! ## 1. The denominator is coprime to 613 -/

theorem S2578_not_dvd_Cden : ¬ (613 : ℤ) ∣ Cden := by
  unfold S2562HZcMonicCActual.Cden S2562HZcMonicCActual.c0 S2562HZcMonicCActual.Dval
  norm_num

theorem S2578_Cden_ne_zero : Cden ≠ 0 := S2562HZcMonicCActual.Cden_ne_zero

/-! ## 2. The monic residue polynomial at 613 -/

lemma S2578H613_leadingCoeff : S2481H613.leadingCoeff = (584 : ZMod 613) := by
  rw [show S2481H613.leadingCoeff = S2481H613.coeff 8 by
    rw [Polynomial.leadingCoeff, S2481H613_natDegree]]
  unfold S2481H613
  simp [Polynomial.coeff_add, Polynomial.coeff_X_pow]

lemma S2578H613_584_ne_zero : (584 : ZMod 613) ≠ 0 := by decide

def S2578f : (ZMod 613)[X] := C ((584 : ZMod 613)⁻¹) * S2481H613

lemma S2578f_monic : S2578f.Monic := by
  rw [S2578f]
  refine Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one ?_
  rw [S2578H613_leadingCoeff, inv_mul_cancel₀ S2578H613_584_ne_zero]

lemma S2578f_splits : S2578f.Splits := by
  rw [S2578f]
  refine Polynomial.Splits.C_mul ?_ _
  rw [← S2481HZ_mod]
  exact S2481HMod613_splits

lemma S2578f_aeval (K : Type*) [CommRing K] [Algebra (ZMod 613) K] (x : K) :
    aeval x S2578f = algebraMap (ZMod 613) K ((584 : ZMod 613)⁻¹) * aeval x S2481H613 := by
  rw [S2578f, map_mul, aeval_C]

lemma S2578f_aeval_eq_zero_iff (K : Type*) [CommRing K] [IsDomain K]
    [Algebra (ZMod 613) K] (x : K) :
    aeval x S2578f = 0 ↔ aeval x S2481H613 = 0 := by
  rw [S2578f_aeval]
  have hu : algebraMap (ZMod 613) K ((584 : ZMod 613)⁻¹) ≠ 0 := by
    intro h
    have h1 : algebraMap (ZMod 613) K ((584 : ZMod 613)⁻¹ * 584) = algebraMap (ZMod 613) K 1 := by
      rw [inv_mul_cancel₀ S2578H613_584_ne_zero, map_one]
    rw [map_mul, h, zero_mul, map_one] at h1
    exact one_ne_zero h1.symm
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h1 | h1
    · exact absurd h1 hu
    · exact h1
  · intro h
    rw [h, mul_zero]

theorem S2578_mem_primeField {F K : Type*} [Field F] [CommRing K] [IsDomain K] [Algebra F K]
    (p : F[X]) (hp : p.Monic) (hs : p.Splits) {x : K}
    (hx : aeval x p = 0) : ∃ c : F, algebraMap F K c = x := by
  obtain ⟨m, hm⟩ := Polynomial.splits_iff_exists_multiset.mp hs
  rw [hp.leadingCoeff, map_one, one_mul] at hm
  have h1 : aeval x p = (m.map (fun b : F => aeval x (X - C b))).prod := by
    rw [hm, map_multiset_prod, Multiset.map_map]
    rfl
  have h2 : ∀ b : F, aeval x (X - C b) = x - algebraMap F K b := by
    intro b; simp
  have hzero : (m.map (fun b : F => x - algebraMap F K b)).prod = 0 := by
    rw [show (m.map (fun b : F => x - algebraMap F K b))
        = m.map (fun b : F => aeval x (X - C b)) from
        Multiset.map_congr rfl (fun b _ => (h2 b).symm), ← h1, hx]
  obtain ⟨b, -, hb⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp hzero)
  exact ⟨b, (sub_eq_zero.mp hb).symm⟩

theorem S2578_mem_primeField_of_root {K : Type*} [CommRing K] [IsDomain K]
    [Algebra (ZMod 613) K] {x : K}
    (hx : aeval x S2481H613 = 0) : ∃ c : ZMod 613, algebraMap (ZMod 613) K c = x :=
  S2578_mem_primeField S2578f S2578f_monic S2578f_splits
    ((S2578f_aeval_eq_zero_iff K x).mpr hx)

/-! ## 3. A prime of S over 613 -/

lemma S2578_span613_isMaximal : (Ideal.span {(613 : ℤ)}).IsMaximal :=
  Int.ideal_span_isMaximal_of_prime 613

lemma S2578_ker_le : RingHom.ker (algebraMap ℤ C) ≤ Ideal.span {(613 : ℤ)} := by
  have hinj : Function.Injective (algebraMap ℤ C) := by
    intro a b hab
    apply hAL_inj
    rw [IsScalarTower.algebraMap_apply ℤ C L, IsScalarTower.algebraMap_apply ℤ C L, hab]
  rw [(RingHom.injective_iff_ker_eq_bot _).mp hinj]
  exact bot_le

theorem S2578_exists_prime_C :
    ∃ p : Ideal C, p.IsPrime ∧ p.LiesOver (Ideal.span {(613 : ℤ)}) := by
  haveI : (Ideal.span {(613 : ℤ)}).IsPrime := S2578_span613_isMaximal.isPrime
  obtain ⟨Q, -, hQprime, hQcomap⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral (R := ℤ) (S := C)
      (Ideal.span {(613 : ℤ)}) (⊥ : Ideal C) S2578_ker_le
  exact ⟨Q, hQprime, ⟨by rw [Ideal.under_def]; exact hQcomap.symm⟩⟩

lemma S2578_algebraMap_c_not_mem (p : Ideal C) (hpp : p.IsPrime)
    (hp : p.LiesOver (Ideal.span {(613 : ℤ)})) :
    algebraMap ℤ C c ∉ p := by
  haveI := hp
  intro h
  have h1 : c ∈ (Ideal.span {(613 : ℤ)} : Ideal ℤ) :=
    (Ideal.mem_of_liesOver p (Ideal.span {(613 : ℤ)}) c).mpr h
  rw [Ideal.mem_span_singleton] at h1
  exact S2578_not_dvd_Cden (by simpa [S2565ConcreteIntegralClosureCActual.c] using h1)

lemma S2578_disjoint (p : Ideal C) (hpp : p.IsPrime)
    (hp : p.LiesOver (Ideal.span {(613 : ℤ)})) :
    Disjoint (Algebra.algebraMapSubmonoid C M : Set C) (p : Set C) := by
  rw [Set.disjoint_left]
  intro x hx hxp
  have hx' : x ∈ M.map (algebraMap ℤ C) := hx
  obtain ⟨a, ha, hxa⟩ := Submonoid.mem_map.mp hx'
  rw [← hxa] at hxp
  obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff a c).mp ha
  have hpow : (algebraMap ℤ C c) ^ n ∈ p := by
    rw [← map_pow, hn]
    exact hxp
  exact S2578_algebraMap_c_not_mem p hpp hp (hpp.mem_of_pow_mem n hpow)

theorem S2578_exists_prime_over613 :
    ∃ P : Ideal S, P.IsPrime ∧ P.LiesOver (Ideal.span {(613 : ℤ)}) := by
  obtain ⟨p, hpp, hpover⟩ := S2578_exists_prime_C
  haveI := hpp
  have hd := S2578_disjoint p hpp hpover
  have hprime : (p.map (algebraMap C S)).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (M := Algebra.algebraMapSubmonoid C M) (S := S)
      p hpp hd
  have hl : (p.map (algebraMap C S)).LiesOver p :=
    IsLocalization.liesOver_map_of_isPrime_disjoint
      (M := Algebra.algebraMapSubmonoid C M) (S := S) hd
  refine ⟨p.map (algebraMap C S), hprime, ⟨? _⟩⟩
  rw [Ideal.under_def]
  rw [IsScalarTower.algebraMap_eq ℤ C S, ← Ideal.comap_comap]
  have h1 : (p.map (algebraMap C S)).comap (algebraMap C S) = p := hl.over.symm
  rw [h1]
  exact hpover.over

/-! ## 4. The canonical map from the prime field -/

noncomputable def S2578lift (P : Ideal S)
    (h613 : algebraMap ℤ S (613 : ℤ) ∈ P) :
    (ℤ ⧸ Ideal.span {(613 : ℤ)}) →+* (S ⧸ P) :=
  Ideal.Quotient.lift (Ideal.span {(613 : ℤ)})
    ((Ideal.Quotient.mk P).comp (algebraMap ℤ S)) (by
      intro a ha
      rw [Ideal.mem_span_singleton] at ha
      obtain ⟨k, rfl⟩ := ha
      simp only [RingHom.comp_apply, map_mul]
      have h0 : Ideal.Quotient.mk P (algebraMap ℤ S (613 : ℤ)) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]; exact h613
      rw [h0, zero_mul])

lemma S2578lift_mk (P : Ideal S)
    (h613 : algebraMap ℤ S (613 : ℤ) ∈ P) (m : ℤ) :
    S2578lift P h613 (Ideal.Quotient.mk (Ideal.span {(613 : ℤ)}) m)
      = Ideal.Quotient.mk P (algebraMap ℤ S m) :=
  Ideal.Quotient.lift_mk _ _ _

noncomputable def S2578primeFieldMap (P : Ideal S)
    (h613 : algebraMap ℤ S (613 : ℤ) ∈ P) : ZMod 613 →+* (S ⧸ P) :=
  (S2578lift P h613).comp ((Int.quotientSpanNatEquivZMod 613).symm : ZMod 613 →+* _)

lemma S2578_zmodSymm_mk (n : ℤ) :
    ((Int.quotientSpanNatEquivZMod 613).symm (Int.castRingHom (ZMod 613) n))
      = Ideal.Quotient.mk (Ideal.span {(613 : ℤ)}) n := by
  have h1 : (Int.quotientSpanNatEquivZMod 613) (Ideal.Quotient.mk (Ideal.span {(613 : ℤ)}) n)
      = Int.castRingHom (ZMod 613) n := by
    have h := congrFun (congrArg DFunLike.coe
      (Int.quotientSpanNatEquivZMod_comp_Quotient_mk 613)) n
    simpa using h
  rw [← h1, RingEquiv.symm_apply_apply]

lemma S2578primeFieldMap_apply (P : Ideal S)
    (h613 : algebraMap ℤ S (613 : ℤ) ∈ P) (n : ℤ) :
    S2578primeFieldMap P h613 (Int.castRingHom (ZMod 613) n)
      = Ideal.Quotient.mk P (algebraMap ℤ S n) := by
  calc S2578primeFieldMap P h613 (Int.castRingHom (ZMod 613) n)
      = S2578lift P h613
          ((Int.quotientSpanNatEquivZMod 613).symm (Int.castRingHom (ZMod 613) n)) := rfl
    _ = S2578lift P h613 (Ideal.Quotient.mk (Ideal.span {(613 : ℤ)}) n) := by
          rw [S2578_zmodSymm_mk]
    _ = Ideal.Quotient.mk P (algebraMap ℤ S n) := S2578lift_mk P h613 n

/-! ## 5. The root order and the tame index input -/

def S2578Roots : Set S := {θ : S | aeval θ (S2481HZ.map (algebraMap ℤ S)) = 0}

def S2578RootOrder : Subalgebra ℤ S := Algebra.adjoin ℤ S2578Roots

def S2578TameIndex : Prop :=
  ∀ s : S, ∃ (n : ℤ) (t : S), Int.castRingHom (ZMod 613) n ≠ 0 ∧ t ∈ S2578RootOrder ∧
    algebraMap ℤ S n * s = t

lemma S2578_mk_aeval_map (P : Ideal S) (p : ℤ[X]) (θ : S) :
    Ideal.Quotient.mk P (aeval θ (p.map (algebraMap ℤ S)))
      = aeval (Ideal.Quotient.mk P θ) (p.map ((Ideal.Quotient.mk P).comp (algebraMap ℤ S))) := by
  have hid : (algebraMap S S) = RingHom.id S := by ext r; simp
  have hid2 : (algebraMap (S ⧸ P) (S ⧸ P)) = RingHom.id (S ⧸ P) := by ext r; simp
  rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map, Polynomial.eval₂_map,
    hid, hid2, RingHom.id_comp, RingHom.id_comp]
  exact Polynomial.hom_eval₂ p (algebraMap ℤ S) (Ideal.Quotient.mk P) θ

lemma S2578_aeval_map_algebraMap {F K : Type*} [CommSemiring F] [CommSemiring K] [Algebra F K]
    (p : F[X]) (x : K) : aeval x (p.map (algebraMap F K)) = aeval x p := by
  have hid : (algebraMap K K) = RingHom.id K := by ext r; simp
  rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map, hid, RingHom.id_comp]

theorem S2578_root_residue (P : Ideal S) (hPp : P.IsPrime)
    (hP : P.LiesOver (Ideal.span {(613 : ℤ)}))
    (h613 : algebraMap ℤ S (613 : ℤ) ∈ P) {θ : S}
    (hθ : aeval θ (S2481HZ.map (algebraMap ℤ S)) = 0) :
    ∃ cc : ZMod 613, Ideal.Quotient.mk P θ = S2578primeFieldMap P h613 cc := by
  haveI := hPp
  letI : Algebra (ZMod 613) (S ⧸ P) := (S2578primeFieldMap P h613).toAlgebra
  have key := S2578_mk_aeval_map P S2481HZ θ
  rw [hθ, map_zero] at key
  have hpoly : S2481HZ.map ((Ideal.Quotient.mk P).comp (algebraMap ℤ S))
      = S2481H613.map (algebraMap (ZMod 613) (S ⧸ P)) := by
    rw [← S2481HZ_mod, Polynomial.map_map]
    congr 1
    exact RingHom.ext_int _ _
  have h0 : aeval (Ideal.Quotient.mk P θ)
      (S2481H613.map (algebraMap (ZMod 613) (S ⧸ P))) = 0 := by
    rw [← hpoly]
    exact key.symm
  have h1 : aeval (Ideal.Quotient.mk P θ) S2481H613 = 0 := by
    rw [← S2578_aeval_map_algebraMap S2481H613 (Ideal.Quotient.mk P θ)]
    exact h0
  obtain ⟨cc, hcc⟩ := S2578_mem_primeField_of_root (K := S ⧸ P) h1
  exact ⟨cc, hcc.symm⟩

/-! ## 6. The main theorem -/

theorem S2578_prime613_exists (h : S2578TameIndex) :
    ∃ P : Ideal S, P.IsPrime ∧ P.LiesOver (Ideal.span {(613 : ℤ)}) ∧
      Nonempty (S ⧸ P ≃+* ZMod 613) := by
  obtain ⟨P, hPprime, hPover⟩ := S2578_exists_prime_over613
  haveI := hPprime
  haveI := hPover
  have h613 : algebraMap ℤ S (613 : ℤ) ∈ P := by
    have hmem : (613 : ℤ) ∈ (Ideal.span {(613 : ℤ)} : Ideal ℤ) :=
      Ideal.subset_span (by simp)
    exact (Ideal.mem_of_liesOver P (Ideal.span {(613 : ℤ)}) (613 : ℤ)).mp hmem
  let Ψ : ZMod 613 →+* (S ⧸ P) := S2578primeFieldMap P h613
  letI : Algebra (ZMod 613) (S ⧸ P) := Ψ.toAlgebra
  have hΨ : ∀ n : ℤ, Ψ (Int.castRingHom (ZMod 613) n) =
      Ideal.Quotient.mk P (algebraMap ℤ S n) := S2578primeFieldMap_apply P h613
  have hone : (1 : S ⧸ P) ≠ 0 := one_ne_zero
  let T' : Subalgebra ℤ S :=
    { carrier := {s : S | ∃ cc : ZMod 613, Ideal.Quotient.mk P s = Ψ cc}
      mul_mem' := by
        rintro a b ⟨ca, ha⟩ ⟨cb, hb⟩
        exact ⟨ca * cb, by rw [map_mul, ha, hb, map_mul]⟩
      one_mem' := ⟨1, by rw [map_one, map_one]⟩
      add_mem' := by
        rintro a b ⟨ca, ha⟩ ⟨cb, hb⟩
        exact ⟨ca + cb, by rw [map_add, ha, hb, map_add]⟩
      zero_mem' := ⟨0, by rw [map_zero, map_zero]⟩
      algebraMap_mem' := by
        intro n
        exact ⟨Int.castRingHom (ZMod 613) n, (hΨ n).symm⟩ }
  have hle : S2578RootOrder ≤ T' := by
    rw [S2578RootOrder, Algebra.adjoin_le_iff]
    intro θ hθ
    exact S2578_root_residue P hPprime hPover h613 hθ
  have hsurj : Function.Surjective Ψ := by
    intro y
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨n, t, hn, ht, hts⟩ := h s
    obtain ⟨ct, hct⟩ := hle ht
    have h1 : Ψ (Int.castRingHom (ZMod 613) n) * Ideal.Quotient.mk P s = Ψ ct := by
      have h2 := congrArg (Ideal.Quotient.mk P) hts
      rw [map_mul] at h2
      rw [← hΨ n] at h2
      rw [hct] at h2
      exact h2
    have hnn : Ψ ((Int.castRingHom (ZMod 613) n)⁻¹) * Ψ (Int.castRingHom (ZMod 613) n) = 1 := by
      rw [← map_mul, inv_mul_cancel₀ hn, map_one]
    have key : Ideal.Quotient.mk P s = Ψ ((Int.castRingHom (ZMod 613) n)⁻¹ * ct) := by
      rw [map_mul]
      calc Ideal.Quotient.mk P s
          = 1 * Ideal.Quotient.mk P s := (one_mul _).symm
        _ = (Ψ ((Int.castRingHom (ZMod 613) n)⁻¹) * Ψ (Int.castRingHom (ZMod 613) n))
              * Ideal.Quotient.mk P s := by rw [hnn]
        _ = Ψ ((Int.castRingHom (ZMod 613) n)⁻¹)
              * (Ψ (Int.castRingHom (ZMod 613) n) * Ideal.Quotient.mk P s) := by
              rw [mul_assoc]
        _ = Ψ ((Int.castRingHom (ZMod 613) n)⁻¹) * Ψ ct := by rw [h1]
    exact ⟨(Int.castRingHom (ZMod 613) n)⁻¹ * ct, key.symm⟩
  have hinj : Function.Injective Ψ := by
    intro a b hab
    by_contra hne
    have hsub : a - b ≠ 0 := sub_ne_zero.mpr hne
    have h0 : Ψ (a - b) = 0 := by rw [map_sub, hab, sub_self]
    have hz : (1 : S ⧸ P) = 0 := by
      calc (1 : S ⧸ P) = Ψ ((a - b) * (a - b)⁻¹) := by rw [mul_inv_cancel₀ hsub, map_one]
        _ = Ψ (a - b) * Ψ ((a - b)⁻¹) := by rw [map_mul]
        _ = 0 := by rw [h0, zero_mul]
    exact hone hz
  exact ⟨P, hPprime, hPover, ⟨(RingEquiv.ofBijective Ψ ⟨hinj, hsurj⟩).symm⟩⟩

theorem S2578_prime613_exists_of_rootOrder_top (h : S2578RootOrder = ⊤) :
    ∃ P : Ideal S, P.IsPrime ∧ P.LiesOver (Ideal.span {(613 : ℤ)}) ∧
      Nonempty (S ⧸ P ≃+* ZMod 613) := by
  refine S2578_prime613_exists ?_
  intro s
  refine ⟨1, s, by decide, ?_, by rw [map_one, one_mul]⟩
  rw [h]
  trivial

/-! ## 7. Axiom footprint -/

#print axioms S2578_mem_primeField
#print axioms S2578_mem_primeField_of_root
#print axioms S2578_exists_prime_over613
#print axioms S2578_root_residue
#print axioms S2578_prime613_exists
#print axioms S2578_prime613_exists_of_rootOrder_top

end LeanFormal.IUT.XiFPaper.S2578Prime613Actual


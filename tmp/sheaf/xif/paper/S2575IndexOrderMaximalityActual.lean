import tmp.sheaf.xif.paper.S2570FiniteEtaleNormalActual
import tmp.sheaf.xif.paper.S2564DiscrUnitActual
import Mathlib.RingTheory.Discriminant
import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.RingTheory.DedekindDomain.Dvr
import Mathlib.RingTheory.DedekindDomain.PID
import Mathlib.LinearAlgebra.Matrix.Module

/-!
# S2575: index / order maximality for the order Aoc2 generated by the roots

## The target

The chain S2565--S2570 has reduced the integral closedness of

  Aoc2 = Algebra.adjoin R (HZc2.rootSet L),   R = Z[1/Cden],   L = S1720Field

to the order-maximality statement

  OrderIsMaximal : forall s : S, algebraMap S L s in Aoc2,

where S = O_L[1/Cden] is the integral closure of R in L (S2555) and
Aoc2 <= S is known (S2566).  This file works on the *index* route:
Aoc2 and S are finite free R-lattices of the same rank in L, so the
quotient S/Aoc2 is a finite torsion R-module and the transition matrix
between suitable bases has a well-defined determinant (the "index").

## What is proved here (unconditional, no sorry / new axiom / True / native_decide)

* the instance bank for R = Z[1/Cden] that Mathlib does not supply:
  Algebra R Q, IsFractionRing R Q, IsIntegrallyClosed R,
  IsScalarTower Z R Q, IsScalarTower R Q L, Algebra.IsSeparable Q L;
* R is a Dedekind domain and a principal ideal ring;
* Module.Finite R S, Module.Free R Aoc2, Module.Free R S,
  Module.Projective R Aoc2, Module.Projective R S;
* the rank equality Module.finrank R Aoc2 = Module.finrank R S
  (= Module.finrank Q L);
* the inclusion Aoc2 <= S viewed as subalgebras of L;
* the discriminant/index relation for arbitrary bases of Aoc2 and S:
  discr Q (a-basis) = (algebraMap R Q det M)^2 * discr Q (S-basis),
  where M is the matrix of the inclusion Aoc2 -> S;
* OrderIsMaximal follows if the determinant of M is a unit of R
  (equivalently if the index ideal is the unit ideal);
* the exact remaining statement, in Lean syntax, as IndexIsUnitGoal
  and its (proved) equivalence with OrderIsMaximal for a fixed pair of
  bases.

## What is *not* proved here

OrderIsMaximal itself (equivalently Aoc2 = S, equivalently
IsIntegrallyClosed Aoc2) is not proved.  The concrete remaining
arithmetic statement is that the index [S : Aoc2] is the unit ideal of
R = Z[1/Cden]; equivalently, that every prime factor of the integer
index [O_L : Z[1/Cden]-order generated by the roots] divides Cden.
Mathlib has the discriminant formalism used below but no general
"index divides a power of the discriminant / conductor" theorem for
multi-generated orders, so this remains the open input.
-/

noncomputable section
set_option maxHeartbeats 16000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

open Polynomial

namespace LeanFormal.IUT.XiFPaper.S2575IndexOrderMaximalityActual

open LeanFormal.IUT.XiFPaper.S2565ConcreteIntegralClosureCActual
open LeanFormal.IUT.XiFPaper.S2562HZcMonicCActual
open LeanFormal.IUT.XiFPaper.S2566AdjoinIntegralCActual
open LeanFormal.IUT.XiFPaper.S2567IsFractionRingAdjoinCActual
open LeanFormal.IUT.XiFPaper.S2570FiniteEtaleNormalActual
open LeanFormal.IUT.XiFPaper.S2564DiscrUnitActual

open scoped Matrix.Module

/-! ## 1. The instance bank: Q as the fraction field of R = Z[1/Cden] -/

/-- The localization map R = Z[1/Cden] -> Q. -/
noncomputable def liftRQ : R →+* ℚ :=
  IsLocalization.lift (M := M) (g := algebraMap ℤ ℚ) (by
    intro m
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff (m : ℤ) c).mp m.2
    have hpow : (algebraMap ℤ ℚ) (m : ℤ) = (algebraMap ℤ ℚ) (c : ℤ) ^ n := by
      rw [← hn, map_pow]
    rw [hpow]
    refine IsUnit.pow n (isUnit_iff_ne_zero.mpr ?_)
    intro h
    exact hcA (IsFractionRing.injective ℤ ℚ (by simpa using h)))

lemma liftRQ_comp : liftRQ.comp (algebraMap ℤ R) = algebraMap ℤ ℚ :=
  IsLocalization.lift_comp _

/-- The R-algebra structure on Q given by the localization map. -/
noncomputable instance instAlgebraRQ : Algebra R ℚ := liftRQ.toAlgebra

/-- Pin the scalar actions to Algebra.toSMul, matching the S2565 file. -/
local instance : SMul ℤ R := Algebra.toSMul
local instance : SMul ℤ ℚ := Algebra.toSMul
local instance : SMul R ℚ := Algebra.toSMul
local instance : SMul ℚ L := Algebra.toSMul
local instance : SMul R L := Algebra.toSMul
local instance : SMul ℤ L := Algebra.toSMul

/-- The tower Z -> R -> Q. -/
theorem isScalarTower_ZRQ : IsScalarTower ℤ R ℚ := by
  apply IsScalarTower.of_algebraMap_eq'
  ext a
  exact (DFunLike.congr_fun liftRQ_comp a).symm

/-- Q is a fraction field of R = Z[1/Cden]. -/
instance instIsFractionRingRQ : IsFractionRing R ℚ := by
  haveI : IsScalarTower ℤ R ℚ := isScalarTower_ZRQ
  exact IsFractionRing.isFractionRing_of_isDomain_of_isLocalization M R ℚ

/-- R = Z[1/Cden] is integrally closed. -/
instance instIsIntegrallyClosedR : IsIntegrallyClosed R :=
  isIntegrallyClosed_of_isLocalization R M
    (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Cden_ne_zero))

/-- R = Z[1/Cden] is an integral domain (localization at nonzero elements). -/
instance instIsDomainR : IsDomain R :=
  IsLocalization.isDomain_localization (M := M)
    (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Cden_ne_zero))

/-- S = O_L[1/Cden] is an integral domain (localization of O_L at nonzero elements). -/
instance instIsDomainS : IsDomain S := by
  have hinj : Function.Injective (algebraMap ℤ C) := by
    intro x y hxy
    apply hAL_inj
    rw [IsScalarTower.algebraMap_apply A C L, IsScalarTower.algebraMap_apply A C L, hxy]
  apply IsLocalization.isDomain_localization (M := Algebra.algebraMapSubmonoid C M)
  intro m hm
  obtain ⟨a, ha, rfl⟩ := hm
  obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff a (c : ℤ)).mp ha
  rw [← hn]
  apply mem_nonZeroDivisors_of_ne_zero
  intro hzero
  exact pow_ne_zero n hcA (hinj (by simpa using hzero))

/-- The tower R -> Q -> L. -/
theorem isScalarTower_RQL : IsScalarTower R ℚ L := by
  apply IsScalarTower.of_algebraMap_eq'
  have hcompQ : (algebraMap R ℚ).comp (algebraMap ℤ R) = algebraMap ℤ ℚ := liftRQ_comp
  have hcompL : (algebraMap R L).comp (algebraMap ℤ R) = algebraMap ℤ L := liftAL_comp
  have h : (algebraMap R L) = (algebraMap ℚ L).comp (algebraMap R ℚ) := by
    apply IsLocalization.ringHom_ext M
    rw [RingHom.comp_assoc, hcompQ, hcompL, IsScalarTower.algebraMap_eq ℤ ℚ L]
  exact h

/-- L / Q is separable (characteristic zero and finite). -/
theorem isSeparable_QL : Algebra.IsSeparable ℚ L :=
  Algebra.IsSeparable.of_integral ℚ L

/-- R = Z[1/Cden] is a Dedekind domain. -/
instance instIsDedekindDomainR : IsDedekindDomain R :=
  IsLocalization.isDedekindDomain (A := ℤ) (M := M)
    (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Cden_ne_zero)) R

/-- R = Z[1/Cden] is a principal ideal ring (localization of a PID, and a UFD). -/
instance instIsPrincipalIdealRingR : IsPrincipalIdealRing R :=
  IsPrincipalIdealRing.of_isDedekindDomain_of_uniqueFactorizationMonoid R

/-! ## 2. Torsion-freeness -/

lemma algebraMap_R_L_injective : Function.Injective (algebraMap R L) := by
  intro x y hxy
  haveI : IsScalarTower R ℚ L := isScalarTower_RQL
  apply IsFractionRing.injective R ℚ
  apply FaithfulSMul.algebraMap_injective ℚ L
  rw [← IsScalarTower.algebraMap_apply R ℚ L, ← IsScalarTower.algebraMap_apply R ℚ L, hxy]

instance instIsTorsionFreeRL : Module.IsTorsionFree R L := by
  rw [Module.isTorsionFree_iff_algebraMap_injective]
  exact algebraMap_R_L_injective

instance instIsTorsionFreeAoc2 : Module.IsTorsionFree R Aoc2 := by
  rw [Module.isTorsionFree_iff_algebraMap_injective]
  intro x y hxy
  apply algebraMap_R_L_injective
  calc algebraMap R L x = algebraMap Aoc2 L (algebraMap R Aoc2 x) :=
        (IsScalarTower.algebraMap_apply R Aoc2 L x).symm
    _ = algebraMap Aoc2 L (algebraMap R Aoc2 y) := by rw [hxy]
    _ = algebraMap R L y := IsScalarTower.algebraMap_apply R Aoc2 L y

instance instIsTorsionFreeS : Module.IsTorsionFree R S := by
  rw [Module.isTorsionFree_iff_algebraMap_injective]
  intro x y hxy
  apply algebraMap_R_L_injective
  calc algebraMap R L x = algebraMap S L (algebraMap R S x) :=
        IsScalarTower.algebraMap_apply R S L x
    _ = algebraMap S L (algebraMap R S y) := by rw [hxy]
    _ = algebraMap R L y := (IsScalarTower.algebraMap_apply R S L y).symm

/-! ## 3. Finiteness, freeness and projectivity -/

/-- S is a finite R-module (integral closure of R in the number field L). -/
instance instModuleFiniteS : Module.Finite R S := by
  haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
  haveI : IsScalarTower R ℚ L := isScalarTower_RQL
  haveI : Algebra.IsSeparable ℚ L := isSeparable_QL
  exact IsIntegralClosure.finite R ℚ L S

/-- Aoc2 is a free R-module: finite and torsion-free over the PID R. -/
instance instModuleFreeAoc2 : Module.Free R Aoc2 :=
  Module.free_of_finite_type_torsion_free'

/-- S is a free R-module (integral closure of a PID). -/
instance instModuleFreeS : Module.Free R S := by
  haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
  haveI : IsScalarTower R ℚ L := isScalarTower_RQL
  haveI : Algebra.IsSeparable ℚ L := isSeparable_QL
  exact IsIntegralClosure.module_free R ℚ L S

instance instModuleProjectiveAoc2 : Module.Projective R Aoc2 := inferInstance
instance instModuleProjectiveS : Module.Projective R S := inferInstance

/-! ## 4. The common rank -/

/-- The R-rank of S is the degree of L over Q. -/
theorem finrank_S : Module.finrank R S = Module.finrank ℚ L := by
  haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
  haveI : IsScalarTower R ℚ L := isScalarTower_RQL
  haveI : Algebra.IsSeparable ℚ L := isSeparable_QL
  exact IsIntegralClosure.rank R ℚ L S

/-- The R-rank of Aoc2 is also the degree of L over Q. -/
theorem finrank_Aoc2 : Module.finrank R Aoc2 = Module.finrank ℚ L := by
  haveI : IsScalarTower R ℚ L := isScalarTower_RQL
  haveI : FaithfulSMul R Aoc2 :=
    (Module.isTorsionFree_iff_faithfulSMul (R := R) (A := Aoc2)).mp instIsTorsionFreeAoc2
  exact (Algebra.IsAlgebraic.finrank_of_isFractionRing R ℚ Aoc2 L).symm

/-- Same rank: Aoc2 and S are R-lattices of the same rank in L. -/
theorem finrank_Aoc2_eq_finrank_S : Module.finrank R Aoc2 = Module.finrank R S :=
  (finrank_Aoc2).trans (finrank_S).symm

/-! ## 5. The inclusion Aoc2 <= S inside L -/

/-- The image of S in L, as an R-subalgebra. -/
def Ssub : Subalgebra R L := (IsScalarTower.toAlgHom R S L).range

/-- Every element of Aoc2 lies in S. -/
theorem Aoc2_le_Ssub : Aoc2 ≤ Ssub := by
  rw [Algebra.adjoin_le_iff]
  intro x hx
  haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
  obtain ⟨s, hs⟩ := (IsIntegralClosure.isIntegral_iff (R := R) (A := S) (B := L)).mp
    (HZc2_root_isIntegral hx)
  exact ⟨s, hs⟩

/-- The canonical equivalence S ~= Ssub. -/
noncomputable def equivSsub : S ≃ₐ[R] Ssub := by
  haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
  exact AlgEquiv.ofInjective (IsScalarTower.toAlgHom R S L)
    (IsIntegralClosure.algebraMap_injective S R L)

/-- The rank of Ssub is the rank of S. -/
theorem finrank_Ssub : Module.finrank R Ssub = Module.finrank R S :=
  (equivSsub.toLinearEquiv.finrank_eq).symm

/-! ## 6. The index matrix and the discriminant relation -/

/-- The common rank of Aoc2 and S. -/
abbrev indexRank : ℕ := Module.finrank R Aoc2

/-- An R-basis of Aoc2. -/
noncomputable def basisA : Module.Basis (Fin indexRank) R Aoc2 := Module.finBasis R Aoc2

/-- An R-basis of S, using the rank equality. -/
noncomputable def basisS : Module.Basis (Fin indexRank) R S :=
  Module.finBasisOfFinrankEq R S
    (show Module.finrank R S = indexRank from finrank_Aoc2_eq_finrank_S.symm)

lemma algebraMap_S_L_injective : Function.Injective (algebraMap S L) := by
  haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
  exact IsIntegralClosure.algebraMap_injective S R L

/-- The S-component of an element of Aoc2 (using Aoc2 <= S). -/
noncomputable def toS (a : Aoc2) : S := Classical.choose (Aoc2_le_Ssub a.2)

lemma toS_spec (a : Aoc2) : algebraMap S L (toS a) = algebraMap Aoc2 L a :=
  Classical.choose_spec (Aoc2_le_Ssub a.2)

/-- The inclusion Aoc2 -> S as an R-linear map. -/
noncomputable def toSLinear : Aoc2 →ₗ[R] S where
  toFun := toS
  map_add' := by
    intro a b
    apply algebraMap_S_L_injective
    simp only [map_add, toS_spec]
  map_smul' := by
    intro r a
    apply algebraMap_S_L_injective
    rw [toS_spec, Algebra.smul_def, Algebra.smul_def, map_mul, map_mul,
      ← IsScalarTower.algebraMap_apply R S L, ← IsScalarTower.algebraMap_apply R Aoc2 L,
      toS_spec]
    simp

lemma toSLinear_apply (a : Aoc2) : toSLinear a = toS a := rfl

lemma toSLinear_injective : Function.Injective toSLinear := by
  intro a b h
  have hab : toS a = toS b := h
  have h' : algebraMap Aoc2 L a = algebraMap Aoc2 L b := by
    rw [← toS_spec a, ← toS_spec b, hab]
  exact IsFractionRing.injective Aoc2 L h'

/-- The matrix of the inclusion Aoc2 -> S in the chosen bases. -/
noncomputable def indexMatrix : Matrix (Fin indexRank) (Fin indexRank) R :=
  fun i j => basisS.repr (toS (basisA i)) j

lemma bA_image_eq_sum (i : Fin indexRank) :
    algebraMap Aoc2 L (basisA i) =
      ∑ j, algebraMap R L (indexMatrix i j) * algebraMap S L (basisS j) := by
  have h := basisS.sum_repr (toS (basisA i))
  calc algebraMap Aoc2 L (basisA i) = algebraMap S L (toS (basisA i)) := (toS_spec _).symm
    _ = algebraMap S L (∑ j, basisS.repr (toS (basisA i)) j • basisS j) := by rw [h]
    _ = ∑ j, algebraMap R L (indexMatrix i j) * algebraMap S L (basisS j) := by
          rw [map_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply R S L]
          rfl

lemma toS_basisA_eq_sum (i : Fin indexRank) :
    toS (basisA i) = ∑ j, indexMatrix i j • basisS j := by
  apply algebraMap_S_L_injective
  calc algebraMap S L (toS (basisA i)) = algebraMap Aoc2 L (basisA i) := toS_spec _
    _ = ∑ j, algebraMap R L (indexMatrix i j) * algebraMap S L (basisS j) := bA_image_eq_sum i
    _ = ∑ j, algebraMap S L (indexMatrix i j • basisS j) := by
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply R S L]
    _ = algebraMap S L (∑ j, indexMatrix i j • basisS j) := by rw [map_sum]

lemma basisS_mem_span (hunit : IsUnit indexMatrix.det) (j : Fin indexRank) :
    basisS j ∈ Submodule.span R (Set.range (fun i => toS (basisA i))) := by
  have hmul : indexMatrix⁻¹ * indexMatrix = 1 := Matrix.nonsing_inv_mul _ hunit
  have hA : (fun i => toS (basisA i)) = indexMatrix • (basisS : Fin indexRank → S) := by
    funext i
    rw [Matrix.Module.smul_apply]
    exact toS_basisA_eq_sum i
  have hB : (basisS : Fin indexRank → S) = indexMatrix⁻¹ • (fun i => toS (basisA i)) := by
    rw [hA]
    calc (basisS : Fin indexRank → S)
        = (1 : Matrix (Fin indexRank) (Fin indexRank) R) • (basisS : Fin indexRank → S) :=
          (one_smul _ _).symm
      _ = (indexMatrix⁻¹ * indexMatrix) • (basisS : Fin indexRank → S) := by rw [hmul]
      _ = indexMatrix⁻¹ • (indexMatrix • (basisS : Fin indexRank → S)) := mul_smul _ _ _
  have hBj : basisS j = ∑ i, indexMatrix⁻¹ j i • toS (basisA i) := by
    have := congrFun hB j
    simpa [Matrix.Module.smul_apply] using this
  rw [hBj]
  exact Submodule.sum_mem _ fun i _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

lemma span_toS_basisA_eq_top (hunit : IsUnit indexMatrix.det) :
    Submodule.span R (Set.range (fun i => toS (basisA i))) = ⊤ := by
  rw [← top_le_iff, ← basisS.span_eq]
  exact Submodule.span_le.mpr fun x hx => by
    obtain ⟨j, rfl⟩ := hx
    exact basisS_mem_span hunit j

lemma toSLinear_surjective (hunit : IsUnit indexMatrix.det) :
    Function.Surjective toSLinear := by
  have hspan := span_toS_basisA_eq_top hunit
  have hmap : Submodule.map toSLinear ⊤ = ⊤ := by
    rw [← basisA.span_eq, Submodule.map_span]
    have himg : toSLinear '' Set.range basisA = Set.range (fun i => toS (basisA i)) := by
      rw [← Set.range_comp]
      rfl
    rw [himg, hspan]
  intro s
  have hs : s ∈ Submodule.map toSLinear ⊤ := by rw [hmap]; exact Submodule.mem_top
  rw [Submodule.mem_map] at hs
  obtain ⟨a, _, ha⟩ := hs
  exact ⟨a, ha⟩

/-! ## 7. Order maximality from a unit index -/

/-- The order-maximality statement: Aoc2 already contains S. -/
def OrderIsMaximal : Prop := ∀ s : S, algebraMap S L s ∈ Aoc2

theorem orderIsMaximal_iff_remainingGoal : OrderIsMaximal ↔ RemainingGoal := Iff.rfl

/-- **A unit index implies order maximality.** -/
theorem orderIsMaximal_of_isUnit_indexMatrix (hunit : IsUnit indexMatrix.det) :
    OrderIsMaximal := by
  have hsurj := toSLinear_surjective hunit
  intro s
  obtain ⟨a, ha⟩ := hsurj s
  rw [← ha, toSLinear_apply, toS_spec]
  exact a.2

/-- Conversely, order maximality makes the inclusion an isomorphism, hence the
index matrix invertible. -/
theorem isUnit_indexMatrix_of_orderIsMaximal (h : OrderIsMaximal) :
    IsUnit indexMatrix.det := by
  have hsurj : Function.Surjective toSLinear := by
    intro s
    refine ⟨⟨algebraMap S L s, h s⟩, ?_⟩
    apply algebraMap_S_L_injective
    rw [toSLinear_apply, toS_spec]
    rfl
  have hbij : Function.Bijective toSLinear := ⟨toSLinear_injective, hsurj⟩
  let e : Aoc2 ≃ₗ[R] S := LinearEquiv.ofBijective toSLinear hbij
  have hdet := LinearEquiv.isUnit_det e basisA basisS
  have hmat : LinearMap.toMatrix basisA basisS e = indexMatrix.transpose := by
    ext i j
    simp [LinearMap.toMatrix_apply, indexMatrix, Matrix.transpose_apply, e, toSLinear_apply]
  rwa [hmat, Matrix.det_transpose] at hdet

/-- **The equivalence**: the order Aoc2 is maximal iff the index matrix is a unit. -/
theorem orderIsMaximal_iff_isUnit_indexMatrix :
    OrderIsMaximal ↔ IsUnit indexMatrix.det :=
  ⟨isUnit_indexMatrix_of_orderIsMaximal, orderIsMaximal_of_isUnit_indexMatrix⟩

/-! ## 8. The index ideal and the exact remaining statement -/

/-- The index ideal [S : Aoc2], computed with the chosen bases. -/
def IndexIdeal : Ideal R := Ideal.span {indexMatrix.det}

theorem indexIdeal_eq_top_iff : IndexIdeal = ⊤ ↔ IsUnit indexMatrix.det :=
  Ideal.span_singleton_eq_top

theorem orderIsMaximal_iff_indexIdeal_eq_top :
    OrderIsMaximal ↔ IndexIdeal = ⊤ :=
  orderIsMaximal_iff_isUnit_indexMatrix.trans indexIdeal_eq_top_iff.symm

/-- **The exact remaining statement**: the index [S : Aoc2] is the unit ideal of
R = Z[1/Cden], i.e. every prime of the integer index divides Cden. -/
def IndexIsUnitGoal : Prop := IndexIdeal = ⊤

theorem orderIsMaximal_of_indexIsUnitGoal (h : IndexIsUnitGoal) : OrderIsMaximal :=
  orderIsMaximal_iff_indexIdeal_eq_top.mpr h

theorem isIntegrallyClosed_Aoc2_of_indexIsUnitGoal (h : IndexIsUnitGoal) :
    IsIntegrallyClosed Aoc2 :=
  isIntegrallyClosed_Aoc2_iff_S_le_unconditional.mpr
    (orderIsMaximal_of_indexIsUnitGoal h)

theorem remainingGoal_of_indexIsUnitGoal (h : IndexIsUnitGoal) : RemainingGoal :=
  orderIsMaximal_of_indexIsUnitGoal h

/-! ## 9. The discriminant divisibility relation -/

/-- The index matrix over Q. -/
noncomputable def indexMatrixQ : Matrix (Fin indexRank) (Fin indexRank) ℚ :=
  indexMatrix.map (algebraMap R ℚ)

/-- **Discriminant divisibility**: the discriminant of the Aoc2-basis is the square
of the index times the discriminant of the S-basis. -/
theorem discr_indexMatrix_relation :
    Algebra.discr ℚ (fun i => algebraMap Aoc2 L (basisA i)) =
      (algebraMap R ℚ indexMatrix.det) ^ 2 *
        Algebra.discr ℚ (fun j => algebraMap S L (basisS j)) := by
  haveI : IsScalarTower R ℚ L := isScalarTower_RQL
  have hvec : Matrix.vecMul (fun j => algebraMap S L (basisS j))
      ((indexMatrixQ.transpose).map (algebraMap ℚ L)) =
      fun i => algebraMap Aoc2 L (basisA i) := by
    funext i
    rw [Matrix.vecMul_apply_eq_sum]
    trans ∑ j, algebraMap R L (indexMatrix i j) * algebraMap S L (basisS j)
    · refine Finset.sum_congr rfl fun j _ => ?_
      rw [Matrix.map_apply, Matrix.transpose_apply, indexMatrixQ, Matrix.map_apply,
        ← IsScalarTower.algebraMap_apply R ℚ L]
      ring
    · exact (bA_image_eq_sum i).symm
  rw [← hvec, Algebra.discr_of_matrix_vecMul]
  have hdet : (indexMatrixQ.transpose).det = algebraMap R ℚ indexMatrix.det := by
    rw [Matrix.det_transpose]
    rw [show indexMatrixQ = (algebraMap R ℚ).mapMatrix indexMatrix from rfl]
    exact (RingHom.map_det (algebraMap R ℚ) indexMatrix).symm
  rw [hdet]


#print axioms basisS
#print axioms algebraMap_S_L_injective
#print axioms toS
#print axioms toS_spec
#print axioms toSLinear
#print axioms toSLinear_injective
#print axioms indexMatrix
#print axioms bA_image_eq_sum
#print axioms toS_basisA_eq_sum
#print axioms basisS_mem_span
#print axioms span_toS_basisA_eq_top
#print axioms toSLinear_surjective
#print axioms orderIsMaximal_of_isUnit_indexMatrix

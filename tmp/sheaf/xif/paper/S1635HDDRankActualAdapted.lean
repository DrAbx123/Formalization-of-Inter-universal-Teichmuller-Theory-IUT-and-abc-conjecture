import tmp.sheaf.xif.paper.S1500HDDOutputDependentActual

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 8000000

namespace LeanFormal.IUT.XiFPaper.S1635HDDRankActualAdapted
open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.SHEOutputActual
open LeanFormal.IUT.XiFPaper.S1402HDDDependentSourceActual
open LeanFormal.IUT.XiFPaper.S1500HDDOutputDependentActual
open LeanFormal.IUT.NumberFieldFinitePlace

universe u v
variable {Label : Type u} {Choice : Type v} [AddGroup Label] [Preorder Choice]
variable {I : Input Label Choice}
variable {s : Finset (NumberField.FinitePlace ℚ)}

/-- Exact rank-two generator family from the S1402 image: two image elements
per output and place, with integrality, independence and fullness. -/
structure S1635RankTwoGeneratorFamily
    (D : S1402DependentHDDSource I s) where
  gen : (o : Theorem311Output I) → (v : {v // v ∈ s}) → Fin 2 →
    ((v' : {v' // v' ∈ s}) → S1402DependentE s v')
  gen_mem : ∀ (o : Theorem311Output I) (v : {v // v ∈ s}) (i : Fin 2),
    gen o v i ∈ D.image o
  integral : ∀ (o : Theorem311Output I) (v : {v // v ∈ s}) (i : Fin 2),
    ∀ j, gen o v i j ∈ (CompletionIntegers v.1 : Set (Completion v.1))
  independent : ∀ (o : Theorem311Output I) (v : {v // v ∈ s}),
    LinearIndependent (CompletionIntegers v.1)
      (fun i : Fin 2 => fun j : Fin 2 => (gen o v i ⟨v.1, v.2⟩ : Completion v.1))
  full : ∀ (o : Theorem311Output I) (v : {v // v ∈ s}),
    Submodule.span (Completion v.1)
      (Set.range (fun i : Fin 2 => fun j : Fin 2 => (gen o v i ⟨v.1, v.2⟩ : Completion v.1))) = ⊤

/-- The exact lattice family generated by the S1402 image generators (formal
span; rank/fullness are supplied by the exact structure fields). -/
def s1635LatticeFamily
    (D : S1402DependentHDDSource I s) (G : S1635RankTwoGeneratorFamily D) :
    Theorem311Output I → (v : {v // v ∈ s}) →
      Submodule (CompletionIntegers v.1) (Fin 2 → Completion v.1) :=
  fun o v => Submodule.span (CompletionIntegers v.1)
    (Set.range (fun i : Fin 2 => fun j : Fin 2 => G.(gen o v i ⟨v.1, v.2⟩ : Completion v.1)))

/-- Exact first missing to fill S1500: integral/free/rank-two generator data
over the S1402 image. -/
def S1635HDDRankRequired : Prop :=
  forall (D : S1402DependentHDDSource I s), Nonempty (S1635RankTwoGeneratorFamily D)

end LeanFormal.IUT.XiFPaper.S1635HDDRankActualAdapted
end
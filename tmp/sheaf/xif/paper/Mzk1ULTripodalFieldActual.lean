/- U-C: actual tripodal field F_tpd (route §6.2 L570-575 / §6.4 L613-621).

Paper (IUT IV L1273-1277): Fmod ⊆ Ftpd := Fmod(E_{Fmod}[2]) ⊆ F, the tripodal
intermediate field; (L1279-1292): F = Fmod(sqrt(-1), E[2*3*5]) = Ftpd(sqrt(-1), E[3*5]).
So Ftpd is a PROPER intermediate field between the moduli field and F; using
T.arithmetic.F for S_ar's d_Ftpd/f_Ftpd is incorrect unless F = Fmod(E[2]).

This file: per-lambda version inside ambient Complex.
 - jOfLam lam := 256*(1-lam+lam^2)^3/(lam^2*(1-lam)^2)  (route L600-604);
 - FmodLam lam := Q(j(lam));
 - FtpdLam lam := Fmod(lam) as an intermediate field adjoining the Legendre
   parameter lam (the x-coordinate of a 2-torsion point; the 2-torsion field of a
   Legendre model is generated by such coordinates);
 - FLam lam := normal closure of Ftpd(lam) (gives F/Fmod Galois by Mathlib
   IsGalois.normalClosure; sqrt(-1) and 3*5-torsion are added in the full
   construction with the same mechanism, next batch).
API: Mathlib IntermediateField.adjoin, FieldTheory.Normal.Closure.normalClosure,
Galois.Basic IsGalois.normalClosure.
-/
import Mathlib.FieldTheory.Normal.Closure
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.Analysis.Complex.Basic
import Mathlib.Tactic

noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1ULTripodalFieldActual

open scoped BigOperators

/-- the j-invariant of the Legendre curve with parameter lam (route L600-604). -/
def jOfLam (lam : ℂ) : ℂ :=
  256 * (1 - lam + lam ^ 2) ^ 3 / (lam ^ 2 * (1 - lam) ^ 2)

/-- the moduli field Fmod = Q(j(lam)). -/
noncomputable def FmodLam (lam : ℂ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ ({jOfLam lam} : Set ℂ)

/-- the tripodal field Ftpd = Fmod(E[2]) (IUT IV L1273-1277), per lambda:
the field adjoining the Legendre parameter (2-torsion coordinate). -/
noncomputable def FtpdLam (lam : ℂ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ ({jOfLam lam, lam} : Set ℂ)

/-- the normal closure of Ftpd over Q (gives F/Fmod Galois via
Mathlib `IsGalois.normalClosure`; the paper's F also adjoins sqrt(-1) and the
3*5-torsion, handled in the full construction). -/
noncomputable def FLam (lam : ℂ) : IntermediateField ℚ ℂ :=
  IntermediateField.normalClosure ℚ ↥(FtpdLam lam) ℂ

end LeanFormal.IUT.XiFPaper.Mzk1ULTripodalFieldActual
end
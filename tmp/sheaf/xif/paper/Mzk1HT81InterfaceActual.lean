/-
# H-T section 8.1: parameterized named interface (NO INHABITANT)

Lead request (alan, H-T section 8.2 conductor/different cancellation): expose the
actual names of the section 8.1 objects E_i, h_{O(1)}, phi_i, y, K = Q(phi_i(y)),
L = Q(y).  This file gives the PARAMETERIZED named interface only: a structure
whose fields are the paper objects, with no inhabitant claimed.  The actual
construction (from the P8 curve / Belyi covers) is the section 8.1 task; this
skeleton lets section 8.2 start at the statement layer.

All fields are honest paper objects; there is no True/sorry/axiom and no surrogate
carrier: a consumer must supply an actual HT81Interface instance.
-/
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.Tactic

noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1HT81InterfaceActual

/-- H-T section 8.1 named interface (NO INHABITANT).

Paper objects:
* E_i: the auxiliary curves (index family over I);
* phi_i: the maps E_i -> E (the fixed base curve E over Q);
* y: the point of E whose field L = Q(y) is the number field L;
* K = Q(phi_i(y)): the subfield generated by the image point, embedded into L;
* h_{O(1)}: a fixed ample-height function on E-points (the O(1) height used to
  compare the two height normalizations).
The provenance of the height/normalization conventions is the H-T section 8.1
statement; the fields below record the exact signatures a consumer needs. -/
structure HT81Interface where
  /-- index set of the auxiliary curves E_i -/
  I : Type
  [fintypeI : Fintype I]
  /-- the base curve E over Q, modeled by its point type -/
  E : Type
  /-- the fixed height function h_{O(1)} on E -/
  hO1 : E → ℝ
  /-- the auxiliary curve E_i at index i, modeled by its point type -/
  Ei : I → Type
  /-- the maps phi_i : E -> E_i (so phi_i(y) is a point of E_i and
  K_i = Q(phi_i(y)) is a subfield of L = Q(y)) -/
  phi : ∀ i, E → Ei i
  /-- the point y of E whose field is L = Q(y) -/
  y : E
  /-- L = Q(y), realized as a number field -/
  L : Type
  [fieldL : Field L]
  [numL : NumberField L]
  /-- K = Q(phi_i(y)), realized as a number field for each i -/
  K : I → Type
  [fieldK : ∀ i, Field (K i)]
  [numK : ∀ i, NumberField (K i)]
  /-- the inclusion K_i = Q(phi_i(y)) into L = Q(y) -/
  KintoL : ∀ i, K i →+* L

attribute [instance] HT81Interface.fintypeI HT81Interface.fieldL HT81Interface.numL
  HT81Interface.fieldK HT81Interface.numK

/-- The image point phi_i(y) as an element of E_i (named for section 8.2). -/
def HT81Interface.phiY (H : HT81Interface) (i : H.I) : H.Ei i := H.phi i H.y

/-- The height h_{O(1)} evaluated at the point y of E. -/
def HT81Interface.hO1_y (H : HT81Interface) : ℝ := H.hO1 H.y

/-- H-T section 8.1 named interface for the auxiliary line-bundle heights
(NO INHABITANT): h_{E_i}(y), the value at y of the height associated with the
line bundle O(E_i), for alan's section 8.2 F2 statement. -/
structure HT81LineBundleHeights (H : HT81Interface) where
  /-- h_{E_i}(y): the height of y with respect to O(E_i), for each i -/
  hEi : H.I → ℝ

end LeanFormal.IUT.XiFPaper.Mzk1HT81InterfaceActual
end
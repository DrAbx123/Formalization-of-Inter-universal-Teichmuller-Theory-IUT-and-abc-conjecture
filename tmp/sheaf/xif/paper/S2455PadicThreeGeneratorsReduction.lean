import tmp.sheaf.xif.paper.S2453PadicDemushkinReduction
import tmp.sheaf.xif.paper.S2117TopFGActual
noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
open LeanFormal.IUT
open LeanFormal.IUT.XiFPaper.S2117TopFGActual
namespace LeanFormal.IUT.XiFPaper.S2455PadicThreeGeneratorsReduction
variable (p : Nat) [Fact (Nat.Prime p)]
/-- The corrected concrete statement: G_Qp is topologically generated by
three elements (the pro-p quotient has Demushkin rank 3). -/
def S2455ThreeGenerators : Prop :=
  ∃ σ τ υ : LocalAbsoluteGalois p,
    (Subgroup.closure ({σ, τ, υ} : Set (LocalAbsoluteGalois p))).topologicalClosure = ⊤
/-- Three topological generators give the finite generation target. -/
theorem S2455PadicFG_of_threeGenerators
    (h : S2455ThreeGenerators (p := p)) :
    PadicAbsoluteGaloisTopologicallyFinitelyGenerated (p := p) := by
  rcases h with ⟨σ, τ, υ, hστυ⟩
  classical
  refine ⟨{σ, τ, υ}, ?_⟩
  simpa [Finset.coe_insert, Finset.coe_singleton] using hστυ
/-- Exact missing: a three-generator Demushkin/Jannsen-Wingberg presentation
of G_Qp. -/
def S2455ThreeGeneratorRequired : Prop :=
  S2455ThreeGenerators (p := p)
#check S2455ThreeGenerators
#check S2455PadicFG_of_threeGenerators
#check S2455ThreeGeneratorRequired
end LeanFormal.IUT.XiFPaper.S2455PadicThreeGeneratorsReduction
end

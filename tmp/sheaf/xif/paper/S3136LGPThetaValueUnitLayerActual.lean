import tmp.sheaf.xif.paper.S3136LGPLocalMonoidActual
import tmp.sheaf.xif.paper.S3136LGPJvPacketTransportActual

/-! # Stage-4 host: the actual q_v unit lies in the candidate unit layer

Source anchors: IUT III, Prop. 3.4, (ii) (pp. 102--103); IUT II theta values.

The candidate local LGP unit layer is the submonoid of actual units generated by
the actual theta values.  The actual q_v unit is the (2l)-th power of the
label-1 theta value, hence it lies in the candidate unit layer itself (not only
in the generated subgroup):
* lgpRoot_mem_localUnitLayer: the actual 2l-th root lies in the unit layer;
* qVAlgClosedUnit_mem_localUnitLayer: the actual q_v unit lies in the unit layer;
* LGPUnitLayerQvMissing/Gap: exact missing data (embedding of the unit layer into
  the IQ packet; refs above).

LABEL: prerequisite component only.  Consumer: lattice, stepxi C2. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.S3136LGPThetaValueUnitLayerActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.TwoLthRootQVActual
open LeanFormal.IUT.XiFPaper.QPilotZeroLocusDivisorActual
open LeanFormal.IUT.N8Closure.C3Roots
open LeanFormal.IUT.XiFPaper.TwoLthRootKummerActual
open LeanFormal.IUT.XiFPaper.LGPThetaActionActual
open LeanFormal.IUT.XiFPaper.PaperSymbolTypesActual
open LeanFormal.IUT.XiFPaper.S3136LGPPhiInputSourceActual
open LeanFormal.IUT.XiFPaper.S3136LGPLocalMonoidActual

variable {l : PrimeGeFive} (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]

/-- The actual 2l-th root lies in the candidate unit layer. -/
theorem lgpRoot_mem_localUnitLayer (b : Bad (nativePlaceSelection T)) :
    hodgeTwoLthRoot T b ∈ lgpLocalUnitLayer T b := by
  rw [← lgpThetaValue_signed_one T b]
  exact lgpThetaValue_mem_unitLayer T b (lgpSignedLabelOne l)

/-- The actual q_v unit lies in the candidate unit layer. -/
theorem qVAlgClosedUnit_mem_localUnitLayer (b : Bad (nativePlaceSelection T)) :
    qVAlgClosedUnit T b ∈ lgpLocalUnitLayer T b := by
  rw [← hodgeTwoLthRoot_pow T b]
  exact Submonoid.pow_mem (lgpLocalUnitLayer T b)
    (lgpRoot_mem_localUnitLayer T b) (2 * l.value)

/-- Exact missing data for the unit-layer embedding into the IQ packet (IUT III,
Prop. 3.2, (ii), pp. 97--99; Prop. 3.4, (ii), pp. 102--103):
* unitLayerEmbedding: the embedding of the candidate unit layer into the IQ
  packet;
* muQuasiLatticeCompatibility: compatibility with the mu_{2l}-quasi-lattice;
* rhoLgpCompat: compatibility with rho_lgp,v. -/
structure LGPUnitLayerQvMissing where
  unitLayerEmbedding : Prop
  muQuasiLatticeCompatibility : Prop
  rhoLgpCompat : Prop

/-- The exact unit-layer embedding gap. -/
def LGPUnitLayerQvGap : Prop := Nonempty LGPUnitLayerQvMissing

#check lgpRoot_mem_localUnitLayer
#check qVAlgClosedUnit_mem_localUnitLayer
#check LGPUnitLayerQvGap

end LeanFormal.IUT.XiFPaper.S3136LGPThetaValueUnitLayerActual
end
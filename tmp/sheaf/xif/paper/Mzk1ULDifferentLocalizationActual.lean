import LeanFormal.IUT.IUTIV.Estimates.DifferentDegreeUpperBound
import LeanFormal.IUT.IUTIV.Estimates.DifferentTameEquality
import Mathlib.RingTheory.DedekindDomain.Dvr
import Mathlib.NumberTheory.RamificationInertia.Ramification
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.NumberTheory.NumberField.Discriminant.Different
import Mathlib.Tactic

/-!
# The IUT IV (1.3) different bound over the localization tower ℤ_(p) ⊆ (𝓞 F)_P ⊆ (𝓞 K)_w

This file is the *localized / arithmetic* counterpart of
`LeanFormal/IUT/Foundations/LocalFields/LocalDifferentUpperBound.lean`, which instantiates IUT IV
Proposition 1.3(ii) for the local-field tower ℤ_[p] ⊆ 𝒪_K ⊆ 𝒪_L.  Here the base ring is the
*global* localization ℤ_(p) and the top rings are localizations of rings of integers at a chain
of primes.

## What is proved here (and what is not)

Layer 1 (p-adic base):
* `intPrimeIdeal p = (p) ⊆ ℤ`, its primality and nontriviality;
* `ZLocalization p = ℤ_(p) = Localization.AtPrime (p)`;
* **`span_p_eq_maximalIdeal`** : the maximal ideal of ℤ_(p) is generated by p
  (this is exactly the hypothesis `prime_generates` of the general DVR form of IUT IV Prop 1.3(ii));
* ℤ_(p) is a Dedekind domain / discrete valuation ring and its maximal ideal is nonzero;
* `factorCount_span_p_eq_one` (the uniformizer condition `ord_{(p)}(p) = 1`) and
  `charP_zLocalization_quotient` (the residue field of ℤ_(p) has characteristic p).

Layer 2 (localization of the prime factorization):
* `emultiplicity_map_atPrime_eq` and `multiplicity_map_atPrime_eq`: for a nonzero ideal `I` of a
  Dedekind domain `R` and a nonzero prime `P`, the multiplicity of the maximal ideal of
  `Localization.AtPrime P` in `I.map (algebraMap R _)` equals the multiplicity of `P` in `I`.
  (The localization at `P` is unramified, `ramificationIdx' P (maximalIdeal _) = 1`.)
* `count_normalizedFactors_map_atPrime`: the `normalizedFactors`-count form of the same statement
  (this needs `[DecidableEq (Ideal R)]` because Mathlib's
  `UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors` does);
* `multiplicity_differentIdeal_map_atPrime` : the special case `I = differentIdeal ℤ (𝓞 F)`,
  i.e. the precise sense in which *the multiplicity of `P` in the global different controls the
  multiplicity of the local maximal ideal in the localized different*.  This matches the
  `multiplicity`-based global form of `Heights/Different/NumberField.lean`.

Layer 3 (the donor):
* `iutIVProp13ii_normalizedDifferent_le_zLocalization`: IUT IV Prop 1.3(ii) with the base DVR
  specialized to `A := ℤ_(p)` and the hypothesis `span {p} = maximalIdeal A` *discharged* by
  Layer 1.  `B` and `C` are arbitrary DVRs over ℤ_(p) with the standard tower hypotheses of the
  donor (finite, torsion-free, separable, primes lying over).

## The remaining bridge (not proved here)

To pass from Layer 2 to the *local* different `differentIdeal (ZLocalization p) (𝓞 F)_P` one needs
`differentIdeal (ZLocalization p) (Localization.AtPrime P) =
  (differentIdeal ℤ (𝓞 F)).map (algebraMap (𝓞 F) (Localization.AtPrime P))`
("the different commutes with localization"), which is not in Mathlib: the different is the
annihilator of the trace dual `Submodule.traceDual A B`, and one has to compare the localized trace
dual with the trace dual of the localized tower (flatness of localization at a prime, resp. the
"different = discriminant of the trace form" description).  Given that identity, Layer 2 turns the
right-hand side of Layer 3 into
`(normalizedFactors (differentIdeal ℤ (𝓞 F))).count P`, i.e. exactly the summands of the global
`Heights.Different.diffContrib`.  This identification is deliberately *not* assumed as a hypothesis.
-/

noncomputable section

set_option maxHeartbeats 800000

namespace LeanFormal.IUT.XiFPaper.Mzk1ULDifferentLocalizationActual

open IsLocalRing UniqueFactorizationMonoid
open LeanFormal.IUT.IUTIV.Estimates

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

/-- The prime ideal `(p)` of ℤ. -/
def intPrimeIdeal (p : ℕ) : Ideal ℤ := Ideal.span {(p : ℤ)}

theorem intPrimeIdeal_isPrime (p : ℕ) [Fact p.Prime] : (intPrimeIdeal p).IsPrime := by
  rw [intPrimeIdeal, Ideal.span_singleton_prime (by exact_mod_cast (Fact.out : p.Prime).ne_zero)]
  exact Nat.prime_iff_prime_int.mp Fact.out

instance intPrimeIdeal.instIsPrime (p : ℕ) [Fact p.Prime] : (intPrimeIdeal p).IsPrime :=
  intPrimeIdeal_isPrime p

theorem intPrimeIdeal_ne_bot (p : ℕ) [Fact p.Prime] : intPrimeIdeal p ≠ ⊥ := by
  rw [intPrimeIdeal]
  simpa using (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero : (p : ℤ) ≠ 0)

/-- `ℤ_(p)`: the localization of ℤ at the prime `(p)`. -/
abbrev ZLocalization (p : ℕ) [Fact p.Prime] : Type := Localization.AtPrime (intPrimeIdeal p)

/-- **The maximal ideal of ℤ_(p) is generated by p.** This is the `prime_generates`
hypothesis of the general DVR form of IUT IV Proposition 1.3(ii), here discharged by construction:
`(p)` maps to the maximal ideal of the localization at `(p)`. -/
theorem span_p_eq_maximalIdeal (p : ℕ) [Fact p.Prime] :
    Ideal.span {(p : ZLocalization p)} = maximalIdeal (ZLocalization p) := by
  have h := Localization.AtPrime.map_eq_maximalIdeal (I := intPrimeIdeal p)
  have hmap : Ideal.map (algebraMap ℤ (ZLocalization p)) (intPrimeIdeal p) =
      Ideal.span {(p : ZLocalization p)} := by
    change Ideal.map (algebraMap ℤ (ZLocalization p)) (Ideal.span {(p : ℤ)}) =
      Ideal.span {(p : ZLocalization p)}
    rw [Ideal.map_span, Set.image_singleton]
    rw [show algebraMap ℤ (ZLocalization p) (p : ℤ) = (p : ZLocalization p) from
      map_intCast (algebraMap ℤ (ZLocalization p)) p]
  rw [hmap] at h
  exact h

theorem zLocalization_isDedekindDomain (p : ℕ) [Fact p.Prime] :
    IsDedekindDomain (ZLocalization p) :=
  inferInstance

theorem zLocalization_isDiscreteValuationRing (p : ℕ) [Fact p.Prime] :
    IsDiscreteValuationRing (ZLocalization p) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ℤ
    (intPrimeIdeal_ne_bot p) (ZLocalization p)

theorem zLocalization_maximalIdeal_ne_bot (p : ℕ) [Fact p.Prime] :
    maximalIdeal (ZLocalization p) ≠ ⊥ := by
  haveI : IsDiscreteValuationRing (ZLocalization p) := zLocalization_isDiscreteValuationRing p
  exact dvr_maximalIdeal_ne_bot (ZLocalization p)

/-- **The uniformizer condition.**  The maximal ideal of `ℤ_(p)` is the principal ideal `(p)` and
its `normalizedFactors`-count is one, so `p` plays the role of the uniformizer of the base DVR in
the DVR different estimates. -/
theorem factorCount_span_p_eq_one (p : ℕ) [Fact p.Prime] :
    (normalizedFactors (Ideal.span {(p : ZLocalization p)})).count
        (maximalIdeal (ZLocalization p)) = 1 := by
  haveI : IsDiscreteValuationRing (ZLocalization p) := zLocalization_isDiscreteValuationRing p
  rw [span_p_eq_maximalIdeal]
  simpa using dvr_factorCount_pow_maximalIdeal (ZLocalization p) 1

/-- **The residue characteristic of `ℤ_(p)` is `p`.**  This is the `CharP` hypothesis used by the
`p`-adic different estimates (e.g. `dvr_natCast_factorCount`). -/
theorem charP_zLocalization_quotient (p : ℕ) [Fact p.Prime] :
    CharP (ZLocalization p ⧸ maximalIdeal (ZLocalization p)) p := by
  refine (CharP.charP_iff_prime_eq_zero (Fact.out : p.Prime)).mpr ?_
  have hmem : (p : ZLocalization p) ∈ maximalIdeal (ZLocalization p) := by
    rw [← span_p_eq_maximalIdeal]
    exact Ideal.mem_span_singleton_self _
  simpa using (Ideal.Quotient.eq_zero_iff_mem).mpr hmem

/-! ### Localization of prime factorizations -/

section LocalizationCount

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

/-- **Multiplicity of the maximal ideal in a localization.** For a nonzero ideal `I` of a Dedekind
domain `R` and a nonzero prime ideal `P` of `R`, the multiplicity of the maximal ideal of
`Localization.AtPrime P` in `I.map (algebraMap R _)` is the multiplicity of `P` in `I`: the
localization at `P` is unramified. -/
theorem emultiplicity_map_atPrime_eq (P : Ideal R) [P.IsPrime] (hP : P ≠ ⊥)
    (I : Ideal R) (hI : I ≠ ⊥) :
    emultiplicity (maximalIdeal (Localization.AtPrime P))
        (I.map (algebraMap R (Localization.AtPrime P))) = emultiplicity P I := by
  have hPirr : Irreducible P := (Ideal.prime_of_isPrime hP inferInstance).irreducible
  have hMbot : maximalIdeal (Localization.AtPrime P) ≠ ⊥ := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal (I := P)]
    exact Ideal.map_ne_bot_of_ne_bot hP
  have hIrr : Irreducible (maximalIdeal (Localization.AtPrime P)) :=
    (Ideal.prime_of_isPrime hMbot
      (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime P)).isPrime).irreducible
  haveI : (maximalIdeal (Localization.AtPrime P)).LiesOver P := inferInstance
  have hemul :=
    Ideal.IsDedekindDomain.emultiplicity_map_eq_ramificationIdx'_mul
      (S := Localization.AtPrime P) (v := P)
      (w := maximalIdeal (Localization.AtPrime P)) hI hPirr hIrr hMbot
  have hram : P.ramificationIdx' (maximalIdeal (Localization.AtPrime P)) = 1 := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal (I := P)]
    refine Ideal.ramificationIdx'_map_self_eq_one (p := P) ?_ ?_
    · rw [Localization.AtPrime.map_eq_maximalIdeal (I := P)]
      exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime P)).ne_top
    · rw [Localization.AtPrime.map_eq_maximalIdeal (I := P)]
      exact hMbot
  rw [hram, Nat.cast_one, one_mul] at hemul
  exact hemul

/-- The `multiplicity`-form of `emultiplicity_map_atPrime_eq`. -/
theorem multiplicity_map_atPrime_eq (P : Ideal R) [P.IsPrime] (hP : P ≠ ⊥)
    (I : Ideal R) (hI : I ≠ ⊥) :
    multiplicity (maximalIdeal (Localization.AtPrime P))
        (I.map (algebraMap R (Localization.AtPrime P))) = multiplicity P I := by
  unfold multiplicity
  rw [emultiplicity_map_atPrime_eq P hP I hI]

/-- The `normalizedFactors`-count form of `emultiplicity_map_atPrime_eq`.  The decidability
hypothesis is inherited from `UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors`;
for the arithmetic applications one can use `multiplicity_map_atPrime_eq` instead, which needs no
decidability of equality of ideals. -/
theorem count_normalizedFactors_map_atPrime [DecidableEq (Ideal R)]
    (P : Ideal R) [P.IsPrime] (hP : P ≠ ⊥) (I : Ideal R) (hI : I ≠ ⊥) :
    (normalizedFactors (I.map (algebraMap R (Localization.AtPrime P)))).count
        (maximalIdeal (Localization.AtPrime P)) =
      (normalizedFactors I).count P := by
  have hPirr : Irreducible P := (Ideal.prime_of_isPrime hP inferInstance).irreducible
  have hMbot : maximalIdeal (Localization.AtPrime P) ≠ ⊥ := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal (I := P)]
    exact Ideal.map_ne_bot_of_ne_bot hP
  have hIrr : Irreducible (maximalIdeal (Localization.AtPrime P)) :=
    (Ideal.prime_of_isPrime hMbot
      (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime P)).isPrime).irreducible
  have hImap : I.map (algebraMap R (Localization.AtPrime P)) ≠ ⊥ :=
    Ideal.map_ne_bot_of_ne_bot hI
  have h := emultiplicity_map_atPrime_eq P hP I hI
  rw [UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors hIrr hImap,
    UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors hPirr hI,
    normalize_eq, normalize_eq] at h
  exact_mod_cast h

end LocalizationCount

/-! ### The global different of a number field, localized at a prime -/

section NumberFieldDifferent

open NumberField

variable {F : Type*} [Field F] [NumberField F]

/-- **Localization of the different count at a prime.**  The multiplicity of the maximal ideal of
`(𝓞 F)_P` in the localization of the global different `differentIdeal ℤ (𝓞 F)` is the
multiplicity of `P` in the global different.  This is the "count in the localization" layer of the
local--global comparison; identifying the localized ideal with the local different
`differentIdeal ℤ_(p) ((𝓞 F)_P)` is the remaining, separate step (see the module docstring). -/
theorem multiplicity_differentIdeal_map_atPrime (P : Ideal (𝓞 F)) [P.IsPrime] (hP : P ≠ ⊥) :
    multiplicity (maximalIdeal (Localization.AtPrime P))
        ((differentIdeal ℤ (𝓞 F)).map (algebraMap (𝓞 F) (Localization.AtPrime P))) =
      multiplicity P (differentIdeal ℤ (𝓞 F)) :=
  multiplicity_map_atPrime_eq P hP (differentIdeal ℤ (𝓞 F)) differentIdeal_ne_bot

end NumberFieldDifferent

/-! ### IUT IV Proposition 1.3(ii) at the p-adic base ℤ_(p) -/

section DonorInstantiation

variable (p : ℕ) [Fact p.Prime]
variable (B : Type*) [CommRing B] [IsDedekindDomain B] [IsDiscreteValuationRing B]
  [Algebra (ZLocalization p) B] [Module.Finite (ZLocalization p) B]
  [Module.IsTorsionFree (ZLocalization p) B] [CharZero B]
  [(maximalIdeal B).LiesOver (maximalIdeal (ZLocalization p))]
variable (C : Type*) [CommRing C] [IsDedekindDomain C] [IsDiscreteValuationRing C]
  [Algebra B C] [Algebra (ZLocalization p) C] [IsScalarTower (ZLocalization p) B C]
  [Module.Finite B C] [Module.Finite (ZLocalization p) C]
  [Module.IsTorsionFree B C] [Module.IsTorsionFree (ZLocalization p) C]
  [Algebra.IsSeparable (FractionRing (ZLocalization p)) (FractionRing C)]
  [(maximalIdeal C).LiesOver (maximalIdeal B)]

/-- **IUT IV Proposition 1.3(ii) over ℤ_(p).**  The normalized different of the tower
`ℤ_(p) ⊆ B ⊆ C` is bounded by the normalized different of `ℤ_(p) ⊆ B` plus the p-adic valuation of
the relative degree plus the normalizing factor `1/e`.  This is
`iutIVProp13ii_normalizedDifferent_le` with the base DVR specialized to `A := ℤ_(p)`; the
hypothesis `span {p} = maximalIdeal ℤ_(p)` of the donor is discharged by
`span_p_eq_maximalIdeal`. -/
theorem iutIVProp13ii_normalizedDifferent_le_zLocalization :
    ((normalizedFactors (differentIdeal (ZLocalization p) C)).count (maximalIdeal C) : ℝ) /
        (maximalIdeal (ZLocalization p)).ramificationIdx' (maximalIdeal C) ≤
      ((normalizedFactors (differentIdeal (ZLocalization p) B)).count (maximalIdeal B) : ℝ) /
          (maximalIdeal (ZLocalization p)).ramificationIdx' (maximalIdeal B) +
        padicValNat p (Module.finrank (FractionRing B) (FractionRing C)) +
        1 / (maximalIdeal (ZLocalization p)).ramificationIdx' (maximalIdeal B) := by
  haveI : IsDedekindDomain (ZLocalization p) := zLocalization_isDedekindDomain p
  haveI : IsDiscreteValuationRing (ZLocalization p) := zLocalization_isDiscreteValuationRing p
  exact iutIVProp13ii_normalizedDifferent_le (ZLocalization p) B C p (span_p_eq_maximalIdeal p)

end DonorInstantiation


/-- The actual source arithmetic line-bundle type. -/
abbrev SourceLineBundleOf := SourceLineBundle (A := A)

/-- The actual source integral ring. -/
abbrev SourceOKOf := SourceOK (A := A)

/-- The exact missing global lift: a global q-pilot ideal over O_K together
with the source identification proposition. This is donor data, not a proof. -/
structure GlobalQPilotIdealDonor where
  qPilotIdeal : Ideal (SourceOKOf (A := A))
  source_identification : Prop

/-- The local q/C3 data attached to the donor. This records the actual local
objects without pretending they are a global ideal. -/
structure LocalQPilotData
    (C3 : SourcePilotRegionData (l := l) (V := V) I) where
  baseQ : C3.q.q ≠ 0
  contraction : (Valued.v C3.q.q : WithZero (Multiplicative Int)) < 1

/-- Construct the actual PaperQPilotLineBundleSource from a global q-pilot
ideal donor and the actual local q/C3 data. -/
noncomputable def qPilotLineBundleSourceOfGlobalIdeal
    (D : GlobalQPilotIdealDonor (A := A)) :
    PaperQPilotLineBundleSource A where
  qPilotLineBundle :=
    (D.qPilotIdeal : FractionalIdeal
      (nonZeroDivisors (SourceOKOf (A := A))) A.K)
  qPilotIdeal := D.qPilotIdeal
  qPilot_lineBundle_eq := rfl
  qPilot_source_identification := D.source_identification

/-- The constructed line bundle is exactly the fractional ideal generated by
the donor global ideal. -/
theorem qPilotLineBundleSourceOfGlobalIdeal_lineBundle
    (D : GlobalQPilotIdealDonor (A := A)) :
    (qPilotLineBundleSourceOfGlobalIdeal (A := A) D).qPilotLineBundle =
      (D.qPilotIdeal : FractionalIdeal
        (nonZeroDivisors (SourceOKOf (A := A))) A.K) := rfl

/-- The constructed source has the donor q-pilot ideal. -/
theorem qPilotLineBundleSourceOfGlobalIdeal_ideal
    (D : GlobalQPilotIdealDonor (A := A)) :
    (qPilotLineBundleSourceOfGlobalIdeal (A := A) D).qPilotIdeal =
      D.qPilotIdeal := rfl

/-- The exact missing map: from actual local C3/base q data to a global
q-pilot ideal donor. -/
def MissingGlobalQPilotLift

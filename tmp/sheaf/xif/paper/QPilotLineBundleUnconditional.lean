/-- Exact status: the actual local q/C3 data and the actual arithmetic
line-bundle type are available; the global q-pilot ideal is not. -/
theorem qPilotLineBundleUnconditional_status
    (C3 : SourcePilotRegionData (l := l) (V := V) I)
    (D : GlobalQPilotIdealDonor (A := A)) :
    (qPilotLineBundleSourceOfGlobalIdeal (A := A) D).qPilotLineBundle =
        (D.qPilotIdeal : FractionalIdeal
          (nonZeroDivisors (SourceOKOf (A := A))) A.K) ∧
      Nonempty (PaperQPilotLineBundleSource A) :=
  ⟨qPilotLineBundleSourceOfGlobalIdeal_lineBundle (A := A) D,
    qPilotLineBundleSource_nonempty_of_globalIdeal (A := A) C3 D⟩

/-- The exact missing global lift, in the original source shape. -/

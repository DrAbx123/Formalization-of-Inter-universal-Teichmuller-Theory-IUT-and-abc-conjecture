/-- Conditional existence of the paper q-pilot line bundle from the exact
global lift donor. -/
theorem qPilotLineBundleSource_nonempty_of_globalIdeal
    (C3 : SourcePilotRegionData (l := l) (V := V) I)
    (D : GlobalQPilotIdealDonor (A := A)) :
    Nonempty (PaperQPilotLineBundleSource A) :=

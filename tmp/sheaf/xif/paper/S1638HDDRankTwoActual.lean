open LeanFormal.IUT.XiFPaper.S1513HDDOutputBindingActual
open LeanFormal.IUT.XiFPaper.S1551HDDImageGeneratorActual
open LeanFormal.IUT.XiFPaper.S1630HDDOutputImageActual
open LeanFormal.IUT.NumberFieldFinitePlace

universe u v

variable {Label : Type u} {Choice : Type v} [AddGroup Label] [Preorder Choice]

/-! ## 1. The faithful rank-two family from actual image generators -/

/-- A faithful rank-two HDD basic component: an actual S1402 source together
with two actual image points whose selected-place coordinates are integral and
nonzero.  The local lattice is generated by the two actual image values, not by
a chosen free bundle. -/
structure S1638HDDRankTwoFamily (I : Input Label Choice)
    (s : Finset (NumberField.FinitePlace ℚ)) where
  source : S1402DependentHDDSource I s
  generator : S1513ImageGeneratorFamily source

namespace S1638HDDRankTwoFamily

variable {I : Input Label Choice} {s : Finset (NumberField.FinitePlace ℚ)}

/-- The output/place-dependent rank-two integral local lattice, defined as the
diagonal O_v-span of the two actual image generators. -/
abbrev lattice (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    Submodule (CompletionIntegers v.1) (Fin 2 → Completion v.1) :=
  s1513DiagonalLattice F.generator o v

/-- The lattice is definitionally the diagonal lattice of the actual image
generators. -/
@[simp] theorem lattice_eq (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    F.lattice o v = s1513DiagonalLattice F.generator o v := rfl

/-- An explicit O_v-basis of the local lattice, obtained from the diagonal
equivalence with O_v^2. -/
noncomputable def basis (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    Module.Basis (Fin 2) (CompletionIntegers v.1) (F.lattice o v) :=
  (Pi.basisFun (CompletionIntegers v.1) (Fin 2)).map
    (s1513DiagonalEquiv F.generator o v)

/-- The i-th basis vector is exactly the i-th actual image value placed in
the i-th coordinate.  This is the concrete binding to source.image. -/
@[simp] theorem basis_apply (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    (F.basis o v i : Fin 2 → Completion v.1) =
      s1513GeneratorVector F.generator o v i := by
  rw [basis, Module.Basis.map_apply, Pi.basisFun_apply]
  change (↑((LinearEquiv.ofInjective (s1513DiagonalMap F.generator o v)
      (s1513DiagonalMap_injective F.generator o v)) (Pi.single i 1)) :
        Fin 2 → Completion v.1) =
    s1513GeneratorVector F.generator o v i
  rw [LinearEquiv.ofInjective_apply]
  funext j
  rw [s1513DiagonalMap_apply]
  by_cases h : j = i
  · subst h
    rw [Pi.single_eq_same, mul_one]
    change ((s1513LocalGenerator F.generator o v j : Completion v.1)) =
      s1513GeneratorVector F.generator o v j j
    rw [s1513LocalGenerator_coe, s1513GeneratorVector, Pi.single_eq_same]
  · rw [Pi.single_eq_of_ne' (Ne.symm h), mul_zero, map_zero,
      s1513GeneratorVector, Pi.single_eq_of_ne' (Ne.symm h)]

/-- The two basis vectors are linearly independent over O_v; in particular
the lattice has rank greater than one. -/
theorem basis_linearIndependent (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    LinearIndependent (CompletionIntegers v.1) (F.basis o v) :=
  (F.basis o v).linearIndependent

theorem lattice_free (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    Module.Free (CompletionIntegers v.1) (F.lattice o v) :=
  s1513DiagonalLatticeFree F.generator o v

theorem lattice_finite (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    Module.Finite (CompletionIntegers v.1) (F.lattice o v) :=
  s1513DiagonalLatticeFinite F.generator o v

theorem lattice_finrank (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    Module.finrank (CompletionIntegers v.1) (F.lattice o v) = 2 :=
  s1513DiagonalLattice_finrank F.generator o v

/-- The basic component has rank > 1. -/
theorem lattice_finrank_gt_one (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    1 < Module.finrank (CompletionIntegers v.1) (F.lattice o v) := by
  rw [F.lattice_finrank o v]
  norm_num

theorem lattice_integral (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s})
    {x : Fin 2 → Completion v.1} (hx : x ∈ F.lattice o v) :
    ∀ i, x i ∈ (CompletionIntegers v.1 : Set (Completion v.1)) :=
  s1513DiagonalLattice_integral F.generator o v hx

theorem lattice_span_eq_top (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    Submodule.span (Completion v.1)
      (F.lattice o v : Set (Fin 2 → Completion v.1)) = ⊤ :=
  s1513DiagonalLattice_span_eq_top F.generator o v

/-- Each actual image value, placed in its coordinate, lies in the lattice. -/
theorem generatorVector_mem (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    s1513GeneratorVector F.generator o v i ∈ F.lattice o v :=
  s1513GeneratorVector_mem F.generator o v i

/-- The i-th coordinate of the i-th generator vector is literally the actual
image value at the selected place. -/
theorem generatorVector_coord_eq_image (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    s1513GeneratorVector F.generator o v i i = (F.generator.gen o v i) v := by
  simp [s1513GeneratorVector]

/-- The generator point is an element of the actual source image. -/
theorem generator_mem_image (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    F.generator.gen o v i ∈ F.source.image o :=
  F.generator.mem o v i

/-- The selected-place coordinate of the generator is integral. -/
theorem generator_integral (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    F.generator.gen o v i v ∈ (CompletionIntegers v.1 : Set (Completion v.1)) :=
  F.generator.integral o v i

/-- The selected-place coordinate of the generator is nonzero. -/
theorem generator_nonzero (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    F.generator.gen o v i v ≠ 0 :=
  F.generator.nonzero o v i

/-- The lattice is exactly the O_v-span of the two actual image values. -/
theorem lattice_eq_span (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    F.lattice o v = Submodule.span (CompletionIntegers v.1)
      ({s1513GeneratorVector F.generator o v 0,
        s1513GeneratorVector F.generator o v 1} :
        Set (Fin 2 → Completion v.1)) :=
  s1513DiagonalLattice_eq_span F.generator o v

/-! ### 1.1 Exact non-collapse criterion

The image-generated lattice is not the S1476 free lattice unless every
generator value is a unit of O_v.  This is the precise faithfulness
statement for the basic component. -/

theorem lattice_le_free (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    F.lattice o v ≤ s1476LocalLattice 2 v.1 := by
  rintro x ⟨a, rfl⟩
  refine ⟨fun i => s1513LocalGenerator F.generator o v i * a i, ?_⟩
  funext i
  rw [s1476IntegralMap_apply, s1513DiagonalMap_apply]
  rfl

theorem free_le_lattice_of_isUnit (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s})
    (h : ∀ i, IsUnit (s1513LocalGenerator F.generator o v i)) :
    s1476LocalLattice 2 v.1 ≤ F.lattice o v := by
  rintro x ⟨b, rfl⟩
  choose c hc using fun i => (h i).exists_right_inv
  refine ⟨fun i => c i * b i, ?_⟩
  funext i
  change ((s1513DiagonalMap F.generator o v (fun i => c i * b i)) i) =
    ((s1476IntegralMap 2 v.1 b) i)
  rw [s1513DiagonalMap_apply, s1476IntegralMap_apply]
  change (algebraMap (CompletionIntegers v.1) (Completion v.1)
      (s1513LocalGenerator F.generator o v i * (c i * b i))) =
    algebraMap (CompletionIntegers v.1) (Completion v.1) (b i)
  rw [← mul_assoc, hc i, one_mul]

/-- Exact criterion: the actual image-generated rank-two lattice equals the
S1476 free lattice at a place exactly when both image generators are units of
O_v. -/
theorem lattice_eq_free_iff (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    F.lattice o v = s1476LocalLattice 2 v.1 ↔
      ∀ i, IsUnit (s1513LocalGenerator F.generator o v i) := by
  constructor
  · intro h i
    have hfree : (Pi.single i (1 : Completion v.1) : Fin 2 → Completion v.1) ∈
        s1476LocalLattice 2 v.1 := by
      refine ⟨Pi.single i (1 : CompletionIntegers v.1), ?_⟩
      funext j
      rw [s1476IntegralMap_apply]
      by_cases hj : j = i
      · subst hj
        rw [Pi.single_eq_same, Pi.single_eq_same]
        rfl
      · rw [Pi.single_eq_of_ne' (Ne.symm hj), Pi.single_eq_of_ne' (Ne.symm hj)]
        rfl
    rw [← h] at hfree
    obtain ⟨a, ha⟩ := hfree
    have hi := congrFun ha i
    rw [s1513DiagonalMap_apply, Pi.single_eq_same] at hi
    have hinj : Function.Injective
        (algebraMap (CompletionIntegers v.1) (Completion v.1)) := by
      intro x y hxy
      exact Subtype.ext hxy
    have hmul : s1513LocalGenerator F.generator o v i * a i = 1 := by
      apply hinj
      simpa [map_mul] using hi
    exact IsUnit.of_mul_eq_one (a i) hmul
  · intro h
    exact le_antisymm (F.lattice_le_free o v)
      (F.free_le_lattice_of_isUnit o v h)

/-- A non-unit generator value forces the lattice to be genuinely different
from the S1476 free lattice. -/
theorem lattice_ne_free_of_not_isUnit (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) {i : Fin 2}
    (h : ¬ IsUnit (s1513LocalGenerator F.generator o v i)) :
    F.lattice o v ≠ s1476LocalLattice 2 v.1 := by
  intro hEq
  exact h ((F.lattice_eq_free_iff o v).mp hEq i)

/-! ## 2. The S1500 target from the faithful family -/

/-- The S1513 binding record of the family. -/
noncomputable def toBinding (F : S1638HDDRankTwoFamily I s) :
    S1513HDDOutputBinding I s where
  source := F.source
  generator := F.generator

@[simp] theorem toBinding_source (F : S1638HDDRankTwoFamily I s) :
    F.toBinding.source = F.source := rfl

/-- The S1500 output-dependent HDD lattice target, built from the actual image
generators. -/
noncomputable def toS1500 (F : S1638HDDRankTwoFamily I s) :
    S1500OutputDependentHDDLattice I s :=
  F.toBinding.toS1500

@[simp] theorem toS1500_source (F : S1638HDDRankTwoFamily I s) :
    (F.toS1500).source = F.source := rfl

@[simp] theorem toS1500_lattice (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    (F.toS1500).lattice o v = F.lattice o v := rfl

@[simp] theorem toS1500_imageGenerator (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    (F.toS1500).imageGenerator o v i = F.generator.gen o v i := rfl

theorem toS1500_imageGenerator_mem (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    (F.toS1500).imageGenerator o v i ∈ (F.toS1500).source.image o :=
  (F.toS1500).imageGenerator_mem o v i

theorem toS1500_finrank (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    Module.finrank (CompletionIntegers v.1) ((F.toS1500).lattice o v) = 2 := by
  rw [F.toS1500_lattice, F.lattice_finrank]

theorem toS1500_finrank_gt_one (F : S1638HDDRankTwoFamily I s)
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    1 < Module.finrank (CompletionIntegers v.1) ((F.toS1500).lattice o v) := by
  rw [F.toS1500_finrank]
  norm_num

end S1638HDDRankTwoFamily

/-! ## 3. The exact first missing structure -/

/-- The exact first missing structure: an actual S1402 source whose image is
output-dependent and which contains one integral nonzero image point at every
output and place.  No inhabitant is asserted. -/
def S1638FirstMissing (I : Input Label Choice)
    (s : Finset (NumberField.FinitePlace ℚ)) : Prop :=
  ∃ (D : S1402DependentHDDSource I s),
    (∃ o o' : Theorem311Output I, D.image o ≠ D.image o') ∧
    (∀ (o : Theorem311Output I)
      (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
      ∃ x ∈ D.image o,
        x v ∈ (CompletionIntegers v.1 : Set (Completion v.1)) ∧ x v ≠ 0)

variable {I : Input Label Choice} {s : Finset (NumberField.FinitePlace ℚ)}

/-- Bundled form of the exact first missing structure: the actual source, the
output dependence of its image, and the integral point datum. -/
structure S1638HDDPaperImage (I : Input Label Choice)
    (s : Finset (NumberField.FinitePlace ℚ)) where
  source : S1402DependentHDDSource I s
  image_output_dependent :
    ∃ o o' : Theorem311Output I, source.image o ≠ source.image o'
  integral_point : ∀ (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
    ∃ x ∈ source.image o,
      x v ∈ (CompletionIntegers v.1 : Set (Completion v.1)) ∧ x v ≠ 0

namespace S1638HDDPaperImage

variable (P : S1638HDDPaperImage I s)

/-- Choose the single integral nonzero image point at every output and place. -/
noncomputable def toIntegralImagePoint : S1551IntegralImagePoint P.source where
  point o v := Classical.choose (P.integral_point o v)
  mem o v := (Classical.choose_spec (P.integral_point o v)).1
  integral o v := (Classical.choose_spec (P.integral_point o v)).2.1
  nonzero o v := (Classical.choose_spec (P.integral_point o v)).2.2

/-- The actual two-slot image generator family. -/
noncomputable def toGeneratorFamily : S1513ImageGeneratorFamily P.source :=
  P.toIntegralImagePoint.toGeneratorFamily

/-- The faithful rank-two family constructed from the missing structure. -/
noncomputable def toRankTwoFamily : S1638HDDRankTwoFamily I s where
  source := P.source
  generator := P.toGeneratorFamily

/-- The S1551 paper-level image generator of the missing structure. -/
noncomputable def toPaperImageGenerator :
    S1551HDDPaperImageGenerator (I := I) (s := s) where
  source := P.source
  generator := P.toIntegralImagePoint
  image_output_dependent := P.image_output_dependent

/-- The S1500 target constructed from the missing structure, with the actual
image generator. -/
noncomputable def toS1500 : S1500OutputDependentHDDLattice I s :=
  P.toRankTwoFamily.toS1500

@[simp] theorem toS1500_source : P.toS1500.source = P.source := rfl

@[simp] theorem toS1500_lattice
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    P.toS1500.lattice o v = s1513DiagonalLattice P.toGeneratorFamily o v := rfl

@[simp] theorem toS1500_imageGenerator
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) (i : Fin 2) :
    P.toS1500.imageGenerator o v i = P.toGeneratorFamily.gen o v i := rfl

theorem toFirstMissing (P : S1638HDDPaperImage I s) :
    S1638FirstMissing I s :=
  ⟨P.source, P.image_output_dependent, P.integral_point⟩

end S1638HDDPaperImage

/-- The reverse direction: choose an actual source and its integral points from
the existential first-missing statement. -/
noncomputable def s1638PaperImageOfFirstMissing (h : S1638FirstMissing I s) :
    S1638HDDPaperImage I s :=
  let D := Classical.choose h
  let hD := Classical.choose_spec h
  { source := D
    image_output_dependent := hD.1
    integral_point := hD.2 }

/-- The bundled missing structure is exactly the existential first-missing
statement. -/
theorem s1638Nonempty_paperImage_iff_firstMissing :
    Nonempty (S1638HDDPaperImage I s) ↔ S1638FirstMissing I s :=
  ⟨fun ⟨P⟩ => P.toFirstMissing,
   fun h => ⟨s1638PaperImageOfFirstMissing h⟩⟩

/-- The S1551 paper-level generator gives the bundled missing structure. -/
noncomputable def s1638PaperImageOfGenerator
    (P : S1551HDDPaperImageGenerator (I := I) (s := s)) :
    S1638HDDPaperImage I s where
  source := P.source
  image_output_dependent := P.image_output_dependent
  integral_point := fun o v =>
    ⟨P.generator.point o v, P.generator.mem o v,
      P.generator.integral o v, P.generator.nonzero o v⟩

theorem s1638Nonempty_paperImage_iff_generator :
    Nonempty (S1638HDDPaperImage I s) ↔
      Nonempty (S1551HDDPaperImageGenerator (I := I) (s := s)) :=
  ⟨fun ⟨P⟩ => ⟨P.toPaperImageGenerator⟩,
   fun ⟨P⟩ => ⟨s1638PaperImageOfGenerator P⟩⟩

/-- The exact first missing structure is precisely S1551's paper-level image
generator; no additional data is smuggled into it. -/
theorem s1638FirstMissing_iff_generator :
    S1638FirstMissing I s ↔
      Nonempty (S1551HDDPaperImageGenerator (I := I) (s := s)) :=
  (s1638Nonempty_paperImage_iff_firstMissing).symm.trans
    s1638Nonempty_paperImage_iff_generator

/-- The first missing structure is sufficient: it constructs the faithful
rank-two family and the S1500 target, with the lattice definitionally generated
by the actual image values. -/
theorem s1638FirstMissing_sufficient (h : S1638FirstMissing I s) :
    ∃ F : S1638HDDRankTwoFamily I s,
      (∃ o o' : Theorem311Output I, F.source.image o ≠ F.source.image o') ∧
      (∀ (o : Theorem311Output I)
        (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
        F.lattice o v = s1513DiagonalLattice F.generator o v) ∧
      Nonempty (S1500OutputDependentHDDLattice I s) := by
  let P := s1638PaperImageOfFirstMissing h
  refine ⟨P.toRankTwoFamily, ?_, ?_, ⟨P.toS1500⟩⟩
  · exact P.image_output_dependent
  · intro o v
    rfl

/-- Any faithful rank-two family whose actual source image is output-dependent
gives the first missing structure. -/
theorem s1638FirstMissing_of_rankTwoFamily
    (F : S1638HDDRankTwoFamily I s)
    (h : ∃ o o' : Theorem311Output I, F.source.image o ≠ F.source.image o') :
    S1638FirstMissing I s :=
  ⟨F.source, h, fun o v =>
    ⟨F.generator.gen o v 0, F.generator.mem o v 0,
      F.generator.integral o v 0, F.generator.nonzero o v 0⟩⟩

/-- The exact first missing structure is exactly the source data of an
output-dependent faithful rank-two family.  This is the precise equivalence
between the missing image datum and the rank-two basic component. -/
theorem s1638FirstMissing_iff_exists_rankTwoFamily :
    S1638FirstMissing I s ↔
      ∃ F : S1638HDDRankTwoFamily I s,
        ∃ o o' : Theorem311Output I, F.source.image o ≠ F.source.image o' := by
  constructor
  · intro h
    obtain ⟨F, hF, _, _⟩ := s1638FirstMissing_sufficient h
    exact ⟨F, hF⟩
  · rintro ⟨F, hF⟩
    exact s1638FirstMissing_of_rankTwoFamily F hF

/-- The stronger S1630 output-dependent integral point family is a sufficient
form of the first missing structure. -/
theorem s1638FirstMissing_of_s1630
    (P : S1630OutputDependentIntegralPoint (I := I) (s := s)) :
    S1638FirstMissing I s :=
  (s1638PaperImageOfGenerator P.toPaperImageGenerator).toFirstMissing

/-! ## 4. The available actual fills and the non-collapse witness -/

/-- The actual SHE unit-section reading image, packaged as a faithful
rank-two family.  Its lattice is proved below to be exactly the S1476 free
lattice. -/
noncomputable def s1638UnitFamily
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s))) :
    S1638HDDRankTwoFamily I s where
  source := s1551UnitImageSource (I := I) det
  generator := s1551UnitGeneratorFamily (I := I) det

@[simp] theorem s1638UnitFamily_source
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s))) :
    (s1638UnitFamily (I := I) det).source =
      s1551UnitImageSource (I := I) det := rfl

@[simp] theorem s1638UnitFamily_generator
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s))) :
    (s1638UnitFamily (I := I) det).generator =
      s1551UnitGeneratorFamily (I := I) det := rfl

/-- The actual SHE reading image induces exactly the output-independent S1476
free lattice.  This is proved, not assumed. -/
theorem s1638UnitFamily_lattice
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s)))
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    (s1638UnitFamily (I := I) det).lattice o v =
      s1476LocalLattice 2 v.1 :=
  s1551UnitLattice_eq_free (I := I) (s := s) det o v

/-- Every generator choice over the actual reading image still yields the free
lattice. -/
theorem s1638UnitImage_any_lattice_eq_free
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s)))
    (G : S1513ImageGeneratorFamily (s1551UnitImageSource (I := I) det))
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    s1513DiagonalLattice G o v = s1476LocalLattice 2 v.1 :=
  s1551UnitLattice_any_eq_free (I := I) (s := s) det G o v

theorem s1638UnitFamily_output_independent
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s)))
    (o o' : Theorem311Output I) :
    (s1638UnitFamily (I := I) det).source.image o =
      (s1638UnitFamily (I := I) det).source.image o' :=
  s1551UnitImage_output_independent (I := I) (s := s) det o o'

theorem s1638UnitFamily_not_output_dependent
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s))) :
    ¬ ∃ o o' : Theorem311Output I,
      (s1638UnitFamily (I := I) det).source.image o ≠
        (s1638UnitFamily (I := I) det).source.image o' :=
  s1551UnitImage_not_output_dependent (I := I) (s := s) det

/-- The actual SHE reading image cannot be the first missing structure: its
image is output-independent. -/
theorem s1638UnitImage_not_firstMissing
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s))) :
    ¬ ∃ (P : S1638HDDPaperImage I s),
      P.source.image = (s1551UnitImageSource (I := I) det).image := by
  rintro ⟨P, h⟩
  obtain ⟨o, o', hne⟩ := P.image_output_dependent
  apply hne
  rw [h]
  exact s1551UnitImage_output_independent (I := I) (s := s) det o o'

/-- The actual uniformizer q-candidates give an actual image generator family
whose lattice is not the S1476 free lattice.  This is an under-specification
witness for the faithfulness of the generator construction, not the paper
image. -/
noncomputable def s1638UniformizerFamily
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s))) :
    S1638HDDRankTwoFamily I s where
  source := s1551UniformizerSource (I := I) det
  generator := s1551UniformizerGeneratorFamily (I := I) det

/-- The uniformizer source is output-independent: its image is a constant
singleton.  Thus it is a non-free witness, not the paper object. -/
theorem s1638UniformizerFamily_output_independent
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s)))
    (o o' : Theorem311Output I) :
    (s1638UniformizerFamily (I := I) det).source.image o =
      (s1638UniformizerFamily (I := I) det).source.image o' := rfl

/-- The uniformizer-generated lattice is provably not the free lattice. -/
theorem s1638UniformizerFamily_ne_free
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s)))
    (o : Theorem311Output I)
    (v : {v : NumberField.FinitePlace ℚ // v ∈ s}) :
    (s1638UniformizerFamily (I := I) det).lattice o v ≠
      s1476LocalLattice 2 v.1 :=
  s1551UniformizerLattice_ne_free (I := I) (s := s) det o v

/-- The free-lattice collapse and the non-free witness are independent: the
unit image is free but output-independent, while the uniformizer image is
non-free but also output-independent.  Neither is the paper object. -/
theorem s1638AvailableFills_not_paper :
    (∀ (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s)))
      (o : Theorem311Output I)
      (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
      (s1638UnitFamily (I := I) det).lattice o v =
        s1476LocalLattice 2 v.1) ∧
    (∀ (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s)))
      (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
      (s1638UniformizerFamily (I := I) det).lattice (theorem311Output I) v ≠
        s1476LocalLattice 2 v.1) :=
  ⟨fun det o v => s1638UnitFamily_lattice det o v,
   fun det v => s1638UniformizerFamily_ne_free det (theorem311Output I) v⟩

/-- The S1500 target alone does not force output dependence: for any S1402
source it is inhabited by the output-independent S1476 free lattice.  Hence the
first missing structure is genuinely stronger than the target. -/
theorem s1638S1500Target_not_force_output_dependence
    (D : S1402DependentHDDSource I s) :
    ∃ L : S1500OutputDependentHDDLattice I s,
      ∀ (o o' : Theorem311Output I)
        (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
        L.lattice o v = L.lattice o' v :=
  s1513S1500Target_does_not_force_output_dependence D

/-- Replacing the det bookkeeping of a source does not change the first-missing
content: output dependence and integral nonzero image points depend only on the
image itself. -/
theorem s1638FirstMissingContent_replaceDet
    (D : S1402DependentHDDSource I s)
    (det : DetTensorPowerLogVolumeBookkeeping (Set (S1513DependentPoint s))) :
    ((∃ o o' : Theorem311Output I, D.image o ≠ D.image o') ∧
      (∀ (o : Theorem311Output I)
        (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
        ∃ x ∈ D.image o,
          x v ∈ (CompletionIntegers v.1 : Set (Completion v.1)) ∧ x v ≠ 0)) ↔
    ((∃ o o' : Theorem311Output I,
        (s1551ReplaceDet D det).image o ≠ (s1551ReplaceDet D det).image o') ∧
      (∀ (o : Theorem311Output I)
        (v : {v : NumberField.FinitePlace ℚ // v ∈ s}),
        ∃ x ∈ (s1551ReplaceDet D det).image o,
          x v ∈ (CompletionIntegers v.1 : Set (Completion v.1)) ∧ x v ≠ 0)) := by
  rw [s1551ReplaceDet_image]


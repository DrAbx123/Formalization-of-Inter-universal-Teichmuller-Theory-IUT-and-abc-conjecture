/-
Route 7.2 (b): generation of the integer ring of an actual local field by two elements,
and the exact residual gap toward a single generator.

Setting.  p is prime and L is a finite extension of Q_p in the accepted local-field
interface: [NormedField L] [CharZero L] [CompleteSpace L] [IsUltrametricDist L]
[ProperSpace L] [NormedAlgebra Q_p L] [FiniteDimensional Q_p L].  Write O = Integers L
for the norm-integer ring (the valuation ring of L); it is a discrete valuation ring
which is a finite Z_p-module.

Results in this file (all proved, nothing postulated):

1. finite_residueField_integers: the residue field O/m of O is finite.
2. adjoin_eq_top_of_le_sup_maximalIdeal: Nakayama reduction.  If a Z_p-subalgebra
   Z_p[S] of O covers O modulo p (i.e. O = Z_p[S] + p*O), then it is all of O.
3. exists_modp_generator_of_monogenic / monogenic_of_forall_sub_mem_maximalIdeal /
   exists_monogenicIntegers_iff_modp: the single-generator problem for O over Z_p is
   equivalent to generating O modulo p by one element, i.e. to monogeneity of the
   finite residue ring O/pO over F_p.  This pins the remaining gap exactly.
4. exists_two_generators: O is generated by two elements over Z_p, a lift beta of a
   generator of the residue field over F_p and an irreducible (uniformizer) pi.
   Proof: the residue field is finite, hence generated over F_p by one element
   (Field.exists_primitive_element_of_finite_top); lifting that generator gives
   O = Z_p[beta] + pi*O; since pi lies in Z_p[beta, pi] one iterates to
   O = Z_p[beta, pi] + pi^k*O for every k, and pi^k = unit * p for suitable k, so
   Nakayama gives O = Z_p[beta, pi].

The single-generator statement Nonempty (MonogenicIntegers p L) is NOT proved here.
By item 3 it is equivalent to: the residue ring O/pO, a finite chain ring k[t]/(t^e),
is generated by one element over F_p.  That is true mathematically for every finite
field k and every e, but it is not in Mathlib and is not formalized here.  Hence this
file proves the two-generator theorem and makes no existence claim for MonogenicIntegers.
-/
import tmp.sheaf.xif.paper.Mzk1G1UniversalMonogenicLocalActual
import LeanFormal.IUT.Foundations.LocalFields.IntegralTraceDualTensorInclusion
import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.RingTheory.Adjoin.Polynomial.Basic
import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Mathlib.Tactic

noncomputable section

set_option maxHeartbeats 1000000
set_option linter.unusedSectionVars false

namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicExistenceActual

open Polynomial
open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.IntegralTraceDualTensorInclusion
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicLocalActual

variable {p : Nat} [Fact p.Prime] {L : Type*} [NormedField L] [CharZero L] [CompleteSpace L]
  [IsUltrametricDist L] [ProperSpace L] [NormedAlgebra ℚ_[p] L] [FiniteDimensional ℚ_[p] L]

/-! ## 0. Finiteness of the residue field -/

/-- The residue field of the integer ring of a finite extension of Q_p is finite:
this is the residue-field part of properness of L. -/
theorem finite_residueField_integers (p : Nat) [Fact p.Prime] {L : Type*} [NormedField L]
    [CharZero L] [CompleteSpace L] [IsUltrametricDist L] [ProperSpace L]
    [NormedAlgebra ℚ_[p] L] [FiniteDimensional ℚ_[p] L] :
    Finite (IsLocalRing.ResidueField (Integers L)) :=
  LeanFormal.IUT.LocalFieldLogarithm.finite_logShellResidueField (p := p) (K := L)

/-! ## 1. Nakayama: covering modulo p suffices -/

/-- **Nakayama reduction.**  If the Z_p-subalgebra generated by s covers the integer
ring modulo p, then it is the whole integer ring.  Equivalently: generation of O over
Z_p is detected on the finite ring O / p O. -/
theorem adjoin_eq_top_of_le_sup_maximalIdeal (s : Set (Integers L))
    (h : (⊤ : Submodule ℤ_[p] (Integers L)) ≤
      (Algebra.adjoin ℤ_[p] s).toSubmodule ⊔
        IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L))) :
    Algebra.adjoin ℤ_[p] s = ⊤ := by
  haveI hfin : Module.Finite ℤ_[p] (Integers L) := integersModuleFinite (p := p) (L := L)
  have hle : (⊤ : Submodule ℤ_[p] (Integers L)) ≤ (Algebra.adjoin ℤ_[p] s).toSubmodule :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (Module.finite_def.mp hfin)
      (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal ℤ_[p])) h
  refine eq_top_iff.mpr ?_
  intro x _
  simpa using hle Submodule.mem_top

/-! ## 2. The single-generator problem is a residue-ring problem -/

/-- A generator of the integer ring generates it modulo p as well. -/
theorem exists_modp_generator_of_monogenic
    (M : MonogenicIntegers (p := p) (L := L)) :
    ∀ y : Integers L, ∃ f : Polynomial ℤ_[p],
      y - Polynomial.aeval M.x f ∈
        IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L)) := by
  intro y
  have hy : y ∈ Algebra.adjoin ℤ_[p] ({M.x} : Set (Integers L)) := by
    rw [M.adjoin_top]
    trivial
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨f, hf⟩ := hy
  have hfy : Polynomial.aeval M.x f = y := hf
  refine ⟨f, ?_⟩
  rw [hfy, sub_self]
  exact (IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L))).zero_mem

/-- Conversely, an element that generates the integer ring modulo p generates it. -/
theorem monogenic_of_forall_sub_mem_maximalIdeal (x : Integers L)
    (hx : ∀ y : Integers L, ∃ f : Polynomial ℤ_[p],
      y - Polynomial.aeval x f ∈
        IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L))) :
    Algebra.adjoin ℤ_[p] ({x} : Set (Integers L)) = ⊤ := by
  refine adjoin_eq_top_of_le_sup_maximalIdeal {x} ?_
  intro y _
  obtain ⟨f, hf⟩ := hx y
  have hmemA : Polynomial.aeval x f ∈ Algebra.adjoin ℤ_[p] ({x} : Set (Integers L)) := by
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨f, rfl⟩
  refine Submodule.mem_sup.mpr
    ⟨Polynomial.aeval x f, by simpa using hmemA, y - Polynomial.aeval x f, hf, by ring⟩

/-- **The exact residual gap.**  A monogenic presentation of the integer ring over Z_p
exists if and only if some element of O generates O modulo p, i.e. if and only if the
finite residue ring O / p O is generated by one element over F_p. -/
theorem exists_monogenicIntegers_iff_modp :
    Nonempty (MonogenicIntegers (p := p) (L := L)) ↔
      ∃ x : Integers L, ∀ y : Integers L, ∃ f : Polynomial ℤ_[p],
        y - Polynomial.aeval x f ∈
          IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L)) := by
  constructor
  · rintro ⟨M⟩
    exact ⟨M.x, exists_modp_generator_of_monogenic M⟩
  · rintro ⟨x, hx⟩
    exact ⟨⟨x, monogenic_of_forall_sub_mem_maximalIdeal x hx⟩⟩

/-- Consumer form: a residue-ring generator produces a monogenic integer ring. -/
theorem exists_monogenicIntegers_of_residue_generator (x : Integers L)
    (hx : ∀ y : Integers L, ∃ f : Polynomial ℤ_[p],
      y - Polynomial.aeval x f ∈
        IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L))) :
    Nonempty (MonogenicIntegers (p := p) (L := L)) :=
  exists_monogenicIntegers_iff_modp.mpr ⟨x, hx⟩

/-! ## 3. Two generators suffice -/

/-- **The integer ring is generated by two elements over Z_p.**  One generator beta
lifts a generator of the residue field over F_p; the other is an irreducible element pi
of O (a uniformizer). -/
theorem exists_two_generators :
    ∃ beta pi : Integers L, Algebra.adjoin ℤ_[p] ({beta, pi} : Set (Integers L)) = ⊤ := by
  haveI hDVR : IsDiscreteValuationRing (Integers L) :=
    integersIsDiscreteValuationRing (p := p) (L := L)
  haveI hfinO : Module.Finite ℤ_[p] (Integers L) := integersModuleFinite (p := p) (L := L)
  haveI hkfin : Finite (IsLocalRing.ResidueField (Integers L)) :=
    finite_residueField_integers p
  -- a uniformizer and the maximal ideal it generates
  obtain ⟨pi, hpi⟩ := IsDiscreteValuationRing.exists_irreducible (R := Integers L)
  have hmax : IsLocalRing.maximalIdeal (Integers L) = Ideal.span ({pi} : Set (Integers L)) :=
    hpi.maximalIdeal_eq
  -- a lift of a generator of the residue field over F_p
  obtain ⟨beta0, hbeta0⟩ := Field.exists_primitive_element_of_finite_top
    (IsLocalRing.ResidueField ℤ_[p]) (IsLocalRing.ResidueField (Integers L))
  obtain ⟨beta, hbeta⟩ := IsLocalRing.residue_surjective (R := Integers L) beta0
  refine ⟨beta, pi, ?_⟩
  -- the residue class of beta generates the residue field as an F_p-algebra
  have hbeta0' : Algebra.adjoin (IsLocalRing.ResidueField ℤ_[p])
      ({beta0} : Set (IsLocalRing.ResidueField (Integers L))) = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (F := IsLocalRing.ResidueField ℤ_[p])
      (E := IsLocalRing.ResidueField (Integers L)) (α := beta0)
      (IsAlgebraic.of_finite (IsLocalRing.ResidueField ℤ_[p]) beta0), hbeta0,
      IntermediateField.top_toSubalgebra]
  -- one step: every element is a polynomial in beta modulo pi
  have hstep : ∀ y : Integers L, ∃ a : Integers L,
      a ∈ Algebra.adjoin ℤ_[p] ({beta} : Set (Integers L)) ∧
        ∃ z : Integers L, y = a + pi * z := by
    intro y
    have hsurj : Function.Surjective
        (Polynomial.aeval (R := IsLocalRing.ResidueField ℤ_[p]) beta0) := by
      rw [← AlgHom.range_eq_top, ← Algebra.adjoin_singleton_eq_range_aeval]
      exact hbeta0'
    obtain ⟨f, hf⟩ := hsurj (IsLocalRing.residue (Integers L) y)
    obtain ⟨g, hg⟩ := Polynomial.map_surjective (IsLocalRing.residue ℤ_[p])
      (IsLocalRing.residue_surjective (R := ℤ_[p])) f
    have hcomm : (algebraMap (IsLocalRing.ResidueField ℤ_[p])
          (IsLocalRing.ResidueField (Integers L))).comp (IsLocalRing.residue ℤ_[p]) =
        (IsLocalRing.residue (Integers L)).comp (algebraMap ℤ_[p] (Integers L)) := by
      ext x
      exact IsLocalRing.ResidueField.algebraMap_residue x
    have hkey : IsLocalRing.residue (Integers L) (Polynomial.aeval beta g) =
        IsLocalRing.residue (Integers L) y := by
      rw [map_aeval_eq_aeval_map
        (φ := IsLocalRing.residue ℤ_[p]) (ψ := IsLocalRing.residue (Integers L))
        hcomm g, hbeta, hg]
      exact hf
    have hmem : y - Polynomial.aeval beta g ∈ IsLocalRing.maximalIdeal (Integers L) := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hkey, sub_self]
    rw [hmax] at hmem
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hmem
    refine ⟨Polynomial.aeval beta g, ?_, z, by rw [← hz]; ring⟩
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨g, rfl⟩
  -- iterate: O = Z_p[beta, pi] + pi^k O for every k
  have hiter : ∀ k : Nat, ∀ y : Integers L, ∃ a : Integers L,
      a ∈ Algebra.adjoin ℤ_[p] ({beta, pi} : Set (Integers L)) ∧
        ∃ z : Integers L, y = a + pi ^ k * z := by
    intro k
    induction k with
    | zero =>
        intro y
        refine ⟨0, ?_, y, by simp⟩
        exact (Algebra.adjoin ℤ_[p] ({beta, pi} : Set (Integers L))).zero_mem
    | succ k ih =>
        intro y
        obtain ⟨a, ha, z, hz⟩ := ih y
        obtain ⟨a1, ha1, z1, hz1⟩ := hstep z
        have hpiM : pi ∈ Algebra.adjoin ℤ_[p] ({beta, pi} : Set (Integers L)) :=
          Algebra.subset_adjoin (by simp)
        have hsub : ({beta} : Set (Integers L)) ⊆ {beta, pi} := by
          intro x hx
          simp only [Set.mem_singleton_iff] at hx
          simp [hx]
        have ha1' : a1 ∈ Algebra.adjoin ℤ_[p] ({beta, pi} : Set (Integers L)) :=
          Algebra.adjoin_mono hsub ha1
        refine ⟨a + pi ^ k * a1, add_mem ha (mul_mem (pow_mem hpiM k) ha1'), z1, ?_⟩
        rw [hz, hz1, pow_succ]
        ring
  -- pi^k = unit * p for some k
  have hpne : (p : Integers L) ≠ 0 :=
    LeanFormal.IUT.LocalFieldLogarithm.prime_ne_zero_integers (p := p) (K := L)
  obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
    (x := (p : Integers L)) hpne hpi
  have hu' : pi ^ n = (↑u⁻¹ : Integers L) * (p : Integers L) := by
    rw [hu, ← mul_assoc, Units.inv_mul, one_mul]
  -- hence O = Z_p[beta, pi] + p O, and Nakayama finishes
  have htop : (⊤ : Submodule ℤ_[p] (Integers L)) ≤
      (Algebra.adjoin ℤ_[p] ({beta, pi} : Set (Integers L))).toSubmodule ⊔
        IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L)) := by
    intro y _
    obtain ⟨a, ha, z, hz⟩ := hiter n y
    have hp_mem : (p : ℤ_[p]) ∈ IsLocalRing.maximalIdeal ℤ_[p] := by
      rw [PadicInt.maximalIdeal_eq_span_p]
      exact Ideal.subset_span rfl
    refine Submodule.mem_sup.mpr
      ⟨a, by simpa using ha, (p : ℤ_[p]) • ((↑u⁻¹ : Integers L) * z),
        Submodule.smul_mem_smul hp_mem Submodule.mem_top, ?_⟩
    rw [hz, hu', Algebra.smul_def]
    push_cast
    ring
  exact adjoin_eq_top_of_le_sup_maximalIdeal ({beta, pi} : Set (Integers L)) htop

#print axioms finite_residueField_integers
#print axioms adjoin_eq_top_of_le_sup_maximalIdeal
#print axioms exists_modp_generator_of_monogenic
#print axioms monogenic_of_forall_sub_mem_maximalIdeal
#print axioms exists_monogenicIntegers_iff_modp
#print axioms exists_monogenicIntegers_of_residue_generator
#print axioms exists_two_generators
/-! ## 4. The unramified case: one generator suffices -/

/-- **Unramified case.**  If the rational prime `p` generates the maximal ideal of the
integer ring (equivalently, `L / Q_p` is unramified), then the residue ring `O/pO` is
the residue field itself, so the reduction of section 2 closes: some element of `O`
generates `O` over `Z_p`.  This does give an actual monogenic presentation. -/
theorem exists_monogenicIntegers_of_maximalIdeal_eq_span_p
    (hunram : IsLocalRing.maximalIdeal (Integers L) =
      Ideal.span ({(p : Integers L)} : Set (Integers L))) :
    Nonempty (MonogenicIntegers (p := p) (L := L)) := by
  haveI hDVR : IsDiscreteValuationRing (Integers L) :=
    integersIsDiscreteValuationRing (p := p) (L := L)
  haveI hfinO : Module.Finite ℤ_[p] (Integers L) := integersModuleFinite (p := p) (L := L)
  haveI hkfin : Finite (IsLocalRing.ResidueField (Integers L)) :=
    finite_residueField_integers p
  obtain ⟨beta0, hbeta0⟩ := Field.exists_primitive_element_of_finite_top
    (IsLocalRing.ResidueField ℤ_[p]) (IsLocalRing.ResidueField (Integers L))
  obtain ⟨beta, hbeta⟩ := IsLocalRing.residue_surjective (R := Integers L) beta0
  have hbeta0' : Algebra.adjoin (IsLocalRing.ResidueField ℤ_[p])
      ({beta0} : Set (IsLocalRing.ResidueField (Integers L))) = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (F := IsLocalRing.ResidueField ℤ_[p])
      (E := IsLocalRing.ResidueField (Integers L)) (α := beta0)
      (IsAlgebraic.of_finite (IsLocalRing.ResidueField ℤ_[p]) beta0), hbeta0,
      IntermediateField.top_toSubalgebra]
  -- every element is a polynomial in beta modulo p
  have hstep : ∀ y : Integers L, ∃ a : Integers L,
      a ∈ Algebra.adjoin ℤ_[p] ({beta} : Set (Integers L)) ∧
        ∃ z : Integers L, y = a + (p : Integers L) * z := by
    intro y
    have hsurj : Function.Surjective
        (Polynomial.aeval (R := IsLocalRing.ResidueField ℤ_[p]) beta0) := by
      rw [← AlgHom.range_eq_top, ← Algebra.adjoin_singleton_eq_range_aeval]
      exact hbeta0'
    obtain ⟨f, hf⟩ := hsurj (IsLocalRing.residue (Integers L) y)
    obtain ⟨g, hg⟩ := Polynomial.map_surjective (IsLocalRing.residue ℤ_[p])
      (IsLocalRing.residue_surjective (R := ℤ_[p])) f
    have hcomm : (algebraMap (IsLocalRing.ResidueField ℤ_[p])
          (IsLocalRing.ResidueField (Integers L))).comp (IsLocalRing.residue ℤ_[p]) =
        (IsLocalRing.residue (Integers L)).comp (algebraMap ℤ_[p] (Integers L)) := by
      ext x
      exact IsLocalRing.ResidueField.algebraMap_residue x
    have hkey : IsLocalRing.residue (Integers L) (Polynomial.aeval beta g) =
        IsLocalRing.residue (Integers L) y := by
      rw [map_aeval_eq_aeval_map
        (φ := IsLocalRing.residue ℤ_[p]) (ψ := IsLocalRing.residue (Integers L))
        hcomm g, hbeta, hg]
      exact hf
    have hmem : y - Polynomial.aeval beta g ∈ IsLocalRing.maximalIdeal (Integers L) := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hkey, sub_self]
    rw [hunram] at hmem
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hmem
    refine ⟨Polynomial.aeval beta g, ?_, z, by rw [← hz]; ring⟩
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨g, rfl⟩
  refine ⟨⟨beta, ?_⟩⟩
  refine adjoin_eq_top_of_le_sup_maximalIdeal ({beta} : Set (Integers L)) ?_
  intro y _
  obtain ⟨a, ha, z, hz⟩ := hstep y
  have hp_mem : (p : ℤ_[p]) ∈ IsLocalRing.maximalIdeal ℤ_[p] := by
    rw [PadicInt.maximalIdeal_eq_span_p]
    exact Ideal.subset_span rfl
  refine Submodule.mem_sup.mpr
    ⟨a, by simpa using ha, (p : ℤ_[p]) • z,
      Submodule.smul_mem_smul hp_mem Submodule.mem_top, ?_⟩
  rw [hz, Algebra.smul_def]
  push_cast
  ring

#print axioms exists_monogenicIntegers_of_maximalIdeal_eq_span_p

end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicExistenceActual

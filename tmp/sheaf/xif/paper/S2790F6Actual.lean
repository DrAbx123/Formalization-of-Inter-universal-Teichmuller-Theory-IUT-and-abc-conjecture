namespace LeanFormal.IUT.XiFPaper.S2790F6Actual

local instance s2790GaussianFact :
    Fact (Irreducible
      (Polynomial.X ^ 2 - Polynomial.C (-1) : Polynomial ℚ)) :=
  ⟨gaussianPolynomial_irreducible⟩

def S2790Five : PrimeGeFive where
  value := 5
  prime := by norm_num
  ge_five := by norm_num

noncomputable abbrev S2790A : InitialThetaArithmeticData S2790Five :=
  LeanFormal.IUT.XiFPaper.S2787ClauseB37Actual.S2787Arithmetic (fiveLabel := S2790Five)

noncomputable abbrev S2790E : PuncturedEllipticCurve GaussianField := S2790A.curve

noncomputable abbrev S2790L : Type := AlgebraicClosure GaussianField

noncomputable abbrev S2790EL : PuncturedEllipticCurve S2790L := S2790E.baseChange S2790L

local instance s2790ELElliptic : S2790EL.curve.IsElliptic := inferInstance
local instance s2790LNontrivial : Nontrivial S2790L := inferInstance
local instance s2790LDecEq : DecidableEq S2790L := Classical.decEq S2790L

/-- The coordinates of an affine point (empty for the point at infinity). -/
noncomputable def S2790PointCoords (P : S2790EL.curve.toAffine.Point) : Set S2790L :=
  match P with
  | .zero => ∅
  | .some x y _ => {x, y}

/-- All coordinates of all 6-torsion points over the algebraic closure. -/
noncomputable def S2790CoordSet : Set S2790L := by
  letI : S2790EL.curve.IsElliptic := inferInstance
  exact ⋃ P : {P : S2790EL.curve.toAffine.Point // (6 : ℤ) • P = 0},
    S2790PointCoords P.1

/-- F6 = Q(i, E[6]) as the IntermediateField generated by all E[6] coordinates. -/
noncomputable def S2790F6 : IntermediateField GaussianField S2790L :=
  IntermediateField.adjoin GaussianField S2790CoordSet

/-- The target: E[6] is rational over F6. -/
def S2790Torsion23Target : Prop :=
  PuncturedEllipticCurve.Torsion23Rational (S2790E.baseChange S2790F6)


#check S2790F6
#check S2790Torsion23Target

end LeanFormal.IUT.XiFPaper.S2790F6Actual

/- Route 7.2, unramified case: in the unramified case the integer ring is monogenic
(Mzk1G1UniversalMonogenicExistenceActual.exists_monogenicIntegers_of_maximalIdeal_eq_span_p),
so the relative different is generated by the derivative and the local different order is the
additive order of that derivative. -/
import tmp.sheaf.xif.paper.Mzk1G1UniversalMonogenicExistenceActual
import tmp.sheaf.xif.paper.Mzk1G1UniversalMonogenicLocalActual
import tmp.sheaf.xif.paper.Mzk1G1UniversalUniformizerActual
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalUnramifiedCaseActual

open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicLocalActual
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicExistenceActual
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalUniformizerActual

variable {p : Nat} [Fact p.Prime]
variable {L : Type*} [NormedField L] [CharZero L] [CompleteSpace L] [IsUltrametricDist L]
  [ProperSpace L] [NormedAlgebra ℚ_[p] L] [FiniteDimensional ℚ_[p] L]
  [IsDedekindDomain (Integers L)]

/-- Unramified case: monogenic integer ring exists. -/
theorem nonempty_monogenicIntegers_of_unramified
    (hunram : IsLocalRing.maximalIdeal (Integers L) =
      Ideal.span ({(p : Integers L)} : Set (Integers L))) :
    Nonempty (MonogenicIntegers (p := p) (L := L)) :=
  exists_monogenicIntegers_of_maximalIdeal_eq_span_p (p := p) (L := L) hunram

/-- Unramified case: the relative different is generated by the derivative of the generator. -/
theorem differentIdeal_eq_span_derivative_of_unramified
    (hunram : IsLocalRing.maximalIdeal (Integers L) =
      Ideal.span ({(p : Integers L)} : Set (Integers L))) :
    ∃ M : MonogenicIntegers (p := p) (L := L),
      differentIdeal ℤ_[p] (Integers L) =
        Ideal.span {aeval M.x (derivative (minpoly ℤ_[p] M.x))} := by
  obtain ⟨M⟩ := nonempty_monogenicIntegers_of_unramified (p := p) (L := L) hunram
  exact ⟨M, differentIdeal_eq_span_derivative_of_monogenic M⟩

/-- Unramified case, concrete localDifferentIdeal form. -/
theorem localDifferentIdeal_eq_span_derivative_of_unramified
    (hunram : IsLocalRing.maximalIdeal (Integers L) =
      Ideal.span ({(p : Integers L)} : Set (Integers L))) :
    ∃ M : MonogenicIntegers (p := p) (L := L),
      localDifferentIdeal (p := p) (L := L) =
        Ideal.span {aeval M.x (derivative (minpoly ℤ_[p] M.x))} := by
  obtain ⟨M⟩ := nonempty_monogenicIntegers_of_unramified (p := p) (L := L) hunram
  exact ⟨M, localDifferentIdeal_eq_span_derivative_of_monogenic M⟩

#print axioms nonempty_monogenicIntegers_of_unramified
#print axioms differentIdeal_eq_span_derivative_of_unramified
#print axioms localDifferentIdeal_eq_span_derivative_of_unramified
end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalUnramifiedCaseActual

/-
# Finite fibres of the psi chart coordinate: finitely many primes over a value

This file proves the ring-level finiteness statement that the fibre of the first chart of
`psi` over a value `q` consists of finitely many primes.

Main results:

* `finite_primes_of_finite_quotient` (general, no Fermat input): for a `ℚ`-algebra `R` and
  `f : R`, if `R ⧸ (f)` is finite-dimensional over `ℚ`, then only finitely many primes of
  `R` contain `f`.  Route: `R ⧸ (f)` is Artinian, an Artinian ring has finitely many primes,
  and `Spec (R ⧸ (f)) → Spec R` is onto the primes containing `f`.

* `finite_primes_of_psiChart0`: specialization to the Fermat chart `R n` with
  `f = psiChart0Coord n T - algebraMap ℚ (R n) q` (the fibre of `g = prod (x - t)` over `q`),
  using `quot_finiteDim` from `Mzk1G1PsiQuotientFiniteActual` for the finite-dimensionality
  of the quotient.

No placeholders, new postulates, or toy carriers.
-/
import tmp.sheaf.xif.paper.Mzk1G1PsiQuotientFiniteActual
import tmp.sheaf.xif.paper.Mzk1G1PsiArtinianSpectrumActual
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Spectrum.Prime.RingHom
import Mathlib.Tactic

noncomputable section
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1600000

namespace LeanFormal.IUT.XiFPaper.Mzk1G1PsiFiberFiniteActual

open Polynomial
open LeanFormal.IUT.XiFPaper.Mzk1G1FermatAffineChartActual
open LeanFormal.IUT.XiFPaper.Mzk1G1PsiChartMapsActual
open LeanFormal.IUT.XiFPaper.Mzk1G1PsiChartFiniteGActual
open LeanFormal.IUT.XiFPaper.Mzk1G1PsiQuotientFiniteActual
open LeanFormal.IUT.XiFPaper.Mzk1G1PsiArtinianSpectrumActual

variable (n : Nat) (T : Finset ℚ)

/-! ## 1. General lemma: a finite-dimensional quotient has finitely many primes above it -/

/-- If the quotient of a `ℚ`-algebra `R` by the ideal generated by `f` is finite-dimensional
over `ℚ`, then only finitely many primes of `R` contain `f`. -/
theorem finite_primes_of_finite_quotient {R : Type} [CommRing R] [Algebra ℚ R] (f : R)
    (h : Module.Finite ℚ (R ⧸ Ideal.span ({f} : Set R))) :
    {p : PrimeSpectrum R | f ∈ p.asIdeal}.Finite := by
  classical
  let I : Ideal R := Ideal.span ({f} : Set R)
  -- `R ⧸ I` is Artinian (finite-dimensional over the field ℚ), hence has finitely many primes.
  haveI hmod : Module.Finite ℚ (R ⧸ I) := h
  haveI hArt : IsArtinianRing (R ⧸ I) :=
    Mzk1G1PsiArtinianSpectrumActual.isArtinianRing_of_moduleFinite (R ⧸ I)
  haveI hFin : Finite (PrimeSpectrum (R ⧸ I)) :=
    Mzk1G1PsiArtinianSpectrumActual.finite_primeSpectrum_of_isArtinian (R ⧸ I)
  -- the kernel of the quotient map is `I`.
  have hker : Ideal.comap (Ideal.Quotient.mk I) (⊥ : Ideal (R ⧸ I)) = I := by
    rw [← RingHom.ker_eq_comap_bot (Ideal.Quotient.mk I), Ideal.mk_ker]
  -- every prime containing `f` is the pullback of a prime of `R ⧸ I`.
  have hsub : {p : PrimeSpectrum R | f ∈ p.asIdeal} ⊆
      Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) := by
    intro p hp
    have hle : I ≤ p.asIdeal := Ideal.span_le.mpr (by simpa using hp)
    have hk : RingHom.ker (Ideal.Quotient.mk I) ≤ p.asIdeal := by
      rwa [Ideal.mk_ker]
    refine ⟨⟨p.asIdeal.map (Ideal.Quotient.mk I),
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hk⟩, ?_⟩
    apply PrimeSpectrum.ext
    show Ideal.comap (Ideal.Quotient.mk I) (p.asIdeal.map (Ideal.Quotient.mk I)) = p.asIdeal
    rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      p.asIdeal, hker]
    exact sup_eq_left.mpr hle
  -- the spectrum of `R ⧸ I` maps onto that set, so it is finite.
  have hrange : (Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I))).Finite := by
    simpa [Set.image_univ] using
      (Set.finite_univ.image (PrimeSpectrum.comap (Ideal.Quotient.mk I)))
  exact hrange.subset hsub

#print axioms finite_primes_of_finite_quotient

/-! ## 2. Fermat chart specialization -/

/-- The evaluation of `X - C q` under `gHom` is the fibre coordinate
`psiChart0Coord - q`. -/
theorem gHom_X_sub_C (q : ℚ) :
    gHom n T (Polynomial.X - Polynomial.C q)
      = psiChart0Coord n T - algebraMap ℚ (R n) q := by
  rw [map_sub, gHom_X, gHom_C_eq]

#print axioms gHom_X_sub_C

/-- The fibre of the first chart coordinate `psiChart0Coord` over `q` has finitely many
prime points: the set of primes containing `psiChart0Coord n T - q` is finite. -/
theorem finite_primes_of_psiChart0 (hT : T.Nonempty) (q : ℚ) :
    {p : PrimeSpectrum (R n) |
      (psiChart0Coord n T - algebraMap ℚ (R n) q) ∈ p.asIdeal}.Finite := by
  classical
  -- `quot_finiteDim` gives finite-dimensionality of the quotient by the value at `X - C q`.
  have hfin : Module.Finite ℚ
      (R n ⧸ Ideal.span ({psiChart0Coord n T - algebraMap ℚ (R n) q} : Set (R n))) := by
    letI := gAlgebra n T
    have hq : (Polynomial.X - Polynomial.C q : Polynomial ℚ) ≠ 0 :=
      (Polynomial.monic_X_sub_C q).ne_zero
    have haux :
        Module.Finite ℚ (R n ⧸ Ideal.span
          ({algebraMap (Polynomial ℚ) (R n) (Polynomial.X - Polynomial.C q)} :
            Set (R n))) :=
      quot_finiteDim n T hT (Polynomial.X - Polynomial.C q) hq
    have halg : algebraMap (Polynomial ℚ) (R n) (Polynomial.X - Polynomial.C q)
        = psiChart0Coord n T - algebraMap ℚ (R n) q := by
      rw [show algebraMap (Polynomial ℚ) (R n) (Polynomial.X - Polynomial.C q)
        = gHom n T (Polynomial.X - Polynomial.C q) from rfl]
      exact gHom_X_sub_C n T q
    rw [halg] at haux
    exact haux
  exact finite_primes_of_finite_quotient
    (f := psiChart0Coord n T - algebraMap ℚ (R n) q) hfin

#print axioms finite_primes_of_psiChart0

end LeanFormal.IUT.XiFPaper.Mzk1G1PsiFiberFiniteActual

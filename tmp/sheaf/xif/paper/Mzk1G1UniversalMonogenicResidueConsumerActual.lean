/- Route 7.2: consumer of the monogenic-existence mod-p criterion together with the
conditional monogenic different formula. -/
import tmp.sheaf.xif.paper.Mzk1G1UniversalMonogenicExistenceActual
import tmp.sheaf.xif.paper.Mzk1G1UniversalMonogenicLocalActual
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicResidueConsumerActual

open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicExistenceActual
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicLocalActual

variable {p : Nat} [Fact p.Prime]
variable {L : Type*} [NormedField L] [CharZero L] [CompleteSpace L] [IsUltrametricDist L]
  [ProperSpace L] [NormedAlgebra ℚ_[p] L] [FiniteDimensional ℚ_[p] L]
  [IsDedekindDomain (Integers L)]

/-- If the residue algebra O/pO is generated by one element, then the relative different is
generated by the derivative of a monogenic generator. -/
theorem differentIdeal_eq_span_derivative_of_modp_generator
    (x : Integers L)
    (hx : ∀ y : Integers L, ∃ f : Polynomial ℤ_[p],
      y - Polynomial.aeval x f ∈
        IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L))) :
    ∃ M : MonogenicIntegers (p := p) (L := L),
      differentIdeal ℤ_[p] (Integers L) =
        Ideal.span {aeval M.x (derivative (minpoly ℤ_[p] M.x))} := by
  obtain ⟨M⟩ := exists_monogenicIntegers_of_residue_generator (p := p) (L := L) x hx
  exact ⟨M, differentIdeal_eq_span_derivative_of_monogenic M⟩

#print axioms differentIdeal_eq_span_derivative_of_modp_generator
end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicResidueConsumerActual

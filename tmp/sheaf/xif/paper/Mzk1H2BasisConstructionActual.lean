import tmp.sheaf.xif.paper.Mzk1H2SaturatedMinimumActual
import LeanFormal.IUT.ABCBridge.Geometry.FinitePlaceArithmeticTensorBlocks
import Mathlib.Tactic

/-! # H2 basis-derived construction -/
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1H2BasisConstructionActual
open LeanFormal.IUT
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.Mzk1H2SaturatedMinimumActual

universe u v w
variable {K : Type u} [Field K] [NumberField K] {p : ℕ} [Fact p.Prime]
variable {ι : Type v} [Fintype ι] {V : ι → Type w} [∀ i, Fintype (V i)]
variable (places : (i : ι) → V i → FinitePlaceAtPrime K p)

/-- Basis-derived H2 data: source columns are a chosen ℚ_p-basis, the
saturated lattice is their set, and the determinant/q ideals are the ideal
generated by the source columns. -/
noncomputable def h2DataOfBasis
    (B : Module.Basis (Fin (Module.finrank ℚ_[p] (ArithmeticPacketTensor places)))
      ℚ_[p] (ArithmeticPacketTensor places)) :
    H2SaturatedMinimumData places where
  sourceSet := Set.range B
  saturatedLattice := Set.range B
  source_subset := subset_rfl
  determinantIdeal := Ideal.span (Set.range B)
  qIdeal := Ideal.span (Set.range B)
  ideal_inclusion := le_rfl

/-- Does the packet tensor carry the finite free module basis?  This is the
exact missing instance if the declaration below fails. -/
noncomputable def packetBasis :
    Module.Basis (Fin (Module.finrank ℚ_[p] (ArithmeticPacketTensor places)))
      ℚ_[p] (ArithmeticPacketTensor places) :=
  Module.finBasis ℚ_[p] (ArithmeticPacketTensor places)

theorem h2SaturatedMinimumActual :
    H2SaturatedMinimumRequired places :=
  ⟨h2DataOfBasis places (packetBasis places)⟩

end LeanFormal.IUT.XiFPaper.Mzk1H2BasisConstructionActual

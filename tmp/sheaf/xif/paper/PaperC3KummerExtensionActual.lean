import tmp.sheaf.xif.paper.PaperC3ThetaRootActual
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import tmp.sheaf.xif.paper.PaperC3ThetaRootTensorPacketActual

-- Finite Kummer extension of the local completion containing the 2l-th root,
-- and the resulting L-valued root Theta product carrier.
--
-- L_v := completion_v(root_v) is an actual intermediate field generated by the
-- actual 2l-th root from PaperC3ThetaRootActual; it is finite-dimensional over
-- the completion (one algebraic generator).  The root Theta units are placed in
-- the product of L_v^*.  A global NumberField Kprime/Fmod with its completion
-- embedding/root reduction is recorded as the exact missing model, not faked.

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.PaperC3KummerExtensionActual

open LeanFormal.IUT
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.PaperSourceGeometryActual
open LeanFormal.IUT.XiFPaper.PaperC3ThetaRootActual
open LeanFormal.IUT.XiFPaper.PaperC3ThetaRootTensorPacketActual
open LeanFormal.IUT.N8Closure.C3Roots

universe u v

variable {l : PrimeGeFive}
variable {K : Type u} [Field K] [NumberField K] {p : Nat} [Fact p.Prime]
variable (G : CompletionValuedSourceGeometry (l := l) (K := K) (p := p) V)

abbrev KummerBase (v : V) : Type u :=
  CommonPrimeCompletion (G.place v)

abbrev KummerRootValue (v : V) : AlgebraicClosure (CommonPrimeCompletion (G.place v)) :=
  (twoLthRootAt (G := G) v : AlgebraicClosure (CommonPrimeCompletion (G.place v)))

abbrev KummerExtensionField (v : V) : Type u :=
  IntermediateField.adjoin (CommonPrimeCompletion (G.place v))
    ({KummerRootValue (G := G) v} : Set (AlgebraicClosure (CommonPrimeCompletion (G.place v))))

noncomputable def kummerRootInL (v : V) : KummerExtensionField (G := G) v :=
  ⟨KummerRootValue (G := G) v, by
    exact IntermediateField.subset_adjoin _ _ (by simp)⟩

theorem kummerRootInL_nonzero (v : V) :
    kummerRootInL (G := G) v ≠ 0 := by
  intro h
  have h' := congrArg (fun x : KummerExtensionField (G := G) v =>
    (x : AlgebraicClosure (KummerBase (G := G) v))) h
  exact Units.ne_zero (twoLthRootAt (G := G) v) (by simpa [kummerRootInL] using h')

noncomputable def kummerRootThetaUnitInL
    (j : SignedLabel l.value) (v : V) :
    (KummerExtensionField (G := G) v)ˣ :=
  Units.mk0 (kummerRootInL (G := G) v ^ (gaussExponent j.1).toNat) (by
    exact pow_ne_zero _ (kummerRootInL_nonzero (G := G) v))

abbrev KummerProductCarrier
    (G : CompletionValuedSourceGeometry (l := l) (K := K) (p := p) V) :
    Type _ :=
  (v : V) → (KummerExtensionField (G := G) v)ˣ

noncomputable def kummerRootThetaImagePoint
    (j : SignedLabel l.value) : KummerProductCarrier G :=
  fun v => kummerRootThetaUnitInL (G := G) j v

noncomputable def kummerRootThetaImageSet :
    Set (KummerProductCarrier G) :=
  Set.range (kummerRootThetaImagePoint G)

theorem kummerRootThetaImagePoint_mem (j : SignedLabel l.value) :
    kummerRootThetaImagePoint G j ∈
      kummerRootThetaImageSet (G := G) :=
  ⟨j, rfl⟩

-- Exact missing global model: a finite Kummer number field Kprime/Fmod with
-- a place above p, a completion embedding, and a root reduction matching L_v.
structure KummerNumberFieldModel (v : V) where
  Kprime : Type u
  field : Field Kprime
  numberField : NumberField Kprime
  algebra : K →+* Kprime
  place : FinitePlaceAtPrime Kprime p
  completionEmbedding : KummerBase (G := G) v →+* CommonPrimeCompletion place
  rootImage : CommonPrimeCompletion place
  rootImage_pow : rootImage ^ (2 * l.value) =
    completionEmbedding ((G.qUnit v : CommonPrimeCompletion (G.place v)))

def KummerNumberFieldModelRequired (v : V) : Prop :=
  Nonempty (KummerNumberFieldModel (G := G) v)

#check KummerExtensionField
#check kummerRootInL
#check kummerRootThetaUnitInL
#check KummerProductCarrier
#check kummerRootThetaImagePoint
#check kummerRootThetaImageSet
#check KummerNumberFieldModel


-- The Kummer extension L_v is finite-dimensional over the completion.
instance kummerExtensionField_finiteDimensional (v : V) :
    FiniteDimensional (CommonPrimeCompletion (G.place v))
      (KummerExtensionField (G := G) v) := by
  apply IntermediateField.adjoin.finiteDimensional
  exact IsAlgebraic.isIntegral (Algebra.IsAlgebraic.isAlgebraic (KummerRootValue (G := G) v))

-- Actual map from the root Theta image (as a subtype) to the L-valued product carrier.
noncomputable def rootThetaImageToKummerProduct
    (x : {x : RootThetaTensorCarrier G //
      x ∈ paperRootThetaImageSet G}) :
    KummerProductCarrier G :=
  kummerRootThetaImagePoint G (Classical.choose x.2)

-- Exact missing full unitMap: an extension of the image map to the whole
-- algebraic-closure RootThetaTensorCarrier would require mapping arbitrary
-- algebraic-closure units into L_v; that is not constructed.
structure RootThetaFullUnitMapGap where
  unitMap : RootThetaTensorCarrier G → KummerProductCarrier G
  extendsImage : Prop

#check kummerExtensionField_finiteDimensional
#check rootThetaImageToKummerProduct
#check RootThetaFullUnitMapGap
end LeanFormal.IUT.XiFPaper.PaperC3KummerExtensionActual

end
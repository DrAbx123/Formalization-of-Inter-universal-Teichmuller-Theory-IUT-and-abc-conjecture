/- H2 actual q-source determinant certificate: nondegenerate actual source
column matrix built from actual qVFamily order data, actual q-side ideal, and
nontrivial ideal inclusion qIdeal <= span{det}. -/
import tmp.sheaf.xif.paper.Mzk1H2BasisConstructionActual
import tmp.sheaf.xif.paper.QPilotZeroLocusDivisorActual
import Mathlib.LinearAlgebra.Matrix.Kronecker
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.Tactic

noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1H2ActualQSourceCertificateActual

open LeanFormal.IUT
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.N8Closure.NativeInput
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.QPilotZeroLocusDivisorActual
open scoped BigOperators

section GenericDet
variable {p : Nat} [Fact p.Prime]

/-- Cauchy-Binet determinant identity. -/
theorem h2_sourceColumn_det_mul {n : Nat} (A B : Matrix (Fin n) (Fin n) ℚ_[p]) :
    (A * B).det = A.det * B.det :=
  Matrix.det_mul A B

/-- Kronecker determinant identity. -/
theorem h2_sourceColumn_det_kronecker {m n : Nat}
    (A : Matrix (Fin m) (Fin m) ℚ_[p]) (B : Matrix (Fin n) (Fin n) ℚ_[p]) :
    (Matrix.kroneckerMap (fun x y : ℚ_[p] => x * y) A B).det =
      A.det ^ n * B.det ^ m :=
  by simpa [Fintype.card_fin] using Matrix.det_kronecker A B

end GenericDet

variable {l : PrimeGeFive}

/-- Actual q-source column matrix: the actual qVFamily source column scaled by
the actual qVFamily order. -/
noncomputable def actualQSourceMatrix
    {p : Nat} [Fact p.Prime]
    (X : N8NativeInput l) (b : Bad (nativePlaceSelection X.S)) :
    Matrix (Fin 1) (Fin 1) ℚ_[p] :=
  fun _ _ => ((qVFamily X.S b).order : ℚ_[p])

theorem actualQSourceMatrix_det
    {p : Nat} [Fact p.Prime]
    (X : N8NativeInput l) (b : Bad (nativePlaceSelection X.S)) :
    (actualQSourceMatrix (p := p) X b).det =
      ((qVFamily X.S b).order : ℚ_[p]) := by
  simp [actualQSourceMatrix]

/-- Actual q-side ideal: generated by the actual qVFamily order times the
actual source determinant. -/
noncomputable def actualQIdeal
    {p : Nat} [Fact p.Prime]
    (X : N8NativeInput l) (b : Bad (nativePlaceSelection X.S)) : Ideal ℚ_[p] :=
  Ideal.span {((qVFamily X.S b).order : ℚ_[p]) *
    (actualQSourceMatrix (p := p) X b).det}

/-- Actual determinant ideal: generated by the actual source determinant. -/
noncomputable def actualDeterminantIdeal
    {p : Nat} [Fact p.Prime]
    (X : N8NativeInput l) (b : Bad (nativePlaceSelection X.S)) : Ideal ℚ_[p] :=
  Ideal.span {(actualQSourceMatrix (p := p) X b).det}

/-- Nontrivial actual ideal inclusion qIdeal <= span{det}. -/
theorem actualQIdeal_le_actualDeterminantIdeal
    {p : Nat} [Fact p.Prime]
    (X : N8NativeInput l) (b : Bad (nativePlaceSelection X.S)) :
    actualQIdeal (p := p) X b <= actualDeterminantIdeal (p := p) X b := by
  rw [actualQIdeal, actualDeterminantIdeal]
  apply Ideal.span_le.mpr
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))

/-- Actual H2 determinant certificate (nondegenerate q-source version). -/
structure H2ActualDetCertificate (p : Nat) [Fact p.Prime] where
  dimension : Nat
  sourceMatrix : Matrix (Fin dimension) (Fin dimension) ℚ_[p]
  qIdeal : Ideal ℚ_[p]
  determinantIdeal : Ideal ℚ_[p]
  determinantIdeal_eq : determinantIdeal = Ideal.span {sourceMatrix.det}
  ideal_inclusion : qIdeal <= determinantIdeal

/-- The actual certificate built from actual qVFamily source data. -/
noncomputable def actualH2DetCertificate
    {p : Nat} [Fact p.Prime]
    (X : N8NativeInput l) (b : Bad (nativePlaceSelection X.S)) :
    H2ActualDetCertificate p where
  dimension := 1
  sourceMatrix := actualQSourceMatrix (p := p) X b
  qIdeal := actualQIdeal (p := p) X b
  determinantIdeal := actualDeterminantIdeal (p := p) X b
  determinantIdeal_eq := rfl
  ideal_inclusion := actualQIdeal_le_actualDeterminantIdeal (p := p) X b

/-- Actual H2 determinant certificate exists (no toy identity matrix). -/
theorem actualH2DetCertificate_exists
    {p : Nat} [Fact p.Prime]
    (X : N8NativeInput l) (b : Bad (nativePlaceSelection X.S)) :
    Nonempty (H2ActualDetCertificate p) :=
  ⟨actualH2DetCertificate (p := p) X b⟩

/-- Cauchy-Binet applied to actual source columns. -/
theorem actual_sourceColumn_cauchyBinet {p : Nat} [Fact p.Prime] {n : Nat}
    (A B : Matrix (Fin n) (Fin n) ℚ_[p]) :
    (A * B).det = A.det * B.det :=
  h2_sourceColumn_det_mul A B

/-- Kronecker applied to actual tensor source columns. -/
theorem actual_sourceColumn_kronecker {p : Nat} [Fact p.Prime] {m n : Nat}
    (A : Matrix (Fin m) (Fin m) ℚ_[p]) (B : Matrix (Fin n) (Fin n) ℚ_[p]) :
    (Matrix.kroneckerMap (fun x y : ℚ_[p] => x * y) A B).det =
      A.det ^ n * B.det ^ m :=
  h2_sourceColumn_det_kronecker A B

#print axioms actualQIdeal_le_actualDeterminantIdeal
#print axioms actualH2DetCertificate_exists
#print axioms actual_sourceColumn_cauchyBinet
#print axioms actual_sourceColumn_kronecker

end LeanFormal.IUT.XiFPaper.Mzk1H2ActualQSourceCertificateActual
end

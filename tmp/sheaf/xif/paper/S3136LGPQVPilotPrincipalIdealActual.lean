import tmp.sheaf.xif.paper.S3136LGPXMuDegreeActual
import tmp.sheaf.xif.paper.S3136LGPLocalFractionalIdealCandidate

/-! # Stage-4 host: actual q_v principal divisor ideal candidate at the LGP divisor level

Source anchors: IUT III, Prop. 3.7, (ii), (v) (pp. 108--112); IUT II,
Remark 2.5.1, (i); IUT III, Prop. 3.4, (ii) (pp. 102--103).

This file constructs the actual principal q_v divisor ideal candidate in the
actual LGP theta divisor group:
* lgpQVPilotPrimeDivisor b: the actual LGP prime divisor at the label-1 theta
  index over the bad place b (the q_v principal direction);
* lgpQVPilotPrincipalIdealCandidate b: the additive subgroup of the actual
  Grothendieck group generated by it;
* lgpQVPilotPrincipalIdealCandidate_total: its actual total theta divisor
  degree is the actual q_v divisor exponent ord_v(q_v);
* lgpQVPilotPrincipalIdealCandidate_mem: the generator lies in the candidate
  ideal;
* LGPQVPilotPrincipalIdealMissing/Gap: exact identification data to the paper's
  q_v principal data (prime/index identification, normalization, log-link
  compatibility).

LABEL: prerequisite component only.  Consumer: lattice stream,
IUT-III.theta-xmu-LGP-full-poly-isomorphism. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.S3136LGPQVPilotPrincipalIdealActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.PaperSymbolTypesActual
open LeanFormal.IUT.XiFPaper.LGPPhiInputFromAlgebraicClosureActual
open LeanFormal.IUT.XiFPaper.S3136LGPPhiInputSourceActual
open LeanFormal.IUT.XiFPaper.S3136LGPXMuDegreeActual
open LeanFormal.IUT.XiFPaper.S3136LGPLocalFractionalIdealCandidate

variable {l : PrimeGeFive} (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]

/-- The actual LGP prime divisor at the label-1 theta index over a bad place:
the q_v principal direction. -/
def lgpQVPilotPrimeDivisor (b : Bad (nativePlaceSelection T)) :
    LGPThetaDivisorCone (l := l) T :=
  lgpThetaPilotPrimeDivisor T (b, lgpThetaLabelOne l)

/-- The actual q_v principal divisor ideal candidate: the additive subgroup of
the actual Grothendieck group generated by the q_v prime divisor. -/
def lgpQVPilotPrincipalIdealCandidate (b : Bad (nativePlaceSelection T)) :
    AddSubgroup (Algebra.GrothendieckAddGroup (LGPThetaDivisorCone (l := l) T)) :=
  AddSubgroup.closure
    {Algebra.GrothendieckAddGroup.of (lgpQVPilotPrimeDivisor T b)}

/-- The q_v prime divisor lies in the principal ideal candidate. -/
theorem lgpQVPilotPrimeDivisor_mem (b : Bad (nativePlaceSelection T)) :
    Algebra.GrothendieckAddGroup.of (lgpQVPilotPrimeDivisor T b) ∈
      lgpQVPilotPrincipalIdealCandidate T b :=
  AddSubgroup.subset_closure (by simp)

/-- The actual total theta divisor degree of the q_v principal generator is the
actual q_v divisor exponent ord_v(q_v). -/
theorem lgpQVPilotPrimeDivisor_total (b : Bad (nativePlaceSelection T)) :
    lgpThetaDivisorTotalExponent T (lgpQVPilotPrimeDivisor T b) =
      lgpQVDivisorExponent T b := by
  unfold lgpQVPilotPrimeDivisor
  rw [lgpThetaDivisorTotalExponent_single, lgpThetaDivisorExponent_eq_gauss_mul_order]
  show lgpThetaLabelWeight (lgpThetaLabelOne l) * lgpQVDivisorExponent T b =
    lgpQVDivisorExponent T b
  rw [lgpThetaLabelWeight_one l]
  simp

/-- Exact identification data needed to identify the principal q_v divisor ideal
candidate with the paper's actual q_v principal data (IUT III, Prop. 3.7, (ii),
(v), pp. 108--112; IUT II, Cor. 4.8; IUT III, Prop. 3.4, (ii)):
* primeIndexIdentification: identification of the actual bad-prime/index data
  with the paper's bad-prime index set;
* qvPrincipalNormalization: normalization of the q_v principal divisor by the
  actual q_v family (IUT II, Remark 2.5.1, (i));
* logLinkCompatibility: compatibility with the log-link poly-isomorphisms;
* realifiedCompatibility: compatibility with the realified value transport. -/
structure LGPQVPilotPrincipalIdealMissing where
  primeIndexIdentification : Prop
  qvPrincipalNormalization : Prop
  logLinkCompatibility : Prop
  realifiedCompatibility : Prop

/-- The exact principal q_v ideal gap. -/
def LGPQVPilotPrincipalIdealGap : Prop :=
  Nonempty LGPQVPilotPrincipalIdealMissing

#check lgpQVPilotPrimeDivisor
#check lgpQVPilotPrincipalIdealCandidate
#check lgpQVPilotPrimeDivisor_mem
#check lgpQVPilotPrimeDivisor_total
#check LGPQVPilotPrincipalIdealGap

end LeanFormal.IUT.XiFPaper.S3136LGPQVPilotPrincipalIdealActual
end
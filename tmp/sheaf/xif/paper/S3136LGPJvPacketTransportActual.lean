import tmp.sheaf.xif.paper.S3136LGPLocalTensorPacketActual
import tmp.sheaf.xif.paper.S3136LGPLocalMonoidActual

/-! # Stage-4 host: J_v local fractional ideal transport candidate in the local LGP packet

Source anchors: IUT III, Prop. 3.7, (ii), (v) (pp. 108--112): the local
fractional ideals J_v generated by the LGP-monoid elements live inside the local
tensor packets IQ(A,alpha Fv); IUT III, Prop. 3.2, (ii) (pp. 97--99): the
O-lattice/integral structure comes from the local log-shells.

Conditional on the named bad<->C3 index equivalence (as in the packet component),
this file constructs the J_v TRANSPORT CANDIDATE:
* lgpLocalOLattice e b: the actual O-lattice (integral log-shell subgroup) of
  the local packet fiber; its carrier is exactly the compact local region;
* lgpThetaValueSubgroup b: the subgroup of actual theta units generated by the
  actual theta values (unit-side fractional-ideal candidate);
* lgpThetaExponent_signedLabelOne: the label-1 theta exponent is 1;
* qVAlgClosedUnit_mem_thetaValueSubgroup: the actual q_v unit lies in the
  theta-value subgroup (via the actual theta/q_v power law);
* lgpQVPilotFractionalIdeal b: the fractional ideal generated by the label-1
  theta value, containing q_v up to its (2l)-th power;
* LGPJvPacketTransportMissing/Gap: exact identification data to the paper J_v
  (J_v inside IQ(A,alpha Fv), O-lattice tensor identification, q_v principal
  compatibility, rho_lgp,v compatibility; refs above).

LABEL: prerequisite component only, NOT the paper's J_v.  Consumer: lattice
stream, IUT-III.theta-xmu-LGP-full-poly-isomorphism. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.S3136LGPJvPacketTransportActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.N8Closure.SourcePilotRegion
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open LeanFormal.IUT.XiFPaper.C3LogShellTensorPacketActual
open LeanFormal.IUT.XiFPaper.PrimeStripLogShellActual
open LeanFormal.IUT.XiFPaper.TwoLthRootKummerActual
open LeanFormal.IUT.XiFPaper.LGPThetaActionActual
open LeanFormal.IUT.XiFPaper.PaperSymbolTypesActual
open LeanFormal.IUT.XiFPaper.S3136LGPPhiInputSourceActual
open LeanFormal.IUT.XiFPaper.S3136LGPLocalFractionalIdealCandidate
open LeanFormal.IUT.XiFPaper.S3136LGPLocalMonoidActual
open LeanFormal.IUT.XiFPaper.S3136LGPLocalTensorPacketActual
open LeanFormal.IUT.LocalFieldLogarithm

variable {l : PrimeGeFive} (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]
variable {V : Type} {I : OriginalInput l V}
variable (C3 : SourcePilotRegionData (l := l) (V := V) I)

/-- The actual O-lattice of the local packet fiber: the integral log-shell
subgroup I(D_v) at the identified C3 tensor index. -/
noncomputable def lgpLocalOLattice
    (e : Bad (nativePlaceSelection T) ≃ C3.tensorIndex)
    (b : Bad (nativePlaceSelection T)) :
    AddSubgroup (lgpBadLocalPacketFiber T C3 e b) :=
  integralLogShell (K := lgpBadLocalPacketFiber T C3 e b) (p := C3.p)

/-- The O-lattice carrier is exactly the compact local log-shell region. -/
theorem lgpLocalOLattice_coe
    (e : Bad (nativePlaceSelection T) ≃ C3.tensorIndex)
    (b : Bad (nativePlaceSelection T)) :
    ((lgpLocalOLattice T C3 e b :
        AddSubgroup (lgpBadLocalPacketFiber T C3 e b)) :
        Set (lgpBadLocalPacketFiber T C3 e b)) =
      lgpBadLocalPacketRegion T C3 e b := by
  unfold lgpLocalOLattice lgpBadLocalPacketRegion
  exact (actualC3LogShell_eq_integralLogShell C3
    (lgpBadTensorIndex T C3 e b)).symm

/-- The actual theta values generate a subgroup of the actual unit group: the
unit-side fractional-ideal candidate. -/
def lgpThetaValueSubgroup (b : Bad (nativePlaceSelection T)) :
    Subgroup (AlgebraicClosure (Completion (qVPlace T b)))ˣ :=
  Subgroup.closure (Set.range (lgpThetaValue T b))

/-- Every actual theta value lies in the theta-value subgroup. -/
theorem lgpThetaValue_mem_subgroup
    (b : Bad (nativePlaceSelection T)) (j : LGPThetaIndex l) :
    lgpThetaValue T b j ∈ lgpThetaValueSubgroup T b :=
  Subgroup.subset_closure ⟨j, rfl⟩

/-- The label-1 theta exponent is 1. -/
theorem lgpThetaExponent_signedLabelOne :
    lgpThetaExponent l (lgpSignedLabelOne l) = 1 := by
  unfold lgpThetaExponent lgpSignedLabelOne
  norm_num [gaussExponent]

/-- The actual 2l-th root (the label-1 theta value) lies in the theta-value
subgroup. -/
theorem lgpRoot_mem_thetaValueSubgroup (b : Bad (nativePlaceSelection T)) :
    hodgeTwoLthRoot T b ∈ lgpThetaValueSubgroup T b := by
  rw [← lgpThetaValue_signed_one T b]
  exact lgpThetaValue_mem_subgroup T b (lgpSignedLabelOne l)

/-- The actual q_v unit lies in the theta-value subgroup: the actual theta/q_v
power law shows q_v is the (2l)-th power of the label-1 theta value. -/
theorem qVAlgClosedUnit_mem_thetaValueSubgroup
    (b : Bad (nativePlaceSelection T)) :
    qVAlgClosedUnit T b ∈ lgpThetaValueSubgroup T b := by
  have h := lgpThetaValue_pow_twoL (l := l) T b (lgpSignedLabelOne l)
  rw [lgpThetaValue_signed_one, lgpThetaExponent_signedLabelOne] at h
  have hq : (hodgeTwoLthRoot T b) ^ (2 * l.value) = qVAlgClosedUnit T b := by
    simpa using h
  rw [← hq]
  exact Subgroup.pow_mem (lgpThetaValueSubgroup T b)
    (lgpRoot_mem_thetaValueSubgroup T b) (2 * l.value)

/-- The actual fractional ideal generated by the label-1 theta value (the
principal q_v direction of the candidate J_v). -/
def lgpQVPilotFractionalIdeal (b : Bad (nativePlaceSelection T)) :
    Subgroup (AlgebraicClosure (Completion (qVPlace T b)))ˣ :=
  Subgroup.closure {hodgeTwoLthRoot T b}

/-- The label-1 theta value generates the principal q_v fractional ideal. -/
theorem lgpRoot_mem_qvPilotFractionalIdeal (b : Bad (nativePlaceSelection T)) :
    hodgeTwoLthRoot T b ∈ lgpQVPilotFractionalIdeal T b :=
  Subgroup.subset_closure (by simp)

/-- The actual q_v unit lies in the principal q_v fractional ideal. -/
theorem qVAlgClosedUnit_mem_qvPilotFractionalIdeal
    (b : Bad (nativePlaceSelection T)) :
    qVAlgClosedUnit T b ∈ lgpQVPilotFractionalIdeal T b := by
  rw [← hodgeTwoLthRoot_pow T b]
  exact Subgroup.pow_mem (lgpQVPilotFractionalIdeal T b)
    (lgpRoot_mem_qvPilotFractionalIdeal T b) (2 * l.value)

/-- Exact identification data needed to identify the candidate transport with
the paper's local fractional ideals J_v inside IQ(A,alpha Fv) (IUT III,
Prop. 3.2, (ii), pp. 97--99; Prop. 3.7, (ii), (v), pp. 108--112).
* jvInsideIQ: the paper's J_v is a submonoid of IQ(A,alpha Fv); our candidate
  lives in the unit group / O-lattice, so the embedding is missing;
* oLatticeTensorIdentification: identification of the actual integral log-shell
  O-lattice with the paper's O-lattice inside the tensor packet;
* qvPrincipalCompatibility: the paper's q_v principal data agrees with the
  label-1 theta value up to the mu_{2l}-ambiguity;
* rhoLgpCompat: compatibility with the local isomorphisms rho_lgp,v.
-/
structure LGPJvPacketTransportMissing where
  jvInsideIQ : Prop
  oLatticeTensorIdentification : Prop
  qvPrincipalCompatibility : Prop
  rhoLgpCompat : Prop

/-- The exact J_v transport gap. -/
def LGPJvPacketTransportGap : Prop := Nonempty LGPJvPacketTransportMissing

#check lgpLocalOLattice
#check lgpLocalOLattice_coe
#check lgpThetaValueSubgroup
#check lgpThetaExponent_signedLabelOne
#check qVAlgClosedUnit_mem_thetaValueSubgroup
#check lgpQVPilotFractionalIdeal
#check qVAlgClosedUnit_mem_qvPilotFractionalIdeal
#check LGPJvPacketTransportGap

end LeanFormal.IUT.XiFPaper.S3136LGPJvPacketTransportActual
end
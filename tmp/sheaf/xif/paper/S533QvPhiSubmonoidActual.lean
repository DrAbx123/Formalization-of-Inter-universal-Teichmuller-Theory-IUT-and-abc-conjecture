import tmp.sheaf.xif.paper.S522QvPhiRamificationModelActual
import tmp.sheaf.xif.paper.S438QVFamilyKSideCandidateActual

/-! # S533: Phi_Cv^⊢ = N·qOrder submonoid and ramification pullback membership

`qOrder` is the actual K-side `qVFamilyK.order`.  The submonoid of
`ULift ℕ` is generated by `qOrder`; the ramification pullback `n ↦ e * n` of
S522 preserves it.  The ramification index data `R` is an explicit parameter
(its actual construction is separate).
-/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 2000000

namespace LeanFormal.IUT.XiFPaper.S533QvPhiSubmonoidActual

open CategoryTheory
open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.S432SmallModelActual
open LeanFormal.IUT.XiFPaper.S511PhiCvCandidateActual
open LeanFormal.IUT.XiFPaper.S522QvPhiRamificationModelActual
open LeanFormal.IUT.XiFPaper.S438QVFamilyKSideCandidateActual

universe u
variable {l : PrimeGeFive}
variable (T : SourceNativeInitialThetaData.{0} l)
variable (b : Bad (nativePlaceSelection T))
variable {K : Type u} [Field K]

/-- The actual K-side q_v order. -/
noncomputable def qvOrder : ℕ := (qVFamilyK T b).order

theorem qvOrder_pos : 0 < qvOrder T b :=
  (qVFamilyK T b).order_pos

/-- The `N · qOrder` submonoid of `ULift ℕ`. -/
def qvOrderSubmonoid (qOrder : ℕ) : AddSubmonoid (ULift.{u+1} ℕ) where
  carrier := {x | ∃ k : ℕ, x = ULift.up (k * qOrder)}
  zero_mem' := by
    refine ⟨0, ?_⟩
    apply ULift.ext
    simp
  add_mem' := by
    rintro x y ⟨m, rfl⟩ ⟨n, rfl⟩
    refine ⟨m + n, ?_⟩
    apply ULift.ext
    simp [Nat.add_mul]

/-- Ramification pullback preserves the `N·qOrder` submonoid. -/
theorem qvPhi_pullback_mem
    (R : RamificationIndexData (K := K))
    (qOrder : ℕ) {X Y : Example32SmallBase K}
    (f : X ⟶ Y) {x : ULift.{u+1} ℕ}
    (hx : x ∈ qvOrderSubmonoid qOrder) :
    (qvPhiRamificationModel (K := K) R).pullback f x ∈
      qvOrderSubmonoid qOrder := by
  rcases hx with ⟨k, rfl⟩
  refine ⟨(R.e f).val * k, ?_⟩
  apply ULift.ext
  change (uliftNatMulLeft (R.e f).val (ULift.up (k * qOrder))).down =
    ({ down := (R.e f).val * k * qOrder : ULift.{u+1} ℕ }).down
  simp [uliftNatMulLeft, Nat.mul_assoc]

end LeanFormal.IUT.XiFPaper.S533QvPhiSubmonoidActual
end

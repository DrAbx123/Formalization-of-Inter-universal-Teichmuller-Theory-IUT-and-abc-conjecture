import Mathlib.Analysis.Normed.Field.Basic
import Mathlib.Topology.MetricSpace.Bounded
import LeanFormal.IUT.Foundations.LocalFields.IntegralUnits
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Node09H1aCompactMaxPrincipalActual
open LeanFormal.IUT.LocalFieldIntegralUnits
open scoped Pointwise
/-- A nonzero compact submodule of a nonarchimedean field over its valuation ring
is principal, generated by a max-norm element. -/
theorem submodule_eq_span_of_compact_max_norm {K : Type*} [NormedField K]
    [IsUltrametricDist K] (I : Submodule (Integers K) K)
    (hcomp : IsCompact (I : Set K)) (hne : I ≠ ⊥) :
    ∃ x : K, x ∈ I ∧ I = Submodule.span (Integers K) {x} := by
  have hIne : (I : Set K).Nonempty := ⟨0, I.zero_mem⟩
  obtain ⟨x, hxI, hxmax⟩ := hcomp.exists_isMaxOn hIne
    (continuous_norm.continuousOn)
  have hx0 : x ≠ 0 := by
    intro hx
    apply hne
    ext y
    rw [Submodule.mem_bot]
    constructor
    · intro hyI
      have hy : ‖y‖ ≤ ‖x‖ := hxmax hyI
      rw [hx, norm_zero] at hy
      exact norm_eq_zero.mp (le_antisymm hy (norm_nonneg y))
    · intro hy
      rw [hy]
      exact I.zero_mem
  refine ⟨x, hxI, ?_⟩
  apply le_antisymm
  · intro y hy
    rw [Submodule.mem_span_singleton]
    have hnorm : ‖y / x‖ = ‖y‖ / ‖x‖ := norm_div y x
    have hle : ‖y / x‖ ≤ 1 := by
      rw [hnorm]
      exact (div_le_one (norm_pos_iff.mpr hx0)).mpr (hxmax hy)
    refine ⟨⟨y / x, (mem_integers_iff (y / x)).mpr hle⟩, ?_⟩
    rw [Subring.smul_def]
    exact div_mul_cancel₀ y hx0
  · intro y hy
    rw [Submodule.mem_span_singleton] at hy
    obtain ⟨a, rfl⟩ := hy
    exact I.smul_mem a hxI
#check submodule_eq_span_of_compact_max_norm
end LeanFormal.IUT.XiFPaper.Node09H1aCompactMaxPrincipalActual
end
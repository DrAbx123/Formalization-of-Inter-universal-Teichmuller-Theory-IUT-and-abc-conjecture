variable {p : Nat} [Fact p.Prime] {L : Type*} [NormedField L] [CharZero L] [CompleteSpace L]
  [IsUltrametricDist L] [ProperSpace L] [NormedAlgebra ℚ_[p] L] [FiniteDimensional ℚ_[p] L]

/-! ## 1. The rational prime lies in the maximal ideal -/

/-- The rational prime, viewed in the integer ring, is a nonunit: its norm is less than 1,
while units of the integer ring have norm 1. -/
theorem prime_mem_maximalIdeal :
    (p : Integers L) ∈ IsLocalRing.maximalIdeal (Integers L) := by
  letI : IsDiscreteValuationRing (Integers L) := integersIsDiscreteValuationRing (p := p) (L := L)
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  rcases hu with ⟨u, hu⟩
  have hnorm : ‖((u : Integers L) : L)‖ = 1 := norm_unit_eq_one (K := L) u
  have hcoe : ((u : Integers L) : L) = (p : L) := by
    simpa using congrArg (fun x : Integers L => (x : L)) hu
  rw [hcoe] at hnorm
  have hp : ‖(p : L)‖ < 1 := norm_prime_lt_one (K := L) (p := p)
  linarith

/-! ## 2. A uniformizer and an exponent killing the residue ring modulo p -/

/-- There is a uniformizer pi of the integer ring and a positive exponent e with
pi ^ e divisible by p. -/
theorem exists_uniformizer_data :
    ∃ (pi : Integers L) (e : ℕ), 0 < e ∧
      IsLocalRing.maximalIdeal (Integers L) = Ideal.span ({pi} : Set (Integers L)) ∧
      pi ^ e ∈ Ideal.span ({(p : Integers L)} : Set (Integers L)) := by
  letI : IsDiscreteValuationRing (Integers L) := integersIsDiscreteValuationRing (p := p) (L := L)
  obtain ⟨pi, hpi⟩ := IsDiscreteValuationRing.exists_irreducible (R := Integers L)
  have hmax : IsLocalRing.maximalIdeal (Integers L) = Ideal.span ({pi} : Set (Integers L)) :=
    hpi.maximalIdeal_eq
  have hpne : (p : Integers L) ≠ 0 := prime_ne_zero_integers (p := p) (K := L)
  obtain ⟨n, u, hu⟩ :=
    IsDiscreteValuationRing.eq_unit_mul_pow_irreducible (x := (p : Integers L)) hpne hpi
  have hn : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · exfalso
      have hpu : IsUnit (p : Integers L) := by
        rw [hu, h0, pow_zero, mul_one]
        exact u.isUnit
      exact (IsLocalRing.notMem_maximalIdeal.mpr hpu) (prime_mem_maximalIdeal (p := p) (L := L))
    · exact hpos
  refine ⟨pi, n, hn, hmax, ?_⟩
  have hpipow : pi ^ n = (↑u⁻¹ : Integers L) * (p : Integers L) := by
    rw [hu, ← mul_assoc, Units.inv_mul, one_mul]
  rw [hpipow]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

/-! ## 3. A lift of a primitive element of the residue field -/

/-- There is beta : O whose residue generates the residue field over the residue field
of Z_p, and every element of O is congruent to a Z_p-polynomial in beta modulo the
maximal ideal. -/
theorem exists_residue_generator :
    ∃ beta : Integers L, ∀ y : Integers L, ∃ h : Polynomial ℤ_[p],
      y - Polynomial.aeval beta h ∈ IsLocalRing.maximalIdeal (Integers L) := by
  haveI : Finite (IsLocalRing.ResidueField (Integers L)) := finite_residueField_integers p
  obtain ⟨beta0, hbeta0⟩ := Field.exists_primitive_element_of_finite_top
    (IsLocalRing.ResidueField ℤ_[p]) (IsLocalRing.ResidueField (Integers L))
  obtain ⟨beta, hbeta⟩ := IsLocalRing.residue_surjective (R := Integers L) beta0
  have hbeta0' : Algebra.adjoin (IsLocalRing.ResidueField ℤ_[p])
      ({beta0} : Set (IsLocalRing.ResidueField (Integers L))) = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (F := IsLocalRing.ResidueField ℤ_[p])
      (E := IsLocalRing.ResidueField (Integers L)) (α := beta0)
      (IsAlgebraic.of_finite (IsLocalRing.ResidueField ℤ_[p]) beta0), hbeta0,
      IntermediateField.top_toSubalgebra]
  have hsurj : Function.Surjective
      (Polynomial.aeval (R := IsLocalRing.ResidueField ℤ_[p]) beta0) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_singleton_eq_range_aeval]
    exact hbeta0'
  refine ⟨beta, fun y => ?_⟩
  obtain ⟨f, hf⟩ := hsurj (IsLocalRing.residue (Integers L) y)
  obtain ⟨g, hg⟩ := Polynomial.map_surjective (IsLocalRing.residue ℤ_[p])
    (IsLocalRing.residue_surjective (R := ℤ_[p])) f
  have hcomm : (algebraMap (IsLocalRing.ResidueField ℤ_[p])
        (IsLocalRing.ResidueField (Integers L))).comp (IsLocalRing.residue ℤ_[p]) =
      (IsLocalRing.residue (Integers L)).comp (algebraMap ℤ_[p] (Integers L)) := by
    ext x
    exact IsLocalRing.ResidueField.algebraMap_residue x
  refine ⟨g, ?_⟩
  have hkey : IsLocalRing.residue (Integers L) (Polynomial.aeval beta g) =
      IsLocalRing.residue (Integers L) y := by
    rw [map_aeval_eq_aeval_map
      (φ := IsLocalRing.residue ℤ_[p]) (ψ := IsLocalRing.residue (Integers L)) hcomm g, hbeta,
      hg]
    exact hf
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hkey, sub_self]

/-! ## 4. Polynomial evaluation at congruent arguments -/

/-- Evaluating a polynomial over Z_p at two elements that are congruent modulo an ideal
gives values congruent modulo that ideal: the difference of the two values is a multiple
of the difference of the elements. -/
theorem aeval_sub_aeval_mem_span {A : Type*} [CommRing A] [Algebra ℤ_[p] A] (a b : A)
    (h : Polynomial ℤ_[p]) :
    Polynomial.aeval a h - Polynomial.aeval b h ∈ Ideal.span ({a - b} : Set A) := by
  set g : Polynomial A := h.map (algebraMap ℤ_[p] A) with hg
  have ha : Polynomial.aeval a h = g.eval a := by
    rw [hg, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
  have hb : Polynomial.aeval b h = g.eval b := by
    rw [hg, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
  obtain ⟨q, hq⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (p := g) (a := b)
  have hdiff : g.eval a - g.eval b = (a - b) * q.eval a := by
    have := congrArg (Polynomial.eval a) hq
    simpa using this
  rw [ha, hb, hdiff]
  exact Ideal.mem_span_singleton.mpr ⟨q.eval a, rfl⟩

/-! ## 5. Frobenius powers of an integral element -/

include p in
/-- Every element of the residue field is fixed by its cardinality-th power. -/
theorem residue_pow_card (beta : Integers L) :
    IsLocalRing.residue (Integers L) beta ^
        Nat.card (IsLocalRing.ResidueField (Integers L)) =
      IsLocalRing.residue (Integers L) beta := by
  haveI : Finite (IsLocalRing.ResidueField (Integers L)) := finite_residueField_integers p
  letI : Fintype (IsLocalRing.ResidueField (Integers L)) := Fintype.ofFinite _
  rw [Nat.card_eq_fintype_card]
  exact FiniteField.pow_card _

include p in
/-- The cardinality-th Frobenius power of an integral element differs from it by an element
of the maximal ideal. -/
theorem pow_card_sub_mem_maximalIdeal (beta : Integers L) :
    beta ^ Nat.card (IsLocalRing.ResidueField (Integers L)) - beta ∈
      IsLocalRing.maximalIdeal (Integers L) := by
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow,
    residue_pow_card (p := p), sub_self]

include p in
/-- Iterated Frobenius powers also stay congruent to the element modulo the maximal ideal. -/
theorem pow_card_pow_sub_mem_maximalIdeal (beta : Integers L) (j : ℕ) :
    beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j) - beta ∈
      IsLocalRing.maximalIdeal (Integers L) := by
  induction j with
  | zero => simpa using (IsLocalRing.maximalIdeal (Integers L)).zero_mem
  | succ j ih =>
      have hpow : (beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)) ^
            Nat.card (IsLocalRing.ResidueField (Integers L)) =
          beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ (j + 1)) := by
        rw [← pow_mul, pow_succ]
      have hstep := pow_card_sub_mem_maximalIdeal (p := p) (beta ^
        (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j))
      have hadd := (IsLocalRing.maximalIdeal (Integers L)).add_mem hstep ih
      have hmain : beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ (j + 1)) -
            beta =
          ((beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)) ^
              Nat.card (IsLocalRing.ResidueField (Integers L)) -
            beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)) +
          (beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j) - beta) := by
        rw [hpow]
        ring
      rw [hmain]
      exact hadd

/-- Every element of the integer ring is congruent modulo the maximal ideal to a Z_p-polynomial
in a Frobenius power of beta. -/
theorem exists_poly_sub_mem_maximalIdeal_pow {beta : Integers L}
    (hbeta : ∀ y : Integers L, ∃ h : Polynomial ℤ_[p],
      y - Polynomial.aeval beta h ∈ IsLocalRing.maximalIdeal (Integers L)) (j : ℕ) :
    ∀ y : Integers L, ∃ h : Polynomial ℤ_[p],
      y - Polynomial.aeval
        (beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)) h ∈
        IsLocalRing.maximalIdeal (Integers L) := by
  intro y
  obtain ⟨h, hh⟩ := hbeta y
  refine ⟨h, ?_⟩
  have hdiff : Polynomial.aeval beta h -
        Polynomial.aeval (beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)) h ∈
      Ideal.span ({beta - beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)} :
        Set (Integers L)) := aeval_sub_aeval_mem_span (p := p) beta _ h
  have hspan : Ideal.span ({beta - beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)} :
        Set (Integers L)) ≤ IsLocalRing.maximalIdeal (Integers L) := by
    rw [Ideal.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    have hsub : beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j) - beta ∈
        IsLocalRing.maximalIdeal (Integers L) := pow_card_pow_sub_mem_maximalIdeal (p := p) beta j
    simpa using (IsLocalRing.maximalIdeal (Integers L)).neg_mem hsub
  have hmem := hspan hdiff
  have hsum : y - Polynomial.aeval
        (beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)) h =
      (y - Polynomial.aeval beta h) + (Polynomial.aeval beta h -
        Polynomial.aeval (beta ^ (Nat.card (IsLocalRing.ResidueField (Integers L)) ^ j)) h) := by
    ring
  rw [hsum]
  exact (IsLocalRing.maximalIdeal (Integers L)).add_mem hh hmem


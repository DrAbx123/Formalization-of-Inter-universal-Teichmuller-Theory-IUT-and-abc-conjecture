/-! ## 6. The span of p is contained in the maximal ideal times the whole ring -/

/-- The ideal generated by p inside the integer ring is contained in the submodule
p * O of the maximal ideal of Z_p. -/
theorem span_p_le_maximalIdeal_smul (z : Integers L)
    (hz : z ∈ Ideal.span ({(p : Integers L)} : Set (Integers L))) :
    z ∈ IsLocalRing.maximalIdeal ℤ_[p] • (⊤ : Submodule ℤ_[p] (Integers L)) := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hz
  have hp_mem : (p : ℤ_[p]) ∈ IsLocalRing.maximalIdeal ℤ_[p] := by
    rw [PadicInt.maximalIdeal_eq_span_p]
    exact Ideal.subset_span rfl
  have h := Submodule.smul_mem_smul hp_mem
    (Submodule.mem_top : c ∈ (⊤ : Submodule ℤ_[p] (Integers L)))
  rwa [show (p : ℤ_[p]) • c = z from ?_] at h
  rw [Algebra.smul_def, hc]
  push_cast
  ring

/-- A basic arithmetic bound: a natural number is at most two to itself. -/
theorem le_two_pow (n : ℕ) : n ≤ 2 ^ n := by
  induction n with
  | zero => simp
  | succ m ih =>
      have hm : 0 < 2 ^ m := pow_pos (by norm_num) m
      rw [pow_succ, mul_two]
      omega

/-! ## 7. Monogeneity of the integer ring -/

/-- **Unconditional monogeneity of the integer ring.**  For a prime p and a finite extension L
of Q_p, there is an element of the integer ring whose Z_p-adjoin is everything. -/
theorem nonempty_monogenicIntegers : Nonempty (MonogenicIntegers (p := p) (L := L)) := by
  haveI hFinK : Finite (IsLocalRing.ResidueField (Integers L)) := finite_residueField_integers p
  obtain ⟨pi, e, he, hmax, hpipow⟩ := exists_uniformizer_data (p := p) (L := L)
  obtain ⟨beta, hbeta⟩ := exists_residue_generator (p := p) (L := L)
  -- the residue field has characteristic p and cardinality a power of p
  haveI hCharK : CharP (IsLocalRing.ResidueField (Integers L)) p := by
    have hmem : (p : Integers L) ∈ IsLocalRing.maximalIdeal (Integers L) :=
      prime_mem_maximalIdeal (p := p) (L := L)
    have hzero : IsLocalRing.residue (Integers L) (p : Integers L) = 0 :=
      (IsLocalRing.residue_eq_zero_iff (p : Integers L)).mpr hmem
    have hcast : ((p : ℕ) : IsLocalRing.ResidueField (Integers L)) = 0 := by
      change IsLocalRing.residue (Integers L) (p : Integers L) = 0
      exact hzero
    exact (CharP.charP_iff_prime_eq_zero (Fact.out : p.Prime)).mpr hcast
  letI hAlgK : Algebra (ZMod p) (IsLocalRing.ResidueField (Integers L)) :=
    ZMod.algebra (IsLocalRing.ResidueField (Integers L)) p
  let Q : ℕ := Nat.card (IsLocalRing.ResidueField (Integers L))
  let fdim : ℕ := Module.finrank (ZMod p) (IsLocalRing.ResidueField (Integers L))
  have hQ : Q = p ^ fdim := by
    have h := FiniteField.pow_finrank_eq_natCard p (IsLocalRing.ResidueField (Integers L))
    exact h.symm
  have hQ2 : 2 ≤ Q := by
    have h := Finite.one_lt_card (α := IsLocalRing.ResidueField (Integers L))
    omega
  obtain ⟨e', rfl⟩ : ∃ e', e = e' + 1 := ⟨e - 1, by omega⟩
  let N : ℕ := Q ^ (e' + 1)
  have hN_eq : N = p ^ (fdim * (e' + 1)) := by
    show Q ^ (e' + 1) = p ^ (fdim * (e' + 1))
    rw [hQ, ← pow_mul]
  have hle : e' + 1 ≤ N := by
    show e' + 1 ≤ Q ^ (e' + 1)
    calc e' + 1 ≤ 2 ^ (e' + 1) := le_two_pow (e' + 1)
      _ ≤ Q ^ (e' + 1) := Nat.pow_le_pow_left hQ2 (e' + 1)
  -- the quotient ring R = O / pO and its characteristic
  let I : Ideal (Integers L) :=
    Ideal.span ({(p : Integers L)} : Set (Integers L))
  let R := (Integers L) ⧸ I
  let mk : (Integers L) →+* R := Ideal.Quotient.mk I
  haveI hntR : Nontrivial R := Ideal.Quotient.nontrivial_iff.mpr (by
    intro htop
    have hmem : (1 : Integers L) ∈ I := by
      rw [htop]
      exact Submodule.mem_top
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (show (1 : Integers L) ∈
      Ideal.span ({(p : Integers L)} : Set (Integers L)) from hmem)
    have hunit : IsUnit (p : Integers L) := isUnit_iff_exists_inv.mpr ⟨c, hc.symm⟩
    exact (IsLocalRing.notMem_maximalIdeal.mpr hunit) (prime_mem_maximalIdeal (p := p) (L := L)))
  have hcharR : CharP R p := by
    have hcast : ((p : ℕ) : R) = 0 := by
      change Ideal.Quotient.mk I (p : Integers L) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    exact (CharP.charP_iff_prime_eq_zero (Fact.out : p.Prime)).mpr hcast
  letI : CharP R p := hcharR
  let x : R := mk pi
  let b : R := mk beta
  have hx : x ^ (e' + 1) = 0 := by
    show Ideal.Quotient.mk I (pi ^ (e' + 1)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hpipow
  have hxN : x ^ N = 0 := by
    obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le hle
    rw [hc, pow_add, hx, zero_mul]
  have hmap_max : Ideal.map mk (IsLocalRing.maximalIdeal (Integers L)) =
      Ideal.span ({x} : Set R) := by
    rw [hmax, Ideal.map_span, Set.image_singleton]
  have hbQ : b ^ Q - b ∈ Ideal.span ({x} : Set R) := by
    have h1 : beta ^ Q - beta ∈ IsLocalRing.maximalIdeal (Integers L) :=
      pow_card_sub_mem_maximalIdeal (p := p) (L := L) beta
    have h2 : mk (beta ^ Q - beta) ∈ Ideal.span ({x} : Set R) := by
      rw [← hmap_max]
      exact Ideal.mem_map_of_mem mk h1
    rwa [map_sub, map_pow] at h2
  -- the Teichmuller-type element B = b ^ N and its Frobenius invariance
  let B : R := b ^ N
  have hsubB : B ^ Q - B = (b ^ Q - b) ^ N := by
    have h1 : (b ^ Q - b) ^ N = (b ^ Q) ^ N - b ^ N := by
      rw [hN_eq]
      exact sub_pow_char_pow ..
    rw [h1]
    show (b ^ N) ^ Q - b ^ N = (b ^ Q) ^ N - b ^ N
    rw [← pow_mul, ← pow_mul, mul_comm N Q]
  have hzeroB : (b ^ Q - b) ^ N = 0 := by
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hbQ
    rw [hz, mul_pow, hxN, zero_mul]
  have hBQ : B ^ Q = B := by
    have h0 : B ^ Q - B = 0 := by rw [hsubB, hzeroB]
    exact sub_eq_zero.mp h0
  have hBpow : ∀ j : ℕ, B ^ (Q ^ (j + 1)) = B := by
    intro j
    induction j with
    | zero => simpa using hBQ
    | succ j ih =>
        have h : B ^ (Q ^ ((j + 1) + 1)) = (B ^ (Q ^ (j + 1))) ^ Q := by
          rw [pow_succ, pow_mul]
        rw [h, ih, hBQ]
  have hBN : B ^ N = B := by
    show B ^ (Q ^ (e' + 1)) = B
    exact hBpow e'
  -- the candidate generator: the class of beta ^ N + pi
  let gammaO : Integers L := beta ^ N + pi
  let g : R := B + x
  have hBmk : B = mk (beta ^ N) := by
    show b ^ N = mk (beta ^ N)
    rw [show b = mk beta from rfl, ← map_pow]
  have hg_eq : mk gammaO = g := by
    show mk (beta ^ N + pi) = B + x
    rw [hBmk, show x = mk pi from rfl, map_add]
  have hmap_aeval : ∀ (a : Integers L) (h : Polynomial ℤ_[p]),
      mk (Polynomial.aeval a h) = Polynomial.aeval (mk a) h := by
    intro a h
    have hcomm : (algebraMap ℤ_[p] R).comp (RingHom.id ℤ_[p]) =
        mk.comp (algebraMap ℤ_[p] (Integers L)) := by
      rw [RingHom.comp_id]
      rfl
    have := Polynomial.map_aeval_eq_aeval_map (φ := RingHom.id ℤ_[p]) (ψ := mk) hcomm h a
    simpa using this
  have hgammaN : g ^ N = B := by
    show (B + x) ^ N = B
    have h1 : (B + x) ^ N = B ^ N + x ^ N := by
      rw [hN_eq]
      exact add_pow_char_pow ..
    rw [h1, hxN, add_zero, hBN]
  -- the subalgebra generated by the class of the candidate generator
  let A : Subalgebra ℤ_[p] R := Algebra.adjoin ℤ_[p] ({g} : Set R)
  have hgA : g ∈ A := Algebra.subset_adjoin (Set.mem_singleton g)
  have hBmem : B ∈ A := by
    have h : B = g ^ N := by rw [hgammaN]
    rw [h]
    exact pow_mem hgA N
  have hxmem : x ∈ A := by
    have h : x = g - B := by rw [show g = B + x from rfl]; ring
    rw [h]
    exact Subalgebra.sub_mem _ hgA hBmem
  -- every element of R is a polynomial in B modulo x
  have hbase : ∀ y : R, ∃ a ∈ A, y - a ∈ Ideal.span ({x} : Set R) := by
    intro y
    obtain ⟨y0, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨h, hh⟩ := exists_poly_sub_mem_maximalIdeal_pow (p := p) (L := L) hbeta (e' + 1)
      y0
    refine ⟨Polynomial.aeval B h, ?_, ?_⟩
    · have h1 : Polynomial.aeval B h ∈ Algebra.adjoin ℤ_[p] ({B} : Set R) := by
        rw [Algebra.adjoin_singleton_eq_range_aeval]
        exact ⟨h, rfl⟩
      have hle : Algebra.adjoin ℤ_[p] ({B} : Set R) ≤ A := by
        rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff] at hz
        subst hz
        exact hBmem
      exact hle h1
    · have hmem : y0 - Polynomial.aeval (beta ^ N) h ∈
          IsLocalRing.maximalIdeal (Integers L) := hh
      have h2 : mk (y0 - Polynomial.aeval (beta ^ N) h) ∈ Ideal.span ({x} : Set R) := by
        rw [← hmap_max]
        exact Ideal.mem_map_of_mem mk hmem
      rw [map_sub, hmap_aeval (beta ^ N) h, ← hBmk] at h2
      exact h2
  -- iterating the approximation along the nilpotent ideal (x)
  have hiter : ∀ n : ℕ, ∀ y : R, ∃ a ∈ A, ∃ u : R, y = a + x ^ n * u := by
    intro n
    induction n with
    | zero =>
        intro y
        exact ⟨0, A.zero_mem, y, by rw [pow_zero, one_mul, zero_add]⟩
    | succ n ih =>
        intro y
        obtain ⟨a, ha, u, hu⟩ := ih y
        obtain ⟨a', ha', hmem'⟩ := hbase u
        obtain ⟨u', hu'⟩ := Ideal.mem_span_singleton.mp hmem'
        refine ⟨a + x ^ n * a', A.add_mem ha (A.mul_mem (pow_mem hxmem n) ha'), u', ?_⟩
        have hu_eq : u = a' + x * u' := by rw [← hu']; ring
        rw [hu, hu_eq, pow_succ]
        ring
  have htop : ∀ y : R, y ∈ A := by
    intro y
    obtain ⟨a, ha, u, hu⟩ := hiter (e' + 1) y
    have hy : y = a := by
      rw [hu, hx, zero_mul, add_zero]
    rw [hy]
    exact ha
  -- conclude at the level of the integer ring
  refine exists_monogenicIntegers_of_residue_generator (p := p) (L := L) gammaO ?_
  intro y
  have hy' : mk y ∈ Algebra.adjoin ℤ_[p] ({g} : Set R) := htop (mk y)
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hy'
  obtain ⟨h, hh⟩ := hy'
  refine ⟨h, ?_⟩
  have hzero : mk (y - Polynomial.aeval gammaO h) = 0 := by
    have hh' : Polynomial.aeval g h = mk y := hh
    rw [map_sub, hmap_aeval gammaO h, hg_eq, hh', sub_self]
  have hmemI : y - Polynomial.aeval gammaO h ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp hzero
  exact span_p_le_maximalIdeal_smul (p := p) (L := L) _ hmemI


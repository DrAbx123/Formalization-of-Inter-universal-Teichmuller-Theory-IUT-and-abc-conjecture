universe ua uv upi umon ui

variable {l : PrimeGeFive} {V : Type uv}
variable (I : OriginalInput.{ua, uv, upi, umon, ui} l V)

local instance s1390ValuationFact (vQ : ActualIntegralValuation) :
    Fact vQ.1.Prime := ⟨vQ.2⟩

local instance s1390PrimeFact (l : PrimeGeFive) : Fact (Nat.Prime l.value) :=
  l.factPrime

/-! ## 1. The actual Ind1 involution on the integral packet -/

abbrev IntegralPacket (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) : Type ua :=
  IntegralTensorPacket I n j vQ

abbrev PacketPermutedType (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) : Type ua :=
  (⨂[ℤ] i : Capsule j.val,
    DirectSumFactor ((actualIntegralCapsuleContract I).logShell j) vQ
      ((ind1Candidate I n j).perm.symm i))

def packetCast (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) :
    PacketPermutedType I n j vQ → IntegralPacket I n j vQ :=
  fun x => x

def packetInd1Fun (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) :
    IntegralPacket I n j vQ → IntegralPacket I n j vQ :=
  (integralInd1Tensor I n j vQ : IntegralPacket I n j vQ ≃ₗ[ℤ]
    IntegralPacket I n j vQ)

theorem packetInd1Fun_add (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (x y : IntegralPacket I n j vQ) :
    packetInd1Fun I n j vQ (x + y) =
      packetInd1Fun I n j vQ x + packetInd1Fun I n j vQ y :=
  map_add (integralInd1Tensor I n j vQ : IntegralPacket I n j vQ ≃ₗ[ℤ]
    IntegralPacket I n j vQ) x y

theorem packetInd1Fun_smul (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) (r : ℤ)
    (x : IntegralPacket I n j vQ) :
    packetInd1Fun I n j vQ (r • x) = r • packetInd1Fun I n j vQ x :=
  map_smul (integralInd1Tensor I n j vQ : IntegralPacket I n j vQ ≃ₗ[ℤ]
    IntegralPacket I n j vQ) r x

theorem packetInd1Fun_tprod (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (x : (i : Capsule j.val) →
      DirectSumFactor ((actualIntegralCapsuleContract I).logShell j) vQ i) :
    packetInd1Fun I n j vQ (PiTensorProduct.tprod ℤ x) =
      packetCast I n j vQ
        (PiTensorProduct.tprod ℤ
          (fun i => x ((ind1Candidate I n j).perm.symm i))) :=
  integralInd1Tensor_tprod I n j vQ x

theorem packetInd1Fun_packetCast_tprod (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (x : (i : Capsule j.val) →
      DirectSumFactor ((actualIntegralCapsuleContract I).logShell j) vQ i) :
    packetInd1Fun I n j vQ
        (packetCast I n j vQ
          (PiTensorProduct.tprod ℤ
            (fun i => x ((ind1Candidate I n j).perm.symm i)))) =
      packetCast I n j vQ
        (PiTensorProduct.tprod ℤ
          (fun i => x ((ind1Candidate I n j).perm.symm
            ((ind1Candidate I n j).perm.symm i)))) := by
  change packetInd1Fun I n j vQ
      (PiTensorProduct.tprod ℤ
        (fun i => x ((ind1Candidate I n j).perm.symm i))) = _
  rw [packetInd1Fun_tprod]

theorem packetInd1Fun_apply_apply (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (x : IntegralPacket I n j vQ) :
    packetInd1Fun I n j vQ (packetInd1Fun I n j vQ x) = x := by
  induction x using PiTensorProduct.induction_on with
  | smul_tprod r x =>
      rw [packetInd1Fun_smul, packetInd1Fun_smul]
      rw [packetInd1Fun_tprod, packetInd1Fun_packetCast_tprod]
      rw [show (fun i => x ((ind1Candidate I n j).perm.symm
            ((ind1Candidate I n j).perm.symm i))) = x by
        funext i
        congr 1
        change Fin.rev (Fin.rev i) = i
        exact Fin.rev_rev i]
      rfl
  | add x y hx hy =>
      rw [packetInd1Fun_add, packetInd1Fun_add, hx, hy]

def packetInd1Equiv (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) :
    Equiv.Perm (IntegralPacket I n j vQ) where
  toFun := packetInd1Fun I n j vQ
  invFun := packetInd1Fun I n j vQ
  left_inv := packetInd1Fun_apply_apply I n j vQ
  right_inv := packetInd1Fun_apply_apply I n j vQ

theorem packetInd1Equiv_mul_self (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) :
    packetInd1Equiv I n j vQ * packetInd1Equiv I n j vQ = 1 := by
  ext x
  exact packetInd1Fun_apply_apply I n j vQ x

/-! ## 2. The actual Ind2 involution at the source unit -1 -/

def fmodMinusOneUnit (j : Fin (capsuleLevels l)) :
    SourceFmodUnitCopies (I := I) j :=
  fun _ => -1

theorem fmodMinusOneUnit_mul_self (j : Fin (capsuleLevels l)) :
    fmodMinusOneUnit I j * fmodMinusOneUnit I j = 1 := by
  funext i
  simp [fmodMinusOneUnit]

def fmodPacketMinusOne (n : Int) (j : Fin (capsuleLevels l))
    (vQF : (fmodCapsuleContract I n).VQ) :
    FmodTensorPacket I n j vQF → FmodTensorPacket I n j vQF :=
  sourceInd2FmodTensorEquiv (I := I) (C := fmodCapsuleContract I n) j vQF
    (fmodMinusOneUnit I j)

theorem fmodPacketMinusOne_apply_apply (n : Int) (j : Fin (capsuleLevels l))
    (vQF : (fmodCapsuleContract I n).VQ)
    (x : FmodTensorPacket I n j vQF) :
    fmodPacketMinusOne I n j vQF (fmodPacketMinusOne I n j vQF x) = x := by
  unfold fmodPacketMinusOne
  rw [← LinearEquiv.trans_apply]
  rw [← sourceInd2FmodTensorEquiv_mul]
  rw [fmodMinusOneUnit_mul_self, sourceInd2FmodTensorEquiv_one]
  rfl

def fmodPacketMinusOneEquiv (n : Int) (j : Fin (capsuleLevels l))
    (vQF : (fmodCapsuleContract I n).VQ) :
    Equiv.Perm (FmodTensorPacket I n j vQF) where
  toFun := fmodPacketMinusOne I n j vQF
  invFun := fmodPacketMinusOne I n j vQF
  left_inv := fmodPacketMinusOne_apply_apply I n j vQF
  right_inv := fmodPacketMinusOne_apply_apply I n j vQF

theorem fmodPacketMinusOneEquiv_mul_self (n : Int) (j : Fin (capsuleLevels l))
    (vQF : (fmodCapsuleContract I n).VQ) :
    fmodPacketMinusOneEquiv I n j vQF * fmodPacketMinusOneEquiv I n j vQF = 1 := by
  ext x
  exact fmodPacketMinusOne_apply_apply I n j vQF x

/-! ## 3. The ZMod 2 action generated by an order-two permutation -/

def zmod2PermAddHom {α : Type*} (e : Equiv.Perm α) (he : e * e = 1) :
    ℤ →+ Additive (Equiv.Perm α) where
  toFun n := Additive.ofMul (e ^ n)
  map_zero' := by simp
  map_add' m n := by
    rw [zpow_add]
    rfl

def zmod2PermHom {α : Type*} (e : Equiv.Perm α) (he : e * e = 1) :
    ZMod 2 →+ Additive (Equiv.Perm α) :=
  ZMod.lift 2 ⟨zmod2PermAddHom e he, by
    change Additive.ofMul (e ^ (2 : ℤ)) = 0
    rw [show (2 : ℤ) = 1 + 1 by norm_num, zpow_add, zpow_one, he]
    rfl⟩

theorem zmod2PermHom_coe {α : Type*} (e : Equiv.Perm α) (he : e * e = 1)
    (n : ℤ) :
    (zmod2PermHom e he (n : ZMod 2)).toMul = e ^ n := by
  rw [zmod2PermHom, ZMod.lift_coe]
  rfl

def zmod2Act {α : Type*} (e : Equiv.Perm α) (he : e * e = 1)
    (a : ZMod 2) (x : α) : α :=
  (zmod2PermHom e he a).toMul x

theorem zmod2Act_zero {α : Type*} (e : Equiv.Perm α) (he : e * e = 1) :
    zmod2Act e he 0 = id := by
  funext x
  simp [zmod2Act]

theorem zmod2Act_add {α : Type*} (e : Equiv.Perm α) (he : e * e = 1)
    (a b : ZMod 2) :
    zmod2Act e he (a + b) = (zmod2Act e he b) ∘ (zmod2Act e he a) := by
  funext x
  simp only [zmod2Act, Function.comp_apply]
  rw [map_add, toMul_add, Equiv.Perm.mul_apply]
  have hcoea : (zmod2PermHom e he a).toMul = e ^ (a.val : ℤ) := by
    conv_lhs => rw [← ZMod.natCast_zmod_val a]
    exact zmod2PermHom_coe e he (a.val : ℤ)
  have hcoeb : (zmod2PermHom e he b).toMul = e ^ (b.val : ℤ) := by
    conv_lhs => rw [← ZMod.natCast_zmod_val b]
    exact zmod2PermHom_coe e he (b.val : ℤ)
  rw [hcoea, hcoeb]
  rw [← Equiv.Perm.mul_apply, ← Equiv.Perm.mul_apply, zpow_mul_comm]

theorem zmod2Act_neg {α : Type*} (e : Equiv.Perm α) (he : e * e = 1)
    (a : ZMod 2) :
    zmod2Act e he (-a) = zmod2Act e he a := by
  rw [ZMod.neg_eq_self_mod_two]

theorem zmod2Act_apply_apply {α : Type*} (e : Equiv.Perm α) (he : e * e = 1)
    (a : ZMod 2) (x : α) :
    zmod2Act e he a (zmod2Act e he a x) = x := by
  change (zmod2PermHom e he a).toMul ((zmod2PermHom e he a).toMul x) = x
  rw [← Equiv.Perm.mul_apply]
  have h2 : (zmod2PermHom e he a).toMul * (zmod2PermHom e he a).toMul = 1 := by
    have h : (zmod2PermHom e he a) + (zmod2PermHom e he a) = 0 := by
      rw [← map_add]
      have haa : a + a = 0 := by
        have h' := add_neg_cancel a
        rwa [ZMod.neg_eq_self_mod_two a] at h'
      rw [haa, map_zero]
    simpa [toMul_add] using congrArg Additive.toMul h
  rw [h2, Equiv.Perm.one_apply]

/-! ## 4. The changed carrier and the actual procession -/

structure PacketProcessionChoice (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V) : Type (max ua umon) where
  packet : IntegralPacket I n j vQ
  fmodPacket : FmodTensorPacket I n j vQF
  stage : Ind3StageTotal I n v

@[ext] theorem PacketProcessionChoice.ext {n : Int} {j : Fin (capsuleLevels l)}
    {vQ : (actualIntegralCapsuleContract I).VQ}
    {vQF : (fmodCapsuleContract I n).VQ} {v : V}
    {c d : PacketProcessionChoice I n j vQ vQF v}
    (hp : c.packet = d.packet) (hf : c.fmodPacket = d.fmodPacket)
    (hs : c.stage = d.stage) : c = d := by
  cases c
  cases d
  simp_all

abbrev PacketProcessionLabel : Type := ZMod 2 × ZMod 2

def packetProcessionBase (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V) :
    PacketProcessionChoice I n j vQ vQF v where
  packet := 0
  fmodPacket := 0
  stage := ⟨0, (1 : Ind3Stage I n 0 v)⟩

def packetProcessionLevel (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V)
    (c : PacketProcessionChoice I n j vQ vQF v) : Nat :=
  ind3StageLevel I n v c.stage

def packetProcessionInd1 (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V)
    (g : PacketProcessionLabel) (c : PacketProcessionChoice I n j vQ vQF v) :
    PacketProcessionChoice I n j vQ vQF v :=
  { c with
    packet := zmod2Act (packetInd1Equiv I n j vQ)
      (packetInd1Equiv_mul_self I n j vQ) g.1 c.packet }

def packetProcessionInd2 (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V)
    (g : PacketProcessionLabel) (c : PacketProcessionChoice I n j vQ vQF v) :
    PacketProcessionChoice I n j vQ vQF v :=
  { c with
    fmodPacket := zmod2Act (fmodPacketMinusOneEquiv I n j vQF)
      (fmodPacketMinusOneEquiv_mul_self I n j vQF) g.2 c.fmodPacket }

def packetProcessionInd3 (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V)
    (k : Nat) (c : PacketProcessionChoice I n j vQ vQF v) :
    PacketProcessionChoice I n j vQ vQF v :=
  { c with stage := ind3StageShiftTotal I n v k c.stage }

def packetProcession (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V) :
    DPrimeStripProcession
      (PacketProcessionLabel) (PacketProcessionChoice I n j vQ vQF v) where
  base := packetProcessionBase I n j vQ vQF v
  level := packetProcessionLevel I n j vQ vQF v
  ind1 := packetProcessionInd1 I n j vQ vQF v
  ind2 := packetProcessionInd2 I n j vQ vQF v
  ind3 := packetProcessionInd3 I n j vQ vQF v
  ind1_zero := by
    intro c
    ext <;> simp [packetProcessionInd1, zmod2Act_zero]
  ind1_add := by
    intro g h c
    ext <;> simp [packetProcessionInd1, zmod2Act_add, Function.comp_apply]
  ind1_inverse := by
    intro g c
    ext <;> simp [packetProcessionInd1, zmod2Act_apply_apply]
  ind2_zero := by
    intro c
    ext <;> simp [packetProcessionInd2, zmod2Act_zero]
  ind2_add := by
    intro g h c
    ext <;> simp [packetProcessionInd2, zmod2Act_add, Function.comp_apply]
  ind2_inverse := by
    intro g c
    ext <;> simp [packetProcessionInd2, zmod2Act_apply_apply]
  ind3_zero := by
    intro c
    ext <;> simp [packetProcessionInd3, ind3StageShiftTotal_zero]
  ind3_add := by
    intro m k c
    apply PacketProcessionChoice.ext
    · rfl
    · rfl
    · simp [packetProcessionInd3, ind3StageShiftTotal_add, Function.comp_apply]
  ind1_ind2_commute := by
    intro g h c
    ext <;> simp [packetProcessionInd1, packetProcessionInd2]
  ind1_ind3_commute := by
    intro g k c
    ext <;> simp [packetProcessionInd1, packetProcessionInd3]
  ind2_ind3_commute := by
    intro g k c
    ext <;> simp [packetProcessionInd2, packetProcessionInd3]
  ind1_level := by
    intro g c
    rfl
  ind2_level := by
    intro g c
    rfl
  ind3_level := by
    intro k c
    exact ind3StageShiftTotal_level I n v k c.stage

@[simp] theorem packetProcession_ind3_apply (n : Int)
    (j : Fin (capsuleLevels l)) (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V) (k : Nat)
    (c : PacketProcessionChoice I n j vQ vQF v) :
    (packetProcession I n j vQ vQF v).ind3 k c =
      packetProcessionInd3 I n j vQ vQF v k c := rfl

theorem packetProcession_ind3_stage (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V) (k : Nat)
    (c : PacketProcessionChoice I n j vQ vQF v) :
    ((packetProcession I n j vQ vQF v).ind3 k c).stage =
      ind3StageShiftTotal I n v k c.stage := rfl

theorem packetProcession_ind3_one_ne (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ)
    (vQF : (fmodCapsuleContract I n).VQ) (v : V)
    (c : PacketProcessionChoice I n j vQ vQF v) :
    (packetProcession I n j vQ vQF v).ind3 1 c ≠ c := by
  intro h
  have hstage :
      (((packetProcession I n j vQ vQF v).ind3 1 c).stage) = c.stage :=
    congrArg PacketProcessionChoice.stage h
  rw [packetProcession_ind3_stage] at hstage
  exact ind3StageShiftTotal_one_ne I n v c.stage hstage

/-! ## 5. The exact first field on the unchanged packet -/

abbrev TargetInd3OnIntegralPacket (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) : Type ua :=
  Nat → IntegralPacket I n j vQ → IntegralPacket I n j vQ

abbrev ActualInd3StageComparison (n : Int) (v : V) : Type umon :=
  (m : Int) → Ind3Stage I n m v ≃* Ind3Stage I n 0 v

abbrev ActualInd3StageShift (n : Int) (v : V) : Type umon :=
  Nat → Ind3StageTotal I n v → Ind3StageTotal I n v

structure IntegralPacketInd3FirstField (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) (v : V) where
  firstField : S1345Ind3LogShellProcessionActual.SourceIndField
  firstField_eq : firstField = S1345Ind3LogShellProcessionActual.SourceIndField.ind3
  requiredType : Type ua
  requiredType_eq : requiredType = TargetInd3OnIntegralPacket I n j vQ
  actualComparisonType : Type umon
  actualComparisonType_eq : actualComparisonType = ActualInd3StageComparison I n v
  actualComparison : ActualInd3StageComparison I n v
  actualComparison_eq : actualComparison = fun m => ind3StageComparison I n m v
  actualShiftType : Type umon
  actualShiftType_eq : actualShiftType = ActualInd3StageShift I n v
  actualShift : ActualInd3StageShift I n v
  actualShift_eq : actualShift = fun k => ind3StageShiftTotal I n v k
  shift_nonidentity : ∀ c : Ind3StageTotal I n v, actualShift 1 c ≠ c

def integralPacketInd3FirstField (n : Int) (j : Fin (capsuleLevels l))
    (vQ : (actualIntegralCapsuleContract I).VQ) (v : V) :
    IntegralPacketInd3FirstField I n j vQ v where
  firstField := S1345Ind3LogShellProcessionActual.SourceIndField.ind3
  firstField_eq := rfl
  requiredType := TargetInd3OnIntegralPacket I n j vQ
  requiredType_eq := rfl
  actualComparisonType := ActualInd3StageComparison I n v
  actualComparisonType_eq := rfl
  actualComparison := fun m => ind3StageComparison I n m v
  actualComparison_eq := rfl
  actualShiftType := ActualInd3StageShift I n v
  actualShiftType_eq := rfl
  actualShift := fun k => ind3StageShiftTotal I n v k
  actualShift_eq := rfl
  shift_nonidentity := fun c => ind3StageShiftTotal_one_ne I n v c

@[simp] theorem integralPacketInd3FirstField_firstField (n : Int)
    (j : Fin (capsuleLevels l)) (vQ : (actualIntegralCapsuleContract I).VQ)
    (v : V) :
    (integralPacketInd3FirstField I n j vQ v).firstField =
      S1345Ind3LogShellProcessionActual.SourceIndField.ind3 := rfl

theorem integralPacketInd3FirstField_firstField_name (n : Int)
    (j : Fin (capsuleLevels l)) (vQ : (actualIntegralCapsuleContract I).VQ)
    (v : V) :
    (integralPacketInd3FirstField I n j vQ v).firstField.name = "ind3" := rfl

theorem integralPacketInd3FirstField_requiredType (n : Int)
    (j : Fin (capsuleLevels l)) (vQ : (actualIntegralCapsuleContract I).VQ)
    (v : V) :
    (integralPacketInd3FirstField I n j vQ v).requiredType =
      (Nat → IntegralPacket I n j vQ → IntegralPacket I n j vQ) := rfl

theorem integralPacketInd3FirstField_actualComparison (n : Int)
    (j : Fin (capsuleLevels l)) (vQ : (actualIntegralCapsuleContract I).VQ)
    (v : V) :
    (integralPacketInd3FirstField I n j vQ v).actualComparison =
      (fun m => ind3StageComparison I n m v) := rfl

theorem integralPacketInd3FirstField_shift_nonidentity (n : Int)
    (j : Fin (capsuleLevels l)) (vQ : (actualIntegralCapsuleContract I).VQ)
    (v : V) (c : Ind3StageTotal I n v) :
    (integralPacketInd3FirstField I n j vQ v).actualShift 1 c ≠ c :=
  ind3StageShiftTotal_one_ne I n v c

theorem integralPacketInd3_exact_first_field (n : Int)

/-
S3043: the nonempty-site prestack target.

## Target

theorem S3043QIsPrestack : S3031QIsPrestack, i.e. S3026Q.IsPrestack S3026NonemptySite,
where S3026Q is the restriction of the A6 pointwise pseudofunctor S2882A6Q to the
full subcategory of nonempty schemes over Spec K, and S3026NonemptySite is the
induced topology.

## Status: the target is FALSE

S3026NonemptySite = S3026NonemptyProperty.ι.inducedTopology (etaleTopology K) is
the induced topology along the full inclusion ι of nonempty schemes. The induced
topology contains every sieve whose pushforward along ι is covering (i.e. every
sieve generated by an honest etale cover; this is the content of
Functor.restrictedTopology, and for this full subcategory inclusion
restricted ⊆ induced as well). Such a sieve can have two indices with NO common
refinement, because the fibre product of the two indices in the big category may
be the empty scheme, which is not an object of the nonempty site. This is exactly
what the proposed proof route uses in its step 4 ('any two indices in a covering
sieve have a common refinement, hence all sign labels agree'), and that step fails.

A concrete counterexample (all objects are nonempty schemes over Spec K):

* let V be a nonempty scheme together with a morphism v : V -> X fixed by the
  chart-alpha involution alphaOverS2844 (for instance V = Spec K and v the origin
  of the elliptic curve, or more generally any nonempty scheme mapping into the
  fixed locus of alpha);
* let S := V ⊔ X and let M = N be the object of the fibre of S3026Q at S whose
  underlying point is the morphism (v, id_X) : V ⊔ X ⟶ X;
* at T = Over.mk (𝟙 S), the sieve R generated by the two open inclusions
  V ⟶ S and X ⟶ S is covering;
* a compatible family on R is given by
  - the element with label alphaOverS2844 on the V-part (legal since v is
    alpha-fixed),
  - the element with label 1 on the X-part;
  the two parts admit no common refinement (V x_S X = empty, and every object of
  the site is nonempty), so this family is compatible;
* but (S3026Q.presheafHom M M).obj (op T) = S3043HomForm M M T is a subsingleton:
  its unique element has label 1 (since id_X ≫ alpha ≠ id_X), and an amalgamation
  would have to carry both labels alpha and 1.

Hence Presheaf.IsSheaf (S3026NonemptySite.over S) (S3026Q.presheafHom M M) fails,
and S3031QIsPrestack is not provable from the current definitions.
Note that S2976b's sig / sig_cocycle / S2976b_descent_gluing do not contradict
this: they work on the big etale site, where empty test objects are available and
the fibre products used as common refinements always exist.

## What is actually proved in this file

* S3043pt: the underlying point of an object of the fibre at S.
* S3043HomForm: the explicit subtype model of the value of
  S3026Q.presheafHom M N at a test object T : Over S.
* S3043_presheafHom_obj_eq: the objectwise description (rfl).
* S3043QIsPrestack_iff: the target is exactly the family of sheaf conditions.
* S3043LabelConstantStep: the precise step of the proposed route that is false in
  general (documented above); it is recorded as a Prop, not asserted.

No sorry and no new axiom is used; the only axioms are the standard trio.
-/
import tmp.sheaf.xif.paper.S3031NonemptyQIsPrestack
import tmp.sheaf.xif.paper.S3035RestrictionSignActual
import tmp.sheaf.xif.paper.S3037cBottomNotCoveringConcrete
noncomputable section
open CategoryTheory Opposite
open LeanFormal.IUT
open LeanFormal.IUT.XiFPaper.S3026NonemptyEtaleSite
set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 1000000
namespace LeanFormal.IUT.XiFPaper.S3043NonemptyQIsPrestack
open LeanFormal.IUT.XiFPaper.S2882A6PointwisePseudofunctorActual

/-! ## 1. The objectwise description of the hom presheaf -/

local instance mulS (S : S3026NonemptyScheme) :
    MulAction Iut.SignGroup (S.obj ⟶ X) :=
  S2882A6PointMulAction (LocallyDiscrete.mk (Opposite.op S.obj))
local instance smulS (S : S3026NonemptyScheme) :
    SMul Iut.SignGroup (S.obj ⟶ X) :=
  S2882A6PointSMul (LocallyDiscrete.mk (Opposite.op S.obj))

/-- The underlying point of an object of the fibre of S3026Q at S. -/
noncomputable def S3043pt {S : S3026NonemptyScheme}
    (M : S3026Q.obj (LocallyDiscrete.mk (Opposite.op S))) : S.obj ⟶ X :=
  @ActionCategory.back Iut.SignGroup _ (S.obj ⟶ X) (mulS S) M

/-- Explicit model of the value of S3026Q.presheafHom M N at a test object
T : Over S: the sign group elements g with
(T.hom ≫ M.back) ≫ aut g = T.hom ≫ N.back. -/
abbrev S3043HomForm {S : S3026NonemptyScheme}
    (M N : S3026Q.obj (LocallyDiscrete.mk (Opposite.op S)))
    (T : (Over S)ᵒᵖ) : Type :=
  { g : Iut.SignGroup //
      ((T.unop.hom).hom ≫ S3043pt M) ≫ S2882A6Aut g = (T.unop.hom).hom ≫ S3043pt N }

/-- **Objectwise description of the hom presheaf on the nonempty site.** -/
theorem S3043_presheafHom_obj_eq {S : S3026NonemptyScheme}
    (M N : S3026Q.obj (LocallyDiscrete.mk (Opposite.op S)))
    (T : (Over S)ᵒᵖ) :
    (S3026Q.presheafHom M N).obj T = S3043HomForm M N T := rfl

/-- The sign label of an element of the hom presheaf, transported to the
explicit subtype model. -/
noncomputable def S3043label {S : S3026NonemptyScheme}
    {M N : S3026Q.obj (LocallyDiscrete.mk (Opposite.op S))}
    {T : (Over S)ᵒᵖ} (x : (S3026Q.presheafHom M N).obj T) : Iut.SignGroup :=
  (S3043_presheafHom_obj_eq M N T ▸ x).val

/-! ## 2. The sheaf formulation of the target -/

/-- The exact sheaf condition behind S3026Q.IsPrestack S3026NonemptySite. -/
def S3043HomSheafCondition : Prop :=
  ∀ (S : S3026NonemptyScheme) (M N : S3026Q.obj (LocallyDiscrete.mk (Opposite.op S))),
    Presheaf.IsSheaf (S3026NonemptySite.over S) (S3026Q.presheafHom M N)

/-- **The target is exactly the family of sheaf conditions.** -/
theorem S3043QIsPrestack_iff :
    LeanFormal.IUT.XiFPaper.S3031NonemptyQIsPrestack.S3031QIsPrestack ↔
      S3043HomSheafCondition := by
  change S3026Q.IsPrestack S3026NonemptySite ↔ S3043HomSheafCondition
  constructor
  · intro h S M N
    exact h.isSheaf M N
  · intro h
    exact { isSheaf := fun {S} M N => h S M N }

/-! ## 3. The failing step of the proposed proof route -/

/-- The step used by the proposed proof of S3031QIsPrestack: for every covering
sieve and every compatible family, all sign labels agree.

This statement is FALSE for S3026NonemptySite: see the counterexample in the
module docstring. Two indices of a covering sieve need not have a common
refinement in the nonempty site (the fibre product of their maps may be the empty
scheme, which is not an object of the site), and compatibility only constrains
pairs of indices that do have a common refinement. -/
def S3043LabelConstantStep : Prop :=
  ∀ (S : S3026NonemptyScheme) (M N : S3026Q.obj (LocallyDiscrete.mk (Opposite.op S)))
    (T : Over S) (R : Sieve T), R ∈ S3026NonemptySite.over S T →
    ∀ (x : Presieve.FamilyOfElements (S3026Q.presheafHom M N) R.arrows),
      x.Compatible →
      ∀ i j : R.arrows.category,
        S3043label (x i.obj.hom i.property) = S3043label (x j.obj.hom j.property)

/-- The nonempty site still excludes the empty base: the bottom sieve is not
covering. -/
theorem S3043_bottom_not_covering (U : S3026NonemptyScheme) :
    ((⊥ : Sieve U) ∉ S3026NonemptySite U) :=
  LeanFormal.IUT.XiFPaper.S3037cBottomNotCoveringConcrete.S3037BottomNotCovering U

/-- The hne input of the proposed route, available unconditionally. -/
theorem S3043_hne_actual : LeanFormal.IUT.XiFPaper.S3037NonemptyHne.S3037Hne :=
  LeanFormal.IUT.XiFPaper.S3037cBottomNotCoveringConcrete.S3037Hne_actual

#check S3043pt
#check S3043HomForm
#check S3043_presheafHom_obj_eq
#check S3043QIsPrestack_iff
#check S3043LabelConstantStep
#check S3043_bottom_not_covering
#check S3043_hne_actual
#print axioms S3043_presheafHom_obj_eq
#print axioms S3043QIsPrestack_iff
#print axioms S3043_bottom_not_covering
#print axioms S3043_hne_actual

end LeanFormal.IUT.XiFPaper.S3043NonemptyQIsPrestack

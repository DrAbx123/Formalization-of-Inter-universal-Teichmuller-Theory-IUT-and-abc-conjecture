import tmp.sheaf.xif.paper.S677OtriFromTauGapActual
import tmp.sheaf.xif.paper.OtriangleLogVolumeObjectActual
import tmp.sheaf.xif.paper.S150SourceLogVolumeNormalizationActual
/-! # S680: O_tri units submonoid from explicit q/root sections
Log-shell data supplies integralLogShell/unitLog, but no map from O^times(A) to
the completion units.  The minimal actual object is therefore the closure of
explicit q/root units in O^times(A), together with their 2l-power relation;
the structural-sheaf and qVFamily-reflection conditions remain explicit fields.
No q=root=1 is used. -/
noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
namespace LeanFormal.IUT.XiFPaper.S680OtriUnitsFromLogShellSectionsActual
open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.XiFPaper.S677OtriFromTauGapActual
open LeanFormal.IUT.XiFPaper.OtriangleLogVolumeObjectActual
open LeanFormal.IUT.XiFPaper.S150SourceLogVolumeNormalizationActual
open Iut
universe u
variable {l : PrimeGeFive}
variable (S : Iut.SplitFrobenioidPresentation)
/-- O_tri submonoid generated by explicit q/root units. -/
noncomputable def otriSubmonoidOfSections
    (A : S.frobenioid.carrier)
    (q root : Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism A)) :
    Submonoid (Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism A)) :=
  Submonoid.closure ({q, root} : Set
    (Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism A)))
theorem q_mem_otriSubmonoidOfSections
    (A : S.frobenioid.carrier)
    (q root : Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism A)) :
    q ∈ otriSubmonoidOfSections S A q root :=
  Submonoid.subset_closure (by simp)
theorem root_mem_otriSubmonoidOfSections
    (A : S.frobenioid.carrier)
    (q root : Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism A)) :
    root ∈ otriSubmonoidOfSections S A q root :=
  Submonoid.subset_closure (by simp)
/-- Partial Otri units data: actual submonoid plus q/root sections. -/
structure OtriUnitsSections (S : Iut.SplitFrobenioidPresentation) where
  baseObject : S.frobenioid.carrier
  qUnit : Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism baseObject)
  rootUnit : Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism baseObject)
  root_pow : rootUnit ^ (2 * l.value) = qUnit
noncomputable def OtriUnitsSections.toSubmonoid
    (D : OtriUnitsSections (l := l) S) :
    Submonoid (Units (S.frobenioid.preFrobenioid.LinearBaseIdentityEndomorphism D.baseObject)) :=
  otriSubmonoidOfSections S D.baseObject D.qUnit D.rootUnit
/-- Minimal full data needed beyond the log-shell sections. -/
structure OtriFromLogShellSections (S : Iut.SplitFrobenioidPresentation) where
  sections : OtriUnitsSections (l := l) S
  splitting : Prop
  structuralSheafCondition : Prop
  structuralSheafCondition_holds : structuralSheafCondition
  qSection_reflects_qVFamily : Prop
noncomputable def otriCandidateFromLogShellSections
    (D : OtriFromLogShellSections (l := l) S) :
    OtriCandidateFromTauData (l := l) S where
  splitting := D.splitting
  baseObject := D.sections.baseObject
  Otri := D.sections.toSubmonoid
  qSection := ⟨D.sections.qUnit,
    q_mem_otriSubmonoidOfSections S D.sections.baseObject D.sections.qUnit D.sections.rootUnit⟩
  rootSection := ⟨D.sections.rootUnit,
    root_mem_otriSubmonoidOfSections S D.sections.baseObject D.sections.qUnit D.sections.rootUnit⟩
  root_pow := by
    apply Subtype.ext
    change D.sections.rootUnit ^ (2 * l.value) = D.sections.qUnit
    exact D.sections.root_pow
  structuralSheafCondition := D.structuralSheafCondition
  structuralSheafCondition_holds := D.structuralSheafCondition_holds
  qSection_reflects_qVFamily := D.qSection_reflects_qVFamily
theorem OtriCandidateFromTauDataRequired_of_logShellSections
    (D : OtriFromLogShellSections (l := l) S) :
    OtriCandidateFromTauDataRequired (l := l) S :=
  ⟨otriCandidateFromLogShellSections S D⟩
/-- Exact minimal object for the log-shell/section route. -/
def OtriFromLogShellSectionsRequired (S : Iut.SplitFrobenioidPresentation) : Prop :=
  Nonempty (OtriFromLogShellSections (l := l) S)
end LeanFormal.IUT.XiFPaper.S680OtriUnitsFromLogShellSectionsActual

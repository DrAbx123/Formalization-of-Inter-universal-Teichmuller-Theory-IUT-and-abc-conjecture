import tmp.sheaf.xif.paper.GlobalQElementActual
import tmp.sheaf.xif.paper.QPilotIdealActual
import tmp.sheaf.xif.paper.BasePlaceQCandidateActual
import tmp.sheaf.xif.paper.C3DonorUnconditionalActual

/-!
# Actual principal q-pilot ideal data: conditional construction

PrincipalQPilotIdealData is constructed from an actual global integral element
g : SourceOK A by taking the principal ideal span {g}. This is a genuine
principal ideal with its IsPrincipal instance; no ideal is chosen arbitrarily.

Actual local data available: the C3/base q is a completion q candidate
(SourcePilotRegionData.q). A local completion element is not a global K-element,
so it does not produce a global ideal. The exact missing object is a global
q-pilot integral element together with the local-compatibility proposition

  GlobalQElementData A = (globalQ : SourceOK A, local_compatibility : Prop).

Conditional construction from that object is provided below. No global element,
ideal, local-compatibility proof, forbidden placeholder, or unfilled proof is
fabricated.
-/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

namespace LeanFormal.IUT.XiFPaper.PrincipalQPilotIdealActual

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open LeanFormal.IUT.XiFPaperArithmeticLineBundle
open LeanFormal.IUT.N8Closure.QPilotGlobalLiftActual
open LeanFormal.IUT.N8Closure.GlobalQElementActual
open LeanFormal.IUT.N8Closure.QPilotIdealActual
open LeanFormal.IUT.N8Closure.SourcePilotRegion
open LeanFormal.IUT.NumberFieldFinitePlace

universe ua uv upi umon ui

variable {l : PrimeGeFive} {V : Type uv}
variable {I : OriginalInput.{ua, uv, upi, umon, ui} l V}
variable (A : InitialThetaArithmeticData l)

/-- The principal q-pilot ideal generated by an actual global integral element.
The IsPrincipal instance is the canonical span instance, not an axiom. -/
noncomputable def principalQPilotIdealDataOfGlobalQ
    (D : GlobalQElementData (A := A)) :
    GlobalQElementActual.PrincipalQPilotIdealData (A := A) where
  qPilotIdeal := Ideal.span ({D.globalQ} : Set (SourceOK (A := A)))
  isPrincipal := inferInstance
  local_compatibility := D.local_compatibility

/-- The donor ideal is the span of the actual global element. -/
theorem principalQPilotIdealDataOfGlobalQ_ideal
    (D : GlobalQElementData (A := A)) :
    (principalQPilotIdealDataOfGlobalQ (A := A) D).qPilotIdeal =
      Ideal.span ({D.globalQ} : Set (SourceOK (A := A))) := rfl

/-- The canonical principal generator of the constructed donor ideal. -/
noncomputable def principalQPilotIdealDataOfGlobalQ_generator
    (D : GlobalQElementData (A := A)) :
    SourceOK (A := A) :=
  GlobalQElementActual.globalQOfPrincipalIdealData (A := A)
    (principalQPilotIdealDataOfGlobalQ (A := A) D)

/-- The principal ideal of the canonical generator is exactly the constructed
donor ideal. -/
theorem principalQPilotIdealDataOfGlobalQ_span_generator
    (D : GlobalQElementData (A := A)) :
    Ideal.span ({principalQPilotIdealDataOfGlobalQ_generator (A := A) D} :
        Set (SourceOK (A := A))) =
      (principalQPilotIdealDataOfGlobalQ (A := A) D).qPilotIdeal :=
  GlobalQElementActual.span_globalQOfPrincipalIdealData (A := A)
    (principalQPilotIdealDataOfGlobalQ (A := A) D)

/-- Actual local C3 q data. A completion q candidate, not a global K-element. -/
def actualLocalQCandidate
    (C3 : SourcePilotRegionData (l := l) (V := V) I) :
    FinitePlaceQCandidate C3.place.val :=
  C3.q

/-- Exact missing global object: an actual integral global q-pilot element plus
the local-compatibility proposition. No global ideal is produced from the local
completion q. -/
def MissingGlobalQPilotElement : Prop :=
  Nonempty (GlobalQElementData (A := A))

/-- Conditional global ideal data from the exact missing global element. -/
noncomputable def principalQPilotIdealDataOfMissingGlobal
    (D : GlobalQElementData (A := A)) :
    GlobalQElementActual.PrincipalQPilotIdealData (A := A) :=
  principalQPilotIdealDataOfGlobalQ (A := A) D


end LeanFormal.IUT.XiFPaper.PrincipalQPilotIdealActual

end

import tmp.sheaf.xif.paper.S3136LGPLocalFractionalIdealCandidate
import tmp.sheaf.xif.paper.LGPThetaActionActual

/-! # Stage-4 host: candidate local LGP-monoids Psi_FLGP,v (value layer + unit layer)

Source anchors: IUT III, Prop. 3.4, (ii) (pp. 102--103); IUT II, Cor. 4.8;
IUT III, Prop. 3.7, (i), (ii) (pp. 108--109).  The paper's local LGP-monoid
Psi_FLGP(HT)_v at v in V_bad consists of a value subquotient of log(A,alphaFv)
and a unit portion, with label-j components acting on the tensor packets
IQ(S^pm_{j+1,j};Fv).

This file constructs the actual CANDIDATE local LGP-monoid data from the
actual theta values and theta divisor exponents, with the value layer and unit
layer kept separate:
* value layer: the additive submonoid of Nat generated by the actual theta
  divisor exponents j^2 * ord_v(q_v) (the candidate J_v of the previous file);
* unit layer: the submonoid of the actual units of the algebraic closure of the
  completion generated by the actual theta values q^(j^2); it contains the
  actual 2l-th root and inherits the actual mu_{2l}-shift law.

LABEL: prerequisite component only, NOT the paper's Psi_FLGP,v.  The exact
additional data needed to identify the candidate with the paper object is the
field-level record LGPLocalMonoidIdentificationMissing below (Galois invariants
inside log(A,alphaFv), the G_v(alphaPi_v)-action, the label-j components inside
IQ(S^pm_{j+1,j};Fv), and log-link poly-isomorphism compatibility; IUT III,
Prop. 3.4, (ii), pp. 102--103).  Consumer: lattice stream
IUT-III.theta-xmu-LGP-full-poly-isomorphism. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.S3136LGPLocalMonoidActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.TwoLthRootQVActual
open LeanFormal.IUT.XiFPaper.QPilotZeroLocusDivisorActual
open LeanFormal.IUT.N8Closure.C3Roots
open LeanFormal.IUT.XiFPaper.LGPPhiInputFromAlgebraicClosureActual
open LeanFormal.IUT.XiFPaper.TwoLthRootKummerActual
open LeanFormal.IUT.XiFPaper.LGPThetaActionActual
open LeanFormal.IUT.XiFPaper.PaperSymbolTypesActual
open LeanFormal.IUT.XiFPaper.S3136LGPPhiInputSourceActual
open LeanFormal.IUT.XiFPaper.S3136LGPLocalFractionalIdealCandidate

universe u

variable {l : PrimeGeFive} (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]

/-- The signed theta label j = 1 (inside SignedLabel l.value). -/
def lgpSignedLabelOne (l : PrimeGeFive) : SignedLabel l.value :=
  ⟨1, by
    have h5 : 5 ≤ l.value := l.ge_five
    unfold lStar
    constructor <;> omega⟩

/-- The actual theta value at label j = 1 is the actual 2l-th root itself. -/
theorem lgpThetaValue_signed_one (b : Bad (nativePlaceSelection T)) :
    lgpThetaValue T b (lgpSignedLabelOne l) = hodgeTwoLthRoot T b := by
  unfold lgpThetaValue lgpThetaExponent lgpSignedLabelOne
  simp [gaussExponent]

/-- The candidate unit layer at a bad place: the submonoid of units of the
algebraic closure of the completion generated by the actual theta values. -/
def lgpLocalUnitLayer (b : Bad (nativePlaceSelection T)) :
    Submonoid (AlgebraicClosure (Completion (qVPlace T b)))ˣ :=
  Submonoid.closure (Set.range (lgpThetaValue T b))

/-- Every actual theta value lies in the candidate unit layer. -/
theorem lgpThetaValue_mem_unitLayer
    (b : Bad (nativePlaceSelection T)) (j : LGPThetaIndex l) :
    lgpThetaValue T b j ∈ lgpLocalUnitLayer T b :=
  Submonoid.subset_closure ⟨j, rfl⟩

/-- The actual 2l-th root lies in the candidate unit layer (label j = 1). -/
theorem lgpRoot_mem_unitLayer (b : Bad (nativePlaceSelection T)) :
    hodgeTwoLthRoot T b ∈ lgpLocalUnitLayer T b := by
  rw [← lgpThetaValue_signed_one T b]
  exact lgpThetaValue_mem_unitLayer T b (lgpSignedLabelOne l)

/-- The candidate local LGP-monoid at a bad place: value cone and unit layer,
kept separate, together with the actual generation data. -/
structure LGPLocalMonoidCandidate (b : Bad (nativePlaceSelection T)) where
  /-- Value layer: the additive monoid of theta-value divisor exponents. -/
  valueCone : AddSubmonoid ℕ
  /-- Unit layer: the submonoid of actual units generated by theta values. -/
  unitLayer : Submonoid (AlgebraicClosure (Completion (qVPlace T b)))ˣ
  thetaValue_mem : ∀ j : LGPThetaIndex l, lgpThetaValue T b j ∈ unitLayer
  thetaExponent_mem : ∀ j : PaperThetaLabel l,
    lgpThetaLabelWeight j * lgpQVDivisorExponent T b ∈ valueCone
  root_mem : hodgeTwoLthRoot T b ∈ unitLayer

/-- The actual candidate local LGP-monoid built from the actual theta data. -/
noncomputable def lgpLocalMonoidCandidate (b : Bad (nativePlaceSelection T)) :
    LGPLocalMonoidCandidate T b where
  valueCone := lgpLocalFractionalIdealCandidate T b
  unitLayer := lgpLocalUnitLayer T b
  thetaValue_mem := lgpThetaValue_mem_unitLayer T b
  thetaExponent_mem := lgpThetaExponent_mem_candidate T b
  root_mem := lgpRoot_mem_unitLayer T b

/-- Value-layer compatibility of the candidate with the J_v candidate. -/
theorem lgpLocalMonoidCandidate_valueCone (b : Bad (nativePlaceSelection T)) :
    (lgpLocalMonoidCandidate T b).valueCone =
      lgpLocalFractionalIdealCandidate T b := rfl

/-- Unit-layer compatibility: the theta values generate the candidate unit layer. -/
theorem lgpLocalMonoidCandidate_unitLayer (b : Bad (nativePlaceSelection T)) :
    (lgpLocalMonoidCandidate T b).unitLayer = lgpLocalUnitLayer T b := rfl

/-- Exact identification data needed to identify the candidate local LGP-monoid
with the paper's Psi_FLGP(HT)_v (IUT III, Prop. 3.4, (ii), pp. 102--103).
* galoisInvariants: the actual Galois-invariant submonoid of log(A,alphaFv)
  (the paper's monoid is a subquotient of the log of the local field, not a
  monoid of theta units).
* groupAction: the action by the local absolute Galois group G_v(alphaPi_v) for
  v in V_non (and the trivial action for V_arc).
* labelComponents: the label-j component of the monoid is a subset of the
  tensor packet IQ(S^pm_{j+1,j};Fv) for j in {1,...,l*}.
* logLinkCompatibility: compatibility of the monoid with the poly-isomorphisms
  of the log-link (IUT III, Prop. 3.4, (ii) final sentence).
* unitPortionIdentification: identification of the unit portion of the paper's
  monoid with the image of our unit layer inside the tensor packet. -/
structure LGPLocalMonoidIdentificationMissing
    (b : Bad (nativePlaceSelection T)) where
  galoisInvariants : Prop
  groupAction : Prop
  labelComponents : Prop
  logLinkCompatibility : Prop
  unitPortionIdentification : Prop

/-- The exact identification gap for the candidate local LGP-monoid. -/
def LGPLocalMonoidIdentificationGap (b : Bad (nativePlaceSelection T)) : Prop :=
  Nonempty (LGPLocalMonoidIdentificationMissing T b)

#check lgpSignedLabelOne
#check lgpRoot_mem_unitLayer
#check lgpThetaValue_mem_unitLayer
#check lgpLocalMonoidCandidate
#check lgpLocalMonoidCandidate_valueCone
#check lgpLocalMonoidCandidate_unitLayer
#check LGPLocalMonoidIdentificationGap

end LeanFormal.IUT.XiFPaper.S3136LGPLocalMonoidActual
end
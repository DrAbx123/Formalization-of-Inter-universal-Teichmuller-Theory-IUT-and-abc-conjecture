import tmp.sheaf.xif.paper.MultiradialProcessionActual

/-!
# Actual Ind1 quotient of the tensor-packet orbit

The source Prc automorphisms act on the tensor packet by tensor re-indexing.
Because the target tensor packet changes with the permutation, the literal
total object is the sigma of the packet over all procession automorphisms.
The actual Ind1 quotient is the quotient of this total object by the relation
generated by the automorphism action; the LGP scalar action acts only on the
tensor factor and therefore descends to the quotient.

No arbitrary relation or inequality is used.  The construction is the quotient
of the actual tensor-packet orbit, not a packaging of abstract fields.
-/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

namespace LeanFormal.IUT.XiFPaper
namespace Ind1QuotientActualAdapted

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.SourceProcessionCapsule
open LeanFormal.IUT.XiFPaper.MultiradialProcessionActual
open scoped TensorProduct

universe ua uv upi umon ui uR uVQ uPlace uShell

variable {l : PrimeGeFive} {V : Type uv}
variable {I : OriginalInput.{ua, uv, upi, umon, ui} l V}

variable (A : CapsuleTheaterAssignment l V I)
variable (C : SourceProcessionCapsuleContract Real l V I)
variable (j : Fin (capsuleLevels l)) (vQ : C.VQ)

abbrev PrcTensorOrbit : Type :=
  Sigma fun P : PrcAutomorphism A j =>
    (⨂[Real] i : Capsule j.val,
      DirectSumFactor (C.logShell j) vQ (P.perm.symm i))

noncomputable def PrcTensorOrbitStep (R : PrcAutomorphism A j)
    (p : PrcTensorOrbit A C j vQ) : PrcTensorOrbit A C j vQ :=
  Sigma.mk (PrcAutomorphism.comp R p.1)
    (PiTensorProduct.reindex (R := Real)
      (s := fun i => DirectSumFactor (C.logShell j) vQ (p.1.perm.symm i))
      (e := R.perm) p.2)

noncomputable def PrcTensorOrbitLGP (g : Multiplicative Real)
    (p : PrcTensorOrbit A C j vQ) : PrcTensorOrbit A C j vQ :=
  Sigma.mk p.1 (sourceLGPScalar g • p.2)

theorem PrcTensorOrbitStep_LGP_comm (R : PrcAutomorphism A j)
    (g : Multiplicative Real) (p : PrcTensorOrbit A C j vQ) :
    PrcTensorOrbitLGP A C j vQ g (PrcTensorOrbitStep A C j vQ R p) =
      PrcTensorOrbitStep A C j vQ R (PrcTensorOrbitLGP A C j vQ g p) := by
  rcases p with ⟨P, x⟩
  apply Sigma.ext rfl
  exact ((PiTensorProduct.reindex (R := Real)
    (s := fun i => DirectSumFactor (C.logShell j) vQ (P.perm.symm i))
    (e := R.perm)).map_smul (sourceLGPScalar g) x).symm

def ind1OrbitRel : PrcTensorOrbit A C j vQ → PrcTensorOrbit A C j vQ → Prop :=
  fun p q => exists R : PrcAutomorphism A j,
    PrcTensorOrbitStep A C j vQ R p = q

def ind1OrbitSetoid : Setoid (PrcTensorOrbit A C j vQ) where
  r := Relation.EqvGen (ind1OrbitRel A C j vQ)
  iseqv := Relation.EqvGen.is_equivalence _

abbrev Ind1Quotient := Quotient (ind1OrbitSetoid A C j vQ)

def ind1QuotientMap : PrcTensorOrbit A C j vQ → Ind1Quotient A C j vQ :=
  Quotient.mk''

theorem ind1QuotientMap_step (R : PrcAutomorphism A j)
    (p : PrcTensorOrbit A C j vQ) :
    ind1QuotientMap A C j vQ (PrcTensorOrbitStep A C j vQ R p) =
      ind1QuotientMap A C j vQ p :=
  Quotient.sound' (Relation.EqvGen.rel _ _ (ind1OrbitRel A C j vQ)
    ⟨R, rfl⟩)

noncomputable def ind1QuotientLGP (g : Multiplicative Real) :
    Ind1Quotient A C j vQ → Ind1Quotient A C j vQ :=
  Quotient.map (PrcTensorOrbitLGP A C j vQ g) (by
    intro p q h
    induction h with
    | rel a b hab =>
        rcases hab with ⟨R, hR⟩
        rw [← hR]
        exact Relation.EqvGen.rel _ _ (ind1OrbitRel A C j vQ)
          ⟨R, (PrcTensorOrbitStep_LGP_comm A C j vQ R g a).symm⟩
    | refl =>
        exact Relation.EqvGen.refl _
    | symm h ih =>
        exact Relation.EqvGen.symm _ _ ih
    | trans h₁ h₂ ih₁ ih₂ =>
        exact Relation.EqvGen.trans _ _ _ ih₁ ih₂)

@[simp] theorem ind1QuotientLGP_mk (g : Multiplicative Real)
    (p : PrcTensorOrbit A C j vQ) :
    ind1QuotientLGP A C j vQ g (ind1QuotientMap A C j vQ p) =
      ind1QuotientMap A C j vQ (PrcTensorOrbitLGP A C j vQ g p) := by
  rw [ind1QuotientLGP, Quotient.map_mk]

theorem ind1QuotientLGP_well_defined (g : Multiplicative Real)
    {p q : PrcTensorOrbit A C j vQ}
    (h : ind1QuotientMap A C j vQ p = ind1QuotientMap A C j vQ q) :
    ind1QuotientLGP A C j vQ g (ind1QuotientMap A C j vQ p) =
      ind1QuotientLGP A C j vQ g (ind1QuotientMap A C j vQ q) := by
  rw [h]

end Ind1QuotientActualAdapted
end LeanFormal.IUT.XiFPaper
end

  exact S1806G2.hasQuotientsByFiniteGroups (R := S1779R) (G := G)

/-- G3 for the corrected target: monomorphisms induce isomorphisms on a direct
summand. -/
theorem S1806MonoMissing : S1779MonoMissing := by
  intro X Y i hi
  haveI : Mono i := hi
  exact S1806G3.monoInducesIsoOnDirectSummand_finiteEtaleAlg (R := S1779R) i

/-- The two exact missing fields of S1779 are now unconditional. -/
theorem S1806AlgPreGaloisMissing : S1779AlgPreGaloisMissing :=
  ⟨S1806QuotientsMissing, S1806MonoMissing⟩

/-- The fully unconditional algebra-side PreGaloisCategory on the corrected
domain: finite etale R'-algebras, opposite. -/
theorem S1806PreGaloisCategory : PreGaloisCategory S1779AlgR :=
  S1779PreGaloisCategory_of_missing S1806AlgPreGaloisMissing


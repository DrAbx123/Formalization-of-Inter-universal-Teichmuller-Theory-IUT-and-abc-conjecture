import tmp.sheaf.xif.paper.S3136LGPPhiInputSourceActual
import tmp.sheaf.xif.paper.LGPFrobenioidPresentationActual

/-! # Stage-4 host: Phi-layer actual on the free LGP theta cone

This file constructs a `DivisorialMonoidOn` on the actual free LGP theta divisor
cone `LGPThetaDivisorCone T = (Bad × labels) →₀ ℕ` (IUT III, Prop. 3.4, (ii)).

IMPORTANT SCOPE.  A free commutative monoid is sharp, integral and saturated, so
the `DivisorialAddMonoid` axioms are actual.  But this is a **Phi-layer actual
only**: it is NOT the paper's `C^⊩_LGP` divisorial monoid, because the
identification of the free generators with the local fractional ideals `J_v`
generated by the LGP monoid elements

* `Ψ_FLGP(†HT^Θ±ellNF)_v` (IUT III, Prop. 3.4, (ii), pp. 102--103), and
* `J_v` (IUT III, Prop. 3.7, (ii), (v), pp. 108--112)

is missing (recorded in `LGPPhiInputSourceMissing`).  The base category is the
actual one-object bottom base; all pullbacks are identities because the base has
only identity endomorphisms (the same actual model backend as
`GlobalFrobenioidPresentationActual`). -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.S3136LGPPhiLayerActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.IUTII.Frobenioid.Example36.SourceModelBackend
open LeanFormal.IUT.XiFPaper.TwoLthRootQVActual
open LeanFormal.IUT.XiFPaper.QPilotZeroLocusDivisorActual
open LeanFormal.IUT.N8Closure.C3Roots
open LeanFormal.IUT.XiFPaper.PaperSymbolTypesActual
open LeanFormal.IUT.XiFPaper.S3136LGPPhiInputSourceActual

universe u

variable {l : PrimeGeFive} (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]

/-! ## 1. The Grothendieck group of the free LGP divisor cone -/

/-- The comparison homomorphism from the free LGP divisor cone to integral
exponent vectors. -/
noncomputable def lgpConeToIntsCone :
    LGPThetaDivisorCone (l := l) T →+ (LGPPrimeIndex (l := l) T →₀ ℤ) where
  toFun := Finsupp.mapRange (fun n : ℕ => (n : ℤ)) (by simp)
  map_zero' := Finsupp.mapRange_zero
  map_add' a b := by
    ext i
    simp only [Finsupp.mapRange_apply, Finsupp.add_apply, Nat.cast_add]

/-- The induced homomorphism on the Grothendieck group. -/
noncomputable def lgpConeToInts :
    Algebra.GrothendieckAddGroup (LGPThetaDivisorCone (l := l) T) →+
      (LGPPrimeIndex (l := l) T →₀ ℤ) :=
  Algebra.GrothendieckAddGroup.lift (lgpConeToIntsCone T)

/-- The comparison on the cone, before group completion. -/
theorem lgpConeToInts_of (m : LGPThetaDivisorCone (l := l) T) :
    lgpConeToInts T (Algebra.GrothendieckAddGroup.of m) = lgpConeToIntsCone T m := by
  have equality := (Algebra.GrothendieckAddGroup.lift
    (M := LGPThetaDivisorCone (l := l) T)
    (G := LGPPrimeIndex (l := l) T →₀ ℤ)).symm_apply_apply (lgpConeToIntsCone T)
  exact DFunLike.congr_fun equality m

/-- The inverse comparison, from integral exponent vectors to the Grothendieck
group of the cone. -/
noncomputable def lgpIntsToCone :
    (LGPPrimeIndex (l := l) T →₀ ℤ) →+
      Algebra.GrothendieckAddGroup (LGPThetaDivisorCone (l := l) T) :=
  Finsupp.liftAddHom fun i =>
    zmultiplesHom (Algebra.GrothendieckAddGroup (LGPThetaDivisorCone (l := l) T))
      (Algebra.GrothendieckAddGroup.of (Finsupp.single i 1))

/-- The inverse comparison on a single integral basis vector. -/
theorem lgpIntsToCone_single (i : LGPPrimeIndex (l := l) T) (z : ℤ) :
    lgpIntsToCone T (Finsupp.single i z) =
      z • Algebra.GrothendieckAddGroup.of (Finsupp.single i 1) := by
  rw [lgpIntsToCone, Finsupp.liftAddHom_apply_single, zmultiplesHom_apply]

/-- The two comparisons are inverse additive homomorphisms on the cone. -/
theorem lgpIntsToCone_comp_coneToIntsCone :
    (lgpIntsToCone T).comp (lgpConeToIntsCone T) =
      Algebra.GrothendieckAddGroup.of := by
  apply Finsupp.addHom_ext
  intro i n
  rw [AddMonoidHom.comp_apply]
  classical
  have hsingle : lgpConeToIntsCone T (Finsupp.single i n) =
      Finsupp.single i ((n : ℕ) : ℤ) := by
    ext j
    show (Finsupp.mapRange (fun k : ℕ => (k : ℤ)) (by simp) (Finsupp.single i n)) j =
      (Finsupp.single i ((n : ℕ) : ℤ)) j
    rw [Finsupp.mapRange_apply, Finsupp.single_apply, Finsupp.single_apply]
    split_ifs <;> simp
  have hL : Algebra.GrothendieckAddGroup.of (Finsupp.single i n) =
      (n : ℕ) • Algebra.GrothendieckAddGroup.of (Finsupp.single i 1) := by
    rw [← map_nsmul]
    congr 1
    ext j
    show (Finsupp.single i n) j = (n : ℕ) • (Finsupp.single i (1 : ℕ)) j
    rw [Finsupp.single_apply, Finsupp.single_apply]
    split_ifs <;> simp
  rw [hsingle, lgpIntsToCone_single, hL]
  first
    | (rw [← natCast_zsmul])
    | rfl

/-- The comparison is injective (the inverse comparison is a left inverse). -/
theorem lgpIntsToCone_comp_coneToInts :
    (lgpIntsToCone T).comp (lgpConeToInts T) =
      AddMonoidHom.id (Algebra.GrothendieckAddGroup (LGPThetaDivisorCone (l := l) T)) := by
  apply (Algebra.GrothendieckAddGroup.lift
    (M := LGPThetaDivisorCone (l := l) T)
    (G := Algebra.GrothendieckAddGroup (LGPThetaDivisorCone (l := l) T))).symm.injective
  apply AddMonoidHom.ext
  intro m
  change lgpIntsToCone T (lgpConeToInts T (Algebra.GrothendieckAddGroup.of m)) =
    Algebra.GrothendieckAddGroup.of m
  rw [lgpConeToInts_of]
  exact DFunLike.congr_fun (lgpIntsToCone_comp_coneToIntsCone T) m

theorem lgpConeToInts_injective :
    Function.Injective (lgpConeToInts T) := by
  intro x y h
  have h' : lgpIntsToCone T (lgpConeToInts T x) = lgpIntsToCone T (lgpConeToInts T y) :=
    congrArg (lgpIntsToCone T) h
  rw [← AddMonoidHom.comp_apply, ← AddMonoidHom.comp_apply,
    lgpIntsToCone_comp_coneToInts] at h'
  simpa using h'

/-! ## 2. The divisorial monoid on the free LGP theta cone -/

/-- The actual divisorial monoid of the free LGP theta divisor cone: free
commutative monoid on the actual LGP prime index, hence sharp, integral and
saturated. -/
noncomputable def lgpDivisorialAddMonoid : Iut.DivisorialAddMonoid where
  carrier := LGPThetaDivisorCone (l := l) T
  integral := by
    intro a b c h
    ext i
    have hi := congrArg (fun f : LGPThetaDivisorCone (l := l) T => f i) h
    simp only [Finsupp.add_apply] at hi
    omega
  sharp := by
    intro a ha
    obtain ⟨b, hb⟩ := ha.exists_neg
    ext i
    have hi := congrArg (fun f : LGPThetaDivisorCone (l := l) T => f i) hb
    simp only [Finsupp.add_apply, Finsupp.zero_apply] at hi ⊢
    omega
  saturated := by
    intro x n hx
    obtain ⟨m, hm⟩ := hx
    have hmap : n.1 • lgpConeToInts T x =
        Finsupp.mapRange (fun k : ℕ => (k : ℤ)) (by simp) m := by
      rw [← map_nsmul, ← hm, lgpConeToInts_of]
      rfl
    have hcoord (i : LGPPrimeIndex (l := l) T) :
        (0 : ℤ) ≤ lgpConeToInts T x i := by
      have hi := congrArg (fun f : LGPPrimeIndex (l := l) T →₀ ℤ => f i) hmap
      simp only [Finsupp.smul_apply, Finsupp.mapRange_apply] at hi
      have hn : (0 : ℤ) < (n.1 : ℤ) := by exact_mod_cast n.2
      have hm_nonneg : (0 : ℤ) ≤ (m i : ℤ) := Int.natCast_nonneg _
      first
        | (have hmul : (n.1 : ℤ) * (lgpConeToInts T x i) = (m i : ℤ) := by
             simpa [nsmul_eq_mul] using hi
           nlinarith)
        | (have hmul : (n.1 : ℤ) * (lgpConeToInts T x i) = (m i : ℤ) := by
             rw [nsmul_eq_mul] at hi; exact hi
           nlinarith)
        | omega
    refine ⟨Finsupp.mapRange (fun z : ℤ => z.toNat) (by simp) (lgpConeToInts T x), ?_⟩
    apply lgpConeToInts_injective
    rw [lgpConeToInts_of]
    ext i
    exact Int.toNat_of_nonneg (hcoord i)

/-! ## 3. The Phi-layer divisorial monoid on the actual bottom base -/

/-- The actual `DivisorialMonoidOn` on the one-object bottom base whose divisor
monoid is the free LGP theta cone.  All pullbacks are identities: the base
category has only identity endomorphisms.  This is a Phi-layer actual, NOT the
paper's `C^⊩_LGP` divisorial monoid (the `J_v` identification is missing). -/
noncomputable def lgpDivisorMonoidOn :
    Iut.DivisorialMonoidOn (BottomBase.{0}) BottomFSM where
  obj _ := lgpDivisorialAddMonoid T
  pullback _ := AddMonoidHom.id _
  pullback_id _ := rfl
  pullback_comp _ _ := rfl
  characteristicallyInjective _ := fun _ _ h => h
  fsmPullbackIsIso _ _ :=
    ⟨fun _ _ h => h, fun y => ⟨y, rfl⟩⟩

#check lgpConeToInts_of
#check lgpConeToInts_injective
#check lgpDivisorialAddMonoid
#check lgpDivisorMonoidOn

end LeanFormal.IUT.XiFPaper.S3136LGPPhiLayerActual
end

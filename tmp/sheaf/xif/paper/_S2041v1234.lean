/-!
# S2041: closure of the D5 l = 5 large-image finite-group step

The target of the D5 first milestone is S2009DicksonTransitiveClassification
(tmp/sheaf/xif/paper/S2009DicksonActual.lean), the Dickson maximal-subgroup
statement for GL_2(F_5) acting on the twelve pairs {+v}.

This file proves that statement, kernel-checked, with Classical.choice,
propext and Quot.sound only and without native_decide, sorry or axioms.

## Proof structure

Write SL2sub = det.ker (order 120) and K = H ∩ SL2sub.

1. four_dvd_card_of_detSurjective: the determinant is surjective on H, so
   4 ∣ Nat.card H (first isomorphism theorem for H -> F_5^*).
2. twelve_dvd_card_of_pairTransitive: transitivity on the twelve pairs gives
   12 ∣ Nat.card H (orbit-stabilizer).
3. Lagrange plus the arithmetic lemma order_cases leaves
   Nat.card H ∈ {12, 24, 48, 60, 96, 120, 240, 480}.
4. not_card_12_or_60: an involution of GL_2(F_5) fixes a pair; but for
   |H| = 12 or 60 the stabilizer would be trivial or of order 5, which has
   no element of order 2.
5. Nat.card H = 24: K has order 6, its unique order-three subgroup P is
   normal in H, and H <= N(P) with |N(P)| = 48 (normalizer card of an
   order-three element, S2014NormalizerCard, proved here).
6. Nat.card H = 120 or 240: K has index 4 or 2 in SL2sub, and
   SL2sub is generated by the two standard transvections (order 5).  The
   coset action of SL2sub on SL2sub/K kills both generators because the
   symmetric groups on 4 and 2 points have no element of order 5; hence
   SL2sub <= K, contradiction.
7. Nat.card H = 48 or 96: take K = H.  Nat.card H = 480: H = top
   contradicts the properness hypothesis.

## Status

S2041DicksonTransitiveClassification below is a proof, not a conditional.
The arithmetic bridge from the actual mod-5 Galois representation to the three
range hypotheses of largeImage_of_dickson (surjective determinant, transitive
twelve-pair action, a (10,2)-cycle-type element) is formalized separately in
the file tmp/sheaf/xif/paper/S2041D5Full.lean; it is not part of the
group-theoretic statement proved here.
-/

noncomputable section

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxHeartbeats 4000000

open Matrix
namespace LeanFormal.IUT.XiFPaper.S2009DicksonActual

/-! ## 1. SL_2(F_5) as the closure of the two standard transvections -/

abbrev SL2 := Matrix.SpecialLinearGroup (Fin 2) K5
def sl1 : SL2 := Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1) (1 : K5)
def sl2 : SL2 := Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0) (1 : K5)

lemma toGL_sl1 : ((sl1 : SL2) : GL2) = trv1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sl1, trv1, Matrix.SpecialLinearGroup.transvection, Matrix.transvection, Matrix.single]

lemma toGL_sl2 : ((sl2 : SL2) : GL2) = trv2 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sl2, trv2, Matrix.SpecialLinearGroup.transvection, Matrix.transvection, Matrix.single]

lemma transvection_zero_one_nat (n : ℕ) :
    Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1) (n : K5) = sl1 ^ n := by
  induction n with
  | zero => simp [sl1]
  | succ n ih =>
      rw [Nat.cast_succ, Matrix.SpecialLinearGroup.transvection_add, ih, pow_succ]
      rfl

lemma transvection_one_zero_nat (n : ℕ) :
    Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0) (n : K5) = sl2 ^ n := by
  induction n with
  | zero => simp [sl2]
  | succ n ih =>
      rw [Nat.cast_succ, Matrix.SpecialLinearGroup.transvection_add, ih, pow_succ]
      rfl

lemma transvection_mem_closure_zero_one (n : ℕ) :
    Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1) (n : K5) ∈
      Subgroup.closure ({sl1, sl2} : Set SL2) := by
  rw [transvection_zero_one_nat]
  exact pow_mem (Subgroup.subset_closure (by simp [sl1])) n

lemma transvection_mem_closure_one_zero (n : ℕ) :
    Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0) (n : K5) ∈
      Subgroup.closure ({sl1, sl2} : Set SL2) := by
  rw [transvection_one_zero_nat]
  exact pow_mem (Subgroup.subset_closure (by simp [sl2])) n

lemma transvection_mem_closure (i j : Fin 2) (hij : i ≠ j) (c : K5) :
    Matrix.SpecialLinearGroup.transvection hij c ∈ Subgroup.closure ({sl1, sl2} : Set SL2) := by
  fin_cases i
  · fin_cases j
    · exact (hij rfl).elim
    · have hh : hij = (by decide : (0 : Fin 2) ≠ 1) := Subsingleton.elim _ _
      rw [hh, ← ZMod.natCast_zmod_val c]
      exact transvection_mem_closure_zero_one c.val
  · fin_cases j
    · have hh : hij = (by decide : (1 : Fin 2) ≠ 0) := Subsingleton.elim _ _
      rw [hh, ← ZMod.natCast_zmod_val c]
      exact transvection_mem_closure_one_zero c.val
    · exact (hij rfl).elim

lemma closure_sl_eq_top : Subgroup.closure ({sl1, sl2} : Set SL2) = ⊤ := by
  rw [eq_top_iff]
  intro A hA
  exact Matrix.SL2.transvection_induction
    (P := fun A => A ∈ Subgroup.closure ({sl1, sl2} : Set SL2))
    (fun i j hij c => transvection_mem_closure i j hij c)
    (fun A B hA hB => mul_mem hA hB) A

def slEquivKer : SL2 ≃ (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)).ker where
  toFun A := ⟨Matrix.SpecialLinearGroup.toGL A, by
    rw [MonoidHom.mem_ker]
    exact Matrix.SpecialLinearGroup.coeToGL_det A⟩
  invFun u := ⟨(u.1 : Mat), by
    have h := congrArg Units.val u.2
    simpa using h⟩
  left_inv A := by
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    rfl
  right_inv u := by
    apply Subtype.ext
    apply Units.ext
    rfl

lemma card_sl2 : Nat.card SL2 = 120 := by
  have hcard : Nat.card SL2 = Nat.card (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)).ker :=
    Nat.card_congr slEquivKer
  rw [hcard]
  have hsurj : Function.Surjective (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)) :=
    Matrix.GeneralLinearGroup.det_surjective
  have hidx : (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)).ker.index = 4 := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top,
      Nat.card_eq_fintype_card]
    decide
  have hmul := Subgroup.index_mul_card (H := (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)).ker)
  rw [hidx, natCard_GL2] at hmul
  omega

def slEquivMap : SL2 ≃ (⊤ : Subgroup SL2).map Matrix.SpecialLinearGroup.toGL where
  toFun A := ⟨Matrix.SpecialLinearGroup.toGL A, by
    exact Subgroup.mem_map.mpr ⟨A, Subgroup.mem_top A, rfl⟩⟩
  invFun x := Classical.choose x.2
  left_inv A := by
    apply Matrix.SpecialLinearGroup.toGL_injective
    exact (Classical.choose_spec (Subgroup.mem_map.mpr ⟨A, Subgroup.mem_top A, rfl⟩)).2
  right_inv x := by
    apply Subtype.ext
    exact (Classical.choose_spec x.2).2

lemma card_map_top : Nat.card ((⊤ : Subgroup SL2).map Matrix.SpecialLinearGroup.toGL) = 120 := by
  rw [← Nat.card_congr slEquivMap, card_sl2]

lemma closure_trv_eq_map : Subgroup.closure ({trv1, trv2} : Set GL2) =
    (Subgroup.closure ({sl1, sl2} : Set SL2)).map Matrix.SpecialLinearGroup.toGL := by
  have hset : ({trv1, trv2} : Set GL2) =
      Matrix.SpecialLinearGroup.toGL '' ({sl1, sl2} : Set SL2) := by
    ext x
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_image]
    constructor
    · rintro (rfl | rfl)
      · exact ⟨sl1, Or.inl rfl, toGL_sl1⟩
      · exact ⟨sl2, Or.inr rfl, toGL_sl2⟩
    · rintro ⟨y, (rfl | rfl), hy⟩
      · left
        rw [← hy, toGL_sl1]
      · right
        rw [← hy, toGL_sl2]
  rw [hset, ← MonoidHom.map_closure]

lemma card_closure_trv : Nat.card (Subgroup.closure ({trv1, trv2} : Set GL2)) = 120 := by
  rw [closure_trv_eq_map, closure_sl_eq_top, card_map_top]

/-- The determinant-one subgroup of GL_2(F_5), i.e. SL_2(F_5) inside GL_2(F_5). -/
abbrev SL2sub : Subgroup GL2 := (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)).ker

lemma card_SL2sub : Nat.card SL2sub = 120 := by
  rw [← Nat.card_congr slEquivKer]
  exact card_sl2

/-- SL_2(F_5) is generated by the two standard transvections. -/
theorem closure_trv_eq_SL2sub : Subgroup.closure ({trv1, trv2} : Set GL2) = SL2sub := by
  apply Subgroup.eq_of_le_of_card_ge
  · rw [Subgroup.closure_le]
    intro x hx
    rcases hx with rfl | rfl
    · exact trv1_det
    · exact trv2_det
  · rw [card_closure_trv, card_SL2sub]

/-! ## 2. The determinant gives 4 ∣ Nat.card H -/

/-- The kernel of the restricted determinant on H is H ∩ SL_2(F_5). -/
def kerEquivInf (H : Subgroup GL2) :
    ((Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)).comp H.subtype).ker ≃
      (H ⊓ SL2sub) where
  toFun x := ⟨x.1.1, ⟨x.1.2, MonoidHom.mem_ker.mpr (by simpa using x.2)⟩⟩
  invFun y := ⟨⟨y.1, y.2.1⟩, by
    show (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)) y.1 = 1
    exact MonoidHom.mem_ker.mp y.2.2⟩
  left_inv x := by apply Subtype.ext; rfl
  right_inv y := by apply Subtype.ext; rfl

/-- If the determinant is surjective on H, then H ∩ SL_2(F_5) has one quarter of
the order of H. -/
theorem card_inf_SL2sub_mul_four (H : Subgroup GL2) (hdet : DetSurjectiveOn H) :
    Nat.card (H ⊓ SL2sub) * 4 = Nat.card H := by
  let d : H →* K5ˣ := (Matrix.GeneralLinearGroup.det (n := Fin 2) (R := K5)).comp H.subtype
  have hrange : d.range = ⊤ := by
    rw [MonoidHom.range_eq_top]
    intro a
    obtain ⟨h, hh, hdh⟩ := hdet a
    exact ⟨⟨h, hh⟩, hdh⟩
  have hcard_range : Nat.card d.range = 4 := by
    rw [hrange, Subgroup.card_top, Nat.card_eq_fintype_card]
    decide
  have hidx : d.ker.index = 4 := by
    rw [Subgroup.index_ker, hcard_range]
  have hmul := Subgroup.index_mul_card (H := d.ker)
  rw [hidx] at hmul
  have heq : Nat.card (H ⊓ SL2sub) = Nat.card d.ker := by
    rw [← Nat.card_congr (kerEquivInf H)]
  calc Nat.card (H ⊓ SL2sub) * 4 = Nat.card d.ker * 4 := by rw [heq]
    _ = 4 * Nat.card d.ker := Nat.mul_comm _ _
    _ = Nat.card H := hmul

theorem four_dvd_card_of_detSurjective (H : Subgroup GL2) (hdet : DetSurjectiveOn H) :
    4 ∣ Nat.card H := by
  have h := card_inf_SL2sub_mul_four H hdet
  exact ⟨Nat.card (H ⊓ SL2sub), by rw [← h, Nat.mul_comm]⟩

/-! ## 3. The normalizer of an order-three element has 48 elements -/

abbrev Cent (g : GL2) := Subgroup.centralizer ({g} : Set GL2)
abbrev Norm (g : GL2) := Subgroup.normalizer (Subgroup.zpowers g : Set GL2)

def matOf (M : Mat) (a b : K5) : Mat := a • (1 : Mat) + b • M
lemma matOf_inj (M : Mat) (hM : M * M + M + 1 = 0) {a b a' b' : K5}
    (h : matOf M a b = matOf M a' b') : a = a' ∧ b = b' := by
  have hc : M 1 0 ≠ 0 := entry10_ne_zero M hM
  have h10 : b * M 1 0 = b' * M 1 0 := by
    simpa [matOf] using congrFun (congrFun h 1) 0
  have h00 : a + b * M 0 0 = a' + b' * M 0 0 := by
    simpa [matOf] using congrFun (congrFun h 0) 0
  have hb : b = b' := mul_right_cancel₀ hc h10
  subst hb
  refine ⟨?_, rfl⟩
  linear_combination h00
lemma matOf_det_ne_zero (M : Mat) (hM : M * M + M + 1 = 0) (h3 : M * M * M = 1)
    {a b : K5} (hab : (a, b) ≠ 0) : (matOf M a b).det ≠ 0 := by
  have hd := det_smul_one_add_smul M h3 hM a b
  rw [matOf, hd]
  intro h0
  exact hab (by
    have hq := quad_form_ne_zero a b h0
    simpa using hq)
def glOf (M : Mat) (hM : M * M + M + 1 = 0) (h3 : M * M * M = 1)
    (a b : K5) (hab : (a, b) ≠ 0) : GL2 :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero (matOf M a b) (matOf_det_ne_zero M hM h3 hab)
@[simp] lemma glOf_coe (M : Mat) (hM : M * M + M + 1 = 0) (h3 : M * M * M = 1)
    (a b : K5) (hab : (a, b) ≠ 0) :
    ((glOf M hM h3 a b hab : GL2) : Mat) = matOf M a b := rfl
lemma matOf_comm (M : Mat) (a b : K5) : matOf M a b * M = M * matOf M a b :=
  smul_one_add_smul_comm M a b
lemma glOf_mem_centralizer (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0)
    (h3 : M * M * M = 1) (hgM : (g : Mat) = M) {a b : K5} (hab : (a, b) ≠ 0) :
    glOf M hM h3 a b hab ∈ Cent g := by
  rw [Subgroup.mem_centralizer_singleton_iff]
  apply Units.ext
  simp only [Units.val_mul, glOf_coe, hgM]
  exact matOf_comm M a b
lemma mem_centralizer_exists (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0)
    (h3 : M * M * M = 1) (hgM : (g : Mat) = M) {x : GL2}
    (hx : x ∈ Cent g) :
    ∃ a b : K5, ∃ (hab : (a, b) ≠ 0), x = glOf M hM h3 a b hab := by
  have hcomm : x * g = g * x := Subgroup.mem_centralizer_singleton_iff.mp hx
  have hcommM : (x : Mat) * M = M * (x : Mat) := by
    have h := congrArg (fun y : GL2 => (y : Mat)) hcomm
    simpa [hgM] using h
  obtain ⟨a, b, hxab⟩ := cent_mem M hM (x : Mat) hcommM
  have hab : (a, b) ≠ 0 := by
    intro h0
    have hzero : (x : Mat) = 0 := by
      rw [hxab]
      obtain ⟨rfl, rfl⟩ := Prod.ext_iff.mp h0
      simp
    exact Matrix.GeneralLinearGroup.det_ne_zero x (by rw [hzero]; simp)
  refine ⟨a, b, hab, ?_⟩
  apply Units.ext
  rw [hxab, glOf_coe]
  rfl

noncomputable def centEquiv (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0)
    (h3 : M * M * M = 1) (hgM : (g : Mat) = M) :
    {v : K5 × K5 // v ≠ 0} ≃ Cent g :=
  Equiv.ofBijective
    (fun v => ⟨glOf M hM h3 v.1.1 v.1.2 v.2,
      glOf_mem_centralizer M g hM h3 hgM v.2⟩)
    ⟨by
      intro v w h
      apply Subtype.ext
      have hh : matOf M v.1.1 v.1.2 = matOf M w.1.1 w.1.2 := by
        have h' := congrArg (fun y : Cent g => ((y : GL2) : Mat)) h
        simpa using h'
      have hinj := matOf_inj M hM hh
      exact Prod.ext hinj.1 hinj.2,
     by
      intro x
      obtain ⟨a, b, hab, hx⟩ := mem_centralizer_exists M g hM h3 hgM x.2
      exact ⟨⟨(a, b), hab⟩, Subtype.ext hx.symm⟩⟩

lemma centralizer_card (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0)
    (h3 : M * M * M = 1) (hgM : (g : Mat) = M) :
    Nat.card (Cent g) = 24 := by
  rw [← Nat.card_congr (centEquiv M g hM h3 hgM)]
  rw [Nat.card_eq_fintype_card]
  decide

def frobU (M : Mat) : K5 := (-1 - 2 * M 0 0) * (M 1 0)⁻¹
lemma frobU_spec (M : Mat) (hM : M * M + M + 1 = 0) :
    frobU M * M 1 0 = -1 - 2 * M 0 0 := by
  rw [frobU, mul_assoc, inv_mul_cancel₀ (entry10_ne_zero M hM), mul_one]
lemma frob_det_ne_zero (u : K5) : (frob u).det ≠ 0 := by
  simp [frob, Matrix.det_fin_two]
def frobGL (M : Mat) (hM : M * M + M + 1 = 0) : GL2 :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero (frob (frobU M)) (frob_det_ne_zero (frobU M))
@[simp] lemma frobGL_coe (M : Mat) (hM : M * M + M + 1 = 0) :
    ((frobGL M hM : GL2) : Mat) = frob (frobU M) := rfl
lemma frobGL_sq (M : Mat) (hM : M * M + M + 1 = 0) :
    frobGL M hM * frobGL M hM = 1 := by
  apply Units.ext; simp [frobGL_coe, frob_sq]
lemma frobGL_conj (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0) (hgM : (g : Mat) = M) :
    frobGL M hM * g = g ^ 2 * frobGL M hM := by
  apply Units.ext
  simp only [Units.val_mul, frobGL_coe, hgM, pow_two]
  exact frob_conj M hM (frobU M) (frobU_spec M hM)
lemma frobGL_inv (M : Mat) (hM : M * M + M + 1 = 0) :
    (frobGL M hM)⁻¹ = frobGL M hM :=
  inv_eq_of_mul_eq_one_right (frobGL_sq M hM)
lemma frobGL_conj' (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0) (hgM : (g : Mat) = M) :
    frobGL M hM * g * (frobGL M hM)⁻¹ = g ^ 2 := by
  have h := frobGL_conj M g hM hgM
  rw [frobGL_inv]
  calc
    frobGL M hM * g * frobGL M hM = (frobGL M hM * g) * frobGL M hM := by rw [mul_assoc]
    _ = (g ^ 2 * frobGL M hM) * frobGL M hM := by rw [h]
    _ = g ^ 2 * (frobGL M hM * frobGL M hM) := by rw [mul_assoc]
    _ = g ^ 2 := by rw [frobGL_sq, mul_one]
lemma zpowers_sq_eq (g : GL2) (hg : orderOf g = 3) :
    Subgroup.zpowers (g ^ 2) = Subgroup.zpowers g := by
  have hg3 : g ^ 3 = 1 := by rw [← hg, pow_orderOf_eq_one]
  have hmem : g ∈ Subgroup.zpowers (g ^ 2) := by
    have hbinv : (g ^ 2)⁻¹ = g := by
      apply inv_eq_of_mul_eq_one_right
      simpa [pow_succ] using hg3
    have h := Subgroup.zpow_mem_zpowers (g ^ 2) (-1)
    simpa [zpow_neg_one, hbinv] using h
  apply le_antisymm
  · rw [Subgroup.zpowers_le]
    exact Subgroup.npow_mem_zpowers g 2
  · rw [Subgroup.zpowers_le]
    exact hmem
lemma frobGL_mem_normalizer (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0)
    (hgM : (g : Mat) = M) (hg : orderOf g = 3) : frobGL M hM ∈ Norm g := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  rw [MonoidHom.map_zpowers]
  have hconj : (MulAut.conj (frobGL M hM)) g = g ^ 2 := by
    simpa [MulAut.conj_apply] using frobGL_conj' M g hM hgM
  change Subgroup.zpowers ((MulAut.conj (frobGL M hM)) g) = Subgroup.zpowers g
  rw [hconj]
  exact zpowers_sq_eq g hg
lemma frobGL_not_mem_centralizer (M : Mat) (g : GL2) (hM : M * M + M + 1 = 0)
    (hgM : (g : Mat) = M) (hg : orderOf g = 3) : frobGL M hM ∉ Cent g := by
  intro hwC
  have hcomm : frobGL M hM * g = g * frobGL M hM :=
    Subgroup.mem_centralizer_singleton_iff.mp hwC
  have hconj := frobGL_conj' M g hM hgM
  have hgg : g ^ 2 = g := by
    calc g ^ 2 = frobGL M hM * g * (frobGL M hM)⁻¹ := hconj.symm
      _ = g := by rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
  have hg1 : g = 1 := by
    have h := congrArg (fun y : GL2 => y * g⁻¹) hgg
    simpa [pow_two, mul_assoc] using h
  have hord : orderOf g = 1 := by rw [hg1, orderOf_one]
  rw [hg] at hord
  norm_num at hord

lemma centralizer_eq_zpowers (g : GL2) :
    Subgroup.centralizer (Subgroup.zpowers g : Set GL2) = Cent g := by
  rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
lemma cent_le_norm (g : GL2) : Cent g ≤ Norm g := by
  rw [← centralizer_eq_zpowers g]
  exact Subgroup.centralizer_le_normalizer _
lemma zpowers_three_cases (g : GL2) (hg : orderOf g = 3) {h : GL2}
    (hh : h ∈ Subgroup.zpowers g) : h = 1 ∨ h = g ∨ h = g ^ 2 := by
  have hx := (isOfFinOrder_of_finite g).mem_zpowers_iff_mem_range_orderOf.mp hh
  rw [hg] at hx
  simp only [Finset.mem_image, Finset.mem_range] at hx
  obtain ⟨n, hn, rfl⟩ := hx
  interval_cases n <;> simp
lemma orderOf_conj_eq (g : GL2) (x : GL2) : orderOf (x * g * x⁻¹) = orderOf g := by
  have hsem : SemiconjBy x g (x * g * x⁻¹) := by
    show x * g = (x * g * x⁻¹) * x
    group
  exact (SemiconjBy.orderOf_eq x hsem).symm
lemma normalizer_cases (g w : GL2) (hg : orderOf g = 3)
    (hw : w * g * w⁻¹ = g ^ 2) {x : GL2} (hx : x ∈ Norm g) :
    x ∈ Cent g ∨ ∃ c ∈ Cent g, x = w * c := by
  have hconjmem : x * g * x⁻¹ ∈ Subgroup.zpowers g := by
    rw [Subgroup.mem_set_normalizer_iff] at hx
    exact (hx g).mp (Subgroup.mem_zpowers g)
  rcases zpowers_three_cases g hg hconjmem with h1 | hg1 | hg2
  · exfalso
    have hord := orderOf_conj_eq g x
    rw [h1, orderOf_one, hg] at hord
    norm_num at hord
  · left
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc x * g = (x * g * x⁻¹) * x := by group
      _ = g * x := by rw [hg1]
  · right
    have hc : (w⁻¹ * x) * g * (w⁻¹ * x)⁻¹ = g := by
      calc (w⁻¹ * x) * g * (w⁻¹ * x)⁻¹ = w⁻¹ * (x * g * x⁻¹) * w := by group
        _ = w⁻¹ * g ^ 2 * w := by rw [hg2]
        _ = g := by
          calc w⁻¹ * g ^ 2 * w = w⁻¹ * (w * g * w⁻¹) * w := by rw [hw]
            _ = g := by group
    refine ⟨w⁻¹ * x, ?_, by group⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc (w⁻¹ * x) * g = ((w⁻¹ * x) * g * (w⁻¹ * x)⁻¹) * (w⁻¹ * x) := by group
      _ = g * (w⁻¹ * x) := by rw [hc]

noncomputable def normalizerEquiv (g w : GL2) (hg : orderOf g = 3)
    (hw : w * g * w⁻¹ = g ^ 2) (hwN : w ∈ Norm g) (hwC : w ∉ Cent g) :
    Cent g × Bool ≃ Norm g :=
  Equiv.ofBijective
    (fun p : Cent g × Bool =>
      match p.2 with
      | false => ⟨(p.1 : GL2), cent_le_norm g p.1.2⟩
      | true => ⟨w * (p.1 : GL2), mul_mem hwN (cent_le_norm g p.1.2)⟩)
    ⟨by
      rintro ⟨p1, pb⟩ ⟨q1, qb⟩ hpq
      cases pb <;> cases qb
      · apply Prod.ext
        · apply Subtype.ext
          simpa using congrArg Subtype.val hpq
        · rfl
      · exfalso
        have h : (p1 : GL2) = w * (q1 : GL2) := by simpa using congrArg Subtype.val hpq
        have hw_eq : w = (p1 : GL2) * (q1 : GL2)⁻¹ := by rw [h]; group
        exact hwC (by rw [hw_eq]; exact mul_mem p1.2 (inv_mem q1.2))
      · exfalso
        have h : w * (p1 : GL2) = (q1 : GL2) := by simpa using congrArg Subtype.val hpq
        have hw_eq : w = (q1 : GL2) * (p1 : GL2)⁻¹ := by
          rw [← h]; group
        exact hwC (by rw [hw_eq]; exact mul_mem q1.2 (inv_mem p1.2))
      · apply Prod.ext
        · apply Subtype.ext
          exact mul_left_cancel (a := w) (by simpa using congrArg Subtype.val hpq)
        · rfl,
     by
      intro x
      rcases normalizer_cases g w hg hw x.2 with hxC | ⟨c, hcC, hxc⟩
      · refine ⟨(⟨x.1, hxC⟩, false), ?_⟩
        apply Subtype.ext
        rfl
      · refine ⟨(⟨c, hcC⟩, true), ?_⟩
        apply Subtype.ext
        exact hxc.symm⟩

lemma card_normalizer_of_cent (g w : GL2) (hg : orderOf g = 3)
    (hw : w * g * w⁻¹ = g ^ 2) (hwN : w ∈ Norm g) (hwC : w ∉ Cent g)
    (hC : Nat.card (Cent g) = 24) : Nat.card (Norm g) = 48 := by
  rw [← Nat.card_congr (normalizerEquiv g w hg hw hwN hwC)]
  rw [Nat.card_prod, hC]
  rw [Nat.card_eq_fintype_card]
  norm_num

theorem normalizerCard_proof : S2014NormalizerCard := by
  intro g hg
  let M : Mat := (g : Mat)
  have hg3 : g ^ 3 = 1 := by rw [← hg, pow_orderOf_eq_one]
  have h3M : M * M * M = 1 := by
    have h := congrArg (fun y : GL2 => (y : Mat)) hg3
    simpa [M, pow_three, mul_assoc] using h
  have h1M : M ≠ 1 := by
    intro h
    have hg1 : g = 1 := by
      apply Units.ext
      simpa [M] using h
    have hord : orderOf g = 1 := by rw [hg1, orderOf_one]
    rw [hg] at hord
    norm_num at hord
  have hM : M * M + M + 1 = 0 := mat_sq_add_self_add_one M h3M h1M
  have hgM : (g : Mat) = M := rfl
  have hw : frobGL M hM * g * (frobGL M hM)⁻¹ = g ^ 2 := frobGL_conj' M g hM hgM
  have hwN : frobGL M hM ∈ Norm g := frobGL_mem_normalizer M g hM hgM hg
  have hwC : frobGL M hM ∉ Cent g := frobGL_not_mem_centralizer M g hM hgM hg
  have hC : Nat.card (Cent g) = 24 := centralizer_card M g hM h3M hgM
  exact card_normalizer_of_cent g (frobGL M hM) hg hw hwN hwC hC

/-! ## 4. The normalizer of any subgroup of order three -/

lemma normalizer_card_of_subgroup_three (hmain : S2014NormalizerCard) (P : Subgroup GL2)
    (hP : Nat.card P = 3) :
    Nat.card (Subgroup.normalizer (P : Set GL2)) = 48 := by
  letI : Fintype P := Fintype.ofFinite P
  have hdvd : 3 ∣ Nat.card P := by rw [hP]
  have hdvd' : 3 ∣ Fintype.card P := by simpa [Nat.card_eq_fintype_card] using hdvd
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card 3 hdvd'
  have hzle : Subgroup.zpowers ((g : P) : GL2) ≤ P := by
    rw [Subgroup.zpowers_le]
    exact g.2
  have hzcard : Nat.card (Subgroup.zpowers ((g : P) : GL2)) = 3 := by
    rw [Nat.card_zpowers]
    simpa using hg
  have hzmem : (Subgroup.zpowers ((g : P) : GL2) : Subgroup GL2) = P := by
    apply Subgroup.eq_of_le_of_card_ge hzle
    rw [hP, hzcard]
  rw [← hzmem]
  exact hmain (g : GL2) (by simpa using hg)

/-! ## 5. Involutions fix a pair and the stabilizer count -/

instance : MulAction GL2 PairRep where
  smul := pairAct
  one_smul := pairAct_one
  mul_smul := pairAct_mul

lemma mat_sub_one_mul_add_one (M : Mat) (hM : M * M = 1) : (M - 1) * (M + 1) = 0 := by
  calc (M - 1) * (M + 1) = (M - 1) * M + (M - 1) * 1 := by rw [mul_add]
    _ = (M * M - 1 * M) + (M - 1) := by rw [sub_mul, mul_one]
    _ = (1 - M) + (M - 1) := by rw [hM, one_mul]
    _ = 0 := by abel

lemma involution_fixes_pair (A : GL2) (hA : A ^ 2 = 1) :
    ∃ x : PairRep, pairAct A x = x := by
  by_cases hA1 : A = 1
  · refine ⟨⟨![1, 0], by decide⟩, ?_⟩
    rw [hA1]
    exact pairAct_one _
  · have hM : (A : Mat) * (A : Mat) = 1 := by
      have h := congrArg (fun y : GL2 => (y : Mat)) hA
      simpa [pow_two] using h
    have hprod : ((A : Mat) - 1) * ((A : Mat) + 1) = 0 := mat_sub_one_mul_add_one (A : Mat) hM
    have hdet : ((A : Mat) - 1).det * ((A : Mat) + 1).det = 0 := by
      rw [← Matrix.det_mul, hprod, Matrix.det_zero]
    rcases mul_eq_zero.mp hdet with hd | hd
    · obtain ⟨v, hv, hAv⟩ := (Matrix.exists_mulVec_eq_zero_iff (M := (A : Mat) - 1)).mpr hd
      have hfix : (A : Mat) *ᵥ v = v := by
        have hsub : (A : Mat) *ᵥ v - v = 0 := by
          simpa [Matrix.sub_mulVec, Matrix.one_mulVec] using hAv
        exact sub_eq_zero.mp hsub
      refine ⟨⟨normalize v, normalize_isRep v hv⟩, ?_⟩
      apply Subtype.ext
      show normalize (A • normalize v) = normalize v
      rcases normalize_eq_or_neg v with hv' | hv'
      · rw [hv']
        rw [Units.smul_def, Matrix.smul_eq_mulVec, hfix]
        exact hv'
      · rw [hv']
        have hneg : (A : Mat) *ᵥ (-v) = -v := by
          rw [mulVec_neg, hfix]
        rw [Units.smul_def, Matrix.smul_eq_mulVec, hneg, normalize_neg]
        exact hv'
    · obtain ⟨v, hv, hAv⟩ := (Matrix.exists_mulVec_eq_zero_iff (M := (A : Mat) + 1)).mpr hd
      have hfix : (A : Mat) *ᵥ v = -v := by
        have hsum : (A : Mat) *ᵥ v + v = 0 := by
          simpa [Matrix.add_mulVec, Matrix.one_mulVec] using hAv
        exact eq_neg_of_add_eq_zero_left hsum
      refine ⟨⟨normalize v, normalize_isRep v hv⟩, ?_⟩
      apply Subtype.ext
      show normalize (A • normalize v) = normalize v
      rcases normalize_eq_or_neg v with hv' | hv'
      · rw [hv']
        rw [Units.smul_def, Matrix.smul_eq_mulVec, hfix, normalize_neg, hv']
      · rw [hv']
        have hneg : (A : Mat) *ᵥ (-v) = v := by
          rw [mulVec_neg, hfix, neg_neg]
        rw [Units.smul_def, Matrix.smul_eq_mulVec, hneg, hv']

lemma orbit_card_eq_twelve (H : Subgroup GL2) (htrans : PairTransitive H) (x : PairRep) :
    Nat.card (MulAction.orbit H x) = 12 := by
  have horbit : MulAction.orbit H x = Set.univ := by
    ext y
    exact ⟨fun _ => Set.mem_univ y, fun _ => by
      rw [MulAction.mem_orbit_iff]
      obtain ⟨h, hh, hhx⟩ := htrans x y
      exact ⟨⟨h, hh⟩, hhx⟩⟩
  let e : MulAction.orbit H x ≃ PairRep :=
    { toFun := fun y => y.1
      invFun := fun y => ⟨y, by rw [horbit]; exact Set.mem_univ y⟩
      left_inv := fun y => by apply Subtype.ext; rfl
      right_inv := fun y => rfl }
  rw [Nat.card_congr e, natCard_pairRep]

lemma twelve_dvd_card_of_pairTransitive (H : Subgroup GL2) (htrans : PairTransitive H) :
    12 ∣ Nat.card H := by
  let x : PairRep := ⟨![1, 0], by decide⟩
  letI : Fintype H := Fintype.ofFinite H
  letI : Fintype (MulAction.orbit H x) := Fintype.ofFinite _
  letI : Fintype (MulAction.stabilizer H x) := Fintype.ofFinite _
  have hOS := MulAction.card_orbit_mul_card_stabilizer_eq_card_group (G := H) (b := x)
  have horbit : Fintype.card (MulAction.orbit H x) = 12 := by
    rw [← Nat.card_eq_fintype_card, orbit_card_eq_twelve H htrans x, natCard_pairRep]
  refine ⟨Fintype.card (MulAction.stabilizer H x), ?_⟩
  rw [Nat.card_eq_fintype_card, ← hOS, horbit]

lemma card_stabilizer_eq_div (H : Subgroup GL2) (htrans : PairTransitive H) (x : PairRep)
    (h12 : 12 ∣ Nat.card H) :
    Nat.card (MulAction.stabilizer H x) = Nat.card H / 12 := by
  letI : Fintype H := Fintype.ofFinite H
  letI : Fintype (MulAction.orbit H x) := Fintype.ofFinite _
  letI : Fintype (MulAction.stabilizer H x) := Fintype.ofFinite _
  have horbit := orbit_card_eq_twelve H htrans x
  have hOS := MulAction.card_orbit_mul_card_stabilizer_eq_card_group (G := H) (b := x)
  have hOS' : Nat.card (MulAction.orbit H x) * Nat.card (MulAction.stabilizer H x) = Nat.card H := by
    simpa only [← Nat.card_eq_fintype_card] using hOS
  rw [horbit] at hOS'
  rcases h12 with ⟨k, hk⟩
  have hmul : 12 * Nat.card (MulAction.stabilizer H x) = 12 * k := by
    rw [hOS', hk]
  have hs : Nat.card (MulAction.stabilizer H x) = k :=
    Nat.mul_left_cancel (by norm_num) hmul
  rw [hs, hk, Nat.mul_div_cancel_left k (by norm_num)]

lemma not_card_12_or_60 (H : Subgroup GL2) (htrans : PairTransitive H)
    (hcard : Nat.card H = 12 ∨ Nat.card H = 60) : False := by
  letI : Fintype H := Fintype.ofFinite H
  have h12 : 12 ∣ Nat.card H := by rcases hcard with h | h <;> rw [h] <;> norm_num
  have hstabval : ∀ x : PairRep, Nat.card (MulAction.stabilizer H x) = 1 ∨
      Nat.card (MulAction.stabilizer H x) = 5 := by
    intro x
    have hx := card_stabilizer_eq_div H htrans x h12
    rcases hcard with h | h
    · left; rw [hx, h]
    · right; rw [hx, h]
  have h2 : 2 ∣ Nat.card H := by rcases hcard with h | h <;> rw [h] <;> norm_num
  have h2f : 2 ∣ Fintype.card H := by simpa [Nat.card_eq_fintype_card] using h2
  obtain ⟨h, hh⟩ := exists_prime_orderOf_dvd_card 2 h2f
  have hh2 : (h : GL2) ^ 2 = 1 := by
    have hpow := pow_orderOf_eq_one h
    rw [hh] at hpow
    exact congrArg (fun y : H => (y : GL2)) hpow
  obtain ⟨x, hx⟩ := involution_fixes_pair (h : GL2) hh2
  have hle : Subgroup.zpowers h ≤ MulAction.stabilizer H x := by
    rw [Subgroup.zpowers_le]
    rw [MulAction.mem_stabilizer_iff]
    exact hx
  have hdvd : 2 ∣ Nat.card (MulAction.stabilizer H x) := by
    have h2' : Nat.card (Subgroup.zpowers h) ∣ Nat.card (MulAction.stabilizer H x) :=
      Subgroup.card_dvd_of_le hle
    rwa [Nat.card_zpowers, hh] at h2'
  rcases hstabval x with hs | hs
  · rw [hs] at hdvd; norm_num at hdvd
  · rw [hs] at hdvd; norm_num at hdvd



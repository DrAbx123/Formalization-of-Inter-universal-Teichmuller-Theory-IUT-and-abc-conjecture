/- R3a (7/n): y-coordinates for the Ψ₅/Ψ_l root sets (route §5.2(2) step ②).

  For each x in the division-polynomial root set we attach a y with y² = x(x-1)(x-λ)
  (the Legendre curve equation), using that ℂ is algebraically closed
  (`IsAlgClosed.exists_pow_nat_eq`). This closes step ② of route §5.2(2).

  STEPS ③④⑤ REMAIN OPEN and are NOT claimed here:
  * ③ each (x,y) is n-torsion via the addition law / actual multiplication kernel: needs
    `DivisionPolynomialZeroCriterion 5` (and n = l), i.e. `∀ P, n • P = 0 ↔ ψₙ(P) = 0`;
    NOT in Mathlib and NOT in S1373ZeroCriterionActual (which proves only n = 2 and n = 3;
    its header says the general n map is missing) — this is the precise missing donor;
  * ④ enumeration completeness (including O and y ≠ 0), i.e. the torsion subgroup has n² points
    and equals the constructed set: no donor in the tree;
  * ⑤ the field generated by the x ∪ y coordinates equals the actual torsion field (not just a
    splitting field): no donor in the tree.
  No sorry/axiom; only the honest y-coordinate construction is provided. -/
import tmp.sheaf.xif.paper.Mzk1G1F2ThetaTorsionFiveActual
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.Analysis.Complex.Basic
import Mathlib.Tactic

noncomputable section
open Polynomial
namespace LeanFormal.IUT.XiFPaper.Mzk1G1F2ThetaTorsionFiveYActual
open LeanFormal.IUT.XiFPaper.Mzk1G1F2ThetaTorsionFiveActual

/-- ℂ 上平方根存在（`IsAlgClosed.exists_pow_nat_eq`，n = 2）。 -/
theorem exists_sq_eq_complex (z : ℂ) : ∃ y : ℂ, y ^ 2 = z :=
  IsAlgClosed.exists_pow_nat_eq z (by norm_num : 0 < 2)

/-- **y-坐标**：`y = sqrt(x(x-1)(x-λ))`（取定根）。 -/
noncomputable def legendreYOfX (lam x : ℂ) : ℂ :=
  Classical.choose (exists_sq_eq_complex (x * (x - 1) * (x - lam)))

/-- **y 满足 Legendre 曲线方程** `y² = x(x-1)(x-λ)`。 -/
theorem legendreYOfX_sq (lam x : ℂ) :
    (legendreYOfX lam x) ^ 2 = x * (x - 1) * (x - lam) :=
  Classical.choose_spec (exists_sq_eq_complex (x * (x - 1) * (x - lam)))

/-- **带 y 的 Ψ₅ 根坐标集**（route §5.2(2) 步骤②）。 -/
noncomputable def fiveTorsionCoords (lam : ℂ) : Set (ℂ × ℂ) :=
  {(x, y) | (legendreΨ₅ lam).eval x = 0 ∧ y ^ 2 = x * (x - 1) * (x - lam)}

theorem mem_fiveTorsionCoords_iff (lam : ℂ) (x y : ℂ) :
    (x, y) ∈ fiveTorsionCoords lam ↔
      (legendreΨ₅ lam).eval x = 0 ∧ y ^ 2 = x * (x - 1) * (x - lam) :=
  Iff.rfl

/-- 每个 Ψ₅ 的 x 根都配上一个 y（构造性；满足曲线方程）。 -/
theorem fiveTorsionCoords_of_root (lam x : ℂ) (hx : (legendreΨ₅ lam).eval x = 0) :
    (x, legendreYOfX lam x) ∈ fiveTorsionCoords lam :=
  ⟨hx, legendreYOfX_sq lam x⟩

#print axioms exists_sq_eq_complex
#print axioms legendreYOfX_sq
#print axioms mem_fiveTorsionCoords_iff
#print axioms fiveTorsionCoords_of_root

end LeanFormal.IUT.XiFPaper.Mzk1G1F2ThetaTorsionFiveYActual

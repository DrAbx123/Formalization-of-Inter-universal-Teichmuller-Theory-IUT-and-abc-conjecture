  ⟨gaussianPolynomial_irreducible⟩
local instance : Field S2844D6F6BaseChangeActual.K := S2847A6.fieldF
local instance : NumberField S2844D6F6BaseChangeActual.K := S2847A6.numberFieldF
local instance : DecidableEq S2844D6F6BaseChangeActual.K := Classical.decEq _

abbrev R0 : Type := S2801E37CoordinateRing S2844D6F6BaseChangeActual.K
abbrev x : R0 := S2801E37X S2844D6F6BaseChangeActual.K
abbrev y : R0 := S2801E37Y S2844D6F6BaseChangeActual.K

/-- Exact algebraic classification target, definitionally the S3030 affine
origin-preserving classification. -/
def S3035OrderTwoAlgebraClassification : Prop :=
  S3030AffineOriginClassification

theorem S3035_iff_S3030 :
    S3035OrderTwoAlgebraClassification ↔
      S3030AffineOriginClassification :=
  Iff.rfl

/-- The actual E37 relation y^2 + y = x^3 - x, in the form used below. -/
theorem S3035_curve_relation : y ^ 2 + y = x ^ 3 - x :=
  S2801E37_relation S2844D6F6BaseChangeActual.K

/-- Actual expansion of the curve relation under a reflection y -> A - y.
This is the polynomial coefficient computation in R0:
(A-y)^2 + (A-y) - x^3 + x = A^2 + A - 2(A+1)y. -/
theorem S3035_reflection_relation (A : R0) :
    (A - y) ^ 2 + (A - y) - x ^ 3 + x =
      A ^ 2 + A - 2 * (A + 1) * y := by
  have h : y ^ 2 = x ^ 3 - x - y := by linarith [S3035_curve_relation]
  rw [h]
  ring

/-- The alpha branch A = -1 makes the reflected relation vanish, actual. -/
theorem S3035_alpha_relation :
    ((-1 : R0) - y) ^ 2 + ((-1 : R0) - y) - x ^ 3 + x = 0 := by
  rw [S3035_reflection_relation]
  ring

/-- Exact normal-form input: every element of R0 can be written A + B*y with
A, B in the K-subalgebra generated by x (the polynomial functions in x), and
every endomorphism fixing x sends y to such an expression. -/
def S3035NormalForm : Prop :=
  ∀ (φ : R0 →+* R0),
    φ x = x →
      ∃ A B : R0,
        A ∈ Algebra.adjoin S2844D6F6BaseChangeActual.K ({x} : Set R0) ∧
        B ∈ Algebra.adjoin S2844D6F6BaseChangeActual.K ({x} : Set R0) ∧
        φ y = A + B * y

/-- Exact coefficient-comparison input: if A is in the x-polynomial subalgebra
and A^2 + A = 2(A+1)y, then A = -1.  Equivalently, 1 and y are linearly
independent over K[x] (rank-two freeness of the E37 coordinate ring over K[x]). -/
def S3035CoefficientComparison : Prop :=
  ∀ A : R0,
    A ∈ Algebra.adjoin S2844D6F6BaseChangeActual.K ({x} : Set R0) →
      A ^ 2 + A - 2 * (A + 1) * y = 0 → A = -1

/-- Conditional classification from normal form and coefficient comparison.
If φ fixes x, satisfies the order-two relation on y via the reflected form, and
the coefficient comparison holds, then φ(y) = -y, i.e. the alpha substitution,
or φ(y)=y for the identity branch.  This is the exact reduction; the missing
inputs are S3035NormalForm and S3035CoefficientComparison. -/
theorem S3035_reflection_classification
    (hnf : S3035NormalForm) (hcc : S3035CoefficientComparison)
    (φ : R0 →+* R0) (hx : φ x = x)
    (h2 : φ (φ y) = y)
    (hreflect : ∃ A : R0,
      A ∈ Algebra.adjoin S2844D6F6BaseChangeActual.K ({x} : Set R0) ∧
      φ y = A - y) :
    φ y = y ∨ φ y = -1 - y := by
  obtain ⟨A, hA, hAy⟩ := hreflect
  rcases hnf φ hx with ⟨A', B', hA', hB', hφy⟩
  have hAeq : A' = A := by
    -- both normal forms have the same coefficient of y equal to -1
    -- this is exactly the uniqueness part of the normal form
    sorry
  left
  -- placeholder: exact branch splitting needs the B coefficient comparison
  sorry

/-!
## Exact statement and first error

S3035OrderTwoAlgebraClassification is exactly S3030AffineOriginClassification
(Iff.rfl).  The polynomial computation has an actual core:

* S3035_curve_relation: y^2 + y = x^3 - x;
* S3035_reflection_relation: under y -> A - y,
    (A-y)^2 + (A-y) - x^3 + x = A^2 + A - 2(A+1)y;
* S3035_alpha_relation: A = -1 makes this vanish, giving alpha.

The exact missing inputs are now isolated:

1. S3035NormalForm: every endomorphism fixing x sends y to A + B*y with
   A,B in K[x] inside R0.  This is the rank-two normal form of
   R0 = K[x,y]/(y^2+y-x^3+x) over K[x].
2. S3035CoefficientComparison: for A in K[x],
   A^2 + A = 2(A+1)y  =>  A = -1; equivalently 1 and y are K[x]-linearly
   independent (rank-two freeness).

Once these two are supplied, the reflection relation gives
A = -1, hence phi(y) = -1 - y (alpha), while the B=1 branch gives the identity.
The remaining S3035_reflection_classification is left with explicit sorries
because the normal-form uniqueness and branch split are exactly the missing
rank-two arguments; no classification is asserted as proved.
-/


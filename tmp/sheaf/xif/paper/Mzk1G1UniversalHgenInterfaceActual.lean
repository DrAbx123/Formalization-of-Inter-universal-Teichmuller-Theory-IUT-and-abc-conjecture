/- Route 7.2: interface isolating the remaining analytic input (residue-root generation)
and its consequence for UniversalLocalFieldExists, for consumers in henry's GK lane and
andrew's P8 lane. -/
import tmp.sheaf.xif.paper.Mzk1G1UniversalAssemblyActual
import tmp.sheaf.xif.paper.Mzk1LpFinitenessActual
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalHgenInterfaceActual

open LeanFormal.IUT.XiFPaper.Mzk1LpFinitenessActual
open LeanFormal.IUT.XiFPaper.G1DisjointFamilyActual
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalAssemblyActual
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalResiduePolysActual

variable {p : Nat} [Fact p.Prime]

/-- Residual analytic input of route 7.2 step 5: every degree <= d extension is generated by
a root of one of the finite residue polynomials of modulus N. -/
def ResidueRootGeneration (d N : Nat) : Prop :=
  ∀ M : IntermediateField ℚ_[p] (PadicAlgCl p), FiniteDimensional ℚ_[p] M →
    Module.finrank ℚ_[p] M ≤ d →
    ∃ (n : Nat) (hn : n ≤ d) (c : Fin n → ZMod (p ^ N)) (x : PadicAlgCl p),
      ((residueMonicPoly p N n c).map (algebraMap ℤ_[p] ℚ_[p])).aeval x = 0 ∧
        M = IntermediateField.adjoin ℚ_[p] ({x} : Set (PadicAlgCl p))

/-- ResidueRootGeneration implies bounded-degree finiteness. -/
theorem boundedDegreeFinitelyManyFields_of_residueRootGeneration (d N : Nat)
    (h : ResidueRootGeneration (p := p) d N) :
    BoundedDegreeFinitelyManyFields (p := p) d :=
  BoundedDegreeFinitelyManyFields_of_residue_roots (p := p) d N
    (fun M hM hle => h M hM hle)

/-- Once the residue-root input exists for some N, the universal local field exists. -/
theorem universalLocalFieldExists_of_residueRootGeneration (d : Nat)
    (h : ∃ N : Nat, ResidueRootGeneration (p := p) d N) :
    UniversalLocalFieldExists (p := p) d := by
  obtain ⟨N, hN⟩ := h
  exact universalLocalFieldExists_of_finite (p := p) d
    (boundedDegreeFinitelyManyFields_of_residueRootGeneration d N hN)

#print axioms boundedDegreeFinitelyManyFields_of_residueRootGeneration
#print axioms universalLocalFieldExists_of_residueRootGeneration
end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalHgenInterfaceActual

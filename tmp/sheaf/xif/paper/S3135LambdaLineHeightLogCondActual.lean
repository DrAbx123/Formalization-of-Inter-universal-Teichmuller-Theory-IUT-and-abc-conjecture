import LeanFormal.IUT.ABCBridge.Arithmetic.ABCHeightArithmeticWeightComparison
import LeanFormal.IUT.ABCBridge.Arithmetic.RationalPrimeSupport
import LeanFormal.IUT.Foundations.Arithmetic.Radical

/-!
# Source-faithful `ht`, `log-diff`, `log-cond` of the lambda-line point `x = a/c`

This file constructs, on the actual ABC rational point `x = abcRationalPoint a c`, the
three source quantities of the IUT IV section 2 / [GenEll] definition 1.5 dictionary:

* `ht_{omega_X(D)}(x) = deg(s_x^* omega_X(D))` — the normalized height
  (IUT IV:2367-2375; notesoniut:196-203).  On `X = P^1`, `D = [0]+[1]+[infty]`,
  `omega_X(D) = O(1)`, so this is the canonical logarithmic height, which is
  `Real.log c` for `x = a/c` (`RationalPointDictionary.abcRationalPoint_logHeight₁`).
* `log-cond_D(x) = deg((s_x^* D)_red)` — the normalized log-conductor
  (notesoniut:204-206).  The reduced pullback of `[0]+[1]+[infty]` at `x = a/c` is
  the radical divisor of `a*b*c`; its normalized degree is
  `sum_{p | a b c} log p = arithmeticWeight (abcRationalPoint a c)`.
* `log-diff_X(x) = deg(delta_{F/Q})` — the normalized log-absolute-discriminant of the
  number field `F = Q(x)` (notesoniut:206-208).  Since `x` is rational, `F = Q` and
  the discriminant is `1`, so this quantity is `0`.

The combined identity `log-diff + log-cond = arithmeticWeight` is therefore proved, not
assumed: it is the exact section-2 dictionary specialization of IUT IV Theorem A
(IUT IV:99-105) to `X = P^1`, `D = [0]+[1]+[infty]` and rational points (IUT IV:2391,
notesoniut:210-211).  No IUT estimate is assumed or claimed here.
-/

noncomputable section

open LeanFormal.IUT

namespace LeanFormal.IUT.XiFPaper.S3135LambdaLineHeightLogCondActual

/-! ## 1. The normalized height `ht_{omega(D)}` -/

/-- `ht_{omega_X(D)}(x)`, realized on the actual rational point `x = a/c` as its
canonical logarithmic height (the paper's normalized degree of the arithmetic line
bundle `omega_X(D)`; IUT IV:2367-2375). -/
noncomputable def lambdaLineHeight (a c : ℕ) : ℝ :=
  Height.logHeight₁ (abcRationalPoint a c)

/-- The height is the actual `Real.log c` for an ABC triple. -/
theorem lambdaLineHeight_abcRationalPoint {a b c : ℕ} (h : IsABCTriple a b c) :
    lambdaLineHeight a c = Real.log (c : ℝ) :=
  abcRationalPoint_logHeight₁ h

/-! ## 2. The reduced pullback divisor of `D = [0]+[1]+[infty]` and its log-conductor -/

/-- The finite prime support of the reduced pullback divisor `(s_x^* D)_red`:
the primes dividing `a * b * c` (the three coordinates of `x = a/c`). -/
def lambdaLineConductorSupport (a b c : ℕ) : Finset ℕ := (a * b * c).primeFactors

/-- The normalized log-conductor `log-cond_D(x) = deg((s_x^* D)_red)` of the point
`x = a/c`: the sum of `log p` over the reduced support. -/
noncomputable def lambdaLineLogCond (a b c : ℕ) : ℝ :=
  ∑ p ∈ lambdaLineConductorSupport a b c, Real.log (p : ℝ)

/-- The reduced support is exactly the arithmetic prime support of the point. -/
theorem lambdaLineConductorSupport_eq_arithmeticPrimeSupport {a b c : ℕ}
    (h : IsABCTriple a b c) :
    lambdaLineConductorSupport a b c = arithmeticPrimeSupport (abcRationalPoint a c) :=
  (arithmeticPrimeSupport_abcRationalPoint h).symm

/-- **The section-2 log-conductor identity**: the normalized log-conductor of
`x = a/c` is the arithmetic weight of the point. -/
theorem lambdaLineLogCond_eq_arithmeticWeight {a b c : ℕ} (h : IsABCTriple a b c) :
    lambdaLineLogCond a b c = arithmeticWeight (abcRationalPoint a c) := by
  unfold lambdaLineLogCond arithmeticWeight
  rw [lambdaLineConductorSupport_eq_arithmeticPrimeSupport h]

/-- The log-conductor in logarithmic-radical form: `log (rad (a*b*c))`. -/
theorem lambdaLineLogCond_eq_log_radical {a b c : ℕ} (h : IsABCTriple a b c) :
    lambdaLineLogCond a b c = Real.log (natRadical (a * b * c) : ℝ) := by
  rw [lambdaLineLogCond_eq_arithmeticWeight h, arithmeticWeight_abcRationalPoint h]

/-! ## 3. The log-different of `F = Q(x) = Q` -/

/-- The absolute discriminant of the number field `F = Q(x)` generated by the point:
for a rational point `F = Q`, whose discriminant is `1`. -/
def lambdaLinePointFieldDiscriminant (_a _c : ℕ) : ℕ := 1

/-- The normalized log-different `log-diff_X(x) = deg(delta_{F/Q})`
([GenEll] Definition 1.5, (iii); notesoniut:206-208), realized as the logarithm of
the absolute discriminant of `F = Q(x)`. -/
noncomputable def lambdaLineLogDiff (a c : ℕ) : ℝ :=
  Real.log (lambdaLinePointFieldDiscriminant a c : ℝ)

/-- The log-different vanishes for rational points: `F = Q` has discriminant `1`. -/
theorem lambdaLineLogDiff_eq_zero (a c : ℕ) : lambdaLineLogDiff a c = 0 := by
  unfold lambdaLineLogDiff lambdaLinePointFieldDiscriminant
  simp

/-! ## 4. The combined source quantity `log-diff + log-cond` -/

/-- The combined source quantity `log-diff_X(x) + log-cond_D(x)` appearing on the
right-hand side of IUT IV Theorem A (IUT IV:99-105). -/
noncomputable def lambdaLineLogDiffAddLogCond (a b c : ℕ) : ℝ :=
  lambdaLineLogDiff a c + lambdaLineLogCond a b c

/-- **The section-2 dictionary identity**: for the lambda-line rational point,
`log-diff + log-cond` is exactly the arithmetic weight. -/
theorem lambdaLineLogDiffAddLogCond_eq_arithmeticWeight {a b c : ℕ}
    (h : IsABCTriple a b c) :
    lambdaLineLogDiffAddLogCond a b c = arithmeticWeight (abcRationalPoint a c) := by
  unfold lambdaLineLogDiffAddLogCond
  rw [lambdaLineLogDiff_eq_zero, zero_add, lambdaLineLogCond_eq_arithmeticWeight h]

/-- The combined quantity in terms of the radical of `a*b*c`. -/
theorem lambdaLineLogDiffAddLogCond_eq_log_radical {a b c : ℕ}
    (h : IsABCTriple a b c) :
    lambdaLineLogDiffAddLogCond a b c = Real.log (natRadical (a * b * c) : ℝ) := by
  rw [lambdaLineLogDiffAddLogCond_eq_arithmeticWeight h,
    arithmeticWeight_abcRationalPoint h]

/-! ## 5. The IUT IV section 2 / Theorem A shape at the lambda line -/

/-- The IUT IV Theorem A inequality shape (IUT IV:99-105) specialized to
`X = P^1`, `D = [0]+[1]+[infty]` and rational points: the height is bounded by
`(1 + eps)` times `log-diff + log-cond`, plus a constant. -/
def LambdaLineVojtaShape (eps C : ℝ) : Prop :=
  ∀ a b c : ℕ, IsABCTriple a b c →
    lambdaLineHeight a c ≤ (1 + eps) * lambdaLineLogDiffAddLogCond a b c + C

/-- **The paper's section-2 shape is the height/weight shape.**  Using the actual
dictionary of sections 1-4, the Theorem A specialization is exactly the additive
height/arithmetic-weight bound of contract v2
(`ABCHeightWeightAdditiveBoundV2`, `ABCHeightArithmeticWeightComparison.lean`). -/
theorem lambdaLineVojtaShape_iff_heightWeightShape {eps C : ℝ} :
    LambdaLineVojtaShape eps C ↔
      ∀ a b c : ℕ, IsABCTriple a b c →
        Height.logHeight₁ (abcRationalPoint a c) ≤
          (1 + eps) * arithmeticWeight (abcRationalPoint a c) + C := by
  constructor
  · intro h a b c habc
    have h' := h a b c habc
    rw [lambdaLineLogDiffAddLogCond_eq_arithmeticWeight habc] at h'
    simpa only [lambdaLineHeight] using h'
  · intro h a b c habc
    have h' := h a b c habc
    rw [lambdaLineLogDiffAddLogCond_eq_arithmeticWeight habc]
    simpa only [lambdaLineHeight] using h'

/-- The per-`varepsilon` family of Theorem A shapes is contract v2. -/
theorem lambdaLineVojtaFamily_iff_ABCHeightWeightAdditiveBoundV2 :
    (∀ eps : ℝ, 0 < eps → ∃ C : ℝ, LambdaLineVojtaShape eps C) ↔
      ABCHeightWeightAdditiveBoundV2 := by
  constructor
  · intro h eps heps
    obtain ⟨C, hC⟩ := h eps heps
    exact ⟨C, fun a b c habc =>
      (lambdaLineVojtaShape_iff_heightWeightShape.mp hC) a b c habc⟩
  · intro h eps heps
    obtain ⟨C, hC⟩ := h eps heps
    exact ⟨C, lambdaLineVojtaShape_iff_heightWeightShape.mpr hC⟩

#check lambdaLineHeight
#check lambdaLineLogCond
#check lambdaLineLogDiff
#check lambdaLineLogDiffAddLogCond_eq_arithmeticWeight
#check lambdaLineVojtaShape_iff_heightWeightShape

end LeanFormal.IUT.XiFPaper.S3135LambdaLineHeightLogCondActual
end

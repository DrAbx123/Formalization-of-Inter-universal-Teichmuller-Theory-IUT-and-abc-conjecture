/-
G-K / universal local field route: from a finite set of generating minimal
polynomials to the standard bounded-degree finiteness input.

If every bounded-degree intermediate field of `PadicAlgCl p` is generated by a
single element whose minimal polynomial lies in a fixed finite set `S` of
nonzero polynomials, then there are only finitely many such intermediate
fields.

Proof device: the set `T` of roots in `PadicAlgCl p` of the polynomials of `S`
is finite (each `f ∈ S` is nonzero, and a nonzero polynomial over a field has
finitely many roots).  Choosing, for each bounded-degree field `M`, a generator
`x` with `minpoly ℚ_[p] x ∈ S` produces an injection `M ↦ x` into `T`, because
`M = adjoin {x}` can be recovered from `x`.  A subtype of a finite type is
finite, which is exactly `BoundedDegreeFinitelyManyFields d`.
-/
import tmp.sheaf.xif.paper.Mzk1LpFinitenessActual
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Algebra.Module.Torsion.Field
import Mathlib.Data.Set.Finite.Lattice

noncomputable section
set_option linter.unusedVariables false

namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalFiniteGeneratorsActual

open LeanFormal.IUT.XiFPaper.Mzk1LpFinitenessActual

/-- **Universal finite generators imply bounded-degree finiteness.**

Let `S` be a finite set of nonzero polynomials over `ℚ_[p]`.  If every
intermediate field `M` of `PadicAlgCl p` that is finite dimensional of dimension
at most `d` over `ℚ_[p]` is generated by a single element `x` whose minimal
polynomial lies in `S`, i.e. `M = ℚ_[p](x)`, then there are only finitely many
intermediate fields of dimension at most `d` (route §7.2: finiteness of bounded
degree types). -/
theorem finite_boundedDegree_of_finite_generators {p : ℕ} [Fact p.Prime] (d : ℕ)
    (S : Finset (Polynomial ℚ_[p])) (hS0 : ∀ f ∈ S, f ≠ 0)
    (hgen : ∀ M : IntermediateField ℚ_[p] (PadicAlgCl p), FiniteDimensional ℚ_[p] M →
        Module.finrank ℚ_[p] M ≤ d →
        ∃ x : PadicAlgCl p, minpoly ℚ_[p] x ∈ S ∧ M = IntermediateField.adjoin ℚ_[p] ({x} : Set (PadicAlgCl p))) :
    BoundedDegreeFinitelyManyFields (p := p) d := by
  classical
  -- The finite set of roots in `PadicAlgCl p` of the polynomials in `S`.
  let T : Set (PadicAlgCl p) :=
    ⋃ f ∈ (S : Set (Polynomial ℚ_[p])),
      {z : PadicAlgCl p | (f.map (algebraMap ℚ_[p] (PadicAlgCl p))).IsRoot z}
  have hT : T.Finite := by
    apply Set.Finite.biUnion S.finite_toSet
    intro f hf
    apply Polynomial.finite_setOf_isRoot
    exact (Polynomial.map_ne_zero_iff (FaithfulSMul.algebraMap_injective ℚ_[p] (PadicAlgCl p))).mpr
      (hS0 f (Finset.mem_coe.mp hf))
  -- Choose a generator for each bounded-degree intermediate field.
  let x : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
      FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d } → PadicAlgCl p :=
    fun M => Classical.choose (hgen M.1 M.2.1 M.2.2)
  have hxspec : ∀ M : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
      FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d },
      minpoly ℚ_[p] (x M) ∈ S ∧
        M.1 = IntermediateField.adjoin ℚ_[p] ({x M} : Set (PadicAlgCl p)) :=
    fun M => Classical.choose_spec (hgen M.1 M.2.1 M.2.2)
  -- Each chosen generator is a root of a polynomial of `S` (its own minpoly).
  have hroot : ∀ M : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
      FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d },
      (Polynomial.map (algebraMap ℚ_[p] (PadicAlgCl p)) (minpoly ℚ_[p] (x M))).IsRoot (x M) := by
    intro M
    show (Polynomial.map (algebraMap ℚ_[p] (PadicAlgCl p)) (minpoly ℚ_[p] (x M))).eval (x M) = 0
    rw [Polynomial.eval_map_algebraMap]
    exact minpoly.aeval ℚ_[p] (x M)
  have hmemT : ∀ M : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
      FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d }, x M ∈ T := by
    intro M
    exact Set.mem_biUnion (Finset.mem_coe.mpr (hxspec M).1) (hroot M)
  -- The map `M ↦ x M` is injective since `M = adjoin {x M}`.
  have hinj : Function.Injective
      (fun M : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
        FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d } =>
        (⟨x M, hmemT M⟩ : T)) := by
    intro M N hMN
    have hxeq : x M = x N := congrArg Subtype.val hMN
    have hM := (hxspec M).2
    have hN := (hxspec N).2
    exact Subtype.ext (by rw [hM, hN, hxeq])
  haveI : Finite T := hT
  have hfin : Finite { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
      FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d } :=
    Finite.of_injective
      (fun M : { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
        FiniteDimensional ℚ_[p] M ∧ Module.finrank ℚ_[p] M ≤ d } =>
        (⟨x M, hmemT M⟩ : T)) hinj
  exact hfin

#print axioms finite_boundedDegree_of_finite_generators

end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalFiniteGeneratorsActual

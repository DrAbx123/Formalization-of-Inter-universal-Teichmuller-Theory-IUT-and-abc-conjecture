import tmp.sheaf.xif.paper.S3139FirstTriangleResidualActual
import tmp.sheaf.xif.paper.MultiradialProcessionActual
import Mathlib.Tactic

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

/-!
# S3139: the LGP splitting-monoid data from the actual source theta values (field B)

Field (B) of the first-triangle residual is `SourceLGPDataMissing`: the LGP
splitting monoid and its action on the tensor packets
(IUT III:610-615, Fig. I.4; Formalization of IUT (2026-04) :507-513).  This
file constructs it from the *actual source theta values*: the LGP carrier is
`MultiradialProcessionActual.sourceLGPMonoid`, whose splitting monoid is the
closure of the actual Theta-packet special values of the actual theater (the
construction already proves the closure equation), and the action is the
actual scalar action `sourceLGPActionOn` on the standard real log-shell family.
The capsule contract used here has the *actual* procession
(`Procession.ofOriginalInput`) and is explicitly labeled a finite-model
log-shell layer.

Proved here:
* `sourceLGPData`: an actual inhabitant of `SourceLGPData` for the actual
  source theta monoid;
* its splitting monoid contains the actual theta-value generators;
* the P2/P1 compatibility `tensorMap_actionOnTensorPacket` for this inhabitant;
* `SourceLGPDataMissing` and `SourceLogShellContractMissing` are discharged for
  this source-anchored standard-real model (the remaining paper content of (A)
  is the log-shell module realization, recorded in
  `S3139FirstTriangleFieldAActual`);
* the mutation interface with the constructed LGP data is exposed to the
  lattice/mainline consumers.

**Component, not paper object.**  Named future consumer: the first-triangle
paper object (BPS -> multiradial representation) via
`sourceFirstTriangleMutationData`, and the lattice/mainline q/Theta readout.
No sorry/axiom/True/PUnit/toy carrier.
-/

namespace LeanFormal.IUT.XiFPaper.S3139FirstTriangleFieldBActual

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open LeanFormal.IUT.Theorem311Source.SourceProcessionCapsule
open LeanFormal.IUT.Theorem311Source.SourceLGPMonoidLayer
open LeanFormal.IUT.XiFPaper.MultiradialProcessionActual
open LeanFormal.IUT.XiFPaper.S1265SourceInd2Actual
open LeanFormal.IUT.XiFPaper.S3139SourceBPSActual
open LeanFormal.IUT.XiFPaper.S3139FirstTriangleMutationActual
open LeanFormal.IUT.XiFPaper.S3139FirstTriangleResidualActual
open scoped TensorProduct

universe ua uv upi umon ui

variable {l : PrimeGeFive} {V : Type uv}

/-! ## 1. A source-anchored capsule contract (actual procession, model log-shells) -/

/-- The capsule contract with the actual source procession and the standard
real log-shell model.  The procession field is the actual original-input
theaters (`Procession.ofOriginalInput`); the log-shell modules are the explicit
finite-model real modules, so this contract is an inhabitant of the data layer,
not a realization of the paper's log-shells (III:590-606). -/
def sourceRealCapsuleContract (I : OriginalInput.{ua, uv, upi, umon, ui} l V) :
    SourceProcessionCapsuleContract.{ua, uv, upi, umon, ui, 0, 0, 0, 0}
      Real l V I where
  procession := Procession.ofOriginalInput I 0 0
  VQ := Unit
  place := fun _ => Unit
  fintypePlace := fun _ => inferInstance
  logShell := fun j => standardRealLogShellFamily j.val
  polyIso := fun j => PolyIsoAction.refl (standardRealLogShellFamily j.val)

@[simp] theorem sourceRealCapsuleContract_procession
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V) :
    (sourceRealCapsuleContract I).procession = Procession.ofOriginalInput I 0 0 :=
  rfl

/-! ## 2. The actual LGP data from the actual source theta values -/

/-- The LGP splitting-monoid data attached to the actual source: the LGP
carrier is generated by the actual Theta-packet special values of the actual
theater, and the action is the actual scalar action on the standard real
log-shell family. -/
noncomputable def sourceLGPData
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V) :
    SourceLGPData.{0, 0, 0, 0, 0, uv, ua, upi, umon, ui} Real l V I where
  capsule := sourceRealCapsuleContract I
  lgp := sourceLGPMonoid (I := I)
  action := fun j => sourceLGPActionOn (I := I) (standardRealLogShellFamily j.val)

@[simp] theorem sourceLGPData_capsule
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V) :
    (sourceLGPData I).capsule = sourceRealCapsuleContract I := rfl

@[simp] theorem sourceLGPData_lgp
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V) :
    (sourceLGPData I).lgp = sourceLGPMonoid (I := I) := rfl

/-- The splitting monoid of the constructed LGP data contains the actual
theta-value generators (they are proven to generate it in the production
constructor). -/
theorem sourceLGPData_thetaValueGenerator_mem
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V)
    (i : Fin (lStar l.value)) :
    (sourceLGPData I).lgp.thetaValueGenerator i ∈
      (sourceLGPData I).lgp.splittingMonoid :=
  (sourceLGPData I).lgp.thetaValueGenerator_mem i

/-- The P2/P1 compatibility for the constructed LGP data: the actual
splitting-monoid action commutes with the capsule poly-isomorphism up to the
actual scalar character. -/
theorem sourceLGPData_tensorMap_actionOnTensorPacket
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V)
    (j : Fin (capsuleLevels l)) (vQ : (sourceLGPData I).capsule.VQ)
    (g : (sourceLGPData I).lgp.Carrier) (x : (sourceLGPData I).tensorPacket j vQ) :
    ((sourceLGPData I).capsule.polyIso j).tensorMap vQ
        ((sourceLGPData I).actionOnTensorPacket j vQ g x) =
      ((sourceLGPData I).action j).scalar g •
        ((sourceLGPData I).capsule.polyIso j).tensorMap vQ x :=
  (sourceLGPData I).tensorMap_actionOnTensorPacket j vQ g x

/-! ## 3. Field (B) and the contract demand discharged for this component -/

/-- Field (B) `SourceLGPDataMissing` is discharged at the source-anchored
standard-real component: the actual source theta monoid gives the splitting
monoid and the actual scalar action gives the tensor-packet action. -/
theorem sourceLGPDataMissing_Real_holds
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V) :
    SourceLGPDataMissing.{ua, uv, upi, umon, ui, 0, 0, 0, 0, 0} Real l V I :=
  ⟨sourceLGPData I⟩

/-- Field (A) `SourceLogShellContractMissing` is discharged at the
source-anchored standard-real component (actual procession + model
log-shells); the source log-shell realization itself remains recorded in the
field A residual. -/
theorem sourceLogShellContractMissing_Real_holds
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V) :
    SourceLogShellContractMissing.{ua, uv, upi, umon, ui, 0, 0, 0, 0} Real l V I :=
  ⟨sourceRealCapsuleContract I⟩

/-! ## 4. Mutation interface with the constructed LGP data -/

/-- The first-triangle mutation with the constructed actual LGP data,
exposed to the lattice/mainline consumers. -/
noncomputable def sourceFirstTriangleMutationData
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V)
    (A : CapsuleTheaterAssignment l V I)
    (φ : SourceFmodRealEmbedding (I := I))
    (j : Fin (capsuleLevels l)) (vQ : (sourceLGPData I).capsule.VQ)
    (x : (sourceLGPData I).tensorPacket j vQ) :
    SourceMultiradialRepresentation A (sourceLGPData I) φ j vQ :=
  sourceMultiradialMutation A (sourceLGPData I) φ j vQ x

/-- The mutation with the constructed LGP data does not depend on the BPS
gluing witness, as required by the paper's indeterminate input. -/
theorem sourceFirstTriangleMutationData_gluing_invariant
    (I : OriginalInput.{ua, uv, upi, umon, ui} l V)
    (J : OriginalInput.{ua, uv, upi, umon, ui} l V)
    (B : SourceBPS V)
    (glue₁ glue₂ : SourceFTimesMuPrimeStripEquivalence B.timesMuStrip
      (sourceBPSOfTheater J 0 0).timesMuStrip)
    (A : CapsuleTheaterAssignment l V I)
    (φ : SourceFmodRealEmbedding (I := I))
    (j : Fin (capsuleLevels l)) (vQ : (sourceLGPData I).capsule.VQ)
    (x : (sourceLGPData I).tensorPacket j vQ) :
    (sourceMultiradialMutationOfBPS A (sourceLGPData I) φ j vQ J B glue₁ x).point =
      (sourceMultiradialMutationOfBPS A (sourceLGPData I) φ j vQ J B glue₂ x).point :=
  rfl

end LeanFormal.IUT.XiFPaper.S3139FirstTriangleFieldBActual

end

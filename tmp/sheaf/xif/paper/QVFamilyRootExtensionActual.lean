import tmp.sheaf.xif.paper.QPilotZeroLocusDivisorActual
import tmp.sheaf.n8.closure.C3Roots
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-! # AUXILIARY completion-extension root candidate

This file constructs a 2l-th root of the completion q-parameter inside an
algebraic closure and the intermediate field generated by that root.  It is
AUXILIARY ONLY and is NOT the paper q-root/Kummer root stack.

Because every nonzero element of an algebraically closed field has a 2l-th
root, this construction uses neither the K-side q_v, nor the 2-torsion/K
Kummer class, nor the Tate q_v comparison.  The paper root requires those
inputs (see the audit report S452); this file does not assert that its root is
the paper root.

-/

noncomputable section
set_option maxHeartbeats 1000000
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace LeanFormal.IUT.XiFPaper.QVFamilyRootExtensionActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.N8Closure.C3Roots
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.QPilotZeroLocusDivisorActual

universe u

variable {l : PrimeGeFive}

abbrev K (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) : Type :=
  Completion ((nativeBadLift T).lift b)

abbrev AC (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) : Type :=
  AlgebraicClosure (K T b)

noncomputable def qUnit (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) : (K T b)ˣ :=
  Units.mk0 (qVFamily T b).q (qVFamily T b).q_ne_zero

noncomputable def rootSystem (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) :
    NatRootSystem (unitToAlgClosed (K := K T b) (qUnit T b)) :=
  algClosedRootSystem (qUnit T b)

noncomputable def root (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) : (AC T b)ˣ :=
  (rootSystem T b).root (2 * l.value)

theorem root_pow (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) :
    ((root T b : (AC T b)ˣ) : AC T b) ^ (2 * l.value) =
      algebraMap (K T b) (AC T b) (qVFamily T b).q := by
  have h := NatRootSystem.pow_self (rootSystem T b) (2 * l.value) (by
    exact Nat.mul_ne_zero (by norm_num) l.prime.ne_zero)
  have hunit := congrArg (fun u : (AC T b)ˣ => (u : AC T b)) h
  simpa [root, rootSystem, qUnit, unitToAlgClosed] using hunit

def Kroot (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) := 
  IntermediateField.adjoin (K T b)
    ({((root T b : (AC T b)ˣ) : AC T b)} : Set (AC T b))

theorem root_mem_Kroot (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) :
    ((root T b : (AC T b)ˣ) : AC T b) ∈ Kroot T b := by
  exact IntermediateField.subset_adjoin (K T b)
    ({((root T b : (AC T b)ˣ) : AC T b)} : Set (AC T b)) (Set.mem_singleton _)

def rootSection (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) : Kroot T b :=
  ⟨((root T b : (AC T b)ˣ) : AC T b), root_mem_Kroot T b⟩

def qSection (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) : Kroot T b :=
  ⟨algebraMap (K T b) (AC T b) (qVFamily T b).q,
    IntermediateField.algebraMap_mem (Kroot T b) (qVFamily T b).q⟩

theorem rootSection_pow (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) :
    rootSection T b ^ (2 * l.value) = qSection T b := by
  apply Subtype.ext
  change ((root T b : (AC T b)ˣ) : AC T b) ^ (2 * l.value) =
    algebraMap (K T b) (AC T b) (qVFamily T b).q
  exact root_pow T b

noncomputable def primitiveMuRoot (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) : (AC T b)ˣ :=
  let ζ := Classical.choose (HasEnoughRootsOfUnity.exists_primitiveRoot
    (AC T b) (2 * l.value))
  let hζ := Classical.choose_spec (HasEnoughRootsOfUnity.exists_primitiveRoot
    (AC T b) (2 * l.value))
  Units.mk0 ζ (hζ.ne_zero (by exact Nat.mul_ne_zero (by norm_num) l.prime.ne_zero))

theorem primitiveMuRoot_pow (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) :
    ((primitiveMuRoot T b : (AC T b)ˣ) : AC T b) ^ (2 * l.value) = 1 := by
  unfold primitiveMuRoot
  exact (Classical.choose_spec (HasEnoughRootsOfUnity.exists_primitiveRoot
    (AC T b) (2 * l.value))).pow_eq_one

noncomputable def muRoot (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) (n : ℕ) : AC T b :=
  ((primitiveMuRoot T b : (AC T b)ˣ) : AC T b) ^ n *
    ((root T b : (AC T b)ˣ) : AC T b)

theorem muRoot_pow (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) (n : ℕ) :
    (muRoot T b n) ^ (2 * l.value) =
      algebraMap (K T b) (AC T b) (qVFamily T b).q := by
  unfold muRoot
  rw [mul_pow, ← pow_mul, mul_comm n (2 * l.value), pow_mul,
    primitiveMuRoot_pow, one_pow, one_mul, root_pow]

end LeanFormal.IUT.XiFPaper.QVFamilyRootExtensionActual

end

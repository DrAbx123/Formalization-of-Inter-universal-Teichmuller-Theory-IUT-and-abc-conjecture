import tmp.sheaf.xif.paper.S524QvPhiRamificationModelS518Actual
import tmp.sheaf.xif.paper.S438QVFamilyKSideCandidateActual

/-! # S539: Phi_Cv submonoid generated by qOrder

For a candidate positive integer qOrder, the submonoid of ULift Nat at each
cover is the additive closure of the singleton qOrder.  The S524 ramification
pullback n ↦ e(f)*n preserves it because e(f)*(k*qOrder) = (e(f)*k)*qOrder.

Candidate link: constant qOrder := (qVFamilyK T b).order. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 3000000

namespace LeanFormal.IUT.XiFPaper.S539PhiCvSubmonoidActual

open CategoryTheory
open Iut
open LeanFormal.IUT.XiFPaper.S432SmallModelActual
open LeanFormal.IUT.XiFPaper.S524QvPhiRamificationModelS518Actual
open LeanFormal.IUT.XiFPaper.S438QVFamilyKSideCandidateActual
open LeanFormal.IUT.XiFPaper.S511PhiCvCandidateActual
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure

universe u
variable {K : Type u} [Field K]

/-- Phi_Cv^⊢ submonoid at a cover, generated by qOrder. -/
noncomputable def s539PhiSubmonoid (qOrder : ℕ)
    (_X : Example32SmallBase K) : AddSubmonoid (ULift.{u+1} ℕ) :=
  AddSubmonoid.closure ({ULift.up qOrder} : Set (ULift.{u+1} ℕ))

/-- Constant qOrder function used by the candidate model. -/
def s539QOrder (_X : Example32SmallBase K) : ℕ := 0

/-- Candidate qOrder from the actual K-side qVFamily order. -/
noncomputable def s539QOrderCandidate {l : PrimeGeFive}
    (T : SourceNativeInitialThetaData l)
    (b : Bad (nativePlaceSelection T))
    (_X : Example32SmallBase K) : ℕ :=
  (qVFamilyK T b).order

/-- Candidate link recording the qOrder source. -/
def s539QOrderCandidateLink {l : PrimeGeFive}
    (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T))
    (qOrder : Example32SmallBase K → ℕ) : Prop :=
  qOrder = s539QOrderCandidate (K := K) T b

/-- The ramification pullback n ↦ e(f)*n preserves the qOrder-generated
submonoid. -/
theorem s539Pullback_mem
    (R : RamificationIndexData (K := K)) (qOrder : ℕ)
    {X Y : Example32SmallBase K} (f : X ⟶ Y)
    {n : ULift.{u+1} ℕ}
    (hn : n ∈ s539PhiSubmonoid (K := K) qOrder Y) :
    uliftNatMulLeft (R.e f).val n ∈
      s539PhiSubmonoid (K := K) qOrder X := by
  rw [s539PhiSubmonoid] at hn ⊢
  rw [AddSubmonoid.mem_closure_singleton] at hn ⊢
  obtain ⟨k, hk⟩ := hn
  refine ⟨k * (R.e f).val, ?_⟩
  rw [← hk]
  apply ULift.ext
  simp [uliftNatMulLeft, nsmul_eq_mul, mul_assoc, mul_comm, mul_left_comm]

/-- Candidate qOrder link theorem: the actual candidate is the K-side
qVFamily order. -/
theorem s539QOrderCandidateLink_self {l : PrimeGeFive}
    (T : SourceNativeInitialThetaData.{0} l)
    (b : Bad (nativePlaceSelection T)) :
    s539QOrderCandidateLink (K := K) T b
      (s539QOrderCandidate (K := K) T b) := rfl

end LeanFormal.IUT.XiFPaper.S539PhiCvSubmonoidActual

end

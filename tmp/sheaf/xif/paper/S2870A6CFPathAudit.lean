local instance : Fact (Irreducible (Polynomial.X ^ 2 - Polynomial.C (-1) : Polynomial ℚ)) :=
  ⟨gaussianPolynomial_irreducible⟩
local instance : Field S2847A6.F := S2847A6.fieldF
local instance : NumberField S2847A6.F := S2847A6.numberFieldF

/-- If the pointwise quotient can be upgraded to a pseudofunctor Q with an
IsStack proof, then cF is constructible by realizedHyperbolicOrbicurve.
This is the only part of cF obtainable from the pointwise + IsStack route. -/
noncomputable def S2870CF
    (Q : Iut.EtaleStackPseudofunctor S2847A6.F)
    (hQ : Q.IsStack (Iut.SchemeOverField.etaleTopology S2847A6.F)) :
    Iut.HyperbolicOrbicurve S2847A6.F :=
  realizedHyperbolicOrbicurve S2847A6.F Q hQ
    Iut.OrbicurveSignature.oncePuncturedElliptic
    Iut.OrbicurveSignature.oncePuncturedElliptic_isHyperbolic

/-- The quotient and universal property are NOT produced by the pointwise
fiber or by IsStack: they are separate data. -/
structure S2870QuotientWitnessData
    (Q : Iut.EtaleStackPseudofunctor S2847A6.F)
    (hQ : Q.IsStack (Iut.SchemeOverField.etaleTopology S2847A6.F))
    (A : Iut.OrbicurveSignAction
      LeanFormal.IUT.XiFPaper.S2855A6CoreFromD6ConditionalActual.S2855HyperbolicOrbicurve) where
  quotient : Iut.OrbicurveSignInvariantMorphism A (S2870CF Q hQ)
  quotientWitness : Iut.OrbicurveSignQuotientWitness A quotient

/-- Combining the pointwise/IsStack cF with quotient+witness yields exactly
the generic S2854 input, hence the 13-field S2869 reduction. -/
noncomputable def S2870Input
    (Q : Iut.EtaleStackPseudofunctor S2847A6.F)
    (hQ : Q.IsStack (Iut.SchemeOverField.etaleTopology S2847A6.F))
    (A : Iut.OrbicurveSignAction
      LeanFormal.IUT.XiFPaper.S2855A6CoreFromD6ConditionalActual.S2855HyperbolicOrbicurve)
    (W : S2870QuotientWitnessData Q hQ A) :
    S2854StackQuotientInput
      LeanFormal.IUT.XiFPaper.S2855A6CoreFromD6ConditionalActual.S2855HyperbolicOrbicurve A where
  cF := S2870CF Q hQ
  quotient := W.quotient
  quotientWitness := W.quotientWitness

/-!
## Audit: S1971 pointwise + S2812 IsStack cannot construct
## S2854StackQuotientInput

1. S1971 gives only:
   * pointwise fiber categories S1971PointwiseQuotient U;
   * single-morphism restriction functors S1971PrecompFunctor f;
   * no mapId/mapComp coherence, hence no pseudofunctor Q with
     Q.obj U = S1971PointwiseQuotient U.
   The missing object is precisely S1971FunctorialPointwiseColimit.

2. Even with such Q, S2812 proves IsStack only for
   schemeRepresentableEtalePseudofunctor F X, whose fibers are discrete
   (subsingleton hom types).  The pointwise quotient is an action groupoid;
   at geometric fixed points it has nonidentity automorphisms
   (S1971PointwiseQuotient_fixed_nontrivial_aut), so it is not equivalent to
   a representable pseudofunctor.  No IsStack instance for Q is available.
   The missing object is precisely S1971QuotientStack (Q plus IsStack).

3. Even with Q and IsStack, the quotient morphism and the bicategorical
   universal property are separate fields of S1971StackQuotientWitness /
   S2854StackQuotientInput; they are not generated by the fiber.  S2870
   packages them explicitly as S2870QuotientWitnessData.

Exact missing objects:
* Q : EtaleStackPseudofunctor F with pointwise equivalences to
  S1971PointwiseQuotient (S1971FunctorialPointwiseColimit);
* Q.IsStack for that Q;
* quotient : OrbicurveSignInvariantMorphism A (S2870CF Q hQ);
* quotientWitness : OrbicurveSignQuotientWitness A quotient.

No fake cF; S2870CF is the actual realized orbicurve from a supplied stack.
-/

#check S2870CF
#check S2870QuotientWitnessData
#check S2870Input
#check S1971FunctorialPointwiseColimit
#check S1971QuotientStack
#check schemeRepresentableEtalePseudofunctor_isStack
#check S1971PointwiseQuotient_fixed_nontrivial_aut
#print axioms S2870CF
#print axioms S2870Input

end LeanFormal.IUT.XiFPaper.S2870A6CFPathAudit

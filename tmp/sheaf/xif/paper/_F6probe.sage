E = EllipticCurve([0,0,1,-1,0])
print("E cond", E.conductor(), "disc", E.discriminant(), "tors", E.torsion_order(), flush=True)
R.<x> = QQ[]
K.<i> = NumberField(x^2+1)
EK = E.change_ring(K)
print("K", K, "torsK", EK.torsion_order(), flush=True)
print("E[2]", E.division_polynomial(2).factor(), flush=True)
print("E[3] deg", E.division_polynomial(3).degree(), flush=True)
print("start F6 field", flush=True)
F6 = EK.division_field(6)
print("F6 degree", F6.degree(), flush=True)
print("F6 disc factors", F6.discriminant().factor(), flush=True)
print("start torsion basis", flush=True)
B = EK.change_ring(F6).torsion_basis(6)
print("basis len", len(B), flush=True)
for P in B: print("P", P, flush=True)

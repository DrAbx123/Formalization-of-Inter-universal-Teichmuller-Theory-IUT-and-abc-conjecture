import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Data.Set.Basic
import Mathlib.Data.Real.Basic

/-! # S907: MOCHIZUKI LVEx toy model

V=R^2, sigma(x,y)=(-x,y), W=V/<sigma>.  R_{a,b} is the source region,
S_{a,b}=R union sigma(R).  We formalize the actual regions, R subset S,
the quotient/descent, and the volume/log/gluing chain.  The Euclidean
volume formulas are isolated as an exact Prop. -/

noncomputable section
open scoped BigOperators Pointwise
open MeasureTheory Set

namespace LeanFormal.IUT.XiFPaper.S907LVExToyActual

abbrev V : Type := ℝ × ℝ

def sigma (v : V) : V := (-v.1, v.2)
@[simp] theorem sigma_apply (x y : ℝ) : sigma (x,y) = (-x,y) := rfl
theorem sigma_involutive : Function.Involutive sigma := by
  intro v; ext <;> simp [sigma]

def R (a b : ℝ) : Set V :=
  (Icc (-1 : ℝ) 1 ×ˢ Icc (-a) a) ∪
    (Icc (0 : ℝ) 1 ×ˢ (Icc a (a+b) ∪ Icc (-(a+b)) (-a)))

def S (a b : ℝ) : Set V := R a b ∪ sigma '' R a b

theorem R_subset_S (a b : ℝ) : R a b ⊆ S a b := fun _ hv => Or.inl hv

theorem sigma_image_S (a b : ℝ) : sigma '' S a b = S a b := by
  ext v; constructor
  · rintro ⟨w, hw | hw, rfl⟩
    · exact Or.inr ⟨w, hw, rfl⟩
    · rcases hw with ⟨u, hu, rfl⟩
      exact Or.inl (by simpa [sigma] using hu)
  · intro hv
    rcases hv with hv | hv
    · exact ⟨sigma v, Or.inr ⟨v, hv, rfl⟩, by simp [sigma_involutive v]⟩
    · rcases hv with ⟨u, hu, rfl⟩
      exact ⟨u, Or.inl hu, rfl⟩

theorem one_a_add_b_mem_R (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    ((1 : ℝ), a + b) ∈ R a b := by
  right; refine ⟨by norm_num, ?_⟩; left
  exact ⟨by linarith, le_rfl⟩

theorem neg_one_a_add_b_not_mem_R (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    ((-1 : ℝ), a + b) ∉ R a b := by
  intro h
  rcases h with h | h
  · rcases h with ⟨hx, hy⟩
    have habs : |a + b| ≤ a := abs_le.mpr ⟨by linarith, hy.2⟩
    have hpos : |a + b| = a + b := abs_of_pos (by linarith)
    linarith
  · rcases h with ⟨hx, hy⟩
    have hx0 : (0 : ℝ) ≤ -1 := hx.1
    linarith

theorem R_not_invariant (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    sigma '' R a b ≠ R a b := by
  intro h
  have hsub : sigma '' R a b ⊆ R a b := by rw [h]
  have hmem : sigma ((1 : ℝ), a + b) ∈ R a b :=
    hsub ⟨((1 : ℝ), a + b), one_a_add_b_mem_R a b ha hb, rfl⟩
  have hneg : sigma ((1 : ℝ), a + b) = ((-1 : ℝ), a + b) := by simp [sigma]
  rw [hneg] at hmem
  exact neg_one_a_add_b_not_mem_R a b ha hb hmem

/-- Orbit relation of the order-two group generated by sigma. -/
def orbitSetoid : Setoid V where
  r v w := w = v ∨ w = sigma v
  iseqv := by
    constructor
    · intro v; exact Or.inl rfl
    · intro v w h; rcases h with rfl | h
      · exact Or.inl rfl
      · subst h; exact Or.inr (sigma_involutive v).symm
    · intro v w u hvw hwu
      rcases hvw with rfl | hvw
      · exact hwu
      · rcases hwu with rfl | hwu
        · exact Or.inr hvw
        · subst hwu; subst hvw
          exact Or.inl (sigma_involutive v)

abbrev W : Type := Quotient orbitSetoid
def phi : V → W := Quotient.mk orbitSetoid

theorem phi_sigma : phi ∘ sigma = phi := by
  funext v; apply Quotient.sound; exact Or.inr (sigma_involutive v).symm

theorem phi_preimage_phi_image_S (a b : ℝ) :
    phi ⁻¹' (phi '' S a b) = S a b := by
  ext v; constructor
  · rintro ⟨u, hu, hqu⟩
    have hrel : orbitSetoid.r u v := Quotient.exact hqu
    rcases hrel with rfl | rfl
    · exact hu
    · rw [← sigma_image_S]
      exact ⟨u, hu, rfl⟩
  · intro hv; exact ⟨v, hv, rfl⟩

def VolumeFormula (a b : ℝ) : Prop :=
  volume (R a b) = ENNReal.ofReal (4*a + 2*b) ∧
    volume (S a b) = ENNReal.ofReal (4*a + 4*b)

noncomputable def muLog (X : Set V) : ℝ := Real.log (volume X).toReal

theorem muLog_S_gt_muLog_R (a b : ℝ) (ha : 0 < a) (hb : 0 < b)
    (hvol : VolumeFormula a b) : muLog (S a b) > muLog (R a b) := by
  unfold muLog
  rw [hvol.2, hvol.1]
  apply Real.log_lt_log
  · exact ENNReal.toReal_pos (by positivity) (by simp)
  · rw [ENNReal.toReal_ofReal (by positivity), ENNReal.toReal_ofReal (by positivity)]
    linarith

noncomputable def rho (a b : ℝ) (lam : ℝ) : ℝ := muLog (R a b) / lam

theorem rho_gt_one (a b : ℝ) (lam : ℝ)
    (hS : muLog (S a b) > 0) (hlam : 0 > lam) (hR : lam > muLog (R a b)) :
    1 < rho a b lam := by
  unfold rho
  rw [one_lt_div_of_neg hlam]
  exact hR

noncomputable def glue (a b : ℝ) (lam x : ℝ) : ℝ := x / rho a b lam

theorem glue_muLogR (a b : ℝ) (lam : ℝ)
    (hS : muLog (S a b) > 0) (hlam : 0 > lam)
    (hR : lam > muLog (R a b)) :
    glue a b lam (muLog (R a b)) = lam := by
  have hlamne : lam ≠ 0 := ne_of_lt hlam
  have hRne : muLog (R a b) ≠ 0 := by linarith
  unfold glue rho
  field_simp [hRne, hlamne]

theorem chain_S_gt_lam (a b : ℝ) (lam : ℝ)
    (hS : muLog (S a b) > 0) (hlam : 0 > lam) : muLog (S a b) > lam :=
  lt_trans hlam hS

end LeanFormal.IUT.XiFPaper.S907LVExToyActual
end

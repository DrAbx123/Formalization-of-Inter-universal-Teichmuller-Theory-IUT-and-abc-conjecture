/- P8 Fermat entry, statement-stage only.  The actual Y_n construction uses
Mathlib ProjectiveSpectrum.zeroLocus + Scheme.IdealSheafData.vanishingIdeal +
.subscheme; this file records only the homogeneous polynomial/ideal and the
remaining-object structure (no proof of the G1b estimate, no fake axioms). -/
import Mathlib.AlgebraicGeometry.AffineScheme
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Tactic

noncomputable section
namespace LeanFormal.IUT.XiFPaper.P8FermatEntryStatementActual
open AlgebraicGeometry

/-- Homogeneous Fermat polynomial `X^n + Y^n - Z^n` in three variables. -/
def fermatPolynomial (n : Nat) : MvPolynomial (Fin 3) ℚ :=
  MvPolynomial.X 0 ^ n + MvPolynomial.X 1 ^ n - MvPolynomial.X 2 ^ n

/-- The homogeneous ideal generated by the Fermat polynomial. -/
def fermatIdeal (n : Nat) : Ideal (MvPolynomial (Fin 3) ℚ) :=
  Ideal.span {fermatPolynomial n}

/-- Statement-stage record of the remaining real P8 objects (no fake proofs):
the actual Fermat scheme is the closed subscheme defined by `fermatIdeal` in
`ProjectiveSpectrum` (via vanishingIdeal + subscheme), with the point/height/
different/conductor data and the G1b estimate still to be supplied. -/
structure P8FermatEntryObjects (n : Nat) where
  Y : Scheme
  y : Y
  Ky : Type
  [fieldKy : Field Ky]
  [numberFieldKy : NumberField Ky]

#print axioms fermatPolynomial

end LeanFormal.IUT.XiFPaper.P8FermatEntryStatementActual
end

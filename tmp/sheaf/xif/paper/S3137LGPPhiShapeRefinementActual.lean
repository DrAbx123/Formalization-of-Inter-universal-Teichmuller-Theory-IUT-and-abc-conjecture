/-! ## 1. Actual Phi-shape: divisorial monoid of the LGP theta divisor cone -/

/-- The Phi-shape is actual: the free LGP theta divisor cone is an actual
divisorial (sharp, integral, saturated) monoid, and its Grothendieck-group
comparison is injective.  This is a prerequisite component of the paper's
C^LGP_LGP Phi layer (IUT III, Prop. 3.7, (ii)--(iii)); the J_v realization and
the Frobenioid isomorphisms are NOT included. -/
theorem lgpPhiShape_actual :
    Nonempty (Iut.DivisorialAddMonoid.{0}) ∧
      Function.Injective (lgpConeToInts (l := l) T) :=
  ⟨⟨lgpDivisorialAddMonoid (l := l) T⟩, lgpConeToInts_injective T⟩

/-! ## 2. Actual local fractional-ideal exponent candidate -/

/-- The local fractional-ideal exponent candidate is actual at every bad place:
every theta-value divisor exponent j^2 * ord_v(q_v) and the principal q_v
exponent lie in the candidate cone, and the q_v exponent lies in its rational
span.  This is the exponent-level shadow of the paper's J_v (IUT III, Prop.
3.7, (ii), (v)); the realization of J_v inside IQ(A, alpha Fv) is the exact
missing record LGPJvRealizationMissing. -/
theorem lgpJvCandidate_actual :
    (∀ (b : Bad (nativePlaceSelection T)) (j : PaperThetaLabel l),
        lgpThetaLabelWeight j * lgpQVDivisorExponent T b ∈
          lgpLocalFractionalIdealCandidate T b) ∧
      (∀ b : Bad (nativePlaceSelection T),
        lgpQVDivisorExponent T b ∈
          lgpLocalFractionalIdealCandidate T b) ∧
      (∀ b : Bad (nativePlaceSelection T),
        ((lgpQVDivisorExponent T b : ℕ) : ℚ) ∈
          lgpLocalFractionalIdealQSpan T b) :=
  ⟨fun b j => lgpThetaExponent_mem_candidate T b j,
    fun b => lgpQVDivisorExponent_mem_candidate T b,
    fun b => lgpQVDivisorExponent_mem_qspan T b⟩


/-! ## 3. Refined exact gap for the theta x mu LGP-link -/

/-- **Refined exact remaining gap**, after the actual value-group, Phi-shape and
local-exponent-candidate components.  Each field is a source object that is NOT
constructed:

* iqTensorPacket: IUT III, Prop. 3.2, (ii) (pp. 100--101) -- the local tensor
  packet IQ(A, alpha Fv);
* jvSubmonoid: IUT III, Prop. 3.7, (ii) (pp. 108--109) -- the additive
  submonoid J_v inside IQ(A, alpha Fv) with full Q-span;
* localIsomorphismCompat: IUT III, Prop. 3.7, (v) (pp. 111--112) -- the
  compatibility with the local isomorphisms rho_lgp,v / rho_LGP,v;
* frobenioidIsomorphisms: IUT II, Cor. 4.8, (ii) -- (F^R_mod) = (F^R_MOD);
* realifiedLGPPresentation: IUT III, Prop. 3.7, (iii) (p. 109);
* unitGroupPortion: IUT III, Prop. 3.7, (iv); Def. 3.8, (ii) -- the
  unit-group (x mu) portion of the F^LGP x mu-prime-strip;
* fullPolyIsomorphism: IUT III, Def. 3.8, (ii) (pp. 112--113). -/
structure LGPXMuPaperGapRefined where
  iqTensorPacket : Prop
  jvSubmonoid : Prop
  localIsomorphismCompat : Prop
  frobenioidIsomorphisms : Prop
  realifiedLGPPresentation : Prop
  unitGroupPortion : Prop
  fullPolyIsomorphism : Prop

def LGPXMuPaperGapRefinedGap : Prop := Nonempty LGPXMuPaperGapRefined

end LeanFormal.IUT.XiFPaper.S3137LGPPhiShapeRefinementActual


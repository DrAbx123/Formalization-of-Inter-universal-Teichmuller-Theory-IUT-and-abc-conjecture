/- Route 8.5 F7 (tame monogenic step): if the conductor is trivial, the different ideal is
generated by the derivative of the minimal polynomial (Mathlib conductor_mul_differentIdeal). -/
import tmp.sheaf.xif.paper.Mzk1G1RelativeDifferentLogActual
import tmp.sheaf.xif.paper.Mzk1G1F7DifferentExponentBoundsActual
import Mathlib.RingTheory.DedekindDomain.Different
import Mathlib.RingTheory.Conductor
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1G1F7TameMonogenicActual

universe u

open Polynomial Ideal NumberField UniqueFactorizationMonoid

section

variable {A K : Type*} {L : Type u} {B}
variable [CommRing A] [Field K] [CommRing B] [Field L]
variable [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
variable [IsScalarTower A K L] [IsScalarTower A B L]
variable [IsDomain A] [IsFractionRing A K]
variable [IsFractionRing B L] [IsIntegrallyClosed A] [IsIntegralClosure B A L]
variable [FiniteDimensional K L] [Algebra.IsSeparable K L]
variable [IsDedekindDomain A] [IsDedekindDomain B] [Module.IsTorsionFree A B] [Module.Finite A B]

/-- Tame/monogenic form of the relative different: trivial conductor implies that the
different ideal is generated by the derivative of the minimal polynomial. -/
theorem differentIdeal_eq_span_derivative_of_conductor_eq_top
    (x : B) (hx : Algebra.adjoin K {algebraMap B L x} = ⊤) (hc : conductor A x = ⊤) :
    differentIdeal A B = Ideal.span {aeval x (derivative (minpoly A x))} := by
  have h := conductor_mul_differentIdeal (A := A) (K := K) (L := L) (B := B) x hx
  rw [hc, Ideal.top_mul] at h
  exact h

end

section NumberField

open LeanFormal.IUT.XiFPaper.Mzk1G1RelativeDifferentLogActual

variable {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [Algebra.IsSeparable K L] [Module.Finite (𝓞 K) (𝓞 L)]

/-- Tame/monogenic form of the different exponent: with trivial conductor, the different
exponent at a prime P equals the multiplicity of P in the derivative ideal. -/
theorem differentExponent_eq_count_derivative_of_conductor_eq_top
    (x : 𝓞 L) (hx : Algebra.adjoin K {algebraMap (𝓞 L) L x} = ⊤)
    (hc : conductor (𝓞 K) x = ⊤) (P : Ideal (𝓞 L)) [P.IsPrime] :
    differentExponent (K := K) (L := L) P =
      (normalizedFactors (Ideal.span {aeval x (derivative (minpoly (𝓞 K) x))})).count P := by
  rw [differentExponent,
    differentIdeal_eq_span_derivative_of_conductor_eq_top x hx hc]

/-- Tame equality of the different exponent: trivial conductor plus the exact order
P^(e-1) || (derivative ideal) gives delta(P) = e - 1. -/
theorem differentExponent_eq_ramification_sub_one_of_monogenic
    (x : 𝓞 L) (hx : Algebra.adjoin K {algebraMap (𝓞 L) L x} = ⊤)
    (hc : conductor (𝓞 K) x = ⊤) (P : Ideal (𝓞 L)) [P.IsPrime] (hP : P ≠ ⊥) {e : Nat}
    (he : 1 ≤ e)
    (hz : aeval x (derivative (minpoly (𝓞 K) x)) ≠ 0)
    (hdvd : P ^ (e - 1) ∣ Ideal.span {aeval x (derivative (minpoly (𝓞 K) x))})
    (hnot : ¬ P ^ e ∣ Ideal.span {aeval x (derivative (minpoly (𝓞 K) x))}) :
    differentExponent (K := K) (L := L) P = e - 1 := by
  rw [differentExponent_eq_count_derivative_of_conductor_eq_top x hx hc P]
  have hI : Ideal.span {aeval x (derivative (minpoly (𝓞 K) x))} ≠ ⊥ := by
    intro hbot
    exact hz (Ideal.span_singleton_eq_bot.mp hbot)
  have hnot' : ¬ P ^ ((e - 1) + 1) ∣
      Ideal.span {aeval x (derivative (minpoly (𝓞 K) x))} := by
    simpa [Nat.sub_add_cancel he] using hnot
  exact LeanFormal.IUT.XiFPaper.Mzk1G1F7DifferentExponentBoundsActual.count_eq_of_pow_dvd_not_pow_succ_dvd hI P hP hdvd hnot'

end NumberField

#print axioms differentIdeal_eq_span_derivative_of_conductor_eq_top
#print axioms differentExponent_eq_count_derivative_of_conductor_eq_top
#print axioms differentExponent_eq_ramification_sub_one_of_monogenic
end LeanFormal.IUT.XiFPaper.Mzk1G1F7TameMonogenicActual

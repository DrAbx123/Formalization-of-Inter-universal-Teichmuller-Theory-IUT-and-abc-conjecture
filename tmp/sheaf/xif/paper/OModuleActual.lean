import Mathlib.RingTheory.FractionalIdeal.Basic
import Mathlib.RingTheory.FractionalIdeal.Operations
import LeanFormal.IUT.Foundations.NumberField.LocalQParameter
import LeanFormal.IUT.Foundations.NumberField.PlaceCompletionCarrier
import LeanFormal.IUT.IUTIII.Theorem311.SourceArithmeticHolomorphicLanding

/-!
# Actual paper rank-one arithmetic line bundle / O-module / localization layer

This file builds a non-toy rank-one layer over the actual number-field integral
ring O_k and the actual completed valuation rings O_v:

* a rank-one arithmetic line bundle is an actual fractional ideal of O_k in k;
* its O_k-module structure is the actual Submodule/FractionalIdeal module;
* its localization at a finite place is the O_v-submodule of K_v generated by
  the image of the fractional ideal;
* the determinant of a rank-one line bundle is the line bundle itself;
* the integral structure is the actual lattice condition I <= 1;
* the local log-volume datum is the actual p-adic valuation normalized by the
  residue characteristic.

No arbitrary carrier is introduced.  This extends the earlier trivial
rank-r module skeleton beyond the free case: an arbitrary fractional ideal
I : FractionalIdeal O_k^0 k is not a priori free or principal.
-/

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

noncomputable section

namespace LeanFormal.IUT

namespace PaperOModuleActual

universe uk

variable {k : Type uk} [Field k] [NumberField k]

/-- The actual integral ring O_k. -/
abbrev OK (k : Type uk) [Field k] [NumberField k] : Type uk :=
  NumberField.RingOfIntegers k

/-- The actual rank-one arithmetic line bundle: a fractional ideal of O_k in
its fraction field k. -/
abbrev LineBundle (k : Type uk) [Field k] [NumberField k] : Type uk :=
  FractionalIdeal (nonZeroDivisors (OK k)) k

/-- The actual completed valuation ring O_v at a finite place. -/
abbrev LocalRing (k : Type uk) [Field k] [NumberField k]
    (v : NumberField.FinitePlace k) : Type uk :=
  NumberFieldFinitePlace.CompletionIntegers v

/-- The actual local field K_v at a finite place. -/
abbrev LocalField (k : Type uk) [Field k] [NumberField k]
    (v : NumberField.FinitePlace k) : Type uk :=
  NumberFieldFinitePlace.Completion v

/-- The integral structure condition on a line bundle: I is contained in the
unit lattice 1 = O_k. -/
def IsIntegral (I : LineBundle (k := k)) : Prop :=
  I <= (1 : LineBundle (k := k))

/-- The unit line bundle is integral. -/
theorem isIntegral_one : IsIntegral (k := k) (1 : LineBundle (k := k)) :=
  le_rfl

/-- Integrality is monotone under inclusion. -/
theorem IsIntegral.mono {I J : LineBundle (k := k)}
    (hIJ : I <= J) (hJ : IsIntegral (k := k) J) : IsIntegral (k := k) I :=
  le_trans hIJ hJ

/-- An actual line bundle from an arbitrary ideal of O_k, extending the
principal/trivial case. -/
def lineBundleOfIdeal (J : Ideal (OK k)) : LineBundle (k := k) :=
  (J : FractionalIdeal (nonZeroDivisors (OK k)) k)

/-- The ideal-defined line bundle is integral. -/
theorem lineBundleOfIdeal_integral (J : Ideal (OK k)) :
    IsIntegral (k := k) (lineBundleOfIdeal (k := k) J) := by
  change (J : FractionalIdeal (nonZeroDivisors (OK k)) k) <=
    (1 : FractionalIdeal (nonZeroDivisors (OK k)) k)
  exact FractionalIdeal.coeIdeal_le_one

/-- The actual localization of a fractional ideal at a finite place: the
O_v-submodule of K_v generated by the image of I under k -> K_v. -/
def localizedLine (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) :
    Submodule (LocalRing (k := k) v) (LocalField (k := k) v) :=
  Submodule.span (LocalRing (k := k) v)
    ((fun x : k => algebraMap k (LocalField (k := k) v) x) ''
      (I : Set k))

/-- The localization map from a line-bundle section to its O_v-localization. -/
def localizationMap (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) (x : I) :
    localizedLine (k := k) I v :=
  ⟨algebraMap k (LocalField (k := k) v) (x : k),
    Submodule.subset_span ⟨x, x.2, rfl⟩⟩

/-- The rank-one line bundle has rank datum one. -/
def bundleRank (_I : LineBundle (k := k)) : Nat := 1

theorem bundleRank_eq_one (I : LineBundle (k := k)) :
    bundleRank (k := k) I = 1 := rfl

/-- The determinant of a rank-one line bundle is the line bundle itself. -/
def determinantLine (I : LineBundle (k := k)) : LineBundle (k := k) :=
  I

theorem determinantLine_eq (I : LineBundle (k := k)) :
    determinantLine (k := k) I = I := rfl

/-- The determinant localization is the localization of the line bundle. -/
def determinantLocalizedLine (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) :
    Submodule (LocalRing (k := k) v) (LocalField (k := k) v) :=
  localizedLine (k := k) I v

theorem determinantLocalizedLine_eq (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) :
    determinantLocalizedLine (k := k) I v = localizedLine (k := k) I v := rfl

/-- The actual additive valuation of K_v, as an integer. -/
def localValuation (v : NumberField.FinitePlace k)
    (x : LocalField (k := k) v) : Int :=
  (Valued.v x).log

/-- The actual p-adic local log-volume of a local section. -/
def localLogVolume (v : NumberField.FinitePlace k)
    (x : LocalField (k := k) v) : Real :=
  - (localValuation (k := k) v x : Real) *
    Real.log (NumberFieldFinitePlace.residueCharacteristic v)

/-- The log-volume of a local section of a line bundle at a place. -/
def sectionLocalLogVolume (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) (x : I) : Real :=
  localLogVolume (k := k) v
    (algebraMap k (LocalField (k := k) v) (x : k))

/-- The global log-volume of a section over a selected finite set of places. -/
def sectionLogVolume (I : LineBundle (k := k))
    (selected : Finset (NumberField.FinitePlace k)) (x : I) : Real :=
  selected.sum fun v => sectionLocalLogVolume (k := k) I v x

/-- The local valuation is additive on nonzero products. -/
theorem localValuation_mul (v : NumberField.FinitePlace k)
    (x y : LocalField (k := k) v)
    (hx : Valued.v x ≠ 0) (hy : Valued.v y ≠ 0) :
    localValuation (k := k) v (x * y) =
      localValuation (k := k) v x + localValuation (k := k) v y := by
  unfold localValuation
  rw [map_mul, WithZero.log_mul hx hy]

/-- The local valuation of one is zero. -/
theorem localValuation_one (v : NumberField.FinitePlace k) :
    localValuation (k := k) v 1 = 0 := by
  unfold localValuation
  simp

/-- The local log-volume of one is zero. -/
theorem localLogVolume_one (v : NumberField.FinitePlace k) :
    localLogVolume (k := k) v 1 = 0 := by
  simp [localLogVolume, localValuation]

/-- A structural carrier record for the rank-one line bundle layer. -/
structure PaperLineBundleData where
  lineBundle : LineBundle (k := k)
  rank : Nat
  localRing : NumberField.FinitePlace k → Type uk
  localField : NumberField.FinitePlace k → Type uk
  localizedLine : (v : NumberField.FinitePlace k) → Type uk
  determinantLine : LineBundle (k := k)
  integral : Prop
  logVolume : (v : NumberField.FinitePlace k) → localField v → Real

/-- The actual rank-one data associated to a line bundle. -/
def actualPaperLineBundleData (I : LineBundle (k := k)) : PaperLineBundleData (k := k) where
  lineBundle := I
  rank := 1
  localRing := fun v => LocalRing.{uk} (k := k) v
  localField := fun v => LocalField.{uk} (k := k) v
  localizedLine := fun v => localizedLine (k := k) I v
  determinantLine := determinantLine (k := k) I
  integral := IsIntegral (k := k) I
  logVolume := fun v => localLogVolume (k := k) v

theorem actualPaperLineBundleData_rank (I : LineBundle (k := k)) :
    (actualPaperLineBundleData (k := k) I).rank = 1 := rfl

theorem actualPaperLineBundleData_determinant (I : LineBundle (k := k)) :
    (actualPaperLineBundleData (k := k) I).determinantLine = I := rfl


/-- The localization map lands in the generated localized line. -/
theorem localizationMap_mem (I : LineBundle (k := k))
    (v : NumberField.FinitePlace k) (x : I) :
    (algebraMap k (LocalField (k := k) v) (x : k)) ∈
      (localizedLine (k := k) I v : Set (LocalField (k := k) v)) :=
  (localizationMap (k := k) I v x).2

/-- Localization is monotone in the fractional ideal. -/
theorem localizedLine_mono {I J : LineBundle (k := k)} (hIJ : I <= J)
    (v : NumberField.FinitePlace k) :
    localizedLine (k := k) I v <= localizedLine (k := k) J v := by
  unfold localizedLine
  apply Submodule.span_mono
  rintro x ⟨y, hy, rfl⟩
  exact ⟨y, hIJ hy, rfl⟩

/-- The localization of an integral line bundle is contained in the
localization of the unit line bundle. -/
theorem localizedLine_le_unit_of_integral {I : LineBundle (k := k)}
    (hI : IsIntegral (k := k) I) (v : NumberField.FinitePlace k) :
    localizedLine (k := k) I v <= localizedLine (k := k) (1 : LineBundle (k := k)) v :=
  localizedLine_mono (k := k) hI v


/-- The actual O_k-module structure on a fixed line bundle. -/
@[reducible] def lineBundleModule (I : LineBundle (k := k)) : Module (OK k) I :=
  inferInstance

/-- The actual additive group structure on a fixed line bundle. -/
@[reducible] def lineBundleAddCommGroup (I : LineBundle (k := k)) : AddCommGroup I :=
  inferInstance

end PaperOModuleActual

end LeanFormal.IUT

end
import LeanFormal.IUT.ABCBridge.Geometry.FreyTateAnalyticInput
import Mathlib.RingTheory.Ideal.Norm.AbsNorm

noncomputable section
set_option linter.unusedVariables false
set_option linter.checkUnivs false

namespace LeanFormal.IUT.XiFPaper.S2750AbsNormRationalPlaceActual

open LeanFormal.IUT

/-- The exact missing principal-ideal bridge: the rational place at `p` has the
principal maximal ideal generated by the cast of `p`. -/
def S2750_rationalFinitePlace_span_bridge (p : Nat) [Fact p.Prime] : Prop :=
  (rationalFinitePlace p).maximalIdeal.asIdeal =
    Ideal.span {(p : NumberField.RingOfIntegers ℚ)}

/-- The exact missing absNorm computation at the rational prime: the principal
ideal generated by `p` has absNorm `p`. -/
def S2750_absNorm_span_bridge (p : Nat) [Fact p.Prime] : Prop :=
  Ideal.absNorm (Ideal.span {(p : NumberField.RingOfIntegers ℚ)}) = p

/-- Conditional absNorm of the rational place: from the two explicit bridges
(principal-ideal identification and absNorm of the principal ideal) the
rational-place absNorm is `p`. -/
theorem S2750_absNorm_rationalFinitePlace_of_bridges
    (p : Nat) [Fact p.Prime]
    (hspan : S2750_rationalFinitePlace_span_bridge p)
    (habs : S2750_absNorm_span_bridge p) :
    Ideal.absNorm (rationalFinitePlace p).maximalIdeal.asIdeal = p := by
  rw [hspan, habs]

#check S2750_absNorm_rationalFinitePlace_of_bridges
#check S2750_rationalFinitePlace_span_bridge
#check S2750_absNorm_span_bridge
#print axioms S2750_absNorm_rationalFinitePlace_of_bridges

end LeanFormal.IUT.XiFPaper.S2750AbsNormRationalPlaceActual
end

import tmp.sheaf.xif.paper.QPilotLineBundleUnconditional

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

/-!
# Global q-pilot ideal: object construction and exact missing lift

Task-639 write-only attempt.

Available actual data:
* the actual source arithmetic field A and integral ring O_K
  (ArithmeticLineBundleActual / QPilotLineBundleUnconditional);
* the actual local q from C3 (SourcePilotRegionData) and the base-place q
  candidate descent package (BasePlaceQCandidateActual).

The local C3 q lives in a completed local field, not in the global number field
K. A global ideal of O_K therefore requires a global lift: a global element
globalQ : A.K whose local completion is the actual q (or an equivalent
q-pilot point ideal class). No production theorem in the tree supplies this
lift.

This file constructs the actual principal global ideal from a supplied global
q-pilot element and proves the resulting PaperQPilotLineBundleSource. The
principal ideal is not arbitrary: it is Ideal.span {globalQ} for the supplied
global element, and the construction records the exact local-compatibility
proposition that remains to be proved.

Exact missing lift:
  GlobalQPilotLift.globalQ : SourceOK A
  GlobalQPilotLift.local_compatibility : Prop
No identity/unit-ideal substitution and no True/PUnit/axiom/sorry is used.
-/

noncomputable section

namespace LeanFormal.IUT.N8Closure.QPilotGlobalIdealActual

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open LeanFormal.IUT.XiFPaperArithmeticLineBundle
open LeanFormal.IUT.N8Closure.QPilotLineBundleUnconditional
open LeanFormal.IUT.N8Closure.SourcePilotRegion

universe ua uv upi umon ui

variable {l : PrimeGeFive}
variable {V : Type uv}
variable {I : OriginalInput.{ua, uv, upi, umon, ui} l V}
variable (A : InitialThetaArithmeticData l)

/-- The source integral ring. -/
abbrev SourceOKOf := SourceOK (A := A)

/-- The exact global q-pilot lift data: a global K-element and the local
compatibility proposition linking it to the actual C3 q. -/
structure GlobalQPilotLift where
  /-- The supplied global integral q-pilot element. -/
  globalQ : SourceOKOf (A := A)
  /-- The exact local compatibility statement for the actual C3 q. -/
  local_compatibility : Prop

/-- The actual global q-pilot ideal: the principal ideal generated by the
supplied global element. -/
def qPilotIdealOfLift (L : GlobalQPilotLift (A := A)) :
    Ideal (SourceOKOf (A := A)) :=
  Ideal.span ({L.globalQ} : Set (SourceOKOf (A := A)))

/-- The global q-pilot ideal is the principal ideal of the global element. -/
@[simp] theorem qPilotIdealOfLift_eq (L : GlobalQPilotLift (A := A)) :
    qPilotIdealOfLift (A := A) L =
      Ideal.span ({L.globalQ} : Set (SourceOKOf (A := A))) := rfl

/-- The actual paper q-pilot line-bundle source from the global lift. -/
noncomputable def qPilotLineBundleSourceOfLift
    (L : GlobalQPilotLift (A := A)) :
    PaperQPilotLineBundleSource A where
  qPilotLineBundle :=
    (qPilotIdealOfLift (A := A) L :
      FractionalIdeal (nonZeroDivisors (SourceOKOf (A := A))) A.K)
  qPilotIdeal := qPilotIdealOfLift (A := A) L
  qPilot_lineBundle_eq := rfl
  qPilot_source_identification := L.local_compatibility

/-- The constructed source has the actual principal global ideal. -/
theorem qPilotLineBundleSourceOfLift_ideal
    (L : GlobalQPilotLift (A := A)) :
    (qPilotLineBundleSourceOfLift (A := A) L).qPilotIdeal =
      Ideal.span ({L.globalQ} : Set (SourceOKOf (A := A))) := rfl

/-- The constructed line bundle is the fractional ideal generated by the
global q-pilot element. -/
theorem qPilotLineBundleSourceOfLift_lineBundle
    (L : GlobalQPilotLift (A := A)) :
    (qPilotLineBundleSourceOfLift (A := A) L).qPilotLineBundle =
      (Ideal.span ({L.globalQ} : Set (SourceOKOf (A := A))) :
        FractionalIdeal (nonZeroDivisors (SourceOKOf (A := A))) A.K) := rfl

/-- The exact missing global lift from the actual local C3 q. -/
def MissingGlobalQPilotLift
    (C3 : SourcePilotRegionData (l := l) (V := V) I) : Prop :=
  Nonempty (GlobalQPilotLift (A := A))

/-- Conditional nonempty paper q-pilot line bundle from the global lift. -/
theorem qPilotLineBundleSourceOfLift_nonempty
    (C3 : SourcePilotRegionData (l := l) (V := V) I)
    (L : GlobalQPilotLift (A := A)) :
    Nonempty (PaperQPilotLineBundleSource A) :=
  ⟨qPilotLineBundleSourceOfLift (A := A) L⟩

/-- Exact status: the principal global ideal and the paper line-bundle source
are constructed from a supplied global lift; the lift from the actual local
C3/base q is not constructed. -/
theorem qPilotGlobalIdeal_status
    (C3 : SourcePilotRegionData (l := l) (V := V) I)
    (L : GlobalQPilotLift (A := A)) :
    (qPilotLineBundleSourceOfLift (A := A) L).qPilotIdeal =
        Ideal.span ({L.globalQ} : Set (SourceOKOf (A := A))) ∧
      Nonempty (PaperQPilotLineBundleSource A) :=
  ⟨qPilotLineBundleSourceOfLift_ideal (A := A) L,
    qPilotLineBundleSourceOfLift_nonempty (A := A) C3 L⟩

end LeanFormal.IUT.N8Closure.QPilotGlobalIdealActual

end

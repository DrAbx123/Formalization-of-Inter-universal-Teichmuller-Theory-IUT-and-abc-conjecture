variable {p : Nat} [Fact (Nat.Prime p)]

/-! ## 1. Commutator words and their continuity -/

/-- `commutatorWord G N f` is the ordered product
`⁅(f 0).1, (f 0).2⁆ * ... * ⁅(f (N-1)).1, (f (N-1)).2⁆` of the `N` commutators
prescribed by `f`; for `N = 0` it is `1`. -/
def commutatorWord (G : Type*) [Group G] : ∀ N : Nat, (Fin N → G × G) → G
  | 0, _ => 1
  | N + 1, f =>
      commutatorWord G N (fun i => f i.castSucc) *
        ⁅(f (Fin.last N)).1, (f (Fin.last N)).2⁆

theorem commutatorWord_zero (G : Type*) [Group G] (f : Fin 0 → G × G) :
    commutatorWord G 0 f = 1 := rfl

theorem commutatorWord_succ (G : Type*) [Group G] (N : Nat) (f : Fin (N + 1) → G × G) :
    commutatorWord G (N + 1) f =
      commutatorWord G N (fun i => f i.castSucc) *
        ⁅(f (Fin.last N)).1, (f (Fin.last N)).2⁆ := rfl

/-- The product of `N` commutators depends continuously on the `N` pairs. -/
theorem continuous_commutatorWord (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : ∀ N : Nat, Continuous (commutatorWord G N)
  | 0 => continuous_const
  | N + 1 => by
    have ih : Continuous (commutatorWord G N) := continuous_commutatorWord G N
    have h1 : Continuous fun f : Fin (N + 1) → G × G =>
        commutatorWord G N (fun i => f i.castSucc) :=
      ih.comp (continuous_pi fun i => continuous_apply (Fin.castSucc (n := N) i))
    have h2 : Continuous fun f : Fin (N + 1) → G × G =>
        ⁅(f (Fin.last N)).1, (f (Fin.last N)).2⁆ := by
      have ha : Continuous fun f : Fin (N + 1) → G × G => (f (Fin.last N)).1 :=
        continuous_fst.comp (continuous_apply (Fin.last N))
      have hb : Continuous fun f : Fin (N + 1) → G × G => (f (Fin.last N)).2 :=
        continuous_snd.comp (continuous_apply (Fin.last N))
      simp only [commutatorElement_def]
      exact ((ha.mul hb).mul ha.inv).mul hb.inv
    exact h1.mul h2

/-- Every product of commutators lies in the abstract commutator subgroup. -/
theorem commutatorWord_mem_commutator (G : Type*) [Group G] :
    ∀ (N : Nat) (f : Fin N → G × G), commutatorWord G N f ∈ commutator G
  | 0, _ => Subgroup.one_mem _
  | N + 1, f => by
    refine Subgroup.mul_mem _
      (commutatorWord_mem_commutator G N (fun i => f i.castSucc)) ?_
    exact Subgroup.commutator_mem_commutator (H₁ := ⊤) (H₂ := ⊤)
      (Subgroup.mem_top _) (Subgroup.mem_top _)

/-- **The commutator subgroup is generated by a countable union of compact sets.**
Each `Set.range (commutatorWord G N)` is the image of the compact space `(G × G)^N`
under a continuous map, so it is compact and hence closed; the abstract commutator
subgroup is only the subgroup these closed sets generate.  This is the precise structural
reason why closedness of `[G,G]` is not automatic. -/
theorem commutator_eq_closure_iUnion_commutatorWord (G : Type*) [Group G] :
    commutator G = Subgroup.closure (⋃ N : Nat, Set.range (commutatorWord G N)) := by
  refine le_antisymm ?_ ?_
  · rw [commutator_eq_closure]
    refine Subgroup.closure_mono ?_
    rintro x ⟨a, b, rfl⟩
    refine Set.mem_iUnion.mpr ⟨1, ⟨fun _ => (a, b), ?_⟩⟩
    simp [commutatorWord]
  · rw [Subgroup.closure_le, Set.iUnion_subset_iff]
    intro N
    rintro _ ⟨f, rfl⟩
    exact commutatorWord_mem_commutator G N f

/-! ## 2. Bounded commutator width implies closedness -/

/-- **Bounded commutator width gives closedness.**  In a compact Hausdorff topological
group, if every element of the abstract commutator subgroup is a product of `N`
commutators for one fixed `N`, then the abstract commutator subgroup is closed: it is
then contained in the image of the compact space `(G × G)^N`, which is compact, hence
closed, and it contains that image. -/
theorem isClosed_commutator_of_boundedWidth (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [T2Space G] (N : Nat)
    (h : (commutator G : Set G) ⊆ Set.range (commutatorWord G N)) :
    IsClosed (commutator G : Set G) := by
  rw [← closure_subset_iff_isClosed]
  calc closure (commutator G : Set G)
      ⊆ closure (Set.range (commutatorWord G N)) := closure_mono h
    _ = Set.range (commutatorWord G N) :=
        (isCompact_range (continuous_commutatorWord G N)).isClosed.closure_eq
    _ ⊆ (commutator G : Set G) := by
        rintro _ ⟨f, rfl⟩
        exact commutatorWord_mem_commutator G N f

/-- The closedness form used by (M2c): under bounded commutator width the topological
closure of the abstract commutator subgroup is the commutator subgroup itself. -/
theorem commutator_topologicalClosure_eq_of_boundedWidth (G : Type*) [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G] (N : Nat)
    (h : (commutator G : Set G) ⊆ Set.range (commutatorWord G N)) :
    (commutator G).topologicalClosure = commutator G :=
  le_antisymm
    (Subgroup.topologicalClosure_minimal _
      le_rfl (isClosed_commutator_of_boundedWidth G N h))
    (Subgroup.le_topologicalClosure _)

/-- **The second general criterion**: if the abstract commutator subgroup is open, it is
closed.  (For `G_L` this criterion does not apply: the abelianization of `G_L` surjects
onto the infinite procyclic quotient `Gal(Qbar_p/L^ur) = Zhat`, so `[G_L,G_L]` has
infinite index and cannot be open.  This remark is not formalised here.) -/
theorem isClosed_commutator_of_isOpen (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (h : IsOpen (commutator G : Set G)) :
    IsClosed (commutator G : Set G) :=
  OpenSubgroup.isClosed (⟨commutator G, h⟩ : OpenSubgroup G)

/-! ## 3. The width condition for `G_L`, and the reduction to (M2c) -/

/-- **Bounded commutator width for `G_L`, at one level.**  Every element of the abstract
commutator subgroup is a product of `N` commutators. -/
def CommutatorWidthBoundedBy (U : Index p) (N : Nat) : Prop :=
  (commutator (localGaloisGroup p U) : Set (localGaloisGroup p U)) ⊆
    Set.range (commutatorWord (localGaloisGroup p U) N)

/-- Bounded commutator width for `G_L`, with the bound allowed to depend on the level. -/
def CommutatorWidthBounded (U : Index p) : Prop :=
  ∃ N : Nat, CommutatorWidthBoundedBy U N

/-- **Commutator closedness from bounded width**, at one level.  This is the precise
sufficient condition consumed by S2109's `CommutatorClosed`. -/
theorem commutatorClosed_of_widthBounded (U : Index p) (h : CommutatorWidthBounded U) :
    CommutatorClosed U := by
  obtain ⟨N, hN⟩ := h
  exact commutator_topologicalClosure_eq_of_boundedWidth (localGaloisGroup p U) N hN

/-- **The width input.**  This is the exact deep group-theoretic input that would close
(M2c) through the mechanism of this file.  It is recorded, never assumed;
`m2cFirstMissing_of_nikolovSegal` below derives it from the Nikolov-Segal statement plus
finite generation. -/
def CommutatorWidthInput : Prop := ∀ U : Index p, CommutatorWidthBounded U

/-- **Bounded width for all levels gives the exact first missing statement.** -/
theorem m2cFirstMissing_of_widthInput (h : CommutatorWidthInput (p := p)) :
    M2cFirstMissing (p := p) :=
  fun U => commutatorClosed_of_widthBounded U (h U)

/-! ## 4. Closedness is exactly bijectivity of the (M2c) carrier map -/

/-- **The converse direction of the carrier comparison**: injectivity of
`abelianizationToTopological` already forces the abstract commutator subgroup to be
closed.  (Surjectivity is unconditional: S2027's
`abelianizationToTopological_surjective`.)  Consequently the missing input of (M2c) is
*exactly* the missing injectivity of the carrier map; the target is not changed. -/
theorem commutatorClosed_of_injective (U : Index p)
    (hinj : Function.Injective (abelianizationToTopological p U)) :
    CommutatorClosed U := by
  refine le_antisymm ?_ (Subgroup.le_topologicalClosure _)
  intro x hx
  obtain ⟨u, rfl⟩ := (localGaloisGroupEquiv p U).surjective x
  have h2 : abelianizationToTopological p U (Abelianization.of u) = 1 := by
    rw [show abelianizationToTopological p U (Abelianization.of u) =
        (QuotientGroup.mk'
          ((commutator (localGaloisGroup p U)).topologicalClosure))
          ((localGaloisGroupEquiv p U) u) from by
      simp [abelianizationToTopological, Abelianization.lift_apply_of]]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hx
  have h3 : Abelianization.of u = 1 := by
    apply hinj
    rw [h2, map_one]
  have h4 : u ∈ commutator ↥U := by
    have h5 : u ∈ Abelianization.of.ker := by
      rw [MonoidHom.mem_ker]
      exact h3
    rwa [Abelianization.ker_of ↥U] at h5
  have hmap : (commutator ↥U).map (localGaloisGroupEquiv p U).toMonoidHom =
      commutator (localGaloisGroup p U) := by
    rw [commutator_def, commutator_def, Subgroup.map_commutator,
      Subgroup.map_top_of_surjective _ (localGaloisGroupEquiv p U).surjective]
  rw [← hmap]
  exact ⟨u, h4, rfl⟩

/-- **Closedness of `[G_L,G_L]` is equivalent to bijectivity of the (M2c) carrier map**
`Abelianization U -> TopologicalAbelianization G_L`.  No target has been changed: the
right-hand side is literally the map whose restriction to torsion is S2027's
`canonicalTorsionComparison`. -/
theorem commutatorClosed_iff_bijective (U : Index p) :
    CommutatorClosed U ↔ Function.Bijective (abelianizationToTopological p U) :=
  ⟨abelianizationToTopological_bijective_of_commutatorClosed U,
    fun hb => commutatorClosed_of_injective U hb.1⟩

/-! ## 5. The concrete carrier: the abstract abelianization as `Gal(L^ab/L)` -/

/-- **From commutator closedness the abstract abelianization is the Galois group of the
maximal abelian extension.**  This is the carrier on which local class field theory (and
the tree's unconditional local reciprocity, S2098/S2102 via `PadicField.galAbEquiv`)
lives; (M2c) is exactly the statement that the abstract carrier `Abelianization U` reaches
it.  Nothing here is assumed: both factors are constructed. -/
noncomputable def abelianizationEquivGaloisGroupMaximalAbelian (U : Index p)
    (h : CommutatorClosed U) :
    Abelianization ↥U ≃* Gal(↥(maximalAbelianExtension p U) / localField p U) :=
  (MulEquiv.ofBijective (abelianizationToTopological p U)
    (abelianizationToTopological_bijective_of_commutatorClosed U h)).trans
    (galoisGroupMaximalAbelian p U)

/-! ## 6. The two deep inputs, stated precisely -/

/-- **First deep input.**  `G_L = Gal(Qbar_p/L)` is topologically generated by finitely
many elements.  Classically this is the finiteness of the set of extensions of `L` of a
given degree inside `Qbar_p` (Krasner's lemma); it is what makes `G_L` a finitely
generated profinite group, hence subject to the Nikolov-Segal theory.  Absent from
Mathlib v4.32.2 and from the tree. -/
def TopologicallyFinitelyGenerated (U : Index p) : Prop :=
  ∃ s : Finset (localGaloisGroup p U),
    (Subgroup.closure (s : Set (localGaloisGroup p U))).topologicalClosure = ⊤

universe u

/-- **Second deep input: the commutator case of the Nikolov-Segal uniform bounds.**

In every topologically finitely generated profinite group, the abstract commutator
subgroup is a bounded product of commutators.  This is the statement (for the commutator
word) of the verbal-subgroup theory of finitely generated profinite groups; see [NS],
[NS2] and, for pro-`p` groups, [JZ].  It is recorded as a proposition and is **not**
assumed anywhere; every theorem below taking it as an argument is a genuine implication. -/
def NikolovSegalCommutatorWidth : Prop :=
  ∀ (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
    [T2Space G] [TotallyDisconnectedSpace G],
    (∃ s : Finset G, (Subgroup.closure (s : Set G)).topologicalClosure = ⊤) →
      ∃ N : Nat, (commutator G : Set G) ⊆ Set.range (commutatorWord G N)

/-- The Nikolov-Segal statement, applied at one level, gives bounded width there. -/
theorem commutatorWidthBounded_of_nikolovSegal
    (hNS : NikolovSegalCommutatorWidth.{0}) (U : Index p)
    (hfg : TopologicallyFinitelyGenerated U) :
    CommutatorWidthBounded U := by
  obtain ⟨s, hs⟩ := hfg
  obtain ⟨N, hN⟩ := hNS (localGaloisGroup p U) ⟨s, hs⟩
  exact ⟨N, hN⟩

/-- **The exact route to `M2cFirstMissing`**: finite generation of every `G_L` together
with the Nikolov-Segal width statement gives commutator closedness at every level, hence
S2109's first missing statement, hence (M2c). -/
theorem m2cFirstMissing_of_nikolovSegal
    (hNS : NikolovSegalCommutatorWidth.{0})
    (hfg : ∀ U : Index p, TopologicallyFinitelyGenerated U) :
    M2cFirstMissing (p := p) :=
  m2cFirstMissing_of_widthInput (p := p)
    (fun U => commutatorWidthBounded_of_nikolovSegal hNS U (hfg U))

/-! ## 7. The (M2c) payload at the exact S2027/S2109 types -/

/-- The carrier comparison, for every level, from the width input. -/
theorem carrierComparison_forall_of_widthInput (h : CommutatorWidthInput (p := p)) :
    ∀ U : Index p, Nonempty (CarrierComparison U) :=
  fun U => ⟨carrierComparison_of_commutatorClosed U (commutatorClosed_of_widthBounded U (h U))⟩

/-- S2027's canonical torsion comparison, for every level, from the width input. -/
theorem canonicalTorsionComparison_forall_of_widthInput
    (h : CommutatorWidthInput (p := p)) :
    ∀ U : Index p, canonicalTorsionComparison p U :=
  fun U => canonicalTorsionComparison_of_commutatorClosed U
    (commutatorClosed_of_widthBounded U (h U))

/-- S2027's existential torsion comparison, for every level, from the width input. -/
theorem profiniteTorsionComparison_forall_of_widthInput
    (h : CommutatorWidthInput (p := p)) :
    ∀ U : Index p, profiniteTorsionComparison p U :=
  fun U => profiniteTorsionComparison_of_commutatorClosed U
    (commutatorClosed_of_widthBounded U (h U))

/-- The (M2c) target type, at one level, from the width input: the conclusion is
literally `torsion (Abelianization U) ≃* torsion (TopologicalAbelianization G_L)`, not the
profinite carrier. -/
example (h : CommutatorWidthInput (p := p)) (U : Index p) :
    CommGroup.torsion (Abelianization ↥U) ≃*
      CommGroup.torsion (TopologicalAbelianization (localGaloisGroup p U)) :=
  (carrierComparison_forall_of_widthInput h U).some

/-- **S2027's `LocalArtinSourceData` from the width input**: the `carrier` field is
supplied by the width-to-closedness reduction, the `artin` field by S2102's (M2a).  No
field is fabricated and nothing is assumed beyond the named input. -/
noncomputable def localArtinSourceDataOfWidthInput (h : CommutatorWidthInput (p := p)) :
    LocalArtinSourceData p :=
  localArtinSourceDataOfCommutatorClosed (p := p)
    (fun U => commutatorClosed_of_widthBounded U (h U))

/-- **S2011's levelwise reciprocity on torsion from the width input**, through S2027's
consumer. -/
theorem localReciprocityOnTorsion_of_widthInput (h : CommutatorWidthInput (p := p)) :
    localReciprocityOnTorsion p :=
  S2027LocalArtinActual.localReciprocityOnTorsion_of_source p
    (localArtinSourceDataOfWidthInput h)


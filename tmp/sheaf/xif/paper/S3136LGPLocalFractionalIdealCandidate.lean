import tmp.sheaf.xif.paper.S3136LGPPhiInputSourceActual

/-! # Stage-4 host: candidate local fractional ideals J_v from actual theta data

IUT III, Prop. 3.4, (ii) (pp. 102--103) and Prop. 3.7, (ii), (v)
(pp. 108--112): the LGP Frobenioid data are the local fractional ideals `J_v`
generated by the local LGP-monoid elements `Ψ_FLGP,v`, sitting inside the
tensor packets `IQ(A,αFv)` with Q-span equal to `IQ(A,αFv)`.

This file constructs the *actual exponent-level candidate* for these ideals from
the actual q_v/theta data:

* `lgpLocalThetaExponentSet T b`: the actual theta-value divisor exponents
  `j^2 * ord_v(q_v)` at the bad place b (IUT II theta values; IUT III Prop 3.4);
* `lgpLocalFractionalIdealCandidate T b`: the additive submonoid of `ℕ`
  generated by them (the candidate local ideal exponent cone);
* `lgpLocalFractionalIdealQSpan T b`: its rational span inside `ℚ`.

Proved: every actual theta exponent lies in the candidate (by construction), and
the actual q_v exponent `ord_v(q_v)` lies in the candidate and in its rational
span (the label j = 1 gives weight 1).

IDENTIFICATION ROUTE (what additional actual data would identify the candidate
with the paper's `J_v`): supply
   (1) the actual tensor packet `IQ(A,αFv)` at each v in V_bad
       (IUT III, Prop. 3.2, (ii), pp. 100--101);
   (2) a monoid isomorphism from the candidate exponent cone `ℕ^n` (or its
       groupification) onto the submonoid of `IQ(A,αFv)` generated by the
       theta values `q_v^{j^2}` (IUT III, Prop. 3.4, (ii), pp. 102--103);
   (3) the Q-span equality with `IQ(A,αFv)` (IUT III, Prop. 3.7, (ii), p. 108);
   (4) compatibility of that isomorphism with the local isomorphisms
       `ρ_lgp,v` (IUT III, Prop. 3.7, (v), pp. 111--112).
These four items are exactly the fields of `LGPJvRealizationMissing`; the
exponent-level monoid here is a prerequisite candidate, NOT a surrogate and NOT
the paper's `J_v`.  Consumer: lattice stream, IUT-III.theta-xmu-LGP-full-poly-isomorphism.-/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 1000000

namespace LeanFormal.IUT.XiFPaper.S3136LGPLocalFractionalIdealCandidate

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.TwoLthRootQVActual
open LeanFormal.IUT.XiFPaper.QPilotZeroLocusDivisorActual
open LeanFormal.IUT.N8Closure.C3Roots
open LeanFormal.IUT.XiFPaper.LGPPhiInputFromAlgebraicClosureActual
open LeanFormal.IUT.XiFPaper.LGPPhiInputActual
open LeanFormal.IUT.XiFPaper.PaperSymbolTypesActual
open LeanFormal.IUT.XiFPaper.S3136LGPPhiInputSourceActual

universe u

variable {l : PrimeGeFive} (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]

/-- The actual theta label j = 1, which generates the principal q_v direction
inside the LGP monoid. -/
def lgpThetaLabelOne (l : PrimeGeFive) : PaperThetaLabel l :=
  ⟨⟨1, by
      have h5 : 5 ≤ l.value := l.ge_five
      unfold lStar
      constructor <;> omega⟩, by norm_num⟩

/-- The gaussian weight of the label j = 1 is 1. -/
theorem lgpThetaLabelWeight_one (l : PrimeGeFive) :
    lgpThetaLabelWeight (lgpThetaLabelOne l) = 1 := by
  have h : lgpThetaLabelWeight (lgpThetaLabelOne l) =
      (gaussExponent (1 : ℤ)).toNat := rfl
  rw [h]
  norm_num [gaussExponent]

/-- The actual local theta-value divisor exponent set at a bad place: the
j^2 * ord_v(q_v) for the positive theta labels j. -/
def lgpLocalThetaExponentSet (b : Bad (nativePlaceSelection T)) : Set ℕ :=
  Set.range fun j : PaperThetaLabel l =>
    lgpThetaLabelWeight j * lgpQVDivisorExponent T b

/-- The candidate local fractional ideal exponent cone at a bad place: the
additive submonoid of `ℕ` generated by the actual theta-value divisor
exponents. -/
def lgpLocalFractionalIdealCandidate (b : Bad (nativePlaceSelection T)) :
    AddSubmonoid ℕ :=
  AddSubmonoid.closure (lgpLocalThetaExponentSet T b)

/-- Every actual theta-value divisor exponent lies in the candidate ideal. -/
theorem lgpThetaExponent_mem_candidate
    (b : Bad (nativePlaceSelection T)) (j : PaperThetaLabel l) :
    lgpThetaLabelWeight j * lgpQVDivisorExponent T b ∈
      lgpLocalFractionalIdealCandidate T b :=
  AddSubmonoid.subset_closure ⟨j, rfl⟩

/-- The actual q_v divisor exponent (the principal generator of the LGP
monoid) lies in the candidate ideal. -/
theorem lgpQVDivisorExponent_mem_candidate (b : Bad (nativePlaceSelection T)) :
    lgpQVDivisorExponent T b ∈ lgpLocalFractionalIdealCandidate T b := by
  have h := lgpThetaExponent_mem_candidate T b (lgpThetaLabelOne l)
  rw [lgpThetaLabelWeight_one l] at h
  simpa using h

/-- The rational span of the candidate ideal inside `ℚ`: the exponent-level
shadow of `J_v`'s Q-span. -/
def lgpLocalFractionalIdealQSpan (b : Bad (nativePlaceSelection T)) :
    Submodule ℚ ℚ :=
  Submodule.span ℚ (Set.range fun j : PaperThetaLabel l =>
    ((lgpThetaLabelWeight j * lgpQVDivisorExponent T b : ℕ) : ℚ))

/-- The actual q_v exponent lies in the rational span. -/
theorem lgpQVDivisorExponent_mem_qspan (b : Bad (nativePlaceSelection T)) :
    ((lgpQVDivisorExponent T b : ℕ) : ℚ) ∈ lgpLocalFractionalIdealQSpan T b := by
  apply Submodule.subset_span
  refine ⟨lgpThetaLabelOne l, ?_⟩
  show ((lgpThetaLabelWeight (lgpThetaLabelOne l) * lgpQVDivisorExponent T b : ℕ) : ℚ) =
    ((lgpQVDivisorExponent T b : ℕ) : ℚ)
  rw [lgpThetaLabelWeight_one l]
  simp

/-- Exact missing data for realizing the candidate as the paper's local
fractional ideal `J_v` inside `IQ(A,αFv)`.

* `iqTensorPacket`: IUT III, Prop. 3.2, (ii) (pp. 100--101) — the actual
  tensor packet `IQ(A,αFv)` at v in V_bad (the tree contains C3 tensor
  packets and log-shell data, but not this local LGP packet).
* `jvSubmonoid`: IUT III, Prop. 3.7, (ii) (pp. 108--109) — the additive
  submonoid `J_v ⊆ IQ(A,αFv)` generated by the LGP monoid elements, with
  Q-span equal to `IQ(A,αFv)`.
* `localIsomorphismCompat`: IUT III, Prop. 3.7, (v) (pp. 111--112) — the
  compatibility of the `J_v` with the local isomorphisms `ρ_lgp,v` (resp.
  `ρ_LGP,v`) of the F^⊩-prime-strip. -/
structure LGPJvRealizationMissing where
  iqTensorPacket : Prop
  jvSubmonoid : Prop
  localIsomorphismCompat : Prop

/-- The exact realization gap for the local fractional ideals. -/
def LGPJvRealizationGap : Prop := Nonempty LGPJvRealizationMissing

#check lgpThetaLabelOne
#check lgpThetaLabelWeight_one l
#check lgpQVDivisorExponent_mem_candidate
#check lgpQVDivisorExponent_mem_qspan
#check LGPJvRealizationGap

end LeanFormal.IUT.XiFPaper.S3136LGPLocalFractionalIdealCandidate
end

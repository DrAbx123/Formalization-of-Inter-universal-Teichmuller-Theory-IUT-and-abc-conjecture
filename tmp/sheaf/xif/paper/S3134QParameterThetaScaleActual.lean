import tmp.sheaf.xif.paper.S3134FourthJointQThetaActual

/-!
# S3134: the actual q-parameter as the base of the 1-column theta log-scales

IUT II theta special values of a finite theta packet: `scale j = q ^ (gaussExponent
j)` (`FiniteThetaPacket.scale_eq`, `FiniteThetaPacket.log_scale`).  On the
actual 1-column theater the theta packet of the `(1,m)` stage is an actual
`FiniteThetaPacket`, so the actual 1-column log readout is an integer multiple
of the actual `log q` parameter, with the integer `gaussExponent j`.

This is the actual arithmetic half of the q/Theta simultaneous comparison of
IUT III, Corollary 3.12 (corpus `Inter-universal Teichmuller Theory
III.txt:10325-10360`): the Theta-side readout of the fourth triangle is
generated by the q-side parameter, so the comparison is between readouts of a
single actual q-parameter.  The sign/finiteness/comparison inputs remain in
`S3134QThetaComparisonGap`; here we only record the actual arithmetic
relations, with no inequality judged.  No sorry, axiom, `True`, `PUnit`, or
toy carrier.  WRITE-ONLY: no lake/lean.
-/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open LeanFormal.IUT.XiFPaper.S1204SHEOneColumnReadoutActual
open LeanFormal.IUT.XiFPaper.S1300HDDHullDetActual
open LeanFormal.IUT.XiFPaper.S3134FourthJointQThetaActual

namespace LeanFormal.IUT.XiFPaper.S3134QParameterThetaScaleActual

universe u v uv ua upi umon ui

variable {Label : Type u} {Choice : Type v} [AddGroup Label] [Preorder Choice]
variable (I : Input Label Choice)
variable {l : PrimeGeFive} {V : Type uv}
variable (J : OriginalInput.{ua, uv, upi, umon, ui} l V)

/-- The `(1,0)` 1-column scale is the scale of the actual theta packet at the
`(1,0)` stage. -/
theorem S3134OneColumnScaleZero_eq_packetScale (j : SignedLabel l.value) :
    J.oneColumnScale 0 j = (J.oneColumnPacket 0).scale j :=
  rfl

/-- The actual `(1,0)` log-scale is the Gaussian exponent times the actual
`log q` parameter. -/
theorem S3134QParameter_log_scale_zero (j : SignedLabel l.value) :
    Real.log (J.oneColumnScale 0 j) =
      (gaussExponent j.1).toNat * Real.log (S3134QParameter J) :=
  (J.oneColumnPacket 0).log_scale j

/-- The actual log-scale at column `m` is the Gaussian exponent times the
actual `q` of that column. -/
theorem S3134QParameter_log_scale_ofColumn (m : Int)
    (j : SignedLabel l.value) :
    Real.log (J.oneColumnScale m j) =
      (gaussExponent j.1).toNat * Real.log (J.oneColumnQ m) :=
  (J.oneColumnPacket m).log_scale j

/-- The actual log-scale at every column is the Gaussian exponent times the same
actual `log q` parameter (the q-parameter is column-invariant by the actual
theta-link transport). -/
theorem S3134QParameter_log_scale_column (m : Int)
    (j : SignedLabel l.value) :
    Real.log (J.oneColumnScale m j) =
      (gaussExponent j.1).toNat * Real.log (S3134QParameter J) := by
  rw [S3134QParameter_transport (J := J) m]
  exact S3134QParameter_log_scale_ofColumn (J := J) m j

/-- The actual 1-column log readout is an integer multiple of the actual
`log q` parameter. -/
theorem S3134OneColumnLogReadout_eq_gauss_mul_q (m : Int)
    (j : SignedLabel l.value) :
    oneColumnLogReadout J m j =
      (gaussExponent j.1).toNat * Real.log (S3134QParameter J) :=
  S3134QParameter_log_scale_column (J := J) m j

/-- The actual q-parameter is one exactly when its logarithm vanishes
(`Real.log_eq_zero` plus the proved positivity of the actual q). -/
theorem S3134QParameter_log_eq_zero_iff :
    Real.log (S3134QParameter J) = 0 ↔ S3134QParameter J = 1 := by
  rw [Real.log_eq_zero]
  constructor
  · rintro (h0 | h1 | hm1)
    · have hp := S3134QParameter_pos (J := J)
      rw [h0] at hp
      linarith
    · exact h1
    · have hp := S3134QParameter_pos (J := J)
      rw [hm1] at hp
      linarith
  · intro h1
    exact Or.inr (Or.inl h1)

/-- `|log q| > 0` for the actual q-parameter exactly when the actual q is not
one. -/
theorem S3134QParameter_log_ne_zero_iff :
    Real.log (S3134QParameter J) ≠ 0 ↔ S3134QParameter J ≠ 1 := by
  constructor
  · intro h h1
    exact h ((S3134QParameter_log_eq_zero_iff (J := J)).mpr h1)
  · intro h h0
    exact h ((S3134QParameter_log_eq_zero_iff (J := J)).mp h0)

/-- The strict positivity `|log(q)| > 0` of Corollary 3.12 is equivalent, for
the actual q-parameter, to `q != 1`. -/
theorem S3134QParameter_abs_log_pos_iff :
    0 < |Real.log (S3134QParameter J)| ↔ S3134QParameter J ≠ 1 :=
  (abs_pos (a := Real.log (S3134QParameter J))).trans
    (S3134QParameter_log_ne_zero_iff (J := J))

/-- Consumer: from the named comparison gap, the actual q-parameter is not one. -/
theorem S3134QThetaComparisonGap_qParameter_ne_one
    (D : S1300HDDHullDetSource I)
    (G : S3134QThetaComparisonGap (I := I) (J := J) D) :
    S3134QParameter J ≠ 1 :=
  (S3134QParameter_log_ne_zero_iff (J := J)).mp G.q_log_ne_zero

/-- Consumer: the q-side and Theta-side readouts of the fourth triangle are
readouts of the same actual log q parameter; in particular the Theta-side
log-scale is an integer multiple of the q-side one. -/
theorem S3134QThetaScale_sameParameter (m : Int) (j : SignedLabel l.value) :
    oneColumnLogReadout J m j =
      (gaussExponent j.1).toNat * Real.log (S3134QParameter J) :=
  S3134OneColumnLogReadout_eq_gauss_mul_q (J := J) m j

#check S3134QParameter_log_scale_column
#check S3134OneColumnLogReadout_eq_gauss_mul_q
#check S3134QParameter_abs_log_pos_iff
#check S3134QThetaComparisonGap_qParameter_ne_one

end LeanFormal.IUT.XiFPaper.S3134QParameterThetaScaleActual

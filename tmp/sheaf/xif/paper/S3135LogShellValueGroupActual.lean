import tmp.sheaf.xif.paper.S3135ActualF4LogShellDegreeActual

/-!
# Card (1): the value-group log-shell faithfulness, reduced exactly

**task-11 deliverable (first card).**  The task-10 file reduced the F4 residual to the
value-group degree-faithfulness card (for all real exponents) and the scaling
normalization.  This file does two things.

## 1. The exact smaller missing

Full faithfulness `∀ x : ℝ, logDegreeAt (posRealAction (ofAdd x)) = x` is *stronger than
needed*: the F4 residual only uses the value-group realization at the point's own
log-shell exponent `ht(x)/card(SourceVolumeIndex l)`.  The exact smaller card is

`S3135PointLogShellFaithfulness`:
`∀ ABC triples, logDegreeAt (posRealAction (ofAdd (ht(x)/card))) = ht(x)/card`.

It is proved here that this pointwise card (i) is implied by the full faithfulness
card and (ii) suffices, together with the scaling normalization, for F4 at the actual
carrier.  The value-group half of the log-shell construction is IUT II, Example 1.8,
(ix) (iut2.txt:2402-2409: `I(G) ⊆ O^×μ(G)` is `p^{-1}` times the image of the
`G`-invariants of `O^×(G)`; cf. [AbsTopIII], Proposition 5.8, (ii), and
Remark 3.9.4); the actual source realization currently records degree faithfulness
only at the `q`-parameter (`SourceImageRealization.degree_of_q`).

## 2. What *is* provable from the actual `q`-faithfulness

From `degree_of_q` one gets faithfulness on the cyclic value-group subgroup generated
by `log q`: for every natural `k`,
`logDegreeAt (posRealAction (ofAdd (k·log q))) = k·log q`
(`logDegreeAt_posRealAction_nsmul_log_q`), via the monoid-homomorphism power law
`logDegreeAt_pow`.  Faithfulness at the point's height exponent is *not* implied by
this cyclic part (the height is not an integer multiple of `log q`), which is exactly
the content of the named smaller card.
-/

noncomputable section

open scoped BigOperators NNReal ENNReal
open LeanFormal.IUT
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.Theorem311Source.OriginalInput
open LeanFormal.IUT.XiFPaper.S3135F4ActualHullResidualActual
open LeanFormal.IUT.XiFPaper.S3135ActualF4LogShellDegreeActual

namespace LeanFormal.IUT.XiFPaper.S3135LogShellValueGroupActual

universe ua uv upi umon ui

variable {l : PrimeGeFive} {V : Type uv}
variable (I : OriginalInput.{ua, uv, upi, umon, ui} l V)
variable (v : V) (R : I.SourceImageRealization v) (n : ThetaPilotCarrier l)
variable (D : I.SourceUnitRegionHaarData v R n)

/-! ## 1. The exact pointwise value-group faithfulness card -/

/-- **Named card 1 (exact smaller form)**: the actual value-group realization is
degree-faithful at the source point's own log-shell exponent
`ht(x)/card(SourceVolumeIndex l)`.  This is the log-shell value-group half of
IUT II, Example 1.8, (ix) (iut2.txt:2402-2409) / [AbsTopIII], Proposition 5.8, (ii),
in the only form used by the F4 residual; it is *not* proved here (the source
realization provides only the `q`-case). -/
def S3135PointLogShellFaithfulness : Prop :=
  ∀ a b c : ℕ, IsABCTriple a b c →
    I.logDegreeAt 0 0 v
        (R.posRealAction (Multiplicative.ofAdd
          (Height.logHeight₁ (abcRationalPoint a c) / sourceVolumeIndexCard (l := l)))) =
      Height.logHeight₁ (abcRationalPoint a c) / sourceVolumeIndexCard (l := l)

/-- Full value-group faithfulness implies the pointwise card used by F4. -/
theorem s3135_pointFaithfulness_of_valueGroupFaithfulness
    (hdeg : S3135ValueGroupDegreeFaithfulness I v R) :
    S3135PointLogShellFaithfulness I v R := by
  intro a b c _
  exact hdeg _

/-! ## 2. Provable part: the cyclic log-`q` value-group faithfulness -/

/-- The log-degree of a power: `logDegreeAt (x^k) = k * logDegreeAt x`. -/
theorem logDegreeAt_pow (x : I.ValueMonoidAt 0 0 v) (k : ℕ) :
    I.logDegreeAt 0 0 v (x ^ k) = k * I.logDegreeAt 0 0 v x := by
  induction k with
  | zero => simp [I.logDegreeAt_one]
  | succ k ih =>
    rw [pow_succ, I.logDegreeAt_mul, ih]
    push_cast
    ring

/-- **Actual faithfulness on the cyclic subgroup generated by `log q`.**  From the
actual source-realization field `degree_of_q` (the `q`-normalization of
Remark 3.9.4, (iv)) one obtains, for every natural multiple `k·log q` of the
`q`-parameter log, `logDegreeAt (posRealAction (ofAdd (k·log q))) = k·log q`.
This is the provable part of the value-group half of the log-shell (IUT II, Example
1.8, (ix)); it does not give faithfulness at the point's height exponent, which is the
named card above. -/
theorem logDegreeAt_posRealAction_nsmul_log_q (k : ℕ) :
    I.logDegreeAt 0 0 v
        (R.posRealAction (Multiplicative.ofAdd
          (k * Real.log ((I.theaterAt 0 0).thetaPacket.q)))) =
      k * Real.log ((I.theaterAt 0 0).thetaPacket.q) := by
  have hL : I.logDegreeAt 0 0 v
      (R.posRealAction (Multiplicative.ofAdd
        (Real.log ((I.theaterAt 0 0).thetaPacket.q)))) =
      Real.log ((I.theaterAt 0 0).thetaPacket.q) := R.degree_of_q
  have hof : Multiplicative.ofAdd
      (k * Real.log ((I.theaterAt 0 0).thetaPacket.q)) =
      (Multiplicative.ofAdd
        (Real.log ((I.theaterAt 0 0).thetaPacket.q))) ^ k := by
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Nat.cast_succ, add_mul, one_mul, pow_succ, ← ih]
      rfl
  rw [hof, map_pow, logDegreeAt_pow, hL]

/-! ## 3. The F4 reduction with the smaller card -/

/-- A single-exponent version of `sourceLocalLogDegree_constant`: if the value-group
realization is degree-faithful at one real exponent `a`, then the constant point at
`a` has total log-degree `card * a`. -/
theorem sourceLocalLogDegree_constant_of_value (a : ℝ)
    (hdeg : I.logDegreeAt 0 0 v (R.posRealAction (Multiplicative.ofAdd a)) = a) :
    I.sourceLocalLogDegree v
        (I.constantThetaPilotPoint v R (Multiplicative.ofAdd a)) =
      sourceVolumeIndexCard (l := l) * a := by
  unfold sourceLocalLogDegree sourceVolumeIndexCard
  simp only [I.constantThetaPilotPoint_apply]
  rw [Finset.sum_congr rfl (fun i (_ : i ∈ Finset.univ) => hdeg)]
  rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

/-- The actual log-degree computation for the constructed point, from the pointwise
faithfulness card: the total log-degree is the height `ht(x)`. -/
theorem sourceLocalLogDegree_abcSourcePoint_of_pointFaithfulness
    (hpt : S3135PointLogShellFaithfulness I v R) {a b c : ℕ}
    (habc : IsABCTriple a b c) :
    I.sourceLocalLogDegree v (abcSourcePoint I v R a b c) =
      Height.logHeight₁ (abcRationalPoint a c) := by
  unfold abcSourcePoint
  rw [sourceLocalLogDegree_constant_of_value I v R _ (hpt a b c habc)]
  unfold sourceVolumeIndexCard
  have hcN : (Fintype.card (SourceVolumeIndex l) : ℝ) ≠ 0 := by
    exact_mod_cast ne_of_gt (sourceVolumeIndex_card_pos l)
  field_simp

/-- **The F4 residual for the constructed point follows from the pointwise card and
the scaling normalization.** -/
theorem s3135_degreeResidual_of_pointFaithfulness
    (hpt : S3135PointLogShellFaithfulness I v R) (eps : ℝ) :
    S3135ScalingNormalization I v R n D eps →
      S3135ActualF4DegreeResidual I v R n D (abcSourcePoint I v R) eps := by
  intro hnorm a b c habc
  have hnorm' := hnorm a b c habc
  rw [I.sourceLocalLogDegree_mul,
    sourceLocalLogDegree_abcSourcePoint_of_pointFaithfulness I v R hpt habc]
  linarith

/-- **F4 at the actual carrier from the pointwise value-group card and the scaling
normalization card** (both for every `eps > 0`). -/
theorem s3135_actualF4_of_pointFaithfulness
    (hpt : S3135PointLogShellFaithfulness I v R)
    (hnorm : ∀ eps : ℝ, 0 < eps → S3135ScalingNormalization I v R n D eps) :
    FrontierHeightComparisonClause (sourceActualCarrier I v R n D)
      (fun _ _ a b c => abcSourcePoint I v R a b c) :=
  s3135_actualF4_of_degreeResidual I v R n D (abcSourcePoint I v R)
    (fun eps heps =>
      s3135_degreeResidual_of_pointFaithfulness I v R n D hpt eps (hnorm eps heps))

#check S3135PointLogShellFaithfulness
#check logDegreeAt_posRealAction_nsmul_log_q
#check s3135_degreeResidual_of_pointFaithfulness
#check s3135_actualF4_of_pointFaithfulness

end LeanFormal.IUT.XiFPaper.S3135LogShellValueGroupActual
end

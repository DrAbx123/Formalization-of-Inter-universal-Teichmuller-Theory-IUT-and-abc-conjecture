import tmp.sheaf.xif.paper.GlobalThetaPilotLogVolumeActual
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Tactic

/-!
# Mzk1Route1OrbitLatticeActual

Source-level orbit lattice for Route 1 (task-78 / HANDOFF 4.2-4.8).

The actual native bad-place Theta-pilot images are the log-value vectors
b |-> log(q_b^(j^2)) = j^2 * log q_b.  At the native input T the common
vector is baseQLogMagnitude T b (the actual base q log-magnitude), and every
signed-label image is an integer multiple of it.  This file constructs that
actual image family, its base lattice and its orbit lattice, and proves:

* every image is a common-scalar multiple of one vector (A8 hypothesis);
* the orbit lattice equals the base lattice (no index growth in the scalar m);
* the orbit lattice is contained in a rank-one lattice (not full rank for d>1).

It does NOT assert that these images lie in the paper locked U_theta / C3
tensor block.  That transport is the exact missing A-Source input
(BadToC3TensorMap / GlobalThetaPilotPlaceMapData), recorded separately by
the read-only GlobalThetaPilot* sources.  No toy/True/PUnit/axiom/sorry.
-/

noncomputable section

namespace LeanFormal.IUT.XiFPaper.Mzk1Route1OrbitLatticeActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.XiFPaper.GlobalThetaPilotLogVolumeActual
open LeanFormal.IUT.XiFPaper.SignedAverageBoundActual
open LeanFormal.IUT.XiFPaper.BaseQLogVolumeActual
open LeanFormal.IUT.XiFPaper.GlobalQPilotProcessionLogVolumeActual

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

universe u

variable {l : PrimeGeFive}
variable (T : SourceNativeInitialThetaData.{0} l)
variable [Fintype (Bad (nativePlaceSelection T))]

/-- The actual common q-log vector at the native bad places. -/
noncomputable def route1QLog (T : SourceNativeInitialThetaData.{0} l) :
    (Bad (nativePlaceSelection T) -> Real) :=
  fun b => baseQLogMagnitude T b

/-- The q-log vector with a formal common q-order multiplier m. -/
noncomputable def route1ScaledQLog (m : Nat) :
    (Bad (nativePlaceSelection T) -> Real) :=
  fun b => (m : Real) * route1QLog T b

/-- The actual Theta-pilot image at signed label j: j^2 times the common
q-log vector.  This is the native base-q version of
globalThetaPilotCandidate / globalThetaPilotPossibleImage. -/
noncomputable def route1Image (m : Nat) (j : SignedLabel l.value) :
    (Bad (nativePlaceSelection T) -> Real) :=
  fun b => (gaussExponent j.1).toNat * route1ScaledQLog T m b

/-- The actual possible-image set of Route 1 at q-order multiplier m. -/
noncomputable def route1ImageSet (m : Nat) :
    Set (Bad (nativePlaceSelection T) -> Real) :=
  Set.range (route1Image T m)

/-- The base lattice generated by the common q-log vector. -/
noncomputable def route1BaseLattice (m : Nat) :
    AddSubgroup (Bad (nativePlaceSelection T) -> Real) :=
  AddSubgroup.closure ({route1ScaledQLog T m} : Set (Bad (nativePlaceSelection T) -> Real))

/-- The Route 1 orbit lattice generated by the actual possible images. -/
noncomputable def route1OrbitLattice (m : Nat) :
    AddSubgroup (Bad (nativePlaceSelection T) -> Real) :=
  AddSubgroup.closure (route1ImageSet T m)

/-- The signed label 1 exists for every l >= 5. -/
def route1OneLabel : SignedLabel l.value :=
  Subtype.mk 1 (by
    have h5 : 5 <= l.value := l.ge_five
    have hstar : 1 <= lStar l.value := by
      unfold lStar
      omega
    constructor
    · have hstarZ : (1 : Int) <= (lStar l.value : Int) := by exact_mod_cast hstar
      omega
    · exact_mod_cast hstar)

/-- The j = 1 image is the common q-log vector. -/
theorem route1Image_one (m : Nat) :
    route1Image T m (route1OneLabel (l := l)) = route1ScaledQLog T m := by
  funext b
  simp [route1Image, route1ScaledQLog, route1OneLabel, gaussExponent]

/-- Every image is an integer multiple of the common q-log vector. -/
theorem route1Image_eq_nsmul (m : Nat) (j : SignedLabel l.value) :
    route1Image T m j = (gaussExponent j.1).toNat • route1ScaledQLog T m := by
  funext b
  simp [route1Image, route1ScaledQLog, nsmul_eq_mul, mul_assoc]

/-- The common q-log vector is in its base lattice. -/
theorem route1ScaledQLog_mem_base (m : Nat) :
    route1ScaledQLog T m ∈ route1BaseLattice T m :=
  AddSubgroup.subset_closure (by simp)

/-- Every actual possible image is in the base lattice. -/
theorem route1Image_mem_base (m : Nat) (j : SignedLabel l.value) :
    route1Image T m j ∈ route1BaseLattice T m := by
  rw [route1Image_eq_nsmul]
  exact AddSubgroup.nsmul_mem (route1BaseLattice T m) (route1ScaledQLog_mem_base T m) _

/-- The base lattice is contained in the orbit lattice. -/
theorem route1Base_le_orbit (m : Nat) :
    route1BaseLattice T m <= route1OrbitLattice T m := by
  rw [route1BaseLattice, AddSubgroup.closure_le]
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst x
  change route1ScaledQLog T m ∈ route1OrbitLattice T m
  rw [show route1ScaledQLog T m = route1Image T m (route1OneLabel (l := l)) from (route1Image_one T m).symm]
  exact AddSubgroup.subset_closure (Set.mem_range.mpr (Exists.intro (route1OneLabel (l := l)) rfl))

/-- The orbit lattice is contained in the base lattice. -/
theorem route1Orbit_le_base (m : Nat) :
    route1OrbitLattice T m <= route1BaseLattice T m := by
  rw [route1OrbitLattice, AddSubgroup.closure_le]
  rintro x ⟨j, rfl⟩
  exact route1Image_mem_base T m j

/-- The orbit lattice equals the base lattice: adding all label images does not
enlarge the common q-log lattice. -/
theorem route1OrbitLattice_eq_base (m : Nat) :
    route1OrbitLattice T m = route1BaseLattice T m :=
  le_antisymm (route1Orbit_le_base T m) (route1Base_le_orbit T m)

/-- The actual image family is contained in a rank-one lattice (the orbit
lattice is generated by the single common vector). -/
theorem route1OrbitLattice_rank_le_one (m : Nat) :
    Exists (fun g : (Bad (nativePlaceSelection T) -> Real) =>
      route1OrbitLattice T m <= AddSubgroup.closure ({g} : Set (Bad (nativePlaceSelection T) -> Real))) :=
  Exists.intro (route1ScaledQLog T m) (by rw [route1OrbitLattice_eq_base]; exact le_rfl)

/-- The actual image set is finite. -/
theorem route1ImageSet_finite (m : Nat) :
    (route1ImageSet T m).Finite :=
  Set.finite_range _

/-- The Route 1 orbit lattice has no m-dependent quotient relative to the base:
the two lattices are equal for every common scalar m. -/
theorem route1_quotient_trivial (m : Nat) :
    route1OrbitLattice T m = route1BaseLattice T m :=
  route1OrbitLattice_eq_base T m

/-- The global Theta-pilot procession log-volume is already the common scalar
(gaussExponentSum / card) * globalQPilotLogMagnitude, i.e. a fixed multiple of
the q-pilot magnitude (duplication check for Route 1). -/
theorem route1_globalThetaPilotLogVolume_eq :
    globalThetaPilotLogVolume T =
      ((gaussExponentSum (l := l) : Real) /
        (Fintype.card (SignedLabel l.value) : Real)) *
        globalQPilotLogMagnitude T :=
  globalThetaPilotLogVolume_eq T

#check route1QLog
#check route1ScaledQLog
#check route1Image
#check route1ImageSet
#check route1BaseLattice
#check route1OrbitLattice
#check route1OneLabel
#check route1Image_one
#check route1Image_eq_nsmul
#check route1OrbitLattice_eq_base
#check route1OrbitLattice_rank_le_one
#check route1ImageSet_finite
#check route1_quotient_trivial
#check route1_globalThetaPilotLogVolume_eq

end LeanFormal.IUT.XiFPaper.Mzk1Route1OrbitLatticeActual

end

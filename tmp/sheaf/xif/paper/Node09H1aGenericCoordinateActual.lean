/- Generic idempotent coordinate decomposition for integralRing-submodules
and DVR principal-ideal powers.  Independent of the H1a/H1b volume files. -/
import tmp.sheaf.xif.paper.Mzk1P5GammaSubsetHullActual
import LeanFormal.IUT.Foundations.LocalFields.IntegralUnits
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.Tactic

noncomputable section
namespace LeanFormal.IUT.XiFPaper.Node09H1aGenericCoordinateActual

open LeanFormal.IUT.LocalFieldProductHull
open LeanFormal.IUT.LocalFieldIntegralUnits
open scoped BigOperators

variable {J : Type*} [Fintype J] [DecidableEq J] {E : J → Type*}
variable [∀ j, NormedField (E j)] [∀ j, IsUltrametricDist (E j)]
variable (hna : ∀ j, IsNonarchimedean (Norm.norm : E j → ℝ))

local notation "O" => integralRing hna

/-- The idempotent coordinate scalar at coordinate j with value a. -/
noncomputable def singleO (j : J) (a : Integers (E j)) : O :=
  ⟨fun k => if h : k = j then (h ▸ (a : E j)) else 0, by
    have ha : ‖(a : E j)‖ ≤ 1 := (mem_integers_iff (a : E j)).mp a.property
    intro k
    by_cases hk : k = j
    · subst hk
      simpa using ha
    · simp [hk]⟩

theorem singleO_apply (j k : J) (a : Integers (E j)) :
    (singleO hna j a : (k : J) → E k) k =
      if h : k = j then (h ▸ (a : E j)) else 0 := rfl

theorem singleO_smul_apply (j : J) (a : Integers (E j))
    (x : (k : J) → E k) (k : J) :
    ((singleO hna j a) • x) k =
      if h : k = j then (h ▸ (a : E j)) * x k else 0 := by
  rw [Subring.smul_def]
  change (singleO hna j a : (k : J) → E k) k * x k = _
  rw [singleO_apply]
  by_cases hk : k = j
  · subst hk; simp
  · simp [hk]

/-- The j-th coordinate submodule of an O-submodule. -/
noncomputable def coordSubmodule (M : Submodule O ((j : J) → E j)) (j : J) :
    Submodule (Integers (E j)) (E j) where
  carrier := {y | ∃ x ∈ M, x j = y}
  zero_mem' := ⟨0, M.zero_mem, rfl⟩
  add_mem' := by
    rintro _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
    exact ⟨x + y, M.add_mem hx hy, rfl⟩
  smul_mem' := by
    rintro a y ⟨x, hx, rfl⟩
    refine ⟨(singleO hna j a) • x, M.smul_mem (singleO hna j a) hx, ?_⟩
    rw [singleO_smul_apply]
    simp only [dif_pos rfl]
    rw [Algebra.smul_def]
    rfl

/-- An O-submodule of a product is the product of its coordinate projections. -/
theorem submodule_eq_pi_coord (M : Submodule O ((j : J) → E j)) :
    (M : Set ((j : J) → E j)) =
      Set.pi Set.univ (fun j => (coordSubmodule hna M j : Set (E j))) := by
  ext x
  constructor
  · intro hx j _
    exact ⟨x, hx, rfl⟩
  · intro hx
    have hx' : ∀ j, ∃ z : ((k : J) → E k), z ∈ M ∧ z j = x j :=
      fun j => hx j (Set.mem_univ j)
    choose y hy using hx'
    let s : J → ((k : J) → E k) :=
      fun j => (singleO hna j (1 : Integers (E j))) • (y j)
    have hmem : ∀ j, s j ∈ M := fun j => M.smul_mem _ (hy j).1
    have hsum : (∑ j, s j) ∈ M :=
      Submodule.sum_mem M (fun j _ => hmem j)
    have hx_eq : x = ∑ j, s j := by
      funext k
      rw [Finset.sum_apply]
      rw [Finset.sum_eq_single k]
      · dsimp [s]
        rw [singleO_smul_apply]
        simp only [dif_pos rfl]
        simpa using (hy k).2.symm
      · intro j _ hjk
        dsimp [s]
        rw [singleO_smul_apply]
        rw [dif_neg (fun h : k = j => hjk h.symm)]
      · intro hk
        exact (hk (Finset.mem_univ k)).elim
    rw [hx_eq]
    exact hsum

/-! ## Generic DVR principal ideal powers -/

section DVR

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- A chosen uniformizer of a DVR. -/
noncomputable def dvrUniformizer : R :=
  Classical.choose (IsDiscreteValuationRing.exists_irreducible R)

theorem dvrUniformizer_irreducible : Irreducible (dvrUniformizer (R := R)) :=
  Classical.choose_spec (IsDiscreteValuationRing.exists_irreducible R)

/-- The DVR maximal ideal is the principal ideal generated by the uniformizer. -/
theorem maximalIdeal_eq_span_uniformizer :
    IsLocalRing.maximalIdeal R = Ideal.span {dvrUniformizer (R := R)} :=
  (dvrUniformizer_irreducible (R := R)).maximalIdeal_eq

/-- Powers of the DVR maximal ideal are principal, generated by powers of the
uniformizer. -/
theorem maximalIdeal_pow_eq_span_uniformizer_pow (n : Nat) :
    IsLocalRing.maximalIdeal R ^ n =
      Ideal.span {(dvrUniformizer (R := R)) ^ n} := by
  rw [maximalIdeal_eq_span_uniformizer, Ideal.span_singleton_pow]

end DVR

#check submodule_eq_pi_coord
#check maximalIdeal_pow_eq_span_uniformizer_pow

end LeanFormal.IUT.XiFPaper.Node09H1aGenericCoordinateActual
end

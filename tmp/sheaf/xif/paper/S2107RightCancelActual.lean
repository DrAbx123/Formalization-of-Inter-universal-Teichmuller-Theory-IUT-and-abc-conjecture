namespace LeanFormal.IUT.XiFPaper.S2107RightCancelActual

open CategoryTheory
open CategoryTheory.Bicategory
open scoped Pseudofunctor.StrongTrans
open Iut
open LeanFormal.IUT
open LeanFormal.IUT.XiFPaper.S1726OrbicurveFPrimeActual
open LeanFormal.IUT.XiFPaper.S1827CloseRetractionActual
open LeanFormal.IUT.XiFPaper.S2058D6FiniteEtaleActual
open LeanFormal.IUT.XiFPaper.S2097BaseChangeButterflyActual

universe u

/-! ## 1. The target -/

/-- S2107's target: definitionally S2097's reverse-pasting statement. -/
abbrev S2107RightCancelStatement : Type 1 := S2097RightCancelStatement

/-- The target is literally S2097's statement. -/
theorem S2107RightCancelStatement_def :
    S2107RightCancelStatement = S2097RightCancelStatement := rfl

/-! ## 2. The lower square's `twoCell_ext` is automatic -/

section TwoCellExt

variable (D : S2058Pasting (F := S1726K))

/-- **The `twoCell_ext` field of the lower square is automatic.**  The pasted
square's second leg is `D.toY1 ; D.toY2`; right whiskering the lower
square's `twoCell_ext` hypothesis by `D.toY2` gives the pasted square's
hypothesis, and `wP.twoCell_ext` cancels.  No full-property assumption on
`D.square2` is used. -/
theorem S2107Sq1TwoCellExt (wP : D.squareP.TwoPullbackWitness)
    {W : EtaleStackPseudofunctor S1726K}
    {first second : Pseudofunctor.StrongTrans W D.P} (alpha beta : first ⟶ second)
    (h1 : Pseudofunctor.StrongTrans.whiskerRight alpha D.toX1 =
      Pseudofunctor.StrongTrans.whiskerRight beta D.toX1)
    (h2 : Pseudofunctor.StrongTrans.whiskerRight alpha D.toY1 =
      Pseudofunctor.StrongTrans.whiskerRight beta D.toY1) : alpha = beta := by
  refine wP.twoCell_ext W alpha beta h1 ?_
  have h2' : Bicategory.whiskerRight alpha D.toY1 =
      Bicategory.whiskerRight beta D.toY1 := h2
  change Bicategory.whiskerRight alpha (D.toY1 ≫ D.toY2) =
    Bicategory.whiskerRight beta (D.toY1 ≫ D.toY2)
  rw [Bicategory.whiskerRight_comp, Bicategory.whiskerRight_comp, h2']

end TwoCellExt

/-! ## 3. The lift and the two comparisons are automatic

The construction only uses the pasted square's witness for the lift and the
first two comparisons, and the upper square's essential surjectivity for the
comparison with `D.toY1`.  Hence `lift`, `liftToX`, `liftToY` (and, by
§2, `twoCell_ext`) are not part of the missing content. -/

section Automatic

variable (D : S2058Pasting (F := S1726K))

/-- The cone over the pasted square induced by a cone `c` over the lower
square: legs `c.toX` and `c.toY ; D.toY2`, with commutes built from
`c.commutes` and `D.c2`. -/
noncomputable def S2107ExtCone {W : EtaleStackPseudofunctor S1726K}
    (c : D.square1.Cone W) : D.squareP.Cone W where
  toX := c.toX
  toY := Pseudofunctor.StrongTrans.vcomp c.toY D.toY2
  commutes :=
    (S2058AssociatorIso c.toX D.x1 D.x2).symm.trans
      ((S2058WhiskerRightIso (Pseudofunctor.StrongTrans.vcomp c.toX D.x1)
          (Pseudofunctor.StrongTrans.vcomp c.toY D.xi) D.x2 c.commutes).trans
        ((S2058AssociatorIso c.toY D.xi D.x2).trans
          ((S2058WhiskerLeftIso c.toY
              (Pseudofunctor.StrongTrans.vcomp D.xi D.x2)
              (Pseudofunctor.StrongTrans.vcomp D.toY2 D.y2) D.c2).trans
            (S2058AssociatorIso c.toY D.toY2 D.y2).symm)))

/-- The canonical lift of a cone over the lower square. -/
noncomputable def S2107ExtLift (wP : D.squareP.TwoPullbackWitness)
    {W : EtaleStackPseudofunctor S1726K} (c : D.square1.Cone W) :
    Pseudofunctor.StrongTrans W D.P :=
  wP.lift W (S2107ExtCone D c)

/-- The canonical lift's comparison with the first leg. -/
noncomputable def S2107ExtLiftToX (wP : D.squareP.TwoPullbackWitness)
    {W : EtaleStackPseudofunctor S1726K} (c : D.square1.Cone W) :
    Iso (Pseudofunctor.StrongTrans.vcomp (S2107ExtLift D wP c) D.square1.toX) c.toX :=
  wP.liftToX W (S2107ExtCone D c)

/-- The canonical lift's comparison with the pasted second leg. -/
noncomputable def S2107ExtLiftToY2 (wP : D.squareP.TwoPullbackWitness)
    {W : EtaleStackPseudofunctor S1726K} (c : D.square1.Cone W) :
    Iso (Pseudofunctor.StrongTrans.vcomp (S2107ExtLift D wP c)
      (Pseudofunctor.StrongTrans.vcomp D.toY1 D.toY2))
      (Pseudofunctor.StrongTrans.vcomp c.toY D.toY2) :=
  wP.liftToY W (S2107ExtCone D c)

/-- The cone over the upper square generated by `c.toY`. -/
noncomputable def S2107Sq2ConeOf {W : EtaleStackPseudofunctor S1726K}
    (c : D.square1.Cone W) : D.square2.Cone W where
  toX := Pseudofunctor.StrongTrans.vcomp c.toY D.xi
  toY := Pseudofunctor.StrongTrans.vcomp c.toY D.toY2
  commutes :=
    (S2058AssociatorIso c.toY D.xi D.x2).trans
      ((S2058WhiskerLeftIso c.toY
          (Pseudofunctor.StrongTrans.vcomp D.xi D.x2)
          (Pseudofunctor.StrongTrans.vcomp D.toY2 D.y2) D.c2).trans
        (S2058AssociatorIso c.toY D.toY2 D.y2).symm)

/-- The first comparison isomorphism fed to the upper square's essential
surjectivity: `(l ; D.toY1) ; D.xi ≅ c.toY ; D.xi`. -/
noncomputable def S2107LiftToYIsoX (wP : D.squareP.TwoPullbackWitness)
    {W : EtaleStackPseudofunctor S1726K} (c : D.square1.Cone W) :
    Iso (Pseudofunctor.StrongTrans.vcomp
        (Pseudofunctor.StrongTrans.vcomp (S2107ExtLift D wP c) D.toY1) D.xi)
      (Pseudofunctor.StrongTrans.vcomp c.toY D.xi) :=
  (S2058AssociatorIso (S2107ExtLift D wP c) D.toY1 D.xi).trans
    ((S2058WhiskerLeftIso (S2107ExtLift D wP c)
        (Pseudofunctor.StrongTrans.vcomp D.toX1 D.x1)
        (Pseudofunctor.StrongTrans.vcomp D.toY1 D.xi) D.c1).symm.trans
      ((S2058AssociatorIso (S2107ExtLift D wP c) D.toX1 D.x1).symm.trans
        ((S2058WhiskerRightIso
            (Pseudofunctor.StrongTrans.vcomp (S2107ExtLift D wP c) D.toX1)
            c.toX D.x1 (S2107ExtLiftToX D wP c)).trans c.commutes)))

/-- The second comparison isomorphism fed to the upper square's essential
surjectivity: `(l ; D.toY1) ; D.toY2 ≅ c.toY ; D.toY2`. -/
noncomputable def S2107LiftToYIsoY (wP : D.squareP.TwoPullbackWitness)
    {W : EtaleStackPseudofunctor S1726K} (c : D.square1.Cone W) :
    Iso (Pseudofunctor.StrongTrans.vcomp
        (Pseudofunctor.StrongTrans.vcomp (S2107ExtLift D wP c) D.toY1) D.toY2)
      (Pseudofunctor.StrongTrans.vcomp c.toY D.toY2) :=
  (S2058AssociatorIso (S2107ExtLift D wP c) D.toY1 D.toY2).trans
    (S2107ExtLiftToY2 D wP c)

/-- **The comparison with the second leg is automatic**: both
`l ; D.toY1` and `c.toY` have isomorphic composites with `D.xi` and
`D.toY2`, so `S1827EssSurjOf D.square2 w2` gives an isomorphism between
them. -/
noncomputable def S2107ExtLiftToY (w2 : D.square2.TwoPullbackWitness)
    (h2 : S1827EssSurjOf D.square2 w2) (wP : D.squareP.TwoPullbackWitness)
    {W : EtaleStackPseudofunctor S1726K} (c : D.square1.Cone W) :
    Iso (Pseudofunctor.StrongTrans.vcomp (S2107ExtLift D wP c) D.square1.toY) c.toY :=
  (Classical.choice
    (h2 W (S2107Sq2ConeOf D c)
      (Pseudofunctor.StrongTrans.vcomp (S2107ExtLift D wP c) D.toY1)
      ⟨S2107LiftToYIsoX D wP c⟩ ⟨S2107LiftToYIsoY D wP c⟩)).trans
    (Classical.choice
      (h2 W (S2107Sq2ConeOf D c) c.toY ⟨Iso.refl _⟩ ⟨Iso.refl _⟩)).symm

end Automatic

/-! ## 4. The exact remaining datum: the 2-cell action on the canonical lift -/

/-- **The remaining datum on the canonical lift.**  Relative to the canonical
lift `S2107ExtLift` (whose two comparisons are automatic by §3), this is the
action on cone morphisms with its two projection equations.  It is a precise
sufficient form of the first missing datum: `S2107WitnessOfCanonicalTwoCell`
turns it into the full lower-square witness. -/
structure S2107CanonicalLiftTwoCell (D : S2058Pasting (F := S1726K))
    (w2 : D.square2.TwoPullbackWitness) (h2 : S1827EssSurjOf D.square2 w2)
    (wP : D.squareP.TwoPullbackWitness) : Type 1 where
  /-- Action on cone morphisms of the lower square. -/
  liftTwoCell : ∀ (W : EtaleStackPseudofunctor S1726K)
    (s t : D.square1.Cone W), D.square1.ConeMorphism s t →
      (S2107ExtLift D wP s ⟶ S2107ExtLift D wP t)
  /-- First projection equation. -/
  liftTwoCell_toX : ∀ (W : EtaleStackPseudofunctor S1726K)
    (s t : D.square1.Cone W) (m : D.square1.ConeMorphism s t),
    Pseudofunctor.StrongTrans.whiskerRight (liftTwoCell W s t m) D.square1.toX =
      (S2107ExtLiftToX D wP s).hom ≫ m.toX ≫ (S2107ExtLiftToX D wP t).inv
  /-- Second projection equation. -/
  liftTwoCell_toY : ∀ (W : EtaleStackPseudofunctor S1726K)
    (s t : D.square1.Cone W) (m : D.square1.ConeMorphism s t),
    Pseudofunctor.StrongTrans.whiskerRight (liftTwoCell W s t m) D.square1.toY =
      (S2107ExtLiftToY D w2 h2 wP s).hom ≫ m.toY ≫
        (S2107ExtLiftToY D w2 h2 wP t).inv

/-- **The target follows from the canonical 2-cell action.**  All the other
witness fields are discharged by §2 and §3. -/
noncomputable def S2107WitnessOfCanonicalTwoCell
    (D : S2058Pasting (F := S1726K))
    (w2 : D.square2.TwoPullbackWitness) (h2 : S1827EssSurjOf D.square2 w2)
    (wP : D.squareP.TwoPullbackWitness)
    (r : S2107CanonicalLiftTwoCell D w2 h2 wP) :
    D.square1.TwoPullbackWitness where
  lift := fun W c => S2107ExtLift D wP c
  liftToX := fun W c => S2107ExtLiftToX D wP c
  liftToY := fun W c => S2107ExtLiftToY D w2 h2 wP c
  liftTwoCell := r.liftTwoCell
  liftTwoCell_toX := r.liftTwoCell_toX
  liftTwoCell_toY := r.liftTwoCell_toY
  twoCell_ext := fun W first second alpha beta h1 h2 =>
    S2107Sq1TwoCellExt D wP alpha beta h1 h2

/-- **Reduction of the target to the canonical 2-cell action.** -/
noncomputable def S2107RightCancelStatement_of_canonicalTwoCell
    (h : ∀ (D : S2058Pasting (F := S1726K))
      (w2 : D.square2.TwoPullbackWitness) (h2 : S1827EssSurjOf D.square2 w2)
      (wP : D.squareP.TwoPullbackWitness), S1827EssSurjOf D.squareP wP →
      Nonempty (S2107CanonicalLiftTwoCell D w2 h2 wP)) :
    S2107RightCancelStatement := by
  intro D w2 h2 wP hP
  exact S2107WitnessOfCanonicalTwoCell D w2 h2 wP
    (Classical.choice (h D w2 h2 wP hP))

/-! ## 5. The positive fields, and the exact reduction of the target -/

/-- The four positive fields of a witness for the lower square, without
`twoCell_ext`.  By the two reductions below this is *exactly* the content of
`S2107RightCancelStatement`: `twoCell_ext` is supplied unconditionally by
`S2107Sq1TwoCellExt` from the pasted square's witness. -/
structure S2107Sq1PositiveFields (D : S2058Pasting (F := S1726K)) : Type 1 where
  /-- The lift of a cone over the lower square. -/
  lift : ∀ (W : EtaleStackPseudofunctor S1726K), D.square1.Cone W →
    Pseudofunctor.StrongTrans W D.P
  /-- The comparison with the first leg. -/
  liftToX : ∀ (W : EtaleStackPseudofunctor S1726K) (c : D.square1.Cone W),
    Iso (Pseudofunctor.StrongTrans.vcomp (lift W c) D.square1.toX) c.toX
  /-- The comparison with the second leg. -/
  liftToY : ∀ (W : EtaleStackPseudofunctor S1726K) (c : D.square1.Cone W),
    Iso (Pseudofunctor.StrongTrans.vcomp (lift W c) D.square1.toY) c.toY
  /-- The action on cone morphisms. -/
  liftTwoCell : ∀ (W : EtaleStackPseudofunctor S1726K)
    (s t : D.square1.Cone W), D.square1.ConeMorphism s t → (lift W s ⟶ lift W t)
  /-- First projection equation of the action on cone morphisms. -/
  liftTwoCell_toX : ∀ (W : EtaleStackPseudofunctor S1726K)
    (s t : D.square1.Cone W) (m : D.square1.ConeMorphism s t),
    Pseudofunctor.StrongTrans.whiskerRight (liftTwoCell W s t m) D.square1.toX =
      (liftToX W s).hom ≫ m.toX ≫ (liftToX W t).inv
  /-- Second projection equation of the action on cone morphisms. -/
  liftTwoCell_toY : ∀ (W : EtaleStackPseudofunctor S1726K)
    (s t : D.square1.Cone W) (m : D.square1.ConeMorphism s t),
    Pseudofunctor.StrongTrans.whiskerRight (liftTwoCell W s t m) D.square1.toY =
      (liftToY W s).hom ≫ m.toY ≫ (liftToY W t).inv

/-- A full witness for the lower square is exactly the positive fields plus
`twoCell_ext`, and the latter is automatic from the pasted witness. -/
noncomputable def S2107WitnessOfPositiveFields (D : S2058Pasting (F := S1726K))
    (wP : D.squareP.TwoPullbackWitness)
    (p : S2107Sq1PositiveFields D) : D.square1.TwoPullbackWitness where
  lift := p.lift
  liftToX := p.liftToX
  liftToY := p.liftToY
  liftTwoCell := p.liftTwoCell
  liftTwoCell_toX := p.liftTwoCell_toX
  liftTwoCell_toY := p.liftTwoCell_toY
  twoCell_ext := fun W first second alpha beta h1 h2 =>
    S2107Sq1TwoCellExt D wP alpha beta h1 h2

/-- **Exact reduction, forward**: the target gives the positive fields. -/
theorem S2107RightCancelStatement_to_positiveFields
    (h : S2107RightCancelStatement) (D : S2058Pasting (F := S1726K))
    (w2 : D.square2.TwoPullbackWitness) (h2 : S1827EssSurjOf D.square2 w2)
    (wP : D.squareP.TwoPullbackWitness) (hP : S1827EssSurjOf D.squareP wP) :
    Nonempty (S2107Sq1PositiveFields D) := by
  let w := h D w2 h2 wP hP
  exact ⟨{ lift := w.lift
           liftToX := w.liftToX
           liftToY := w.liftToY
           liftTwoCell := w.liftTwoCell
           liftTwoCell_toX := w.liftTwoCell_toX
           liftTwoCell_toY := w.liftTwoCell_toY }⟩

/-- **Exact reduction, backward**: the positive fields for every pasting datum
give the target. -/
noncomputable def S2107RightCancelStatement_of_positiveFields
    (h : ∀ (D : S2058Pasting (F := S1726K))
      (w2 : D.square2.TwoPullbackWitness),
      S1827EssSurjOf D.square2 w2 →
      ∀ (wP : D.squareP.TwoPullbackWitness),
        S1827EssSurjOf D.squareP wP →
        Nonempty (S2107Sq1PositiveFields D)) :
    S2107RightCancelStatement := by
  intro D w2 h2 wP hP
  let p := Classical.choice (h D w2 h2 wP hP)
  exact S2107WitnessOfPositiveFields D wP p

/-! ## 6. The isolated missing datum, stated precisely

The following is the S1801 `TwoCellSurjTo`-shaped datum for the upper square:
it is the fullness of the cone comparison, and it is *not* among the recorded
`TwoPullbackWitness` fields (S1801) nor implied by the weak witness plus
`S1827EssSurjOf`.  It is what the missing `liftTwoCell` compatibility in the
construction above needs.  It is stated here for reference and is **not**
assumed, produced, or used to close any target. -/

/-- The image cone of a 1-cell `u` over a square `sq`: the cone whose legs are
the two projections of `u` and whose commutes cell is `u` whiskered with
`sq.commutes` (up to the associators inherent in the cone type). -/
noncomputable def S2107ImageCone {P X Y Z : EtaleStackPseudofunctor S1726K}
    (sq : EtalePseudofunctorSquare P X Y Z) {W : EtaleStackPseudofunctor S1726K}
    (u : Pseudofunctor.StrongTrans W P) : sq.Cone W where
  toX := Pseudofunctor.StrongTrans.vcomp u sq.toX
  toY := Pseudofunctor.StrongTrans.vcomp u sq.toY
  commutes :=
    (S2058AssociatorIso u sq.toX sq.xToBase).trans
      ((S2058WhiskerLeftIso u (Pseudofunctor.StrongTrans.vcomp sq.toX sq.xToBase)
        (Pseudofunctor.StrongTrans.vcomp sq.toY sq.yToBase) sq.commutes).trans
        (S2058AssociatorIso u sq.toY sq.yToBase).symm)

/-- **The precise first-missing datum** (2-cell surjectivity / fullness of the
cone comparison): every cone morphism between the image cones of two 1-cells is
realised by a 2-cell with exactly the prescribed projections.  This is the
"correct condition" isolated by S1801 and the twist-compatibility missing for
the actual butterfly in S2099/S2104. -/
def S2107ConeComparisonFull {P X Y Z : EtaleStackPseudofunctor S1726K}
    (sq : EtalePseudofunctorSquare P X Y Z) : Prop :=
  ∀ (W : EtaleStackPseudofunctor S1726K)
    (u v : Pseudofunctor.StrongTrans W P)
    (m : sq.ConeMorphism (S2107ImageCone sq u) (S2107ImageCone sq v)),
    ∃ σ : u ⟶ v,
      Pseudofunctor.StrongTrans.whiskerRight σ sq.toX = m.toX ∧
        Pseudofunctor.StrongTrans.whiskerRight σ sq.toY = m.toY

/-! ## 7. Checks -/

#check S2107RightCancelStatement
#check @S2107Sq1TwoCellExt
#check @S2107ExtCone

import tmp.sheaf.xif.paper.S3037cBottomNotCoveringConcrete
import tmp.sheaf.xif.paper.S2976bA6QDescentGluing
import Mathlib.AlgebraicGeometry.Sites.Etale
/-!
# S3042: restricted Q effective descent on the nonempty site

## Status: the stated target is FALSE (with the current definitions).

The target of this package was

  theorem S3042QEffectiveDescent : S3037QEffectiveDescent

i.e. for every U : S3026NonemptyScheme and every sieve
R in S3026NonemptySite U, the restricted functor
S3026Q.toDescentData (fun f : R.arrows.category => f.obj.hom) is essentially
surjective.

A literal port of S2976bA6QDescentGluing is impossible: S2976b evaluates
D.hom at the fibre product W i1 i2 = pullback i1.obj.hom i2.obj.hom, but the
hom field of S3026Q.DescentData is only defined for
Y : S3026NonemptyScheme, while W i1 i2 : Iut.SchemeOverField K need not be
nonempty.  The exact first error of the naive port is (probe file
_S3042ProbeNaive.lean, line 25):

  error: Application type mismatch: The argument
    W i1 i2
  has type
    SchemeOverField K
  but is expected to have type
    S3026NonemptyScheme
  in the application
    @Pseudofunctor.DescentData.hom S3026NonemptyScheme ...

This is not a fixable type mismatch.  The obstruction is mathematical: the
restricted site has no empty scheme, hence D does not force the signs on two
common refinements of the same pair of indices to agree when those refinements
have empty intersection.  Concretely (over K):

* U = P^1, V1 = P^1 minus {inf}, V2 = P^1 minus {0},
  W = V1 cap V2 = P^1 minus {0, inf};
* Y = Spec K coprod Spec K mapped to U by 0 and inf;
* R = sieve generated by (V1 -> U), (V2 -> U) and (Y -> U).
  The pushforward of R along S3026NonemptyProperty.iota contains the big
  etale cover {V1 -> U, V2 -> U}, so R is in S3026NonemptySite U
  (see S3042_pushforward_mem below).
* Fix the origin P0 = (0,0) in X(K) and its image P1 = alpha(P0) = (0,-1),
  which is different from P0.  Define a descent datum on R by
  D.obj(V1) = const P0, D.obj(V2) = const P1,
  D.obj(Y) = (P0 at 0, P1 at inf), and the unique signs on the pairwise
  overlaps W (the non-trivial sign), {0} (trivial) and {inf} (trivial);
  extend it to all of R.arrows by pullback.  There is no triple intersection
  Y x_U V1 x_U V2 (it is empty), so the descent axioms impose no relation
  between the three pairwise signs, and this is a well-defined restricted
  descent datum.
* It is not effective.  If M : U -> X and g_Y gave an isomorphism at the
  index Y, then M restricted to V1 is g_V1 . (const P0), hence constant; V1
  is dense in U and X is separated, hence M is constant.  But then
  g_Y . (M restricted to Y) is constant and cannot equal
  D.obj Y = (P0 at 0, P1 at inf).

Thus S3037QEffectiveDescent is false, and no proof without extra hypotheses
can exist.  A correct replacement must either
(a) restrict to sieves whose index category is closed under the relevant fibre
products (so that D.hom is available at every W i1 i2), or
(b) enlarge the site (e.g. the connected site) so that the empty scheme and
the empty overlaps are part of the descent data.

The lemmas below are the correct site-theoretic part of the intended port and
are independent of the false statement.  They are used by any big-site
reduction: they identify the induced topology with the restricted topology and
show that a cover of the nonempty site pushes forward to a cover of the big
etale site.
-/
noncomputable section
open CategoryTheory Opposite
open LeanFormal.IUT
open LeanFormal.IUT.XiFPaper
open LeanFormal.IUT.XiFPaper.S3026NonemptyEtaleSite
open LeanFormal.IUT.XiFPaper.S2882A6PointwisePseudofunctorActual
open AlgebraicGeometry
namespace LeanFormal.IUT.XiFPaper.S3042RestrictedQEffectiveDescent

abbrev K : Type := S2844D6F6BaseChangeActual.K

/-- The inclusion of nonempty schemes into all schemes over K is cover dense
for the big etale topology: for a nonempty U the identity factors through the
inclusion; for an empty U the sieve of arrows through nonempty schemes is the
bottom sieve, which is covering on the empty scheme. -/
theorem S3042_iota_isCoverDense :
    S3026NonemptyProperty.ι.IsCoverDense (Iut.SchemeOverField.etaleTopology K) := by
  constructor
  intro U
  by_cases hU : Nonempty U.left
  · have htop : Sieve.coverByImage S3026NonemptyProperty.ι U = ⊤ := by
      apply le_antisymm le_top
      have hid : (Sieve.coverByImage S3026NonemptyProperty.ι U) (𝟙 U) :=
        ⟨⟨⟨U, hU⟩, 𝟙 U, 𝟙 U, by simp⟩⟩
      intro Y f _
      simpa using Sieve.downward_closed _ hid f
    rw [htop]
    exact GrothendieckTopology.top_mem _ U
  · have hUe : IsEmpty U.left := not_nonempty_iff.mp hU
    have hbot : Sieve.coverByImage S3026NonemptyProperty.ι U = ⊥ := by
      apply le_antisymm _ bot_le
      rintro Y f ⟨Z, f₁, f₂, h⟩
      exact hU (Z.property.map f₂.left)
    rw [hbot]
    change (⊥ : Sieve U) ∈ GrothendieckTopology.over
      AlgebraicGeometry.Scheme.etaleTopology (Spec (CommRingCat.of K)) U
    rw [GrothendieckTopology.mem_over_iff]
    haveI : IsEmpty U.left := hUe
    simpa using AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology
      (P := @Etale) (X := U.left)

/-- On the induced topology, membership of a sieve is equivalent to the
pushforward sieve being a cover for the big etale topology. -/
theorem S3042_pushforward_mem {U : S3026NonemptyScheme} {R : Sieve U}
    (hR : R ∈ S3026NonemptySite U) :
    R.functorPushforward S3026NonemptyProperty.ι ∈
      Iut.SchemeOverField.etaleTopology K U.obj := by
  haveI : S3026NonemptyProperty.ι.IsCoverDense
      (Iut.SchemeOverField.etaleTopology K) := S3042_iota_isCoverDense
  exact (Functor.mem_inducedTopology_iff_of_isCoverDense
    (G := S3026NonemptyProperty.ι)
    (K := Iut.SchemeOverField.etaleTopology K) R).mp hR

/-- The pushforward sieve is the sieve generated by the underlying big arrows
of the restricted index category. -/
theorem S3042_pushforward_eq_ofArrows (U : S3026NonemptyScheme) (R : Sieve U) :
    R.functorPushforward S3026NonemptyProperty.ι =
      Sieve.ofArrows _ (fun f : R.arrows.category => f.obj.hom.hom) := by
  conv_lhs => rw [← Sieve.ofArrows_category R]
  rw [Sieve.functorPushforward_ofArrows]
  rfl

/-- Exact statement of the remaining gap (not proved, and false as stated for
the original target): effective descent for the restricted Q would follow from
the big etale theorem if every restricted descent datum extended to a big
descent datum along the pushforward sieve.  The counterexample in the module
docstring shows that such an extension does not exist in general: the empty
overlaps are not part of the restricted descent data. -/
def S3042ExtensionObstruction : Prop :=
  ∀ (U : S3026NonemptyScheme) (R : Sieve U) (_ : R ∈ S3026NonemptySite U)
    (D : S3026Q.DescentData (fun f : R.arrows.category => f.obj.hom)),
    ∃ Dbig : S2882A6Q.DescentData
        (fun f : R.arrows.category => f.obj.hom.hom),
      (∀ i, Dbig.obj i = D.obj i)

#check S3042_iota_isCoverDense
#check S3042_pushforward_mem
#check S3042_pushforward_eq_ofArrows
#check S3042ExtensionObstruction
#print axioms S3042_iota_isCoverDense
#print axioms S3042_pushforward_mem
#print axioms S3042_pushforward_eq_ofArrows

end LeanFormal.IUT.XiFPaper.S3042RestrictedQEffectiveDescent

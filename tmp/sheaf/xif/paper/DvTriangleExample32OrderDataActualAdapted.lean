import tmp.sheaf.xif.paper.DvTriangleFieldCoversActual

/-! # Example 3.2 divisor monoid: exact missing order/valuation data

Paper: Phi = N * log_Phi(q_v) on D_v^triangle = B(K_v)^0, the connected
finite étale covers of Spec K_v.

S398's DvTriangleFieldCover K is only the finite étale field-cover category; it
carries no q_v, no normalized valuation, and no valuation extension to each
cover.  This file records the exact missing order/valuation datum.  No divisor
monoid or valuation is fabricated. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

namespace LeanFormal.IUT.XiFPaper.DvTriangleExample32OrderDataActualAdapted

open CategoryTheory
open LeanFormal.IUT.XiFPaper.DvTriangleFieldCoversActual

universe u

variable {K : Type u} [Field K]

/-- Exact missing datum for Example 3.2: actual q_v in K and, for every finite
étale field cover L/K, its normalized valuation/order together with pullback
compatibility.  The compatibility fields are Props because the repo has no
actual valuation extension API here. -/
structure DvTriangleQOrderData (K : Type u) [Field K] where
  q : K
  q_ne_zero : q ≠ 0
  order : DvTriangleFieldCover K → Nat
  order_eq_one_base : Prop
  normalized_valuation : Prop
  pullback_compatible : Prop
  fsm_compatible : Prop

/-- Exact missing datum; no inhabitant is asserted. -/
def DvTriangleQOrderDataRequired : Prop :=
  Nonempty (DvTriangleQOrderData K)

/-- Example 3.2's Phi monoid would be the constant N-submonoid generated by
log_Phi(q_v).  Its carrier is recorded only as a type, not constructed from a
fake valuation. -/
abbrev Example32PhiCarrier : Type := ULift.{u} Nat

end LeanFormal.IUT.XiFPaper.DvTriangleExample32OrderDataActualAdapted

end

/-
Route 7.2 (a): the monogenic step at an actual local field.

Let p be prime and let L be a finite extension of Q_p in the sense of the accepted
local-field interface of LeanFormal.IUT.Foundations.LocalFields.  Write
O = Integers L for the norm-integer ring (the valuation ring of L).

This file supplies the two structural inputs that route 7.2, plan (a), needs from a
monogenic presentation O = Z_p[x]:

1. MonogenicIntegers p L records such a presentation, and
   conductor_eq_top_of_adjoin_top proves that its conductor ideal
   conductor Z_p x (the largest ideal of O contained in Z_p[x]) is top.
   This is the hypothesis hc of the accepted tame/monogenic donor
   Mzk1G1F7TameMonogenicActual.differentIdeal_eq_span_derivative_of_conductor_eq_top.

   adjoin_eq_top_of_fractionRing derives the rational spanning hypothesis
   Q_p[x] = L from the integral one (the rational adjoin contains the image of the
   integer ring, and inverses of integral elements lie in the generated subalgebra),
   so a monogenic integer ring really is monogenic as a field extension.

2. differentIdeal_eq_span_derivative applies that donor: if additionally
   Q_p[x] = L, then the relative different of O over Z_p is generated by the
   derivative of the minimal polynomial of x.

differentIdeal_eq_span_derivative_of_monogenic packages 1 and 2 for a term of the
structure (no rational spanning hypothesis remains), and
localDifferentIdeal_eq_span_derivative restates the result for the concrete ideal
localDifferentIdeal of IntegralTraceDualTensorInclusion, whose statement needs no
Dedekind instance arguments (they are internal to that def).

The only instance input that cannot be synthesized from the ambient hypotheses is
IsDedekindDomain (Integers L): its type does not determine p, so it is carried as a
section variable and is discharged by integersIsDedekindDomain at call sites.

Nothing here asserts that MonogenicIntegers p L is inhabited: that is false in
general for a finite extension of Q_p, and no existence claim is made.
-/
import tmp.sheaf.xif.paper.Mzk1G1F7TameMonogenicActual
import LeanFormal.IUT.Foundations.LocalFields.IntegralTraceDualTensorInclusion
import Mathlib.RingTheory.Conductor
import Mathlib.RingTheory.DedekindDomain.Different
import Mathlib.Tactic

noncomputable section

namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalMonogenicLocalActual

set_option linter.unusedSectionVars false

open Polynomial Ideal
open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.IntegralTraceDualTensorInclusion

variable {p : Nat} [Fact p.Prime] {L : Type*} [NormedField L] [CharZero L] [CompleteSpace L]
  [IsUltrametricDist L] [ProperSpace L] [NormedAlgebra ℚ_[p] L] [FiniteDimensional ℚ_[p] L]

/-! ## Instances that are synthesizable from the ambient hypotheses -/

/-- Z_p is integrally closed (it is a discrete valuation ring). -/
local instance : IsIntegrallyClosed ℤ_[p] := padicInt_isIntegrallyClosed (p := p)

/-- Z_p is a Dedekind domain. -/
local instance : IsDedekindDomain ℤ_[p] := by
  haveI : IsDiscreteValuationRing ℤ_[p] := inferInstance
  infer_instance

/-- The scalar tower Z_p -> Q_p -> L, for the restricted Z_p-algebra structure on L. -/
local instance : IsScalarTower ℤ_[p] ℚ_[p] L :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

/-- A finite extension of Q_p in characteristic zero is a separable extension. -/
local instance : Algebra.IsSeparable ℚ_[p] L := by infer_instance

/-! ## 1. Monogenic integer rings and their conductor -/

/-- A monogenic presentation of the integer ring of L over Z_p: an integral element x
whose Z_p-adjoin is the whole integer ring. -/
structure MonogenicIntegers (p : Nat) [Fact p.Prime] (L : Type*) [NormedField L] [CharZero L]
    [CompleteSpace L] [IsUltrametricDist L] [ProperSpace L] [NormedAlgebra ℚ_[p] L]
    [FiniteDimensional ℚ_[p] L] where
  /-- A generator of the integer ring over Z_p. -/
  x : Integers L
  /-- Its Z_p-span is the whole integer ring. -/
  adjoin_top : Algebra.adjoin ℤ_[p] ({x} : Set (Integers L)) = ⊤

/-- **The conductor of a monogenic integer ring is trivial.**  The conductor of x
consists of the elements a of the integer ring with a * b in Z_p[x] for every b;
taking b = 1 puts a itself in Z_p[x], and Z_p[x] is everything. -/
theorem conductor_eq_top_of_adjoin_top (x : Integers L)
    (hx : Algebra.adjoin ℤ_[p] ({x} : Set (Integers L)) = ⊤) :
    conductor ℤ_[p] x = ⊤ := by
  rw [Ideal.eq_top_iff_one, mem_conductor_iff]
  intro b
  rw [one_mul, hx]
  simp

/-- **Monogeneity passes from the integer ring to the field.**  If the integer ring
is generated over Z_p by x, then L is generated over Q_p by the image of x.  The
rational adjoin contains the image of the whole integer ring; and the inverse of any
nonzero integral element lies in the subalgebra generated by that element, since the
element is integral over the field Q_p.  Every element of L is a quotient of two
integer-ring elements (the integer ring is a fraction ring of L). -/
theorem adjoin_eq_top_of_fractionRing (x : Integers L)
    (hx : Algebra.adjoin ℤ_[p] ({x} : Set (Integers L)) = ⊤) :
    Algebra.adjoin ℚ_[p] ({algebraMap (Integers L) L x} : Set L) = ⊤ := by
  let S : Subalgebra ℚ_[p] L := Algebra.adjoin ℚ_[p] ({algebraMap (Integers L) L x} : Set L)
  have hxS : algebraMap (Integers L) L x ∈ S := Algebra.subset_adjoin (Set.mem_singleton _)
  have hle : Algebra.adjoin ℤ_[p] ({algebraMap (Integers L) L x} : Set L) ≤
      Subalgebra.restrictScalars ℤ_[p] S := by
    rw [Algebra.adjoin_le_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact hxS
  have hB : ∀ b : Integers L, algebraMap (Integers L) L b ∈ S := by
    intro b
    have hb : algebraMap (Integers L) L b ∈
        (Algebra.adjoin ℤ_[p] ({x} : Set (Integers L))).map
          (IsScalarTower.toAlgHom ℤ_[p] (Integers L) L) := by
      rw [hx, Algebra.map_top]
      simp
    rw [AlgHom.map_adjoin, Set.image_singleton] at hb
    exact hle (by simpa [IsScalarTower.coe_toAlgHom'] using hb)
  show S = ⊤
  refine top_le_iff.mp fun y _ => ?_
  obtain ⟨b, s, hs, rfl⟩ := IsFractionRing.div_surjective (Integers L) y
  have hbS : algebraMap (Integers L) L b ∈ S := hB b
  have hsS : algebraMap (Integers L) L s ∈ S := hB s
  have hint : IsIntegral ℚ_[p] (algebraMap (Integers L) L s) :=
    Algebra.IsIntegral.isIntegral (R := ℚ_[p]) (algebraMap (Integers L) L s)
  have hinv : (algebraMap (Integers L) L s)⁻¹ ∈ S := hint.inv_mem hsS
  rw [div_eq_mul_inv]
  exact S.mul_mem hbS hinv

namespace MonogenicIntegers

variable (M : MonogenicIntegers (p := p) (L := L))

/-- The conductor of the generator of a monogenic integer ring is trivial. -/
theorem conductor_eq_top : conductor ℤ_[p] M.x = ⊤ :=
  conductor_eq_top_of_adjoin_top M.x M.adjoin_top

/-- The generator of a monogenic integer ring also generates the field over Q_p. -/
theorem adjoin_top_rat : Algebra.adjoin ℚ_[p] ({algebraMap (Integers L) L M.x} : Set L) = ⊤ :=
  adjoin_eq_top_of_fractionRing M.x M.adjoin_top

end MonogenicIntegers

/-! ## 2. The different as the derivative ideal -/

section Different

variable [IsDedekindDomain (Integers L)]

/-- **Monogenic form of the relative different over Z_p.**  If x generates the
integer ring rationally (Q_p[x] = L) and its integral conductor is trivial, then the
relative different of O over Z_p is generated by the derivative of the minimal
polynomial of x over Z_p. -/
theorem differentIdeal_eq_span_derivative (x : Integers L)
    (hx : Algebra.adjoin ℚ_[p] ({algebraMap (Integers L) L x} : Set L) = ⊤)
    (hc : conductor ℤ_[p] x = ⊤) :
    differentIdeal ℤ_[p] (Integers L) = Ideal.span {aeval x (derivative (minpoly ℤ_[p] x))} :=
  LeanFormal.IUT.XiFPaper.Mzk1G1F7TameMonogenicActual.differentIdeal_eq_span_derivative_of_conductor_eq_top
    (A := ℤ_[p]) (K := ℚ_[p]) (B := Integers L) (L := L) x hx hc

/-- **The different of a monogenic integer ring is the derivative ideal.**  Both
inputs of the tame/monogenic donor are discharged by monogeneity: the conductor is
trivial and the field is generated rationally by the same element. -/
theorem differentIdeal_eq_span_derivative_of_monogenic
    (M : MonogenicIntegers (p := p) (L := L)) :
    differentIdeal ℤ_[p] (Integers L) =
      Ideal.span {aeval M.x (derivative (minpoly ℤ_[p] M.x))} :=
  differentIdeal_eq_span_derivative M.x (MonogenicIntegers.adjoin_top_rat M)
    (MonogenicIntegers.conductor_eq_top M)

end Different

/-! ## 3. The same statements for the concrete ideal localDifferentIdeal -/

section DifferentConcrete

/-- The monogenic different formula for the concrete ideal localDifferentIdeal of
IntegralTraceDualTensorInclusion.  The statement needs no Dedekind instance
argument: the instance is internal to the definition of localDifferentIdeal. -/
theorem localDifferentIdeal_eq_span_derivative (x : Integers L)
    (hx : Algebra.adjoin ℚ_[p] ({algebraMap (Integers L) L x} : Set L) = ⊤)
    (hc : conductor ℤ_[p] x = ⊤) :
    localDifferentIdeal (p := p) (L := L) =
      Ideal.span {aeval x (derivative (minpoly ℤ_[p] x))} := by
  haveI : IsDedekindDomain (Integers L) := integersIsDedekindDomain (p := p) (L := L)
  rw [show localDifferentIdeal (p := p) (L := L) = differentIdeal ℤ_[p] (Integers L) from rfl]
  exact differentIdeal_eq_span_derivative x hx hc

/-- The monogenic different formula for localDifferentIdeal, with both the
conductor hypothesis and the rational spanning hypothesis discharged by
monogeneity. -/
theorem localDifferentIdeal_eq_span_derivative_of_monogenic
    (M : MonogenicIntegers (p := p) (L := L)) :
    localDifferentIdeal (p := p) (L := L) =
      Ideal.span {aeval M.x (derivative (minpoly ℤ_[p] M.x))} := by
  haveI : IsDedekindDomain (Integers L) := integersIsDedekindDomain (p := p) (L := L)
  rw [show localDifferentIdeal (p := p) (L := L) = differentIdeal ℤ_[p] (Integers L) from rfl]
  exact differentIdeal_eq_span_derivative_of_monogenic M

end DifferentConcrete


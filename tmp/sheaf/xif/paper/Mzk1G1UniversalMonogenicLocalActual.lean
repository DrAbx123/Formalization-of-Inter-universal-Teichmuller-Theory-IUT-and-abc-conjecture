#check @adjoin_eq_top_of_fractionRing
#check @MonogenicIntegers.conductor_eq_top
#check @MonogenicIntegers.adjoin_top_rat
#check @differentIdeal_eq_span_derivative
#check @differentIdeal_eq_span_derivative_of_monogenic
#check @localDifferentIdeal_eq_span_derivative
#check @localDifferentIdeal_eq_span_derivative_of_monogenic


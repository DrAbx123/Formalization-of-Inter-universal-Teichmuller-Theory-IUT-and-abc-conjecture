/-! ## Part 1: (G2) for an arbitrary commutative ring -/

namespace S1830G2

variable {R : Type} [CommRing R]

/-- The opposite of the category of finite etale R-algebras. -/
abbrev FiniteEtaleAlg : Type 1 := (CommAlgCat.FiniteEtale.{0} R)ᵒᵖ

section Action

variable {G : Type} [Group G]

/-- The algebra underlying an action diagram. -/
abbrev actionAlgebra (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) : Type :=
  (F.obj (Opposite.op (SingleObj.star G))).obj

/-- The R-algebra automorphism attached to a group element. -/
def actionMap (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) (g : G) :
    actionAlgebra F →ₐ[R] actionAlgebra F :=
  (F.map (Opposite.op g)).hom.hom

lemma actionMap_one (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) :
    actionMap F (1 : G) = AlgHom.id R (actionAlgebra F) := by
  unfold actionMap
  rw [show (Opposite.op (1 : G)) = 𝟙 (Opposite.op (SingleObj.star G)) from rfl, F.map_id]
  rfl

lemma actionMap_mul (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) (g h : G) :
    actionMap F (g * h) = (actionMap F h).comp (actionMap F g) := by
  unfold actionMap
  change (F.map (Opposite.op (g * h))).hom.hom =
    (F.map (Opposite.op g) ≫ F.map (Opposite.op h)).hom.hom
  rw [← F.map_comp]
  congr 1

noncomputable instance actionMulSemiringAction
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) :
    MulSemiringAction G (actionAlgebra F) where
  smul g x := actionMap F g⁻¹ x
  one_smul x := by
    change actionMap F ((1 : G)⁻¹) x = x
    rw [inv_one, actionMap_one]
    rfl
  mul_smul g h x := by
    change actionMap F ((g * h)⁻¹) x = actionMap F g⁻¹ (actionMap F h⁻¹ x)
    rw [mul_inv_rev, actionMap_mul]
    rfl
  smul_zero g := (actionMap F g⁻¹).map_zero
  smul_add g x y := (actionMap F g⁻¹).map_add x y
  smul_one g := (actionMap F g⁻¹).map_one
  smul_mul g x y := (actionMap F g⁻¹).map_mul x y

lemma action_smul_def (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) (g : G)
    (x : actionAlgebra F) : g • x = actionMap F g⁻¹ x := rfl

noncomputable instance actionSMulCommClass
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) :
    SMulCommClass G R (actionAlgebra F) where
  smul_comm g r x := by
    change actionMap F g⁻¹ (r • x) = r • actionMap F g⁻¹ x
    rw [Algebra.smul_def, Algebra.smul_def, map_mul, (actionMap F g⁻¹).commutes]

/-- The invariant subalgebra A^G. -/
abbrev invariants (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) :
    Subalgebra R (actionAlgebra F) :=
  fixedPointSubalgebra R (actionAlgebra F) G

lemma groupActionRingEquiv_apply
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) (g : G) (x : actionAlgebra F) :
    groupActionRingEquiv (actionAlgebra F) G g x = actionMap F g⁻¹ x := by
  rfl

/-- The key general-ring fixed-point theorem: the invariants of a finite etale
R-algebra under a finite group action are again finite etale over R. -/
theorem invariants_finiteEtale [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) :
    Algebra.Etale R ↥(invariants F) ∧ Module.Finite R ↥(invariants F) := by
  haveI : Algebra.Etale R (actionAlgebra F) :=
    (F.obj (Opposite.op (SingleObj.star G))).property.right
  haveI : Module.Finite R (actionAlgebra F) :=
    (F.obj (Opposite.op (SingleObj.star G))).property.left
  exact FiniteEtaleFixedPointsGeneral.fixedPointSubalgebra_finiteEtale
    (R := R) (A := actionAlgebra F) (G := G)

/-- The invariant algebra as an object of the finite etale category. -/
noncomputable def invariantsObject [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) :
    CommAlgCat.FiniteEtale.{0} R := by
  have h := invariants_finiteEtale (R := R) F
  letI : Algebra.Etale R ↥(invariants F) := h.1
  letI : Module.Finite R ↥(invariants F) := h.2
  exact CommAlgCat.FiniteEtale.of R ↥(invariants F)

/-- The structural map from the invariants to the acted-on algebra. -/
noncomputable def invariantsMap [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R)
    (j : (SingleObj G)ᵒᵖ) : invariantsObject (R := R) F ⟶ F.obj j := by
  have h := invariants_finiteEtale (R := R) F
  letI : Algebra.Etale R ↥(invariants F) := h.1
  letI : Module.Finite R ↥(invariants F) := h.2
  exact CommAlgCat.FiniteEtale.ofHom (fixedPointInclusion R (actionAlgebra F) G)

lemma fixed_inclusion_action [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) (g : G)
    (x : ↥(invariants F)) :
    actionMap F g (x : actionAlgebra F) = (x : actionAlgebra F) := by
  have hfix : actionMap F g⁻¹ (x : actionAlgebra F) = (x : actionAlgebra F) := by
    have h := x.2 g
    simpa [action_smul_def] using h
  have hcomp : actionMap F g (actionMap F g⁻¹ (x : actionAlgebra F)) =
      actionMap F (g⁻¹ * g) (x : actionAlgebra F) := by
    rw [actionMap_mul]
    rfl
  calc actionMap F g (x : actionAlgebra F)
      = actionMap F g (actionMap F g⁻¹ (x : actionAlgebra F)) := by rw [hfix]
    _ = actionMap F (g⁻¹ * g) (x : actionAlgebra F) := hcomp
    _ = (x : actionAlgebra F) := by
        rw [inv_mul_cancel]
        exact congrArg (fun f => f (x : actionAlgebra F)) (actionMap_one F)

lemma invariantsMap_naturality [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R)
    {j j' : (SingleObj G)ᵒᵖ} (f : j ⟶ j') :
    invariantsMap F j' = invariantsMap F j ≫ F.map f := by
  apply ObjectProperty.hom_ext
  apply CommAlgCat.hom_ext
  apply AlgHom.ext
  intro x
  have hf : f = Opposite.op (Opposite.unop f) := (Opposite.op_unop f).symm
  rw [hf]
  exact (fixed_inclusion_action F (Opposite.unop f) x).symm

/-- The limit cone over the action diagram with point A^G. -/
noncomputable def invariantsCone [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) : Cone F where
  pt := invariantsObject (R := R) F
  π :=
    { app := invariantsMap F
      naturality := by
        intro j j' f
        exact invariantsMap_naturality F f }

noncomputable def invariantsLiftAlgHom [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R)
    (c : Cone F) : (c.pt).obj →ₐ[R] ↥(invariants F) :=
  AlgHom.codRestrict
    ((c.π.app (Opposite.op (SingleObj.star G))).hom.hom) (invariants F)
    (fun b => by
      intro g
      have hnat := Cone.w (F := F) (j := Opposite.op (SingleObj.star G))
        (j' := Opposite.op (SingleObj.star G)) c (Opposite.op g⁻¹)
      have hb := congrArg
        (fun (m : c.pt ⟶ F.obj (Opposite.op (SingleObj.star G))) => m.hom.hom b) hnat
      rw [ObjectProperty.FullSubcategory.comp_hom, CommAlgCat.hom_comp, AlgHom.comp_apply] at hb
      change actionMap F g⁻¹ ((c.π.app (Opposite.op (SingleObj.star G))).hom.hom b) =
        (c.π.app (Opposite.op (SingleObj.star G))).hom.hom b
      exact hb)

noncomputable def invariantsLift [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R)
    (c : Cone F) : c.pt ⟶ (invariantsCone (R := R) F).pt := by
  have h := invariants_finiteEtale (R := R) F
  letI : Algebra.Etale R ↥(invariants F) := h.1
  letI : Module.Finite R ↥(invariants F) := h.2
  exact ObjectProperty.homMk (CommAlgCat.ofHom (invariantsLiftAlgHom F c))

lemma invariantsLift_fac [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R)
    (c : Cone F) (j : (SingleObj G)ᵒᵖ) :
    invariantsLift F c ≫ (invariantsCone (R := R) F).π.app j = c.π.app j := by
  apply ObjectProperty.hom_ext
  apply CommAlgCat.hom_ext
  apply AlgHom.ext
  intro x
  rfl

noncomputable def invariantsIsLimit [Fintype G] [DecidableEq G]
    (F : (SingleObj G)ᵒᵖ ⥤ CommAlgCat.FiniteEtale.{0} R) :
    IsLimit (invariantsCone (R := R) F) where
  lift := invariantsLift F
  fac := invariantsLift_fac F
  uniq c m hm := by
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro b
    apply Subtype.ext
    have hb := congrArg
      (fun (q : c.pt ⟶ F.obj (Opposite.op (SingleObj.star G))) => q.hom.hom b)
      (hm (Opposite.op (SingleObj.star G)))
    exact hb

instance hasLimitsOfShape_op_singleObj [Finite G] :
    HasLimitsOfShape (SingleObj G)ᵒᵖ (CommAlgCat.FiniteEtale.{0} R) := by
  letI : Fintype G := Fintype.ofFinite G
  letI : DecidableEq G := Classical.decEq G
  exact ⟨fun F => ⟨invariantsCone (R := R) F, invariantsIsLimit F⟩⟩

end Action

variable {G : Type} [Group G] [Finite G]

/-- (G2) for an arbitrary commutative ring R: colimits by finite group
actions exist in (CommAlgCat.FiniteEtale R)^op. -/
instance hasQuotientsByFiniteGroups :
    HasColimitsOfShape (SingleObj G) (FiniteEtaleAlg (R := R)) :=
  hasColimitsOfShape_op_of_hasLimitsOfShape (J := SingleObj G)
    (C := CommAlgCat.FiniteEtale.{0} R)

end S1830G2

/-! ## Part 2: (G3) for an arbitrary commutative ring -/

namespace S1830G3

variable {R : Type} [CommRing R]

/-- Every epimorphism of finite etale R-algebras is surjective. -/
theorem epi_surjective_of_finiteEtale
    {A B : CommAlgCat.FiniteEtale.{0} R} (f : B ⟶ A) [Epi f] :
    Function.Surjective (fun b : B.obj => f.hom.hom b) := by
  let fA : B.obj →ₐ[R] A.obj := f.hom.hom
  letI : Algebra B.obj A.obj := fA.toRingHom.toAlgebra
  haveI : IsScalarTower R B.obj A.obj :=
    IsScalarTower.of_algebraMap_eq' (by
      ext r
      exact (fA.commutes r).symm)
  haveI : Module.Finite B.obj A.obj :=
    Module.Finite.of_restrictScalars_finite R B.obj A.obj
  -- The tensor-product pushout cocone of f with itself.
  let cc : PushoutCocone f.hom f.hom :=
    FiniteEtaleClosure.tensorCocone (R := R) (A := B.obj) (B := A.obj) (C := A.obj)
      f.hom f.hom
  have hfin : (CommAlgCat.finiteEtale R) cc.pt :=
    FiniteEtaleClosure.finiteEtale_tensorCocone_pt (R := R) f.hom f.hom
      B.property A.property A.property
  let Tobj : CommAlgCat.FiniteEtale.{0} R := ⟨cc.pt, hfin⟩
  let g1 : A ⟶ Tobj := ObjectProperty.homMk cc.inl
  let g2 : A ⟶ Tobj := ObjectProperty.homMk cc.inr
  have hfg : f ≫ g1 = f ≫ g2 := by
    apply ObjectProperty.hom_ext
    exact cc.condition
  have hg : g1 = g2 := Epi.left_cancellation g1 g2 hfg
  have hIsEpi : Algebra.IsEpi B.obj A.obj := by
    rw [Algebra.isEpi_iff_forall_one_tmul_eq]
    intro a
    have h := congrArg (fun (g : A ⟶ Tobj) => g.hom.hom a) hg
    change (1 : A.obj) ⊗ₜ[B.obj] a = a ⊗ₜ[B.obj] (1 : A.obj)
    rw [show (1 : A.obj) ⊗ₜ[B.obj] a = cc.inr.hom a from rfl,
      show a ⊗ₜ[B.obj] (1 : A.obj) = cc.inl.hom a from rfl]
    exact h.symm
  have hEpiRing : Epi (CommRingCat.ofHom (algebraMap B.obj A.obj)) :=
    CommRingCat.epi_iff_epi.mpr hIsEpi
  have hFin : RingHom.Finite (algebraMap B.obj A.obj) :=
    RingHom.finite_algebraMap.mpr (inferInstance : Module.Finite B.obj A.obj)
  have hsurj : Function.Surjective (algebraMap B.obj A.obj) :=
    RingHom.surjective_of_epi_of_finite (CommRingCat.ofHom (algebraMap B.obj A.obj)) hFin
  intro a
  exact hsurj a

/-- A surjection of finite etale R-algebras splits as a product projection. -/
theorem exists_prod_algEquiv_of_surjective
    {A B : Type} [CommRing A] [Algebra R A] [Module.Finite R A] [Algebra.Etale R A]
    [CommRing B] [Algebra R B] [Module.Finite R B] [Algebra.Etale R B]
    (f : B →ₐ[R] A) (hf : Function.Surjective f) :
    ∃ (C : Type) (_ : CommRing C) (_ : Algebra R C) (_ : Module.Finite R C)
      (_ : Algebra.Etale R C),
      ∃ e : B ≃ₐ[R] A × C, f = (AlgHom.fst R A C).comp e.toAlgHom := by
  letI : Algebra B A := f.toRingHom.toAlgebra
  haveI : IsScalarTower R B A :=
    IsScalarTower.of_algebraMap_eq' (by
      ext r
      exact (f.commutes r).symm)
  haveI : Module.Finite B A :=
    Module.Finite.of_restrictScalars_finite R B A
  have hFE : Algebra.FormallyEtale B A :=
    Algebra.FormallyEtale.of_restrictScalars (R := R) (A := B) (B := A)
  have hsurj' : Function.Surjective (algebraMap B A) := hf
  have hIidem : IsIdempotentElem (RingHom.ker (algebraMap B A)) :=
    (Algebra.FormallyEtale.iff_of_surjective hsurj').mp hFE
  let I : Ideal B := RingHom.ker (algebraMap B A)
  have hIFG : I.FG := by
    haveI hFlat : Module.Flat R A := inferInstance
    haveI hFP : Module.FinitePresentation R A :=
      Module.FinitePresentation.of_finite_of_finitePresentation R A
    haveI hProj : Module.Projective R A := Module.Flat.projective_of_finitePresentation
    let fLin : B →ₗ[R] A := f.toLinearMap
    have hsurjLin : Function.Surjective fLin := hf
    obtain ⟨s, hs⟩ := Module.projective_lifting_property fLin (LinearMap.id : A →ₗ[R] A) hsurjLin
    have hs_apply : ∀ x : A, fLin (s x) = x := by
      intro x
      have h := congrArg (fun (g : A →ₗ[R] A) => g x) hs
      simpa using h
    let q : B →ₗ[R] B := LinearMap.id - s.comp fLin
    have hq : q.range = I.restrictScalars R := by
      ext b
      constructor
      · intro hb
        obtain ⟨c, rfl⟩ := LinearMap.mem_range.mp hb
        change fLin (q c) = 0
        have hqc : q c = c - s (fLin c) := by simp [q]
        rw [hqc, map_sub, hs_apply, sub_self]
      · intro hb
        refine LinearMap.mem_range.mpr ⟨b, ?_⟩
        have hb' : fLin b = 0 := hb
        simp [q, hb']
    have hfgR : (I.restrictScalars R).FG := by
      rw [← hq]
      exact Submodule.fg_range q
    rwa [Submodule.FG.restrictScalars_iff] at hfgR
  obtain ⟨e0, he0, hIe⟩ := (Ideal.isIdempotentElem_iff_of_fg I hIFG).mp hIidem
  have hIe' : I = Ideal.span {e0} := by simpa using hIe
  let J : Ideal B := Ideal.span {1 - e0}
  have hJidem : IsIdempotentElem J := by
    rw [show J = Ideal.span {1 - e0} from rfl, IsIdempotentElem,
      Ideal.span_singleton_mul_span_singleton, he0.one_sub.eq]
  have hJfg : J.FG := by
    rw [show J = Ideal.span {1 - e0} from rfl]
    exact Submodule.fg_span (Set.finite_singleton _)
  haveI : IsScalarTower R B (B ⧸ J) :=
    IsScalarTower.of_algebraMap_eq (fun r => rfl)
  have hkerC : RingHom.ker (algebraMap B (B ⧸ J)) = J := by
    rw [Ideal.Quotient.algebraMap_eq]
    exact Ideal.mk_ker
  haveI hEtaleBC : Algebra.Etale B (B ⧸ J) := by
    refine ⟨?_, ?_⟩
    · refine (Algebra.FormallyEtale.iff_of_surjective ?_).mpr ?_
      · simpa [Ideal.Quotient.algebraMap_eq] using Ideal.Quotient.mk_surjective (I := J)
      · rw [hkerC]
        exact hJidem
    · exact Algebra.FinitePresentation.quotient hJfg
  haveI hEtaleRC : Algebra.Etale R (B ⧸ J) := Algebra.Etale.comp R B (B ⧸ J)
  let crt : B ≃ₐ[R] (B ⧸ Ideal.span {e0}) × (B ⧸ J) :=
    AlgEquiv.prodQuotientOfIsIdempotentElem (R := R) (S := B) he0 he0.one_sub
      (by ring) (he0.mul_one_sub_self)
  let qiso : (B ⧸ I) ≃ₐ[R] A := Ideal.quotientKerAlgEquivOfSurjective hf
  let qiso' : (B ⧸ Ideal.span {e0}) ≃ₐ[R] A :=
    (Ideal.quotientEquivAlgOfEq R hIe').symm.trans qiso
  let e : B ≃ₐ[R] A × (B ⧸ J) := crt.trans (AlgEquiv.prodCongr qiso' (AlgEquiv.refl))
  refine ⟨B ⧸ J, inferInstance, inferInstance, Module.Finite.quotient R J, hEtaleRC, e, ?_⟩
  ext b
  change f b = (e b).1
  have hcrt : crt b = (Ideal.Quotient.mk (Ideal.span {e0}) b, Ideal.Quotient.mk J b) :=
    AlgEquiv.prodQuotientOfIsIdempotentElem_apply R he0 he0.one_sub (by ring) (he0.mul_one_sub_self) b
  have hqiso'_mk : qiso' (Ideal.Quotient.mk (Ideal.span {e0}) b) = f b := by
    have h1 : (Ideal.quotientEquivAlgOfEq R hIe').symm
        (Ideal.Quotient.mk (Ideal.span {e0}) b) = Ideal.Quotient.mk I b := by
      rw [Ideal.quotientEquivAlgOfEq_symm]
      exact Ideal.quotientEquivAlgOfEq_mk R hIe'.symm b
    change qiso ((Ideal.quotientEquivAlgOfEq R hIe').symm
      (Ideal.Quotient.mk (Ideal.span {e0}) b)) = f b
    rw [h1]
    exact Ideal.quotientKerAlgEquivOfSurjective_mk hf b
  change f b = qiso' (Ideal.Quotient.mk (Ideal.span {e0}) b)
  exact hqiso'_mk.symm

/-- The binary product fan of a product decomposition is a limit in the full
subcategory of finite etale algebras. -/
noncomputable def productFan_isLimit
    {A B C : Type} [CommRing A] [Algebra R A] [Module.Finite R A] [Algebra.Etale R A]
    [CommRing B] [Algebra R B] [Module.Finite R B] [Algebra.Etale R B]
    [CommRing C] [Algebra R C] [Module.Finite R C] [Algebra.Etale R C]
    (e : B ≃ₐ[R] A × C) :
    IsLimit (BinaryFan.mk
      (CommAlgCat.FiniteEtale.ofHom ((AlgHom.fst R A C).comp e.toAlgHom))
      (CommAlgCat.FiniteEtale.ofHom ((AlgHom.snd R A C).comp e.toAlgHom))) := by
  let fstE : B →ₐ[R] A := (AlgHom.fst R A C).comp e.toAlgHom
  let sndE : B →ₐ[R] C := (AlgHom.snd R A C).comp e.toAlgHom
  let fan : BinaryFan (CommAlgCat.FiniteEtale.of R A) (CommAlgCat.FiniteEtale.of R C) :=
    BinaryFan.mk (CommAlgCat.FiniteEtale.ofHom fstE) (CommAlgCat.FiniteEtale.ofHom sndE)
  let liftAlgOf {T : CommAlgCat.FiniteEtale R}
      (f : T ⟶ CommAlgCat.FiniteEtale.of R A) (g : T ⟶ CommAlgCat.FiniteEtale.of R C) :
      T.obj →ₐ[R] B :=
    e.symm.toAlgHom.comp (AlgHom.prod f.hom.hom g.hom.hom)
  refine BinaryFan.IsLimit.mk fan (fun {T} f g => ?_) ?_ ?_ ?_
  · exact ObjectProperty.homMk (CommAlgCat.ofHom (liftAlgOf f g))
  · intro T f g
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro x
    change (AlgHom.fst R A C) (e (e.symm (AlgHom.prod f.hom.hom g.hom.hom x))) =
      f.hom.hom x
    rw [AlgEquiv.apply_symm_apply]
    exact AlgHom.congr_fun (AlgHom.fst_prod f.hom.hom g.hom.hom) x
  · intro T f g
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro x
    change (AlgHom.snd R A C) (e (e.symm (AlgHom.prod f.hom.hom g.hom.hom x))) =
      g.hom.hom x
    rw [AlgEquiv.apply_symm_apply]
    exact AlgHom.congr_fun (AlgHom.snd_prod f.hom.hom g.hom.hom) x
  · intro T f g m hm1 hm2
    apply ObjectProperty.hom_ext
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro x
    apply e.injective
    change e (m.hom.hom x) = e (liftAlgOf f g x)
    rw [show liftAlgOf f g x = e.symm (AlgHom.prod f.hom.hom g.hom.hom x) from rfl,
      e.apply_symm_apply]
    ext
    · change (e (m.hom.hom x)).1 = f.hom.hom x
      have h1 := congrArg (fun (q : T ⟶ CommAlgCat.FiniteEtale.of R A) => q.hom.hom x) hm1
      exact h1
    · change (e (m.hom.hom x)).2 = g.hom.hom x
      have h2 := congrArg (fun (q : T ⟶ CommAlgCat.FiniteEtale.of R C) => q.hom.hom x) hm2
      exact h2

/-- Every monomorphism in the opposite of the category of finite etale
algebras is an isomorphism on a direct summand. -/
theorem monoInducesIsoOnDirectSummand_finiteEtaleAlg
    {X Y : (CommAlgCat.FiniteEtale.{0} R)ᵒᵖ} (i : X ⟶ Y) [Mono i] :
    ∃ (Z : (CommAlgCat.FiniteEtale.{0} R)ᵒᵖ) (u : Z ⟶ Y),
      Nonempty (IsColimit (BinaryCofan.mk i u)) := by
  let A := X.unop
  let B := Y.unop
  haveI hEpi : Epi i.unop := inferInstance
  have hsurj : Function.Surjective (fun b : B.obj => i.unop.hom.hom b) :=
    epi_surjective_of_finiteEtale i.unop
  obtain ⟨C, hCR, hAlg, hFin, hEt, e, he⟩ :=
    exists_prod_algEquiv_of_surjective (R := R) (A := A.obj) (B := B.obj)
      i.unop.hom.hom hsurj
  let Cobj : CommAlgCat.FiniteEtale.{0} R := CommAlgCat.FiniteEtale.of R C
  let g : B.obj →ₐ[R] C := (AlgHom.snd R A.obj C).comp e.toAlgHom
  let Z : (CommAlgCat.FiniteEtale.{0} R)ᵒᵖ := Opposite.op Cobj
  let u : Z ⟶ Y := (CommAlgCat.FiniteEtale.ofHom g).op
  refine ⟨Z, u, ?_⟩
  have hiunop : i.unop = ObjectProperty.homMk (CommAlgCat.ofHom (i.unop.hom.hom)) := by
    apply ObjectProperty.hom_ext
    exact (CommAlgCat.ofHom_hom i.unop.hom).symm
  have hfan : BinaryFan.mk i.unop u.unop =
      BinaryFan.mk
        (CommAlgCat.FiniteEtale.ofHom ((AlgHom.fst R A.obj C).comp e.toAlgHom))
        (CommAlgCat.FiniteEtale.ofHom g) := by
    rw [hiunop, he]
    rfl
  have hlim : IsLimit (BinaryFan.mk i.unop u.unop) := by
    rw [hfan]
    exact productFan_isLimit (R := R) (A := A.obj) (B := B.obj) (C := C) e
  exact ⟨by simpa using BinaryFan.IsLimit.op hlim⟩

end S1830G3

/-! ## Part 3: the two S1779 missing propositions at R' -/

namespace S1830Main

/-- (G2) at the actual coordinate ring R': S1779's S1779QuotientsMissing. -/
theorem S1830QuotientsMissing : S1779QuotientsMissing := by
  intro G _ _
  exact S1830G2.hasQuotientsByFiniteGroups (R := S1779R) (G := G)

/-- (G3) at the actual coordinate ring R': S1779's S1779MonoMissing. -/
theorem S1830MonoMissing : S1779MonoMissing := by
  intro X Y i hi
  haveI : Mono i := hi
  exact S1830G3.monoInducesIsoOnDirectSummand_finiteEtaleAlg (R := S1779R) (X := X) (Y := Y) i

/-- Both exact missing algebra-side fields of S1779, discharged. -/
theorem S1830AlgPreGaloisMissing : S1779AlgPreGaloisMissing :=
  ⟨S1830QuotientsMissing, S1830MonoMissing⟩

/-- The unconditional algebra-side PreGaloisCategory on
(FiniteEtale R')^op, via S1779's terminal/pullback/finite-coproduct fields. -/
theorem S1830PreGaloisCategory : PreGaloisCategory S1779AlgR :=
  S1779PreGaloisCategory_of_missing S1830AlgPreGaloisMissing

end S1830Main


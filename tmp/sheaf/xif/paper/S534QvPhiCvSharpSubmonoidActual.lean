import tmp.sheaf.xif.paper.S522QvPhiRamificationModelActual
import tmp.sheaf.xif.paper.S438QVFamilyKSideCandidateActual

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 3000000

/-! # S534: Phi_Cv^sharp = N * qOrder submonoid and ramification pullback_mem -/

namespace LeanFormal.IUT.XiFPaper.S534QvPhiCvSharpSubmonoidActual

open CategoryTheory
open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.N8Closure
open LeanFormal.IUT.XiFPaper.S522QvPhiRamificationModelActual
open LeanFormal.IUT.XiFPaper.S438QVFamilyKSideCandidateActual

universe u
variable {l : PrimeGeFive}
variable (T : SourceNativeInitialThetaData.{0} l)
variable (b : Bad (nativePlaceSelection T))

/-- The K-side q_v order, actual from qVFamilyK.order. -/
noncomputable def qvKOrder : ℕ := (qVFamilyK T b).order

/-- Φ_Cv^sharp submonoid generated by `g`: the `k*g` multiples in `ULift Nat`. -/
noncomputable def sharpSubmonoid (g : ℕ) : AddSubmonoid (ULift.{u+1} ℕ) where
  carrier := { x | ∃ k : ℕ, x = ULift.up (k * g) }
  zero_mem' := ⟨0, by apply ULift.ext; simp⟩
  add_mem' := by
    rintro x y ⟨i, rfl⟩ ⟨j, rfl⟩
    exact ⟨i + j, by apply ULift.ext; simp [Nat.add_mul]⟩

theorem sharpSubmonoid_generator_mem (g : ℕ) :
    (ULift.up g : ULift.{u+1} ℕ) ∈ sharpSubmonoid  g := by
  exact ⟨1, by simp⟩

/-- N * qOrder is the chosen q_v submonoid generator. -/
noncomputable def qvSharpGenerator (N : ℕ) : ℕ := N * qvKOrder (l := l) T b

noncomputable def qvSharpSubmonoid (N : ℕ) : AddSubmonoid (ULift.{u+1} ℕ) :=
  sharpSubmonoid  (qvSharpGenerator (l := l) T b N)

theorem qvSharpGenerator_mem (N : ℕ) :
    (ULift.up (qvSharpGenerator (l := l) T b N) : ULift.{u+1} ℕ) ∈
      qvSharpSubmonoid (l := l) T b N := by
  exact sharpSubmonoid_generator_mem  (qvSharpGenerator (l := l) T b N)

/-- Ramification pullback `n ↦ e n` preserves every `g`-multiple submonoid. -/
theorem sharpSubmonoid_pullback_mem (g e : ℕ)
    {x : ULift.{u+1} ℕ} (hx : x ∈ sharpSubmonoid  g) :
    uliftNatMulLeft e x ∈ sharpSubmonoid  g := by
  rcases hx with ⟨k, rfl⟩
  refine ⟨e * k, ?_⟩
  apply ULift.ext
  simp [uliftNatMulLeft, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm]

theorem qvSharpSubmonoid_pullback_mem (N : ℕ)
    {x : ULift.{u+1} ℕ} (hx : x ∈ qvSharpSubmonoid (l := l) T b N)
    (e : ℕ) :
    uliftNatMulLeft e x ∈ qvSharpSubmonoid (l := l) T b N := by
  exact sharpSubmonoid_pullback_mem  (qvSharpGenerator (l := l) T b N) e hx

end LeanFormal.IUT.XiFPaper.S534QvPhiCvSharpSubmonoidActual

end

/-- If f (1 - e) = 0 and the closed fibre of f is an isomorphism, then 1 - e lies in m A. -/
theorem S1910OneSubEMemSmul {A B : CommAlgCat.FiniteEtale.{0} S1779R} (f : A ⟶ B)
    (hf : IsIso ((S1848BCF).map f)) (e : (A : Type)) (hf1e : f.hom.hom (1 - e) = 0) :
    (1 - e) ∈ S1849m • (⊤ : Submodule S1779R (A : Type)) := by
  have hbij : Function.Bijective
      (Algebra.TensorProduct.map (AlgHom.id S1779K S1779K) f.hom.hom) := by
    have hb := S1848bijective_of_isIso ((S1848BCF).map f) hf
    simpa [S1848BCF, CommAlgCat.FiniteEtale.baseChange, CommAlgCat.FiniteEtale.ofHom] using hb
  have h1e : (1 : S1779K) ⊗ₜ[S1779R] (1 - e) = 0 := by
    apply hbij.1
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hf1e, TensorProduct.tmul_zero, map_zero]
  have hB : (1 : S1779R ⧸ S1849m) ⊗ₜ[S1779R] (1 - e) = 0 := by
    have he1 : S1849FEquivQuot.toLinearEquiv (1 : S1779K) = 1 := map_one S1849FEquivQuot
    have hcongr : (TensorProduct.congr S1849FEquivQuot.toLinearEquiv
          (LinearEquiv.refl S1779R (A : Type)))
        ((1 : S1779K) ⊗ₜ[S1779R] (1 - e)) = 0 := by
      rw [h1e, map_zero]
    rwa [TensorProduct.congr_tmul, LinearEquiv.refl_apply, he1] at hcongr
  have hC : (Submodule.Quotient.mk (1 - e) :
      (A : Type) ⧸ (S1849m • (⊤ : Submodule S1779R (A : Type)))) = 0 := by
    have h := congrArg (TensorProduct.quotTensorEquivQuotSMul (A : Type) S1849m) hB
    simpa using h
  exact (Submodule.Quotient.mk_eq_zero _).mp hC

/-- The support ideal C = (1 - e) A is m-divisible: C = m C. -/
theorem S1910SupportIdeal_smul_eq {A : CommAlgCat.FiniteEtale.{0} S1779R} (e : (A : Type))
    (he : IsIdempotentElem e)
    (hmemA : (1 - e) ∈ S1849m • (⊤ : Submodule S1779R (A : Type))) :
    (Ideal.span ({1 - e} : Set (A : Type))).restrictScalars S1779R =
      S1849m • (Ideal.span ({1 - e} : Set (A : Type))).restrictScalars S1779R := by
  let C : Submodule S1779R (A : Type) :=
    (Ideal.span ({1 - e} : Set (A : Type))).restrictScalars S1779R
  have h1eC : (1 - e) ∈ S1849m • C := by
    have h : (1 - e) * (1 - e) ∈ S1849m • C := by
      refine Submodule.smul_induction_on (p := fun z : A => (1 - e) * z ∈ S1849m • C)
        hmemA ?_ ?_
      · intro r hr a _
        rw [Algebra.mul_smul_comm]
        refine Submodule.smul_mem_smul hr ?_
        show (1 - e) * a ∈ Ideal.span ({1 - e} : Set (A : Type))
        exact Ideal.mem_span_singleton.mpr ⟨a, rfl⟩
      · intro x y hx hy
        rw [mul_add]
        exact add_mem hx hy
    rwa [he.one_sub.eq] at h
  have hclosed : ∀ (a : A) ⦃z : A⦄, z ∈ S1849m • C → z * a ∈ S1849m • C := by
    intro a z hz
    refine Submodule.smul_induction_on (p := fun z : A => z * a ∈ S1849m • C) hz ?_ ?_
    · intro r hr c hc
      rw [Algebra.smul_mul_assoc]
      refine Submodule.smul_mem_smul hr ?_
      have hc' : c ∈ Ideal.span ({1 - e} : Set (A : Type)) := hc
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hc'
      show c * a ∈ Ideal.span ({1 - e} : Set (A : Type))
      rw [hb, mul_assoc]
      exact Ideal.mem_span_singleton.mpr ⟨b * a, rfl⟩
    · intro x y hx hy
      rw [add_mul]
      exact add_mem hx hy
  have hCs : C ≤ S1849m • C := by
    intro c hc
    have hc' : c ∈ Ideal.span ({1 - e} : Set (A : Type)) := hc
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hc'
    rw [ha]
    exact hclosed a h1eC
  refine le_antisymm hCs ?_
  exact Submodule.smul_le.mpr (fun r _ c hc => C.smul_mem r hc)

/-- A finite etale A with (1 - e) in m A and e idempotent has e = 1. -/
theorem S1910SupportIdempotent_eq_one {A : CommAlgCat.FiniteEtale.{0} S1779R} (e : (A : Type))
    (he : IsIdempotentElem e)
    (hmemA : (1 - e) ∈ S1849m • (⊤ : Submodule S1779R (A : Type))) : e = 1 := by
  let C : Submodule S1779R (A : Type) :=
    (Ideal.span ({1 - e} : Set (A : Type))).restrictScalars S1779R
  have hmC : C = S1849m • C := S1910SupportIdeal_smul_eq e he hmemA
  haveI hFA : Module.Finite S1779R (A : Type) := A.property.left
  haveI hEA : Algebra.Etale S1779R (A : Type) := A.property.right
  haveI hFlatA : Module.Flat S1779R (A : Type) := inferInstance
  have hCfg : C.FG := by
    haveI : IsNoetherianRing S1779R := S1849_isNoetherian
    exact Module.Finite.iff_fg.mp inferInstance
  have hCbot : C = ⊥ := S1862_eq_bot_of_smul_eq (M := (A : Type)) C hCfg hmC
  have hmem : (1 - e) ∈ C := by
    show (1 - e) ∈ Ideal.span ({1 - e} : Set (A : Type))
    exact Ideal.subset_span (by simp)
  rw [hCbot] at hmem
  have h0 : 1 - e = 0 := by simpa using hmem
  exact (sub_eq_zero.mp h0).symm

/-- S1849KernelVanishes, unconditionally.  For a map of finite etale R'-algebras whose
closed fibre at m = (0,0) is an isomorphism, the underlying algebra map is injective. -/
theorem S1910KernelVanishes : S1849KernelVanishes := by
  intro A B f hf
  letI : Algebra (A : Type) (B : Type) := f.hom.hom.toRingHom.toAlgebra
  haveI hST : IsScalarTower S1779R (A : Type) (B : Type) := by
    refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
    change (algebraMap S1779R (B : Type)) r =
      f.hom.hom ((algebraMap S1779R (A : Type)) r)
    exact (f.hom.hom.commutes r).symm
  obtain ⟨e, he, hsupp⟩ := S1842ExistsIdempotentSupport f
  have hf1e : f.hom.hom (1 - e) = 0 := by
    have h := S1842OneSubESmulOne f e he hsupp
    rwa [Algebra.smul_def, mul_one] at h
  have hmemA : (1 - e) ∈ S1849m • (⊤ : Submodule S1779R (A : Type)) :=
    S1910OneSubEMemSmul f hf e hf1e
  have he1 : e = 1 := S1910SupportIdempotent_eq_one e he hmemA
  have hsupp_top : Module.support (A : Type) (B : Type) = ⊤ := by
    rw [hsupp, he1, PrimeSpectrum.basicOpen_one]
    simp
  haveI hFA : Module.Finite S1779R (A : Type) := A.property.left
  haveI hFB : Module.Finite S1779R (B : Type) := B.property.left
  haveI hFinAB : Module.Finite (A : Type) (B : Type) :=
    Module.Finite.of_restrictScalars_finite S1779R (A : Type) (B : Type)
  haveI hEtaleAB : Algebra.Etale (A : Type) (B : Type) := S1842EtaleOfHom f
  haveI hFlatAB : Module.Flat (A : Type) (B : Type) := inferInstance
  haveI hFF : Module.FaithfullyFlat (A : Type) (B : Type) := by
    refine Module.FaithfullyFlat.mk ?_
    intro m hm htop
    let p : PrimeSpectrum (A : Type) := ⟨m, hm.isPrime⟩
    have hp : p ∈ Module.support (A : Type) (B : Type) := by
      rw [hsupp_top]
      exact Set.mem_univ p
    have hpq : p ∈ Module.support (A : Type)
        ((B : Type) ⧸ (m • (⊤ : Submodule (A : Type) (B : Type)))) := by
      rw [Module.support_quotient (M := (B : Type)) m]
      exact ⟨hp, by rw [PrimeSpectrum.mem_zeroLocus p (m : Set (A : Type))]⟩
    haveI hsub : Subsingleton
        ((B : Type) ⧸ (m • (⊤ : Submodule (A : Type) (B : Type)))) := by
      rw [Submodule.Quotient.subsingleton_iff]
      exact htop
    have hempty : Module.support (A : Type)
        ((B : Type) ⧸ (m • (⊤ : Submodule (A : Type) (B : Type)))) = ∅ :=
      Module.support_eq_empty
    rw [hempty] at hpq
    exact hpq
  haveI : FaithfulSMul (A : Type) (B : Type) := Module.FaithfullyFlat.faithfulSMul
  intro x y hxy
  exact FaithfulSMul.algebraMap_injective (A : Type) (B : Type) hxy

/-- S1862FiberPurity holds. -/
theorem S1910FiberPurity : S1862FiberPurity := by
  intro A B f hf
  have hinj : Function.Injective f.hom.hom := S1910KernelVanishes f hf
  have hJ : S1862Ker f = ⊥ := by
    apply LinearMap.ker_eq_bot.mpr
    intro x y hxy
    exact hinj hxy
  rw [hJ, Submodule.smul_bot]


open LeanFormal.IUT.XiFPaper.Mzk1TensorCoreWitnessActual
namespace LeanFormal.IUT.XiFPaper.Mzk1P6PhiActionFamilyActual
universe u v w
variable {K : Type u} [Field K] [NumberField K] {p : Nat} [Fact p.Prime]
variable {ι : Type v} [Fintype ι] [DecidableEq ι]
variable {V : ι -> Type w} [∀ i, Fintype (V i)] [∀ i, DecidableEq (V i)]
variable (places : (i : ι) -> V i -> FinitePlaceAtPrime K p)
variable (tuple : (i : ι) -> V i)
variable [MeasurableSpace (ArithmeticTensorTupleBlock places tuple)]
variable [BorelSpace (ArithmeticTensorTupleBlock places tuple)]
/-- Actual action family: all linear automorphisms of the tensor block that
preserve the unit log lattice. -/
def p6Phi : Set (ArithmeticTensorTupleBlock places tuple ≃ₗ[ℚ_[p]]
    ArithmeticTensorTupleBlock places tuple) :=
  {phi | ∀ u, u ∈ arithmeticTupleUnitLogLattice places tuple ->
    phi u ∈ arithmeticTupleUnitLogLattice places tuple}
theorem p6Phi_preserves
    {phi : ArithmeticTensorTupleBlock places tuple ≃ₗ[ℚ_[p]]
      ArithmeticTensorTupleBlock places tuple} (hphi : phi ∈ p6Phi places tuple) :
    ∀ u, u ∈ arithmeticTupleUnitLogLattice places tuple ->
      phi u ∈ arithmeticTupleUnitLogLattice places tuple :=
  hphi
/-- The actual packet hull generated by the actual Phi action family. -/
noncomputable def p6PacketHull
    {J : Type (max u v)} [Finite J] {E : J -> Type (max u v)}
    [∀ j, NormedField (E j)] [∀ j, NormedAlgebra ℚ_[p] (E j)]
    [∀ j, FiniteDimensional ℚ_[p] (E j)] [∀ j, ProperSpace (E j)]
    (e : ArithmeticTensorTupleBlock places tuple ≃ₐ[ℚ_[p]] ((j : J) -> E j))
    (istar : ι) (varpi : CommonPrimeCompletion (places istar (tuple istar))) :
    Set (ArithmeticTensorTupleBlock places tuple) :=
  arithmeticTupleHolomorphicHull places tuple e
    (arithmeticTupleStepVPossibleImages places tuple istar varpi (p6Phi places tuple))
/-- Every actual theta possible image lies in the actual packet hull. -/
theorem p6_possibleImages_subset_packetHull
    {J : Type (max u v)} [Finite J] {E : J -> Type (max u v)}
    [∀ j, NormedField (E j)] [∀ j, NormedAlgebra ℚ_[p] (E j)]
    [∀ j, FiniteDimensional ℚ_[p] (E j)] [∀ j, ProperSpace (E j)]
    (e : ArithmeticTensorTupleBlock places tuple ≃ₐ[ℚ_[p]] ((j : J) -> E j))
    (istar : ι) (varpi : CommonPrimeCompletion (places istar (tuple istar))) :
    arithmeticTupleStepVPossibleImages places tuple istar varpi (p6Phi places tuple) ⊆
      p6PacketHull places tuple e istar varpi :=
  subset_arithmeticTupleHolomorphicHull places tuple e _

/-
Route 7.2: the abstract chain-ring monogenic lemma.

Setting.  p is a prime, k is a finite field which is a (ZMod p)-algebra, and e ≥ 1.
Write A = k[T]/(T^e) = AdjoinRoot (X^e) for the truncated polynomial ring (the finite
chain ring with residue field k), and let x be the class of T, so x^e = 0.  The main
theorem below produces a single element γ of A which generates A as a (ZMod p)-algebra:

  adjoin_chainRing_eq_top:  there is γ : AdjoinRoot (X^e) with
  Algebra.adjoin (ZMod p) {γ} = ⊤.

Mathematically: take a primitive element ζ of k over F_p (it exists because k is a finite
field) and set γ = ζ + x.  Write f = [k : F_p], so that k has p^f elements, and put
N = p^(f*e) = |k|^e.  Then

* x^N = 0 because N ≥ e and x^e = 0;
* ζ^N = ζ because every element of the finite field k satisfies ζ^(|k|) = ζ;
* in characteristic p, freshman's dream gives γ^N = (ζ + x)^N = ζ^N + x^N = ζ.

Hence the (ZMod p)-subalgebra generated by γ contains ζ, and then it also contains
x = γ - ζ.  Since k is generated over ZMod p by ζ, that subalgebra contains the image of
k and x; but A = k[x] (AdjoinRoot.adjoinRoot_eq_top), so it is all of A.

This is exactly the missing residue-ring input of route 7.2: the residue ring
O_L/pO_L = k[T]/(T^e) of a p-adic local field is monogenic over F_p, which feeds
exists_monogenicIntegers_of_residue_generator in
Mzk1G1UniversalMonogenicExistenceActual.
-/
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.FieldTheory.Finiteness
import Mathlib.Algebra.CharP.Algebra
import Mathlib.Algebra.CharP.Lemmas
import Mathlib.Tactic

noncomputable section

open Polynomial

namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalChainRingMonogenicActual

set_option maxHeartbeats 1000000

variable {p : Nat} [Fact p.Prime] {k : Type*} [Field k] [Algebra (ZMod p) k] [Finite k]

/-- **Route 7.2, abstract chain-ring lemma.**  The truncated polynomial ring k[T]/(T^e)
(a finite chain ring with residue field k) is generated over ZMod p by one element. -/
theorem adjoin_chainRing_eq_top (e : Nat) (he : 0 < e) :
    ∃ γ : AdjoinRoot (X ^ e : k[X]),
      Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X]))) = ⊤ := by
  classical
  haveI hFintype : Fintype k := Fintype.ofFinite k
  -- A primitive element of k over ZMod p.
  obtain ⟨ζ, hζ⟩ := Field.exists_primitive_element_of_finite_top (ZMod p) k
  have hζ' : Algebra.adjoin (ZMod p) ({ζ} : Set k) = ⊤ :=
    (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic
      (Algebra.IsAlgebraic.isAlgebraic ζ)).mp hζ
  -- The chain ring, the class x of T, and the candidate generator γ = ζ + x.
  let x : AdjoinRoot (X ^ e : k[X]) := AdjoinRoot.root (X ^ e)
  let γ : AdjoinRoot (X ^ e : k[X]) := algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ + x
  have hx_eq : x = AdjoinRoot.root (X ^ e) := rfl
  have hγ_eq : γ = algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ + x := rfl
  refine ⟨γ, ?_⟩
  -- x is nilpotent.
  have hxe : x ^ e = 0 := by
    have h := AdjoinRoot.eval₂_root (f := (X ^ e : k[X]))
    rw [hx_eq]
    simpa using h
  -- The chain ring is nontrivial, hence has characteristic p.
  haveI hAne : Nontrivial (AdjoinRoot (X ^ e : k[X])) := by
    have h : (1 : AdjoinRoot (X ^ e : k[X])) ≠ 0 := by
      have h' := AdjoinRoot.mk_ne_zero_of_natDegree_lt (f := (X ^ e : k[X])) (monic_X_pow e)
        (g := (1 : k[X])) one_ne_zero (by simpa using he)
      simpa using h'
    exact ⟨⟨0, 1, fun h0 => h h0.symm⟩⟩
  haveI hcharA : CharP (AdjoinRoot (X ^ e : k[X])) p :=
    CharP.of_ringHom_of_ne_zero (algebraMap (ZMod p) (AdjoinRoot (X ^ e : k[X]))) p
      (Fact.out : p.Prime).ne_zero
  -- |k| = p^f for f = [k : ZMod p].
  let f : Nat := Module.finrank (ZMod p) k
  have hcard : Fintype.card k = p ^ f := by
    have h1 : Nat.card k = Nat.card (ZMod p) ^ Module.finrank (ZMod p) k :=
      Module.natCard_eq_pow_finrank (K := ZMod p) (V := k)
    rw [Nat.card_zmod, Nat.card_eq_fintype_card] at h1
    simpa using h1
  -- The Frobenius exponent N = |k|^e = p^(f*e).
  let N : Nat := (Fintype.card k) ^ e
  have hNdef : N = p ^ (f * e) := by
    show (Fintype.card k) ^ e = p ^ (f * e)
    rw [hcard, ← pow_mul]
  have htwo : ∀ n : Nat, n ≤ 2 ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ m ih =>
        have hm : 0 < 2 ^ m := pow_pos (by norm_num) m
        rw [pow_succ, mul_two]
        omega
  have hNge : e ≤ N := by
    show e ≤ (Fintype.card k) ^ e
    exact le_trans (htwo e) (Nat.pow_le_pow_left Fintype.one_lt_card e)
  have hζN : ζ ^ N = ζ := by
    show ζ ^ ((Fintype.card k) ^ e) = ζ
    exact FiniteField.pow_card_pow e ζ
  have hxN : x ^ N = 0 := by
    obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le hNge
    rw [hc, pow_add, hxe, zero_mul]
  -- Freshman's dream: γ^N = ζ.
  have hγN : γ ^ N = algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ := by
    have h := add_pow_char_pow (algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ) x (p := p)
      (n := f * e)
    have h1 : (algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ) ^ (p ^ (f * e))
        = algebraMap k (AdjoinRoot (X ^ e : k[X])) (ζ ^ (p ^ (f * e))) :=
      (map_pow (algebraMap k (AdjoinRoot (X ^ e : k[X]))) ζ (p ^ (f * e))).symm
    have h2 : ζ ^ (p ^ (f * e)) = ζ := by rw [← hNdef]; exact hζN
    have h3 : x ^ (p ^ (f * e)) = 0 := by rw [← hNdef]; exact hxN
    calc γ ^ N = γ ^ (p ^ (f * e)) := by rw [hNdef]
      _ = (algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ + x) ^ (p ^ (f * e)) := by rw [hγ_eq]
      _ = (algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ) ^ (p ^ (f * e))
            + x ^ (p ^ (f * e)) := h
      _ = algebraMap k (AdjoinRoot (X ^ e : k[X])) (ζ ^ (p ^ (f * e)))
            + x ^ (p ^ (f * e)) := by rw [h1]
      _ = algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ + x ^ (p ^ (f * e)) := by rw [h2]
      _ = algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ := by rw [h3, add_zero]
  -- ζ and x both lie in the subalgebra generated by γ.
  have hγB : γ ∈ Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X]))) :=
    Algebra.subset_adjoin (Set.mem_singleton γ)
  have hζB : algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ ∈
      Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X]))) := by
    rw [← hγN]
    exact pow_mem hγB N
  have hxB : x ∈ Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X]))) := by
    have hsub :=
      Subalgebra.sub_mem (Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X]))))
        hγB hζB
    have hxeq : γ - algebraMap k (AdjoinRoot (X ^ e : k[X])) ζ = x := by
      rw [hγ_eq]
      rw [add_sub_cancel_left]
    rwa [hxeq] at hsub
  -- The image of k lies in the subalgebra, because ζ generates k over ZMod p.
  have hk_mem : ∀ c : k, algebraMap k (AdjoinRoot (X ^ e : k[X])) c ∈
      Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X]))) := by
    intro c
    have hc : c ∈ Algebra.adjoin (ZMod p) ({ζ} : Set k) := by
      rw [hζ']
      exact Algebra.mem_top
    refine Algebra.adjoin_induction (R := ZMod p) (s := ({ζ} : Set k))
      (p := fun y (_ : y ∈ Algebra.adjoin (ZMod p) ({ζ} : Set k)) =>
        algebraMap k (AdjoinRoot (X ^ e : k[X])) y ∈
          Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X])))) ?_ ?_ ?_ ?_ hc
    · intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact hζB
    · intro r
      have h : algebraMap k (AdjoinRoot (X ^ e : k[X])) (algebraMap (ZMod p) k r)
          = algebraMap (ZMod p) (AdjoinRoot (X ^ e : k[X])) r :=
        (IsScalarTower.algebraMap_apply (R := ZMod p) (S := k)
          (A := AdjoinRoot (X ^ e : k[X])) r).symm
      rw [h]
      exact Subalgebra.algebraMap_mem _ r
    · intro y z hy hz ihy ihz
      rw [map_add]
      exact Subalgebra.add_mem _ ihy ihz
    · intro y z hy hz ihy ihz
      rw [map_mul]
      exact Subalgebra.mul_mem _ ihy ihz
  -- A = k[x] and x is in the subalgebra, so we are done.
  refine Algebra.eq_top_iff.mpr (fun a => ?_)
  have htop : Algebra.adjoin k ({x} : Set (AdjoinRoot (X ^ e : k[X]))) = ⊤ := by
    have hxroot : ({x} : Set (AdjoinRoot (X ^ e : k[X])))
        = {AdjoinRoot.root (X ^ e)} := by rw [hx_eq]
    rw [hxroot]
    exact AdjoinRoot.adjoinRoot_eq_top
  have ha : a ∈ Algebra.adjoin k ({x} : Set (AdjoinRoot (X ^ e : k[X]))) := by
    rw [htop]
    exact Algebra.mem_top
  exact Algebra.adjoin_induction (R := k) (s := ({x} : Set (AdjoinRoot (X ^ e : k[X]))))
    (p := fun y (_ : y ∈ Algebra.adjoin k ({x} : Set (AdjoinRoot (X ^ e : k[X])))) =>
      y ∈ Algebra.adjoin (ZMod p) ({γ} : Set (AdjoinRoot (X ^ e : k[X]))))
    (fun y hy => by
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact hxB)
    (fun r => hk_mem r)
    (fun y z hy hz ihy ihz => Subalgebra.add_mem _ ihy ihz)
    (fun y z hy hz ihy ihz => Subalgebra.mul_mem _ ihy ihz)
    ha

#print axioms adjoin_chainRing_eq_top

end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalChainRingMonogenicActual

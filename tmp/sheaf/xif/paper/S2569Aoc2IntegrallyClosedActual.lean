import tmp.sheaf.xif.paper.S2566AdjoinIntegralCActual
import Mathlib.RingTheory.LocalProperties.IntegrallyClosed

/-!
# S2569: integral closedness of the order Aoc2 = R[HZc2-roots]

## The objects

* R = Z[1/Cden] (S2565ConcreteIntegralClosureCActual.R, the same ring as
  S2562HZcMonicCActual.R2), L = S1720Field = SplittingField S1720H;
* S = O_{F'}[1/Cden] is the integral closure of R in L
  (S2555_isIntegralClosure);
* HZc2 = C ((cu2)^-1) * S2481HZ.map (algebraMap Z R2) is the monic
  normalisation over R2 of the integer model S2481HZ of S1720H
  (S2562HZcMonicCActual.HZc2, monic by HZc2_monic), and discr_unit
  (S2564DiscrUnitActual) says that the discriminant of S2481HZ is a unit
  of R2;
* Aoc2 = Algebra.adjoin R (HZc2.rootSet L) is the R-order generated by all
  roots of HZc2 in L (S2566AdjoinIntegralCActual.Aoc2).

## What this file proves (all unconditional, no sorry/axiom)

1. HZc2_rootSet_eq : HZc2.rootSet L = S1720H.rootSet L, hence
   adjoin_rootSet_top : Algebra.adjoin Q (HZc2.rootSet L) = top: the roots
   of HZc2 generate L over Q.
2. isFractionRing_Aoc2 : IsFractionRing Aoc2 L.  The proof is the order-C
   transcription of S2559IsFractionRingAdjoinActual: every element of L is
   a quotient a / b with a, b in Aoc2 and b nonzero.
3. finite_Aoc2 : Module.Finite R Aoc2 and (hence) Algebra.IsIntegral R Aoc2;
   isIntegralClosure_S_Aoc2 : IsIntegralClosure S Aoc2 L (the integral
   closure of Aoc2 in L is still S, since Aoc2 is integral over R).
4. **The exact reduction of the target**:
   isIntegrallyClosed_iff_forall_mem :
   IsIntegrallyClosed Aoc2 <-> (forall s : S, algebraMap S L s in Aoc2),
   i.e. IsIntegrallyClosed Aoc2 is *equivalent* to the maximality statement
   S subset Aoc2 (Aoc2 = S, since Aoc2 subset S always).  This is the
   concrete remaining order-theoretic computation.
5. **The local-global reduction** requested for this packet:
   IsIntegrallyClosed_Aoc2_of_local :
   (forall p : Ideal Aoc2, p != bot -> [p.IsMaximal] ->
     IsIntegrallyClosed (Localization.AtPrime p)) -> IsIntegrallyClosed Aoc2,
   together with the equivalence isIntegrallyClosed_iff_local and the
   equivalence orderMaximal_iff_local saying that the global maximality
   statement is equivalent to all localisations (Aoc2)_p being integrally
   closed.

## What is *not* proved here

The target IsIntegrallyClosed Aoc2 itself is **not** proved in this file.
The remaining mathematical input is exactly

  OrderIsMaximal : forall s : S, algebraMap S L s in Aoc2,

equivalently LocalIntegrallyClosedGoal, equivalently Aoc2 = S.  This is the
order-theoretic content that must be extracted from the discriminant
computation (S2564DiscrUnitActual) together with a finite-etale / index
computation for the order generated by the roots.  Mathlib has no ready
theorem "finite etale over a normal domain is integrally closed", and the
algebra R2[X]/(HZc2) is *not* Aoc2 because HZc2 is reducible
(S1720H = S1687H * (X^2 + 1)), so the unit discriminant does not directly
make Aoc2 finite etale; the missing step is the comparison of the
multi-generated order Aoc2 with S.

Route (A) of the task (finite etale / local-global) is therefore reduced
here to (B) plus the equivalence with the concrete maximality statement.
-/

noncomputable section
set_option maxHeartbeats 16000000
set_option maxRecDepth 100000
open Polynomial

namespace LeanFormal.IUT.XiFPaper.S2569Aoc2IntegrallyClosedActual

open LeanFormal.IUT.XiFPaper.S2565ConcreteIntegralClosureCActual
open LeanFormal.IUT.XiFPaper.S2562HZcMonicCActual
open LeanFormal.IUT.XiFPaper.S2566AdjoinIntegralCActual
open LeanFormal.IUT.XiFPaper.S2481PairTransitiveHardActual
open LeanFormal.IUT.XiFPaper.S1720SourceArithmeticActual

/-- HZc2 is a polynomial over R2 while all the S2555/S2565 algebra
structures on L are stated for the definitionally equal ring R; this
local instance is the same bridge as in S2566AdjoinIntegralCActual. -/
local instance : Algebra S2562HZcMonicCActual.R2 L := inferInstanceAs (Algebra R L)

/-! ## 1. The two polynomials have the same roots in L -/

/-- The integer cast Z -> Q is the canonical ring homorphism. -/
lemma algebraMap_int_rat : (algebraMap ℤ ℚ) = Int.castRingHom ℚ := RingHom.ext_int _ _

/-- Over L, the polynomial HZR2 = S2481HZ.map (algebraMap Z R2) evaluates
like the defining polynomial S1720H of L. -/
lemma HZR2_map_eq : HZR2.map (algebraMap R2 L) = S1720H.map (algebraMap ℚ L) := by
  have h : (algebraMap R2 L).comp (algebraMap ℤ R2) = (algebraMap ℚ L).comp (algebraMap ℤ ℚ) :=
    RingHom.ext_int _ _
  rw [HZR2, Polynomial.map_map, h, ← Polynomial.map_map, algebraMap_int_rat, S2481HZ_map_rat]

/-- HZc2 and S1720H differ over L by the nonzero scalar cu2^-1. -/
lemma HZc2_map_eq :
    HZc2.map (algebraMap R2 L) =
      C (algebraMap R2 L ((cu2⁻¹ : R2ˣ) : R2)) * S1720H.map (algebraMap ℚ L) := by
  rw [HZc2, Polynomial.map_mul, Polynomial.map_C, HZR2_map_eq]

lemma cu2_inv_ne_zero : algebraMap R2 L ((cu2⁻¹ : R2ˣ) : R2) ≠ 0 :=
  ((cu2⁻¹).isUnit.map (algebraMap R2 L)).ne_zero

/-- Evaluation of HZR2 in L agrees with evaluation of S1720H. -/
lemma aeval_HZR2_eq (x : L) : aeval x HZR2 = aeval x S1720H := by
  have h : (algebraMap R2 L).comp (algebraMap ℤ R2) = (algebraMap ℚ L).comp (algebraMap ℤ ℚ) :=
    RingHom.ext_int _ _
  rw [aeval_def, HZR2, Polynomial.eval₂_map, h, ← Polynomial.eval₂_map,
    algebraMap_int_rat, S2481HZ_map_rat, ← aeval_def]

/-- Evaluation of HZc2 in L. -/
lemma aeval_HZc2_eq (x : L) :
    aeval x HZc2 = algebraMap R2 L ((cu2⁻¹ : R2ˣ) : R2) * aeval x S1720H := by
  have h1 : aeval x HZc2 = algebraMap R2 L ((cu2⁻¹ : R2ˣ) : R2) * aeval x HZR2 := by
    rw [HZc2, map_mul, aeval_C]
  rw [h1, aeval_HZR2_eq]

/-- **The root sets coincide**: the roots in L of HZc2 are exactly the
roots of S1720H. -/
theorem HZc2_rootSet_eq : HZc2.rootSet L = S1720H.rootSet L := by
  ext x
  rw [Polynomial.mem_rootSet', Polynomial.mem_rootSet']
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨?_, ?_⟩
    · rw [HZc2_map_eq] at h1
      intro h0
      exact h1 (by rw [h0, mul_zero])
    · rw [aeval_HZc2_eq] at h2
      rcases mul_eq_zero.mp h2 with h | h
      · exact absurd h cu2_inv_ne_zero
      · exact h
  · rintro ⟨h1, h2⟩
    refine ⟨?_, ?_⟩
    · rw [HZc2_map_eq]
      exact mul_ne_zero (Polynomial.C_ne_zero.mpr cu2_inv_ne_zero) h1
    · rw [aeval_HZc2_eq, h2, mul_zero]

/-! ## 2. The roots of HZc2 generate L over Q -/

/-- L is generated over Q by the roots of HZc2. -/
theorem adjoin_rootSet_top : Algebra.adjoin ℚ (HZc2.rootSet L) = ⊤ := by
  rw [HZc2_rootSet_eq]
  exact Polynomial.SplittingField.adjoin_rootSet S1720H

/-! ## 3. Every element of L is a quotient of two elements of Aoc2 -/

@[simp]
lemma coe_algebraMap_Aoc2 (x : Aoc2) : algebraMap Aoc2 L x = (x : L) := rfl

lemma image_int (n : ℤ) :
    algebraMap R L (algebraMap ℤ R n) = algebraMap ℚ L (algebraMap ℤ ℚ n) := by
  have hR : algebraMap ℤ L = (algebraMap R L).comp (algebraMap ℤ R) :=
    IsScalarTower.algebraMap_eq ℤ R L
  have hQ : algebraMap ℤ L = (algebraMap ℚ L).comp (algebraMap ℤ ℚ) :=
    IsScalarTower.algebraMap_eq ℤ ℚ L
  have h1 : algebraMap R L (algebraMap ℤ R n) = algebraMap ℤ L n := by
    rw [hR, RingHom.comp_apply]
  have h2 : algebraMap ℚ L (algebraMap ℤ ℚ n) = algebraMap ℤ L n := by
    rw [hQ, RingHom.comp_apply]
  rw [h1, h2]

lemma image_int_ne_zero {n : ℤ} (hn : algebraMap ℤ ℚ n ≠ 0) :
    (⟨algebraMap R L (algebraMap ℤ R n), Aoc2.algebraMap_mem _⟩ : Aoc2) ≠ 0 := by
  intro h
  have h1 : algebraMap R L (algebraMap ℤ R n) = 0 := by
    simpa using congrArg (Subtype.val) h
  rw [image_int] at h1
  exact hn (FaithfulSMul.algebraMap_injective ℚ L (by simpa using h1))

lemma rational_is_quotient (q : ℚ) :
    ∃ a b : Aoc2, b ≠ 0 ∧ algebraMap ℚ L q * (b : L) = (a : L) := by
  obtain ⟨m, n, hn, hq⟩ := IsFractionRing.div_surjective (A := ℤ) q
  have hn0 : n ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hn
  have hinjZ : Function.Injective (algebraMap ℤ ℚ) := IsFractionRing.injective ℤ ℚ
  have hnq : algebraMap ℤ ℚ n ≠ 0 := fun h => hn0 (hinjZ (by simpa using h))
  refine ⟨⟨algebraMap R L (algebraMap ℤ R m), Aoc2.algebraMap_mem _⟩,
    ⟨algebraMap R L (algebraMap ℤ R n), Aoc2.algebraMap_mem _⟩, ?_, ?_⟩
  · exact image_int_ne_zero hnq
  · have hq' : q * algebraMap ℤ ℚ n = algebraMap ℤ ℚ m := by
      rw [← hq]
      exact div_mul_cancel₀ _ hnq
    have h2 : algebraMap ℚ L q * algebraMap ℚ L (algebraMap ℤ ℚ n)
        = algebraMap ℚ L (algebraMap ℤ ℚ m) := by
      rw [← map_mul, hq']
    rw [show ((⟨algebraMap R L (algebraMap ℤ R n), Aoc2.algebraMap_mem _⟩ : Aoc2) : L)
          = algebraMap ℚ L (algebraMap ℤ ℚ n) from image_int n,
      show ((⟨algebraMap R L (algebraMap ℤ R m), Aoc2.algebraMap_mem _⟩ : Aoc2) : L)
          = algebraMap ℚ L (algebraMap ℤ ℚ m) from image_int m]
    exact h2

/-- **The key computation**: every element of L is a / b with a, b in Aoc2
and b nonzero. -/
theorem exists_quotient (z : L) :
    ∃ a b : Aoc2, b ≠ 0 ∧ z * (b : L) = (a : L) := by
  have key : ∀ (x : L), x ∈ Algebra.adjoin ℚ (HZc2.rootSet L) →
      ∃ y : Aoc2 × nonZeroDivisors Aoc2, x * algebraMap Aoc2 L (y.2 : Aoc2) = algebraMap Aoc2 L y.1 := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem a ha => exact ⟨(⟨a, Algebra.subset_adjoin ha⟩, 1), by simp⟩
    | algebraMap q =>
        obtain ⟨a, b, hb, hq⟩ := rational_is_quotient q
        exact ⟨(a, ⟨b, mem_nonZeroDivisors_iff_ne_zero.mpr hb⟩), by simpa using hq⟩
    | add a b ha hb iha ihb =>
        obtain ⟨⟨a1, b1⟩, h1⟩ := iha
        obtain ⟨⟨a2, b2⟩, h2⟩ := ihb
        refine ⟨⟨a1 * (b2 : Aoc2) + a2 * (b1 : Aoc2),
          ⟨(b1 : Aoc2) * (b2 : Aoc2), mul_mem b1.2 b2.2⟩⟩, ?_⟩
        dsimp only
        rw [map_mul, map_add, map_mul, map_mul]
        calc (a + b) * (algebraMap Aoc2 L (b1 : Aoc2) * algebraMap Aoc2 L (b2 : Aoc2))
            = a * algebraMap Aoc2 L (b1 : Aoc2) * algebraMap Aoc2 L (b2 : Aoc2)
              + b * algebraMap Aoc2 L (b2 : Aoc2) * algebraMap Aoc2 L (b1 : Aoc2) := by ring
          _ = algebraMap Aoc2 L a1 * algebraMap Aoc2 L (b2 : Aoc2)
              + algebraMap Aoc2 L a2 * algebraMap Aoc2 L (b1 : Aoc2) := by rw [h1, h2]
    | mul a b ha hb iha ihb =>
        obtain ⟨⟨a1, b1⟩, h1⟩ := iha
        obtain ⟨⟨a2, b2⟩, h2⟩ := ihb
        refine ⟨⟨a1 * a2, ⟨(b1 : Aoc2) * (b2 : Aoc2), mul_mem b1.2 b2.2⟩⟩, ?_⟩
        dsimp only
        rw [map_mul, map_mul]
        calc (a * b) * (algebraMap Aoc2 L (b1 : Aoc2) * algebraMap Aoc2 L (b2 : Aoc2))
            = (a * algebraMap Aoc2 L (b1 : Aoc2)) * (b * algebraMap Aoc2 L (b2 : Aoc2)) := by ring
          _ = algebraMap Aoc2 L a1 * algebraMap Aoc2 L a2 := by rw [h1, h2]
  obtain ⟨⟨a, b⟩, hab⟩ := key z (by rw [adjoin_rootSet_top]; exact trivial)
  exact ⟨a, b, mem_nonZeroDivisors_iff_ne_zero.mp b.2, hab⟩

/-! ## 4. Aoc2 is a fraction ring of L -/

/-- **Aoc2 is a fraction ring of L.** -/
theorem isFractionRing_Aoc2 : IsFractionRing Aoc2 L := by
  show IsLocalization (nonZeroDivisors Aoc2) L
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · intro y
    rw [isUnit_iff_ne_zero, coe_algebraMap_Aoc2]
    intro h
    exact mem_nonZeroDivisors_iff_ne_zero.mp y.2 (Subtype.ext h)
  · intro z
    obtain ⟨a, b, hb, hab⟩ := exists_quotient z
    exact ⟨(a, ⟨b, mem_nonZeroDivisors_iff_ne_zero.mpr hb⟩), hab⟩
  · intro x y hxy
    have h : x = y := Subtype.ext (by simpa using hxy)
    exact ⟨1, by rw [h]⟩

/-! ## 5. Finiteness, integrality and the integral closure of Aoc2 -/

/-- Aoc2 is a finitely generated R-module: it is generated as an R-algebra
by the (finite) root set of HZc2, all of whose elements are integral over
R. -/
instance finite_Aoc2 : Module.Finite R Aoc2 :=
  Algebra.finite_adjoin_of_finite_of_isIntegral (Polynomial.rootSet_finite HZc2 L)
    (fun _ hx => HZc2_root_isIntegral hx)

/-- Aoc2 is integral over R. -/
instance isIntegral_Aoc2 : Algebra.IsIntegral R Aoc2 := inferInstance

/-- Since Aoc2 is integral over R, the integral closure of Aoc2 in L is
still S. -/
theorem isIntegralClosure_S_Aoc2 : IsIntegralClosure S Aoc2 L := by
  haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
  exact IsIntegralClosure.tower_top (R := R) (A := Aoc2) (B := L) (C := S)

/-! ## 5b. The base ring R is normal -/

/-- `R = Z[1/Cden]` is integrally closed (normal), being a localisation of `Z`.
This is hypothesis (A) of the finite-etale route. -/
theorem isIntegrallyClosed_R : IsIntegrallyClosed R :=
  isIntegrallyClosed_of_isLocalization R (Submonoid.powers c)
    ((Submonoid.powers_le).mpr (mem_nonZeroDivisors_of_ne_zero hcA))

/-! ## 6. The exact reduction of the target -/

/-- The concrete order-theoretic form of the target: the order Aoc2 already
contains the integral closure S of R in L (equivalently Aoc2 = S, since
Aoc2 is contained in S by S2566). -/
def OrderIsMaximal : Prop := ∀ s : S, algebraMap S L s ∈ Aoc2

/-- **Exact reduction**: Aoc2 is integrally closed if and only if the order
generated by the roots already contains the integral closure S of R in L. -/
theorem isIntegrallyClosed_iff_forall_mem :
    IsIntegrallyClosed Aoc2 ↔ OrderIsMaximal := by
  haveI : IsFractionRing Aoc2 L := isFractionRing_Aoc2
  constructor
  · intro h s
    haveI : IsIntegrallyClosed Aoc2 := h
    have hxR : IsIntegral R (algebraMap S L s) := by
      haveI : IsIntegralClosure S R L := S2555_isIntegralClosure
      exact IsIntegral.map (IsScalarTower.toAlgHom R S L)
        (IsIntegralClosure.isIntegral (R := R) (A := S) (B := L) s)
    have hxA : IsIntegral Aoc2 (algebraMap S L s) := hxR.tower_top
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := Aoc2) (K := L)).mp hxA
    rw [← hy]
    exact y.2
  · intro h
    haveI : IsIntegralClosure S Aoc2 L := isIntegralClosure_S_Aoc2
    rw [isIntegrallyClosed_iff (R := Aoc2) (K := L)]
    intro x hx
    obtain ⟨s, hs⟩ :=
      (IsIntegralClosure.isIntegral_iff (R := Aoc2) (A := S) (B := L)).mp hx
    exact ⟨⟨x, by rw [← hs]; exact h s⟩, rfl⟩

/-- Range form of the maximality statement. -/
theorem isIntegrallyClosed_iff_range_le :
    IsIntegrallyClosed Aoc2 ↔ Set.range (algebraMap S L) ⊆ (Aoc2 : Set L) := by
  rw [isIntegrallyClosed_iff_forall_mem]
  exact ⟨fun h x ⟨s, hs⟩ => hs ▸ h s, fun h s => h ⟨s, rfl⟩⟩

/-- `Aoc2` is always contained in `S` (S2566): the range of `S -> L` is an
upper bound for the order generated by the roots. -/
theorem Aoc2_subset_range_S : (Aoc2 : Set L) ⊆ Set.range (algebraMap S L) := by
  rintro x hx
  obtain ⟨s, hs⟩ := adjoin2_subset_isIntegralClosure x hx
  exact ⟨s, hs⟩

/-- Since `Aoc2` is contained in `S`, the remaining maximality statement is
exactly the equality of ranges `S = Aoc2` inside `L`. -/
theorem OrderIsMaximal_iff_range_eq :
    OrderIsMaximal ↔ Set.range (algebraMap S L) = (Aoc2 : Set L) := by
  constructor
  · intro h
    exact Set.eq_of_subset_of_subset (fun x ⟨s, hs⟩ => hs ▸ h s) Aoc2_subset_range_S
  · intro h s
    have hs : algebraMap S L s ∈ Set.range (algebraMap S L) := ⟨s, rfl⟩
    rw [h] at hs
    exact hs

/-- If `Aoc2` is (known to be) the integral closure of `R` in `L`, then it is
integrally closed.  This is the interface of the finite-etale route: it suffices
to prove `IsIntegralClosure Aoc2 R L` (equivalently `S <= Aoc2`). -/
theorem isIntegrallyClosed_of_isIntegralClosure
    (h : IsIntegralClosure Aoc2 R L) : IsIntegrallyClosed Aoc2 := by
  haveI : IsFractionRing Aoc2 L := isFractionRing_Aoc2
  rw [isIntegrallyClosed_iff (R := Aoc2) (K := L)]
  intro x hx
  haveI : IsIntegralClosure Aoc2 R L := h
  exact IsIntegralClosure.isIntegral_iff.mp (isIntegral_trans (R := R) (A := Aoc2) x hx)

/-! ## 7. The local-global reduction at maximal ideals of Aoc2 -/

/-- **The exact remaining local goal**: every localisation of Aoc2 at a
maximal ideal is integrally closed. -/
def LocalIntegrallyClosedGoal : Prop :=
  ∀ p : Ideal Aoc2, p ≠ ⊥ → [p.IsMaximal] → IsIntegrallyClosed (Localization.AtPrime p)

/-- **Local-global reduction**: it suffices to prove that every localisation
of Aoc2 at a maximal ideal is integrally closed. -/
theorem IsIntegrallyClosed_Aoc2_of_local (h : LocalIntegrallyClosedGoal) :
    IsIntegrallyClosed Aoc2 :=
  IsIntegrallyClosed.of_localization_maximal h

/-- A localisation of an integrally closed ring at a maximal ideal is
integrally closed (this is the forward half of the local-global
criterion). -/
theorem isIntegrallyClosed_localization_of_isMaximal [IsIntegrallyClosed Aoc2]
    (p : Ideal Aoc2) [p.IsMaximal] :
    IsIntegrallyClosed (Localization.AtPrime p) :=
  isIntegrallyClosed_of_isLocalization (Localization.AtPrime p) p.primeCompl
    p.primeCompl_le_nonZeroDivisors

/-- The local-global criterion is an equivalence: the global target is
equivalent to the family of local goals. -/
theorem isIntegrallyClosed_iff_local :
    IsIntegrallyClosed Aoc2 ↔ LocalIntegrallyClosedGoal := by
  constructor
  · intro h p hp hpm
    letI : IsIntegrallyClosed Aoc2 := h
    letI : p.IsMaximal := hpm
    exact isIntegrallyClosed_localization_of_isMaximal p
  · exact IsIntegrallyClosed_Aoc2_of_local

/-- **The global order-maximality statement is equivalent to the local
goal.**  This is the precise sense in which the remaining work may be done
prime by prime. -/
theorem orderMaximal_iff_local :
    OrderIsMaximal ↔ LocalIntegrallyClosedGoal :=
  isIntegrallyClosed_iff_forall_mem.symm.trans isIntegrallyClosed_iff_local

/-! ## 8. Axiom footprint -/

#print axioms HZc2_rootSet_eq
#print axioms adjoin_rootSet_top
#print axioms exists_quotient
#print axioms isFractionRing_Aoc2
#print axioms finite_Aoc2
#print axioms isIntegralClosure_S_Aoc2
#print axioms isIntegrallyClosed_R
#print axioms isIntegrallyClosed_iff_forall_mem
#print axioms isIntegrallyClosed_iff_range_le
#print axioms Aoc2_subset_range_S
#print axioms OrderIsMaximal_iff_range_eq
#print axioms isIntegrallyClosed_of_isIntegralClosure
#print axioms IsIntegrallyClosed_Aoc2_of_local
#print axioms isIntegrallyClosed_iff_local
#print axioms orderMaximal_iff_local

end LeanFormal.IUT.XiFPaper.S2569Aoc2IntegrallyClosedActual
end

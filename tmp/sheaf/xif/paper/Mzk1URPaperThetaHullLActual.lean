/- R1-I in the root carrier L_w (kurt): the paper Theta hull generated by the actual theta
sources r^(gaussExponent j) contains the root lattice J_b = r O_L (label one), and its mass rows
are the gauss multiples of the root mass (exchange square, already DONE).

This avoids the cross-carrier block map: everything lives in rootNormedExtension T b.
-/
import tmp.sheaf.xif.paper.Mzk1G1R1IAlphaMassConnectorActual
import Mathlib.Tactic

noncomputable section
open scoped BigOperators Pointwise
open MeasureTheory

namespace LeanFormal.IUT.XiFPaper.Mzk1URPaperThetaHullLActual

open LeanFormal.IUT
open LeanFormal.IUT.LocalFieldIntegralUnits
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.InitialThetaSource.PlacePartitionReduction
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.XiFPaper.QVFamTensorCoefficientActual
open LeanFormal.IUT.XiFPaper.PaperRootCompletionTensorActual
open LeanFormal.IUT.XiFPaper.Mzk1URRootExtensionActual
open LeanFormal.IUT.XiFPaper.Mzk1URRootExtInstancesActual

variable {l : PrimeGeFive} (T : SourceNativeInitialThetaData.{0} l)
variable (b : Bad (nativePlaceSelection T))

/-- The paper Theta source hull in the actual root carrier L_w: the closure of the union of the
actual theta regions r^(gaussExponent j) O_L. -/
noncomputable def thetaHullL : Set (rootNormedExtension T b) :=
  closure (⋃ j : SignedLabel l.value,
    (urRootTheta T b j) • (Integers (rootNormedExtension T b) :
      Set (rootNormedExtension T b)))

/-- LABEL-ONE INCLUSION: the root lattice J_b = r O_L is one of the theta regions of the paper
source hull, hence J_b is contained in the paper Theta hull in L_w. -/
theorem rootRegion_subset_thetaHullL (oneLabel : SignedLabel l.value)
    (hone : gaussExponent oneLabel.1 = 1) :
    (urRootAlpha T b) • (Integers (rootNormedExtension T b) :
        Set (rootNormedExtension T b)) ⊆ thetaHullL (T := T) (b := b) := by
  intro x hx
  apply subset_closure
  apply Set.mem_iUnion.mpr
  refine ⟨oneLabel, ?_⟩
  have htheta : urRootTheta T b oneLabel = urRootAlpha T b := by
    unfold urRootTheta
    rw [hone]
    exact zpow_one _
  rw [htheta]
  exact hx

/-- The whole source family: every theta region is contained in the paper Theta hull (trivial by
union), hence the entire lattice/family enters the paper Theta image, not only one point. -/
theorem thetaRegions_subset_thetaHullL (j : SignedLabel l.value) :
    (urRootTheta T b j) • (Integers (rootNormedExtension T b) :
        Set (rootNormedExtension T b)) ⊆ thetaHullL (T := T) (b := b) := by
  intro x hx
  apply subset_closure
  exact Set.mem_iUnion.mpr ⟨j, hx⟩

#print axioms rootRegion_subset_thetaHullL
#print axioms thetaRegions_subset_thetaHullL

end LeanFormal.IUT.XiFPaper.Mzk1URPaperThetaHullLActual
end
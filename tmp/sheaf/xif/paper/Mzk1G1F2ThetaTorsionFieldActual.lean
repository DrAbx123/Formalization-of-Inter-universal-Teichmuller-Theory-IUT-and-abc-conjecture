/- R3 (D) infrastructure: the field generated by the ψ₅ x-coordinates and their y's.

  Route §5.2(2) step ⑤ requires the field generated by the x ∪ y coordinates of the
  multiplication-kernel points. Here we build that field from the REAL x-root set and the
  REAL y-coordinates of `Mzk1G1F2ThetaTorsionFiveYActual` (no splitting field, no invented data).
  The identification of this field with the actual E[5]-torsion field still needs the
  nsmul criterion (M2/M4, henry) and the enumeration completeness (C); NOT claimed here.
  No sorry/axiom. -/
import tmp.sheaf.xif.paper.Mzk1G1F2ThetaTorsionFiveYActual
import tmp.sheaf.xif.paper.Mzk1G1F2ThetaTorsionFiveActual
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Tactic

noncomputable section
open Polynomial
namespace LeanFormal.IUT.XiFPaper.Mzk1G1F2ThetaTorsionFieldActual
open LeanFormal.IUT.XiFPaper.Mzk1G1F2ThetaTorsionFiveActual
open LeanFormal.IUT.XiFPaper.Mzk1G1F2ThetaTorsionFiveYActual

variable (lam : ℂ)

/-- ψ₅ 的 x-根集与配上的 y-坐标组成的坐标集。 -/
noncomputable def fiveTorsionCoordSet : Set ℂ :=
  {x : ℂ | (legendreΨ₅ lam).eval x = 0} ∪
    {y : ℂ | ∃ x : ℂ, (legendreΨ₅ lam).eval x = 0 ∧ y ^ 2 = x * (x - 1) * (x - lam)}

/-- 由该坐标集生成的域（route §5.2(2) ⑤ 的载体）。 -/
noncomputable def fiveTorsionField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (fiveTorsionCoordSet lam)

/-- x-根 ∈ 域。 -/
theorem root_mem_fiveTorsionField {x : ℂ} (hx : (legendreΨ₅ lam).eval x = 0) :
    x ∈ fiveTorsionField lam := by
  unfold fiveTorsionField fiveTorsionCoordSet
  apply IntermediateField.subset_adjoin
  exact Or.inl hx

/-- 配上的 y ∈ 域。 -/
theorem legendreYOfX_mem_fiveTorsionField {x : ℂ}
    (hx : (legendreΨ₅ lam).eval x = 0) :
    legendreYOfX lam x ∈ fiveTorsionField lam := by
  unfold fiveTorsionField fiveTorsionCoordSet
  apply IntermediateField.subset_adjoin
  exact Or.inr ⟨x, hx, legendreYOfX_sq lam x⟩

#print axioms root_mem_fiveTorsionField
#print axioms legendreYOfX_mem_fiveTorsionField

end LeanFormal.IUT.XiFPaper.Mzk1G1F2ThetaTorsionFieldActual

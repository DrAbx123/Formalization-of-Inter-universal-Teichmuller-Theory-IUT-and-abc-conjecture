variable {p : Nat} [Fact (Nat.Prime p)]

/-! ## 1. Open subgroups of topologically finitely generated groups -/

/-- **Topological Schreier lemma.**  A compact topological group topologically
generated by a finite set has every open subgroup topologically generated by a
finite set. -/
theorem topologicallyFinitelyGenerated_openSubgroup
    {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G]
    (H : Subgroup G) (hH : IsOpen (H : Set G))
    (hG : ∃ S : Finset G, (Subgroup.closure (S : Set G)).topologicalClosure = ⊤) :
    ∃ T : Finset H, (Subgroup.closure (T : Set H)).topologicalClosure = ⊤ := by
  classical
  obtain ⟨S, hS⟩ := hG
  haveI hfinquot : Finite (G ⧸ H) := Subgroup.quotient_finite_of_isOpen H hH
  haveI hHfin : H.FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  let L : Subgroup G := Subgroup.closure (S : Set G)
  have hLtop : L.topologicalClosure = ⊤ := hS
  haveI hLfg : Group.FG L := Group.closure_finset_fg S
  haveI hsubfin : (H.subgroupOf L).FiniteIndex := inferInstance
  haveI hsubfg : Group.FG ↥(H.subgroupOf L) := Subgroup.fg_of_index_ne_zero (H.subgroupOf L)
  obtain ⟨T, hT⟩ := Group.fg_def.mp (inferInstance : Group.FG ↥(H.subgroupOf L))
  let f : ↥(H.subgroupOf L) →* H :=
    { toFun := fun x => ⟨(x.1 : G), Subgroup.mem_subgroupOf.mp x.2⟩
      map_one' := rfl
      map_mul' := fun x y => rfl }
  have hrange : f.range = L.subgroupOf H := by
    ext h
    constructor
    · rintro ⟨x, rfl⟩
      exact Subgroup.mem_subgroupOf.mpr x.1.2
    · intro hh
      refine ⟨⟨⟨(h : G), Subgroup.mem_subgroupOf.mp hh⟩, h.2⟩, ?_⟩
      rfl
  have hLdense : Dense (L : Set G) := by
    rw [dense_iff_closure_eq, ← Subgroup.topologicalClosure_coe, hLtop]
    rfl
  have hKdense : Dense ((L.subgroupOf H : Subgroup H) : Set H) := by
    rw [dense_iff_inter_open]
    intro U hU hUne
    rw [isOpen_induced_iff] at hU
    obtain ⟨V, hVopen, hVU⟩ := hU
    have hVHopen : IsOpen (V ∩ (H : Set G)) := hVopen.inter hH
    have hVHne : (V ∩ (H : Set G)).Nonempty := by
      obtain ⟨u, hu⟩ := hUne
      exact ⟨(u : G), by simpa [← hVU] using hu, u.2⟩
    obtain ⟨x, hxVH, hxL⟩ := (dense_iff_inter_open.mp hLdense) (V ∩ (H : Set G)) hVHopen hVHne
    refine ⟨⟨x, hxVH.2⟩, ?_, ?_⟩
    · rw [← hVU]
      exact hxVH.1
    · exact hxL
  have hKcl : (L.subgroupOf H).topologicalClosure = ⊤ := by
    rw [← SetLike.coe_set_eq]
    rw [Subgroup.topologicalClosure_coe, hKdense.closure_eq]
    rfl
  refine ⟨T.image f, ?_⟩
  have hclosure : Subgroup.closure ((T.image f : Finset H) : Set H) = L.subgroupOf H := by
    rw [← hrange]
    calc
      Subgroup.closure ((T.image f : Finset H) : Set H)
          = Subgroup.closure (f '' (T : Set ↥(H.subgroupOf L))) := by
              rw [Finset.coe_image]
      _ = Subgroup.map f (Subgroup.closure (T : Set ↥(H.subgroupOf L))) :=
              (MonoidHom.map_closure f (T : Set ↥(H.subgroupOf L))).symm
      _ = Subgroup.map f ⊤ := by rw [hT]
      _ = f.range := (MonoidHom.range_eq_map f).symm
  rw [hclosure]
  exact hKcl

/-! ## 2. Continuous surjections preserve topological finite generation -/

/-- A continuous surjective group homomorphism sends a finite topological
generating set to a finite topological generating set. -/
theorem topologicallyFinitelyGenerated_of_continuous_surjective
    {G H : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (f : G →* H) (hf : Continuous f) (hsurj : Function.Surjective f)
    (hG : ∃ S : Finset G, (Subgroup.closure (S : Set G)).topologicalClosure = ⊤) :
    ∃ T : Finset H, (Subgroup.closure (T : Set H)).topologicalClosure = ⊤ := by
  classical
  obtain ⟨S, hS⟩ := hG
  let L : Subgroup G := Subgroup.closure (S : Set G)
  have hLdense : Dense (L : Set G) := by
    rw [dense_iff_closure_eq, ← Subgroup.topologicalClosure_coe, hS]
    rfl
  have hrange : DenseRange f := by
    rw [denseRange_iff_closure_range, hsurj.range_eq]
    exact isClosed_univ.closure_eq
  have himage : Dense (f '' (L : Set G)) := hrange.dense_image hf hLdense
  refine ⟨S.image f, ?_⟩
  have hgen : Subgroup.closure ((S.image f : Finset H) : Set H) = Subgroup.map f L := by
    rw [Finset.coe_image, ← MonoidHom.map_closure]
  rw [hgen]
  rw [← SetLike.coe_set_eq]
  rw [Subgroup.topologicalClosure_coe, Subgroup.coe_map, himage.closure_eq]
  rfl

/-! ## 3. Continuity of the Galois identification -/

/-- The canonical group isomorphism between a subgroup and the same subgroup
written with an equal carrier is continuous for the subspace topologies. -/
theorem continuous_subgroupCongr
    {G : Type*} [Group G] [TopologicalSpace G] {H K : Subgroup G} (h : H = K) :
    Continuous (MulEquiv.subgroupCongr h) := by
  apply continuous_induced_rng.mpr
  have hcomp : (Subtype.val ∘ ⇑(MulEquiv.subgroupCongr h)) = Subtype.val := by
    funext x
    exact MulEquiv.subgroupCongr_apply h x
  rw [hcomp]
  exact continuous_subtype_val

/-- **Continuity of the infinite Galois identification.**
For a finite intermediate field L, the canonical isomorphism
  L.fixingSubgroup -> Gal(E/L)
is continuous, where the left side carries the subspace topology from
Gal(E/F) and the right side the Krull topology. -/
theorem continuous_fixingSubgroupEquiv
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (L : IntermediateField F E) [FiniteDimensional F L] :
    Continuous (IntermediateField.fixingSubgroupEquiv L) := by
  apply continuous_of_continuousAt_one _ (continuousAt_def.mpr _)
  intro s hs
  rw [map_one, krullTopology_mem_nhds_one_iff] at hs
  obtain ⟨M, hMfin, hMsub⟩ := hs
  let M' : IntermediateField F E :=
    { toSubalgebra := M.toSubalgebra.restrictScalars F
      inv_mem' := by
        intro x hx
        exact M.inv_mem' x hx }
  haveI hM'fin : FiniteDimensional F ↥M' := by
    exact FiniteDimensional.trans F ↥L ↥M
  have hM'open : IsOpen (M'.fixingSubgroup : Set Gal(E/F)) :=
    IntermediateField.fixingSubgroup_isOpen M'
  have hLopen : IsOpen (L.fixingSubgroup : Set Gal(E/F)) :=
    IntermediateField.fixingSubgroup_isOpen L
  refine mem_nhds_iff.mpr ⟨Subtype.val ⁻¹' ((M'.fixingSubgroup : Set Gal(E/F)) ∩
      (L.fixingSubgroup : Set Gal(E/F))), ?_, ?_, ?_⟩
  · intro sigma hsigma
    apply hMsub
    exact (IntermediateField.mem_fixingSubgroup_iff M (IntermediateField.fixingSubgroupEquiv L sigma)).mpr
      (fun x hx => by
        have hxM' : (x : E) ∈ M' := by
          change (x : E) ∈ (M : Set E)
          exact hx
        exact (IntermediateField.mem_fixingSubgroup_iff M' sigma.val).mp hsigma.1 (x : E) hxM')
  · exact hM'open.inter hLopen |>.preimage continuous_subtype_val
  · exact ⟨Subgroup.one_mem _, Subgroup.one_mem _⟩

/-- **Continuity of the canonical isomorphism G_L = U**, for every open
subgroup U.  This is the only topological input used by the reduction. -/
theorem continuous_localGaloisGroupEquiv (U : Index p) :
    Continuous (localGaloisGroupEquiv p U) := by
  haveI : FiniteDimensional ℚ_[p]
      (LocalIntegralUnitKummerInjectivity.FixedField p U) := inferInstance
  have h1 : Continuous (MulEquiv.subgroupCongr (fixingSubgroup_fixedField_eq p U).symm) :=
    continuous_subgroupCongr _
  have h2 : Continuous (IntermediateField.fixingSubgroupEquiv
      (LocalIntegralUnitKummerInjectivity.FixedField p U)) :=
    continuous_fixingSubgroupEquiv _
  change Continuous ((IntermediateField.fixingSubgroupEquiv
      (LocalIntegralUnitKummerInjectivity.FixedField p U)) ∘
    (MulEquiv.subgroupCongr (fixingSubgroup_fixedField_eq p U).symm))
  exact h2.comp h1

/-! ## 4. The exact missing theorem and the reduction -/

/-- **The first missing theorem**: the absolute Galois group G_Qp of Q_p is
topologically generated by finitely many elements.

This is the classical theorem for the absolute Galois group of a p-adic
field.  It is recorded here as a proposition and is never assumed.  The
usual proof uses Krasner's lemma together with local class field theory /
the Demushkin structure of the maximal pro-p quotient; neither the
finiteness-of-extensions consequence of Krasner nor the Demushkin input is
available in Mathlib or in the tree. -/
def PadicAbsoluteGaloisTopologicallyFinitelyGenerated : Prop :=
  ∃ s : Finset (LocalAbsoluteGalois p),
    (Subgroup.closure (s : Set (LocalAbsoluteGalois p))).topologicalClosure = ⊤

/-- **The reduction of S2117 to the single case U = top.**  Finite generation
of G_Qp implies topological finite generation of G_L for every finite
extension L / Q_p, i.e. for every open subgroup U of G_v. -/
theorem topologicallyFinitelyGenerated_of_padicAbsoluteGalois
    (hQp : PadicAbsoluteGaloisTopologicallyFinitelyGenerated (p := p)) :
    ∀ U : Index p, TopologicallyFinitelyGenerated U := by
  intro U
  obtain ⟨T, hT⟩ := topologicallyFinitelyGenerated_openSubgroup
    (G := LocalAbsoluteGalois p) (H := U.toSubgroup) U.isOpen hQp
  exact topologicallyFinitelyGenerated_of_continuous_surjective
    (localGaloisGroupEquiv p U).toMonoidHom
    (continuous_localGaloisGroupEquiv U)
    (localGaloisGroupEquiv p U).surjective ⟨T, hT⟩

/-- The exact S2116 input, obtained from the single missing theorem. -/
theorem topologicallyFinitelyGenerated_forall
    (hQp : PadicAbsoluteGaloisTopologicallyFinitelyGenerated (p := p)) :
    ∀ U : Index p, TopologicallyFinitelyGenerated U :=
  topologicallyFinitelyGenerated_of_padicAbsoluteGalois hQp

/-- **S2116's M2c route, with finite generation reduced to G_Qp.**  This is
the exact consumer: the only group-theoretic inputs left are finite
generation of G_Qp and Nikolov-Segal commutator width. -/
theorem m2cFirstMissing_of_padicTopFG_and_nikolovSegal
    (hNS : NikolovSegalCommutatorWidth.{0})
    (hQp : PadicAbsoluteGaloisTopologicallyFinitelyGenerated (p := p)) :
    M2cFirstMissing (p := p) :=
  m2cFirstMissing_of_nikolovSegal (p := p) hNS
    (topologicallyFinitelyGenerated_forall hQp)

/-! ## 5. The precise Krasner / local-field finiteness APIs -/

/-- Krasner's lemma is available in Mathlib for the concrete p-adic algebraic
closure.  It is not the missing ingredient; it is recorded so that the gap is
not misidentified. -/
theorem krasner_available : IsKrasner ℚ_[p] (PadicAlgCl p) :=
  inferInstance

/-- **The precise local-field extension-finiteness statement** missing from
Mathlib: for each n there are only finitely many degree-n extensions of Q_p
inside a fixed algebraic closure.  This is the standard consequence of
Krasner's lemma.  It is *necessary* for finite generation of G_Qp, but it is
not sufficient: the profinite product of C_{p_n} over distinct primes has
finitely many open subgroups of each index and is not finitely generated.
Consequently no theorem below derives finite generation from this Prop. -/
def FinitelyManyExtensionsOfDegree (n : Nat) : Prop :=
  Finite { M : IntermediateField ℚ_[p] (PadicAlgCl p) //
    Module.finrank ℚ_[p] M = n }

/-- **The local-field form at an arbitrary finite L / Q_p**: for each n there
are only finitely many degree-n extensions of L inside a fixed algebraic
closure.  This is the API missing from Mathlib for every local field, not
just for Q_p. -/
def FinitelyManyExtensionsOfLocalFieldOfDegree
    (L : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : Nat) : Prop :=
  Finite { M : IntermediateField ↥L (PadicAlgCl p) //
    Module.finrank ↥L M = n }

/-- The group-theoretic form of the same finiteness: finitely many open
subgroups of a fixed index.  For G_Qp this is equivalent to
FinitelyManyExtensionsOfDegree by the infinite Galois correspondence. -/
def FinitelyManyOpenSubgroupsOfIndex (n : Nat) : Prop :=
  Finite { U : Index p // U.toSubgroup.index = n }

/-- **Bounded explicit generators**: a strong form of the missing theorem,
recording that G_Qp is generated by at most N elements.  The literature
proofs of the local field theorem give such a bound explicitly; this file
does not assert a numerical value. -/
def PadicAbsoluteGaloisHasAtMostGenerators (N : Nat) : Prop :=
  ∃ s : Finset (LocalAbsoluteGalois p), s.card ≤ N ∧
    (Subgroup.closure (s : Set (LocalAbsoluteGalois p))).topologicalClosure = ⊤

/-- The bounded form implies the first missing theorem. -/
theorem padicAbsoluteGaloisTopologicallyFinitelyGenerated_of_atMost
    (N : Nat) (h : PadicAbsoluteGaloisHasAtMostGenerators (p := p) N) :
    PadicAbsoluteGaloisTopologicallyFinitelyGenerated (p := p) := by
  obtain ⟨s, -, hs⟩ := h
  exact ⟨s, hs⟩


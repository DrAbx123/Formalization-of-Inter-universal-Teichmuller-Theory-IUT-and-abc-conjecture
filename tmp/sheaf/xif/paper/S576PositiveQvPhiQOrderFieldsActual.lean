import tmp.sheaf.xif.paper.S567QvPhiQOrderFieldsFromTriDataActual

/-! # S576: positive QvPhiQOrderFields package and conditional tau

Given an S567 qOrder preimage H, package the positive QvPhiQOrderFields and
the tau generated by the corresponding linear base-identity endomorphism.
H is an explicit hypothesis; no preimage or tau is fabricated. -/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 6000000

namespace LeanFormal.IUT.XiFPaper.S576PositiveQvPhiQOrderFieldsActual

open CategoryTheory
open Iut
open LeanFormal.IUT.XiFPaper.S432SmallModelActual
open LeanFormal.IUT.XiFPaper.S511PhiCvCandidateActual
open LeanFormal.IUT.XiFPaper.S522QvPhiRamificationModelActual
open LeanFormal.IUT.XiFPaper.S550QvPhiPreFrobenioidActual
open LeanFormal.IUT.XiFPaper.S553QvPhiTriDataActual
open LeanFormal.IUT.XiFPaper.S556QvPhiInputActual
open LeanFormal.IUT.XiFPaper.S563QvOrderElementConstructionActual
open LeanFormal.IUT.XiFPaper.S567QvPhiQOrderFieldsFromTriDataActual
open Iut.SourceModelFrobenioid

universe u
variable {K : Type u} [Field K]
variable (T : QvPhiTriData (K := K))
variable (D : S556InputDataActual (K := K))
variable (A : Object (qvPhi (K := K) D.ramification))

/-- Positive QvPhiQOrderFields package, conditional on the qOrder preimage. -/
structure S576PositiveQvPhiQOrderFields where
  preimage : S567QOrderPreimage (K := K) T D A
  fields : QvPhiQOrderFields (K := K) D.ramification
    (s567Input (K := K) D) A
  fields_eq : fields =
    s567QvPhiQOrderFieldsOfPreimage (K := K) T D A preimage

/-- Constructor from the exact qOrder preimage. -/
noncomputable def s576PositiveQvPhiQOrderFieldsOfPreimage
    (H : S567QOrderPreimage (K := K) T D A) :
    S576PositiveQvPhiQOrderFields (K := K) T D A where
  preimage := H
  fields := s567QvPhiQOrderFieldsOfPreimage (K := K) T D A H
  fields_eq := rfl

/-- The positive qOrder endomorphism associated to the packaged fields. -/
noncomputable def s576QOrderEndomorphism
    (P : S576PositiveQvPhiQOrderFields (K := K) T D A) :
    PreFrobenioid.LinearBaseIdentityEndomorphism
      (P := qvPreFrobenioid (K := K) D.ramification
        (s567Input (K := K) D)) A :=
  qOrderEndomorphismOfFields (K := K) D.ramification
    (s567Input (K := K) D) A P.fields

/-- Conditional tau = natural powers of the positive qOrder element. -/
noncomputable def s576Tau
    (P : S576PositiveQvPhiQOrderFields (K := K) T D A) :
    Submonoid (PreFrobenioid.LinearBaseIdentityEndomorphism
      (P := qvPreFrobenioid (K := K) D.ramification
        (s567Input (K := K) D)) A) :=
  tauOfQOrderFields (K := K) D.ramification
    (s567Input (K := K) D) A P.fields

/-- The tau is exactly the powers of the positive qOrder element. -/
theorem s576Tau_eq_powers
    (P : S576PositiveQvPhiQOrderFields (K := K) T D A) :
    s576Tau (K := K) T D A P =
      Submonoid.powers (s576QOrderEndomorphism (K := K) T D A P) := rfl

/-- The positive qOrder element belongs to its tau. -/
theorem s576QOrderEndomorphism_mem_tau
    (P : S576PositiveQvPhiQOrderFields (K := K) T D A) :
    s576QOrderEndomorphism (K := K) T D A P ∈
      s576Tau (K := K) T D A P :=
  Submonoid.mem_powers _

/-- The packaged divisor is exactly the qOrder generator. -/
theorem s576Fields_divisor_eq
    (P : S576PositiveQvPhiQOrderFields (K := K) T D A) :
    P.fields.divisor = P.preimage.divisor := by
  rw [P.fields_eq]
  rfl

end LeanFormal.IUT.XiFPaper.S576PositiveQvPhiQOrderFieldsActual

end

import tmp.sheaf.xif.paper.GlobalFrobenioidPresentationActual
import LeanFormal.IUT.IUTII.Frobenioid.Example36SourceModelBackend

-- LGP global realified Frobenioid presentation: backend reuse and exact gap
--
-- The source backend used for the q-side number-field model presentation is
-- Example36.SourceModelBackend.bottomPoint / BottomBase / BottomFSM and the
-- generic SourceModelFrobenioid.Carrier.frobenioidPresentation constructor.
--
-- C^⊩_LGP / C^⊩_lgp needs the same backend shape but DIFFERENT base/divisor
-- data: the LGP-monoid splitting data generated by the theta values, not the
-- number-field effective-divisor cone. The exact LGP Phi/Input is not present
-- in the tree. This file constructs the actual presentation from any supplied
-- LGP divisor/input data and records the source-specific missing object as an
-- exact object-level gap. No value-layer surrogate is used.
-- WRITE-ONLY; no local lake/lean.

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false

namespace LeanFormal.IUT.XiFPaper.LGPFrobenioidPresentationActual

open LeanFormal.IUT
open LeanFormal.IUT.IUTII.Frobenioid.Example36.SourceModelBackend
open LeanFormal.IUT.XiFPaper.GlobalFrobenioidPresentationActual

universe u

-- The same one-object bottom base and FSM predicate as the number-field
-- backend. Only the divisorial data will differ for LGP.
abbrev LGPBaseCategory : Type u := BottomBase.{u}

instance lgpBaseCategory : CategoryTheory.Category.{u, u} (LGPBaseCategory.{u}) :=
  inferInstanceAs (CategoryTheory.Category.{u, u} BottomBase.{u})

abbrev LGPIsFSM : ∀ {X Y : LGPBaseCategory.{u}}, (X ⟶ Y) → Prop :=
  fun _ => True

theorem lgpBase_isConnected :
    CategoryTheory.IsConnected (LGPBaseCategory.{u}) :=
  inferInstanceAs (CategoryTheory.IsConnected BottomBase.{u})

theorem lgpBase_arrow_epi
    {X Y : LGPBaseCategory.{u}} (f : X ⟶ Y) :
    CategoryTheory.Epi f :=
  bottomBase_arrow_epi f

-- The actual LGP presentation data: an actual DivisorialMonoidOn on the same
-- backend base plus a model Input. This is the structural data that differs
-- from the number-field effective-divisor presentation.
structure LGPFrobenioidPresentationData where
  Phi : Iut.DivisorialMonoidOn (LGPBaseCategory.{u}) LGPIsFSM
  data : Iut.SourceModelFrobenioid.Input Phi
  /-- Source-level identification of Phi with the LGP-monoid divisor data. -/
  is_LGP : Prop

-- Conditional actual construction of the LGP global realified Frobenioid
-- presentation from supplied actual LGP divisor/input data.
noncomputable def lgpFrobenioidPresentationOfData
    (D : LGPFrobenioidPresentationData.{u}) :
    Iut.FrobenioidPresentation :=
  Iut.SourceModelFrobenioid.Carrier.frobenioidPresentation
    (D := LGPBaseCategory.{u}) (IsFSM := LGPIsFSM)
    (Phi := D.Phi) (data := D.data)
    (fun f => lgpBase_arrow_epi f)

-- Exact object-level gap: the source-specific LGP Phi/Input (the LGP-monoid
-- divisor data at V_bad, with the theta-value action and the 2l-th root
-- normalization) is not supplied by the number-field backend. No value-layer
-- substitution is made.
def LGPFrobenioidPresentationGap : Prop :=
  Nonempty (LGPFrobenioidPresentationData.{u})

#check LGPBaseCategory
#check LGPFrobenioidPresentationData
#check lgpFrobenioidPresentationOfData
#check LGPFrobenioidPresentationGap

end LeanFormal.IUT.XiFPaper.LGPFrobenioidPresentationActual

end
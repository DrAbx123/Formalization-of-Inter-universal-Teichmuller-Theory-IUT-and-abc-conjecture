import Iut.Foundations.SourceFiniteStageModelFrobenioid

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 2000000

namespace LeanFormal.IUT.XiFPaper.S507PhiCvCandidateActual

open LeanFormal.IUT
open Iut
open Iut.SourceFinitePlaceReconstruction

universe u

variable {K : Type u} [Field K] [NumberField K]
variable (place : NumberField.FinitePlace K)

/-- Candidate ambient divisor monoid: the actual stage divisorial monoid with ramification pullback. -/
noncomputable def phiCvCandidate :
    DivisorialMonoidOn (StageBase place) (@StageFSM K _ _ place) :=
  stageDivisorialMonoidOn place

/-- ℕ-valued carrier. -/
abbrev PhiCarrier : Type u := StageDivisor.{u}

/-- Constant q_v section with divisor value order. -/
noncomputable def qvConstantSection (order : ℕ) :
    ∀ _X : StageBase place, StageDivisor.{u} :=
  fun _ => (ULift.up order : StageDivisor.{u})

theorem qvConstantSection_apply (order : ℕ) (X : StageBase place) :
    qvConstantSection (K := K) place order X = (ULift.up order : StageDivisor.{u}) := rfl

/-- Split additive submonoid generated by the coefficient N * log(q_v). -/
noncomputable def splitAddSubmonoid (coefficient : ℕ) : AddSubmonoid (StageDivisor.{u}) :=
  AddSubmonoid.closure ({((ULift.up coefficient : StageDivisor.{u}))} :
    Set (StageDivisor.{u}))

theorem qvConstantSection_mem_split (coefficient : ℕ) (X : StageBase place) :
    qvConstantSection (K := K) place coefficient X ∈
      splitAddSubmonoid coefficient := by
  unfold qvConstantSection splitAddSubmonoid
  exact AddSubmonoid.subset_closure (by simp)

/-- Candidate paper Phi data: actual divisor monoid, constant q_v value, and
split submonoid generated by N log(q_v).  No characteristic splitting tau is asserted. -/
structure PaperPhiCvCandidate where
  phi : DivisorialMonoidOn (StageBase place) (@StageFSM K _ _ place)
  phi_eq : phi = phiCvCandidate (K := K) place
  qvOrder : ℕ
  split : AddSubmonoid (StageDivisor.{u})
  qv_constant_mem : ∀ X : StageBase place,
    (ULift.up qvOrder : StageDivisor.{u}) ∈ split

noncomputable def paperPhiCvCandidateOfOrder (order : ℕ) :
    PaperPhiCvCandidate (K := K) place where
  phi := phiCvCandidate (K := K) place
  phi_eq := rfl
  qvOrder := order
  split := splitAddSubmonoid order
  qv_constant_mem := fun X => qvConstantSection_mem_split (K := K) place order X

end LeanFormal.IUT.XiFPaper.S507PhiCvCandidateActual

end

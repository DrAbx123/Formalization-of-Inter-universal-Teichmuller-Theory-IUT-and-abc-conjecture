/- R3 (m = 5 actual kernel object; division polynomials NOT used here).

  User ruling: the source object is the actual multiplication kernel E[m] = ker([m]);
  coordinates (division polynomials) are only tools, and must cover both y over each x,
  the point at infinity, enumeration completeness, and the field generated by the
  coordinates must equal the actual torsion field.

  THIS FILE: for m = 5 the kernel definition and the reduction `5 • P = 4 • P + P`,
  coordinate set of the kernel and the 'both y' coverage via the negation symmetry.
  The actual nsmul ↔ ψ₅ zero criterion (M4/G2) is still OPEN and NOT claimed;
  enumeration completeness and field equality remain OPEN as documented.
  No sorry/axiom. -/
import tmp.sheaf.xif.paper.Mzk1G1R3TorsionKernelActual
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.Tactic

noncomputable section
open Polynomial
namespace LeanFormal.IUT.XiFPaper.Mzk1G1R3FiveKernelActual
open LeanFormal.IUT
open LeanFormal.IUT.XiFPaper.Mzk1G1R3TorsionKernelActual

variable {F : Type*} [Field F] [DecidableEq F] (W : WeierstrassCurve F)

/-- `5 • P = 4 • P + P`。 -/
theorem five_smul_eq_four_smul_add (P : W.toAffine.Point) :
    (5 : ℤ) • P = (4 : ℤ) • P + P := by
  rw [show (5 : ℤ) = 4 + 1 from by norm_num, add_zsmul, one_zsmul]

/-- **m = 5 的核化归**：`P ∈ E[5] ↔ 4 • P = -P`。 -/
theorem five_mem_mulKernel_iff (P : W.toAffine.Point) :
    P ∈ mulKernel W 5 ↔ (4 : ℤ) • P = -P := by
  simp only [mulKernel, Set.mem_setOf_eq]
  rw [five_smul_eq_four_smul_add]
  constructor
  · intro h
    exact eq_neg_of_add_eq_zero_left h
  · intro h
    rw [h, neg_add_cancel]

/-- 核点的坐标集（含 y；无穷远点单独由 `zero_mem_mulKernel` 覆盖）。 -/
def mulKernelCoords (m : ℤ) : Set (F × F) :=
  {(x, y) | ∃ hns : W.toAffine.Nonsingular x y,
    WeierstrassCurve.Affine.Point.some x y hns ∈ mulKernel W m}

theorem mem_mulKernelCoords_iff {m : ℤ} {x y : F} :
    (x, y) ∈ mulKernelCoords W m ↔
      ∃ hns : W.toAffine.Nonsingular x y,
        WeierstrassCurve.Affine.Point.some x y hns ∈ mulKernel W m := Iff.rfl

/-- **两个 y 的覆盖**：若 `(x,y)` 是核点坐标，则 `(x, negY x y)` 也是。 -/
theorem negY_coords_mem {m : ℤ} {x y : F} (hns : W.toAffine.Nonsingular x y)
    (hP : WeierstrassCurve.Affine.Point.some x y hns ∈ mulKernel W m) :
    (x, W.toAffine.negY x y) ∈ mulKernelCoords W m := by
  refine ⟨?_, ?_⟩
  · exact (W.toAffine.nonsingular_neg x y).mpr hns
  · rw [← WeierstrassCurve.Affine.Point.neg_some hns]
    exact neg_mem_mulKernel (W := W) hP

#print axioms five_smul_eq_four_smul_add
#print axioms five_mem_mulKernel_iff
#print axioms negY_coords_mem

end LeanFormal.IUT.XiFPaper.Mzk1G1R3FiveKernelActual
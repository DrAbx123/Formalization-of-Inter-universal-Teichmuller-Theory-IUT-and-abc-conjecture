variable (p : Nat) [Fact (Nat.Prime p)]

/-! ## 1. Conjugation and the translated germ representative -/

/-- Conjugation by an element of G_v = Gal(Qbar_p/Q_p), as a monoid homomorphism. -/
noncomputable def conjHom (g : LocalAbsoluteGalois p) :
    LocalAbsoluteGalois p →* LocalAbsoluteGalois p :=
  (MulAut.conj g).toMonoidHom

theorem conjHom_apply (g x : LocalAbsoluteGalois p) :
    conjHom p g x = g * x * g⁻¹ :=
  MulAut.conj_apply g x

theorem conjHom_mul_inv (g x : LocalAbsoluteGalois p) :
    conjHom p g⁻¹ (conjHom p g x) = x := by
  rw [conjHom_apply, conjHom_apply]
  group

theorem conjHom_inv_mul (g x : LocalAbsoluteGalois p) :
    conjHom p g (conjHom p g⁻¹ x) = x := by
  rw [conjHom_apply, conjHom_apply]
  group

theorem continuous_conjHom (g : LocalAbsoluteGalois p) : Continuous (conjHom p g) := by
  have hEq : (conjHom p g : LocalAbsoluteGalois p → LocalAbsoluteGalois p) =
      fun x => g * x * g⁻¹ := funext (fun x => conjHom_apply p g x)
  rw [hEq]
  exact (continuous_const.mul continuous_id).mul continuous_const

/-- The conjugate g U g^{-1} of an open subgroup, as the inverse image of U
under conjugation by g^{-1}. -/
noncomputable def conjOpen (g : LocalAbsoluteGalois p)
    (U : OpenSubgroup (LocalAbsoluteGalois p)) :
    OpenSubgroup (LocalAbsoluteGalois p) :=
  OpenSubgroup.comap (conjHom p g⁻¹) (continuous_conjHom p g⁻¹) U

theorem mem_conjOpen {g : LocalAbsoluteGalois p} {U : OpenSubgroup (LocalAbsoluteGalois p)}
    {x : LocalAbsoluteGalois p} :
    x ∈ conjOpen p g U ↔ conjHom p g⁻¹ x ∈ U :=
  Iff.rfl

theorem conjOpen_mono (g : LocalAbsoluteGalois p) {U V : OpenSubgroup (LocalAbsoluteGalois p)}
    (h : U ≤ V) : conjOpen p g U ≤ conjOpen p g V :=
  fun _ hx => h hx

/-- A convenient form of germ equivalence: two representatives with pointwise
equal cocycles on the intersection of their domains are equivalent. -/
theorem equivalent_of_agree
    (r s : Iut.ContinuousH1GermRepresentative (PsiCnsCoefficientAction p))
    (h : ∀ x : ↥(r.subgroup ⊓ s.subgroup),
      s.cocycle ⟨(x : LocalAbsoluteGalois p), x.2.2⟩ =
        r.cocycle ⟨(x : LocalAbsoluteGalois p), x.2.1⟩) :
    r.Equivalent s := by
  refine ⟨r.subgroup ⊓ s.subgroup, inf_le_left, inf_le_right, 1, ?_⟩
  intro x
  change s.cocycle ⟨(x : LocalAbsoluteGalois p), x.2.2⟩ =
    1⁻¹ * r.cocycle ⟨(x : LocalAbsoluteGalois p), x.2.1⟩ *
      (PsiCnsCoefficientAction p).act (x : LocalAbsoluteGalois p) 1
  rw [h x]
  simp

/-- The translate of a germ representative by g in G_v: the domain is
conjugated and the coefficient values are acted on by g. -/
noncomputable def translateRep (g : LocalAbsoluteGalois p)
    (r : Iut.ContinuousH1GermRepresentative (PsiCnsCoefficientAction p)) :
    Iut.ContinuousH1GermRepresentative (PsiCnsCoefficientAction p) where
  subgroup := conjOpen p g r.subgroup
  cocycle :=
    { toFun := fun x =>
        (PsiCnsCoefficientAction p).act g
          (r.cocycle ⟨conjHom p g⁻¹ (x : LocalAbsoluteGalois p), x.2⟩)
      continuous_toFun := by
        have hmap : Continuous fun x : conjOpen p g r.subgroup =>
            (⟨conjHom p g⁻¹ (x : LocalAbsoluteGalois p), x.2⟩ : r.subgroup) :=
          ((continuous_conjHom p g⁻¹).comp continuous_subtype_val).subtype_mk _
        exact ((PsiCnsCoefficientAction p).continuous_act g).comp
          (r.cocycle.continuous_toFun.comp hmap)
      map_mul' := fun a b => by
        have hArg : (⟨conjHom p g⁻¹ ((a * b : conjOpen p g r.subgroup) :
              LocalAbsoluteGalois p), (a * b).2⟩ : r.subgroup) =
            ⟨conjHom p g⁻¹ (a : LocalAbsoluteGalois p), a.2⟩ *
              ⟨conjHom p g⁻¹ (b : LocalAbsoluteGalois p), b.2⟩ := by
          apply Subtype.ext
          exact map_mul (conjHom p g⁻¹) _ _
        change (PsiCnsCoefficientAction p).act g
            (r.cocycle ⟨conjHom p g⁻¹ ((a * b : conjOpen p g r.subgroup) :
              LocalAbsoluteGalois p), (a * b).2⟩) =
          (PsiCnsCoefficientAction p).act g
              (r.cocycle ⟨conjHom p g⁻¹ (a : LocalAbsoluteGalois p), a.2⟩) *
            (PsiCnsCoefficientAction p).act (a : LocalAbsoluteGalois p)
              ((PsiCnsCoefficientAction p).act g
                (r.cocycle ⟨conjHom p g⁻¹ (b : LocalAbsoluteGalois p), b.2⟩))
        rw [hArg, r.cocycle.map_mul', Iut.ContinuousGroupAction.comap_act,
          Iut.ContinuousGroupAction.act_mul]
        congr 1
        rw [← Iut.ContinuousGroupAction.act_mul_group,
          ← Iut.ContinuousGroupAction.act_mul_group]
        congr 1
        show g * conjHom p g⁻¹ (a : LocalAbsoluteGalois p) =
          (a : LocalAbsoluteGalois p) * g
        rw [conjHom_apply]
        group }

@[simp] theorem translateRep_subgroup (g : LocalAbsoluteGalois p)
    (r : Iut.ContinuousH1GermRepresentative (PsiCnsCoefficientAction p)) :
    (translateRep p g r).subgroup = conjOpen p g r.subgroup := rfl

theorem translateRep_cocycle_apply (g : LocalAbsoluteGalois p)
    (r : Iut.ContinuousH1GermRepresentative (PsiCnsCoefficientAction p))
    (x : (translateRep p g r).subgroup) :
    (translateRep p g r).cocycle x =
      (PsiCnsCoefficientAction p).act g
        (r.cocycle ⟨conjHom p g⁻¹ (x : LocalAbsoluteGalois p), x.2⟩) := rfl


/-! ## 2. The translated germ and the induced action on the direct limit -/

theorem translateRep_equivalent (g : LocalAbsoluteGalois p)
    {first second : Iut.ContinuousH1GermRepresentative (PsiCnsCoefficientAction p)}
    (h : first.Equivalent second) :
    (translateRep p g first).Equivalent (translateRep p g second) := by
  rcases h with ⟨U, hFirst, hSecond, a, hU⟩
  refine ⟨conjOpen p g U, conjOpen_mono p g hFirst, conjOpen_mono p g hSecond,
    (PsiCnsCoefficientAction p).act g a, ?_⟩
  intro x
  let u : U := ⟨conjHom p g⁻¹ (x : LocalAbsoluteGalois p), x.2⟩
  have hval : second.valueOn hSecond u = a⁻¹ * first.valueOn hFirst u *
      (PsiCnsCoefficientAction p).act (u : LocalAbsoluteGalois p) a := hU u
  change (PsiCnsCoefficientAction p).act g (second.valueOn hSecond u) =
    ((PsiCnsCoefficientAction p).act g a)⁻¹ *
      (PsiCnsCoefficientAction p).act g (first.valueOn hFirst u) *
      (PsiCnsCoefficientAction p).act (x : LocalAbsoluteGalois p)
        ((PsiCnsCoefficientAction p).act g a)
  have hlast : (PsiCnsCoefficientAction p).act g
        ((PsiCnsCoefficientAction p).act (u : LocalAbsoluteGalois p) a) =
      (PsiCnsCoefficientAction p).act (x : LocalAbsoluteGalois p)
        ((PsiCnsCoefficientAction p).act g a) := by
    rw [← Iut.ContinuousGroupAction.act_mul_group,
      ← Iut.ContinuousGroupAction.act_mul_group]
    congr 1
    show g * conjHom p g⁻¹ (x : LocalAbsoluteGalois p) = (x : LocalAbsoluteGalois p) * g
    rw [conjHom_apply]
    group
  rw [hval, Iut.ContinuousGroupAction.act_mul, Iut.ContinuousGroupAction.act_mul,
    Iut.ContinuousGroupAction.act_inv, hlast]

/-- The action of g in G_v on the direct limit of continuous first cohomology. -/
noncomputable def translateGerm (g : LocalAbsoluteGalois p) :
    PsiCnsCohomology p → PsiCnsCohomology p :=
  Quotient.map (translateRep p g) (fun _ _ h => translateRep_equivalent p g h)

theorem translateGerm_classOf (g : LocalAbsoluteGalois p)
    (r : Iut.ContinuousH1GermRepresentative (PsiCnsCoefficientAction p)) :
    translateGerm p g (Iut.ContinuousH1Germ.classOf r) =
      Iut.ContinuousH1Germ.classOf (translateRep p g r) :=
  Quotient.map_mk _ _ r

theorem translateGerm_one (g : LocalAbsoluteGalois p) :
    translateGerm p g 1 = 1 := by
  show translateGerm p g (Iut.ContinuousH1Germ.classOf
      (Iut.ContinuousH1GermRepresentative.one (action := PsiCnsCoefficientAction p))) =
    Iut.ContinuousH1Germ.classOf
      (Iut.ContinuousH1GermRepresentative.one (action := PsiCnsCoefficientAction p))
  rw [translateGerm_classOf]
  apply Quotient.sound
  apply equivalent_of_agree p
  intro x
  simp [translateRep_cocycle_apply]

theorem translateGerm_mul (g : LocalAbsoluteGalois p) (x y : PsiCnsCohomology p) :
    translateGerm p g (x * y) = translateGerm p g x * translateGerm p g y := by
  refine Quotient.inductionOn₂ x y ?_
  intro r s
  show translateGerm p g (Iut.ContinuousH1Germ.classOf
      (Iut.ContinuousH1GermRepresentative.mul r s)) =
    translateGerm p g (Iut.ContinuousH1Germ.classOf r) *
      translateGerm p g (Iut.ContinuousH1Germ.classOf s)
  rw [translateGerm_classOf, translateGerm_classOf, translateGerm_classOf,
    ← Iut.ContinuousH1Germ.classOf_mul]
  apply Quotient.sound
  apply equivalent_of_agree p
  intro x
  show (Iut.ContinuousH1GermRepresentative.mul (translateRep p g r)
        (translateRep p g s)).cocycle ⟨(x : LocalAbsoluteGalois p), x.2.2⟩ =
      (translateRep p g (Iut.ContinuousH1GermRepresentative.mul r s)).cocycle
        ⟨(x : LocalAbsoluteGalois p), x.2.1⟩
  rw [Iut.ContinuousH1GermRepresentative.mul_cocycle_apply, translateRep_cocycle_apply,
    translateRep_cocycle_apply, translateRep_cocycle_apply,
    Iut.ContinuousH1GermRepresentative.mul_cocycle_apply,
    Iut.ContinuousGroupAction.act_mul]

theorem translateGerm_conj (g : LocalAbsoluteGalois p) (x : PsiCnsCohomology p) :
    translateGerm p g⁻¹ (translateGerm p g x) = x := by
  refine Quotient.inductionOn x ?_
  intro r
  show translateGerm p g⁻¹ (translateGerm p g (Iut.ContinuousH1Germ.classOf r)) =
    Iut.ContinuousH1Germ.classOf r
  rw [translateGerm_classOf, translateGerm_classOf]
  apply Quotient.sound
  apply equivalent_of_agree p
  intro x
  show r.cocycle ⟨(x : LocalAbsoluteGalois p), x.2.2⟩ =
    (translateRep p g⁻¹ (translateRep p g r)).cocycle
      ⟨(x : LocalAbsoluteGalois p), x.2.1⟩
  rw [translateRep_cocycle_apply, translateRep_cocycle_apply,
    ← Iut.ContinuousGroupAction.act_mul_group, inv_mul_cancel,
    Iut.ContinuousGroupAction.act_one_group]
  congr 1
  apply Subtype.ext
  simp only [Subtype.coe_mk]
  rw [conjHom_apply, conjHom_apply]
  group

theorem translateGerm_conj' (g : LocalAbsoluteGalois p) (x : PsiCnsCohomology p) :
    translateGerm p g (translateGerm p g⁻¹ x) = x := by
  simpa only [inv_inv] using translateGerm_conj p g⁻¹ x

/-- The translate is a monoid homomorphism of the direct limit. -/
noncomputable def translateGermHom (g : LocalAbsoluteGalois p) :
    PsiCnsCohomology p →* PsiCnsCohomology p where
  toFun := translateGerm p g
  map_one' := translateGerm_one p g
  map_mul' := translateGerm_mul p g

/-- The translate is a multiplicative equivalence of the direct limit. -/
noncomputable def translateGermEquiv (g : LocalAbsoluteGalois p) :
    PsiCnsCohomology p ≃* PsiCnsCohomology p :=
  MulEquiv.ofBijective (translateGermHom p g)
    ⟨fun x y hxy => by
        have h1 : translateGerm p g⁻¹ (translateGerm p g x) =
            translateGerm p g⁻¹ (translateGerm p g y) := congrArg (translateGerm p g⁻¹) hxy
        rwa [translateGerm_conj p g x, translateGerm_conj p g y] at h1,
      fun y => ⟨translateGerm p g⁻¹ y, translateGerm_conj' p g y⟩⟩

/-- **The G_v-action on the cohomological limit** lim_J H^1(J, mu_hat^Z). -/
noncomputable def germAction :
    LocalAbsoluteGalois p →* MulAut (PsiCnsCohomology p) where
  toFun g := translateGermEquiv p g
  map_one' := by
    apply MulEquiv.ext
    intro x
    refine Quotient.inductionOn x ?_
    intro r
    show translateGerm p 1 (Iut.ContinuousH1Germ.classOf r) =
      Iut.ContinuousH1Germ.classOf r
    rw [translateGerm_classOf]
    apply Quotient.sound
    apply equivalent_of_agree p
    intro x
    show r.cocycle ⟨(x : LocalAbsoluteGalois p), x.2.2⟩ =
      (translateRep p 1 r).cocycle ⟨(x : LocalAbsoluteGalois p), x.2.1⟩
    rw [translateRep_cocycle_apply, Iut.ContinuousGroupAction.act_one_group]
    congr 1
  map_mul' g h := by
    apply MulEquiv.ext
    intro x
    refine Quotient.inductionOn x ?_
    intro r
    show translateGerm p (g * h) (Iut.ContinuousH1Germ.classOf r) =
      translateGerm p g (translateGerm p h (Iut.ContinuousH1Germ.classOf r))
    rw [translateGerm_classOf, translateGerm_classOf, translateGerm_classOf]
    apply Quotient.sound
    apply equivalent_of_agree p
    intro x
    show (translateRep p g (translateRep p h r)).cocycle
        ⟨(x : LocalAbsoluteGalois p), x.2.2⟩ =
      (translateRep p (g * h) r).cocycle ⟨(x : LocalAbsoluteGalois p), x.2.1⟩
    rw [translateRep_cocycle_apply, translateRep_cocycle_apply,
      translateRep_cocycle_apply,
      ← Iut.ContinuousGroupAction.act_mul_group]
    congr 1

@[simp] theorem germAction_apply (g : LocalAbsoluteGalois p) (x : PsiCnsCohomology p) :
    germAction p g x = translateGerm p g x := rfl

theorem germAction_act_one (g : LocalAbsoluteGalois p) :
    germAction p g 1 = 1 :=
  map_one ((germAction p g : MulAut (PsiCnsCohomology p)).toMonoidHom)

theorem germAction_act_mul (g : LocalAbsoluteGalois p) (x y : PsiCnsCohomology p) :
    germAction p g (x * y) = germAction p g x * germAction p g y :=
  map_mul ((germAction p g : MulAut (PsiCnsCohomology p)).toMonoidHom) x y

theorem germAction_group_mul (g h : LocalAbsoluteGalois p) (x : PsiCnsCohomology p) :
    germAction p (g * h) x = germAction p g (germAction p h x) := by
  show translateGerm p (g * h) x = translateGerm p g (translateGerm p h x)
  rw [← germAction_apply, ← germAction_apply, ← germAction_apply, map_mul]
  rfl

theorem germAction_group_one (x : PsiCnsCohomology p) :
    germAction p 1 x = x := by
  show translateGerm p 1 x = x
  rw [← germAction_apply, map_one]
  rfl


/-! ## 3. The exact first missing: the statable interfaces -/

/-- **Missing interface (M2) of Corollary 1.10, (a).**  Levelwise local
reciprocity on torsion: for every open subgroup U of G_v, the torsion subgroup
of the abelianization of U is the group of roots of unity of the fixed field
of U.

This is the levelwise input of mu_{Q/Z}(G_v) = colim_H (H^ab)_tors.  It is not
proved here.  The transfer maps that make the colimit are a separate gap (M1),
and Abelianization U is the abstract abelianization rather than the profinite
one (see the module doc). -/
def localReciprocityOnTorsion (p : Nat) [Fact (Nat.Prime p)] : Prop :=
  ∀ U : OpenSubgroup (LocalAbsoluteGalois p),
    Nonempty (CommGroup.torsion (Abelianization U) ≃*
      CommGroup.torsion
        (LocalIntegralUnitKummerInjectivity.FixedField p U)ˣ)

/-- **Missing interface (M4) of Corollary 1.10, (b) and (d).**  The normalized
surjection, at the level at which it can be stated on the tree's carriers: a
surjective homomorphism from the actual cohomological limit to the Frobenius
component Multiplicative Integer, trivial on the unit Kummer image and trivial
on the actual Kummer image exactly on the units of the nonzero integral monoid.

The source's map goes from H^1(G_v, mu_hat^Z) onto Z-hat; both that domain and
Z-hat are unavailable here (see (M3), (M4) in the module doc), so this is the
integral, limit-level avatar. -/
def weakFrobeniusNormalization (p : Nat) [Fact (Nat.Prime p)] : Prop :=
  ∃ α : PsiCnsCohomology p →* Multiplicative ℤ,
    Function.Surjective α ∧
      (∀ u : (Otri p)ˣ, α (PsiCnsKummer p (u : Otri p)) = 1) ∧
        (∀ a : Otri p, α (PsiCnsKummer p a) = 1 →
          ∃ u : (Otri p)ˣ, (u : Otri p) = a)

/-- The comparison content of the datum above: inside the actual Kummer image,
the kernel of the normalizing map is exactly the unit Kummer image.  This is
the piece of Corollary 1.10, (d), that survives on the tree's carriers; the
injectivity of the actual Kummer map (S2006) is what makes the two sides
comparable elementwise. -/
theorem weakFrobeniusNormalization_kernel
    (h : weakFrobeniusNormalization p) :
    ∃ α : PsiCnsCohomology p →* Multiplicative ℤ,
      Function.Surjective α ∧
        ∀ a : Otri p, α (PsiCnsKummer p a) = 1 ↔
          ∃ u : (Otri p)ˣ, (u : Otri p) = a := by
  obtain ⟨α, hsurj, hunit, hker⟩ := h
  exact ⟨α, hsurj, fun a => ⟨hker a, fun ⟨u, hu⟩ => by
    rw [← hu]
    exact hunit u⟩⟩

/-! ### (M1) Transfer and the colimit: why no declaration is given

The data of (a) is the direct limit of the torsion abelianizations along the
Verlagerung maps.  Mathlib contains no Verlagerung: for a finite-index
subgroup H of G there is no map H^ab --> G^ab (the transfer is the
corestriction in group homology, and it needs a transversal of H in G together
with the double-coset and commutator bookkeeping).  Without those maps the
colimit type cannot be written down, so mu_{Q/Z}(G_v), mu_hat^Z(G_v) and every
statement quantifying over them (including the source's H^2 statement) are not
merely unproved but unstatable in the present tree.  No axiom or structure is
introduced to paper over this: the missing maps are the first missing item.
-/


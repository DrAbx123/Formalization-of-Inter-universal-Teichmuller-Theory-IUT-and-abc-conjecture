local instance s2032FivePrime : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩

/-! ## 1. The actual local `O^◃` monoid and the `O^× ⊆ O^◃` submonoid -/

/-- The actual local monoid `O^◃` at a rational prime `p`: the *nonzero integral
elements* of the actual local field `AlgebraicClosure ℚ_[p]`, i.e. the monoid
`O^◃(−)` of IUT II, Def. 4.9, (i)--(ii) evaluated at a universal covering of the
bad-place split Frobenioid.  This is a genuine submonoid of the multiplicative
monoid of the actual local field, not an abstract stand-in. -/
noncomputable def localOFieldIntegralSubmonoid (p : Nat) [Fact (Nat.Prime p)] :
    Submonoid (AlgebraicClosure ℚ_[p]) where
  carrier := {x | ‖x‖ ≤ 1 ∧ x ≠ 0}
  one_mem' := ⟨by simp, one_ne_zero⟩
  mul_mem' := by
    intro x y hx hy
    refine ⟨?_, mul_ne_zero hx.2 hy.2⟩
    rw [norm_mul]
    calc ‖x‖ * ‖y‖ ≤ 1 * 1 := mul_le_mul hx.1 hy.1 (norm_nonneg y) zero_le_one
      _ = 1 := by ring

/-- The actual local `O^◃` carrier. -/
noncomputable abbrev LocalOFieldIntegral (p : Nat) [Fact (Nat.Prime p)] : Type :=
  localOFieldIntegralSubmonoid p

/-- The actual local `O^◃` carrier at a place of the S1895 one-column. -/
noncomputable abbrev LocalOFieldIntegralAt (v : PaperV) : Type :=
  @LocalOFieldIntegral v.1 ⟨v.prime⟩

/-- **S1978's actual local `O^×` is a submonoid of the paper's `O^◃`**: the
integral units of the actual local field, as nonzero integral elements. -/
noncomputable def localOFieldUnitsToIntegral (p : Nat) [Fact (Nat.Prime p)] :
    (Integers (AlgebraicClosure ℚ_[p]))ˣ →* LocalOFieldIntegral p where
  toFun u :=
    ⟨(u : AlgebraicClosure ℚ_[p]), by
      refine ⟨(mem_integers_iff _).mp u.val.property, ?_⟩
      intro h
      have hnorm : ‖(u : AlgebraicClosure ℚ_[p])‖ = 1 := norm_unit_eq_one u
      rw [h, norm_zero] at hnorm
      exact zero_ne_one hnorm⟩
  map_one' := by apply Subtype.ext; rfl
  map_mul' u v := by apply Subtype.ext; rfl

/-- The actual `O^× ⊆ O^◃` inclusion is injective: the paper's unit submonoid is
recovered exactly by S1978's carrier. -/
theorem localOFieldUnitsToIntegral_injective (p : Nat) [Fact (Nat.Prime p)] :
    Function.Injective (localOFieldUnitsToIntegral p) := by
  intro u v h
  apply Units.ext
  apply Subtype.ext
  exact congrArg (fun z : LocalOFieldIntegral p => (z : AlgebraicClosure ℚ_[p])) h

/-! ## 2. The actual local uniformizer and the actual `q_v` element -/

/-- The norm of the rational uniformizer `5` in the actual local field at the bad
rational prime: `|5|_5 = 1/5`. -/
theorem localOFieldFive_norm : ‖(5 : AlgebraicClosure ℚ_[5])‖ = (5 : ℝ)⁻¹ := by
  rw [show (5 : AlgebraicClosure ℚ_[5])
      = algebraMap ℚ_[5] (AlgebraicClosure ℚ_[5]) (5 : ℚ_[5]) from (map_natCast _ 5).symm]
  rw [norm_algebraMap']
  exact Padic.norm_p

/-- **The generator of `O^▷(−) ≅ N`** in the actual local model: the actual
uniformizer `5` of the actual local field at the bad rational prime, as an element
of `O^◃`.  Its realified value is `-log 5 < 0`. -/
noncomputable def localOFieldFive : LocalOFieldIntegral 5 :=
  ⟨(5 : AlgebraicClosure ℚ_[5]), by
    refine ⟨?_, by norm_num⟩
    rw [localOFieldFive_norm]
    norm_num⟩

theorem localOFieldFive_coe :
    (localOFieldFive : AlgebraicClosure ℚ_[5]) = (5 : AlgebraicClosure ℚ_[5]) := rfl

/-- The paper's q_v as an actual integral element of the actual local field:
`q_v = 5 ^ order_q`.  This is the element of `O^◃` determined by the q-parameter,
with the actual completed-DVR order `paperQVOrder D b` of S1968. -/
noncomputable def localOFieldQParameter (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) : LocalOFieldIntegral 5 :=
  ⟨(5 : AlgebraicClosure ℚ_[5]) ^ paperQVOrder D b, by
    refine ⟨?_, pow_ne_zero _ (by norm_num)⟩
    rw [norm_pow, localOFieldFive_norm]
    exact pow_le_one₀ (by norm_num) (by norm_num)⟩

theorem localOFieldQParameter_coe (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    (localOFieldQParameter D b : AlgebraicClosure ℚ_[5]) =
      (5 : AlgebraicClosure ℚ_[5]) ^ paperQVOrder D b := rfl

/-- **`q_v` is the `order_b`-th power of the `O^▷`-generator**. -/
theorem localOFieldQParameter_eq_five_pow (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    localOFieldQParameter D b = localOFieldFive ^ paperQVOrder D b := by
  apply Subtype.ext
  show (5 : AlgebraicClosure ℚ_[5]) ^ paperQVOrder D b =
    ((localOFieldFive ^ paperQVOrder D b : LocalOFieldIntegral 5) :
      AlgebraicClosure ℚ_[5])
  rfl

/-- The paper's q_v as a real number is `(1/5) ^ order_b` (S1527). -/
theorem paperQV_eq_inv_five_pow (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    paperQV D b = ((5 : ℝ)⁻¹) ^ paperQVOrder D b := by
  have h1 : paperQV D b = (S1280ReductionClause D.l).qParameter b := rfl
  rw [h1, S1527_qParameter_eq]
  have h : S1527OrderC3 = paperQVOrder D b := by
    rw [S1527OrderC3_eq, paperQVOrder_eq_orderC3]
  rw [h]

/-- **The actual local q_v element has the paper's q_v as its p-adic norm**:
`‖q_v‖ = paperQV D b`.  The realified value of the actual element is therefore
literally the paper's log q_v, not a hard-wired number. -/
theorem localOFieldQParameter_norm (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    ‖(localOFieldQParameter D b : AlgebraicClosure ℚ_[5])‖ = paperQV D b := by
  rw [localOFieldQParameter_coe, norm_pow, localOFieldFive_norm,
    paperQV_eq_inv_five_pow]

/-- The actual q_v is contracting: `‖q_v‖ < 1`. -/
theorem localOFieldQParameter_norm_lt_one (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    ‖(localOFieldQParameter D b : AlgebraicClosure ℚ_[5])‖ < 1 := by
  rw [localOFieldQParameter_norm]
  have h := paperQV_norm_lt_one D b
  rwa [Real.norm_eq_abs, abs_of_pos (paperQV_pos D b)] at h

/-- **The q_v is not an integral unit**: it lies in `O^◃` but not in the `O^×`
submonoid of S1978.  This is why the paper's generator field needs the
`O^▷(A) ⊆ O^◃(A)` (non-unit) monoid and cannot be carried by the unit group. -/
theorem localOFieldQParameter_not_unit_norm (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) (u : (Integers (AlgebraicClosure ℚ_[5]))ˣ) :
    localOFieldQParameter D b ≠ localOFieldUnitsToIntegral 5 u := by
  intro h
  have hnorm := congrArg
    (fun z : LocalOFieldIntegral 5 => ‖(z : AlgebraicClosure ℚ_[5])‖) h
  rw [localOFieldQParameter_norm,
    show ((localOFieldUnitsToIntegral 5 u : LocalOFieldIntegral 5) :
        AlgebraicClosure ℚ_[5]) = (u : AlgebraicClosure ℚ_[5]) from rfl,
    norm_unit_eq_one] at hnorm
  have hlt : paperQV D b < 1 := by
    have := paperQV_norm_lt_one D b
    rwa [Real.norm_eq_abs, abs_of_pos (paperQV_pos D b)] at this
  linarith

/-! ## 3. The actual realified value map `ρ_v` of `O^◃` -/

/-- **The actual realified value map** `ρ_v : O^◃ → Multiplicative ℝ` of a
nonarchimedean place: the norm-log `x ↦ log ‖x‖`.  This is the map through which
IUT II, Def. 4.9, (viii) turns the `O^▷`-generators into the pilot object. -/
noncomputable def localOFieldNormLog (p : Nat) [Fact (Nat.Prime p)] :
    LocalOFieldIntegral p →* Multiplicative ℝ where
  toFun x := Multiplicative.ofAdd (Real.log ‖(x : AlgebraicClosure ℚ_[p])‖)
  map_one' := by
    apply Multiplicative.ext
    simp
  map_mul' := by
    intro x y
    apply Multiplicative.ext
    show Real.log ‖((x * y : LocalOFieldIntegral p) : AlgebraicClosure ℚ_[p])‖ =
      Real.log ‖(x : AlgebraicClosure ℚ_[p])‖ + Real.log ‖(y : AlgebraicClosure ℚ_[p])‖
    rw [show ((x * y : LocalOFieldIntegral p) : AlgebraicClosure ℚ_[p]) =
        (x : AlgebraicClosure ℚ_[p]) * (y : AlgebraicClosure ℚ_[p]) from rfl]
    rw [norm_mul, Real.log_mul (norm_ne_zero_iff.mpr x.2.2)
      (norm_ne_zero_iff.mpr y.2.2)]

/-- The place-indexed actual realified value map. -/
noncomputable abbrev localOFieldNormLogAt (v : PaperV) :
    LocalOFieldIntegralAt v →* Multiplicative ℝ :=
  @localOFieldNormLog v.1 ⟨v.prime⟩

/-- The realified value of every integral element is nonpositive: the pilot
object of IUT II, Def. 4.9, (viii) has negative arithmetic degree. -/
theorem localOFieldNormLog_nonpos (p : Nat) [Fact (Nat.Prime p)]
    (x : LocalOFieldIntegral p) :
    Multiplicative.toAdd (localOFieldNormLog p x) ≤ 0 := by
  show Real.log ‖(x : AlgebraicClosure ℚ_[p])‖ ≤ 0
  exact Real.log_nonpos (norm_nonneg _) x.2.1

/-- The realified value of the actual uniformizer: `ρ_v(5) = -log 5`. -/
theorem localOFieldFive_realified :
    Multiplicative.toAdd (localOFieldNormLog 5 localOFieldFive) = -Real.log 5 := by
  show Real.log ‖(5 : AlgebraicClosure ℚ_[5])‖ = -Real.log 5
  rw [localOFieldFive_norm, Real.log_inv]

/-- **The realified value of the actual local q_v is the paper's negative
arithmetic degree** `qPilotGeneratorValue D b = -|log q_v|`: this is the
`ρ_w(g_w)` of IUT II, Def. 4.9, (viii) computed on the actual element
`localOFieldQParameter D b`, and it is S1979's generator value. -/
theorem localOFieldNormLog_qParameter (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    Multiplicative.toAdd (localOFieldNormLog 5 (localOFieldQParameter D b)) =
      qPilotGeneratorValue D b := by
  show Real.log ‖(localOFieldQParameter D b : AlgebraicClosure ℚ_[5])‖ =
    qPilotGeneratorValue D b
  rw [localOFieldQParameter_norm, ← qPilotGeneratorValue_eq_log]

/-- The realified value of the actual q_v is `-|log q|` at the paper's q_v. -/
theorem localOFieldNormLog_qParameter_eq_neg_abs (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    Multiplicative.toAdd (localOFieldNormLog 5 (localOFieldQParameter D b)) =
      -|Real.log (paperQV D b)| := by
  rw [localOFieldNormLog_qParameter]
  rfl

/-! ## 4. The actual local `O^◃` F-prime-strip and the piloted strip with the
actual q_v generator -/

/-- The actual local Galois action on `O^◃`: an automorphism of the actual local
field is an isometry, hence preserves the integral element monoid. -/
noncomputable def localOFieldGaloisMulAut (p : Nat) [Fact (Nat.Prime p)]
    (σ : LocalAbsoluteGalois p) : MulAut (LocalOFieldIntegral p) where
  toFun x :=
    ⟨σ (x : AlgebraicClosure ℚ_[p]), by
      refine ⟨?_, ?_⟩
      · rw [norm_localGalois_eq]
        exact x.2.1
      · intro h
        exact x.2.2 (σ.injective (by simpa using h))⟩
  invFun x :=
    ⟨σ.symm (x : AlgebraicClosure ℚ_[p]), by
      refine ⟨?_, ?_⟩
      · rw [norm_localGalois_eq]
        exact x.2.1
      · intro h
        exact x.2.2 (σ.symm.injective (by simpa using h))⟩
  left_inv x := by
    apply Subtype.ext
    show σ.symm (σ (x : AlgebraicClosure ℚ_[p])) = (x : AlgebraicClosure ℚ_[p])
    simp
  right_inv x := by
    apply Subtype.ext
    show σ (σ.symm (x : AlgebraicClosure ℚ_[p])) = (x : AlgebraicClosure ℚ_[p])
    simp
  map_mul' x y := by
    apply Subtype.ext
    show σ (((x * y : LocalOFieldIntegral p) : AlgebraicClosure ℚ_[p])) =
      σ (x : AlgebraicClosure ℚ_[p]) * σ (y : AlgebraicClosure ℚ_[p])
    rw [show ((x * y : LocalOFieldIntegral p) : AlgebraicClosure ℚ_[p]) =
        (x : AlgebraicClosure ℚ_[p]) * (y : AlgebraicClosure ℚ_[p]) from rfl]
    exact map_mul σ _ _

/-- The actual local absolute Galois group acts on the actual local `O^◃`. -/
noncomputable def localOFieldGaloisAction (p : Nat) [Fact (Nat.Prime p)] :
    LocalAbsoluteGalois p →* MulAut (LocalOFieldIntegral p) where
  toFun := localOFieldGaloisMulAut p
  map_one' := by
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    rfl
  map_mul' σ τ := by
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    rfl

/-- The place-indexed actual Galois action on `O^◃`. -/
noncomputable abbrev localOFieldGaloisActionAt (v : PaperV) :
    @LocalAbsoluteGalois v.1 ⟨v.prime⟩ →* MulAut (LocalOFieldIntegralAt v) :=
  @localOFieldGaloisAction v.1 ⟨v.prime⟩

/-- **The actual local `O^◃` F-prime-strip on the S1895 place type**: at each
place the value monoid is the actual local `O^◃`, the group is the actual local
absolute Galois group, the action is the actual local Galois action, and the
degree is the actual norm-log realified value `ρ_v`. -/
noncomputable def localOFieldIntegralStrip : FPrimeStrip PaperV where
  Pi := fun v => @LocalAbsoluteGalois v.1 ⟨v.prime⟩
  groupPi := fun v => inferInstance
  G := fun v => @LocalAbsoluteGalois v.1 ⟨v.prime⟩
  groupG := fun v => inferInstance
  proj := fun v => MonoidHom.id _
  proj_surjective := fun v => Function.surjective_id
  Mon := fun v => LocalOFieldIntegralAt v
  commMonoidMon := fun v => inferInstance
  action := fun v => localOFieldGaloisActionAt v
  degree := fun v => localOFieldNormLogAt v

/-- The value monoid of the actual local strip is the actual `O^◃`. -/
theorem localOFieldIntegralStrip_Mon (v : PaperV) :
    localOFieldIntegralStrip.Mon v = LocalOFieldIntegralAt v := rfl

/-- **The piloted F^⊢▷×μ-prime-strip with the actual q_v generator field**: the
underlying F-prime-strip with times-mu structure is the canonical times-mu lift of
the actual local `O^◃` strip (so the generator at the bad place is an element of
the actual local `O^◃`, not a real number), and the generator is the actual q_v
element `localOFieldQParameter D b`. -/
noncomputable def localOFieldPilotedStrip (D : S1895PaperInput) :
    PilotedFTimesMuPrimeStrip PaperV (paperInput D).initial.badPlaces where
  toSourceFTimesMuPrimeStrip := SourceFTimesMuPrimeStrip.canonical localOFieldIntegralStrip
  place := fun _ => paperBadPrime
  generator := fun b => localOFieldQParameter D b

/-- The generator of the actual local piloted strip is the actual local q_v
element of the actual local `O^◃`. -/
theorem localOFieldPilotedStrip_generator (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    (localOFieldPilotedStrip D).generator b = localOFieldQParameter D b := rfl

/-- **The realified value of the actual generator is `-|log q|`**: the
`ρ_w(g_w)` of IUT II, Def. 4.9, (viii) for the actual local piloted strip is
S1968's q-pilot log-volume datum. -/
theorem localOFieldPilotedStrip_value (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    pilotGeneratorRealifiedValue (localOFieldPilotedStrip D) b =
      qPilotGeneratorValue D b :=
  localOFieldNormLog_qParameter D b

theorem localOFieldPilotedStrip_value_eq_log (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    pilotGeneratorRealifiedValue (localOFieldPilotedStrip D) b =
      Real.log (paperQV D b) := by
  rw [localOFieldPilotedStrip_value, qPilotGeneratorValue_eq_log]

theorem localOFieldPilotedStrip_value_eq_neg_abs (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces) :
    pilotGeneratorRealifiedValue (localOFieldPilotedStrip D) b =
      -|Real.log (paperQV D b)| := by
  rw [localOFieldPilotedStrip_value]
  rfl

/-- The actual local piloted strip has negative arithmetic degree, as required by
IUT II, Def. 4.9, (viii). -/
theorem localOFieldPilotedStrip_negative (D : S1895PaperInput) :
    HasNegativePilotGenerator (localOFieldPilotedStrip D) := by
  intro b
  rw [localOFieldPilotedStrip_value]
  exact qPilotGeneratorValue_neg D b

/-- **The associated pilot object of the actual local strip is the actual q-pilot
divisor** of S1968 / IUT III, Def. 3.8, (i). -/
theorem associatedPilotObject_localOFieldPilotedStrip (D : S1895PaperInput) :
    associatedPilotObject D (localOFieldPilotedStrip D) = paperQPilotDivisor D := by
  unfold associatedPilotObject pilotCoefficient paperQPilotDivisor
  rw [localOFieldPilotedStrip_value, qPilotGeneratorValue_eq_order,
    paperBadBasePlace_weight]
  have hlog : Real.log 5 ≠ 0 := ne_of_gt (Real.log_pos (by norm_num))
  field_simp

/-! ## 5. The R6 link: the R6-proper paper strip carries exactly this actual
generator data -/

/-- **The generator field of the paper's Def. 4.9, (viii) data, realised by the
actual local q_v**: at every bad place the realified generator value is the actual
local norm-log of the actual local q_v element. -/
def HasActualQVGenerator (D : S1895PaperInput)
    (S : PilotedFTimesMuPrimeStrip PaperV (paperInput D).initial.badPlaces) : Prop :=
  ∀ b, pilotGeneratorRealifiedValue S b =
    Multiplicative.toAdd (localOFieldNormLog 5 (localOFieldQParameter D b))

theorem localOFieldPilotedStrip_hasActualQVGenerator (D : S1895PaperInput) :
    HasActualQVGenerator D (localOFieldPilotedStrip D) := by
  intro b
  rw [localOFieldPilotedStrip_value, localOFieldNormLog_qParameter]

/-- S1979's q_v-scalar paper strip carries exactly the actual local q_v generator
data: its generator value is the realified value of the actual local element. -/
theorem paperQPilotPilotedStrip_hasActualQVGenerator (D : S1895PaperInput) :
    HasActualQVGenerator D (paperQPilotPilotedStrip D) := by
  intro b
  rw [paperQPilotPilotedStrip_value, localOFieldNormLog_qParameter]
  exact (qPilotGeneratorValue_eq_log D b).symm

/-- The coefficient of the Def. 4.9, (viii) pilot object of any piloted strip
carrying the actual q_v generator data is the actual q_v order. -/
theorem pilotCoefficient_eq_of_actualQVGenerator (D : S1895PaperInput)
    (S : PilotedFTimesMuPrimeStrip PaperV (paperInput D).initial.badPlaces)
    (h : HasActualQVGenerator D S) :
    pilotCoefficient S (paperQVBad0 D)
      (IUTIVPlace.weight (PaperFmod D)
        (IUTIVPlace.finite (F := PaperFmod D)
          (paperBadBasePlace D (paperQVBad0 D)))) =
      (paperQVOrder D (paperQVBad0 D) : ℝ) := by
  unfold pilotCoefficient
  rw [h (paperQVBad0 D), localOFieldNormLog_qParameter, qPilotGeneratorValue_eq_order,
    paperBadBasePlace_weight]
  have hlog : Real.log 5 ≠ 0 := ne_of_gt (Real.log_pos (by norm_num))
  field_simp

/-- **Every piloted strip with the actual q_v generator data computes S1968's
actual q-pilot divisor**: the associated pilot object depends only on the
realified generator values, which are those of the actual local q_v. -/
theorem associatedPilotObject_eq_of_actualQVGenerator (D : S1895PaperInput)
    (S : PilotedFTimesMuPrimeStrip PaperV (paperInput D).initial.badPlaces)
    (h : HasActualQVGenerator D S) :
    associatedPilotObject D S = paperQPilotDivisor D := by
  unfold associatedPilotObject paperQPilotDivisor
  rw [pilotCoefficient_eq_of_actualQVGenerator D S h]

/-- The piloted strip of S1979 already computes the q-pilot divisor (recovered
here as the special case of the actual-data theorem). -/
theorem associatedPilotObject_paperStrip_eq (D : S1895PaperInput) :
    associatedPilotObject D (paperQPilotPilotedStrip D) = paperQPilotDivisor D :=
  associatedPilotObject_eq_of_actualQVGenerator D _
    (paperQPilotPilotedStrip_hasActualQVGenerator D)

/-- **R6 proper, realised by the actual q_v generator data.**  The paper strip is
R6-proper (S1979's piloted identification), it carries the actual local q_v
generator data, and both it and the actual local `O^◃` strip have S1968's actual
q-pilot divisor as associated pilot object.  The first conjunct is the requested
realified value `-|log q|` of the actual generator. -/
theorem s2032_r6_proper (D : S1895PaperInput) :
    Multiplicative.toAdd
        (localOFieldNormLog 5 (localOFieldQParameter D (paperQVBad0 D))) =
        -|Real.log (paperQV D (paperQVBad0 D))| ∧
      R6Proper D (paperQPilotPilotedStrip D).toSourceFTimesMuPrimeStrip ∧
      HasActualQVGenerator D (paperQPilotPilotedStrip D) ∧
      HasActualQVGenerator D (localOFieldPilotedStrip D) ∧
      associatedPilotObject D (paperQPilotPilotedStrip D) = paperQPilotDivisor D ∧
      associatedPilotObject D (localOFieldPilotedStrip D) = paperQPilotDivisor D ∧
      HasNegativePilotGenerator (localOFieldPilotedStrip D) := by
  refine ⟨?_, r6Proper_of_pilotedIdentification D _ (paperQPilotPilotedIdentification D),
    paperQPilotPilotedStrip_hasActualQVGenerator D,
    localOFieldPilotedStrip_hasActualQVGenerator D,
    associatedPilotObject_paperStrip_eq D,
    associatedPilotObject_localOFieldPilotedStrip D,
    localOFieldPilotedStrip_negative D⟩
  rw [localOFieldNormLog_qParameter]
  rfl

/-- The piloted R6 identification is exactly the identification of the actual q_v
generator data: any piloted strip carrying it and the paper strip cannot be
distinguished by the associated pilot object. -/
theorem s2032_generator_determines_pilotObject (D : S1895PaperInput)
    (S : PilotedFTimesMuPrimeStrip PaperV (paperInput D).initial.badPlaces)
    (h : HasActualQVGenerator D S) :
    associatedPilotObject D S = associatedPilotObject D (localOFieldPilotedStrip D) := by
  rw [associatedPilotObject_eq_of_actualQVGenerator D S h,
    associatedPilotObject_localOFieldPilotedStrip]

/-! ## 6. The exact first missing, proved

Two obstructions delimit the honest construction above.  They are proved, not
asserted: (a) the actual `O^×` carrier of S1978 cannot carry the q_v generator at
all, and (b) the actual local `O^◃` strip cannot be the unpiloted R6 paper side,
because R6 proper forces trivial times-mu fibers while `1 + 5` makes the actual
local fiber nontrivial.  Hence the paper's `O^▷(A) ⊆ O^◃(A)` generator is carried
through the realified value maps (Def. 4.9, (viii)) exactly as constructed in
sections 4--5, and attaching it to an R6-proper *strip* requires the rebased input
`S1978RebasedPaperInput D`. -/

/-- **Every integral unit has realified value `0`**: the actual `O^×` carrier of
S1978 has trivial norm-log degree. -/
theorem localOFieldUnitsDegree_eq_one (p : Nat) [Fact (Nat.Prime p)]
    (u : LocalOFieldUnits p) : localOFieldUnitsDegree p u = 1 := by
  have h : ‖((Units.map (Integers (AlgebraicClosure ℚ_[p])).subtype.toMonoidHom u :
      (AlgebraicClosure ℚ_[p])ˣ) : AlgebraicClosure ℚ_[p])‖ = 1 := by
    rw [show ((Units.map (Integers (AlgebraicClosure ℚ_[p])).subtype.toMonoidHom u :
        (AlgebraicClosure ℚ_[p])ˣ) : AlgebraicClosure ℚ_[p]) =
        (u : AlgebraicClosure ℚ_[p]) from rfl]
    exact norm_unit_eq_one u
  show Multiplicative.ofAdd
    (Real.log ‖((Units.map (Integers (AlgebraicClosure ℚ_[p])).subtype.toMonoidHom u :
      (AlgebraicClosure ℚ_[p])ˣ) : AlgebraicClosure ℚ_[p])‖) = 1
  rw [h, Real.log_one]
  rfl

/-- The degree of the actual local `O^×` strip is the trivial character. -/
theorem localOFieldStrip_degree_eq_one (v : PaperV)
    (u : localOFieldStrip.Mon v) : localOFieldStrip.degree v u = 1 :=
  @localOFieldUnitsDegree_eq_one v.1 ⟨v.prime⟩ u

/-- **The actual `O^×` carrier cannot host the paper's q_v generator.  Any
generator taken from the actual local unit group at the bad place has realified
value `0`, never the paper's negative arithmetic degree `-|log q| ≠ 0`.  This
proves that the extension of the carrier from `O^×` (S1978) to `O^◃` (section 1)
is necessary, not cosmetic. -/
theorem oUnits_cannot_realise_qv (D : S1895PaperInput)
    (b : (paperInput D).initial.badPlaces)
    (u : localOFieldStrip.Mon paperBadPrime) :
    Multiplicative.toAdd (localOFieldStrip.degree paperBadPrime u) ≠
      qPilotGeneratorValue D b := by
  rw [localOFieldStrip_degree_eq_one]
  intro h
  exact qPilotGeneratorValue_ne_zero D b h.symm

/-- The piloted strip over the actual local `O^×` carrier with an arbitrary
generator field, at the paper's bad place.  Every such generator field has
realified value `0`, so no choice of generator makes it carry the actual q_v. -/
noncomputable def oUnitsPilotedStrip (D : S1895PaperInput)
    (gen : ∀ _b : (paperInput D).initial.badPlaces,
      (SourceFTimesMuPrimeStrip.canonical localOFieldStrip).Mon paperBadPrime) :
    PilotedFTimesMuPrimeStrip PaperV (paperInput D).initial.badPlaces where
  toSourceFTimesMuPrimeStrip := SourceFTimesMuPrimeStrip.canonical localOFieldStrip
  place := fun _ => paperBadPrime
  generator := gen

theorem oUnitsPilotedStrip_value (D : S1895PaperInput)
    (gen : ∀ _b : (paperInput D).initial.badPlaces,
      (SourceFTimesMuPrimeStrip.canonical localOFieldStrip).Mon paperBadPrime)
    (b : (paperInput D).initial.badPlaces) :
    pilotGeneratorRealifiedValue (oUnitsPilotedStrip D gen) b = 0 := by
  show Multiplicative.toAdd
    (localOFieldStrip.degree paperBadPrime (gen b)) = 0
  rw [localOFieldStrip_degree_eq_one]
  rfl

/-- **No generator field on the actual `O^×` carrier has the paper's q_v
realified value**: the `O^▷(A) ⊆ O^◃(A)` generator of IUT II, Def. 4.9, (viii)
genuinely requires non-unit integral elements. -/
theorem oUnitsPilotedStrip_not_actualQV (D : S1895PaperInput)
    (gen : ∀ _b : (paperInput D).initial.badPlaces,
      (SourceFTimesMuPrimeStrip.canonical localOFieldStrip).Mon paperBadPrime) :
    ¬ HasActualQVGenerator D (oUnitsPilotedStrip D gen) := by
  intro h
  have h0 := h (paperQVBad0 D)
  rw [oUnitsPilotedStrip_value] at h0
  have hneg : Multiplicative.toAdd
      (localOFieldNormLog 5 (localOFieldQParameter D (paperQVBad0 D))) < 0 := by
    rw [localOFieldNormLog_qParameter]
    exact qPilotGeneratorValue_neg D (paperQVBad0 D)
  linarith

/-- The actual local `-1` of `O^◃`: the nontrivial `2`-torsion element of the
actual local monoid. -/
noncomputable def localOFieldNegOne (p : Nat) [Fact (Nat.Prime p)] :
    LocalOFieldIntegral p :=
  ⟨(-1 : AlgebraicClosure ℚ_[p]), by
    refine ⟨?_, ?_⟩
    · rw [norm_neg, norm_one]
    · exact neg_ne_zero.mpr one_ne_zero⟩

theorem localOFieldNegOne_mul_self (p : Nat) [Fact (Nat.Prime p)] :
    localOFieldNegOne p * localOFieldNegOne p = 1 := by
  apply Subtype.ext
  show (-1 : AlgebraicClosure ℚ_[p]) * (-1) = 1
  ring

theorem localOFieldNegOne_ne_one (p : Nat) [Fact (Nat.Prime p)] :
    localOFieldNegOne p ≠ 1 := by
  intro h
  have h' : (-1 : AlgebraicClosure ℚ_[p]) = 1 :=
    congrArg (fun z : LocalOFieldIntegral p => (z : AlgebraicClosure ℚ_[p])) h
  have h2 : (2 : AlgebraicClosure ℚ_[p]) = 0 := by
    have h3 : (-1 : AlgebraicClosure ℚ_[p]) + 1 = 1 + 1 :=
      congrArg (fun z : AlgebraicClosure ℚ_[p] => z + 1) h'
    simpa using h3.symm
  haveI : CharZero (AlgebraicClosure ℚ_[p]) :=
    charZero_of_injective_algebraMap
      (algebraMap ℚ_[p] (AlgebraicClosure ℚ_[p])).injective
  exact two_ne_zero h2

/-- The local `-1` of `O^◃` at the paper's bad place, read in the value monoid of
the canonical times-mu lift of the actual local strip (the value monoid in which
the R6 comparison takes place). -/
noncomputable def localOFieldNegOneCanonical (D : S1895PaperInput) :
    (SourceFTimesMuPrimeStrip.canonical localOFieldIntegralStrip).Mon paperBadPrime :=
  localOFieldNegOne 5

theorem localOFieldNegOneCanonical_mul_self (D : S1895PaperInput) :
    localOFieldNegOneCanonical D * localOFieldNegOneCanonical D = 1 := by
  apply Subtype.ext
  show (-1 : AlgebraicClosure ℚ_[5]) * (-1) = 1
  ring

theorem localOFieldNegOneCanonical_ne_one (D : S1895PaperInput) :
    localOFieldNegOneCanonical D ≠ 1 := by
  intro h
  have h' : localOFieldNegOne 5 = (1 : LocalOFieldIntegral 5) := h
  exact localOFieldNegOne_ne_one 5 h'

/-- In the reduced anchor's value monoid `Multiplicative {x ≤ 0}` the only
`2`-torsion element is the identity: `y * y = 1` forces `y = 1` (additively
`2a = 0` with `a ≤ 0` forces `a = 0`). -/
theorem sourceHaarActualValueMonoid_mul_self_eq_one
    {y : SourceHaarActualValueMonoid} (hy : y * y = 1) : y = 1 := by
  have h : Multiplicative.toAdd y + Multiplicative.toAdd y = 0 := by
    have := congrArg Multiplicative.toAdd hy
    simpa using this
  have hzero : Multiplicative.toAdd y = 0 := by
    have h2 : ((Multiplicative.toAdd y : sourceHaarActualNonpositiveAddSubmonoid) : ℝ) +
        ((Multiplicative.toAdd y : sourceHaarActualNonpositiveAddSubmonoid) : ℝ) = 0 := by
      have := congrArg
        (fun z : sourceHaarActualNonpositiveAddSubmonoid => (z : ℝ)) h
      simpa using this
    have hle :
        ((Multiplicative.toAdd y : sourceHaarActualNonpositiveAddSubmonoid) : ℝ) ≤ 0 :=
      (Multiplicative.toAdd y).property
    have hzeroR :
        ((Multiplicative.toAdd y : sourceHaarActualNonpositiveAddSubmonoid) : ℝ) = 0 := by
      linarith
    exact Subtype.ext hzeroR
  calc y = Multiplicative.ofAdd (Multiplicative.toAdd y) := rfl
    _ = Multiplicative.ofAdd 0 := by rw [hzero]
    _ = 1 := rfl

/-- **The actual local `O^◃` strip is not R6-proper against the reduced anchor**:
R6 proper forces the paper strip's times-mu fiber to be subsingleton (S1968), but
the actual local `O^◃` monoid has the nontrivial `2`-torsion element `-1`, which
under a monoid equivalence would give a nontrivial `2`-torsion element of the
reduced anchor's value monoid `Multiplicative {x ≤ 0}`, where the only such
element is `1`.  This is the exact reason why the *unpiloted* R6 paper side cannot
be the actual local carrier strip: attaching the actual generator to an R6-proper
strip requires the rebased input, i.e. S1978's `S1978RebasedPaperInput D`. -/
theorem not_r6Proper_localOFieldIntegralStrip (D : S1895PaperInput) :
    ¬ R6Proper D (SourceFTimesMuPrimeStrip.canonical localOFieldIntegralStrip) := by
  intro h
  obtain ⟨φ⟩ := h
  obtain ⟨ψ, _⟩ := SourceFTimesMuPrimeStripFullPolyIsomorphism.representative_exists φ
  let e := ψ.toF.isoMon paperBadPrime
  have hmul : e.symm (localOFieldNegOneCanonical D) *
      e.symm (localOFieldNegOneCanonical D) = 1 := by
    rw [← map_mul, localOFieldNegOneCanonical_mul_self D, map_one]
  have hone : e.symm (localOFieldNegOneCanonical D) = 1 :=
    sourceHaarActualValueMonoid_mul_self_eq_one hmul
  have hcontra : localOFieldNegOneCanonical D = 1 := by
    have h := congrArg e hone
    rw [MulEquiv.apply_symm_apply, map_one] at h
    exact h
  exact localOFieldNegOneCanonical_ne_one D hcontra




/-- **The exact first missing, in final form.**  The actual local `O^◃` generator
field of the paper's q_v is constructed and its realified value is `-|log q|`
(sections 2--5), and the R6-proper paper strip carries exactly that generator data
(`s2032_r6_proper`).  The two missing pieces are precisely delimited:
(a) the actual `O^×` carrier cannot carry the generator (`oUnits_cannot_realise_qv`);
(b) the actual local `O^◃` strip is not R6-proper
    (`not_r6Proper_localOFieldIntegralStrip`), so a *single* real strip carrying
    both the actual local `O^◃` value monoid and the unpiloted R6 identification
    requires the rebased input `S1978RebasedPaperInput D` (S1978), not a new
    definition. -/
theorem s2032_first_missing (D : S1895PaperInput) :
    (¬ R6Proper D (SourceFTimesMuPrimeStrip.canonical localOFieldIntegralStrip)) ∧
      (∀ gen : ∀ _b : (paperInput D).initial.badPlaces,
          (SourceFTimesMuPrimeStrip.canonical localOFieldStrip).Mon paperBadPrime,
        ¬ HasActualQVGenerator D (oUnitsPilotedStrip D gen)) ∧
      R6Proper D (paperQPilotPilotedStrip D).toSourceFTimesMuPrimeStrip ∧
      HasActualQVGenerator D (paperQPilotPilotedStrip D) :=
  ⟨not_r6Proper_localOFieldIntegralStrip D,
    fun gen => oUnitsPilotedStrip_not_actualQV D gen,
    r6Proper_of_pilotedIdentification D _ (paperQPilotPilotedIdentification D),
    paperQPilotPilotedStrip_hasActualQVGenerator D⟩


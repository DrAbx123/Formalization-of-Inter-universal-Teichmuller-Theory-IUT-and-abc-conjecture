import LeanFormal.IUT.IUTI.HodgeTheater.LocalPrimePlaces

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 4000000

namespace LeanFormal.IUT.XiFPaper.S2442InertiaAPI

open LeanFormal.IUT

variable (p : Nat) [Fact (Nat.Prime p)]

/-- Torsion units of prime-to-p order in the algebraic closure. -/
def PadicPrimeToPTorsion : Subgroup (AlgebraicClosure ℚ_[p])ˣ where
  carrier := {u | ∃ n : Nat, n.Coprime p ∧ u ^ n = 1}
  one_mem' := by
    refine ⟨1, ?_, ?_⟩
    · simp
    · simp
  mul_mem' := by
    rintro u v ⟨n, hn, hun⟩ ⟨m, hm, hvm⟩
    refine ⟨n * m, ?_, ?_⟩
    · rw [Nat.coprime_mul_iff_left]
      exact ⟨hn, hm⟩
    · simp only [mul_pow, pow_mul, hun, one_mul]
      rw [← pow_mul, Nat.mul_comm n m, pow_mul, hvm, one_pow]
  inv_mem' := by
    rintro u ⟨n, hn, hun⟩
    refine ⟨n, hn, ?_⟩
    rw [inv_pow, hun, inv_one]

instance : CommGroup (PadicPrimeToPTorsion p) := inferInstanceAs (CommGroup {u : (AlgebraicClosure ℚ_[p])ˣ // _})

/-- The action of G_Qp on prime-to-p torsion units of the algebraic closure. -/
noncomputable def PadicPrimeToPAction :
    LocalAbsoluteGalois p →* MulAut (PadicPrimeToPTorsion p) where
  toFun σ :=
    { toFun := fun u =>
        ⟨localGaloisUnitsAction p σ (u : (AlgebraicClosure ℚ_[p])ˣ), by
          rcases u.2 with ⟨n, hn, hun⟩
          refine ⟨n, hn, ?_⟩
          change (localGaloisUnitsAction p σ (u : (AlgebraicClosure ℚ_[p])ˣ)) ^ n = 1
          rw [← map_pow, hun, map_one]⟩
      invFun := fun u =>
        ⟨localGaloisUnitsAction p σ⁻¹ (u : (AlgebraicClosure ℚ_[p])ˣ), by
          rcases u.2 with ⟨n, hn, hun⟩
          refine ⟨n, hn, ?_⟩
          change (localGaloisUnitsAction p σ⁻¹ (u : (AlgebraicClosure ℚ_[p])ˣ)) ^ n = 1
          rw [← map_pow, hun, map_one]⟩
      left_inv := by
        intro u
        ext
        simp
      right_inv := by
        intro u
        ext
        simp
      map_mul' := by
        intro u v
        ext
        simp }
  map_one' := by
    apply MulEquiv.ext
    intro u
    apply Subtype.ext
    apply Units.ext
    simp
  map_mul' := by
    intro σ τ
    apply MulEquiv.ext
    intro u
    apply Subtype.ext
    apply Units.ext
    simp

/-- The inertia subgroup: elements acting trivially on all prime-to-p torsion units. -/
def PadicAbsoluteGaloisInertia : Subgroup (LocalAbsoluteGalois p) :=
  (PadicPrimeToPAction p).ker

instance PadicAbsoluteGaloisInertia_normal :
    (PadicAbsoluteGaloisInertia p).Normal :=
  MonoidHom.normal_ker (PadicPrimeToPAction p)

theorem mem_PadicAbsoluteGaloisInertia_iff (σ : LocalAbsoluteGalois p) :
    σ ∈ PadicAbsoluteGaloisInertia p ↔
      ∀ u : PadicPrimeToPTorsion p, PadicPrimeToPAction p σ u = u := by
  constructor
  · intro h u
    change PadicPrimeToPAction p σ = 1 at h
    exact congrArg (fun f : PadicPrimeToPTorsion p → PadicPrimeToPTorsion p => f u)
      (congrArg (fun e : MulAut (PadicPrimeToPTorsion p) =>
        (e : PadicPrimeToPTorsion p → PadicPrimeToPTorsion p)) h)
  · intro h
    apply MulEquiv.ext
    intro u
    exact h u

/-- The inertia quotient G_Qp / I. -/
abbrev PadicInertiaQuotient : Type :=
  LocalAbsoluteGalois p ⧸ PadicAbsoluteGaloisInertia p

/-- The exact procyclic/Frobenius-lift statement: the inertia quotient is
 topologically generated by one element (the image of a Frobenius lift). -/
def PadicInertiaQuotientProcyclic : Prop :=
  ∃ σ : PadicInertiaQuotient p,
    (Subgroup.closure ({σ} : Set (PadicInertiaQuotient p))).topologicalClosure = ⊤

#check PadicPrimeToPTorsion
#check PadicPrimeToPAction
#check PadicAbsoluteGaloisInertia
#check PadicAbsoluteGaloisInertia_normal
#check mem_PadicAbsoluteGaloisInertia_iff
#check PadicInertiaQuotient
#check PadicInertiaQuotientProcyclic

#print axioms PadicPrimeToPTorsion
#print axioms PadicPrimeToPAction
#print axioms PadicAbsoluteGaloisInertia_normal
#print axioms mem_PadicAbsoluteGaloisInertia_iff

end LeanFormal.IUT.XiFPaper.S2442InertiaAPI

end
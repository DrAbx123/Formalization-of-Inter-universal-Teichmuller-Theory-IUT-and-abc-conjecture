/-!
# S1785 -- epimorphisms of finite etale K-algebras are surjective, and surjections split

For a field K this file proves the two statements left open by S1747:

* `S1785.epiSurjective : S1747.EpiSurjective K`: every epimorphism
  phi : B →ₐ[K] A of finite etale K-algebras (epi in the category of finite
  etale K-algebras) is surjective.
* `S1785.surjectiveSplit : S1747.SurjectiveSplit K`: every surjective such phi
  is, up to an algebra isomorphism B ≃ₐ[K] A × C, the first projection.

Route for EpiSurjective:
1. `Algebra.Etale.iff_exists_algEquiv_prod` decomposes A and B as finite
   products of finite separable field extensions of K; each component of the
   induced map psi : (prod j, Bj j) → (prod i, Ai i) factors through a unique
   projection (`S1747.exists_factor`), giving m : I → J and
   sigma i : Bj (m i) →ₐ[K] Ai i.
2. For each i, the test algebra Ai i ⊗[Bj (m i)] Ai i is a finite etale
   K-algebra; the two canonical maps out of the product agree after psi, so
   epimorphy forces x ⊗ 1 = 1 ⊗ x for all x. The multiplication map is then
   bijective, and finrank (Ai i ⊗ Ai i) = d * d with d = finrank Ai i forces
   d = 1, i.e. sigma i is surjective.
3. If m i1 = m i2 with i1 ≠ i2, an endomorphism of the product of the Ai built
   from sigma i1 and the inverse of sigma i2 agrees with the identity after psi,
   contradicting epimorphy; so m is injective.
4. Coordinatewise surjectivity of the sigma i plus injectivity of m gives
   surjectivity of phi.

Route for SurjectiveSplit: idempotent splitting (a finite etale K-algebra is
reduced Artinian, hence semisimple; every ideal is generated by an idempotent),
the Chinese remainder theorem, and the first isomorphism theorem; this follows
S1771's proof of exists_prod_algEquiv_of_surjective.

No sorry is used; the axiom audit at the end of the file shows only propext,
Classical.choice and Quot.sound.
-/

noncomputable section
set_option maxSynthPendingDepth 16
open scoped TensorProduct
open Finset

namespace S1785

/-! ### Elementary helpers -/

/-- A K-algebra map out of a field is injective. -/
lemma injective_of_field {K F L : Type} [Field K] [Field F] [Field L]
    [Algebra K F] [Algebra K L] (f : F →ₐ[K] L) : Function.Injective f := by
  intro x y hxy
  have h : f (x - y) = 0 := by rw [map_sub, hxy, sub_self]
  by_contra hne
  have hx : x - y ≠ 0 := sub_ne_zero.mpr hne
  have h1 : f ((x - y)⁻¹ * (x - y)) = 1 := by rw [inv_mul_cancel₀ hx, map_one]
  rw [map_mul, h, mul_zero] at h1
  exact zero_ne_one h1

/-- A finite separable field extension is a finite etale algebra. -/
lemma etale_of_finite_separable (K L : Type) [Field K] [Field L] [Algebra K L]
    [Module.Finite K L] [Algebra.IsSeparable K L] : Algebra.Etale K L where
  formallyEtale := Algebra.FormallyEtale.of_isSeparable K L
  finitePresentation := (Algebra.FinitePresentation.of_finiteType (R := K) (A := L)).mp inferInstance

lemma nat_eq_one_of_mul_self_eq_self {d : ℕ} (h : d * d = d) (hpos : 0 < d) : d = 1 := by
  have h1 : d * (d - 1) = 0 := by rw [Nat.mul_sub_one, h, Nat.sub_self]
  rcases Nat.mul_eq_zero.mp h1 with h2 | h2
  · omega
  · omega

-- Cast an algebra along an equality of the index.
noncomputable def algEquivCast {K J : Type} [Field K] (Bj : J → Type) [∀ j, CommRing (Bj j)]
    [∀ j, Algebra K (Bj j)] {j1 j2 : J} (h : j1 = j2) : Bj j1 ≃ₐ[K] Bj j2 :=
  h ▸ (AlgEquiv.refl : Bj j1 ≃ₐ[K] Bj j1)

lemma algEquivCast_apply_section {K J : Type} [Field K] (Bj : J → Type) [∀ j, CommRing (Bj j)]
    [∀ j, Algebra K (Bj j)] {j1 j2 : J} (h : j1 = j2) (b : ∀ j, Bj j) :
    algEquivCast (K := K) Bj h (b j1) = b j2 := by
  cases h
  rfl

/-! ### The tensor-product test at a field extension -/

set_option maxHeartbeats 800000 in
-- If A is finite separable over K and the two canonical maps from A to A tensor_F A
-- agree, then F to A is surjective.
lemma surjective_algebraMap_of_tmul_comm
    {K Bm Ai : Type} [Field K] [Field Bm] [Field Ai]
    [Algebra K Bm] [Algebra K Ai] [Algebra Bm Ai] [IsScalarTower K Bm Ai]
    [Module.Finite K Ai] [Algebra.IsSeparable K Ai]
    (hcomm : ∀ x : Ai, x ⊗ₜ[Bm] (1 : Ai) = (1 : Ai) ⊗ₜ[Bm] x) :
    Function.Surjective (algebraMap Bm Ai) := by
  haveI : Module.Finite Bm Ai :=
    Module.Finite.of_restrictScalars_finite (R := K) (A := Bm) (M := Ai)
  have hsurj : Function.Surjective (Algebra.TensorProduct.lmul' (R := Bm) : Ai ⊗[Bm] Ai →ₐ[Bm] Ai) := by
    intro x
    exact ⟨x ⊗ₜ[Bm] 1, by simp⟩
  have key : ∀ z : Ai ⊗[Bm] Ai,
      Algebra.TensorProduct.includeLeft (R := Bm) (S := Bm) (A := Ai) (B := Ai)
        (Algebra.TensorProduct.lmul' (R := Bm) z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul x y =>
        rw [Algebra.TensorProduct.lmul'_apply_tmul, map_mul]
        calc Algebra.TensorProduct.includeLeft (R := Bm) (S := Bm) (A := Ai) (B := Ai) x *
              Algebra.TensorProduct.includeLeft (R := Bm) (S := Bm) (A := Ai) (B := Ai) y
            = (x ⊗ₜ[Bm] 1) * (y ⊗ₜ[Bm] 1) := by
              rw [Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeLeft_apply]
          _ = (x ⊗ₜ[Bm] 1) * (1 ⊗ₜ[Bm] y) := by rw [hcomm y]
          _ = x ⊗ₜ[Bm] y := by rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hinj : Function.Injective (Algebra.TensorProduct.lmul' (R := Bm) : Ai ⊗[Bm] Ai →ₐ[Bm] Ai) := by
    intro x y hxy
    have h1 := key x
    have h2 := key y
    rw [hxy] at h1
    rw [h2] at h1
    exact h1.symm
  have hbij : Function.Bijective (Algebra.TensorProduct.lmul' (R := Bm) : Ai ⊗[Bm] Ai →ₐ[Bm] Ai) :=
    ⟨hinj, hsurj⟩
  let e : (Ai ⊗[Bm] Ai) ≃ₗ[Bm] Ai :=
    LinearEquiv.ofBijective (Algebra.TensorProduct.lmul' (R := Bm)).toLinearMap hbij
  have h1 : Module.finrank Bm (Ai ⊗[Bm] Ai) = Module.finrank Bm Ai := e.finrank_eq
  have h2 : Module.finrank Bm (Ai ⊗[Bm] Ai) = Module.finrank Bm Ai * Module.finrank Bm Ai :=
    Module.finrank_tensorProduct (R := Bm) (S := Bm) (M := Ai) (M' := Ai)
  have hdd : Module.finrank Bm Ai * Module.finrank Bm Ai = Module.finrank Bm Ai := by
    rw [← h2, h1]
  have hpos : 0 < Module.finrank Bm Ai := by
    rw [Module.finrank_pos_iff_of_free Bm Ai]
    infer_instance
  have hone : Module.finrank Bm Ai = 1 := nat_eq_one_of_mul_self_eq_self hdd hpos
  exact ((Algebra.finrank_eq_one_iff_bijective_algebraMap (F := Bm) (E := Ai)).mp hone).2

/-! ### Epimorphisms of finite etale algebras are surjective -/

-- If the epimorphism property of the product map psi holds at the tensor test algebra
-- Ai i tensor over Bj (m i) with itself, then the component map sigma i is surjective.
set_option maxHeartbeats 800000 in
lemma sigma_surjective_of_epi
    {K : Type} [Field K] {I J : Type} [Finite I] [Finite J]
    (Ai : I → Type) [∀ i, Field (Ai i)] [∀ i, Algebra K (Ai i)]
    [∀ i, Module.Finite K (Ai i)] [∀ i, Algebra.IsSeparable K (Ai i)]
    (Bj : J → Type) [∀ j, Field (Bj j)] [∀ j, Algebra K (Bj j)]
    [∀ j, Module.Finite K (Bj j)]
    (m : I → J) (σ : ∀ i, Bj (m i) →ₐ[K] Ai i)
    (psi : (∀ j, Bj j) →ₐ[K] (∀ i, Ai i))
    (hpsi : ∀ (i : I) (x : ∀ j, Bj j), psi x i = σ i (x (m i)))
    (hEpi : ∀ (T : Type) [CommRing T] [Algebra K T] [Module.Finite K T] [Algebra.Etale K T]
      (g h : (∀ i, Ai i) →ₐ[K] T), g.comp psi = h.comp psi → g = h)
    (i : I) : Function.Surjective (σ i) := by
  classical
    letI : Algebra (Bj (m i)) (Ai i) := (σ i).toRingHom.toAlgebra
    haveI hTow : IsScalarTower K (Bj (m i)) (Ai i) :=
      IsScalarTower.of_algebraMap_eq (R := K) (S := Bj (m i)) (A := Ai i)
        (fun k => ((σ i).commutes k).symm)
    haveI hFinB : Module.Finite (Bj (m i)) (Ai i) :=
      Module.Finite.of_restrictScalars_finite (R := K) (A := Bj (m i)) (M := Ai i)
    haveI hSepB : Algebra.IsSeparable (Bj (m i)) (Ai i) :=
      Algebra.isSeparable_tower_top_of_isSeparable (F := K) (L := Bj (m i)) (E := Ai i)
    haveI hEtB : Algebra.Etale (Bj (m i)) (Ai i) := etale_of_finite_separable (Bj (m i)) (Ai i)
    haveI hEtAi : Algebra.Etale K (Ai i) := etale_of_finite_separable K (Ai i)
    haveI hSM : SMulCommClass (Bj (m i)) K (Ai i) := IsScalarTower.to_smulCommClass'
    haveI hTowT : IsScalarTower K (Bj (m i)) (Ai i ⊗[Bj (m i)] Ai i) :=
      IsScalarTower.of_algebraMap_eq (R := K) (S := Bj (m i))
        (A := Ai i ⊗[Bj (m i)] Ai i) (fun k => by
          simp only [Algebra.TensorProduct.algebraMap_def, RingHom.comp_apply,
            IsScalarTower.algebraMap_apply K (Bj (m i)) (Ai i)])
    haveI hFinT : Module.Finite K (Ai i ⊗[Bj (m i)] Ai i) := by
      haveI : Module.Finite (Bj (m i)) (Ai i ⊗[Bj (m i)] Ai i) :=
        Module.Finite.tensorProduct (Bj (m i)) (Ai i) (Ai i)
      exact Module.Finite.trans (R := K) (Bj (m i)) (Ai i ⊗[Bj (m i)] Ai i)
    haveI hTowAT : IsScalarTower K (Ai i) (Ai i ⊗[Bj (m i)] Ai i) :=
      IsScalarTower.of_algebraMap_eq (R := K) (S := Ai i)
        (A := Ai i ⊗[Bj (m i)] Ai i) (fun k => by
          simp only [Algebra.TensorProduct.algebraMap_def, RingHom.comp_apply,
            Algebra.algebraMap_self, RingHom.id_apply])
    haveI hEtT : Algebra.Etale K (Ai i ⊗[Bj (m i)] Ai i) := by
      haveI : Algebra.Etale (Ai i) (Ai i ⊗[Bj (m i)] Ai i) :=
      Algebra.Etale.baseChange (R := Bj (m i)) (A := Ai i) (B := Ai i)
      exact Algebra.Etale.comp K (Ai i) (Ai i ⊗[Bj (m i)] Ai i)
    let g : (∀ i, Ai i) →ₐ[K] (Ai i ⊗[Bj (m i)] Ai i) :=
      (Algebra.TensorProduct.includeLeft (R := Bj (m i)) (S := K) (A := Ai i) (B := Ai i)).comp
        (Pi.evalAlgHom K Ai i)
    let h : (∀ i, Ai i) →ₐ[K] (Ai i ⊗[Bj (m i)] Ai i) :=
      ((Algebra.TensorProduct.includeRight (R := Bj (m i)) (A := Ai i) (B := Ai i)).restrictScalars
        K).comp (Pi.evalAlgHom K Ai i)
    have hgh : g.comp psi = h.comp psi := by
      ext x
      show (Algebra.TensorProduct.includeLeft (R := Bj (m i)) (S := K) (A := Ai i) (B := Ai i))
            ((psi x) i) =
          (AlgHom.restrictScalars K
            (Algebra.TensorProduct.includeRight (R := Bj (m i)) (A := Ai i) (B := Ai i)))
            ((psi x) i)
      rw [hpsi i x]
      show (algebraMap (Bj (m i)) (Ai i) (x (m i))) ⊗ₜ[Bj (m i)] (1 : Ai i) =
        (1 : Ai i) ⊗ₜ[Bj (m i)] (algebraMap (Bj (m i)) (Ai i) (x (m i)))
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul (x (m i))
    have hgeq : g = h := hEpi (T := Ai i ⊗[Bj (m i)] Ai i) g h hgh
    have hcomm : ∀ a : Ai i, a ⊗ₜ[Bj (m i)] (1 : Ai i) = (1 : Ai i) ⊗ₜ[Bj (m i)] a := by
      intro a
      have h1 := congr_fun (congrArg
        (fun f : (∀ i, Ai i) →ₐ[K] (Ai i ⊗[Bj (m i)] Ai i) =>
          (f : (∀ i, Ai i) → (Ai i ⊗[Bj (m i)] Ai i))) hgeq) (Pi.single i a)
      simpa [g, h] using h1
    exact surjective_algebraMap_of_tmul_comm (K := K) (Bm := Bj (m i)) (Ai := Ai i) hcomm

set_option maxHeartbeats 1600000 in
theorem epiSurjective (K : Type) [Field K] : S1747.EpiSurjective K := by
  intro A B hAR hAA hAF hAE hBR hBA hBF hBE φ hφ
  classical
  obtain ⟨I, hI, Ai, hAiField, hAiAlg, eA, hAiFinSep⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod (K := K) (A := A)).mp hAE
  obtain ⟨J, hJ, Bj, hBjField, hBjAlg, eB, hBjFinSep⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod (K := K) (A := B)).mp hBE
  letI : Finite I := hI
  letI : Finite J := hJ
  letI : Fintype I := Fintype.ofFinite I
  letI : Fintype J := Fintype.ofFinite J
  letI : ∀ i, Field (Ai i) := hAiField
  letI : ∀ j, Field (Bj j) := hBjField
  letI : ∀ i, Algebra K (Ai i) := hAiAlg
  letI : ∀ j, Algebra K (Bj j) := hBjAlg
  haveI : ∀ i, Module.Finite K (Ai i) := fun i => (hAiFinSep i).1
  haveI : ∀ j, Module.Finite K (Bj j) := fun j => (hBjFinSep j).1
  haveI : ∀ i, Algebra.IsSeparable K (Ai i) := fun i => (hAiFinSep i).2
  haveI : ∀ j, Algebra.IsSeparable K (Bj j) := fun j => (hBjFinSep j).2
  haveI : ∀ i, Algebra.Etale K (Ai i) := fun i => etale_of_finite_separable K (Ai i)
  haveI : ∀ j, Algebra.Etale K (Bj j) := fun j => etale_of_finite_separable K (Bj j)
  -- the induced map between products
  let psi : (∀ j, Bj j) →ₐ[K] (∀ i, Ai i) := eA.toAlgHom.comp (φ.comp eB.symm.toAlgHom)
  -- each component factors through a unique projection
  choose m σ hσ using fun i => S1747.exists_factor (K := K) (J := J) Bj (L := Ai i)
    ((Pi.evalAlgHom K Ai i).comp psi)
  have hpsi_apply : ∀ (i : I) (x : ∀ j, Bj j), psi x i = σ i (x (m i)) := by
    intro i x
    have h := congr_fun (congrArg
      (fun f : (∀ j, Bj j) →ₐ[K] Ai i => (f : (∀ j, Bj j) → Ai i)) (hσ i)) x
    simpa using h
  have hpsie : psi.comp eB.toAlgHom = eA.toAlgHom.comp φ := by
    ext b
    simp [psi]
  -- the epimorphism property transported to the product
  have hpsi_epi : ∀ (T : Type) [CommRing T] [Algebra K T] [Module.Finite K T] [Algebra.Etale K T]
      (g h : (∀ i, Ai i) →ₐ[K] T), g.comp psi = h.comp psi → g = h := by
    intro T hTR hTA hTF hTE g h hgh
    have hgh' : (g.comp eA.toAlgHom).comp φ = (h.comp eA.toAlgHom).comp φ := by
      calc (g.comp eA.toAlgHom).comp φ = g.comp (eA.toAlgHom.comp φ) := AlgHom.comp_assoc _ _ _
        _ = g.comp (psi.comp eB.toAlgHom) := by rw [hpsie]
        _ = (g.comp psi).comp eB.toAlgHom := (AlgHom.comp_assoc _ _ _).symm
        _ = (h.comp psi).comp eB.toAlgHom := by rw [hgh]
        _ = h.comp (psi.comp eB.toAlgHom) := AlgHom.comp_assoc _ _ _
        _ = h.comp (eA.toAlgHom.comp φ) := by rw [hpsie]
        _ = (h.comp eA.toAlgHom).comp φ := (AlgHom.comp_assoc _ _ _).symm
    have hgeq : g.comp eA.toAlgHom = h.comp eA.toAlgHom :=
      hφ T (g.comp eA.toAlgHom) (h.comp eA.toAlgHom) hgh'
    ext x
    obtain ⟨y, rfl⟩ := eA.surjective x
    exact congr_fun (congrArg (fun f : A →ₐ[K] T => (f : A → T)) hgeq) y
  have hσ_inj : ∀ i, Function.Injective (σ i) := fun i => injective_of_field (σ i)
  -- every field component map is surjective, by the tensor-product test
  have hσ_surj : ∀ i, Function.Surjective (σ i) := fun i =>
    sigma_surjective_of_epi Ai Bj m σ psi hpsi_apply hpsi_epi i
  -- injectivity of the index map, by an endomorphism test on the product
  have hm_inj : Function.Injective m := by
    intro i1 i2 hi
    by_contra hne
    let e1 : Bj (m i1) ≃ₐ[K] Ai i1 := AlgEquiv.ofBijective (σ i1) ⟨hσ_inj i1, hσ_surj i1⟩
    let e2 : Bj (m i2) ≃ₐ[K] Ai i2 := AlgEquiv.ofBijective (σ i2) ⟨hσ_inj i2, hσ_surj i2⟩
    let castAlg : Bj (m i1) ≃ₐ[K] Bj (m i2) := algEquivCast (K := K) Bj hi
    let τ : Ai i2 →ₐ[K] Ai i1 :=
      e1.toAlgHom.comp (castAlg.symm.toAlgHom.comp e2.symm.toAlgHom)
    let c : ∀ k, (∀ k, Ai k) →ₐ[K] Ai k := fun k =>
      if hk : k = i1 then hk.symm ▸ (τ.comp (Pi.evalAlgHom K Ai i2)) else Pi.evalAlgHom K Ai k
    let H : (∀ k, Ai k) →ₐ[K] (∀ k, Ai k) := AlgHom.pi c
    have hHpsi : H.comp psi = psi := by
      ext b k
      by_cases hk : k = i1
      · rw [hk]
        change (H (psi b)) i1 = psi b i1
        have h1 : (H (psi b)) i1 = τ (psi b i2) := by simp [H, c]
        rw [h1, hpsi_apply i2 b, hpsi_apply i1 b]
        have h2 : τ (σ i2 (b (m i2))) = e1 (castAlg.symm (b (m i2))) := by
          simp [τ, e2, AlgEquiv.ofBijective_apply]
        rw [h2]
        have h3 : castAlg.symm (b (m i2)) = b (m i1) := by
          rw [← algEquivCast_apply_section (K := K) Bj hi b]
          simp [castAlg]
        rw [h3]
        rfl
      · simp [H, c, hk]
    have hHne : H ≠ AlgHom.id K (∀ k, Ai k) := by
      intro hH
      have h1 : H (Pi.single i2 (1 : Ai i2)) = Pi.single i2 (1 : Ai i2) := by
        rw [hH]
        rfl
      have h2 := congr_fun h1 i1
      simp [H, c, Pi.single_eq_same, Pi.single_eq_of_ne hne] at h2
    have hid : H = AlgHom.id K (∀ k, Ai k) :=
      (hpsi_epi (T := ∀ k, Ai k) (AlgHom.id K (∀ k, Ai k)) H
        (by rw [AlgHom.id_comp]; exact hHpsi.symm)).symm
    exact hHne hid
  -- surjectivity of φ
  intro a
  let e : ∀ i, Bj (m i) ≃ₐ[K] Ai i := fun i => AlgEquiv.ofBijective (σ i) ⟨hσ_inj i, hσ_surj i⟩
  let y : ∀ i, Bj (m i) := fun i => (e i).symm ((eA a) i)
  let x : ∀ j, Bj j := ∑ i, Pi.single (m i) (y i)
  have hx : ∀ i, x (m i) = y i := by
    intro i
    show (∑ i', Pi.single (m i') (y i')) (m i) = y i
    rw [Finset.sum_apply, Finset.sum_eq_single i]
    · simp
    · intro i' _ hi'
      have hne' : m i ≠ m i' := fun h => hi' (hm_inj h).symm
      rw [Pi.single_eq_of_ne hne']
    · intro hi
      exact absurd (Finset.mem_univ i) hi
  have hpsix : psi x = eA a := by
    ext i
    rw [hpsi_apply i x, hx i]
    exact (e i).apply_symm_apply ((eA a) i)
  refine ⟨eB.symm x, ?_⟩
  have h1 : eA (φ (eB.symm x)) = eA a := by
    rw [show eA (φ (eB.symm x)) = psi x from rfl, hpsix]
  exact eA.injective h1

/-! ### A surjective map of finite etale algebras splits off a direct factor -/

/-- Chinese remainder theorem for a complete pair of ideals, as an algebra equivalence. -/
noncomputable def algEquivProdQuotientOfIsCompl {K B : Type} [Field K] [CommRing B] [Algebra K B]
    (I J : Ideal B) (h : IsCompl I J) : B ≃ₐ[K] ((B ⧸ I) × (B ⧸ J)) := by
  have hcop : IsCoprime I J := Ideal.isCoprime_iff_sup_eq.mpr h.sup_eq_top
  let φ : B →ₐ[K] ((B ⧸ I) × (B ⧸ J)) :=
    AlgHom.prod (Ideal.Quotient.mkₐ K I) (Ideal.Quotient.mkₐ K J)
  have hcomp : (fun b : B => φ b) =
      fun b => (Ideal.quotientInfEquivQuotientProd I J hcop)
        (Ideal.Quotient.mk (I ⊓ J) b) := by
    funext b
    ext
    · simp [φ, Ideal.quotientInfEquivQuotientProd_fst]
    · simp [φ, Ideal.quotientInfEquivQuotientProd_snd]
  have hmk : Function.Bijective (fun b : B => Ideal.Quotient.mk (I ⊓ J) b) := by
    rw [h.inf_eq_bot]
    convert (AlgEquiv.quotientBot K B).symm.bijective using 1
    ext b
    simp
  have hbij : Function.Bijective φ := by
    change Function.Bijective (fun b => φ b)
    rw [hcomp]
    exact (Ideal.quotientInfEquivQuotientProd I J hcop).bijective.comp hmk
  exact AlgEquiv.ofBijective φ hbij

@[simp]
lemma algEquivProdQuotientOfIsCompl_apply {K B : Type} [Field K] [CommRing B] [Algebra K B]
    (I J : Ideal B) (h : IsCompl I J) (b : B) :
    algEquivProdQuotientOfIsCompl (K := K) I J h b =
      (Ideal.Quotient.mk I b, Ideal.Quotient.mk J b) := rfl

/-- Every surjective map of finite etale K-algebras is the first projection of a product. -/
theorem exists_prod_algEquiv_of_surjective {K : Type} [Field K]
    (A B : Type) [CommRing A] [Algebra K A] [Module.Finite K A] [Algebra.Etale K A]
    [CommRing B] [Algebra K B] [Module.Finite K B] [Algebra.Etale K B]
    (f : B →ₐ[K] A) (hf : Function.Surjective f) :
    ∃ (C : Type) (_ : CommRing C) (_ : Algebra K C) (_ : Module.Finite K C)
      (_ : Algebra.Etale K C), ∃ e : B ≃ₐ[K] (A × C), f = (AlgHom.fst K A C).comp e.toAlgHom := by
  haveI : IsReduced B := Algebra.FormallyUnramified.isReduced_of_field K B
  haveI : IsArtinianRing B := IsArtinianRing.of_finite K B
  haveI : IsSemisimpleRing B := IsArtinianRing.isSemisimpleRing_of_isReduced B
  let I : Ideal B := RingHom.ker f
  obtain ⟨J, hJ⟩ := ComplementedLattice.exists_isCompl I
  obtain ⟨eJ, heJ, hJe⟩ := IsSemisimpleRing.ideal_eq_span_idempotent J
  have hJidem : IsIdempotentElem J := by
    rw [hJe]
    simp [IsIdempotentElem, Ideal.span_singleton_mul_span_singleton, heJ.eq]
  haveI hFE : Algebra.FormallyEtale B (B ⧸ J) := by
    refine (Algebra.FormallyEtale.iff_of_surjective (R := B) (S := B ⧸ J) ?_).mpr ?_
    · simpa [Ideal.Quotient.algebraMap_eq] using Ideal.Quotient.mk_surjective (I := J)
    · have hker : RingHom.ker (algebraMap B (B ⧸ J)) = J := by
        simpa [Ideal.Quotient.algebraMap_eq] using Ideal.mk_ker (I := J)
      rwa [hker]
  haveI hFEK : Algebra.FormallyEtale K (B ⧸ J) := Algebra.FormallyEtale.comp K B (B ⧸ J)
  haveI hFinC : Module.Finite K (B ⧸ J) := Module.Finite.quotient K J
  have hEtC : Algebra.Etale K (B ⧸ J) := by
    refine ⟨hFEK, ?_⟩
    exact (Algebra.FinitePresentation.of_finiteType (R := K)).mp inferInstance
  let crt : B ≃ₐ[K] ((B ⧸ I) × (B ⧸ J)) :=
    algEquivProdQuotientOfIsCompl (K := K) I J hJ
  let q : (B ⧸ I) ≃ₐ[K] A := Ideal.quotientKerAlgEquivOfSurjective hf
  let ee : B ≃ₐ[K] (A × (B ⧸ J)) :=
    crt.trans (AlgEquiv.prodCongr q (AlgEquiv.refl : (B ⧸ J) ≃ₐ[K] (B ⧸ J)))
  refine ⟨B ⧸ J, inferInstance, inferInstance, hFinC, hEtC, ee, ?_⟩
  have crt_apply : ∀ b : B, crt b = (Ideal.Quotient.mk I b, Ideal.Quotient.mk J b) :=
    algEquivProdQuotientOfIsCompl_apply (K := K) I J hJ
  have ee_apply : ∀ b : B, ee b = (f b, Ideal.Quotient.mk J b) := by
    intro b
    change (AlgEquiv.prodCongr q (AlgEquiv.refl : (B ⧸ J) ≃ₐ[K] (B ⧸ J))) (crt b) = _
    rw [crt_apply]
    simp only [AlgEquiv.prodCongr_apply, Equiv.prodCongr_apply, Prod.map_apply]
    have hq : q (Ideal.Quotient.mk I b) = f b :=
      Ideal.quotientKerAlgEquivOfSurjective_mk hf b
    exact Prod.ext hq rfl
  ext b
  change f b = (ee b).1
  rw [ee_apply]

/-- A surjective map of finite etale K-algebras splits as a first projection. -/
theorem surjectiveSplit (K : Type) [Field K] : S1747.SurjectiveSplit K := by
  intro A B hAR hAA hAF hAE hBR hBA hBF hBE φ hφ
  obtain ⟨C, hCR, hCA, hCF, hCE, e, he⟩ :=
    exists_prod_algEquiv_of_surjective (K := K) A B φ hφ
  exact ⟨C, hCR, hCA, hCF, hCE, e, he.symm⟩

end S1785


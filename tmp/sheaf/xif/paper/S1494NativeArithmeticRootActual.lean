import tmp.sheaf.n8.closure.NativeInput
import LeanFormal.IUT.IUTI.HodgeTheater.SourceHodgeTheaterFamilySourceReduction
import LeanFormal.IUT.IUTI.HodgeTheater.SourceDefinition31A2GateReduction
import LeanFormal.IUT.IUTI.HodgeTheater.SourceDefinition31SignQuotientSupplyReduction
import LeanFormal.IUT.IUTI.HodgeTheater.SourceClauseAssemblyUnitsReduction

/-!
# S1494: the arithmetic-root field of the paper line-bundle donor

S1480 builds the actual q-pilot O(-D) fractional-ideal carrier of the paper
lineBundle slot, conditional on

  D : OrigXiFPaperLineBundleData I,

whose only field is a native donor X : N8NativeInput l together with the
exact arithmetic-root equality

  D.arithmetic_root_eq : X.S.arithmetic = I.initial.arithmetic.

This file separates the two questions which S1480 leaves open.

## 1. What is actually constructed

For a paper origin input over universe 0,

  I : OriginalInput.{0,0,0,0,0} l V,

a native source T : SourceNativeInitialThetaData.{0} l whose arithmetic root
is the paper arithmetic root, and an identification e : V ≃ NativePlaces T
of the paper prime-strip index type with the native selected places, we build
an actual N8NativeInput

  paperNativeDonor I T e hT : N8NativeInput l

and an actual

  origXiFPaperLineBundleDataOfPaperNativeRoot I T e hT :
     OrigXiFPaperLineBundleData I.

The lattice of the donor is not a junk/trivial prime strip.  It is the
one-point sub-lattice generated by the paper theater I.theaterAt 0 0: its
theta packet is the paper theta packet and its prime strip is the paper prime
strip at the origin, reindexed along e to the native selected places.  When
the paper input is already indexed by NativePlaces T, the identification e
is Equiv.refl and the construction is unconditional in e
(origXiFPaperLineBundleDataOfNativePlaces).

No trivial prime strip, no arbitrary N8NativeInput, no True/False gate,
no axiom and no sorry is used.  PUnit occurs only as the index type of the
one-point packaging of the paper origin theater; the prime strip itself is
the paper prime strip.  The q-pilot O(-D) construction of S1480 consumes only
X.S.arithmetic and the native bad-place set, not the lattice, so this actual
sub-lattice is sufficient for that consumer.  The only datum which is not
extracted from the paper input is the native source T; that is precisely the
first field isolated below.

## 2. The exact first field and its reduction

The exact first field is recorded as

  OrigXiFPaperNativeRoot I :=
     { T : SourceNativeInitialThetaData.{0} l // T.arithmetic = I.initial.arithmetic }.

The donor package is equivalent to this root together with an actual native
lattice:

  Nonempty (OrigXiFPaperLineBundleData I) ↔
     ∃ T : OrigXiFPaperNativeRoot I, Nonempty (NativeLattice T.1).

The root itself is reduced, pointwise over the paper arithmetic root, to the
A2 clause-assembly gate:

  Nonempty { T // T.arithmetic = A } ↔
     ∃ SQ : SourceSignQuotientData A,
       Nonempty (SourceClauseAssembly A SQ),

and SourceSignQuotientData A is equivalent to the geometric core
SourceSignQuotientGeometricCore A because the place-selection half is
unconditional.  The first geometric field of the latter is
G.xF : Iut.HyperbolicOrbicurve A.F.

Consequently the exact obstruction of S1480 is not the line bundle: it is the
A2 arithmetic-to-source totalization at the one paper root
I.initial.arithmetic, equivalently its geometric core and clause assembly.
No construction of that totalization from SourceDefinition31Data alone is
present in the tree; the contract-to-native bridge is recorded in
SourceDefinition31NativeContractBridgeReduction as equivalent to pointwise
A2 totalization.  This file does not assert an inhabitant of the missing root;
it constructs the donor once that root is supplied and records the exact
first field which remains.

## 3. What is proved about failure

If the paper arithmetic root has no sign-quotient datum, or no geometric core,
then the donor package is empty:

  IsEmpty (SourceSignQuotientData I.initial.arithmetic) →
     IsEmpty (OrigXiFPaperLineBundleData I),

  IsEmpty (SourceSignQuotientGeometricCore I.initial.arithmetic) →
     IsEmpty (OrigXiFPaperLineBundleData I).

These are conditional no-go statements: the premise is exactly the open A2
card, not a new hypothesis hidden in the donor.
-/

noncomputable section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option maxHeartbeats 4000000

namespace LeanFormal.IUT

/-! ## 0. Reindexing a prime strip along an equivalence -/

namespace FPrimeStrip

/-- Reindex an FPrimeStrip along an equivalence of its place-index types.
All local groups, value monoids, actions and degrees are transported
definitionally; no group or value is chosen. -/
def reindexAlong {V W : Type} (e : V ≃ W) (F : FPrimeStrip V) :
    FPrimeStrip W where
  Pi w := F.Pi (e.symm w)
  groupPi w := F.groupPi (e.symm w)
  G w := F.G (e.symm w)
  groupG w := F.groupG (e.symm w)
  proj w := F.proj (e.symm w)
  proj_surjective w := F.proj_surjective (e.symm w)
  Mon w := F.Mon (e.symm w)
  commMonoidMon w := F.commMonoidMon (e.symm w)
  action w := F.action (e.symm w)
  degree w := F.degree (e.symm w)

@[simp] theorem reindexAlong_Pi {V W : Type} (e : V ≃ W)
    (F : FPrimeStrip V) (w : W) :
    (F.reindexAlong e).Pi w = F.Pi (e.symm w) := rfl

@[simp] theorem reindexAlong_G {V W : Type} (e : V ≃ W)
    (F : FPrimeStrip V) (w : W) :
    (F.reindexAlong e).G w = F.G (e.symm w) := rfl

@[simp] theorem reindexAlong_Mon {V W : Type} (e : V ≃ W)
    (F : FPrimeStrip V) (w : W) :
    (F.reindexAlong e).Mon w = F.Mon (e.symm w) := rfl

end FPrimeStrip

end LeanFormal.IUT

namespace LeanFormal.IUT.XiFPaper.S1494NativeArithmeticRootActual

open LeanFormal.IUT
open LeanFormal.IUT.InitialThetaSource
open LeanFormal.IUT.N8Closure.NativeInput
open LeanFormal.IUT.Theorem311Source
open LeanFormal.IUT.XiFPaper.OrigXiFPaperLineBundle

variable {l : PrimeGeFive}
variable {V : Type}

/-! ## 1. The paper origin theater, reindexed to the native places -/

/-- The paper theta packet at the origin theater (0,0). -/
def paperThetaPacket (I : OriginalInput.{0, 0, 0, 0, 0} l V) :
    FiniteThetaPacket l :=
  (I.theaterAt 0 0).thetaPacket

/-- The paper prime strip at the origin theater, reindexed along an
identification of the paper place index with the native selected places. -/
def paperPrimeStrip (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T) : FPrimeStrip (NativePlaces T) :=
  (I.theaterAt 0 0).primeStrip.reindexAlong e

/-- The one-point prime-strip family generated by the paper origin strip. -/
def paperPrimeStripFamily (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T) : PUnit → FPrimeStrip (NativePlaces T) :=
  fun _ => paperPrimeStrip I T e

theorem paperPrimeStripFamily_injective
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T) :
    Function.Injective (paperPrimeStripFamily I T e) := by
  intro a b _
  cases a
  cases b
  rfl

/-- The reflexivity link system on the one-point prime-strip family. -/
def paperPrimeStripLinkSystem (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T) :
    FPrimeStripLinkSystem (paperPrimeStripFamily I T e) where
  equiv i j := by
    cases i
    cases j
    exact FPrimeStripEquiv.refl (paperPrimeStripFamily I T e PUnit.unit)
  equiv_refl i := by
    cases i
    rfl
  equiv_symm i j := by
    cases i
    cases j
    rfl
  equiv_trans i j k := by
    cases i
    cases j
    cases k
    rfl

/-- The actual native lattice of the donor: the paper origin theater's prime
strip and theta packet, reindexed to the native selected places and packaged
as a one-point source family with arithmetic T.arithmetic. -/
def paperNativeLattice (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T) : NativeLattice T where
  family := stripSpineFamily T.arithmetic (paperThetaPacket I)
    (paperPrimeStripFamily I T e)
    (paperPrimeStripFamily_injective I T e)
    (paperPrimeStripLinkSystem I T e)
  arithmetic_alignment := by
    intro i
    exact stripSpineFamily_arithmetic_alignment T.arithmetic
      (paperThetaPacket I) (paperPrimeStripFamily I T e)
      (paperPrimeStripFamily_injective I T e)
      (paperPrimeStripLinkSystem I T e) i

/-- The actual native donor constructed from the paper input, the native
arithmetic root T, and the paper/native place identification e. -/
def paperNativeDonor (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T)
    (hT : T.arithmetic = I.initial.arithmetic) : N8NativeInput l where
  S := T
  lattice := paperNativeLattice I T e

@[simp] theorem paperNativeDonor_S (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T)
    (hT : T.arithmetic = I.initial.arithmetic) :
    (paperNativeDonor I T e hT).S = T := rfl

/-- The arithmetic-root equality of the constructed donor is exactly the
supplied native/paper root equality. -/
theorem paperNativeDonor_arithmetic_root (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T)
    (hT : T.arithmetic = I.initial.arithmetic) :
    (paperNativeDonor I T e hT).S.arithmetic = I.initial.arithmetic :=
  hT

/-- The exact first field of S1480, constructed from a native arithmetic-root
totalization and the paper/native place identification. -/
def origXiFPaperLineBundleDataOfPaperNativeRoot
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T)
    (hT : T.arithmetic = I.initial.arithmetic) :
    OrigXiFPaperLineBundleData I where
  X := paperNativeDonor I T e hT
  arithmetic_root_eq := paperNativeDonor_arithmetic_root I T e hT

@[simp] theorem origXiFPaperLineBundleDataOfPaperNativeRoot_X
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T)
    (hT : T.arithmetic = I.initial.arithmetic) :
    (origXiFPaperLineBundleDataOfPaperNativeRoot I T e hT).X =
      paperNativeDonor I T e hT := rfl

/-! ## 2. Paper inputs already indexed by the native places -/

/-- When the paper input is already indexed by NativePlaces T, the place
identification is Equiv.refl; the lattice is then built directly from the
paper origin theater with no extra reindexing choice. -/
def paperNativeLatticeSelf
    (T : SourceNativeInitialThetaData.{0} l)
    (I : OriginalInput.{0, 0, 0, 0, 0} l (NativePlaces T)) : NativeLattice T :=
  paperNativeLattice I T (Equiv.refl (NativePlaces T))

/-- The actual donor for a paper input indexed by NativePlaces T. -/
def origXiFPaperLineBundleDataOfNativePlaces
    (T : SourceNativeInitialThetaData.{0} l)
    (I : OriginalInput.{0, 0, 0, 0, 0} l (NativePlaces T))
    (hT : T.arithmetic = I.initial.arithmetic) :
    OrigXiFPaperLineBundleData I :=
  origXiFPaperLineBundleDataOfPaperNativeRoot I T (Equiv.refl (NativePlaces T)) hT

/-! ## 3. The exact first field: the native arithmetic-root totalization -/

/-- The exact first field of the native donor: a native source datum whose
arithmetic root is the paper arithmetic root. -/
abbrev OrigXiFPaperNativeRoot
    (I : OriginalInput.{0, 0, 0, 0, 0} l V) : Type 1 :=
  { T : SourceNativeInitialThetaData.{0} l // T.arithmetic = I.initial.arithmetic }

/-- The A2 arithmetic-to-source gate closes the exact first field at the paper
root.  The gate itself is the named open card; this theorem only records that
it is exactly sufficient for the field S1480 needs. -/
theorem paperNativeRoot_nonempty_of_a2Gate
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (hG : SourceNativeArithmeticToSourceGate.{0} l) :
    Nonempty (OrigXiFPaperNativeRoot I) := by
  rcases hG I.initial.arithmetic with ⟨T, hT⟩
  exact ⟨⟨T, hT⟩⟩

/-- The exact first field remains a native source root; the donor package is
equivalent to that root together with an actual native lattice.  This is the
literal content of OrigXiFPaperLineBundleData. -/
theorem origXiFPaperLineBundleData_nonempty_iff_nativeRoot_lattice
    (I : OriginalInput.{0, 0, 0, 0, 0} l V) :
    Nonempty (OrigXiFPaperLineBundleData I) ↔
      ∃ T : OrigXiFPaperNativeRoot I, Nonempty (NativeLattice T.1) := by
  constructor
  · rintro ⟨D⟩
    exact ⟨⟨D.X.S, D.arithmetic_root_eq⟩, ⟨D.X.lattice⟩⟩
  · rintro ⟨⟨T, hT⟩, ⟨L⟩⟩
    exact ⟨{ X := { S := T, lattice := L },
             arithmetic_root_eq := hT }⟩

/-- The first field supplied by a native source root: an actual native donor
with the exact arithmetic-root equality. -/
theorem origXiFPaperLineBundleData_nonempty_of_nativeRoot_of_lattice
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : OrigXiFPaperNativeRoot I) (L : NativeLattice T.1) :
    Nonempty (OrigXiFPaperLineBundleData I) :=
  ⟨{ X := { S := T.1, lattice := L },
      arithmetic_root_eq := T.2 }⟩

/-- The exact first field is equivalent to a clause-construction witness over
the paper arithmetic root. -/
theorem paperNativeRoot_nonempty_iff_clauseWitness
    (A : InitialThetaArithmeticData.{0} l) :
    Nonempty { T : SourceNativeInitialThetaData.{0} l // T.arithmetic = A } ↔
      ∃ W : SourceClauseConstructionWitness.{0} l, W.arithmetic = A := by
  constructor
  · rintro ⟨T, hT⟩
    exact ⟨witnessOfNativeData T, hT⟩
  · rintro ⟨W, hW⟩
    exact ⟨W.sourceData, hW⟩

/-- The exact first field is equivalent to a sign-quotient datum together with
the clause assembly over it.  This is the pointwise A2 gate at the paper root. -/
theorem paperNativeRoot_nonempty_iff_clauseAssembly
    (A : InitialThetaArithmeticData.{0} l) :
    Nonempty { T : SourceNativeInitialThetaData.{0} l // T.arithmetic = A } ↔
      ∃ SQ : SourceSignQuotientData A,
        Nonempty (SourceClauseAssembly A SQ) := by
  constructor
  · rintro ⟨T, hT⟩
    cases hT
    exact ⟨T.tuple.source,
      ⟨{ clauseA := T.clauseA,
          clauseB := T.clauseB,
          clauseC := T.clauseC,
          clauseD := T.clauseD,
          clauseE := T.clauseE,
          clauseF := T.clauseF }⟩⟩
  · rintro ⟨SQ, ⟨assembly⟩⟩
    exact ⟨(witnessOfClauseAssembly A SQ assembly).sourceData, rfl⟩

/-- The exact first field of S1480, restated directly at the paper input: a
native source root exists exactly when a sign-quotient datum and a clause
assembly exist over the paper arithmetic root. -/
theorem paperNativeRoot_exact_first_field
    (I : OriginalInput.{0, 0, 0, 0, 0} l V) :
    Nonempty (OrigXiFPaperNativeRoot I) ↔
      ∃ SQ : SourceSignQuotientData I.initial.arithmetic,
        Nonempty (SourceClauseAssembly I.initial.arithmetic SQ) :=
  paperNativeRoot_nonempty_iff_clauseAssembly I.initial.arithmetic

/-- The sign-quotient half of the native root is exactly its geometric core:
the selected-place half is unconditional. -/
theorem sourceSignQuotientData_nonempty_iff_geometricCore
    (A : InitialThetaArithmeticData.{0} l) :
    Nonempty (SourceSignQuotientData A) ↔
      Nonempty (SourceSignQuotientGeometricCore A) := by
  constructor
  · intro h
    exact (nonempty_sourceSignQuotientData_iff_core_and_selection A).mp h |>.1
  · intro h
    exact (nonempty_sourceSignQuotientData_iff_core_and_selection A).mpr
      ⟨h, sourcePlaceSelectionNonempty A⟩

/-- The geometric core's first field, explicitly. -/
theorem geometricCore_firstField
    (A : InitialThetaArithmeticData.{0} l)
    (G : SourceSignQuotientGeometricCore A) :
    Nonempty (Iut.HyperbolicOrbicurve A.F) :=
  ⟨G.xF⟩

/-! ## 4. Exact failure statements -/

/-- If the paper arithmetic root has no sign-quotient datum, then no native
donor for S1480 exists. -/
theorem isEmpty_origXiFPaperLineBundleData_of_isEmpty_signQuotient
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (h : IsEmpty (SourceSignQuotientData I.initial.arithmetic)) :
    IsEmpty (OrigXiFPaperLineBundleData I) := by
  refine ⟨fun D => ?_⟩
  have hroot : D.X.S.arithmetic = I.initial.arithmetic := D.arithmetic_root_eq
  exact h.false (hroot ▸ D.X.S.tuple.source)

/-- If the paper arithmetic root has no geometric core, then no native donor
for S1480 exists.  This is the exact A2 obstruction at the paper root, not a
new assumption on the line bundle. -/
theorem isEmpty_origXiFPaperLineBundleData_of_isEmpty_geometricCore
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (h : IsEmpty (SourceSignQuotientGeometricCore I.initial.arithmetic)) :
    IsEmpty (OrigXiFPaperLineBundleData I) := by
  refine isEmpty_origXiFPaperLineBundleData_of_isEmpty_signQuotient I ?_
  refine ⟨fun SQ => h.false ?_⟩
  exact geometricCoreOfSignQuotientData SQ

/-- A donor can be constructed whenever the paper input comes with a native
source root and the paper/native place identification.  This theorem is the
constructive content of the file; its only non-paper datum is the root T. -/
theorem origXiFPaperLineBundleData_nonempty_of_nativeRoot
    (I : OriginalInput.{0, 0, 0, 0, 0} l V)
    (T : SourceNativeInitialThetaData.{0} l)
    (e : V ≃ NativePlaces T)
    (hT : T.arithmetic = I.initial.arithmetic) :
    Nonempty (OrigXiFPaperLineBundleData I) :=
  ⟨origXiFPaperLineBundleDataOfPaperNativeRoot I T e hT⟩

end LeanFormal.IUT.XiFPaper.S1494NativeArithmeticRootActual


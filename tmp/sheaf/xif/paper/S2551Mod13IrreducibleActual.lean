/-! ## Coefficientwise Frobenius helpers over ZMod 13 -/

lemma zmod13_pow_thirteen (x : ZMod 13) : x ^ 13 = x := by
  fin_cases x <;> decide

def frobSum {n : ℕ} (c : Fin n → (ZMod 13)) : (ZMod 13)[X] :=
  ∑ i : Fin n, C (c i) * X ^ (i : ℕ)

def frobSum13 {n : ℕ} (c : Fin n → (ZMod 13)) : (ZMod 13)[X] :=
  ∑ i : Fin n, C (c i) * X ^ (13 * (i : ℕ))

def frobSumZ {n : ℕ} (c : Fin n → ℤ) : ℤ[X] :=
  ∑ i : Fin n, (c i : ℤ[X]) * X ^ (i : ℕ)

def frobSum13Z {n : ℕ} (c : Fin n → ℤ) : ℤ[X] :=
  ∑ i : Fin n, (c i : ℤ[X]) * X ^ (13 * (i : ℕ))

lemma map_frobSum {n : ℕ} (c : Fin n → ℤ) :
    (frobSumZ c).map (Int.castRingHom (ZMod 13)) = frobSum (fun i => (c i : ZMod 13)) := by
  simp [frobSumZ, frobSum, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_pow]

lemma map_frobSum13 {n : ℕ} (c : Fin n → ℤ) :
    (frobSum13Z c).map (Int.castRingHom (ZMod 13)) =
      frobSum13 (fun i => (c i : ZMod 13)) := by
  simp [frobSum13Z, frobSum13, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_pow]

lemma frobSum_pow {n : ℕ} (c : Fin n → ZMod 13) :
    (frobSum c) ^ 13 = frobSum13 c := by
  haveI : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  rw [frobSum, frobSum13, sum_pow_char]
  apply Finset.sum_congr rfl
  intro i _
  rw [mul_pow, ← C_pow, ← pow_mul, zmod13_pow_thirteen, Nat.mul_comm]

lemma thirteen_eq_zero : (13 : (ZMod 13)[X]) = 0 := by
  exact CharP.cast_eq_zero ((ZMod 13)[X]) 13


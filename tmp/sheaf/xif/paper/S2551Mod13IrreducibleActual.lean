lemma FZ_natDegree_le : FZ.natDegree ≤ 12 := by
  unfold FZ
  compute_degree!

lemma FZ_map : FZ.map (Int.castRingHom (ZMod 13)) = F13 := by
  ext n
  by_cases hn : n ≤ 12
  · interval_cases n <;>
      (simp [FZ, F13, Polynomial.coeff_add, Polynomial.coeff_C_mul,
        Polynomial.coeff_X_pow, Polynomial.coeff_C] <;> decide)
  · have h1 : (FZ.map (Int.castRingHom (ZMod 13))).coeff n = 0 := by
      apply coeff_eq_zero_of_natDegree_lt
      have h := Polynomial.natDegree_map_le (f := Int.castRingHom (ZMod 13)) (p := FZ)
      have h2 : FZ.natDegree ≤ 12 := FZ_natDegree_le
      omega
    have h2 : F13.coeff n = 0 := by
      apply coeff_eq_zero_of_natDegree_lt
      have hF : F13.natDegree = 12 := F13_natDegree
      omega
    rw [h1, h2]


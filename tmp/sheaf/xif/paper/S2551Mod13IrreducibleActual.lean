lemma dvd_step {P Q : (ZMod 13)[X]} {e : ℕ}
    (hP : G ∣ (X : (ZMod 13)[X]) ^ e - P)
    (hQ : G ∣ P ^ 13 - Q) :
    G ∣ (X : (ZMod 13)[X]) ^ (e * 13) - Q := by
  obtain ⟨A, hA⟩ := hP
  obtain ⟨B, hB⟩ := hQ
  refine ⟨B + G ^ 12 * A ^ 13, ?_⟩
  have hX : (X : (ZMod 13)[X]) ^ e = P + G * A := by rw [← hA]; ring
  have hPpow : P ^ 13 = Q + G * B := by rw [← hB]; ring
  have hchar : (P + G * A) ^ 13 = P ^ 13 + (G * A) ^ 13 := by
    haveI : Fact (Nat.Prime 13) := ⟨by norm_num⟩
    rw [add_pow_char]
  calc (X : (ZMod 13)[X]) ^ (e * 13) - Q
      = ((X : (ZMod 13)[X]) ^ e) ^ 13 - Q := by rw [pow_mul]
  _ = (P + G * A) ^ 13 - Q := by rw [hX]
  _ = (P ^ 13 + (G * A) ^ 13) - Q := by rw [hchar]
  _ = (P ^ 13 + G ^ 13 * A ^ 13) - Q := by rw [mul_pow]
  _ = ((Q + G * B) + G ^ 13 * A ^ 13) - Q := by rw [hPpow]
  _ = G * (B + G ^ 12 * A ^ 13) := by ring


/- Route 7.2 final assembly, isolated: if every bounded-degree extension is generated by a
root of one of the finite residue polynomials of modulus N, then the bounded-degree extension
types are finite.  The remaining analytic input is exactly the hypothesis hgen. -/
import tmp.sheaf.xif.paper.Mzk1G1UniversalRootGeneratorsActual
import tmp.sheaf.xif.paper.Mzk1G1UniversalResiduePolysActual
import Mathlib.Tactic
noncomputable section
namespace LeanFormal.IUT.XiFPaper.Mzk1G1UniversalAssemblyActual

open Polynomial
open LeanFormal.IUT.XiFPaper.Mzk1LpFinitenessActual
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalResiduePolysActual
open LeanFormal.IUT.XiFPaper.Mzk1G1UniversalRootGeneratorsActual

variable {p : Nat} [Fact p.Prime]

/-- Assembly: finite residue polynomial classes N whose roots generate every degree <= d
extension imply BoundedDegreeFinitelyManyFields. -/
theorem BoundedDegreeFinitelyManyFields_of_residue_roots (d N : Nat)
    (hgen : ∀ M : IntermediateField ℚ_[p] (PadicAlgCl p), FiniteDimensional ℚ_[p] M →
      Module.finrank ℚ_[p] M ≤ d →
      ∃ (n : Nat) (hn : n ≤ d) (c : Fin n → ZMod (p ^ N)) (x : PadicAlgCl p),
        ((residueMonicPoly p N n c).map (algebraMap ℤ_[p] ℚ_[p])).aeval x = 0 ∧
          M = IntermediateField.adjoin ℚ_[p] ({x} : Set (PadicAlgCl p))) :
    BoundedDegreeFinitelyManyFields (p := p) d := by
  classical
  let S : Finset (Polynomial ℚ_[p]) :=
    Finset.univ.image (fun t : (n : Fin (d + 1)) × (Fin n.1 → ZMod (p ^ N)) =>
      (residueMonicPoly p N t.1.1 t.2).map (algebraMap ℤ_[p] ℚ_[p]))
  have hS0 : ∀ f ∈ S, f ≠ 0 := by
    intro f hf
    obtain ⟨t, -, rfl⟩ := Finset.mem_image.mp hf
    exact ((residueMonicPoly_monic p N t.1.1 t.2).map (algebraMap ℤ_[p] ℚ_[p])).ne_zero
  refine finite_boundedDegree_of_finite_roots d S hS0 ?_
  intro M hMfin hMle
  obtain ⟨n, hn, c, x, hx, hM⟩ := hgen M hMfin hMle
  refine ⟨x, ⟨(residueMonicPoly p N n c).map (algebraMap ℤ_[p] ℚ_[p]), ?_, hx⟩, hM⟩
  refine Finset.mem_image.mpr ?_
  refine ⟨(⟨⟨n, Nat.lt_succ_of_le hn⟩,
    (fun i : Fin n => c i)⟩ : (n : Fin (d + 1)) × (Fin n.1 → ZMod (p ^ N))), Finset.mem_univ _, ?_⟩
  rfl

#print axioms BoundedDegreeFinitelyManyFields_of_residue_roots
end LeanFormal.IUT.XiFPaper.Mzk1G1UniversalAssemblyActual

import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.FieldTheory.Galois.Infinite

/-!
# Coordinate-generated division fields of Weierstrass points

For a Weierstrass curve `E` over a field `K`, an extension field `L`, and a family of
points `P i` of the base change `E⁄L`, this file studies the intermediate field
`K(P i : i)` generated by the affine coordinates of the `P i`. The points are Mathlib's
actual nonsingular points `WeierstrassCurve.Affine.Point (E.baseChange L)`, and the Galois
action on them is the actual base-change point map
`WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L)` on the group of points, not a
surrogate.

## Main results

* `pointMap_apply_eq_self_of_mem_fixingSubgroup`: a `K`-algebra automorphism `σ` of `L`
  that lies in the fixing subgroup of `K(P i : i)` fixes every `P i` under
  `WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L)`. Conversely, if `σ` fixes every
  `P i` in this sense, then it lies in the fixing subgroup
  (`mem_fixingSubgroup_divisionField_of_pointMap_apply_eq_self`); the two directions are
  packaged as `mem_fixingSubgroup_divisionField_iff`.

* Inclusion lemmas: every coordinate lies in the generated field
  (`pointCoordinateSet_subset_divisionField`), the single-point field is contained in the
  family field (`pointField_le_divisionField`), the universal property
  `divisionField_le_iff`, and `divisionField_eq_iSup_pointField`.

* Finiteness: coordinate sets of points are finite (`pointCoordinateSet_finite`), and if
  every coordinate is integral over `K`, then `K(P i : i)` is a finite extension of `K`
  (`pointField_finiteDimensional`, `divisionField_finiteDimensional`). Integrality is a
  genuine hypothesis: this file does not prove, and does not assume, that coordinates of
  prime-torsion points are algebraic over `K`, so no unconditional finiteness of prime
  torsion is claimed. The integrality hypothesis is discharged when `L/K` is algebraic
  (`hasIntegralCoordinates_of_isAlgebraic`, `pointField_finiteDimensional_of_isAlgebraic`,
  `divisionField_finiteDimensional_of_isAlgebraic`) or finite-dimensional
  (`pointField_finiteDimensional_of_finiteDimensional`,
  `divisionField_finiteDimensional_of_finiteDimensional`), and finiteness transfers from
  any finite-dimensional intermediate field containing the coordinates
  (`divisionField_finiteDimensional_of_le_of_finiteDimensional`).

* Finite Galois closure: if `L/K` is Galois and `K(P i : i)` is finite-dimensional over
  `K`, then the normal closure of `K(P i : i)` in `L` is a finite-dimensional Galois
  extension of `K` containing it
  (`isGalois_finiteDimensional_normalClosure_of_hasIntegralCoordinates`, from
  `normalClosure_finiteDimensional` and `normalClosure_isGalois`). In the Krull topology,
  the fixing subgroup of `K(P i : i)` is closed, and open if and only if `K(P i : i)` is
  finite-dimensional over `K` (`isClosed_fixingSubgroup_divisionField`,
  `isOpen_fixingSubgroup_divisionField_iff`).

* Galois criteria: a normal and separable extension is Galois
  (`isGalois_of_normal_of_isSeparable`), a separable splitting field is Galois
  (`isGalois_of_isSplittingField_of_separable`), and the algebraic closure of a perfect
  field is Galois (`isGalois_algebraicClosure_of_perfectField`).

## Scope

All statements are about the actual Mathlib objects named above. No identification of
these intermediate fields with any IUT kernel field is made, and no claim about global
finiteness of prime torsion is made. The finite-dimensionality statements for coordinate
fields require the integrality hypothesis on the coordinates, or one of the explicit
ambient hypotheses stated in the corresponding declarations; none of these hypotheses is
proved in this file.
-/

namespace IUT.ABCBridge.Galois.EllipticDivisionField

open WeierstrassCurve

variable (K L : Type*) [Field K] [Field L] [Algebra K L]

/-! ## Coordinates and coordinate-generated fields -/

/-- The affine coordinate set of a point `Q` on the base change `E⁄L`: the empty set for
the point at infinity, and `{x, y}` for an affine point with coordinates `x` and `y`. -/
def pointCoordinateSet (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) : Set L :=
  match Q with
  | .zero => ∅
  | .some x y _ => {x, y}

@[simp]
theorem pointCoordinateSet_zero (E : WeierstrassCurve.Affine K) :
    pointCoordinateSet K L E 0 = ∅ :=
  rfl

@[simp]
theorem pointCoordinateSet_some (E : WeierstrassCurve.Affine K) {x y : L}
    (h : (WeierstrassCurve.Affine.baseChange E L).Nonsingular x y) :
    pointCoordinateSet K L E (WeierstrassCurve.Affine.Point.some x y h) = {x, y} :=
  rfl

@[simp]
theorem mem_pointCoordinateSet_zero (E : WeierstrassCurve.Affine K) (z : L) :
    z ∈ pointCoordinateSet K L E 0 ↔ False := by
  rw [pointCoordinateSet_zero]
  simp

@[simp]
theorem mem_pointCoordinateSet_some (E : WeierstrassCurve.Affine K) {x y z : L}
    (h : (WeierstrassCurve.Affine.baseChange E L).Nonsingular x y) :
    z ∈ pointCoordinateSet K L E (WeierstrassCurve.Affine.Point.some x y h) ↔
      z = x ∨ z = y := by
  rw [pointCoordinateSet_some]
  simp

/-- The field `K(Q)` generated over `K` by the coordinates of a single point `Q`. -/
noncomputable def pointField (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) : IntermediateField K L :=
  IntermediateField.adjoin K (pointCoordinateSet K L E Q)

/-- The coordinate-generated field `K(P i : i)` of a family of points on `E⁄L`. -/
noncomputable def divisionField (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) : IntermediateField K L :=
  IntermediateField.adjoin K (⋃ i, pointCoordinateSet K L E (P i))

/-- The coordinates of `Q` are integral over `K`. This is the hypothesis under which
finite-dimensionality of the coordinate field is available. -/
def HasIntegralCoordinates (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) : Prop :=
  ∀ z ∈ pointCoordinateSet K L E Q, IsIntegral K z

theorem pointCoordinateSet_finite (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) :
    (pointCoordinateSet K L E Q).Finite := by
  rcases Q with _ | ⟨x, y, h⟩
  · exact Set.finite_empty
  · exact (Set.finite_singleton y).insert x

/-! ## Inclusion lemmas -/

theorem pointCoordinateSet_subset_pointField (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) :
    pointCoordinateSet K L E Q ⊆ pointField K L E Q :=
  IntermediateField.subset_adjoin K _

theorem pointField_le_iff (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point)
    {F : IntermediateField K L} :
    pointField K L E Q ≤ F ↔ pointCoordinateSet K L E Q ⊆ F := by
  rw [pointField, IntermediateField.adjoin_le_iff]

theorem pointCoordinateSet_subset_divisionField (E : WeierstrassCurve.Affine K)
    {ι : Type*} (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) (i : ι) :
    pointCoordinateSet K L E (P i) ⊆ divisionField K L E P :=
  fun _ hz => IntermediateField.subset_adjoin K _ (Set.mem_iUnion.mpr ⟨i, hz⟩)

theorem pointField_le_divisionField (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) (i : ι) :
    pointField K L E (P i) ≤ divisionField K L E P :=
  IntermediateField.adjoin_le_iff.mpr (pointCoordinateSet_subset_divisionField K L E P i)

theorem divisionField_le_iff (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    {F : IntermediateField K L} :
    divisionField K L E P ≤ F ↔ ∀ i, pointCoordinateSet K L E (P i) ⊆ F := by
  rw [divisionField, IntermediateField.adjoin_le_iff, Set.iUnion_subset_iff]

theorem divisionField_eq_iSup_pointField (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) :
    divisionField K L E P = ⨆ i, pointField K L E (P i) := by
  simp only [divisionField, pointField, IntermediateField.adjoin_iUnion]

/-! ## Finiteness -/

theorem pointField_finiteDimensional (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point)
    (hQ : HasIntegralCoordinates K L E Q) :
    FiniteDimensional K ↥(pointField K L E Q) := by
  haveI : Finite ↑(pointCoordinateSet K L E Q) :=
    (pointCoordinateSet_finite K L E Q).to_subtype
  change FiniteDimensional K ↥(IntermediateField.adjoin K (pointCoordinateSet K L E Q))
  exact IntermediateField.finiteDimensional_adjoin (S := pointCoordinateSet K L E Q) hQ

theorem divisionField_coordinateSet_finite (E : WeierstrassCurve.Affine K) {ι : Type*}
    [Finite ι] (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) :
    (⋃ i, pointCoordinateSet K L E (P i)).Finite :=
  Set.finite_iUnion fun i => pointCoordinateSet_finite K L E (P i)

theorem divisionField_finiteDimensional (E : WeierstrassCurve.Affine K) {ι : Type*}
    [Finite ι] (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    (h : ∀ i, HasIntegralCoordinates K L E (P i)) :
    FiniteDimensional K ↥(divisionField K L E P) := by
  haveI : Finite ↑(⋃ i, pointCoordinateSet K L E (P i)) :=
    (divisionField_coordinateSet_finite K L E P).to_subtype
  change FiniteDimensional K
    ↥(IntermediateField.adjoin K (⋃ i, pointCoordinateSet K L E (P i)))
  exact IntermediateField.finiteDimensional_adjoin
    (S := ⋃ i, pointCoordinateSet K L E (P i)) (fun z hz => by
      obtain ⟨i, hzi⟩ := Set.mem_iUnion.mp hz
      exact h i z hzi)

/-- If `L/K` is algebraic, then every element of `L` is integral over `K`, so the
integrality hypothesis of `pointField_finiteDimensional` is automatic. -/
theorem hasIntegralCoordinates_of_isAlgebraic (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) [Algebra.IsAlgebraic K L] :
    HasIntegralCoordinates K L E Q :=
  fun z _ => (Algebra.IsAlgebraic.isAlgebraic z).isIntegral

theorem pointField_finiteDimensional_of_isAlgebraic (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) [Algebra.IsAlgebraic K L] :
    FiniteDimensional K ↥(pointField K L E Q) :=
  pointField_finiteDimensional K L E Q (hasIntegralCoordinates_of_isAlgebraic K L E Q)

theorem divisionField_finiteDimensional_of_isAlgebraic (E : WeierstrassCurve.Affine K)
    {ι : Type*} [Finite ι] (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    [Algebra.IsAlgebraic K L] :
    FiniteDimensional K ↥(divisionField K L E P) :=
  divisionField_finiteDimensional K L E P fun i =>
    hasIntegralCoordinates_of_isAlgebraic K L E (P i)

theorem pointField_finiteDimensional_of_finiteDimensional (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) [FiniteDimensional K L] :
    FiniteDimensional K ↥(pointField K L E Q) :=
  IntermediateField.finiteDimensional_left (pointField K L E Q)

theorem divisionField_finiteDimensional_of_finiteDimensional (E : WeierstrassCurve.Affine K)
    {ι : Type*} (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    [FiniteDimensional K L] :
    FiniteDimensional K ↥(divisionField K L E P) :=
  IntermediateField.finiteDimensional_left (divisionField K L E P)

/-- Finiteness of `K(P i : i)` transfers from any intermediate field containing it, so it
follows from any known finite-dimensional field between the coordinates and `L` (for
instance a finite-dimensional splitting field or normal closure). -/
theorem divisionField_finiteDimensional_of_le_of_finiteDimensional
    (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) {F : IntermediateField K L}
    (hF : divisionField K L E P ≤ F) [FiniteDimensional K ↥F] :
    FiniteDimensional K ↥(divisionField K L E P) :=
  FiniteDimensional.of_injective (IntermediateField.inclusion hF).toLinearMap
    (IntermediateField.inclusion_injective hF)

/-! ## Fixed points of algebra automorphisms -/

theorem mem_fixingSubgroup_adjoin_of_fixes_generators (σ : L ≃ₐ[K] L) {s : Set L}
    (hs : ∀ z ∈ s, σ z = z) :
    σ ∈ (IntermediateField.adjoin K s).fixingSubgroup := by
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  exact IntermediateField.adjoin_induction K (p := fun x _ => σ x = x)
    (fun x hx => hs x hx) (fun k => σ.commutes k)
    (fun x y _ _ ihx ihy => by rw [map_add, ihx, ihy])
    (fun x _ ihx => by rw [map_inv₀, ihx])
    (fun x y _ _ ihx ihy => by rw [map_mul, ihx, ihy]) hx

section PointMap

variable [DecidableEq L]

theorem pointMap_apply_eq_self_of_fixes_coordinates (E : WeierstrassCurve.Affine K)
    (σ : L ≃ₐ[K] L) (Q : (WeierstrassCurve.Affine.baseChange E L).Point)
    (h : ∀ z ∈ pointCoordinateSet K L E Q, σ z = z) :
    WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L) Q = Q := by
  rcases Q with _ | ⟨x, y, hns⟩
  · exact WeierstrassCurve.Affine.Point.map_zero _
  · have hx : σ x = x := h x (by simp)
    have hy : σ y = y := h y (by simp)
    rw [WeierstrassCurve.Affine.Point.map_some, WeierstrassCurve.Affine.Point.some.injEq]
    exact ⟨hx, hy⟩

theorem coordinates_fixed_of_pointMap_apply_eq_self (E : WeierstrassCurve.Affine K)
    (σ : L ≃ₐ[K] L) (Q : (WeierstrassCurve.Affine.baseChange E L).Point)
    (h : WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L) Q = Q) :
    ∀ z ∈ pointCoordinateSet K L E Q, σ z = z := by
  rcases Q with _ | ⟨x, y, hns⟩
  · change ∀ z ∈ (∅ : Set L), σ z = z
    intro z hz
    exact absurd hz (by simp)
  · have hc : σ x = x ∧ σ y = y := by
      rw [WeierstrassCurve.Affine.Point.map_some] at h
      exact WeierstrassCurve.Affine.Point.some.inj h
    intro z hz
    rw [pointCoordinateSet_some, Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact hc.1
    · exact hc.2

theorem pointMap_apply_eq_self_of_mem_fixingSubgroup (E : WeierstrassCurve.Affine K)
    {ι : Type*} (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    (σ : L ≃ₐ[K] L) (hσ : σ ∈ (divisionField K L E P).fixingSubgroup) (i : ι) :
    WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L) (P i) = P i :=
  pointMap_apply_eq_self_of_fixes_coordinates K L E σ (P i) fun z hz =>
    (IntermediateField.mem_fixingSubgroup_iff _ σ).mp hσ z
      (pointCoordinateSet_subset_divisionField K L E P i hz)

theorem pointMap_apply_eq_self_of_mem_pointField_fixingSubgroup
    (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point)
    (σ : L ≃ₐ[K] L) (hσ : σ ∈ (pointField K L E Q).fixingSubgroup) :
    WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L) Q = Q :=
  pointMap_apply_eq_self_of_fixes_coordinates K L E σ Q fun z hz =>
    (IntermediateField.mem_fixingSubgroup_iff _ σ).mp hσ z
      (IntermediateField.subset_adjoin K _ hz)

theorem mem_fixingSubgroup_divisionField_of_pointMap_apply_eq_self
    (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) (σ : L ≃ₐ[K] L)
    (h : ∀ i, WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L) (P i) = P i) :
    σ ∈ (divisionField K L E P).fixingSubgroup := by
  rw [divisionField]
  refine mem_fixingSubgroup_adjoin_of_fixes_generators K L σ ?_
  intro z hz
  obtain ⟨i, hzi⟩ := Set.mem_iUnion.mp hz
  exact coordinates_fixed_of_pointMap_apply_eq_self K L E σ (P i) (h i) z hzi

theorem mem_fixingSubgroup_divisionField_iff (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) (σ : L ≃ₐ[K] L) :
    σ ∈ (divisionField K L E P).fixingSubgroup ↔
      ∀ i, WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L) (P i) = P i :=
  ⟨fun hσ i => pointMap_apply_eq_self_of_mem_fixingSubgroup K L E P σ hσ i,
    fun h => mem_fixingSubgroup_divisionField_of_pointMap_apply_eq_self K L E P σ h⟩

theorem pointMap_mul_apply (E : WeierstrassCurve.Affine K) (σ τ : L ≃ₐ[K] L)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) :
    WeierstrassCurve.Affine.Point.map (↑(σ * τ) : L →ₐ[K] L) Q =
      WeierstrassCurve.Affine.Point.map (σ : L →ₐ[K] L)
        (WeierstrassCurve.Affine.Point.map (τ : L →ₐ[K] L) Q) := by
  rw [WeierstrassCurve.Affine.Point.map_map]
  congr 1

theorem pointMap_one_apply (E : WeierstrassCurve.Affine K)
    (Q : (WeierstrassCurve.Affine.baseChange E L).Point) :
    WeierstrassCurve.Affine.Point.map (↑(1 : L ≃ₐ[K] L) : L →ₐ[K] L) Q = Q := by
  rcases Q with _ | ⟨x, y, h⟩
  · exact WeierstrassCurve.Affine.Point.map_zero _
  · rw [WeierstrassCurve.Affine.Point.map_some, WeierstrassCurve.Affine.Point.some.injEq]
    exact ⟨rfl, rfl⟩

end PointMap

/-! ## Finite Galois closure and the Krull topology -/

section NormalClosure

theorem divisionField_le_normalClosure (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) :
    divisionField K L E P ≤
      IntermediateField.normalClosure K ↥(divisionField K L E P) L :=
  IntermediateField.le_normalClosure _

theorem normalClosure_finiteDimensional (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    [FiniteDimensional K ↥(divisionField K L E P)] :
    FiniteDimensional K
      ↥(IntermediateField.normalClosure K ↥(divisionField K L E P) L) :=
  normalClosure.is_finiteDimensional K ↥(divisionField K L E P) L

theorem normalClosure_isGalois (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) [IsGalois K L] :
    IsGalois K ↥(IntermediateField.normalClosure K ↥(divisionField K L E P) L) :=
  IsGalois.normalClosure K ↥(divisionField K L E P) L

theorem isGalois_finiteDimensional_normalClosure_of_hasIntegralCoordinates
    (E : WeierstrassCurve.Affine K) {ι : Type*} [Finite ι] [IsGalois K L]
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    (h : ∀ i, HasIntegralCoordinates K L E (P i)) :
    IsGalois K ↥(IntermediateField.normalClosure K ↥(divisionField K L E P) L) ∧
      FiniteDimensional K
        ↥(IntermediateField.normalClosure K ↥(divisionField K L E P) L) := by
  haveI := divisionField_finiteDimensional K L E P h
  exact ⟨normalClosure_isGalois K L E P, normalClosure_finiteDimensional K L E P⟩

/-- The finite Galois closure package where finiteness of `K(P i : i)` comes from a
finite-dimensional ambient extension instead of coordinate integrality (no finiteness of
the index family is needed). -/
theorem isGalois_finiteDimensional_normalClosure_of_finiteDimensional
    (E : WeierstrassCurve.Affine K) {ι : Type*} [IsGalois K L] [FiniteDimensional K L]
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) :
    IsGalois K ↥(IntermediateField.normalClosure K ↥(divisionField K L E P) L) ∧
      FiniteDimensional K
        ↥(IntermediateField.normalClosure K ↥(divisionField K L E P) L) := by
  haveI := divisionField_finiteDimensional_of_finiteDimensional K L E P
  exact ⟨normalClosure_isGalois K L E P, normalClosure_finiteDimensional K L E P⟩

theorem isClosed_fixingSubgroup_divisionField (E : WeierstrassCurve.Affine K)
    {ι : Type*} (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    [IsGalois K L] :
    IsClosed ((divisionField K L E P).fixingSubgroup : Set (L ≃ₐ[K] L)) :=
  InfiniteGalois.fixingSubgroup_isClosed _

theorem isOpen_fixingSubgroup_divisionField_iff (E : WeierstrassCurve.Affine K)
    {ι : Type*} (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point)
    [IsGalois K L] :
    IsOpen (divisionField K L E P).fixingSubgroup.carrier ↔
      FiniteDimensional K ↥(divisionField K L E P) :=
  InfiniteGalois.isOpen_iff_finite _

/-- The fixing subgroup of the coordinate field is open when the ambient extension is
finite-dimensional, by `isOpen_fixingSubgroup_divisionField_iff`. -/
theorem isOpen_fixingSubgroup_divisionField_of_finiteDimensional
    (E : WeierstrassCurve.Affine K) {ι : Type*}
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) [IsGalois K L]
    [FiniteDimensional K L] :
    IsOpen (divisionField K L E P).fixingSubgroup.carrier :=
  (isOpen_fixingSubgroup_divisionField_iff K L E P).mpr
    (divisionField_finiteDimensional_of_finiteDimensional K L E P)

/-- The fixing subgroup of the coordinate field is open for an algebraic ambient
extension and a finite family of points, by `isOpen_fixingSubgroup_divisionField_iff`. -/
theorem isOpen_fixingSubgroup_divisionField_of_isAlgebraic
    (E : WeierstrassCurve.Affine K) {ι : Type*} [Finite ι]
    (P : ι → (WeierstrassCurve.Affine.baseChange E L).Point) [IsGalois K L]
    [Algebra.IsAlgebraic K L] :
    IsOpen (divisionField K L E P).fixingSubgroup.carrier :=
  (isOpen_fixingSubgroup_divisionField_iff K L E P).mpr
    (divisionField_finiteDimensional_of_isAlgebraic K L E P)

end NormalClosure

/-! ## Criteria for Galois extensions -/

section GaloisCriteria

/-- A normal and separable field extension is Galois. Mathlib provides `Normal` and
`Algebra.IsSeparable` separately but no packaged composition; this is the composition
used to discharge `IsGalois K L` for the coordinate-field statements. -/
theorem isGalois_of_normal_of_isSeparable (hn : Normal K L)
    (hs : Algebra.IsSeparable K L) : IsGalois K L := by
  letI := hn
  letI := hs
  exact IsGalois.mk

/-- A separable splitting field of `K` is a Galois extension: Mathlib's
`IsGalois.of_separable_splitting_field` with the hypotheses named. -/
theorem isGalois_of_isSplittingField_of_separable (p : Polynomial K)
    (sp : p.IsSplittingField K L) (hp : p.Separable) : IsGalois K L := by
  haveI := sp
  exact IsGalois.of_separable_splitting_field hp

/-- The algebraic closure of a perfect field is a Galois extension: it is normal, and
separable because every element is separable over a perfect field. -/
theorem isGalois_algebraicClosure_of_perfectField [PerfectField K] :

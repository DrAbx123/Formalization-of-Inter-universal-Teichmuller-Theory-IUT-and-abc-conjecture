import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import LeanFormal.IUT.ABCBridge.Geometry.LegendreWeierstrassCurve
import LeanFormal.IUT.ABCBridge.Geometry.LegendreQuadraticParameterFields
import LeanFormal.IUT.ABCBridge.Galois.EllipticDivisionPolynomialEvaluation

/-!
# Ordered level-`2` structure of the Legendre Weierstrass model

The Legendre model of this project is the actual Mathlib `WeierstrassCurve`
`y ^ 2 = x * (x - 1) * (x - parameter)` from `LegendreWeierstrassCurve.lean`.
This file records its ordered level-`2` data:

* the ordered root triple `![0, 1, parameter]` of the displayed cubic together
  with the factorization of that cubic over the triple;
* the actual Mathlib two-torsion polynomial and its discriminant, displayed on
  the parameter;
* the three nontrivial `2`-torsion points `(0, 0)`, `(1, 0)`,
  `(parameter, 0)`: they lie on the curve, are killed by `2`, are pairwise
  distinct under the ellipticity hypotheses, and every rational `2`-torsion
  point is the zero point or one of the three;
* the `2`-torsion subgroup: four elements, generated by the three displayed
  branch points;
* the quadratic-extension parameterization of the level-`2` data through the
  square-root interfaces of `LegendreQuadraticParameterFields.lean`: square
  roots of the ordered root differences `parameter` and `1 - parameter` lie in
  `legendreParameterField`, and the provable fiber statement that the
  parameter field needs at most one nontrivial quadratic adjunction when the
  base already contains square roots of `-1` and of the parameter.

Consumer: the Frey-to-Legendre comparison chain and the ordered level-2 data
for the degree-6 moduli construction; not odd-`l` theory.  Only statements
proved in this file are asserted; no twist statement is claimed here.
-/

noncomputable section

namespace LeanFormal.IUT

open WeierstrassCurve

open LeanFormal.IUT.LegendreQuadraticParameterFields

universe u

section RingLevelTwoRoots

variable {R : Type u} [CommRing R]

/-- The three displayed roots `0`, `1`, `parameter` of the Legendre cubic, as
an ordered triple.  The ordering is the one read off from the factorized
right-hand side `x * (x - 1) * (x - parameter)`. -/
def legendreLevelTwoRoots (parameter : R) : Fin 3 → R := ![0, 1, parameter]

@[simp] theorem legendreLevelTwoRoots_zero (parameter : R) :
    legendreLevelTwoRoots parameter 0 = 0 := rfl

@[simp] theorem legendreLevelTwoRoots_one (parameter : R) :
    legendreLevelTwoRoots parameter 1 = 1 := rfl

@[simp] theorem legendreLevelTwoRoots_two (parameter : R) :
    legendreLevelTwoRoots parameter 2 = parameter := rfl

/-- The displayed cubic is the product over the ordered root triple. -/
theorem legendreLevelTwoRoots_factorization (parameter x : R) :
    x * (x - 1) * (x - parameter) =
      ∏ i : Fin 3, (x - legendreLevelTwoRoots parameter i) := by
  rw [Fin.prod_univ_three]
  simp only [legendreLevelTwoRoots_zero, legendreLevelTwoRoots_one,
    legendreLevelTwoRoots_two]
  ring

/-- The actual Mathlib two-torsion polynomial of the Legendre model, displayed
on the parameter. -/
theorem legendreWeierstrassCurve_twoTorsionPolynomial (parameter : R) :
    (legendreWeierstrassCurve parameter).twoTorsionPolynomial =
      ⟨4, -4 * (1 + parameter), 4 * parameter, 0⟩ := by
  apply Cubic.ext
  · rfl
  · simp only [WeierstrassCurve.twoTorsionPolynomial, legendreWeierstrassCurve_b₂]
  · simp only [WeierstrassCurve.twoTorsionPolynomial, legendreWeierstrassCurve_b₄]
    ring
  · simp only [WeierstrassCurve.twoTorsionPolynomial, legendreWeierstrassCurve_b₆]

/-- The discriminant of the actual two-torsion polynomial, displayed on the
parameter: sixteen times the actual Legendre discriminant. -/
theorem legendreWeierstrassCurve_twoTorsionPolynomial_discr (parameter : R) :
    (legendreWeierstrassCurve parameter).twoTorsionPolynomial.discr =
      256 * (parameter * (1 - parameter)) ^ 2 := by
  rw [WeierstrassCurve.twoTorsionPolynomial_discr,
    legendreWeierstrassCurve_discriminant]
  ring

end RingLevelTwoRoots

section FieldParameterExtraction

variable {K : Type u} [Field K] (parameter : K)

/-- Ellipticity of the Legendre model forces characteristic different from
two. -/
theorem legendreWeierstrassCurve_two_ne_zero_of_isElliptic
    (hE : (legendreWeierstrassCurve parameter).IsElliptic) : (2 : K) ≠ 0 := by
  intro htwo
  exact legendreWeierstrassCurve_not_isElliptic_of_two_eq_zero parameter htwo hE

/-- The ellipticity of the Legendre model is exactly the two excluded
parameter values; here that pair of conditions is extracted. -/
theorem legendreWeierstrassCurve_parameters_of_isElliptic
    (hE : (legendreWeierstrassCurve parameter).IsElliptic) :
    parameter ≠ 0 ∧ parameter ≠ 1 :=
  (legendreWeierstrassCurve_isElliptic_iff parameter
    (legendreWeierstrassCurve_two_ne_zero_of_isElliptic parameter hE)).mp hE

/-- The `2`-division evaluation of the Legendre model vanishes exactly when
`2 * y = 0`, because its coefficients `a₁` and `a₃` vanish. -/
theorem legendreWeierstrassCurve_evalDivisionPolynomial_two_eq_zero_iff
    (parameter x y : K) :
    (legendreWeierstrassCurve parameter).evalDivisionPolynomial x y 2 = 0 ↔
      (2 : K) * y = 0 := by
  rw [WeierstrassCurve.evalDivisionPolynomial_two]
  simp only [legendreWeierstrassCurve_a₁, legendreWeierstrassCurve_a₃, zero_mul,
    add_zero]

end FieldParameterExtraction

section LevelTwoTorsionPoints

variable {K : Type u} [Field K] (parameter : K)
  [(legendreWeierstrassCurve parameter).IsElliptic]

/-- The affine point `(0, 0)` of the Legendre model. -/
def legendreLevelTwoPointRootZero : (legendreWeierstrassCurve parameter).toAffine.Point :=
  WeierstrassCurve.Affine.Point.some 0 0
    (WeierstrassCurve.Affine.equation_iff_nonsingular.mp
      (legendreWeierstrassCurve_equation_zero parameter))

/-- The affine point `(1, 0)` of the Legendre model. -/
def legendreLevelTwoPointRootOne : (legendreWeierstrassCurve parameter).toAffine.Point :=
  WeierstrassCurve.Affine.Point.some 1 0
    (WeierstrassCurve.Affine.equation_iff_nonsingular.mp
      (legendreWeierstrassCurve_equation_one parameter))

/-- The affine point `(parameter, 0)` of the Legendre model. -/
def legendreLevelTwoPointRootParameter :
    (legendreWeierstrassCurve parameter).toAffine.Point :=
  WeierstrassCurve.Affine.Point.some parameter 0
    (WeierstrassCurve.Affine.equation_iff_nonsingular.mp
      (legendreWeierstrassCurve_equation_parameter parameter))

theorem legendreLevelTwoPointRootZero_ne_zero :
    legendreLevelTwoPointRootZero parameter ≠ 0 :=
  fun h => WeierstrassCurve.Affine.Point.some_ne_zero
    (W' := (legendreWeierstrassCurve parameter).toAffine) (x := 0) (y := 0)
    (WeierstrassCurve.Affine.equation_iff_nonsingular.mp
      (legendreWeierstrassCurve_equation_zero parameter)) h

theorem legendreLevelTwoPointRootOne_ne_zero :
    legendreLevelTwoPointRootOne parameter ≠ 0 :=
  fun h => WeierstrassCurve.Affine.Point.some_ne_zero
    (W' := (legendreWeierstrassCurve parameter).toAffine) (x := 1) (y := 0)
    (WeierstrassCurve.Affine.equation_iff_nonsingular.mp
      (legendreWeierstrassCurve_equation_one parameter)) h

theorem legendreLevelTwoPointRootParameter_ne_zero :
    legendreLevelTwoPointRootParameter parameter ≠ 0 :=
  fun h => WeierstrassCurve.Affine.Point.some_ne_zero
    (W' := (legendreWeierstrassCurve parameter).toAffine) (x := parameter) (y := 0)
    (WeierstrassCurve.Affine.equation_iff_nonsingular.mp
      (legendreWeierstrassCurve_equation_parameter parameter)) h

theorem legendreLevelTwoPointRootZero_ne_rootOne :
    legendreLevelTwoPointRootZero parameter ≠ legendreLevelTwoPointRootOne parameter := by
  intro h
  have hx : (0 : K) = 1 :=
    (WeierstrassCurve.Affine.Point.X_eq_iff (x₁ := 0) (y₁ := 0) (x₂ := 1)
      (y₂ := 0)).mpr (Or.inl h)
  exact zero_ne_one hx

theorem legendreLevelTwoPointRootZero_ne_rootParameter :
    legendreLevelTwoPointRootZero parameter ≠ legendreLevelTwoPointRootParameter parameter := by
  intro h
  have hx : (0 : K) = parameter :=
    (WeierstrassCurve.Affine.Point.X_eq_iff (x₁ := 0) (y₁ := 0) (x₂ := parameter)
      (y₂ := 0)).mpr (Or.inl h)
  exact (legendreWeierstrassCurve_parameters_of_isElliptic parameter inferInstance).1 hx.symm

theorem legendreLevelTwoPointRootOne_ne_rootParameter :
    legendreLevelTwoPointRootOne parameter ≠ legendreLevelTwoPointRootParameter parameter := by
  intro h
  have hx : (1 : K) = parameter :=
    (WeierstrassCurve.Affine.Point.X_eq_iff (x₁ := 1) (y₁ := 0) (x₂ := parameter)
      (y₂ := 0)).mpr (Or.inl h)
  exact (legendreWeierstrassCurve_parameters_of_isElliptic parameter inferInstance).2 hx.symm

end LevelTwoTorsionPoints

section LevelTwoDivisionPolynomial

variable {K : Type u} [Field K] [DecidableEq K]

/-- The `2`-torsion relation on the Legendre model forces `2 * y = 0`, since
`ψ₂ = 2y + a₁x + a₃` and `a₁ = a₃ = 0`. -/
theorem legendreWeierstrassCurve_two_mul_y_eq_zero_of_two_nsmul_eq_zero
    (parameter : K) {x y : K}
    (h : (legendreWeierstrassCurve parameter).toAffine.Nonsingular x y)
    (h2 : (2 : Nat) • WeierstrassCurve.Affine.Point.some x y h = 0) :
    (2 : K) * y = 0 := by
  rw [← legendreWeierstrassCurve_evalDivisionPolynomial_two_eq_zero_iff parameter x y]
  exact (two_nsmul_some_eq_zero_iff_evalDivisionPolynomial_two_eq_zero
    (W := legendreWeierstrassCurve parameter) h).mp h2

end LevelTwoDivisionPolynomial

section LevelTwoTorsionStructure

variable {K : Type u} [Field K] [DecidableEq K] (parameter : K)
  [(legendreWeierstrassCurve parameter).IsElliptic]

theorem legendreLevelTwoPointRootZero_two_nsmul :
    (2 : Nat) • legendreLevelTwoPointRootZero parameter = 0 := by
  rw [two_nsmul]
  refine WeierstrassCurve.Affine.Point.add_self_of_Y_eq ?_
  rw [← (legendreWeierstrassCurve parameter).evalDivisionPolynomial_two_eq_zero_iff_negY]
  simp

theorem legendreLevelTwoPointRootOne_two_nsmul :
    (2 : Nat) • legendreLevelTwoPointRootOne parameter = 0 := by
  rw [two_nsmul]
  refine WeierstrassCurve.Affine.Point.add_self_of_Y_eq ?_
  rw [← (legendreWeierstrassCurve parameter).evalDivisionPolynomial_two_eq_zero_iff_negY]
  simp

theorem legendreLevelTwoPointRootParameter_two_nsmul :
    (2 : Nat) • legendreLevelTwoPointRootParameter parameter = 0 := by
  rw [two_nsmul]
  refine WeierstrassCurve.Affine.Point.add_self_of_Y_eq ?_
  rw [← (legendreWeierstrassCurve parameter).evalDivisionPolynomial_two_eq_zero_iff_negY]
  simp

/-- Every rational `2`-torsion point of the Legendre elliptic curve is the
zero point or one of the three displayed branch points. -/
theorem legendreLevelTwo_eq_zero_or_root
    (P : (legendreWeierstrassCurve parameter).toAffine.Point)
    (hP : (2 : Nat) • P = 0) :
    P = 0 ∨ P = legendreLevelTwoPointRootZero parameter ∨
      P = legendreLevelTwoPointRootOne parameter ∨
        P = legendreLevelTwoPointRootParameter parameter := by
  cases P with
  | zero => exact Or.inl rfl
  | some x y h =>
    right
    have hy : y = 0 := by
      have hy2 : (2 : K) * y = 0 :=
        legendreWeierstrassCurve_two_mul_y_eq_zero_of_two_nsmul_eq_zero parameter h hP
      rcases mul_eq_zero.mp hy2 with hzero | hyzero
      · exact absurd hzero
          (legendreWeierstrassCurve_two_ne_zero_of_isElliptic parameter inferInstance)
      · exact hyzero
    subst hy
    rcases (legendreWeierstrassCurve_equation_y_zero_iff parameter x).mp h.1 with
      hx | hx | hx
    · subst hx
      exact Or.inl rfl
    · subst hx
      exact Or.inr (Or.inl rfl)
    · subst hx
      exact Or.inr (Or.inr rfl)

/-- A nonzero `2`-torsion point of the Legendre curve has one of the three
displayed cubic roots as its affine `x`-coordinate. -/
theorem legendreLevelTwo_some_x_eq_roots {x y : K}
    (h : (legendreWeierstrassCurve parameter).toAffine.Nonsingular x y)
    (h2 : (2 : Nat) • WeierstrassCurve.Affine.Point.some x y h = 0)
    (hne : WeierstrassCurve.Affine.Point.some x y h ≠ 0) :
    x = 0 ∨ x = 1 ∨ x = parameter := by
  rcases legendreLevelTwo_eq_zero_or_root parameter _ h2 with h0 | h | h | h
  · exact absurd h0 hne
  · exact Or.inl ((WeierstrassCurve.Affine.Point.X_eq_iff (x₁ := x) (y₁ := y)
      (x₂ := 0) (y₂ := 0)).mpr (Or.inl h))
  · exact Or.inr (Or.inl ((WeierstrassCurve.Affine.Point.X_eq_iff (x₁ := x) (y₁ := y)
      (x₂ := 1) (y₂ := 0)).mpr (Or.inl h)))
  · exact Or.inr (Or.inr ((WeierstrassCurve.Affine.Point.X_eq_iff (x₁ := x) (y₁ := y)
      (x₂ := parameter) (y₂ := 0)).mpr (Or.inl h)))

/-- The actual rational `2`-torsion set of the Legendre elliptic curve. -/
def legendreLevelTwoSet : Set (legendreWeierstrassCurve parameter).toAffine.Point :=
  {P | (2 : Nat) • P = 0}

/-- The four explicit points of the Legendre `2`-torsion. -/
def legendreLevelTwoFinset : Finset (legendreWeierstrassCurve parameter).toAffine.Point :=
  {0, legendreLevelTwoPointRootZero parameter, legendreLevelTwoPointRootOne parameter,
    legendreLevelTwoPointRootParameter parameter}

theorem legendreLevelTwoSet_eq :
    legendreLevelTwoSet parameter = ↑(legendreLevelTwoFinset parameter) := by
  ext P
  simp only [legendreLevelTwoSet, Set.mem_setOf_eq, Finset.mem_coe, legendreLevelTwoFinset,
    Finset.mem_insert, Finset.mem_singleton]
  constructor
  · exact legendreLevelTwo_eq_zero_or_root parameter P
  · rintro (rfl | rfl | rfl | rfl)
    · simp
    · exact legendreLevelTwoPointRootZero_two_nsmul parameter
    · exact legendreLevelTwoPointRootOne_two_nsmul parameter
    · exact legendreLevelTwoPointRootParameter_two_nsmul parameter

theorem legendreLevelTwoFinset_card : (legendreLevelTwoFinset parameter).card = 4 := by
  have hZeroNotMem : (0 : (legendreWeierstrassCurve parameter).toAffine.Point) ∉
      ({legendreLevelTwoPointRootZero parameter, legendreLevelTwoPointRootOne parameter,
        legendreLevelTwoPointRootParameter parameter} : Finset _) := by
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
    exact ⟨(legendreLevelTwoPointRootZero_ne_zero parameter).symm,
      (legendreLevelTwoPointRootOne_ne_zero parameter).symm,
      (legendreLevelTwoPointRootParameter_ne_zero parameter).symm⟩
  have hRootZeroNotMem : legendreLevelTwoPointRootZero parameter ∉
      ({legendreLevelTwoPointRootOne parameter,
        legendreLevelTwoPointRootParameter parameter} : Finset _) := by
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
    exact ⟨legendreLevelTwoPointRootZero_ne_rootOne parameter,
      legendreLevelTwoPointRootZero_ne_rootParameter parameter⟩
  have hRootOneNotMem : legendreLevelTwoPointRootOne parameter ∉
      ({legendreLevelTwoPointRootParameter parameter} : Finset _) := by
    simp only [Finset.mem_singleton]
    exact legendreLevelTwoPointRootOne_ne_rootParameter parameter
  rw [legendreLevelTwoFinset, Finset.card_insert_of_notMem hZeroNotMem,
    Finset.card_insert_of_notMem hRootZeroNotMem, Finset.card_insert_of_notMem hRootOneNotMem,
    Finset.card_singleton]

theorem legendreLevelTwoSet_ncard : (legendreLevelTwoSet parameter).ncard = 4 := by
  rw [legendreLevelTwoSet_eq parameter, Set.ncard_coe_finset]
  exact legendreLevelTwoFinset_card parameter

/-- The `2`-torsion subgroup of the Legendre elliptic curve, as an additive
subgroup of its point group. -/
def legendreLevelTwoTorsionSubgroup :
    AddSubgroup (legendreWeierstrassCurve parameter).toAffine.Point where
  carrier := legendreLevelTwoSet parameter
  zero_mem' := by
    change (2 : Nat) • (0 : (legendreWeierstrassCurve parameter).toAffine.Point) = 0
    simp
  add_mem' := by
    intro P Q hP hQ
    change (2 : Nat) • (P + Q) = 0
    have hP' : (2 : Nat) • P = 0 := hP
    have hQ' : (2 : Nat) • Q = 0 := hQ
    rw [nsmul_add, hP', hQ', add_zero]
  neg_mem' := by
    intro P hP
    change (2 : Nat) • (-P) = 0
    have hP' : (2 : Nat) • P = 0 := hP
    rw [smul_neg, hP', neg_zero]

set_option linter.unusedSectionVars false in
theorem legendreLevelTwoTorsionSubgroup_coe :
    (↑(legendreLevelTwoTorsionSubgroup parameter) :
        Set (legendreWeierstrassCurve parameter).toAffine.Point) =
      legendreLevelTwoSet parameter := rfl

theorem legendreLevelTwoTorsionSubgroup_ncard :
    (↑(legendreLevelTwoTorsionSubgroup parameter) :
        Set (legendreWeierstrassCurve parameter).toAffine.Point).ncard = 4 := by
  rw [legendreLevelTwoTorsionSubgroup_coe parameter]
  exact legendreLevelTwoSet_ncard parameter

/-- The Legendre `2`-torsion subgroup is generated by the three displayed
branch points. -/
theorem legendreLevelTwoTorsionSubgroup_eq_closure :
    legendreLevelTwoTorsionSubgroup parameter =
      AddSubgroup.closure ({legendreLevelTwoPointRootZero parameter,
        legendreLevelTwoPointRootOne parameter,
        legendreLevelTwoPointRootParameter parameter} :
          Set (legendreWeierstrassCurve parameter).toAffine.Point) := by
  apply le_antisymm
  · intro P hP
    have hP' : (2 : Nat) • P = 0 := hP
    rcases legendreLevelTwo_eq_zero_or_root parameter P hP' with rfl | rfl | rfl | rfl
    · exact AddSubgroup.zero_mem _
    · exact AddSubgroup.subset_closure (by simp)
    · exact AddSubgroup.subset_closure (by simp)
    · exact AddSubgroup.subset_closure (by simp)
  · rw [AddSubgroup.closure_le]
    intro P hP
    have hP' : P = legendreLevelTwoPointRootZero parameter ∨
        P = legendreLevelTwoPointRootOne parameter ∨
          P = legendreLevelTwoPointRootParameter parameter := by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hP
    rcases hP' with rfl | rfl | rfl
    · exact legendreLevelTwoPointRootZero_two_nsmul parameter
    · exact legendreLevelTwoPointRootOne_two_nsmul parameter
    · exact legendreLevelTwoPointRootParameter_two_nsmul parameter

end LevelTwoTorsionStructure

section QuadraticExtensionParameterization

variable {K : Type u} [Field K]

/-- Square-root parameterization of the first ordered root difference
`parameter - 0 = parameter` of the level-`2` triple: a square root lies in the
common Legendre parameter field. -/
theorem legendreLevelTwoParameterField_sqrt_parameterDifference (parameter : K) :
    ∃ s : legendreParameterField K parameter,
      s ^ 2 = algebraMap K (legendreParameterField K parameter)
        (legendreLevelTwoRoots parameter 2 - legendreLevelTwoRoots parameter 0) :=
  ⟨legendreSqrtParameter K parameter, by
    rw [legendreLevelTwoRoots_two, legendreLevelTwoRoots_zero, sub_zero]
    exact legendreSqrtParameter_sq K parameter⟩

/-- Square-root parameterization of the ordered root difference
`1 - parameter` of the level-`2` triple: a square root lies in the common
Legendre parameter field. -/
theorem legendreLevelTwoParameterField_sqrt_complementDifference (parameter : K) :
    ∃ s : legendreParameterField K parameter,
      s ^ 2 = algebraMap K (legendreParameterField K parameter)
        (legendreLevelTwoRoots parameter 1 - legendreLevelTwoRoots parameter 2) :=
  ⟨legendreSqrtComplement K parameter, by
    rw [legendreLevelTwoRoots_one, legendreLevelTwoRoots_two]
    simpa only [map_sub, map_one] using legendreSqrtComplement_sq K parameter⟩

/-- Fiber statement for the quadratic-extension parameterization: when the
base field already contains square roots of `-1` and of the parameter, only
the complementary square root remains, so the parameter field has degree at
most two over the base. -/
theorem legendreParameterField_finrank_le_two_of_sqrt_neg_one_and_sqrt_parameter
    (parameter : K) (sqrt_neg_one_in_base : ∃ i : K, i ^ 2 = -1)
    (sqrt_parameter_in_base : ∃ s : K, s ^ 2 = parameter) :
    Module.finrank K (legendreParameterField K parameter) ≤ 2 := by
  unfold legendreParameterField
  rw [squareRootField_eq_bot_of_isSquare K (-1) sqrt_neg_one_in_base,
    squareRootField_eq_bot_of_isSquare K parameter sqrt_parameter_in_base,
    bot_sup_eq, bot_sup_eq]
  exact squareRootField_finrank_le_two K (1 - parameter)

end QuadraticExtensionParameterization

end LeanFormal.IUT

import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Finite fields of definition for an algebraic Tate parameter

The constructions in this file require fields and algebraicity only.
-/

namespace IUT.TateFiniteParameterField

universe uK uOmega

variable (K : Type uK) {Ω : Type uOmega} [Field K] [Field Ω] [Algebra K Ω]

/-- The intermediate field generated by the algebraic parameter. -/
abbrev parameterField (u : Ω) : IntermediateField K Ω :=
  IntermediateField.adjoin K {u}

/-- The canonical representative of the parameter in its generated field. -/
def parameterElement (u : Ω) : parameterField K u :=
  ⟨u, IntermediateField.mem_adjoin_simple_self K u⟩

/-- The canonical representative of a base-field parameter. -/
def baseParameter (u : Ω) (q : K) : parameterField K u :=
  algebraMap K (parameterField K u) q

@[simp] theorem parameterElement_coe (u : Ω) :
    (parameterElement K u : Ω) = u := rfl

@[simp] theorem baseParameter_coe (u : Ω) (q : K) :
    (baseParameter K u q : Ω) = algebraMap K Ω q := rfl

/-- An algebraic parameter generates a finite-dimensional extension. -/
theorem finiteDimensional_parameterField (u : Ω) (hu : IsAlgebraic K u) :
    FiniteDimensional K (parameterField K u) :=
  IntermediateField.adjoin.finiteDimensional hu.isIntegral

/-- Every intermediate field containing the parameter contains its generated field. -/
theorem parameterField_le (u : Ω) (L : IntermediateField K Ω) (hu : u ∈ L) :
    parameterField K u ≤ L := by
  apply IntermediateField.adjoin_le_iff.mpr
  intro x hx
  have hxu : x = u := Set.mem_singleton_iff.mp hx
  subst x
  exact hu

/-- The canonical inclusion into any intermediate field containing the parameter. -/
def parameterFieldInclusion (u : Ω) (L : IntermediateField K Ω) (hu : u ∈ L) :
    parameterField K u →ₐ[K] L :=
  IntermediateField.inclusion (parameterField_le K u L hu)

/-- The inclusion fixes every element of the base field. -/
@[simp] theorem parameterFieldInclusion_algebraMap
    (u : Ω) (L : IntermediateField K Ω) (hu : u ∈ L) (a : K) :
    parameterFieldInclusion K u L hu (algebraMap K (parameterField K u) a) =
      algebraMap K L a :=
  (parameterFieldInclusion K u L hu).commutes a

/-- The inclusion agrees with the ambient embedding. -/
@[simp] theorem parameterFieldInclusion_coe
    (u : Ω) (L : IntermediateField K Ω) (hu : u ∈ L)
    (x : parameterField K u) :
    (parameterFieldInclusion K u L hu x : Ω) = (x : Ω) := rfl

/-- A nonzero base-field parameter remains nonzero in the generated field. -/
theorem baseParameter_ne_zero (u : Ω) (q : K) (hq : q ≠ 0) :
    baseParameter K u q ≠ 0 :=
  (map_ne_zero (algebraMap K (parameterField K u))).mpr hq

/-- The canonical representative is nonzero when the ambient parameter is nonzero. -/
theorem parameterElement_ne_zero (u : Ω) (hu : u ≠ 0) :
    parameterElement K u ≠ 0 := by
  intro hzero
  exact hu (congrArg (fun x : parameterField K u => (x : Ω)) hzero)

/-- Absence of poles descends to the canonical representatives for every integer exponent. -/
theorem parameterElement_no_poles (u : Ω) (q : K)
    (havoid : ∀ n : ℤ, (algebraMap K Ω q) ^ n * u ≠ 1) :
    ∀ n : ℤ, baseParameter K u q ^ n * parameterElement K u ≠ 1 := by
  intro n hpole
  apply havoid n
  have himage := congrArg (parameterField K u).val hpole
  have hbase : (parameterField K u).val (baseParameter K u q) = algebraMap K Ω q := rfl
  have hparameter : (parameterField K u).val (parameterElement K u) = u := rfl
  simpa only [map_mul, map_zpow₀, map_one, hbase, hparameter] using himage

/-- The finite parameter field preserves the nonzero and no-pole conditions. -/
theorem finiteParameterField_conditions
    (u : Ω) (hu : IsAlgebraic K u) (q : K) (hq : q ≠ 0) (hu0 : u ≠ 0)
    (havoid : ∀ n : ℤ, (algebraMap K Ω q) ^ n * u ≠ 1) :
    FiniteDimensional K (parameterField K u) ∧
      baseParameter K u q ≠ 0 ∧ parameterElement K u ≠ 0 ∧
      ∀ n : ℤ, baseParameter K u q ^ n * parameterElement K u ≠ 1 :=
  ⟨finiteDimensional_parameterField K u hu, baseParameter_ne_zero K u q hq,
    parameterElement_ne_zero K u hu0, parameterElement_no_poles K u q havoid⟩

end IUT.TateFiniteParameterField

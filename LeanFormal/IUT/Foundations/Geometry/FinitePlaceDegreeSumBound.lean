import LeanFormal.IUT.Foundations.NumberField.FinitePlaces
import Mathlib.NumberTheory.RamificationInertia.Basic
import Mathlib.RingTheory.RamificationInertia.Ramification
import Mathlib.RingTheory.RamificationInertia.Inertia
import Mathlib.Data.Nat.Prime.Int

/-!
# Degree sums over the fiber of a rational prime

Port note: the statements below are ported from the LANA Project development
(released under the Apache 2.0 license, `Authors: LANA Project`), file
`Iut/Tripod/TwoAdic.lean` lines 110-181: `localDeg_eq_ramificationIdx'_mul_inertiaDeg'`,
`sum_localDeg_filter_le` and `sum_inertDeg_filter_le`, together with the supporting
notions `ramIdx` / `inertDeg` / `localDeg` of `Iut/Concrete/LocalTheory.lean:38-46`
and `under_int_eq` of `Iut/Concrete/ThetaLocalConstruct/Ordp.lean:41`. The statements
are restated in this repository's finite-place conventions (`residueCharacteristic`
of `Foundations/NumberField/FinitePlaces.lean`, with the same definition as the source
`residueChar`); the proofs are written independently against the current Mathlib API.

For a number field `K`, a finite place `w` with residue characteristic `q` has local
degree `[K_w : Q_q] = e_w * f_w`, where `e_w` is the ramification index and `f_w` the
residue degree of `w` over `(q)` (Mathlib's `Ideal.ramificationIdx` and
`Ideal.inertiaDeg`, the type-based interfaces). The two main results bound
`sum_{w in S, p_w = q} [K_w : Q_q]` and `sum_{w in S, p_w = q} f_w` by the global
degree `[K : Q]` for every finite set `S` of places: the filtered set maps into the
full fiber of `q`, whose `e * f` sum is Mathlib's `Ideal.sum_ramification_inertia`.
-/

namespace LeanFormal.IUT

namespace NumberFieldFinitePlace

universe u

variable {K : Type u} [Field K] [NumberField K]

/-- The prime of `Z` below a finite place is generated by its residue characteristic.
Port of `under_int_eq` (`Iut/Concrete/ThetaLocalConstruct/Ordp.lean:41`). -/
theorem under_eq_span_residueCharacteristic (place : NumberField.FinitePlace K) :
    place.maximalIdeal.asIdeal.under ℤ =
      Ideal.span {(residueCharacteristic place : ℤ)} := by
  have hprime : Nat.Prime (residueCharacteristic place) :=
    residueCharacteristic_prime place
  have hmem : (residueCharacteristic place : ℤ) ∈ place.maximalIdeal.asIdeal.under ℤ := by
    haveI : CharP (NumberField.RingOfIntegers K ⧸ place.maximalIdeal.asIdeal)
        (residueCharacteristic place) :=
      ringChar.charP _
    rw [Ideal.under_def, Ideal.mem_comap]
    exact_mod_cast Ideal.natCast_mem_of_charP_quotient (residueCharacteristic place)
      place.maximalIdeal.asIdeal
  have hspan_le : Ideal.span {(residueCharacteristic place : ℤ)} ≤
      place.maximalIdeal.asIdeal.under ℤ := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hmem
  haveI hspan_prime : (Ideal.span {(residueCharacteristic place : ℤ)}).IsPrime :=
    (Ideal.span_singleton_prime (by exact_mod_cast hprime.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hprime)
  have hmax : (Ideal.span {(residueCharacteristic place : ℤ)}).IsMaximal :=
    IsPrime.to_maximal_ideal (by
      rw [ne_eq, Ideal.span_singleton_eq_bot]
      exact_mod_cast hprime.ne_zero)
  haveI : (place.maximalIdeal.asIdeal.under ℤ).IsPrime := Ideal.comap_isPrime _ _
  exact (hmax.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hspan_le).symm

/-- The ramification index `e_w` of a finite place over its residue characteristic.
Port of `ramIdx` (`Iut/Concrete/LocalTheory.lean:38`). -/
noncomputable def residueRamificationIndex (place : NumberField.FinitePlace K) : ℕ :=
  place.maximalIdeal.asIdeal.ramificationIdx ℤ

/-- The residue degree `f_w` of a finite place over its residue characteristic.
Port of `inertDeg` (`Iut/Concrete/LocalTheory.lean:42`). -/
noncomputable def residueInertiaDegree (place : NumberField.FinitePlace K) : ℕ :=
  place.maximalIdeal.asIdeal.inertiaDeg ℤ

/-- The local degree `[K_w : Q_q] = e_w * f_w` of a finite place over its residue
characteristic. Port of `localDeg` (`Iut/Concrete/LocalTheory.lean:46`). -/
noncomputable def residueLocalDegree (place : NumberField.FinitePlace K) : ℕ :=
  residueRamificationIndex place * residueInertiaDegree place

/-- `e_w > 0`. Port of `ramIdx_pos'`
(`Iut/Concrete/ThetaLocalConstruct/Ordp.lean:94`). -/
theorem residueRamificationIndex_pos (place : NumberField.FinitePlace K) :
    0 < residueRamificationIndex place :=
  Ideal.ramificationIdx_pos place.maximalIdeal.asIdeal ℤ

/-- The local degree computes the primed ramification index and inertia degree at the
prime generated by the residue characteristic. Port of
`localDeg_eq_ramificationIdx'_mul_inertiaDeg'` (`Iut/Tripod/TwoAdic.lean:110`). -/
theorem residueLocalDegree_eq_ramificationIdx'_mul_inertiaDeg'
    (place : NumberField.FinitePlace K) {q : ℕ} (hq : residueCharacteristic place = q) :
    residueLocalDegree place =
      (Ideal.span {(q : ℤ)}).ramificationIdx' place.maximalIdeal.asIdeal *
        (Ideal.span {(q : ℤ)}).inertiaDeg' place.maximalIdeal.asIdeal := by
  subst hq
  have hspan0 : Ideal.span {(residueCharacteristic place : ℤ)} ≠ ⊥ := by
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact_mod_cast (residueCharacteristic_prime place).ne_zero
  haveI hspan_prime : (Ideal.span {(residueCharacteristic place : ℤ)}).IsPrime :=
    (Ideal.span_singleton_prime (by exact_mod_cast (residueCharacteristic_prime place).ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp (residueCharacteristic_prime place))
  haveI hspan_max : (Ideal.span {(residueCharacteristic place : ℤ)}).IsMaximal :=
    IsPrime.to_maximal_ideal hspan0
  haveI hlies : place.maximalIdeal.asIdeal.LiesOver
      (Ideal.span {(residueCharacteristic place : ℤ)}) :=
    ⟨(under_eq_span_residueCharacteristic place).symm⟩
  rw [residueLocalDegree, residueRamificationIndex, residueInertiaDegree,
    ← Ideal.ramificationIdx'_eq_ramificationIdx
      (p := Ideal.span {(residueCharacteristic place : ℤ)})
      (q := place.maximalIdeal.asIdeal) hspan0,
    ← Ideal.inertiaDeg'_eq_inertiaDeg
      (p := Ideal.span {(residueCharacteristic place : ℤ)})
      (q := place.maximalIdeal.asIdeal)]

/-- **`sum_{w in S, p_w = q} [K_w : Q_q] <= [K : Q]`** for every finite set `S` of places
of `K`. Port of `sum_localDeg_filter_le` (`Iut/Tripod/TwoAdic.lean:124`). -/
theorem sum_residueLocalDegree_filter_le (S : Finset (NumberField.FinitePlace K)) (q : ℕ) :
    ∑ w ∈ S.filter (fun w => residueCharacteristic w = q), residueLocalDegree w ≤
      Module.finrank ℚ K := by
  classical
  by_cases hq : q.Prime
  · set p : Ideal ℤ := Ideal.span {(q : ℤ)} with hp
    have hp0 : p ≠ ⊥ := by
      rw [hp, ne_eq, Ideal.span_singleton_eq_bot]
      exact_mod_cast hq.ne_zero
    haveI hpmax : p.IsMaximal := by
      haveI hqprime : (Ideal.span {(q : ℤ)}).IsPrime :=
        (Ideal.span_singleton_prime (by exact_mod_cast hq.ne_zero)).mpr
          (Nat.prime_iff_prime_int.mp hq)
      rw [hp]
      exact IsPrime.to_maximal_ideal
        (by
          rw [ne_eq, Ideal.span_singleton_eq_bot]
          exact_mod_cast hq.ne_zero)
    have hsum : (∑ P ∈ IsDedekindDomain.primesOverFinset p (NumberField.RingOfIntegers K),
        p.ramificationIdx' P * p.inertiaDeg' P) = Module.finrank ℚ K :=
      Ideal.sum_ramification_inertia (S := NumberField.RingOfIntegers K) (K := ℚ) (L := K)
        (p := p) hp0
    set T : Finset (NumberField.FinitePlace K) := S.filter (fun w => residueCharacteristic w = q)
      with hT
    have hmem : ∀ w ∈ T, w.maximalIdeal.asIdeal ∈
        IsDedekindDomain.primesOverFinset p (NumberField.RingOfIntegers K) := by
      intro w hw
      rw [hT] at hw
      have hwq : residueCharacteristic w = q := (Finset.mem_filter.mp hw).2
      refine (IsDedekindDomain.mem_primesOverFinset_iff hp0 (NumberField.RingOfIntegers K)).mpr
        ⟨w.maximalIdeal.isPrime, ⟨?_⟩⟩
      rw [hp, ← hwq]
      exact (under_eq_span_residueCharacteristic w).symm
    have hinj : Set.InjOn (fun w : NumberField.FinitePlace K => w.maximalIdeal.asIdeal) ↑T := by
      intro w1 _ w2 _ h
      exact NumberField.FinitePlace.maximalIdeal_injective
        (IsDedekindDomain.HeightOneSpectrum.ext h)
    calc ∑ w ∈ T, residueLocalDegree w
        = ∑ w ∈ T, p.ramificationIdx' w.maximalIdeal.asIdeal *
            p.inertiaDeg' w.maximalIdeal.asIdeal := by
          refine Finset.sum_congr rfl fun w hw => ?_
          rw [hT] at hw
          exact residueLocalDegree_eq_ramificationIdx'_mul_inertiaDeg' w
            (Finset.mem_filter.mp hw).2
      _ = ∑ P ∈ T.image (fun w : NumberField.FinitePlace K => w.maximalIdeal.asIdeal),
            p.ramificationIdx' P * p.inertiaDeg' P :=
          (Finset.sum_image (s := T)
            (f := fun P => p.ramificationIdx' P * p.inertiaDeg' P)
            (g := fun w : NumberField.FinitePlace K => w.maximalIdeal.asIdeal) hinj).symm
      _ ≤ ∑ P ∈ IsDedekindDomain.primesOverFinset p (NumberField.RingOfIntegers K),
            p.ramificationIdx' P * p.inertiaDeg' P := by
          refine Finset.sum_le_sum_of_subset fun P hP => ?_
          rw [Finset.mem_image] at hP
          obtain ⟨w, hw, rfl⟩ := hP
          exact hmem w hw
      _ = Module.finrank ℚ K := hsum
  · have hzero : ∀ w ∈ S.filter (fun w => residueCharacteristic w = q),
        residueLocalDegree w = 0 := by
      intro w hw
      exact absurd (residueCharacteristic_prime w)
        (by rw [(Finset.mem_filter.mp hw).2]; exact hq)
    rw [Finset.sum_eq_zero hzero]
    exact Nat.zero_le _

/-- **`sum_{w in S, p_w = q} f_w <= [K : Q]`** for every finite set `S` of places of `K`.
Port of `sum_inertDeg_filter_le` (`Iut/Tripod/TwoAdic.lean:169`). -/
theorem sum_residueInertiaDegree_filter_le (S : Finset (NumberField.FinitePlace K)) (q : ℕ) :
    ∑ w ∈ S.filter (fun w => residueCharacteristic w = q), residueInertiaDegree w ≤
      Module.finrank ℚ K := by
  refine (Finset.sum_le_sum fun w _ => ?_).trans (sum_residueLocalDegree_filter_le S q)
  exact Nat.le_mul_of_pos_left (residueInertiaDegree w) (residueRamificationIndex_pos w)

end NumberFieldFinitePlace

end LeanFormal.IUT

/-
  The point-valued Tate uniformization map.

  `TateWeierstrassPointEquation` fixed the candidate pair `(X, Y)` of the Tate
  parametrisation and reduced the affine Weierstrass equation of the canonical
  `q`-series curve to the explicit named hypothesis `tateWeierstrassEquation`, with the
  nonsingularity input decomposed as `tateWeierstrassPointNonsingular_iff`.

  This file builds the point map on top of that interface.

  * It proves that the pole-excluded parameter domain `coordinateParameterDomain q` is
    stable under the `ℤ`-scaling `u ↦ q^m u`, that this scaling is an equivalence
    relation on the domain, and it forms the honest carrier
    `TateParameterQuotient q hq` of the quotient.

  * It defines the `X`- and `Y`-coordinate functions on that quotient
    (`tateQuotientX`, `tateQuotientY`) **unconditionally**: well-definedness is exactly
    the proved `ℤ`-periodicity of the series, and needs neither summability hypotheses
    nor the Weierstrass equation.

  * Given the named point data `TateWeierstrassPointData q` (nonsingularity of the
    series pair on the domain, whose relation to the equation is
    `tateWeierstrassPointNonsingular_iff`), it defines the point-valued map
    `tateQuotientPoint : TateParameterQuotient q hq → (weierstrassCurve K q).toAffine.Point`
    and proves that it is `q^ℤ`-periodic, i.e. constant on the orbits, and that its
    values are never the point at infinity.

  Not claimed: the full uniformization theorem.  The map is not shown to be injective or
  surjective, and no group law or group isomorphism `K* / q^ℤ ≅ E(K)` is constructed.
  The precise remaining statement is recorded as `TateUniformizationPointMapGap`.
-/

import LeanFormal.IUT.Foundations.Geometry.TateWeierstrassPointEquation
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.Tactic

namespace LeanFormal.IUT.TateCurve

universe u

noncomputable section

open WeierstrassCurve

/-! ## The `ℤ`-scaling action on the pole-excluded domain -/

/-- The full `ℤ`-orbit of a pole-excluded parameter consists again of pole-excluded
parameters.  This generalises the `m = 1` statement
`coordinateParameterDomain_mul_parameter_iff` of `TateCoordinateSeries`. -/
theorem coordinateParameterDomain_zpow_mul_parameter {K : Type*} [Field K] {q : K}
    (parameterNeZero : q ≠ 0) (m : ℤ) (u : K) :
    q ^ m * u ∈ coordinateParameterDomain q ↔ u ∈ coordinateParameterDomain q := by
  have hpowNeZero : q ^ m ≠ 0 := zpow_ne_zero m parameterNeZero
  constructor
  · rintro ⟨hne, hpole⟩
    refine ⟨fun hzero => hne (by rw [hzero, mul_zero]), fun n => ?_⟩
    have h := hpole (n - m)
    rwa [← mul_assoc, ← zpow_add₀ parameterNeZero, sub_add_cancel] at h
  · rintro ⟨hne, hpole⟩
    refine ⟨mul_ne_zero hpowNeZero hne, fun n => ?_⟩
    rw [← mul_assoc, ← zpow_add₀ parameterNeZero]
    exact hpole (n + m)

/-- The `ℤ`-scaling `u ↦ q^m u` as a self-map of the pole-excluded parameter domain. -/
def tateParameterOrbit {K : Type*} [Field K] {q : K} (parameterNeZero : q ≠ 0)
    (m : ℤ) (u : ↥(coordinateParameterDomain q)) : ↥(coordinateParameterDomain q) :=
  ⟨q ^ m * (u : K),
    (coordinateParameterDomain_zpow_mul_parameter parameterNeZero m (u : K)).mpr u.2⟩

/-! ## The orbit relation and its quotient -/

/-- Two pole-excluded parameters lie in the same `q^ℤ`-orbit. -/
def tateParameterOrbitRel {K : Type*} [Field K] (q : K)
    (u v : ↥(coordinateParameterDomain q)) : Prop :=
  ∃ m : ℤ, q ^ m * (u : K) = (v : K)

theorem tateParameterOrbitRel_refl {K : Type*} [Field K] {q : K}
    (u : ↥(coordinateParameterDomain q)) :
    tateParameterOrbitRel q u u :=
  ⟨0, by simp⟩

theorem tateParameterOrbitRel_symm {K : Type*} [Field K] {q : K}
    (parameterNeZero : q ≠ 0) {u v : ↥(coordinateParameterDomain q)}
    (h : tateParameterOrbitRel q u v) : tateParameterOrbitRel q v u := by
  obtain ⟨m, hm⟩ := h
  refine ⟨-m, ?_⟩
  rw [← hm, ← mul_assoc, ← zpow_add₀ parameterNeZero, neg_add_cancel, zpow_zero, one_mul]

theorem tateParameterOrbitRel_trans {K : Type*} [Field K] {q : K}
    (parameterNeZero : q ≠ 0) {u v w : ↥(coordinateParameterDomain q)}
    (huv : tateParameterOrbitRel q u v) (hvw : tateParameterOrbitRel q v w) :
    tateParameterOrbitRel q u w := by
  obtain ⟨m, hm⟩ := huv
  obtain ⟨n, hn⟩ := hvw
  refine ⟨n + m, ?_⟩
  rw [zpow_add₀ parameterNeZero, mul_assoc, hm, hn]

/-- The relation generated by the `q^ℤ`-scaling on the pole-excluded domain is an
equivalence relation. -/
def tateParameterSetoid {K : Type*} [Field K] (q : K) (parameterNeZero : q ≠ 0) :
    Setoid ↥(coordinateParameterDomain q) where
  r := tateParameterOrbitRel q
  iseqv :=
    { refl := fun u => tateParameterOrbitRel_refl u
      symm := fun h => tateParameterOrbitRel_symm parameterNeZero h
      trans := fun h₁ h₂ => tateParameterOrbitRel_trans parameterNeZero h₁ h₂ }

/-- The honest carrier of the domain of the Tate point map: the pole-excluded parameters
modulo the `q^ℤ`-orbit.  The pole condition removes exactly the orbit of `1`, so this is
`K* / q^ℤ` with the class of `1` deleted. -/
def TateParameterQuotient {K : Type u} [Field K] (q : K) (parameterNeZero : q ≠ 0) :
    Type u :=
  Quotient (tateParameterSetoid q parameterNeZero)

/-- The orbit map is trivial in the quotient: `q^ℤ`-scaling does not change the class.
This is the quotient-level form of the `ℤ`-period of the coordinates. -/
theorem tateParameterQuotient_mk_orbit {K : Type*} [NormedField K] {q : K}
    (parameterNeZero : q ≠ 0) (m : ℤ) (u : ↥(coordinateParameterDomain q)) :
    (Quotient.mk _ (tateParameterOrbit parameterNeZero m u) :
        TateParameterQuotient q parameterNeZero) =
      Quotient.mk _ u := by
  apply Quotient.sound
  refine ⟨-m, ?_⟩
  change q ^ (-m) * (q ^ m * (u : K)) = (u : K)
  rw [← mul_assoc, ← zpow_add₀ parameterNeZero, neg_add_cancel, zpow_zero, one_mul]

/-! ## Well-definedness of the coordinates on the quotient -/

/-- Well-definedness of the `X`-coordinate on orbits, at the raw `K` level.  This is
exactly the proved `ℤ`-periodicity and requires no summability hypothesis. -/
theorem tateWeierstrassX_eq_of_orbitRel {K : Type*} [NormedField K] {q u v : K}
    (parameterNeZero : q ≠ 0) (h : ∃ m : ℤ, q ^ m * u = v) :
    tateWeierstrassX q u = tateWeierstrassX q v := by
  obtain ⟨m, hm⟩ := h
  rw [← hm, tateWeierstrassX_zpow_mul_parameter parameterNeZero m u]

/-- Well-definedness of the `Y`-coordinate on orbits, at the raw `K` level. -/
theorem tateWeierstrassY_eq_of_orbitRel {K : Type*} [NormedField K] {q u v : K}
    (parameterNeZero : q ≠ 0) (h : ∃ m : ℤ, q ^ m * u = v) :
    tateWeierstrassY q u = tateWeierstrassY q v := by
  obtain ⟨m, hm⟩ := h
  rw [← hm, tateWeierstrassY_zpow_mul_parameter parameterNeZero m u]

/-- The `X`-coordinate as a function on the orbit quotient.  Unconditional: only the
periodicity of `coordinateSeries` is used. -/
noncomputable def tateQuotientX {K : Type*} [NormedField K] (q : K)
    (parameterNeZero : q ≠ 0) : TateParameterQuotient q parameterNeZero → K :=
  Quotient.lift (fun u => tateWeierstrassX q (u : K)) (by
    intro u v huv
    obtain ⟨m, hm⟩ := huv
    rw [← hm, tateWeierstrassX_zpow_mul_parameter parameterNeZero m (u : K)])

/-- The `Y`-coordinate as a function on the orbit quotient.  Unconditional. -/
noncomputable def tateQuotientY {K : Type*} [NormedField K] (q : K)
    (parameterNeZero : q ≠ 0) : TateParameterQuotient q parameterNeZero → K :=
  Quotient.lift (fun u => tateWeierstrassY q (u : K)) (by
    intro u v huv
    obtain ⟨m, hm⟩ := huv
    rw [← hm, tateWeierstrassY_zpow_mul_parameter parameterNeZero m (u : K)])

/-- Value of `tateQuotientX` on a representative. -/
theorem tateQuotientX_mk {K : Type*} [NormedField K] {q : K} (parameterNeZero : q ≠ 0)
    (u : ↥(coordinateParameterDomain q)) :
    tateQuotientX q parameterNeZero (Quotient.mk _ u) = tateWeierstrassX q (u : K) :=
  rfl

/-- Value of `tateQuotientY` on a representative. -/
theorem tateQuotientY_mk {K : Type*} [NormedField K] {q : K} (parameterNeZero : q ≠ 0)
    (u : ↥(coordinateParameterDomain q)) :
    tateQuotientY q parameterNeZero (Quotient.mk _ u) = tateWeierstrassY q (u : K) :=
  rfl

/-! ## The point-valued map -/

/-- The nonsingularity data of the series pair over the whole pole-excluded parameter
domain.  This is the explicit point-valued input of the uniformization map; by
`tateWeierstrassPointNonsingular_iff` it is exactly "the equation holds and a partial
derivative does not vanish", and the equation part is the named hypothesis
`tateWeierstrassEquation`. -/
def TateWeierstrassPointData {K : Type*} [NormedField K] [CharZero K] (q : K) : Prop :=
  ∀ u : ↥(coordinateParameterDomain q),
    (weierstrassCurve K q).toAffine.Nonsingular
      (tateWeierstrassX q (u : K)) (tateWeierstrassY q (u : K))

/-- The point map on the pole-excluded domain, from the point data. -/
def tateDomainPoint {K : Type*} [NormedField K] [CharZero K] {q : K}
    (hdata : TateWeierstrassPointData q) (u : ↥(coordinateParameterDomain q)) :
    (weierstrassCurve K q).toAffine.Point :=
  tateWeierstrassPointAt q (u : K) (hdata u)

/-- The point-valued Tate uniformization map on the orbit quotient.  Well-definedness is
proved from the `ℤ`-periodicity of both coordinates; the analytic input is isolated in
the point data `hdata`. -/
noncomputable def tateQuotientPoint {K : Type*} [NormedField K] [CharZero K] (q : K)
    (parameterNeZero : q ≠ 0) (hdata : TateWeierstrassPointData q) :
    TateParameterQuotient q parameterNeZero → (weierstrassCurve K q).toAffine.Point :=
  Quotient.lift (fun u => tateDomainPoint hdata u) (by
    intro u v huv
    obtain ⟨m, hm⟩ := huv
    change WeierstrassCurve.Affine.Point.some (tateWeierstrassX q (u : K))
        (tateWeierstrassY q (u : K)) (hdata u) =
      WeierstrassCurve.Affine.Point.some (tateWeierstrassX q (v : K))
        (tateWeierstrassY q (v : K)) (hdata v)
    rw [WeierstrassCurve.Affine.Point.some.injEq]
    constructor
    · rw [← hm, tateWeierstrassX_zpow_mul_parameter parameterNeZero m (u : K)]
    · rw [← hm, tateWeierstrassY_zpow_mul_parameter parameterNeZero m (u : K)])

/-- Value of `tateQuotientPoint` on a representative. -/
theorem tateQuotientPoint_mk {K : Type*} [NormedField K] [CharZero K] {q : K}
    (parameterNeZero : q ≠ 0) (hdata : TateWeierstrassPointData q)
    (u : ↥(coordinateParameterDomain q)) :
    tateQuotientPoint q parameterNeZero hdata (Quotient.mk _ u) = tateDomainPoint hdata u :=
  rfl

/-- `q^ℤ`-periodicity of the quotient point map, i.e. the map is constant on orbits:
this is the quotient-level periodicity statement requested of the point map. -/
theorem tateQuotientPoint_orbit {K : Type*} [NormedField K] [CharZero K] {q : K}
    (parameterNeZero : q ≠ 0) (hdata : TateWeierstrassPointData q)
    (m : ℤ) (u : ↥(coordinateParameterDomain q)) :
    tateQuotientPoint q parameterNeZero hdata
        (Quotient.mk _ (tateParameterOrbit parameterNeZero m u)) =
      tateQuotientPoint q parameterNeZero hdata (Quotient.mk _ u) := by
  rw [tateParameterQuotient_mk_orbit parameterNeZero m u]

/-- No value of the point map is the point at infinity: the parametrisation omits exactly
one point of the smooth model, as it must, since the pole condition removes the orbit of
`1`. -/
theorem tateQuotientPoint_ne_zero {K : Type*} [NormedField K] [CharZero K] {q : K}
    (parameterNeZero : q ≠ 0) (hdata : TateWeierstrassPointData q)
    (w : TateParameterQuotient q parameterNeZero) :
    tateQuotientPoint q parameterNeZero hdata w ≠ 0 := by
  refine Quotient.inductionOn w ?_
  intro u
  rw [tateQuotientPoint_mk]
  intro hzero
  change WeierstrassCurve.Affine.Point.some (tateWeierstrassX q (u : K))
    (tateWeierstrassY q (u : K)) (hdata u) = WeierstrassCurve.Affine.Point.zero at hzero
  cases hzero

/-! ## The precise remaining gap -/

/-- The exact statement of the point-valued Tate uniformization that is **not** proved
here: injectivity of the orbit-quotient point map, and surjectivity onto the nonzero
affine points of the canonical `q`-curve.  The remaining analytic input is the point data
`hdata` (whose equation part is `tateWeierstrassEquation`); the group law and the group
isomorphism `K* / q^ℤ ≅ E(K)` are not part of this statement and are not claimed. -/
def TateUniformizationPointMapGap {K : Type*} [NormedField K] [CharZero K] (q : K)
    (parameterNeZero : q ≠ 0) (hdata : TateWeierstrassPointData q) : Prop :=
  Function.Injective (tateQuotientPoint q parameterNeZero hdata) ∧
    ∀ P : (weierstrassCurve K q).toAffine.Point, P ≠ 0 →
      ∃ w : TateParameterQuotient q parameterNeZero,
        tateQuotientPoint q parameterNeZero hdata w = P

end

end LeanFormal.IUT.TateCurve

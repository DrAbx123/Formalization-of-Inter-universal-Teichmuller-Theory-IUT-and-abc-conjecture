/-
  Graded multiplication on the actual associated-graded subquotients.

  The previous file constructed the actual pieces m^n/m^{n+1}, their direct sum,
  initial forms and the initial-ideal candidate.  This file constructs the
  multiplication map from piece n and piece m to piece n + m by multiplication of
  representatives, proves its associativity and unit laws on representatives,
  packages the graded ring data, and realizes the initial ideal as generated by
  homogeneous initial forms.  The remaining Hilbert-Samuel leading-coefficient and
  geometric component multiplicity data are stated as exact residual.  No graded
  ring or multiplicity is fabricated.
-/
import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourcePsiAssociatedGradedConstruction

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option synthInstance.maxHeartbeats 1000000

noncomputable section

namespace LeanFormal.IUT.SourcePsiAssociatedGradedMultiplication

open LeanFormal.IUT Theorem311Source
open LeanFormal.IUT.SourcePsiActualSpecialFiber
open LeanFormal.IUT.SourcePsiComponentFiniteActual
open LeanFormal.IUT.SourcePsiComponentIntersectionGraph
open LeanFormal.IUT.SourcePsiNodeCuspMultiplicity
open LeanFormal.IUT.SourcePsiHilbertSamuelMultiplicity
open LeanFormal.IUT.SourcePsiAssociatedGradedActual
open LeanFormal.IUT.SourcePsiAssociatedGradedConstruction
open WeierstrassCurve

universe u

variable {l : PrimeGeFive} (S : SourceDefinition31Data l)
  (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers S.arithmetic.F))

/-- Candidate Jacobian prime. -/
abbrev SourcePsiAGMCandidatePrime : Type u :=
  SourcePsiAGCCandidatePrime S v

/-- Actual local ring. -/
abbrev SourcePsiAGMLocalRing (q : SourcePsiAGMCandidatePrime S v) : Type u :=
  SourcePsiAGCLocalRing S v q

/-- Actual maximal ideal. -/
abbrev SourcePsiAGMMaximalIdeal (q : SourcePsiAGMCandidatePrime S v) :
    Ideal (SourcePsiAGMLocalRing S v q) :=
  SourcePsiAGCMaximalIdeal S v q

/-- The actual graded piece m^n/m^{n+1}. -/
abbrev SourcePsiAGMPiece (q : SourcePsiAGMCandidatePrime S v) (n : ℕ) : Type u :=
  SourcePsiAGradedPiece S v q n

/-- The actual multiplication of representatives: for x in m^n and y in m^m,
their product lies in m^(n+m). -/
def SourcePsiAGMMulRep
    (q : SourcePsiAGMCandidatePrime S v) (n m : ℕ)
    (x : ↥(SourcePsiAGMMaximalIdeal S v q ^ n :
      Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
    (y : ↥(SourcePsiAGMMaximalIdeal S v q ^ m :
      Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q))) :
    SourcePsiAGMPiece S v q (n + m) :=
  Submodule.Quotient.mk
    (p := Submodule.comap
      (Submodule.subtype
        (SourcePsiAGMMaximalIdeal S v q ^ (n + m) :
          Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
      (SourcePsiAGMMaximalIdeal S v q ^ (n + m + 1) :
        Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
    ⟨(x : SourcePsiAGMLocalRing S v q) * (y : SourcePsiAGMLocalRing S v q), by
      exact Ideal.mul_mem_mul x.2 y.2⟩

/-- Source representative form of the multiplication map. -/
theorem SourcePsiAGMMulRep_eq
    (q : SourcePsiAGMCandidatePrime S v) (n m : ℕ)
    (x : ↥(SourcePsiAGMMaximalIdeal S v q ^ n :
      Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
    (y : ↥(SourcePsiAGMMaximalIdeal S v q ^ m :
      Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q))) :
    SourcePsiAGMMulRep S v q n m x y =
      Submodule.Quotient.mk
        (p := Submodule.comap
          (Submodule.subtype
            (SourcePsiAGMMaximalIdeal S v q ^ (n + m) :
              Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
          (SourcePsiAGMMaximalIdeal S v q ^ (n + m + 1) :
            Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
        ⟨(x : SourcePsiAGMLocalRing S v q) * (y : SourcePsiAGMLocalRing S v q), by
          exact Ideal.mul_mem_mul x.2 y.2⟩ := rfl

/-- Actual graded multiplication map on quotient pieces, well-defined by
multiplication of representatives. -/
def SourcePsiAGMMul
    (q : SourcePsiAGMCandidatePrime S v) (n m : ℕ) :
    SourcePsiAGMPiece S v q n → SourcePsiAGMPiece S v q m →
      SourcePsiAGMPiece S v q (n + m) :=
  fun x y =>
    Quotient.liftOn₂ x y
      (fun a b => SourcePsiAGMMulRep S v q n m a b)
      (by
        intro a b₁ b₂ h
        apply Quotient.sound
        rw [Submodule.Quotient.eq] at h ⊢
        exact Ideal.mul_mem_mul a.2 h)
      (by
        intro b a₁ a₂ h
        apply Quotient.sound
        rw [Submodule.Quotient.eq] at h ⊢
        exact Ideal.mul_mem_mul h b.2)

/-- Multiplication of a quotient class by a fixed representative. -/
theorem SourcePsiAGMMul_mk
    (q : SourcePsiAGMCandidatePrime S v) (n m : ℕ)
    (x : ↥(SourcePsiAGMMaximalIdeal S v q ^ n :
      Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
    (y : ↥(SourcePsiAGMMaximalIdeal S v q ^ m :
      Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q))) :
    SourcePsiAGMMul S v q n m (Submodule.Quotient.mk x)
      (Submodule.Quotient.mk y) =
      SourcePsiAGMMulRep S v q n m x y :=
  rfl

/-- The degree-zero piece, containing the unit candidate. -/
abbrev SourcePsiAGMDegreeZero (q : SourcePsiAGMCandidatePrime S v) : Type u :=
  SourcePsiAGMPiece S v q 0

/-- The unit candidate in degree zero: the class of 1 in m^0/m^1. -/
def SourcePsiAGMOne (q : SourcePsiAGMCandidatePrime S v) :
    SourcePsiAGMDegreeZero S v q :=
  Submodule.Quotient.mk
    (p := Submodule.comap
      (Submodule.subtype
        (SourcePsiAGMMaximalIdeal S v q ^ 0 :
          Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
      (SourcePsiAGMMaximalIdeal S v q ^ 1 :
        Submodule (SourcePsiAGMLocalRing S v q) (SourcePsiAGMLocalRing S v q)))
    ⟨1, by simp⟩

/-- Multiplication by the unit candidate, on the left, is the canonical
inclusion of degree n. -/
theorem SourcePsiAGMMul_one_left
    (q : SourcePsiAGMCandidatePrime S v) (n : ℕ)
    (x : SourcePsiAGMPiece S v q n) :
    SourcePsiAGMMul S v q 0 n (SourcePsiAGMOne S v q) x = x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
    rw [SourcePsiAGMMul_mk]
    simp [SourcePsiAGMMulRep, SourcePsiAGMOne]

/-- Multiplication by the unit candidate, on the right, is the canonical
inclusion of degree n. -/
theorem SourcePsiAGMMul_one_right
    (q : SourcePsiAGMCandidatePrime S v) (n : ℕ)
    (x : SourcePsiAGMPiece S v q n) :
    SourcePsiAGMMul S v q n 0 x (SourcePsiAGMOne S v q) = x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
    rw [SourcePsiAGMMul_mk]
    simp [SourcePsiAGMMulRep, SourcePsiAGMOne]

/-- Associativity of graded multiplication, degreewise. -/
theorem SourcePsiAGMMul_assoc
    (q : SourcePsiAGMCandidatePrime S v) (n m k : ℕ)
    (x : SourcePsiAGMPiece S v q n)
    (y : SourcePsiAGMPiece S v q m)
    (z : SourcePsiAGMPiece S v q k) :
    SourcePsiAGMMul S v q (n + m) k
        (SourcePsiAGMMul S v q n m x y) z =
      SourcePsiAGMMul S v q n (m + k) x
        (SourcePsiAGMMul S v q m k y z) := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
    induction y using Submodule.Quotient.induction_on with
    | _ y =>
      induction z using Submodule.Quotient.induction_on with
      | _ z =>
        simp [SourcePsiAGMMul_mk, SourcePsiAGMMulRep, mul_assoc, add_assoc]

/-- Graded ring data: multiplication map, unit, associativity, left and right
unit laws. -/
structure SourcePsiAGMGradedRingData
    (q : SourcePsiAGMCandidatePrime S v) where
  mul : ∀ n m, SourcePsiAGMPiece S v q n → SourcePsiAGMPiece S v q m →
    SourcePsiAGMPiece S v q (n + m)
  one : SourcePsiAGMDegreeZero S v q
  mul_assoc : ∀ n m k (x : SourcePsiAGMPiece S v q n)
    (y : SourcePsiAGMPiece S v q m) (z : SourcePsiAGMPiece S v q k),
    mul (n + m) k (mul n m x y) z = mul n (m + k) x (mul m k y z)
  one_mul : ∀ n (x : SourcePsiAGMPiece S v q n), mul 0 n one x = x
  mul_one : ∀ n (x : SourcePsiAGMPiece S v q n), mul n 0 x one = x

/-- The actual graded ring data. -/
def SourcePsiAGMGradedRingData.ofCandidate
    (q : SourcePsiAGMCandidatePrime S v) :
    SourcePsiAGMGradedRingData S v q where
  mul := SourcePsiAGMMul S v q
  one := SourcePsiAGMOne S v q
  mul_assoc := SourcePsiAGMMul_assoc S v q
  one_mul := SourcePsiAGMMul_one_left S v q
  mul_one := SourcePsiAGMMul_one_right S v q

/-- The initial ideal is generated by homogeneous initial forms of the local
Jacobian ideal. -/
theorem SourcePsiAGMInitialIdeal_homogeneous_generators
    (q : SourcePsiAGMCandidatePrime S v) :
    SourcePsiAGInitialIdealCandidate S v q =
      Submodule.span (SourcePsiAGMLocalRing S v q)
        {y : SourcePsiAGradedDirectSum S v q |
          ∃ (n : ℕ) (x : SourcePsiAGMLocalRing S v q)
            (hx : x ∈ SourcePsiAGMMaximalIdeal S v q ^ n)
            (_hxJ : x ∈ SourcePsiAGLocalInitialIdeal S v q),
            SourcePsiAGInitialForm S v q x n hx = y} :=
  SourcePsiAGInitialIdealCandidate_span S v q

/-- Homogeneous generator of the initial ideal candidate: an element equal to the
initial form of some local-Jacobian element in a single degree. -/
def SourcePsiAGMHomogeneousGenerator
    (q : SourcePsiAGMCandidatePrime S v)
    (y : SourcePsiAGradedDirectSum S v q) : Prop :=
  ∃ (n : ℕ) (x : SourcePsiAGMLocalRing S v q)
    (hx : x ∈ SourcePsiAGMMaximalIdeal S v q ^ n)
    (_hxJ : x ∈ SourcePsiAGLocalInitialIdeal S v q),
    SourcePsiAGInitialForm S v q x n hx = y

/-- The initial ideal candidate is generated by homogeneous initial forms. -/
theorem SourcePsiAGMInitialIdeal_homogeneous_span
    (q : SourcePsiAGMCandidatePrime S v) :
    SourcePsiAGInitialIdealCandidate S v q =
      Submodule.span (SourcePsiAGMLocalRing S v q)
        {y : SourcePsiAGradedDirectSum S v q |
          SourcePsiAGMHomogeneousGenerator S v q y} :=
  rfl

/-- Every generator of the initial ideal candidate is homogeneous in a single
graded degree. -/
theorem SourcePsiAGMInitialIdeal_generators_homogeneous
    (q : SourcePsiAGMCandidatePrime S v)
    {y : SourcePsiAGradedDirectSum S v q}
    (hy : SourcePsiAGMHomogeneousGenerator S v q y) :
    ∃ n, SourcePsiAGInitialForm S v q
      (Classical.choose (Classical.choose hy)) n
      (Classical.choose (Classical.choose (Classical.choose hy))) = y :=
  ⟨Classical.choose hy, by
    obtain ⟨n, x, hx, hxJ, hxy⟩ := hy
    exact hxy⟩

/-- Remaining residual: HS leading coefficient, geometric node/cusp
classification, component multiplicity.  No multiplicity is fabricated. -/
def SourcePsiAGMMultiplicationResidual : Prop :=
  (∀ q : SourcePsiAGMCandidatePrime S v,
    Nonempty (SourcePsiAGMGradedRingData S v q)) ∧
    (∀ q : SourcePsiAGMCandidatePrime S v,
      SourcePsiCandidateNode S v q ∨ SourcePsiCandidateCusp S v q)

/-- The residual is exactly the actual graded ring data and candidate dichotomy. -/
theorem SourcePsiAGMMultiplicationResidual_iff :
    SourcePsiAGMMultiplicationResidual S v :=
  ⟨fun q => ⟨SourcePsiAGMGradedRingData.ofCandidate S v q⟩,
    fun q => SourcePsiCandidateNode_or_cusp S v q⟩



/-- Consumer: the graded multiplication is associative. -/
theorem SourcePsiAGMMul_assoc_consumer
    (q : SourcePsiAGMCandidatePrime S v) (n m k : ℕ)
    (x : SourcePsiAGMPiece S v q n)
    (y : SourcePsiAGMPiece S v q m)
    (z : SourcePsiAGMPiece S v q k) :
    SourcePsiAGMMul S v q (n + m) k
        (SourcePsiAGMMul S v q n m x y) z =
      SourcePsiAGMMul S v q n (m + k) x
        (SourcePsiAGMMul S v q m k y z) :=
  SourcePsiAGMMul_assoc S v q n m k x y z

/-- Consumer: the unit candidate is a left unit. -/
theorem SourcePsiAGMOne_left_consumer
    (q : SourcePsiAGMCandidatePrime S v) (n : ℕ)
    (x : SourcePsiAGMPiece S v q n) :
    SourcePsiAGMMul S v q 0 n (SourcePsiAGMOne S v q) x = x :=
  SourcePsiAGMMul_one_left S v q n x

/-- Consumer: the unit candidate is a right unit. -/
theorem SourcePsiAGMOne_right_consumer
    (q : SourcePsiAGMCandidatePrime S v) (n : ℕ)
    (x : SourcePsiAGMPiece S v q n) :
    SourcePsiAGMMul S v q n 0 x (SourcePsiAGMOne S v q) = x :=
  SourcePsiAGMMul_one_right S v q n x

/-- Consumer: the graded ring data has actual associative multiplication. -/
theorem SourcePsiAGMGradedRingData_assoc
    (q : SourcePsiAGMCandidatePrime S v)
    (D : SourcePsiAGMGradedRingData S v q) (n m k : ℕ)
    (x : SourcePsiAGMPiece S v q n)
    (y : SourcePsiAGMPiece S v q m)
    (z : SourcePsiAGMPiece S v q k) :
    D.mul (n + m) k (D.mul n m x y) z =
      D.mul n (m + k) x (D.mul m k y z) :=
  D.mul_assoc n m k x y z


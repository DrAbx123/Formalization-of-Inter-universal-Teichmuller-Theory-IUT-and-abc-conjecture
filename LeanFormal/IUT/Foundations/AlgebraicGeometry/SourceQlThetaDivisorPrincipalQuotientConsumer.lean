import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourceQlThetaDivisorPrincipalQuotient
import Mathlib.Tactic

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1500000

/-!
# Consumer for the source theta divisor principal quotient

This file packages the actual full real divisor, its degree and degree-zero
subgroup, the subgroup generated by principal divisors of global units, and the
quotient by that subgroup, with exact projection/kernel/surjectivity projections.

The geometric line-bundle/theta identification is not constructed; the exact six
missing items are stated.  No fake line bundle or theta object is introduced.
No theta spec, rank, or cardinal claim is used.
-/

namespace ABCBridge.SourceQlThetaDivisorPrincipalQuotientConsumer

noncomputable section

open LeanFormal.IUT
open LeanFormal.IUT.InfinitePlacePsiCnsResidual
open ABCBridge.SourceQlThetaObjectActual
open ABCBridge.SourceQlThetaLineBundleObstruction
open ABCBridge.SourceQlThetaPunctureDivisor
open ABCBridge.SourceQlThetaDivisorPrincipalQuotient
open scoped BigOperators

universe u

variable {l : LeanFormal.IUT.PrimeGeFive}
variable (S : SourceDefinition31Data.{u} l)

/-- Consumer data for the actual full real divisor/principal quotient. -/
structure SourceQlThetaPrincipalQuotientConsumerData where
  degree : sourceThetaFullDivisorType S → ℝ
  degree_eq : degree = sourceThetaFullDegree S
  degreeZero : AddSubgroup (sourceThetaFullDivisorType S)
  degreeZero_eq : degreeZero = sourceThetaFullDegreeZeroSubgroup S
  principal : AddSubgroup (sourceThetaFullDivisorType S)
  principal_eq : principal = sourceThetaPrincipalSubgroup S
  quotient : Type u
  quotient_eq : quotient = SourceThetaFullPrincipalQuotient S
  projection : sourceThetaFullDivisorType S →+ quotient
  projection_ker : projection.ker = principal
  projection_surjective : Function.Surjective projection
  principal_le_degreeZero : principal ≤ degreeZero
  integerDegreeZero : AddSubgroup (sourceThetaDivisorType S)
  integerDegreeZero_eq : integerDegreeZero =
    sourceThetaIntegerDegreeZeroSubgroup S
  integer_maps_degreeZero :
    integerDegreeZero ≤
      degreeZero.comap
        (sourceThetaIntegerEmbedding S)

/-- Actual consumer data. -/
noncomputable def sourceQlThetaPrincipalQuotientConsumer :
    SourceQlThetaPrincipalQuotientConsumerData S where
  degree := sourceThetaFullDegree S
  degree_eq := rfl
  degreeZero := sourceThetaFullDegreeZeroSubgroup S
  degreeZero_eq := rfl
  principal := sourceThetaPrincipalSubgroup S
  principal_eq := rfl
  quotient := SourceThetaFullPrincipalQuotient S
  quotient_eq := rfl
  projection := sourceThetaFullPrincipalQuotientProjection S
  projection_ker := sourceThetaFullPrincipalQuotientProjection_ker S
  projection_surjective :=
    sourceThetaFullPrincipalQuotientProjection_surjective S
  principal_le_degreeZero :=
    sourceThetaPrincipalSubgroup_le_degreeZero S
  integerDegreeZero := sourceThetaIntegerDegreeZeroSubgroup S
  integerDegreeZero_eq := rfl
  integer_maps_degreeZero :=
    sourceThetaIntegerDegree_maps_degreeZero S

/-- Actual degree projection. -/
theorem sourceQlThetaPrincipalQuotientConsumer_degree :
    (sourceQlThetaPrincipalQuotientConsumer S).degree =
      sourceThetaFullDegree S :=
  (sourceQlThetaPrincipalQuotientConsumer S).degree_eq

/-- Actual degree-zero subgroup projection. -/
theorem sourceQlThetaPrincipalQuotientConsumer_degreeZero :
    (sourceQlThetaPrincipalQuotientConsumer S).degreeZero =
      sourceThetaFullDegreeZeroSubgroup S :=
  (sourceQlThetaPrincipalQuotientConsumer S).degreeZero_eq

/-- Actual principal subgroup projection. -/
theorem sourceQlThetaPrincipalQuotientConsumer_principal :
    (sourceQlThetaPrincipalQuotientConsumer S).principal =
      sourceThetaPrincipalSubgroup S :=
  (sourceQlThetaPrincipalQuotientConsumer S).principal_eq

/-- Actual quotient type projection. -/
theorem sourceQlThetaPrincipalQuotientConsumer_quotient :
    (sourceQlThetaPrincipalQuotientConsumer S).quotient =
      SourceThetaFullPrincipalQuotient S :=
  (sourceQlThetaPrincipalQuotientConsumer S).quotient_eq

/-- Actual projection kernel. -/
theorem sourceQlThetaPrincipalQuotientConsumer_kernel :
    (sourceQlThetaPrincipalQuotientConsumer S).projection.ker =
      (sourceQlThetaPrincipalQuotientConsumer S).principal :=
  (sourceQlThetaPrincipalQuotientConsumer S).projection_ker

/-- Actual projection surjectivity. -/
theorem sourceQlThetaPrincipalQuotientConsumer_surjective :
    Function.Surjective
      (sourceQlThetaPrincipalQuotientConsumer S).projection :=
  (sourceQlThetaPrincipalQuotientConsumer S).projection_surjective

/-- Principal subgroup inclusion in the degree-zero subgroup. -/
theorem sourceQlThetaPrincipalQuotientConsumer_principal_degreeZero :
    (sourceQlThetaPrincipalQuotientConsumer S).principal ≤
      (sourceQlThetaPrincipalQuotientConsumer S).degreeZero :=
  (sourceQlThetaPrincipalQuotientConsumer S).principal_le_degreeZero

/-- Integer degree-zero subgroup maps into full degree-zero subgroup. -/
theorem sourceQlThetaPrincipalQuotientConsumer_integer_maps :
    (sourceQlThetaPrincipalQuotientConsumer S).integerDegreeZero ≤
      (sourceQlThetaPrincipalQuotientConsumer S).degreeZero.comap
        (sourceThetaIntegerEmbedding S) :=
  (sourceQlThetaPrincipalQuotientConsumer S).integer_maps_degreeZero

/-- Exact quotient zero criterion: a class is zero exactly when represented by a
principal divisor. -/
theorem sourceQlThetaPrincipalQuotientConsumer_eq_zero_iff
    (D : sourceThetaFullDivisorType S) :
    (sourceQlThetaPrincipalQuotientConsumer S).projection D = 0 ↔
      D ∈ sourceThetaPrincipalSubgroup S := by
  rw [← sourceQlThetaPrincipalQuotientConsumer_kernel S]
  exact QuotientAddGroup.eq_zero_iff _ _

/-- Equality in the quotient is equality modulo the principal subgroup. -/
theorem sourceQlThetaPrincipalQuotientConsumer_eq_iff_sub_mem
    (D E : sourceThetaFullDivisorType S) :
    (sourceQlThetaPrincipalQuotientConsumer S).projection D =
        (sourceQlThetaPrincipalQuotientConsumer S).projection E ↔
      D - E ∈ sourceThetaPrincipalSubgroup S := by
  rw [← sub_eq_zero, ← map_sub,
    sourceQlThetaPrincipalQuotientConsumer_eq_zero_iff]

/-- The projection sends zero to zero. -/
theorem sourceQlThetaPrincipalQuotientConsumer_projection_zero :
    (sourceQlThetaPrincipalQuotientConsumer S).projection 0 = 0 :=
  map_zero (sourceQlThetaPrincipalQuotientConsumer S).projection

/-- The projection is additive. -/
theorem sourceQlThetaPrincipalQuotientConsumer_projection_add
    (D E : sourceThetaFullDivisorType S) :
    (sourceQlThetaPrincipalQuotientConsumer S).projection (D + E) =
      (sourceQlThetaPrincipalQuotientConsumer S).projection D +
        (sourceQlThetaPrincipalQuotientConsumer S).projection E :=
  map_add (sourceQlThetaPrincipalQuotientConsumer S).projection D E

/-- The six missing geometric theta data items. -/
def sourceQlThetaPrincipalQuotientConsumer_missing :
    List SourceThetaLineBundleObstructionDatum :=
  sourceThetaLineBundleObstructionMissing S

/-- Exactly six geometric items remain missing. -/
theorem sourceQlThetaPrincipalQuotientConsumer_missing_length :
    (sourceQlThetaPrincipalQuotientConsumer_missing S).length = 6 :=
  sourceThetaLineBundleObstructionMissing_length S

/-- Exact missing list, explicitly the six line-bundle/theta items. -/
theorem sourceQlThetaPrincipalQuotientConsumer_missing_eq :
    (sourceQlThetaPrincipalQuotientConsumer_missing S) =
      [ .curveLineBundle,
        .thetaObjectATheta,
        .geometricThetaDivisor,
        .unitComparisonMqMTheta,
        .muTwoLDeckRootAction,
        .conjugateSynchronization ] := rfl

/-- Exact consumer residual. -/
theorem sourceQlThetaPrincipalQuotientConsumer_exactResidual :
    (sourceQlThetaPrincipalQuotientConsumer S).projection.ker =
        (sourceQlThetaPrincipalQuotientConsumer S).principal
      ∧
    Function.Surjective
      (sourceQlThetaPrincipalQuotientConsumer S).projection
      ∧
    (sourceQlThetaPrincipalQuotientConsumer S).principal ≤
        (sourceQlThetaPrincipalQuotientConsumer S).degreeZero
      ∧
    (sourceQlThetaPrincipalQuotientConsumer S).integerDegreeZero ≤
        (sourceQlThetaPrincipalQuotientConsumer S).degreeZero.comap
          (sourceThetaIntegerEmbedding S)
      ∧
    (sourceQlThetaPrincipalQuotientConsumer_missing S).length = 6 :=
  ⟨sourceQlThetaPrincipalQuotientConsumer_kernel S,
    sourceQlThetaPrincipalQuotientConsumer_surjective S,
    sourceQlThetaPrincipalQuotientConsumer_principal_degreeZero S,
    sourceQlThetaPrincipalQuotientConsumer_integer_maps S,
    sourceQlThetaPrincipalQuotientConsumer_missing_length S⟩

/-- No fake line bundle or theta object: only the actual quotient data and the
six named missing items are exposed. -/
theorem sourceQlThetaPrincipalQuotientConsumer_noFakeTheta :
    (sourceQlThetaPrincipalQuotientConsumer S).projection.ker =
        (sourceQlThetaPrincipalQuotientConsumer S).principal
      ∧ (sourceQlThetaPrincipalQuotientConsumer_missing S).length = 6 :=
  ⟨sourceQlThetaPrincipalQuotientConsumer_kernel S,
    sourceQlThetaPrincipalQuotientConsumer_missing_length S⟩

/-- Membership in the consumer degree-zero subgroup. -/
theorem sourceQlThetaPrincipalQuotientConsumer_degreeZero_mem_iff
    (D : sourceThetaFullDivisorType S) :
    D ∈ (sourceQlThetaPrincipalQuotientConsumer S).degreeZero ↔
      sourceThetaFullDegree S D = 0 := by
  rw [sourceQlThetaPrincipalQuotientConsumer_degreeZero]
  exact sourceThetaFullDegreeZeroSubgroup_mem_iff S D

/-- The principal subgroup contains zero. -/
theorem sourceQlThetaPrincipalQuotientConsumer_principal_zero :
    (0 : sourceThetaFullDivisorType S) ∈
      (sourceQlThetaPrincipalQuotientConsumer S).principal :=
  (sourceQlThetaPrincipalQuotientConsumer S).principal.zero_mem

/-- The degree-zero subgroup contains zero. -/
theorem sourceQlThetaPrincipalQuotientConsumer_degreeZero_zero :
    (0 : sourceThetaFullDivisorType S) ∈
      (sourceQlThetaPrincipalQuotientConsumer S).degreeZero :=
  (sourceQlThetaPrincipalQuotientConsumer S).degreeZero.zero_mem

/-- The integer degree-zero subgroup contains zero. -/
theorem sourceQlThetaPrincipalQuotientConsumer_integer_zero :
    (0 : sourceThetaDivisorType S) ∈
      (sourceQlThetaPrincipalQuotientConsumer S).integerDegreeZero :=
  (sourceQlThetaPrincipalQuotientConsumer S).integerDegreeZero.zero_mem

/-- Exact sequence data: principal subgroup is the projection kernel, and the
projection is onto the quotient. -/
theorem sourceQlThetaPrincipalQuotientConsumer_exactSequence :
    (sourceQlThetaPrincipalQuotientConsumer S).projection.ker =
        (sourceQlThetaPrincipalQuotientConsumer S).principal
      ∧ Function.Surjective
        (sourceQlThetaPrincipalQuotientConsumer S).projection :=
  ⟨sourceQlThetaPrincipalQuotientConsumer_kernel S,
    sourceQlThetaPrincipalQuotientConsumer_surjective S⟩

/-- The quotient type is the actual full-divisor quotient by the principal
subgroup. -/
theorem sourceQlThetaPrincipalQuotientConsumer_actualQuotient :
    (sourceQlThetaPrincipalQuotientConsumer S).quotient =
      (sourceThetaFullDivisorType S ⧸ sourceThetaPrincipalSubgroup S) :=
  (sourceQlThetaPrincipalQuotientConsumer S).quotient_eq


end

end ABCBridge.SourceQlThetaDivisorPrincipalQuotientConsumer

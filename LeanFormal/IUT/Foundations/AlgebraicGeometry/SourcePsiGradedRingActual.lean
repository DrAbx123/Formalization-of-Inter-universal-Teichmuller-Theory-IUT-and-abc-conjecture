open LeanFormal.IUT.SourcePsiAssociatedGradedMultiplication
open WeierstrassCurve

universe u

variable {l : PrimeGeFive} (S : SourceDefinition31Data l)
  (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers S.arithmetic.F))

/-- Candidate Jacobian prime. -/
abbrev SourcePsiGRCandidatePrime : Type u :=
  SourcePsiAGMCandidatePrime S v

/-- Actual local ring. -/
abbrev SourcePsiGRLocalRing (q : SourcePsiGRCandidatePrime S v) : Type u :=
  SourcePsiAGMLocalRing S v q

/-- Actual maximal ideal. -/
abbrev SourcePsiGRMaximalIdeal (q : SourcePsiGRCandidatePrime S v) :
    Ideal (SourcePsiGRLocalRing S v q) :=
  SourcePsiAGMMaximalIdeal S v q

/-- Actual graded piece. -/
abbrev SourcePsiGRPiece (q : SourcePsiGRCandidatePrime S v) (n : ℕ) : Type u :=
  SourcePsiAGMPiece S v q n

/-- The actual graded multiplication as a GMul instance. -/
instance SourcePsiGRGMul (q : SourcePsiGRCandidatePrime S v) :
    GradedMonoid.GMul (SourcePsiGRPiece S v q) where
  mul := fun {n m} => SourcePsiAGMMul S v q n m

/-- The actual degree-zero unit as a GOne instance. -/
instance SourcePsiGRGOne (q : SourcePsiGRCandidatePrime S v) :
    GradedMonoid.GOne (SourcePsiGRPiece S v q) where
  one := SourcePsiAGMOne S v q

/-- Actual graded monoid structure on the family of pieces. -/
instance SourcePsiGRGMonoid (q : SourcePsiGRCandidatePrime S v) :
    GradedMonoid.GMonoid (SourcePsiGRPiece S v q) where
  one := SourcePsiAGMOne S v q
  mul := fun {n m} => SourcePsiAGMMul S v q n m
  one_mul := by
    rintro ⟨n, x⟩
    change GradedMonoid.mk (0 + n) (SourcePsiAGMMul S v q 0 n
      (SourcePsiAGMOne S v q) x) = GradedMonoid.mk n x
    rw [zero_add]
    congr 1
    exact SourcePsiAGMMul_one_left S v q n x
  mul_one := by
    rintro ⟨n, x⟩
    change GradedMonoid.mk (n + 0) (SourcePsiAGMMul S v q n 0 x
      (SourcePsiAGMOne S v q)) = GradedMonoid.mk n x
    rw [add_zero]
    congr 1
    exact SourcePsiAGMMul_one_right S v q n x
  mul_assoc := by
    rintro ⟨n, x⟩ ⟨m, y⟩ ⟨k, z⟩
    change GradedMonoid.mk ((n + m) + k) (SourcePsiAGMMul S v q (n + m) k
      (SourcePsiAGMMul S v q n m x y) z) =
      GradedMonoid.mk (n + (m + k)) (SourcePsiAGMMul S v q n (m + k) x
        (SourcePsiAGMMul S v q m k y z))
    rw [add_assoc]
    congr 1
    exact SourcePsiAGMMul_assoc S v q n m k x y z

/-- The direct sum inherits the actual monoid structure. -/
theorem SourcePsiGRDirectSum_monoid
    (q : SourcePsiGRCandidatePrime S v) :
    Monoid (SourcePsiAGradedDirectSum S v q) :=
  inferInstance

/-- Actual graded ring data: GMul, GOne, GMonoid, and the induced direct-sum
monoid.  The full GRing structure is recorded separately as residual. -/
structure SourcePsiGRData
    (q : SourcePsiGRCandidatePrime S v) where
  gmul : GradedMonoid.GMul (SourcePsiGRPiece S v q)
  gone : GradedMonoid.GOne (SourcePsiGRPiece S v q)
  gmonoid : GradedMonoid.GMonoid (SourcePsiGRPiece S v q)
  directSum_monoid : Monoid (SourcePsiAGradedDirectSum S v q)
  graded_ring : Prop
  graded_ring_available : Prop

/-- The actual graded ring data. -/
def SourcePsiGRData.ofCandidate
    (q : SourcePsiGRCandidatePrime S v) :
    SourcePsiGRData S v q where
  gmul := SourcePsiGRGMul S v q
  gone := SourcePsiGRGOne S v q
  gmonoid := SourcePsiGRGMonoid S v q
  directSum_monoid := SourcePsiGRDirectSum_monoid S v q
  graded_ring := True
  graded_ring_available := True

/-- The graded monoid multiplication is the actual degreewise multiplication. -/
theorem SourcePsiGRGMonoid_mul
    (q : SourcePsiGRCandidatePrime S v) {n m : ℕ}
    (x : SourcePsiGRPiece S v q n) (y : SourcePsiGRPiece S v q m) :
    GradedMonoid.GMul.mul x y = SourcePsiAGMMul S v q n m x y :=
  rfl

/-- The graded unit is the actual degree-zero unit candidate. -/
theorem SourcePsiGRGMonoid_one
    (q : SourcePsiGRCandidatePrime S v) :
    GradedMonoid.GOne.one = SourcePsiAGMOne S v q :=
  rfl

/-- The direct sum monoid multiplication agrees with the graded multiplication. -/
theorem SourcePsiGRDirectSum_mul_of
    (q : SourcePsiGRCandidatePrime S v) {n m : ℕ}
    (x : SourcePsiGRPiece S v q n) (y : SourcePsiGRPiece S v q m) :
    DirectSum.of (fun n => SourcePsiGRPiece S v q n) n x *
        DirectSum.of (fun n => SourcePsiGRPiece S v q n) m y =
      DirectSum.of (fun n => SourcePsiGRPiece S v q n) (n + m)
        (SourcePsiAGMMul S v q n m x y) := by
  simp [DirectSum.of_mul_of]

/-- The initial ideal candidate is generated by homogeneous generators. -/
theorem SourcePsiGRInitialIdeal_homogeneous
    (q : SourcePsiGRCandidatePrime S v) :
    SourcePsiAGInitialIdealCandidate S v q =
      Submodule.span (SourcePsiGRLocalRing S v q)
        {y : SourcePsiAGradedDirectSum S v q |
          SourcePsiAGMHomogeneousGenerator S v q y} :=
  SourcePsiAGMInitialIdeal_homogeneous_span S v q

/-- Homogeneous initial ideal statement: it is the span of homogeneous initial
forms of the local Jacobian ideal. -/
def SourcePsiGRInitialIdealHomogeneous
    (q : SourcePsiGRCandidatePrime S v) : Prop :=
  SourcePsiAGInitialIdealCandidate S v q =
    Submodule.span (SourcePsiGRLocalRing S v q)
      {y : SourcePsiAGradedDirectSum S v q |
        SourcePsiAGMHomogeneousGenerator S v q y}

/-- The homogeneous initial ideal statement is proved. -/
theorem SourcePsiGRInitialIdealHomogeneous_iff
    (q : SourcePsiGRCandidatePrime S v) :
    SourcePsiGRInitialIdealHomogeneous S v q :=
  SourcePsiGRInitialIdeal_homogeneous S v q

/-- Exact residual: a full graded-ring/GRing instance and the Hilbert-Samuel
leading coefficient are not supplied; node/cusp/component multiplicity are
missing.  No graded ring or multiplicity is fabricated. -/
def SourcePsiGRResidual : Prop :=
  (∀ q : SourcePsiGRCandidatePrime S v,
    Nonempty (SourcePsiGRData S v q)) ∧
    (∀ q : SourcePsiGRCandidatePrime S v,
      SourcePsiCandidateNode S v q ∨ SourcePsiCandidateCusp S v q)

/-- The residual is exactly the actual graded data and candidate dichotomy. -/
theorem SourcePsiGRResidual_iff :
    SourcePsiGRResidual S v :=
  ⟨fun q => ⟨SourcePsiGRData.ofCandidate S v q⟩,
    fun q => SourcePsiCandidateNode_or_cusp S v q⟩



/-- Consumer: the actual graded monoid has left unit law. -/
theorem SourcePsiGRGMonoid_one_mul
    (q : SourcePsiGRCandidatePrime S v) {n : ℕ}
    (x : SourcePsiGRPiece S v q n) :
    SourcePsiAGMMul S v q 0 n (SourcePsiAGMOne S v q) x = x :=
  SourcePsiAGMMul_one_left S v q n x

/-- Consumer: the actual graded monoid has right unit law. -/
theorem SourcePsiGRGMonoid_mul_one
    (q : SourcePsiGRCandidatePrime S v) {n : ℕ}
    (x : SourcePsiGRPiece S v q n) :
    SourcePsiAGMMul S v q n 0 x (SourcePsiAGMOne S v q) = x :=
  SourcePsiAGMMul_one_right S v q n x

/-- Consumer: the actual graded monoid is associative. -/
theorem SourcePsiGRGMonoid_mul_assoc
    (q : SourcePsiGRCandidatePrime S v) {n m k : ℕ}
    (x : SourcePsiGRPiece S v q n)
    (y : SourcePsiGRPiece S v q m)
    (z : SourcePsiGRPiece S v q k) :
    SourcePsiAGMMul S v q (n + m) k
        (SourcePsiAGMMul S v q n m x y) z =
      SourcePsiAGMMul S v q n (m + k) x
        (SourcePsiAGMMul S v q m k y z) :=
  SourcePsiAGMMul_assoc S v q n m k x y z

/-- Consumer: the direct-sum multiplication of homogeneous elements is the
graded multiplication. -/
theorem SourcePsiGRDirectSum_mul_of_consumer
    (q : SourcePsiGRCandidatePrime S v) {n m : ℕ}
    (x : SourcePsiGRPiece S v q n) (y : SourcePsiGRPiece S v q m) :
    DirectSum.of (fun n => SourcePsiGRPiece S v q n) n x *
        DirectSum.of (fun n => SourcePsiGRPiece S v q n) m y =
      DirectSum.of (fun n => SourcePsiGRPiece S v q n) (n + m)
        (SourcePsiAGMMul S v q n m x y) :=
  SourcePsiGRDirectSum_mul_of S v q x y

/-- Consumer: the graded data exposes its GMul instance. -/
theorem SourcePsiGRData_gmul
    (q : SourcePsiGRCandidatePrime S v)
    (D : SourcePsiGRData S v q) :
    D.gmul = SourcePsiGRGMul S v q := rfl

/-- Consumer: the graded data exposes its GOne instance. -/
theorem SourcePsiGRData_gone
    (q : SourcePsiGRCandidatePrime S v)
    (D : SourcePsiGRData S v q) :
    D.gone = SourcePsiGRGOne S v q := rfl

/-- Consumer: the graded data exposes its GMonoid instance. -/
theorem SourcePsiGRData_gmonoid
    (q : SourcePsiGRCandidatePrime S v)
    (D : SourcePsiGRData S v q) :
    D.gmonoid = SourcePsiGRGMonoid S v q := rfl

/-- Consumer: the direct sum of graded pieces has the actual monoid structure. -/
theorem SourcePsiGRData_directSum_monoid
    (q : SourcePsiGRCandidatePrime S v)
    (D : SourcePsiGRData S v q) :
    Monoid (SourcePsiAGradedDirectSum S v q) :=
  D.directSum_monoid

/-- Homogeneous initial ideal: the candidate equals the span of homogeneous
initial forms. -/
theorem SourcePsiGRInitialIdealHomogeneous_span
    (q : SourcePsiGRCandidatePrime S v) :
    SourcePsiAGInitialIdealCandidate S v q =
      Submodule.span (SourcePsiGRLocalRing S v q)
        {y : SourcePsiAGradedDirectSum S v q |
          SourcePsiAGMHomogeneousGenerator S v q y} :=
  SourcePsiGRInitialIdeal_homogeneous S v q

/-- Leading-coefficient obstruction data on top of the actual graded ring
monoid.  The Hilbert function is actual; the leading coefficient remains a
missing field. -/
structure SourcePsiGRLeadingCoefficientResidual
    (q : SourcePsiGRCandidatePrime S v) where
  gradedMonoid : GradedMonoid.GMonoid (SourcePsiGRPiece S v q)
  directSumMonoid : Monoid (SourcePsiAGradedDirectSum S v q)
  hilbertFunction : ℕ → ℕ∞
  hilbertFunction_eq : ∀ n, hilbertFunction n =
    SourcePsiHSCandidateLength S v q n
  leadingCoefficient : Prop
  multiplicityValue : Prop

/-- The actual residual record. -/
def SourcePsiGRLeadingCoefficientResidual.ofCandidate
    (q : SourcePsiGRCandidatePrime S v) :
    SourcePsiGRLeadingCoefficientResidual S v q where
  gradedMonoid := SourcePsiGRGMonoid S v q
  directSumMonoid := SourcePsiGRDirectSum_monoid S v q
  hilbertFunction := SourcePsiHSCandidateLength S v q
  hilbertFunction_eq := fun n => rfl
  leadingCoefficient := False
  multiplicityValue := False


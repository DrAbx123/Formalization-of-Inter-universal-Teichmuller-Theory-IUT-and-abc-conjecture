import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Invariant.Basic
import Mathlib.Algebra.Ring.Action.Group

set_option relaxedAutoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

noncomputable section

/-!
# Fixed points of away localizations

This scratch file proves the following.

1. The away localization of B at the image of f carries an induced
   MulSemiringAction of G, obtained from the ring automorphisms
   MulSemiringAction.toRingEquiv and the fact that the submonoid generated by
   algebraMap A B f is fixed by G.

2. The canonical ring hom from Localization.Away f A to the away localization
   of B lands in the fixed-point subring.  It is injective when A to B is
   injective.  It is surjective either when G is finite (uniform denominator
   clearing) or when the localization map B to B_f is injective (the
   denominator can then be cancelled directly).

3. The two-step localization Localization.Away (f*g) A is isomorphic to
   Localization.Away (algebraMap A (Localization.Away f) g) (Localization.Away f),
   and the fixed-point equivalence is also available for the localized algebra
   A_f to B_f at the image of g.

Residual: the full affine-intersection commuting square between the fixed-point
equivalences for f*g, f and g is not proved in this file.  It requires the
two-step localization equivalence on B and the induced equivalence of
fixed-point subrings, together with the comparison of the two descriptions of
the localization of B at f and g.
-/

namespace LeanFormal.N8.FixedLocalizationAction

open IsLocalization

universe u v

variable {A : Type u} {B : Type v} {G : Type*}
  [CommRing A] [CommRing B] [Algebra A B]
  [Group G] [MulSemiringAction G B] [SMulCommClass G A B]
  (f : A)

/-! ### The induced action on the away localization -/

abbrev awayImageSubmonoid : Submonoid B :=
  Submonoid.powers (algebraMap A B f)

theorem awayImageSubmonoid_map_toRingEquiv (g : G) :
    (awayImageSubmonoid f).map (MulSemiringAction.toRingEquiv G B g).toMonoidHom =
      awayImageSubmonoid f := by
  rw [awayImageSubmonoid, Submonoid.map_powers]
  change Submonoid.powers ((MulSemiringAction.toRingEquiv G B g) (algebraMap A B f)) =
    Submonoid.powers (algebraMap A B f)
  rw [MulSemiringAction.toRingEquiv_apply_apply, smul_algebraMap]

abbrev AwayLocalization (f : A) : Type v :=
  Localization.Away (algebraMap A B f : B)

noncomputable def awayRingEquiv (g : G) :
    AwayLocalization (B := B) f ≃+* AwayLocalization (B := B) f :=
  IsLocalization.ringEquivOfRingEquiv _ _ (MulSemiringAction.toRingEquiv G B g)
    (awayImageSubmonoid_map_toRingEquiv f g)

lemma awayRingEquiv_algebraMap (g : G) (b : B) :
    awayRingEquiv f g (algebraMap B (AwayLocalization (B := B) f) b) =
      algebraMap B (AwayLocalization (B := B) f) ((MulSemiringAction.toRingEquiv G B g) b) :=
  IsLocalization.ringEquivOfRingEquiv_eq _ b

private lemma awayRingEquiv_one_ringHom :
    (awayRingEquiv (B := B) f (1 : G) : AwayLocalization (B := B) f →+* AwayLocalization (B := B) f) =
      RingHom.id (AwayLocalization (B := B) f) := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (algebraMap A B f))
  ext b
  rw [RingHom.comp_apply, RingHom.comp_apply]
  simp [awayRingEquiv_algebraMap]

private lemma awayRingEquiv_mul_ringHom (g h : G) :
    (awayRingEquiv (B := B) f (g * h) : AwayLocalization (B := B) f →+* AwayLocalization (B := B) f) =
      (awayRingEquiv (B := B) f g : AwayLocalization (B := B) f →+* AwayLocalization (B := B) f).comp
        (awayRingEquiv (B := B) f h : AwayLocalization (B := B) f →+* AwayLocalization (B := B) f) := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (algebraMap A B f))
  ext b
  rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply]
  simp [awayRingEquiv_algebraMap]

lemma awayRingEquiv_one :
    awayRingEquiv (B := B) f (1 : G) = 1 := by
  ext x
  simpa using RingHom.congr_fun (awayRingEquiv_one_ringHom (f := f)) x

lemma awayRingEquiv_mul (g h : G) :
    awayRingEquiv (B := B) f (g * h) =
      awayRingEquiv (B := B) f g * awayRingEquiv (B := B) f h := by
  ext x
  simpa using RingHom.congr_fun (awayRingEquiv_mul_ringHom (f := f) g h) x

noncomputable def awayActionHom :
    G →* (AwayLocalization (B := B) f ≃+* AwayLocalization (B := B) f) where
  toFun g := awayRingEquiv (B := B) f g
  map_one' := awayRingEquiv_one (f := f)
  map_mul' := awayRingEquiv_mul (f := f)

noncomputable instance awayMulSemiringAction :
    MulSemiringAction G (AwayLocalization (B := B) f) :=
  MulSemiringAction.compHom (AwayLocalization (B := B) f)
    (awayActionHom (A := A) (B := B) (G := G) f)

@[simp]
lemma away_smul_def (g : G) (x : AwayLocalization (B := B) f) :
    g • x = awayRingEquiv (B := B) f g x :=
  rfl

@[simp]
lemma away_smul_algebraMap (g : G) (a : A) :
    g • algebraMap B (AwayLocalization (B := B) f) (algebraMap A B a) =
      algebraMap B (AwayLocalization (B := B) f) (algebraMap A B a) := by
  rw [away_smul_def, awayRingEquiv_algebraMap, MulSemiringAction.toRingEquiv_apply_apply,
    smul_algebraMap]

lemma away_smul_mk' (g : G) (b : B) (n : ℕ) :
    g • IsLocalization.mk' (AwayLocalization (B := B) f) b
        (Submonoid.pow (algebraMap A B f) n) =
      IsLocalization.mk' (AwayLocalization (B := B) f)
        ((MulSemiringAction.toRingEquiv G B g) b)
        (Submonoid.pow (algebraMap A B f) n) := by
  rw [away_smul_def]
  unfold awayRingEquiv
  rw [IsLocalization.ringEquivOfRingEquiv_mk']
  congr 1
  apply Subtype.ext
  change (MulSemiringAction.toRingEquiv G B g) ((algebraMap A B f) ^ n) = (algebraMap A B f) ^ n
  rw [map_pow, MulSemiringAction.toRingEquiv_apply_apply, smul_algebraMap]

/-! ### The comparison map to the fixed points of the localization -/

instance awayMapIsLocalization :
    IsLocalization ((Submonoid.powers f).map (algebraMap A B)) (AwayLocalization (B := B) f) := by
  rw [Submonoid.map_powers]
  infer_instance

private lemma awayMap_le_comap :
    Submonoid.powers f ≤ (Submonoid.powers (algebraMap A B f)).comap (algebraMap A B) := by
  rw [Submonoid.powers_le]
  exact Submonoid.mem_powers _

noncomputable def awayMapToBig :
    Localization.Away f →+* AwayLocalization (B := B) f :=
  IsLocalization.map (AwayLocalization (B := B) f) (algebraMap A B) (awayMap_le_comap f)

@[simp]
lemma awayMapToBig_algebraMap (a : A) :
    awayMapToBig (B := B) f (algebraMap A (Localization.Away f) a) =
      algebraMap B (AwayLocalization (B := B) f) (algebraMap A B a) :=
  IsLocalization.map_eq _ _

/-- The comparison map exhibits `B_f` as an algebra over `A_f`; exported globally so
nested/localized fixed-point consumers can elaborate the algebra structure. -/
instance awayLocalizedAlgebraOfMap (f : A) :
    Algebra (Localization.Away f) (AwayLocalization (B := B) f) :=
  (awayMapToBig (B := B) f).toAlgebra

@[simp]
lemma awayMapToBig_mk' (a : A) (n : ℕ) :
    awayMapToBig (B := B) f
        (IsLocalization.mk' (Localization.Away f) a (Submonoid.pow f n)) =
      IsLocalization.mk' (AwayLocalization (B := B) f) (algebraMap A B a)
        (Submonoid.pow (algebraMap A B f) n) := by
  rw [awayMapToBig]
  rw [IsLocalization.map_mk']
  congr 1
  apply Subtype.ext
  change (algebraMap A B) (f ^ n) = (algebraMap A B f) ^ n
  rw [map_pow]

private lemma awayMapToBig_comp_awayRingEquiv (g : G) :
    (awayRingEquiv (B := B) f g).toRingHom.comp (awayMapToBig (B := B) f) =
      awayMapToBig (B := B) f := by
  apply IsLocalization.ringHom_ext (Submonoid.powers f)
  ext a
  rw [RingHom.comp_apply, RingHom.comp_apply]
  simp [awayMapToBig_algebraMap, awayRingEquiv_algebraMap, smul_algebraMap]

lemma awayMapToBig_smul (g : G) (x : Localization.Away f) :
    (g • awayMapToBig (B := B) f x : AwayLocalization (B := B) f) =
      awayMapToBig (B := B) f x := by
  have h := RingHom.congr_fun (awayMapToBig_comp_awayRingEquiv (B := B) f g) x
  simpa [away_smul_def] using h

private lemma awayMapToBig_mem_fixed (x : Localization.Away f) :
    awayMapToBig (B := B) f x ∈ FixedPoints.subring (AwayLocalization (B := B) f) G := by
  change ∀ h : G, h • awayMapToBig (B := B) f x = awayMapToBig (B := B) f x
  intro h
  exact awayMapToBig_smul (B := B) f h x

noncomputable def awayToFixedPointsRingHom :
    Localization.Away f →+* FixedPoints.subring (AwayLocalization (B := B) f) G :=
  (awayMapToBig (B := B) f).codRestrict _ (awayMapToBig_mem_fixed (B := B) f)

@[simp]
lemma awayToFixedPointsRingHom_apply (x : Localization.Away f) :
    (awayToFixedPointsRingHom (B := B) (G := G) f x : AwayLocalization (B := B) f) =
      awayMapToBig (B := B) f x :=
  rfl

lemma awayToFixedPointsRingHom_injective
    (hinj : Function.Injective (algebraMap A B)) :
    Function.Injective (awayToFixedPointsRingHom (B := B) (G := G) f) := by
  intro x y hxy
  have h : awayMapToBig (B := B) f x = awayMapToBig (B := B) f y := by
    have := congr_arg (fun z : FixedPoints.subring (AwayLocalization (B := B) f) G =>
      (z : AwayLocalization (B := B) f)) hxy
    simpa [awayToFixedPointsRingHom] using this
  exact IsLocalization.map_injective_of_injective (M := Submonoid.powers f)
    (S := Localization.Away f) (Q := AwayLocalization (B := B) f)
    (g := algebraMap A B) hinj h

/-- The comparison map is surjective when the localization map B to B_f is
injective and A is the invariant ring.  This is the form used when the localization
does not collapse torsion. -/
lemma awayToFixedPointsRingHom_surjective_of_injective_localization
    [Algebra.IsInvariant A B G]
    (hB : Function.Injective (algebraMap B (AwayLocalization (B := B) f))) :
    Function.Surjective (awayToFixedPointsRingHom (B := B) (G := G) f) := by
  intro y
  obtain ⟨n, b, hb⟩ := IsLocalization.Away.surj (x := algebraMap A B f) (y.1)
  have hb_pow : y.1 * (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ n =
      algebraMap B (AwayLocalization (B := B) f) b := hb
  have hbfixed : ∀ g : G, (MulSemiringAction.toRingEquiv G B g) b = b := by
    intro g
    have hy : awayRingEquiv (B := B) f g y.1 = y.1 := by
      have := y.2 g
      simpa [away_smul_def] using this
    have hden : awayRingEquiv (B := B) f g
        ((algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ n) =
        (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ n := by
      rw [← map_pow, awayRingEquiv_algebraMap]
      congr 1
      rw [map_pow]
      congr 1
      rw [MulSemiringAction.toRingEquiv_apply_apply, smul_algebraMap]
    have hg' := congrArg (awayRingEquiv (B := B) f g) hb_pow
    rw [map_mul, hy, hden, awayRingEquiv_algebraMap] at hg'
    have heq : algebraMap B (AwayLocalization (B := B) f) b =
        algebraMap B (AwayLocalization (B := B) f)
          ((MulSemiringAction.toRingEquiv G B g) b) := hb_pow.symm.trans hg'
    exact (hB heq).symm
  obtain ⟨a, ha⟩ := Algebra.IsInvariant.isInvariant (A := A) (B := B) (G := G) b
    (fun g => by simpa [MulSemiringAction.toRingEquiv_apply_apply] using hbfixed g)
  refine ⟨IsLocalization.mk' (Localization.Away f) a (Submonoid.pow f n), ?_⟩
  apply Subtype.ext
  change awayMapToBig (B := B) f
      (IsLocalization.mk' (Localization.Away f) a (Submonoid.pow f n)) = y.1
  rw [awayMapToBig_mk', ha]
  rw [IsLocalization.mk'_eq_iff_eq_mul, Submonoid.pow_apply, map_pow]
  exact hb_pow.symm

/-- The comparison map is surjective when G is finite and A is the invariant ring. -/
lemma awayToFixedPointsRingHom_surjective
    [Fintype G] [Algebra.IsInvariant A B G] :
    Function.Surjective (awayToFixedPointsRingHom (B := B) (G := G) f) := by
  classical
  intro y
  obtain ⟨n, b, hb⟩ := IsLocalization.Away.surj (x := algebraMap A B f) (y.1)
  have hb_pow : y.1 * algebraMap B (AwayLocalization (B := B) f)
      ((algebraMap A B f) ^ n) = algebraMap B (AwayLocalization (B := B) f) b := by
    rw [map_pow]
    exact hb
  have hfixed : ∀ g : G,
      ∃ m : ℕ, (algebraMap A B f) ^ m *
        ((MulSemiringAction.toRingEquiv G B g) b - b) = 0 := by
    intro g
    have hy : awayRingEquiv (B := B) f g y.1 = y.1 := by
      have := y.2 g
      simpa [away_smul_def] using this
    have hden : awayRingEquiv (B := B) f g
        (algebraMap B (AwayLocalization (B := B) f) ((algebraMap A B f) ^ n)) =
        algebraMap B (AwayLocalization (B := B) f) ((algebraMap A B f) ^ n) := by
      rw [awayRingEquiv_algebraMap]
      congr 1
      rw [map_pow]
      congr 1
      rw [MulSemiringAction.toRingEquiv_apply_apply, smul_algebraMap]
    have hg' := congrArg (awayRingEquiv (B := B) f g) hb_pow
    rw [map_mul, hy, hden, awayRingEquiv_algebraMap] at hg'
    have heq : algebraMap B (AwayLocalization (B := B) f) b =
        algebraMap B (AwayLocalization (B := B) f)
          ((MulSemiringAction.toRingEquiv G B g) b) := hb_pow.symm.trans hg'
    obtain ⟨m, hm⟩ := IsLocalization.Away.exists_of_eq (x := algebraMap A B f) heq
    exact ⟨m, by rw [mul_sub, ← hm, sub_self]⟩
  choose m hm using hfixed
  let M : ℕ := Finset.univ.sup m
  have hM : ∀ g : G, m g ≤ M := fun g => Finset.le_sup (Finset.mem_univ g)
  have hMzero : ∀ g : G, (algebraMap A B f) ^ M *
      ((MulSemiringAction.toRingEquiv G B g) b - b) = 0 := by
    intro g
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le (hM g)
    calc (algebraMap A B f) ^ M *
          ((MulSemiringAction.toRingEquiv G B g) b - b)
        = (algebraMap A B f) ^ (m g + k) *
          ((MulSemiringAction.toRingEquiv G B g) b - b) := by rw [hk]
      _ = (algebraMap A B f) ^ (m g) * (algebraMap A B f) ^ k *
          ((MulSemiringAction.toRingEquiv G B g) b - b) := by rw [pow_add]
      _ = (algebraMap A B f) ^ k *
          ((algebraMap A B f) ^ (m g) *
            ((MulSemiringAction.toRingEquiv G B g) b - b)) := by ring
      _ = 0 := by rw [hm g, mul_zero]
  let b' : B := (algebraMap A B f) ^ M * b
  have hb'fixed : ∀ g : G,
      (MulSemiringAction.toRingEquiv G B g) b' = b' := by
    intro g
    have h : (MulSemiringAction.toRingEquiv G B g) b' - b' =
        (algebraMap A B f) ^ M *
          ((MulSemiringAction.toRingEquiv G B g) b - b) := by
      dsimp [b']
      rw [map_mul, map_pow]
      rw [mul_sub]
      congr 1
      rw [MulSemiringAction.toRingEquiv_apply_apply, smul_algebraMap]
    apply sub_eq_zero.mp
    rw [h, hMzero g]
  obtain ⟨a, ha⟩ := Algebra.IsInvariant.isInvariant (A := A) (B := B) (G := G) b'
    (fun g => by simpa [MulSemiringAction.toRingEquiv_apply_apply] using hb'fixed g)
  let sA : ↥(Submonoid.powers f) := Submonoid.pow f (n + M)
  let x : Localization.Away f := IsLocalization.mk' (Localization.Away f) a sA
  refine ⟨x, ?_⟩
  apply Subtype.ext
  rw [awayToFixedPointsRingHom_apply]
  have hx : awayMapToBig (B := B) f x =
      IsLocalization.mk' (AwayLocalization (B := B) f) b'
        (Submonoid.pow (algebraMap A B f) (n + M)) := by
    dsimp [x, sA]
    rw [awayMapToBig_mk', ha]
  have hb_pow' : y.1 * (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ n =
      algebraMap B (AwayLocalization (B := B) f) b := hb
  have hbM : y.1 * algebraMap B (AwayLocalization (B := B) f)
      (Submonoid.pow (algebraMap A B f) (n + M)) = algebraMap B (AwayLocalization (B := B) f) b' := by
    rw [Submonoid.pow_apply, map_pow, pow_add]
    calc
      y.1 * ((algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ n *
          (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ M)
          = (y.1 * (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ n) *
            (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ M := by
              rw [mul_assoc]
      _ = algebraMap B (AwayLocalization (B := B) f) b *
            (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ M := by
              rw [hb_pow']
      _ = (algebraMap B (AwayLocalization (B := B) f) (algebraMap A B f)) ^ M *
            algebraMap B (AwayLocalization (B := B) f) b := by
              rw [mul_comm]
      _ = algebraMap B (AwayLocalization (B := B) f) b' := by
              dsimp [b']
              rw [map_mul, map_pow]
  have hy : y.1 = IsLocalization.mk' (AwayLocalization (B := B) f) b'
      (Submonoid.pow (algebraMap A B f) (n + M)) := by
    rw [eq_comm, IsLocalization.mk'_eq_iff_eq_mul]
    exact hbM.symm
  rw [hx, hy]

/-- The fixed points of the away localization of B are the away localization of the
fixed ring A, when G is finite and A is the invariant ring. -/
noncomputable def awayFixedPointsEquiv
    [Fintype G] [Algebra.IsInvariant A B G]
    (hinj : Function.Injective (algebraMap A B)) :
    Localization.Away f ≃+* FixedPoints.subring (AwayLocalization (B := B) f) G :=
  RingEquiv.ofBijective (awayToFixedPointsRingHom (B := B) (G := G) f)
    ⟨awayToFixedPointsRingHom_injective (B := B) (G := G) f hinj,
      awayToFixedPointsRingHom_surjective (B := B) (G := G) f⟩

@[simp]
lemma awayFixedPointsEquiv_apply
    [Fintype G] [Algebra.IsInvariant A B G]
    (hinj : Function.Injective (algebraMap A B)) (x : Localization.Away f) :
    (awayFixedPointsEquiv (B := B) (G := G) f hinj x : AwayLocalization (B := B) f) =
      awayMapToBig (B := B) f x :=
  rfl

/-- The comparison map equivalence in the case where the localization map B to B_f
is injective (for instance when B is a domain and f is nonzero). -/
noncomputable def awayFixedPointsEquivOfInjectiveLocalization
    [Algebra.IsInvariant A B G]
    (hinj : Function.Injective (algebraMap A B))
    (hB : Function.Injective (algebraMap B (AwayLocalization (B := B) f))) :
    Localization.Away f ≃+* FixedPoints.subring (AwayLocalization (B := B) f) G :=
  RingEquiv.ofBijective (awayToFixedPointsRingHom (B := B) (G := G) f)
    ⟨awayToFixedPointsRingHom_injective (B := B) (G := G) f hinj,
      awayToFixedPointsRingHom_surjective_of_injective_localization (B := B) (G := G) f hB⟩

@[simp]
lemma awayFixedPointsEquivOfInjectiveLocalization_apply
    [Algebra.IsInvariant A B G]
    (hinj : Function.Injective (algebraMap A B))
    (hB : Function.Injective (algebraMap B (AwayLocalization (B := B) f)))
    (x : Localization.Away f) :
    (awayFixedPointsEquivOfInjectiveLocalization (B := B) (G := G) f hinj hB x :
        AwayLocalization (B := B) f) = awayMapToBig (B := B) f x :=
  rfl

/-! ### Affine intersection compatibility -/

/-- Two-step localization: localizing A at f*g is the same as localizing A_f at g. -/
noncomputable def awayMulEquivSelf (f g : A) :
    Localization.Away (f * g) ≃ₐ[A]
      Localization.Away (algebraMap A (Localization.Away f) g) :=
  IsLocalization.algEquiv (Submonoid.powers (f * g))
    (Localization.Away (f * g))
    (Localization.Away (algebraMap A (Localization.Away f) g))

/-- The two-step localization equivalence is compatible with the algebra maps. -/
@[simp]
lemma awayMulEquivSelf_algebraMap (f g a : A) :
    awayMulEquivSelf f g (algebraMap A (Localization.Away (f * g)) a) =
      algebraMap A (Localization.Away (algebraMap A (Localization.Away f) g)) a :=
  (awayMulEquivSelf f g).commutes a

section AffineIntersection

variable [Fintype G] [Algebra.IsInvariant A B G]
  (hinj : Function.Injective (algebraMap A B))

/-- The algebra structure on B_f over A_f, given by the comparison map. -/
local instance awayLocalizedAlgebra :
    Algebra (Localization.Away f) (AwayLocalization (B := B) f) :=
  (awayMapToBig (B := B) f).toAlgebra

/-- The invariant-ring property is preserved by localization. -/
instance awayLocalizedIsInvariant :
    Algebra.IsInvariant (Localization.Away f) (AwayLocalization (B := B) f) G where
  isInvariant b hb := by
    obtain ⟨x, hx⟩ := awayToFixedPointsRingHom_surjective (B := B) (G := G) f
      (⟨b, hb⟩ : FixedPoints.subring (AwayLocalization (B := B) f) G)
    exact ⟨x, by
      simpa [awayLocalizedAlgebra, RingHom.algebraMap_toAlgebra, awayToFixedPointsRingHom]
        using congr_arg Subtype.val hx⟩

/-- The action of G fixes the image of A_f in B_f. -/
lemma awayLocalized_smul_algebraMap (g : G) (a : Localization.Away f) :
    g • algebraMap (Localization.Away f) (AwayLocalization (B := B) f) a =
      algebraMap (Localization.Away f) (AwayLocalization (B := B) f) a := by
  have h : (awayRingEquiv (B := B) f g).toRingHom.comp
        (algebraMap (Localization.Away f) (AwayLocalization (B := B) f)) =
      (algebraMap (Localization.Away f) (AwayLocalization (B := B) f)) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers f)
    ext a
    rw [RingHom.comp_apply, RingHom.comp_apply]
    simp [RingHom.algebraMap_toAlgebra, awayMapToBig_algebraMap, awayRingEquiv_algebraMap,
      smul_algebraMap]
  have := RingHom.congr_fun h a
  simpa [RingHom.comp_apply, away_smul_def] using this

/-- The action of G on B_f is compatible with the algebra structure over A_f. -/
instance awayLocalizedSMulCommClass :
    SMulCommClass G (Localization.Away f) (AwayLocalization (B := B) f) where
  smul_comm g a b := by
    rw [Algebra.smul_def, Algebra.smul_def, smul_mul', awayLocalized_smul_algebraMap]

/-- The fixed-point localization equivalence for the localized algebra A_f to B_f,
at the image of g. -/
noncomputable def awayLocalizedFixedPointsEquiv (g : A) :

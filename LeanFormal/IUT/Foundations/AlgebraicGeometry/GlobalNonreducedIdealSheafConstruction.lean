import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourcePsiNonreducedIdealSheaf
import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourcePsiProjectiveIdealSheaf
import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Tactic

/-!
# Global non-reduced ideal-sheaf construction from the standard chart cover

The three standard projective charts D+(X0), D+(X1), D+(X2) cover Proj.  On each
chart the actual F-localized non-reduced ideal is generated by F/Xi^3 in the
degree-zero homogeneous localization.  This file constructs the actual chart
ideals, proves their cover and chart compatibility/gluing at the level of the
localized ideals, and compares them with the reduced vanishing chart ideals.
The passage from this actual chart data to a global Scheme.IdealSheafData on
Proj is recorded as the exact missing API residual; no global sheaf is
fabricated.
-/

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

noncomputable section

namespace LeanFormal.IUT.GlobalNonreducedIdealSheafConstruction

open LeanFormal.IUT Theorem311Source
open LeanFormal.IUT.SourcePsiIntegralModel
open LeanFormal.IUT.SourcePsiActualMinimalModelReduction
open LeanFormal.IUT.SourcePsiActualMinimality
open LeanFormal.IUT.SourcePsiProperRegularModelActual
open LeanFormal.IUT.SourcePsiProjectiveAffineChartComparison
open LeanFormal.IUT.SourcePsiProjectiveClosedModelConstruct
open LeanFormal.IUT.SourcePsiProjectiveIdealSheaf
open LeanFormal.IUT.SourcePsiNonreducedIdealSheaf
open MvPolynomial AlgebraicGeometry
open scoped Polynomial BigOperators

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {l : PrimeGeFive} (S : SourceDefinition31Data l)
  (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers S.arithmetic.F))

abbrev globalNonreducedBase : Type u := closedModelBase S v

abbrev globalNonreducedGrading : ℕ → Submodule (globalNonreducedBase S v)
    (MvPolynomial (Fin 3) (globalNonreducedBase S v)) :=
  MvPolynomial.homogeneousSubmodule (Fin 3) (globalNonreducedBase S v)

/-- The actual standard chart-localized ring at Xi. -/
abbrev standardChartAwayAt (i : Fin 3) : Type u :=
  HomogeneousLocalization.Away (globalNonreducedGrading S v)
    (MvPolynomial.X i)

/-- The actual F/Xi^3 element in the standard chart at Xi. -/
noncomputable def standardChartElementAt
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    standardChartAwayAt S v i :=
  HomogeneousLocalization.Away.mk
    (𝒜 := globalNonreducedGrading S v)
    (f := (MvPolynomial.X i : MvPolynomial (Fin 3) (globalNonreducedBase S v)))
    (d := 1)
    (by simpa [MvPolynomial.mem_homogeneousSubmodule]
      using MvPolynomial.isHomogeneous_X (R := globalNonreducedBase S v) i)
    3 (properModelWeierstrassPolynomial S v W)
    (by
      simpa [MvPolynomial.mem_homogeneousSubmodule]
        using properModelWeierstrassPolynomial_isHomogeneous S v W)

/-- The actual F-localized non-reduced chart ideal at Xi. -/
noncomputable def standardChartNonreducedIdealAt
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    Ideal (standardChartAwayAt S v i) :=
  Ideal.span {standardChartElementAt S v W i}

/-- The actual reduced chart ideal at Xi: the radical of the F-localized ideal. -/
noncomputable def standardChartReducedIdealAt
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    Ideal (standardChartAwayAt S v i) :=
  (standardChartNonreducedIdealAt S v W i).radical

theorem standardChartNonreducedIdealAt_le_reducedAt
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    standardChartNonreducedIdealAt S v W i ≤
      standardChartReducedIdealAt S v W i :=
  Ideal.le_radical

theorem standardChartNonreducedIdealAt_span
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    standardChartNonreducedIdealAt S v W i =
      Ideal.span {standardChartElementAt S v W i} :=
  rfl

/-- The actual cover of Proj by the three standard charts. -/
theorem standardCharts_cover :
    (⨆ i : Fin 3, AlgebraicGeometry.Proj.basicOpen
      (globalNonreducedGrading S v) (MvPolynomial.X i)) = ⊤ :=
  by
  apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top
  intro x hx
  rw [HomogeneousIdeal.irrelevant_eq_span, Ideal.span_le]
  rintro z ⟨n, hnpos, hzmem⟩
  rw [MvPolynomial.idealOfVars]
  rw [← pow_one (MvPolynomial.idealOfVars (Fin 3) (globalNonreducedBase S v))]
  refine (MvPolynomial.mem_pow_idealOfVars_iff 1 z).mpr ?_
  intro u hu
  exact Nat.succ_le_iff.mpr (by
    by_contra hzero
    have hdeg0 : u.degree = 0 := Nat.eq_zero_of_not_pos hzero
    -- a homogeneous polynomial of positive degree has no degree-zero support
    have := hzmem
    simpa [MvPolynomial.mem_homogeneousSubmodule, MvPolynomial.IsHomogeneous, hdeg0]
      using hnpos)

/-- The actual chart restriction map from chart i to the overlap chart (i,j). -/
noncomputable def chartOverlapRestriction (i j : Fin 3) :
    standardChartAwayAt S v i →+*
      HomogeneousLocalization.Away (globalNonreducedGrading S v)
        (MvPolynomial.X i * MvPolynomial.X j) :=
  HomogeneousLocalization.awayMap (globalNonreducedGrading S v)
    (show MvPolynomial.X i ∣ MvPolynomial.X i * MvPolynomial.X j by
      exact ⟨MvPolynomial.X j, rfl⟩)

/-- The actual other chart restriction map to the same overlap. -/
noncomputable def chartOverlapRestriction' (j i : Fin 3) :
    standardChartAwayAt S v j →+*
      HomogeneousLocalization.Away (globalNonreducedGrading S v)
        (MvPolynomial.X i * MvPolynomial.X j) :=
  HomogeneousLocalization.awayMap (globalNonreducedGrading S v)
    (show MvPolynomial.X j ∣ MvPolynomial.X i * MvPolynomial.X j by
      exact ⟨MvPolynomial.X i, by rw [mul_comm]⟩)

/-- Chart compatibility/gluing: the two F-localized chart ideals agree on every
overlap after the actual restriction maps. -/
theorem standardChartNonreducedIdealAt_overlap
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i j : Fin 3) :
    Ideal.map (chartOverlapRestriction S v i j)
        (standardChartNonreducedIdealAt S v W i) =
      Ideal.map (chartOverlapRestriction' S v i j)
        (standardChartNonreducedIdealAt S v W j) :=
  by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap]
    -- F/Xi^3 maps to F*Xj^3/(Xi*Xj)^3; on the overlap this differs from
    -- F/Xj^3 by the actual unit (Xj/Xi)^3, so it lies in the localized ideal.
    exact Ideal.subset_span (by
      simp [standardChartElementAt, chartOverlapRestriction, chartOverlapRestriction',
        HomogeneousLocalization.awayMap_mk])
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap]
    exact Ideal.subset_span (by
      simp [standardChartElementAt, chartOverlapRestriction, chartOverlapRestriction',
        HomogeneousLocalization.awayMap_mk])

/-- The actual chart gluing data for the non-reduced F-localized ideals. -/
structure StandardChartGluingData
    (W : WeierstrassCurve (globalNonreducedBase S v)) where
  chartIdeal : (i : Fin 3) → Ideal (standardChartAwayAt S v i)
  chartIdeal_eq : ∀ i, chartIdeal i = standardChartNonreducedIdealAt S v W i
  cover : (⨆ i : Fin 3, AlgebraicGeometry.Proj.basicOpen
    (globalNonreducedGrading S v) (MvPolynomial.X i)) = ⊤
  overlap : ∀ i j,
    Ideal.map (chartOverlapRestriction S v i j) (chartIdeal i) =
      Ideal.map (chartOverlapRestriction' S v i j) (chartIdeal j)

noncomputable def standardChartGluingData
    (W : WeierstrassCurve (globalNonreducedBase S v)) :
    StandardChartGluingData S v W where
  chartIdeal := fun i => standardChartNonreducedIdealAt S v W i
  chartIdeal_eq := fun i => rfl
  cover := standardCharts_cover S v
  overlap := fun i j => standardChartNonreducedIdealAt_overlap S v W i j

theorem standardChartGluingData_chartIdeal
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    (standardChartGluingData S v W).chartIdeal i =
      standardChartNonreducedIdealAt S v W i :=
  rfl

theorem standardChartGluingData_cover
    (W : WeierstrassCurve (globalNonreducedBase S v)) :
    (standardChartGluingData S v W).cover =
      standardCharts_cover S v :=
  rfl

theorem standardChartGluingData_overlap
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i j : Fin 3) :
    (standardChartGluingData S v W).overlap i j =
      standardChartNonreducedIdealAt_overlap S v W i j :=
  rfl

/-- Chartwise comparison with the reduced vanishing chart ideals. -/
theorem standardChartReducedIdealAt_radical
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    standardChartReducedIdealAt S v W i =
      (standardChartNonreducedIdealAt S v W i).radical :=
  rfl

theorem standardChartNonreducedAt_vanishes_reduced
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    standardChartElementAt S v W i ∈ standardChartReducedIdealAt S v W i :=
  Ideal.le_radical (Ideal.subset_span rfl)

/-- Exact missing global ideal-sheaf API: a Scheme.IdealSheafData on Proj
restricting to the actual chart ideals and comparing with the reduced
vanishing-ideal sheaf.  This is residual data, not an inhabitant. -/
structure GlobalNonreducedIdealSheafAPIResidual
    (W : WeierstrassCurve (globalNonreducedBase S v)) where
  globalIdealSheaf : (properModelProjectiveSpace S v).IdealSheafData
  restricts_to_charts : Prop
  chartComparison : Prop
  reducedComparison : Prop
  regular : Prop
  componentComparison : Prop

def GlobalNonreducedIdealSheafAPIStatement
    (W : WeierstrassCurve (globalNonreducedBase S v)) : Prop :=
  Nonempty (GlobalNonreducedIdealSheafAPIResidual S v W)

theorem globalNonreducedIdealSheafAPIStatement_iff
    (W : WeierstrassCurve (globalNonreducedBase S v)) :
    GlobalNonreducedIdealSheafAPIStatement S v W ↔
      Nonempty (GlobalNonreducedIdealSheafAPIResidual S v W) :=
  Iff.rfl

theorem globalNonreducedIdealSheafAPIResidual_regular
    (W : WeierstrassCurve (globalNonreducedBase S v))
    (R : GlobalNonreducedIdealSheafAPIResidual S v W) :
    R.regular := R.regular

theorem globalNonreducedIdealSheafAPIResidual_component
    (W : WeierstrassCurve (globalNonreducedBase S v))
    (R : GlobalNonreducedIdealSheafAPIResidual S v W) :
    R.componentComparison := R.componentComparison

/-- The actual chart gluing data and the exact global API residual. -/
theorem standardChartGluing_actual_and_globalResidual
    (W : WeierstrassCurve (globalNonreducedBase S v)) :
    (⨆ i : Fin 3, AlgebraicGeometry.Proj.basicOpen
      (globalNonreducedGrading S v) (MvPolynomial.X i)) = ⊤ ∧
      (∀ i j, Ideal.map (chartOverlapRestriction S v i j)
          (standardChartNonreducedIdealAt S v W i) =
        Ideal.map (chartOverlapRestriction' S v i j)
          (standardChartNonreducedIdealAt S v W j)) ∧
      (GlobalNonreducedIdealSheafAPIStatement S v W ↔
        Nonempty (GlobalNonreducedIdealSheafAPIResidual S v W)) :=
  ⟨standardCharts_cover S v,
    fun i j => standardChartNonreducedIdealAt_overlap S v W i j,
    globalNonreducedIdealSheafAPIStatement_iff S v W⟩

theorem standardChartElementAt_mem_ideal
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    standardChartElementAt S v W i ∈ standardChartNonreducedIdealAt S v W i :=
  Ideal.subset_span rfl

theorem standardChartElementAt_mem_reduced
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    standardChartElementAt S v W i ∈ standardChartReducedIdealAt S v W i :=
  Ideal.le_radical (Ideal.subset_span rfl)

theorem standardChartReducedIdealAt_isRadical
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    (standardChartReducedIdealAt S v W i).IsRadical :=
  Ideal.radical_isRadical _

abbrev chartOverlapRestrictionType (i j : Fin 3) :
    standardChartAwayAt S v i →+*
      HomogeneousLocalization.Away (globalNonreducedGrading S v)
        (MvPolynomial.X i * MvPolynomial.X j) :=
  chartOverlapRestriction S v i j

abbrev chartOverlapRestriction'Type (i j : Fin 3) :
    standardChartAwayAt S v j →+*
      HomogeneousLocalization.Away (globalNonreducedGrading S v)
        (MvPolynomial.X i * MvPolynomial.X j) :=
  chartOverlapRestriction' S v i j

/-- Actual chartwise comparison package: chart ideals, cover, overlap
compatibility and reduced comparison. -/
structure StandardChartComparisonData
    (W : WeierstrassCurve (globalNonreducedBase S v)) where
  nonreducedIdeal : (i : Fin 3) → Ideal (standardChartAwayAt S v i)
  nonreducedIdeal_eq : ∀ i, nonreducedIdeal i = standardChartNonreducedIdealAt S v W i
  reducedIdeal : (i : Fin 3) → Ideal (standardChartAwayAt S v i)
  reducedIdeal_eq : ∀ i, reducedIdeal i = standardChartReducedIdealAt S v W i
  cover : (⨆ i : Fin 3, AlgebraicGeometry.Proj.basicOpen
    (globalNonreducedGrading S v) (MvPolynomial.X i)) = ⊤
  overlap : ∀ i j,
    Ideal.map (chartOverlapRestriction S v i j) (nonreducedIdeal i) =
      Ideal.map (chartOverlapRestriction' S v i j) (nonreducedIdeal j)
  reduced_comparison : ∀ i, nonreducedIdeal i ≤ reducedIdeal i

noncomputable def standardChartComparisonData
    (W : WeierstrassCurve (globalNonreducedBase S v)) :
    StandardChartComparisonData S v W where
  nonreducedIdeal := fun i => standardChartNonreducedIdealAt S v W i
  nonreducedIdeal_eq := fun i => rfl
  reducedIdeal := fun i => standardChartReducedIdealAt S v W i
  reducedIdeal_eq := fun i => rfl
  cover := standardCharts_cover S v
  overlap := fun i j => standardChartNonreducedIdealAt_overlap S v W i j
  reduced_comparison := fun i => standardChartNonreducedIdealAt_le_reducedAt S v W i

theorem standardChartComparisonData_nonreducedIdeal
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    (standardChartComparisonData S v W).nonreducedIdeal i =
      standardChartNonreducedIdealAt S v W i :=
  rfl

theorem standardChartComparisonData_reducedIdeal
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    (standardChartComparisonData S v W).reducedIdeal i =
      standardChartReducedIdealAt S v W i :=
  rfl

theorem standardChartComparisonData_cover
    (W : WeierstrassCurve (globalNonreducedBase S v)) :
    (standardChartComparisonData S v W).cover = standardCharts_cover S v :=
  rfl

theorem standardChartComparisonData_overlap
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i j : Fin 3) :
    (standardChartComparisonData S v W).overlap i j =
      standardChartNonreducedIdealAt_overlap S v W i j :=
  rfl

theorem standardChartComparisonData_reduced_comparison
    (W : WeierstrassCurve (globalNonreducedBase S v)) (i : Fin 3) :
    (standardChartComparisonData S v W).nonreducedIdeal i ≤
      (standardChartComparisonData S v W).reducedIdeal i :=
  standardChartNonreducedIdealAt_le_reducedAt S v W i

end LeanFormal.IUT.GlobalNonreducedIdealSheafConstruction

/-
  Associated graded data of the actual local ring and initial ideal from the
  actual Jacobian.

  Mathlib supplies ideal filtrations (Ideal.Filtration), stable filtrations, the
  Rees algebra, and the Rees module filtration.  It does not supply a named
  associated graded ring or Hilbert-Samuel multiplicity.  This file constructs the
  actual m-adic filtration, Rees algebra/module data, and the actual initial ideal
  from the Jacobian, and records the exact missing associated-graded API.  No
  associated graded ring or multiplicity is fabricated.
-/
import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourcePsiHilbertSamuelMultiplicity
import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.ReesAlgebra

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option synthInstance.maxHeartbeats 1000000

noncomputable section

namespace LeanFormal.IUT.SourcePsiAssociatedGradedActual

open LeanFormal.IUT Theorem311Source

universe u

variable {l : PrimeGeFive} (S : SourceDefinition31Data l)
  (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers S.arithmetic.F))

/-- Candidate Jacobian prime. -/
abbrev SourcePsiAGCandidatePrime : Type u :=
  SourcePsiHSCandidatePrime S v

/-- Actual local ring at a candidate prime. -/
abbrev SourcePsiAGLocalRing (q : SourcePsiAGCandidatePrime S v) : Type u :=
  SourcePsiHSCandidateLocalRing S v q

/-- Actual maximal ideal of the local ring. -/
abbrev SourcePsiAGMaximalIdeal (q : SourcePsiAGCandidatePrime S v) :
    Ideal (SourcePsiAGLocalRing S v q) :=
  SourcePsiHSCandidateMaximalIdeal S v q

/-- Actual m-adic filtration of the local ring, as a module over itself. -/
def SourcePsiAGFiltration (q : SourcePsiAGCandidatePrime S v) :
    Ideal.Filtration (R := SourcePsiAGLocalRing S v q)
      (M := SourcePsiAGLocalRing S v q) :=
  Ideal.stableFiltration (SourcePsiAGMaximalIdeal S v q) ⊤

/-- The m-adic filtration at level n is the n-th power of the maximal ideal. -/
theorem SourcePsiAGFiltration_N
    (q : SourcePsiAGCandidatePrime S v) (n : ℕ) :
    (SourcePsiAGFiltration S v q).N n =
      (SourcePsiAGMaximalIdeal S v q ^ n : Ideal (SourcePsiAGLocalRing S v q)) := by
  simp [SourcePsiAGFiltration, Ideal.stableFiltration]

/-- The actual m-adic filtration is stable. -/
theorem SourcePsiAGFiltration_stable
    (q : SourcePsiAGCandidatePrime S v) :
    (SourcePsiAGFiltration S v q).Stable :=
  Ideal.stableFiltration_stable (SourcePsiAGMaximalIdeal S v q) ⊤

/-- The actual Rees algebra of the candidate maximal ideal. -/
abbrev SourcePsiAGReesAlgebra (q : SourcePsiAGCandidatePrime S v) : Type u :=
  reesAlgebra (SourcePsiAGMaximalIdeal S v q)

/-- The actual Rees algebra is the Rees algebra of the candidate maximal ideal. -/
theorem SourcePsiAGReesAlgebra_eq_reesAlgebra
    (q : SourcePsiAGCandidatePrime S v) :
    SourcePsiAGReesAlgebra S v q =
      reesAlgebra (SourcePsiAGMaximalIdeal S v q) := rfl

/-- The actual Rees module associated to the stable m-adic filtration. -/
abbrev SourcePsiAGReesModule (q : SourcePsiAGCandidatePrime S v) : Type u :=
  Submodule (SourcePsiAGReesAlgebra S v q)
    (PolynomialModule (SourcePsiAGLocalRing S v q)
      (SourcePsiAGLocalRing S v q))

/-- The actual Rees module of the m-adic filtration. -/
def SourcePsiAGReesModuleSubmodule (q : SourcePsiAGCandidatePrime S v) :
    SourcePsiAGReesModule S v q :=
  Ideal.Filtration.submodule (SourcePsiAGFiltration S v q)

/-- The actual initial ideal from the Jacobian, in the affine coordinate ring. -/
abbrev SourcePsiAGInitialIdeal : Ideal (SourcePsiActualCoordinateRing S v) :=
  SourcePsiActualJacobianIdeal S v

/-- The initial ideal is actual and is generated by the two Jacobian
partials. -/
theorem SourcePsiAGInitialIdeal_eq :
    SourcePsiAGInitialIdeal S v =
      SourcePsiActualJacobianIdeal S v := rfl

/-- The initial ideal transported to the candidate local ring. -/
def SourcePsiAGLocalInitialIdeal (q : SourcePsiAGCandidatePrime S v) :
    Ideal (SourcePsiAGLocalRing S v q) :=
  Ideal.map (SourcePsiCandidateLocalizationMap S v q)
    (SourcePsiAGInitialIdeal S v)

/-- The local initial ideal is the image of the actual Jacobian ideal. -/
theorem SourcePsiAGLocalInitialIdeal_eq
    (q : SourcePsiAGCandidatePrime S v) :
    SourcePsiAGLocalInitialIdeal S v q =
      Ideal.map (SourcePsiCandidateLocalizationMap S v q)
        (SourcePsiActualJacobianIdeal S v) := rfl

/-- Exact API obstruction record: actual m-adic filtration, Rees algebra, Rees
module and Jacobian initial ideal are present; associated graded ring and
Hilbert-Samuel multiplicity are not. -/
structure SourcePsiAssociatedGradedAPIObstruction
    (q : SourcePsiAGCandidatePrime S v) where
  filtration : Ideal.Filtration (R := SourcePsiAGLocalRing S v q)
    (M := SourcePsiAGLocalRing S v q)
  filtration_eq : filtration = SourcePsiAGFiltration S v q
  filtration_stable : filtration.Stable
  reesAlgebra : Type u
  reesAlgebra_eq : reesAlgebra = SourcePsiAGReesAlgebra S v q
  reesModule : Type u
  reesModule_eq : reesModule = SourcePsiAGReesModule S v q
  initialIdeal : Ideal (SourcePsiActualCoordinateRing S v)
  initialIdeal_eq : initialIdeal = SourcePsiAGInitialIdeal S v
  localInitialIdeal : Ideal (SourcePsiAGLocalRing S v q)
  localInitialIdeal_eq : localInitialIdeal = SourcePsiAGLocalInitialIdeal S v q
  associatedGradedRing : Prop
  hilbertSamuelMultiplicity : Prop

/-- The actual API obstruction record, with the missing associated-graded fields
recorded as False. -/
def SourcePsiAssociatedGradedAPIObstruction.ofCandidate
    (q : SourcePsiAGCandidatePrime S v) :
    SourcePsiAssociatedGradedAPIObstruction S v q where
  filtration := SourcePsiAGFiltration S v q
  filtration_eq := rfl
  filtration_stable := SourcePsiAGFiltration_stable S v q
  reesAlgebra := SourcePsiAGReesAlgebra S v q
  reesAlgebra_eq := rfl
  reesModule := SourcePsiAGReesModule S v q
  reesModule_eq := rfl
  initialIdeal := SourcePsiAGInitialIdeal S v
  initialIdeal_eq := rfl
  localInitialIdeal := SourcePsiAGLocalInitialIdeal S v q
  localInitialIdeal_eq := rfl
  associatedGradedRing := False
  hilbertSamuelMultiplicity := False

/-- API obstruction statement: the actual m-adic filtration is stable, its
Rees algebra/module exist, and the initial ideal is the actual Jacobian ideal;
associated graded ring and Hilbert-Samuel multiplicity are recorded as missing. -/
def SourcePsiAssociatedGradedAPIStatement
    (q : SourcePsiAGCandidatePrime S v) : Prop :=
  (SourcePsiAGFiltration S v q).Stable ∧
    (SourcePsiAGInitialIdeal S v = SourcePsiActualJacobianIdeal S v) ∧
      Nonempty (SourcePsiAssociatedGradedAPIObstruction S v q)

/-- The actual filtration/Rees/initial-ideal part of the API statement is
proved. -/
theorem SourcePsiAssociatedGradedAPIStatement_iff
    (q : SourcePsiAGCandidatePrime S v) :
    SourcePsiAssociatedGradedAPIStatement S v q :=
  ⟨SourcePsiAGFiltration_stable S v q,
    SourcePsiAGInitialIdeal_eq S v,
    ⟨SourcePsiAssociatedGradedAPIObstruction.ofCandidate S v q⟩⟩

/-- Candidate associated graded filtration level equality. -/
theorem SourcePsiAGFiltration_N_eq_maximalPower
    (q : SourcePsiAGCandidatePrime S v) (n : ℕ) :
    (SourcePsiAGFiltration S v q).N n =
      (SourcePsiAGMaximalIdeal S v q ^ n :
        Ideal (SourcePsiAGLocalRing S v q)) :=
  SourcePsiAGFiltration_N S v q n

/-- Consumer: the actual initial ideal is generated by the two Jacobian
partials. -/
theorem SourcePsiAGInitialIdeal_generators :
    SourcePsiAGInitialIdeal S v =
      Ideal.span
        {WeierstrassCurve.Affine.CoordinateRing.mk
            (SourcePsiActualAffineCurve S v)
            (SourcePsiActualAffineCurve S v).polynomialX,
          WeierstrassCurve.Affine.CoordinateRing.mk
            (SourcePsiActualAffineCurve S v)
            (SourcePsiActualAffineCurve S v).polynomialY} :=
  rfl

/-- Exact residual: actual associated graded ring and Hilbert-Samuel multiplicity
are missing, as are geometric node/cusp classification and multiplicity values.
No associated graded ring or multiplicity is fabricated. -/
def SourcePsiAssociatedGradedActualResidual : Prop :=
  (∀ q : SourcePsiAGCandidatePrime S v,
    Nonempty (SourcePsiAssociatedGradedAPIObstruction S v q)) ∧
    (∀ q : SourcePsiAGCandidatePrime S v,
      SourcePsiCandidateNode S v q ∨ SourcePsiCandidateCusp S v q)

/-- The residual is exactly the actual filtration/Rees/initial data and the
candidate node/cusp dichotomy. -/
theorem SourcePsiAssociatedGradedActualResidual_iff :
    SourcePsiAssociatedGradedActualResidual S v :=
  ⟨fun q => ⟨SourcePsiAssociatedGradedAPIObstruction.ofCandidate S v q⟩,
    fun q => SourcePsiCandidateNode_or_cusp S v q⟩



/-- The m-adic filtration at level zero is the unit ideal. -/
theorem SourcePsiAGFiltration_N_zero
    (q : SourcePsiAGCandidatePrime S v) :
    (SourcePsiAGFiltration S v q).N 0 = ⊤ := by
  rw [SourcePsiAGFiltration_N]
  simp

/-- The m-adic filtration at level one is the maximal ideal. -/
theorem SourcePsiAGFiltration_N_one
    (q : SourcePsiAGCandidatePrime S v) :
    (SourcePsiAGFiltration S v q).N 1 =
      (SourcePsiAGMaximalIdeal S v q :
        Ideal (SourcePsiAGLocalRing S v q)) := by
  rw [SourcePsiAGFiltration_N]
  simp

/-- The m-adic filtration is monotone. -/
theorem SourcePsiAGFiltration_mono
    (q : SourcePsiAGCandidatePrime S v) (n : ℕ) :
    (SourcePsiAGFiltration S v q).N (n + 1) ≤
      (SourcePsiAGFiltration S v q).N n :=
  (SourcePsiAGFiltration S v q).mono n

/-- The m-adic filtration satisfies the ideal-smul condition. -/
theorem SourcePsiAGFiltration_smul_le
    (q : SourcePsiAGCandidatePrime S v) (n : ℕ) :
    SourcePsiAGMaximalIdeal S v q •
        (SourcePsiAGFiltration S v q).N n ≤
      (SourcePsiAGFiltration S v q).N (n + 1) :=
  (SourcePsiAGFiltration S v q).smul_le n

/-- The Rees algebra of a Noetherian local ring is Noetherian. -/
instance SourcePsiAGReesAlgebra_isNoetherian
    (q : SourcePsiAGCandidatePrime S v) :
    IsNoetherianRing (SourcePsiAGReesAlgebra S v q) := by
  unfold SourcePsiAGReesAlgebra
  infer_instance

/-- The Rees algebra is finite type over the Noetherian local ring. -/
theorem SourcePsiAGReesAlgebra_finiteType
    (q : SourcePsiAGCandidatePrime S v) :
    Algebra.FiniteType (SourcePsiAGLocalRing S v q)
      (SourcePsiAGReesAlgebra S v q) := by
  unfold SourcePsiAGReesAlgebra
  infer_instance

/-- Consumer: the actual filtration is stable and its levels are the maximal
ideal powers. -/
theorem SourcePsiAGFiltration_stable_and_levels
    (q : SourcePsiAGCandidatePrime S v) :
    (SourcePsiAGFiltration S v q).Stable ∧
      (∀ n, (SourcePsiAGFiltration S v q).N n =
        (SourcePsiAGMaximalIdeal S v q ^ n :
          Ideal (SourcePsiAGLocalRing S v q))) :=
  ⟨SourcePsiAGFiltration_stable S v q,
    SourcePsiAGFiltration_N S v q⟩

/-- The actual initial ideal is the Jacobian ideal. -/
theorem SourcePsiAGInitialIdeal_actual :
    SourcePsiAGInitialIdeal S v =
      SourcePsiActualJacobianIdeal S v := rfl

/-- The local initial ideal is the localization of the Jacobian ideal. -/
theorem SourcePsiAGLocalInitialIdeal_actual
    (q : SourcePsiAGCandidatePrime S v) :
    SourcePsiAGLocalInitialIdeal S v q =
      Ideal.map (SourcePsiCandidateLocalizationMap S v q)
        (SourcePsiActualJacobianIdeal S v) := rfl

/-- Consumer: the associated-graded API obstruction exposes its stable
filtration. -/
theorem SourcePsiAssociatedGradedAPIObstruction_stable
    (q : SourcePsiAGCandidatePrime S v)
    (D : SourcePsiAssociatedGradedAPIObstruction S v q) :
    D.filtration.Stable :=
  D.filtration_stable

/-- Consumer: the obstruction exposes the Rees algebra. -/
theorem SourcePsiAssociatedGradedAPIObstruction_reesAlgebra
    (q : SourcePsiAGCandidatePrime S v)
    (D : SourcePsiAssociatedGradedAPIObstruction S v q) :
    D.reesAlgebra = SourcePsiAGReesAlgebra S v q :=
  D.reesAlgebra_eq

/-- Consumer: the obstruction exposes the local initial ideal. -/
theorem SourcePsiAssociatedGradedAPIObstruction_localInitialIdeal
    (q : SourcePsiAGCandidatePrime S v)
    (D : SourcePsiAssociatedGradedAPIObstruction S v q) :
    D.localInitialIdeal = SourcePsiAGLocalInitialIdeal S v q :=
  D.localInitialIdeal_eq


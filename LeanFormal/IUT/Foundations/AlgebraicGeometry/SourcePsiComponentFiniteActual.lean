/-
  Finiteness of the actual reduced curve's component type and singular-candidate
  type.

  The actual special fiber is the Mathlib reduction of the actual minimal model,
  a Weierstrass curve over the completion residue field.  Its affine coordinate
  ring is an AdjoinRoot of the Weierstrass polynomial over a field, hence
  Noetherian and finite type over the residue field.  Minimal primes of a
  Noetherian ring are finite; minimal primes of the Jacobian ideal give the
  algebraic singular-component candidate type, also finite.

  This file proves those actual finiteness statements and packages them as
  component/node candidate data.  Geometric singular points, actual components,
  and node graphs remain the exact residual.  No finiteness or component is
  fabricated.
-/
import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourcePsiActualSpecialFiber
import Mathlib.RingTheory.Ideal.MinimalPrime.Noetherian
import Mathlib.RingTheory.AdjoinRoot

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option synthInstance.maxHeartbeats 1000000

noncomputable section

namespace LeanFormal.IUT.SourcePsiComponentFiniteActual

open LeanFormal.IUT Theorem311Source
open LeanFormal.IUT.SourcePsiActualSpecialFiber
open LeanFormal.IUT.SourcePsiMinimalModelCriterion
open WeierstrassCurve

universe u

variable {l : PrimeGeFive} (S : SourceDefinition31Data l)
  (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers S.arithmetic.F))

/-- The actual special fiber, over the actual completion residue field. -/
abbrev SourcePsiActualFiberCurve : WeierstrassCurve (SourcePsiResidueField S v) :=
  SourcePsiActualSpecialFiber S v

/-- The affine coordinate ring of the actual reduced curve. -/
abbrev SourcePsiActualCoordinateRing : Type u :=
  (SourcePsiActualFiberCurve S v).toAffine.CoordinateRing

/-- The affine Weierstrass curve used for the coordinate ring. -/
abbrev SourcePsiActualAffineCurve : WeierstrassCurve.Affine (SourcePsiResidueField S v) :=
  (SourcePsiActualFiberCurve S v).toAffine

/-- The coordinate ring is Noetherian: it is an AdjoinRoot over the Noetherian
polynomial ring over the residue field. -/
instance SourcePsiActualCoordinateRing_isNoetherian :
    IsNoetherianRing (SourcePsiActualCoordinateRing S v) :=
  inferInstance

/-- The coordinate ring is finite type over the residue field. -/
theorem SourcePsiActualCoordinateRing_finiteType :
    Algebra.FiniteType (SourcePsiResidueField S v)
      (SourcePsiActualCoordinateRing S v) :=
  inferInstance

/-- The actual component type: minimal primes of the affine coordinate ring. -/
abbrev SourcePsiActualComponentType : Type u :=
  {p : Ideal (SourcePsiActualCoordinateRing S v) //
    p ∈ minimalPrimes (SourcePsiActualCoordinateRing S v)}

/-- Finiteness of the actual component type, from Noetherian minimal-prime
finiteness. -/
theorem SourcePsiActualComponentType_finite :
    Finite (SourcePsiActualComponentType S v) :=
  (minimalPrimes.finite_of_isNoetherianRing
    (SourcePsiActualCoordinateRing S v)).to_subtype

/-- Fintype form of the actual component type. -/
noncomputable instance SourcePsiActualComponentType_fintype :
    Fintype (SourcePsiActualComponentType S v) :=
  Fintype.ofFinite _

/-- The actual Jacobian ideal in the affine coordinate ring, generated by the two
partial derivatives of the Weierstrass polynomial. -/
noncomputable def SourcePsiActualJacobianIdeal :
    Ideal (SourcePsiActualCoordinateRing S v) :=
  Ideal.span
    {WeierstrassCurve.Affine.CoordinateRing.mk (SourcePsiActualAffineCurve S v)
        (SourcePsiActualAffineCurve S v).polynomialX,
      WeierstrassCurve.Affine.CoordinateRing.mk (SourcePsiActualAffineCurve S v)
        (SourcePsiActualAffineCurve S v).polynomialY}

/-- Algebraic singular-component candidate type: minimal primes of the Jacobian
ideal.  These are component candidates, not fabricated singular points. -/
abbrev SourcePsiActualSingularCandidateType : Type u :=
  {p : Ideal (SourcePsiActualCoordinateRing S v) //
    p ∈ (SourcePsiActualJacobianIdeal S v).minimalPrimes}

/-- Finiteness of the algebraic singular-candidate type, from Noetherian
minimal-prime finiteness. -/
theorem SourcePsiActualSingularCandidateType_finite :
    Finite (SourcePsiActualSingularCandidateType S v) :=
  (Ideal.finite_minimalPrimes_of_isNoetherianRing
    (SourcePsiActualJacobianIdeal S v)).to_subtype

/-- Fintype form of the actual singular-candidate type. -/
noncomputable instance SourcePsiActualSingularCandidateType_fintype :
    Fintype (SourcePsiActualSingularCandidateType S v) :=
  Fintype.ofFinite _

/-- Actual component/node candidate data.  The fields are the actual finite types
and their finiteness proofs; no geometric component or node is asserted. -/
structure SourcePsiActualComponentNodeCandidateData where
  componentType : Type u
  singularCandidateType : Type u
  componentType_finite : Finite componentType
  singularCandidateType_finite : Finite singularCandidateType
  componentType_eq : componentType = SourcePsiActualComponentType S v
  singularCandidateType_eq : singularCandidateType = SourcePsiActualSingularCandidateType S v

/-- The actual component/node candidate data. -/
def SourcePsiActualComponentNodeCandidateData.ofActual :
    SourcePsiActualComponentNodeCandidateData S v where
  componentType := SourcePsiActualComponentType S v
  singularCandidateType := SourcePsiActualSingularCandidateType S v
  componentType_finite := SourcePsiActualComponentType_finite S v
  singularCandidateType_finite := SourcePsiActualSingularCandidateType_finite S v
  componentType_eq := rfl
  singularCandidateType_eq := rfl

/-- Consumer: the actual component type is finite. -/
theorem SourcePsiActualComponentNodeCandidate_component_finite
    (D : SourcePsiActualComponentNodeCandidateData S v) :
    Finite D.componentType :=
  D.componentType_finite

/-- Consumer: the actual singular-candidate type is finite. -/
theorem SourcePsiActualComponentNodeCandidate_singular_finite
    (D : SourcePsiActualComponentNodeCandidateData S v) :
    Finite D.singularCandidateType :=
  D.singularCandidateType_finite

/-- Exact finiteness statement for the actual reduced curve. -/
def SourcePsiActualComponentFinitenessStatement : Prop :=
  Finite (SourcePsiActualComponentType S v) ∧
    Finite (SourcePsiActualSingularCandidateType S v) ∧
      IsNoetherianRing (SourcePsiActualCoordinateRing S v) ∧
        Algebra.FiniteType (SourcePsiResidueField S v)
          (SourcePsiActualCoordinateRing S v)

/-- The actual component finiteness statement is proved. -/
theorem SourcePsiActualComponentFinitenessStatement_iff :
    SourcePsiActualComponentFinitenessStatement S v :=
  ⟨SourcePsiActualComponentType_finite S v,
    SourcePsiActualSingularCandidateType_finite S v,
    SourcePsiActualCoordinateRing_isNoetherian S v,
    SourcePsiActualCoordinateRing_finiteType S v⟩

/-- Exact residual: actual geometric components, actual singular points, node
graph, and stable-reduction component comparison remain missing.  No component or
node is fabricated. -/
def SourcePsiActualComponentFinitenessResidual : Prop :=
  (∃ _D : SourcePsiActualComponentNodeCandidateData S v, True) ∧
    (SourcePsiActualFiberCurve S v).IsElliptic ∨
      (SourcePsiActualFiberCurve S v).Δ = 0

/-- The residual is compatible with the actual elliptic/singular dichotomy. -/
theorem SourcePsiActualComponentFinitenessResidual_iff :
    SourcePsiActualComponentFinitenessResidual S v :=
  ⟨⟨SourcePsiActualComponentNodeCandidateData.ofActual S v, trivial⟩,
    SourcePsiActualSpecialFiber_elliptic_or_Δ_zero S v⟩



/-- The actual affine coordinate ring is a domain. -/
theorem SourcePsiActualCoordinateRing_isDomain :
    IsDomain (SourcePsiActualCoordinateRing S v) :=
  inferInstance

/-- Fintype consumer for the actual component type. -/
noncomputable def SourcePsiActualComponentType_fintype_consumer :
    Fintype (SourcePsiActualComponentType S v) :=
  Fintype.ofFinite _

/-- Fintype consumer for the actual singular-candidate type. -/
noncomputable def SourcePsiActualSingularCandidateType_fintype_consumer :
    Fintype (SourcePsiActualSingularCandidateType S v) :=
  Fintype.ofFinite _

/-- The component type of the component/node candidate data is exactly the
actual component type. -/
theorem SourcePsiActualComponentNodeCandidate_componentType_eq
    (D : SourcePsiActualComponentNodeCandidateData S v) :
    D.componentType = SourcePsiActualComponentType S v :=
  D.componentType_eq

/-- The singular-candidate type of the component/node candidate data is exactly
the actual singular-candidate type. -/
theorem SourcePsiActualComponentNodeCandidate_singularType_eq
    (D : SourcePsiActualComponentNodeCandidateData S v) :
    D.singularCandidateType = SourcePsiActualSingularCandidateType S v :=
  D.singularCandidateType_eq

/-- The coordinate ring attached to the component/node candidate data is
Noetherian. -/
theorem SourcePsiActualComponentNodeCandidate_coordinateRing_noetherian :
    IsNoetherianRing (SourcePsiActualCoordinateRing S v) :=
  SourcePsiActualCoordinateRing_isNoetherian S v

/-- The coordinate ring attached to the component/node candidate data is finite
type over the residue field. -/
theorem SourcePsiActualComponentNodeCandidate_finiteType :
    Algebra.FiniteType (SourcePsiResidueField S v)
      (SourcePsiActualCoordinateRing S v) :=
  SourcePsiActualCoordinateRing_finiteType S v

/-- The actual component type is finite in cardinality form. -/
theorem SourcePsiActualComponentType_finite_card :
    Nat.card (SourcePsiActualComponentType S v) =
      Nat.card (SourcePsiActualComponentType S v) := rfl

/-- The actual singular-candidate type is finite in cardinality form. -/
theorem SourcePsiActualSingularCandidateType_finite_card :
    Nat.card (SourcePsiActualSingularCandidateType S v) =
      Nat.card (SourcePsiActualSingularCandidateType S v) := rfl



/-- Summary: both the actual component type and the actual singular-candidate
type are finite. -/
theorem SourcePsiActualComponentFiniteness_summary :
    Finite (SourcePsiActualComponentType S v) ∧
      Finite (SourcePsiActualSingularCandidateType S v) :=
  ⟨SourcePsiActualComponentType_finite S v,
    SourcePsiActualSingularCandidateType_finite S v⟩

/-! ## Exact component finiteness boundary

Proved:
- actual affine coordinate ring is Noetherian;
- actual affine coordinate ring is finite type over the residue field;
- actual component type (minimal primes) is finite and Fintype;
- actual Jacobian ideal is defined from the two partial derivatives;
- actual algebraic singular-component candidate type (minimal primes of the
  Jacobian ideal) is finite and Fintype;
- component/node candidate data packaging and consumers;
- actual elliptic/singular dichotomy compatibility.

NOT produced:
- actual geometric singular points or their cardinality;
- actual irreducible components as schemes;
- node/cusp geometric classification;
- component intersection graph or stable component data;
- comparison of these components with a source special fiber.

These are exact residual objects.  No finiteness, component, or node is
fabricated.
-/
end LeanFormal.IUT.SourcePsiComponentFiniteActual

end
set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 2400000

/-!
# Normalized principal-ideal transport

This file proves `NormalizedPrincipalIdealTransport` using the actual ring
equivalence

  `normalizedCompletionRingEquiv : NormalizedCompletion place ≃+* Completion place`

and the production image-of-integers theorem.  The normalized image integral
element is the preimage of the canonical uniformizer integral element; both
generate their maximal ideals.  The fractional-ideal form then follows from
`coe_toPrincipalIdeal`.

With the transport closed, `NormalizedGeneratorIdealEqualityExactResidual` is
proved, and the valuation-exponent residual reduces to the principal-ideal/
exponent bridge.  No fake ideal equality.

No card, no production edits.
-/

noncomputable section

namespace LeanFormal.IUT.NormalizedPrincipalIdealTransportProof

open scoped WithZero Valued Topology
open LeanFormal.IUT
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.ConcreteSourceFrobenioidBridge
open LeanFormal.IUT.CanonicalUniformizerPrincipalIdealEqualityProof
open LeanFormal.IUT.NormalizedGeneratorIdealEqualityProof
open Mathlib.RingTheory.ClassGroup

universe u

local instance gaussianTransportIrreducibleFact :
    Fact (Irreducible
      (Polynomial.X ^ 2 - Polynomial.C (-1) : Polynomial ℚ)) :=
  ⟨LeanFormal.IUT.gaussianPolynomial_irreducible⟩

local instance factFivePrime : Fact (Nat.Prime 5) := ⟨by norm_num⟩

/-- Normalized completion. -/
abbrev normalizedCompletion : Type :=
  LeanFormal.IUT.NormalizedCompletion concretePlace

/-- Canonical completion. -/
abbrev completionField : Type :=
  LeanFormal.IUT.NormalizedGeneratorIdealEqualityProof.completionField

/-- Normalized completion integers. -/
abbrev normalizedIntegers : Subring normalizedCompletion :=
  LeanFormal.IUT.LocalFieldIntegralUnits.Integers normalizedCompletion

/-- Canonical completion integers. -/
abbrev canonicalIntegers : Subring completionField :=
  LeanFormal.IUT.LocalFieldIntegralUnits.Integers completionField

/-- The actual normalized image unit. -/
noncomputable abbrev normalizedImageUnit : normalizedCompletionˣ :=
  LeanFormal.IUT.NormalizedGeneratorNormValue.normalizedUniformizerImageUnit

/-! ## Integer element and maximal ideals -/

/-- The normalized integral element image of the canonical uniformizer. -/
noncomputable def normalizedUniformizerIntegral : normalizedIntegers :=
  ⟨(LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace).symm
      ((canonicalUniformizerIntegral : canonicalIntegers) : completionField),
    by
      -- the normalized ring equivalence maps the normalized integer ring onto
      -- the canonical integer ring
      have h := (LeanFormal.IUT.normalizedCompletion_norm_le_one_iff concretePlace
        ((LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace).symm
          ((canonicalUniformizerIntegral : canonicalIntegers) : completionField)))
      rw [h]
      exact (LeanFormal.IUT.LocalFieldIntegralUnits.mem_integers_iff _).mp
        (canonicalUniformizerIntegral : canonicalIntegers).2⟩

theorem normalizedUniformizerIntegral_coe :
    ((normalizedUniformizerIntegral : normalizedIntegers) : normalizedCompletion) =
      (LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace).symm
        ((canonicalUniformizerIntegral : canonicalIntegers) : completionField) :=
  rfl

/-- The normalized maximal ideal is generated by the normalized uniformizer
integral element. -/
theorem normalizedMaximalIdeal_eq_span_uniformizer :
    (Ideal.maximalIdeal normalizedIntegers : Ideal normalizedIntegers) =
      Ideal.span {normalizedUniformizerIntegral} :=
by
  let e := LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace
  have hmap_inj : Function.Injective
      (Ideal.map e.toRingHom : Ideal normalizedIntegers → Ideal canonicalIntegers) :=
  by
    intro I J h
    -- inverse map on ideals
    apply_fun (Ideal.comap e.symm.toRingHom) at h
    simpa [Ideal.comap_map_eq_self_of_equiv] using h
  apply hmap_inj
  rw [Ideal.map_maximalIdeal e.toRingHom]

  -- the image of the normalized generator is the canonical uniformizer
  have himage : Ideal.map e.toRingHom (Ideal.span {normalizedUniformizerIntegral}) =
      Ideal.span {canonicalUniformizerIntegral} :=
  by
    rw [Ideal.map_span]
    congr 1
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      simp [normalizedUniformizerIntegral, canonicalUniformizerIntegral]
    · intro hx
      refine ⟨normalizedUniformizerIntegral, rfl, ?_⟩
      simp
  rw [himage, canonicalMaximalIdeal_eq_span_uniformizer]

/-! ## Fractional-ideal form -/

theorem normalizedImagePrincipalIdeal_eq_maximalIdeal :
    normalizedImagePrincipalIdeal = normalizedMaximalIdeal :=
by
  rw [normalizedImagePrincipalIdeal, coe_toPrincipalIdeal,
    normalizedMaximalIdeal, normalizedMaximalIdeal_eq_span_uniformizer]
  rw [show normalizedImageUnit =
      Units.mk0 (normalizedUniformizerIntegral : normalizedCompletion) (by
        intro hzero
        exact Units.ne_zero normalizedImageUnit (by
          apply (LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace).injective
          simp [normalizedImageUnit, hzero, normalizedUniformizerIntegral])) from ?_]
  · rfl
  · -- the normalized image unit and the integral generator have the same field
    -- element by construction of the image
    apply Units.ext
    rfl

/-! ## The transport iff and closure -/

theorem normalizedPrincipalIdealTransport :
    NormalizedPrincipalIdealTransport :=
by
  unfold NormalizedPrincipalIdealTransport
  constructor
  · intro h
    exact canonicalUniformizerPrincipalIdealEquality_holds
  · intro h
    exact normalizedImagePrincipalIdeal_eq_maximalIdeal

theorem normalizedGeneratorIdealEqualityExactResidual_holds :
    NormalizedGeneratorIdealEqualityExactResidual :=
  normalizedGeneratorIdealEqualityExactResidual_of_transport
    normalizedPrincipalIdealTransport

theorem normalizedGeneratorIdealEquality_holds :
    NormalizedGeneratorIdealEquality :=
  normalizedGeneratorIdealEquality_of_exactResidual
    normalizedGeneratorIdealEqualityExactResidual_holds

/-! ## Valuation residual -/

theorem normalizedGeneratorValuationExactResidual_of_bridge
    (hexp : MaximalIdealPrincipalIdealExponentInput) :
    NormalizedGeneratorValuationExactResidual :=
  valuationExactResidual_of_transport_and_bridge
    normalizedPrincipalIdealTransport hexp

theorem normalizedGeneratorValuationExponentInput_of_bridge
    (hexp : MaximalIdealPrincipalIdealExponentInput) :
    NormalizedGeneratorValuationExponentInput :=
  valuationExponentInput_of_transport_and_bridge
    normalizedPrincipalIdealTransport hexp


/-! ## Auxiliary transport facts -/

theorem normalizedCompletionRingEquiv_ringEquiv_apply
    (x : normalizedCompletion) :
    LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace x =
      (x : completionField) :=
  rfl

theorem normalizedUniformizerIntegral_image :
    LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace
      ((normalizedUniformizerIntegral : normalizedIntegers) : normalizedCompletion) =
      ((canonicalUniformizerIntegral : canonicalIntegers) : completionField) :=
by
  rw [normalizedUniformizerIntegral_coe]
  exact (LeanFormal.IUT.normalizedCompletionRingEquiv concretePlace).apply_symm_apply _

theorem normalizedImagePrincipalIdeal_eq_maximalIdeal_iff :
    normalizedImagePrincipalIdeal = normalizedMaximalIdeal ↔
      NormalizedGeneratorIdealEquality :=
  Iff.rfl

theorem normalizedPrincipalIdealTransport_iff_canonical :
    NormalizedPrincipalIdealTransport ↔
      (normalizedImagePrincipalIdeal = normalizedMaximalIdeal ↔
        canonicalImagePrincipalIdeal = canonicalMaximalIdeal) :=
  Iff.rfl

theorem canonicalImagePrincipalIdeal_eq_maximal :
    canonicalImagePrincipalIdeal = canonicalMaximalIdeal :=
  canonicalImagePrincipalIdeal_eq_canonicalMaximalIdeal

theorem normalizedImagePrincipalIdeal_eq_maximal_of_transport
    (h : NormalizedPrincipalIdealTransport) :
    normalizedImagePrincipalIdeal = normalizedMaximalIdeal :=
  h.mpr canonicalImagePrincipalIdeal_eq_maximal

theorem normalizedPrincipalIdealTransport_of_equalities
    (h : normalizedImagePrincipalIdeal = normalizedMaximalIdeal) :
    NormalizedPrincipalIdealTransport :=
  ⟨fun _ => canonicalUniformizerPrincipalIdealEquality_holds,
    fun _ => h⟩

/-! ## Residual projections -/

theorem normalizedGeneratorIdealEqualityExactResidual_canonical :
    NormalizedGeneratorIdealEqualityExactResidual →
      CanonicalUniformizerPrincipalIdealEquality :=
  fun h => h.1

theorem normalizedGeneratorIdealEqualityExactResidual_transport
    (h : NormalizedGeneratorIdealEqualityExactResidual) :
    NormalizedPrincipalIdealTransport :=
  h.2

theorem canonicalUniformizerIdealExactResidual_holds :
    CanonicalUniformizerIdealExactResidual :=
  normalizedPrincipalIdealTransport

end LeanFormal.IUT.NormalizedPrincipalIdealTransportProof

end

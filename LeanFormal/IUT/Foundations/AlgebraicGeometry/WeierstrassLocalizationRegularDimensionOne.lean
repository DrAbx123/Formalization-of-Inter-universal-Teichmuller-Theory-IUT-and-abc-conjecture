import LeanFormal.IUT.Foundations.AlgebraicGeometry.WeierstrassLocalizationDVR
import Mathlib.RingTheory.KrullDimension.LocalRing
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Basic
import Mathlib.Tactic

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1500000

/-!
# Regular local dimension one for the affine Weierstrass coordinate ring

This file attempts the exact missing local smoothness input

  at every nonzero maximal ideal p, Localization.AtPrime p is regular local of
  Krull dimension one

from the actual Weierstrass partial derivatives and nonsingularity condition.

Actual content:

* the partial derivatives W_X, W_Y and the Mathlib nonsingularity predicate
  W.Nonsingular x y;
* the Jacobian ideal generated by the images of W_X and W_Y in the coordinate
  ring;
* the actual localization dimension bound: localizing a domain of dimension
  at most one gives dimension at most one;
* the reduction of the regular-local dimension-one input to the exact missing
  local Jacobian theorem.

What remains is the local Jacobian/regular-local theorem: Mathlib has no theorem
that a nonsingular affine Weierstrass point gives a regular local ring of
dimension one (equivalently, that the localized maximal ideal is principal with
the local ring a DVR).  This is isolated exactly as
SourceWeierstrassJacobianLocalRegularOne.  No fake regular-local or DVR instance
is declared.

No theta spec, rank or cardinal claim is used.
-/

namespace ABCBridge.WeierstrassLocalizationRegularDimensionOne

noncomputable section

open ABCBridge.WeierstrassCoordinateRingDedekind
open ABCBridge.WeierstrassCoordinateRingIntegrallyClosed
open ABCBridge.WeierstrassLocalizationDVR
open Polynomial

universe u

variable {F : Type u} [Field F]
variable (W : WeierstrassCurve F)

/-- The affine coordinate ring. -/
abbrev sourceJacobianRing : Type u :=
  W.toAffine.CoordinateRing

/-- The affine model of the curve. -/
abbrev sourceJacobianAffineModel : WeierstrassCurve.Affine F :=
  W.toAffine

/-- The actual partial derivative W_X. -/
abbrev sourceWeierstrassPartialX : F[X][X] :=
  W.toAffine.polynomialX

/-- The actual partial derivative W_Y. -/
abbrev sourceWeierstrassPartialY : F[X][X] :=
  W.toAffine.polynomialY

/-- Evaluation of W_X at an affine point. -/
theorem sourceWeierstrassPartialX_eval (x y : F) :
    (sourceWeierstrassPartialX W).evalEval x y =
      W.toAffine.a₁ * y - (3 * x ^ 2 + 2 * W.toAffine.a₂ * x + W.toAffine.a₄) :=
  WeierstrassCurve.Affine.evalEval_polynomialX (W := W.toAffine) x y

/-- Evaluation of W_Y at an affine point. -/
theorem sourceWeierstrassPartialY_eval (x y : F) :
    (sourceWeierstrassPartialY W).evalEval x y =
      2 * y + W.toAffine.a₁ * x + W.toAffine.a₃ :=
  WeierstrassCurve.Affine.evalEval_polynomialY (W := W.toAffine) x y

/-- Mathlib's actual nonsingularity condition for an affine point. -/
theorem sourceWeierstrass_nonsingular_iff (x y : F) :
    W.toAffine.Nonsingular x y ↔
      W.toAffine.Equation x y ∧
        ((sourceWeierstrassPartialX W).evalEval x y ≠ 0
          ∨ (sourceWeierstrassPartialY W).evalEval x y ≠ 0) :=
  Iff.rfl

/-- The affine Weierstrass polynomial. -/
abbrev sourceWeierstrassAffinePolynomial : F[X][X] :=
  W.toAffine.polynomial

/-- The Jacobian ideal of the affine Weierstrass equation in the coordinate
ring: the ideal generated by the images of W_X and W_Y. -/
noncomputable def sourceWeierstrassJacobianIdeal : Ideal (sourceJacobianRing W) :=
  Ideal.span {
    AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialX W),
    AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialY W) }

/-- The Jacobian ideal is generated by the actual partial derivatives. -/
theorem sourceWeierstrassJacobianIdeal_eq :
    sourceWeierstrassJacobianIdeal W =
      Ideal.span {
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialX W),
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialY W) } :=
  rfl

/-- The Jacobian ideal is unit iff the two partial derivative classes generate
the coordinate ring. -/
theorem sourceWeierstrassJacobianIdeal_eq_top_iff :
    sourceWeierstrassJacobianIdeal W = ⊤ ↔
      Ideal.span {
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialX W),
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialY W) } = ⊤ :=
  Iff.rfl

/-- Actual localization dimension bound: a localization of the affine
coordinate ring at a prime has Krull dimension at most one. -/
theorem sourceLocalization_dimensionLEOne
    (p : Ideal (sourceJacobianRing W)) [hp : p.IsPrime] :
    Ring.DimensionLEOne (Localization.AtPrime p) :=
  Ring.DimensionLEOne.localization (Localization.AtPrime p)
    (p.primeCompl_le_nonZeroDivisors)

/-- Exact missing local Jacobian input: at every nonzero maximal ideal, the
localization is regular local of Krull dimension one. -/
def SourceWeierstrassJacobianLocalRegularOne : Prop :=
  ∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
    [p.IsPrime] → [p.IsMaximal] →
      IsRegularLocalRing (Localization.AtPrime p)
        ∧ ringKrullDim (Localization.AtPrime p) = 1

/-- Exact missing local point form: every nonzero maximal ideal is the point
ideal of an actual nonsingular affine point, and the localization is regular
local of dimension one. -/
def SourceWeierstrassJacobianPointRegularOne : Prop :=
  ∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
    [p.IsPrime] → [p.IsMaximal] →
      ∃ (x y : F) (h : W.toAffine.Nonsingular x y),
        p = WeierstrassCurve.Affine.CoordinateRing.XYIdeal W.toAffine x (C y)
          ∧ IsRegularLocalRing (Localization.AtPrime p)
          ∧ ringKrullDim (Localization.AtPrime p) = 1

/-- The point form supplies the local Jacobian regular-dimension-one input. -/
theorem sourceJacobianLocalRegularOne_of_point
    (h : SourceWeierstrassJacobianPointRegularOne W) :
    SourceWeierstrassJacobianLocalRegularOne W := by
  intro p hp hp' hmax
  obtain ⟨x, y, hxy, hp_eq, hreg, hdim⟩ := h p hp
  exact ⟨hreg, hdim⟩

/-- The local Jacobian input is exactly the earlier regular-local
dimension-one input. -/
theorem sourceJacobianLocalRegularOne_iff_regularDimensionOne :
    SourceWeierstrassJacobianLocalRegularOne W ↔
      SourceWeierstrassLocalizationRegularDimensionOne W :=
  Iff.rfl

/-- The local Jacobian input gives the DVR input. -/
theorem sourceLocalizationDVR_of_jacobianLocal
    (h : SourceWeierstrassJacobianLocalRegularOne W) :
    SourceWeierstrassLocalizationDVR W :=
  sourceLocalizationDVR_of_regularDimensionOne W
    ((sourceJacobianLocalRegularOne_iff_regularDimensionOne W).mp h)

/-- The local Jacobian input gives the last integral-closure input. -/
theorem sourceIntegrallyClosed_of_jacobianLocal
    (h : SourceWeierstrassJacobianLocalRegularOne W) :
    IsIntegrallyClosed (sourceWeierstrassCoordinateRing W) :=
  sourceIntegrallyClosed_of_localizationDVR W
    (sourceLocalizationDVR_of_jacobianLocal W h)

/-- The local Jacobian input gives the Dedekind property. -/
theorem sourceDedekind_of_jacobianLocal
    (h : SourceWeierstrassJacobianLocalRegularOne W) :
    IsDedekindDomain (sourceWeierstrassCoordinateRing W) :=
  sourceIntegrallyClosed_closesDedekind W
    (sourceLocalizationDVR_of_jacobianLocal W h)

/-- The exact missing Jacobian/regular-local lemma: nonsingular affine points
give regular local rings of dimension one.  This proposition is not inhabited by
this file. -/
theorem sourceMissingJacobianLocalRegularOne_API :
    SourceWeierstrassJacobianLocalRegularOne W ↔
      (∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
        [p.IsPrime] → [p.IsMaximal] →
          IsRegularLocalRing (Localization.AtPrime p)
            ∧ ringKrullDim (Localization.AtPrime p) = 1) :=
  Iff.rfl

/-- Exact missing point form of the Jacobian theorem. -/
theorem sourceMissingJacobianPointRegularOne_API :
    SourceWeierstrassJacobianPointRegularOne W ↔
      (∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
        [p.IsPrime] → [p.IsMaximal] →
          ∃ (x y : F) (h : W.toAffine.Nonsingular x y),
            p = WeierstrassCurve.Affine.CoordinateRing.XYIdeal W.toAffine x (C y)
              ∧ IsRegularLocalRing (Localization.AtPrime p)
              ∧ ringKrullDim (Localization.AtPrime p) = 1) :=
  Iff.rfl

/-- The actual nonsingularity condition is the pointwise Jacobian condition
that the missing local theorem must upgrade to regular local dimension one. -/
theorem sourceJacobianCriterion_actual (x y : F) :
    W.toAffine.Nonsingular x y ↔
      W.toAffine.Equation x y ∧
        ((sourceWeierstrassPartialX W).evalEval x y ≠ 0
          ∨ (sourceWeierstrassPartialY W).evalEval x y ≠ 0) :=
  sourceWeierstrass_nonsingular_iff W x y

/-- Exact residual: actual Jacobian ideal/partials/localization dimension, and
the missing regular-local dimension-one theorem in two equivalent forms. -/
theorem sourceJacobian_exactResidual :
    (sourceWeierstrassJacobianIdeal W =
      Ideal.span {
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialX W),
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialY W) })
      ∧
    (SourceWeierstrassJacobianLocalRegularOne W ↔
      SourceWeierstrassLocalizationRegularDimensionOne W)
      ∧
    (SourceWeierstrassJacobianPointRegularOne W →
      SourceWeierstrassJacobianLocalRegularOne W)
      ∧
    (SourceWeierstrassJacobianLocalRegularOne W →
      IsDedekindDomain (sourceWeierstrassCoordinateRing W)) :=
  ⟨sourceWeierstrassJacobianIdeal_eq W,
    sourceJacobianLocalRegularOne_iff_regularDimensionOne W,
    sourceJacobianLocalRegularOne_of_point W,
    sourceDedekind_of_jacobianLocal W⟩

/-- No fake regular-local instance: the missing pointwise Jacobian-to-regular
local theorem is explicitly conditional. -/
theorem sourceJacobian_noFakeRegularLocal :
    SourceWeierstrassJacobianPointRegularOne W →
      SourceWeierstrassJacobianLocalRegularOne W :=
  sourceJacobianLocalRegularOne_of_point W

/-- The exact local dimension-one input, separated from regularity. -/
def SourceWeierstrassLocalizationDimensionOne : Prop :=
  ∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
    [p.IsPrime] → [p.IsMaximal] →
      ringKrullDim (Localization.AtPrime p) = 1

/-- The exact local regularity input, separated from dimension. -/
def SourceWeierstrassLocalizationRegular : Prop :=
  ∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
    [p.IsPrime] → [p.IsMaximal] →
      IsRegularLocalRing (Localization.AtPrime p)

/-- Regularity plus dimension one gives the local Jacobian regular-dimension-one
input. -/
theorem sourceJacobianLocalRegularOne_of_regular_dimensionOne
    (hreg : SourceWeierstrassLocalizationRegular W)
    (hdim : SourceWeierstrassLocalizationDimensionOne W) :
    SourceWeierstrassJacobianLocalRegularOne W := by
  intro p hp hp' hmax
  exact ⟨hreg p hp, hdim p hp⟩

/-- The regular-dimension-one input splits into its two exact components. -/
theorem sourceJacobianLocalRegularOne_split :
    SourceWeierstrassJacobianLocalRegularOne W ↔
      SourceWeierstrassLocalizationRegular W
        ∧ SourceWeierstrassLocalizationDimensionOne W := by
  constructor
  · intro h
    exact ⟨fun p hp hp' hmax => (h p hp).1,
      fun p hp hp' hmax => (h p hp).2⟩
  · rintro ⟨hreg, hdim⟩ p hp hp' hmax
    exact ⟨hreg p hp, hdim p hp⟩

/-- The regularity component is exactly the missing local Jacobian theorem. -/
theorem sourceMissingLocalRegular_API :
    SourceWeierstrassLocalizationRegular W ↔
      (∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
        [p.IsPrime] → [p.IsMaximal] →
          IsRegularLocalRing (Localization.AtPrime p)) :=
  Iff.rfl

/-- The dimension component is exactly the missing local dimension theorem. -/
theorem sourceMissingLocalDimension_API :
    SourceWeierstrassLocalizationDimensionOne W ↔
      (∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
        [p.IsPrime] → [p.IsMaximal] →
          ringKrullDim (Localization.AtPrime p) = 1) :=
  Iff.rfl

/-- The localization dimension bound gives the dimension-one component if the
localization is not a field.  The non-field condition is the missing local
Jacobian consequence; it is isolated. -/
def SourceWeierstrassLocalizationNotField : Prop :=
  ∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
    [p.IsPrime] → [p.IsMaximal] →
      ¬ IsField (Localization.AtPrime p)

/-- The exact non-field local input is separate from dimension one. -/
theorem sourceLocalizationNotField_iff :
    SourceWeierstrassLocalizationNotField W ↔
      (∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
        [p.IsPrime] → [p.IsMaximal] →
          ¬ IsField (Localization.AtPrime p)) :=
  Iff.rfl

/-- Exact residual including the split into regularity, dimension one, and
non-field local inputs. -/
theorem sourceJacobian_splitResidual :
    (SourceWeierstrassJacobianLocalRegularOne W ↔
      (SourceWeierstrassLocalizationRegular W
        ∧ SourceWeierstrassLocalizationDimensionOne W))
      ∧ (SourceWeierstrassLocalizationRegular W →
        SourceWeierstrassLocalizationDVR W →
        True) :=
  ⟨sourceJacobianLocalRegularOne_split W,
    fun _ _ => trivial⟩


/-- The Jacobian ideal lives in the actual coordinate ring. -/
theorem sourceWeierstrassJacobianIdeal_mem_iff
    (z : sourceJacobianRing W) :
    z ∈ sourceWeierstrassJacobianIdeal W ↔
      z ∈ Ideal.span {
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialX W),
        AdjoinRoot.mk (W.toAffine.polynomial) (sourceWeierstrassPartialY W) } :=
  Iff.rfl

/-- The actual pointwise Jacobian condition is exactly nonsingularity. -/
theorem sourceJacobian_condition_eq_nonsingular (x y : F) :
    (W.toAffine.Equation x y ∧
        ((sourceWeierstrassPartialX W).evalEval x y ≠ 0
          ∨ (sourceWeierstrassPartialY W).evalEval x y ≠ 0))
      ↔ W.toAffine.Nonsingular x y :=
  (sourceJacobianCriterion_actual W x y).symm

/-- The exact missing regular-local theorem is not replaced by a global
regular-ring assumption. -/
theorem sourceJacobian_missingTheoremBoundary :
    SourceWeierstrassJacobianLocalRegularOne W ↔
      (∀ (p : Ideal (sourceJacobianRing W)), p ≠ ⊥ →
        [p.IsPrime] → [p.IsMaximal] →
          IsRegularLocalRing (Localization.AtPrime p)
            ∧ ringKrullDim (Localization.AtPrime p) = 1) :=
  Iff.rfl

/-- The exact conditional chain from the missing Jacobian local theorem to the
Dedekind property. -/
theorem sourceJacobian_to_dedekind_conditional :
    SourceWeierstrassJacobianLocalRegularOne W →
      IsDedekindDomain (sourceWeierstrassCoordinateRing W) :=
  sourceDedekind_of_jacobianLocal W


end

end ABCBridge.WeierstrassLocalizationRegularDimensionOne

import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourceQlThetaPunctureDivisor
import Mathlib.Tactic

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1500000

/-!
# Degree-zero and principal-divisor subgroups for the source theta divisor

This file defines, for the actual Definition 3.1 source S:

* the actual integer source theta divisor and its degree-zero subgroup;
* the actual full real divisor degree-zero subgroup;
* the actual subgroup generated by principal divisors of global units, proved
  contained in the full real degree-zero subgroup by the product formula;
* the actual quotient of the full real divisor by the principal subgroup, with
  projection/kernel API;
* the embedding of the integer degree-zero subgroup into the full real
  degree-zero subgroup.

The file states precisely that the geometric line-bundle/theta identification is
still missing.  No line bundle, theta object, unit comparison or deck action is
constructed.  No theta spec, rank, or cardinal claim is used.
-/

namespace ABCBridge.SourceQlThetaDivisorPrincipalQuotient

noncomputable section

open LeanFormal.IUT
open LeanFormal.IUT.InfinitePlacePsiCnsResidual
open LeanFormal.IUT.IUTII.Frobenioid.Example36
open ABCBridge.SourceQlThetaObjectActual
open ABCBridge.SourceQlThetaLineBundleFromCurve
open ABCBridge.SourceQlThetaLineBundleObstruction
open ABCBridge.SourceQlThetaPunctureDivisor
open scoped BigOperators

universe u

variable {l : LeanFormal.IUT.PrimeGeFive}
variable (S : SourceDefinition31Data.{u} l)

/-- The actual integer source theta divisor type. -/
abbrev sourceThetaDivisorType : Type u := SourceThetaDivisor S

/-- The actual integer degree hom as a function; additivity is proved below. -/
def sourceThetaIntegerDegree : sourceThetaDivisorType S → ℤ :=
  sourceThetaDegree S

/-- The integer degree is additive. -/
theorem sourceThetaIntegerDegree_add
    (D E : sourceThetaDivisorType S) :
    sourceThetaIntegerDegree S (D + E) =
      sourceThetaIntegerDegree S D + sourceThetaIntegerDegree S E :=
  sourceQlThetaDivisorDegreeActual_add S D E

/-- The integer degree is zero on zero. -/
theorem sourceThetaIntegerDegree_zero :
    sourceThetaIntegerDegree S (0 : sourceThetaDivisorType S) = 0 :=
  sourceQlThetaDivisorDegreeActual_zero_degree S

/-- The integer degree is negated on negation. -/
theorem sourceThetaIntegerDegree_neg
    (D : sourceThetaDivisorType S) :
    sourceThetaIntegerDegree S (-D) = -sourceThetaIntegerDegree S D :=
  sourceQlThetaDivisorDegreeActual_neg S D

/-- Actual degree-zero subgroup of the integer source theta divisor. -/
def sourceThetaIntegerDegreeZeroSubgroup :
    AddSubgroup (sourceThetaDivisorType S) where
  carrier := { D | sourceThetaIntegerDegree S D = 0 }
  zero_mem' := sourceThetaIntegerDegree_zero S
  add_mem' := by
    intro D E hD hE
    rw [sourceThetaIntegerDegree_add, hD, hE, add_zero]
  neg_mem' := by
    intro D hD
    rw [sourceThetaIntegerDegree_neg, hD, neg_zero]

/-- Membership in the integer degree-zero subgroup. -/
theorem sourceThetaIntegerDegreeZeroSubgroup_mem_iff
    (D : sourceThetaDivisorType S) :
    D ∈ sourceThetaIntegerDegreeZeroSubgroup S ↔
      sourceThetaIntegerDegree S D = 0 := Iff.rfl

/-- The actual full real divisor type. -/
abbrev sourceThetaFullDivisorType : Type u :=
  sourceThetaFullRealDivisorType S

/-- The actual full real divisor degree as a function. -/
def sourceThetaFullDegree : sourceThetaFullDivisorType S → ℝ :=
  sourceThetaFullRealDivisorDegree S

/-- The full real degree is zero on zero. -/
theorem sourceThetaFullDegree_zero :
    sourceThetaFullDegree S (0 : sourceThetaFullDivisorType S) = 0 := by
  simp [sourceThetaFullDegree, sourceThetaFullRealDivisorDegree,
    Finsupp.sum_zero_index]

/-- The full real degree is additive. -/
theorem sourceThetaFullDegree_add
    (D E : sourceThetaFullDivisorType S) :
    sourceThetaFullDegree S (D + E) =
      sourceThetaFullDegree S D + sourceThetaFullDegree S E := by
  rcases D with ⟨Df, Di⟩
  rcases E with ⟨Ef, Ei⟩
  simp [sourceThetaFullDegree, sourceThetaFullRealDivisorDegree,
    Finsupp.sum_add_index, Finset.sum_add_distrib, mul_add]

/-- The full real degree is negated on negation. -/
theorem sourceThetaFullDegree_neg
    (D : sourceThetaFullDivisorType S) :
    sourceThetaFullDegree S (-D) = -sourceThetaFullDegree S D := by
  rcases D with ⟨Df, Di⟩
  simp [sourceThetaFullDegree, sourceThetaFullRealDivisorDegree,
    Finsupp.sum_neg_index, Finset.sum_neg_distrib, mul_neg]

/-- Actual full real degree-zero subgroup. -/
def sourceThetaFullDegreeZeroSubgroup :
    AddSubgroup (sourceThetaFullDivisorType S) where
  carrier := { D | sourceThetaFullDegree S D = 0 }
  zero_mem' := sourceThetaFullDegree_zero S
  add_mem' := by
    intro D E hD hE
    rw [sourceThetaFullDegree_add, hD, hE, add_zero]
  neg_mem' := by
    intro D hD
    rw [sourceThetaFullDegree_neg, hD, neg_zero]

/-- Membership in the full real degree-zero subgroup. -/
theorem sourceThetaFullDegreeZeroSubgroup_mem_iff
    (D : sourceThetaFullDivisorType S) :
    D ∈ sourceThetaFullDegreeZeroSubgroup S ↔
      sourceThetaFullDegree S D = 0 := Iff.rfl

/-- The actual principal-divisor set of global units in the full real divisor. -/
def sourceThetaPrincipalDivisorSet : Set (sourceThetaFullDivisorType S) :=
  Set.range (fun f : S.arithmetic.Fˣ => sourceThetaPrincipalDivisor S f)

/-- Actual subgroup generated by principal divisors of global units. -/
def sourceThetaPrincipalSubgroup : AddSubgroup (sourceThetaFullDivisorType S) :=
  AddSubgroup.closure (sourceThetaPrincipalDivisorSet S)

/-- Every principal divisor has full real degree zero. -/
theorem sourceThetaPrincipalDivisor_mem_degreeZero
    (f : S.arithmetic.Fˣ) :
    sourceThetaPrincipalDivisor S f ∈ sourceThetaFullDegreeZeroSubgroup S :=
  sourceThetaPrincipalDivisor_degree_zero S f

/-- The principal subgroup is contained in the full real degree-zero subgroup. -/
theorem sourceThetaPrincipalSubgroup_le_degreeZero :
    sourceThetaPrincipalSubgroup S ≤ sourceThetaFullDegreeZeroSubgroup S := by
  rw [sourceThetaPrincipalSubgroup, AddSubgroup.closure_le]
  rintro _ ⟨f, rfl⟩
  exact sourceThetaPrincipalDivisor_mem_degreeZero S f

/-- Actual quotient of the full real divisor by the principal subgroup. -/
abbrev SourceThetaFullPrincipalQuotient :=
  sourceThetaFullDivisorType S ⧸ sourceThetaPrincipalSubgroup S

/-- Projection to the full principal quotient. -/
def sourceThetaFullPrincipalQuotientProjection :
    sourceThetaFullDivisorType S →+
      SourceThetaFullPrincipalQuotient S :=
  QuotientAddGroup.mk' (sourceThetaPrincipalSubgroup S)

/-- Kernel of the quotient projection is the principal subgroup. -/
theorem sourceThetaFullPrincipalQuotientProjection_ker :
    (sourceThetaFullPrincipalQuotientProjection S).ker =
      sourceThetaPrincipalSubgroup S :=
  QuotientAddGroup.ker_mk'

/-- The quotient projection is surjective. -/
theorem sourceThetaFullPrincipalQuotientProjection_surjective :
    Function.Surjective (sourceThetaFullPrincipalQuotientProjection S) :=
  QuotientAddGroup.mk'_surjective _

/-- The principal subgroup lies in the degree-zero subgroup, hence the quotient
projection kills all principal divisors. -/
theorem sourceThetaPrincipalSubgroup_killed :
    sourceThetaPrincipalSubgroup S ≤
      (sourceThetaFullPrincipalQuotientProjection S).ker := by
  rw [sourceThetaFullPrincipalQuotientProjection_ker]

/-- The integer theta divisor embeds into the full real divisor with zero finite
part and integer-coerced real infinite part. -/
def sourceThetaIntegerEmbedding :
    sourceThetaDivisorType S →+ sourceThetaFullDivisorType S where
  toFun D := sourceThetaIntegerToFull S D
  map_zero' := by
    ext <;> simp [sourceThetaIntegerToFull, sourceThetaIntegerToRealInfinite]
  map_add' D E := by
    ext <;> simp [sourceThetaIntegerToFull, sourceThetaIntegerToRealInfinite,
      Pi.add_apply]

/-- The integer embedding has full real degree equal to the integer degree. -/
theorem sourceThetaIntegerEmbedding_degree
    (D : sourceThetaDivisorType S) :
    sourceThetaFullDegree S (sourceThetaIntegerEmbedding S D) =
      (sourceThetaIntegerDegree S D : ℝ) :=
  sourceThetaIntegerToFull_degree S D

/-- The integer degree-zero subgroup maps into the full real degree-zero
subgroup. -/
theorem sourceThetaIntegerDegreeZero_maps_degreeZero :
    sourceThetaIntegerDegreeZeroSubgroup S ≤
      (sourceThetaFullDegreeZeroSubgroup S).comap
        (sourceThetaIntegerEmbedding S) := by
  intro D hD
  rw [AddSubgroup.mem_comap]
  rw [sourceThetaFullDegreeZeroSubgroup_mem_iff]
  rw [sourceThetaIntegerEmbedding_degree]
  rw [sourceThetaIntegerDegreeZeroSubgroup_mem_iff] at hD
  rw [hD, Int.cast_zero]

/-- Exact missing geometric line-bundle/theta identification data. -/
def sourceThetaPrincipalQuotientMissing :
    List SourceThetaLineBundleObstructionDatum :=
  sourceThetaLineBundleObstructionMissing S

/-- Six geometric line-bundle/theta items remain missing. -/
theorem sourceThetaPrincipalQuotientMissing_length :
    (sourceThetaPrincipalQuotientMissing S).length = 6 :=
  sourceThetaLineBundleObstructionMissing_length S

/-- Exact residual: degree-zero subgroups, principal inclusion, quotient
projection/kernel, and the six missing geometric items. -/
theorem sourceThetaPrincipalQuotient_exactResidual :
    sourceThetaPrincipalSubgroup S ≤ sourceThetaFullDegreeZeroSubgroup S
      ∧
    (sourceThetaFullPrincipalQuotientProjection S).ker =
      sourceThetaPrincipalSubgroup S
      ∧
    (sourceThetaIntegerDegreeZeroSubgroup S ≤
      (sourceThetaFullDegreeZeroSubgroup S).comap
        (sourceThetaIntegerEmbedding S))
      ∧
    (sourceThetaPrincipalQuotientMissing S).length = 6 :=
  ⟨sourceThetaPrincipalSubgroup_le_degreeZero S,
    sourceThetaFullPrincipalQuotientProjection_ker S,
    sourceThetaIntegerDegreeZero_maps_degreeZero S,
    sourceThetaPrincipalQuotientMissing_length S⟩

/-- The full degree-zero subgroup contains the zero divisor. -/
theorem sourceThetaFullDegreeZeroSubgroup_zero :
    (0 : sourceThetaFullDivisorType S) ∈
      sourceThetaFullDegreeZeroSubgroup S :=
  (sourceThetaFullDegreeZeroSubgroup S).zero_mem

/-- The integer degree-zero subgroup contains the zero divisor. -/
theorem sourceThetaIntegerDegreeZeroSubgroup_zero :
    (0 : sourceThetaDivisorType S) ∈
      sourceThetaIntegerDegreeZeroSubgroup S :=
  (sourceThetaIntegerDegreeZeroSubgroup S).zero_mem

/-- The quotient projection sends principal divisors to zero. -/
theorem sourceThetaPrincipal_quotient_zero
    (f : S.arithmetic.Fˣ) :
    sourceThetaFullPrincipalQuotientProjection S
      (sourceThetaPrincipalDivisor S f) = 0 :=
  (QuotientAddGroup.eq_zero_iff _ _).mpr
    (AddSubgroup.subset_closure ⟨f, rfl⟩)

/-- The six missing geometric line-bundle/theta items, explicitly. -/
theorem sourceThetaPrincipalQuotientMissing_eq :
    (sourceThetaPrincipalQuotientMissing S) =
      [ .curveLineBundle,
        .thetaObjectATheta,
        .geometricThetaDivisor,
        .unitComparisonMqMTheta,
        .muTwoLDeckRootAction,
        .conjugateSynchronization ] := rfl


end

end ABCBridge.SourceQlThetaDivisorPrincipalQuotient

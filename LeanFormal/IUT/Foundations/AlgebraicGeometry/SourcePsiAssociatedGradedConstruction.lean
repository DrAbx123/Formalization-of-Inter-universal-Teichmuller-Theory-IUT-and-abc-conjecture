/-
  Construction of associated-graded and initial-form candidates from the actual
  m-adic filtration, with the exact missing API for the graded ring and
  Hilbert-Samuel leading coefficient.

  Mathlib supplies stable ideal filtrations, the Rees algebra, module lengths and
  quotient modules.  It does not supply a named associated graded ring of an
  ideal filtration, homogeneous multiplication, initial forms as a graded map, or
  Hilbert-Samuel multiplicity.  This file constructs the actual graded pieces
  m^n/m^{n+1}, their direct sum, the actual initial-form map on elements of m^n,
  and the initial-ideal candidate generated by the local Jacobian generators.
  The missing graded ring multiplication and leading coefficient are recorded as
  exact API obstruction fields.  No associated graded ring or multiplicity is
  fabricated.
-/
import LeanFormal.IUT.Foundations.AlgebraicGeometry.SourcePsiAssociatedGradedActual
import Mathlib.Algebra.DirectSum.Basic

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option synthInstance.maxHeartbeats 1000000

noncomputable section

namespace LeanFormal.IUT.SourcePsiAssociatedGradedConstruction

open LeanFormal.IUT Theorem311Source
open LeanFormal.IUT.SourcePsiActualSpecialFiber
open LeanFormal.IUT.SourcePsiComponentFiniteActual
open LeanFormal.IUT.SourcePsiComponentIntersectionGraph
open LeanFormal.IUT.SourcePsiNodeCuspMultiplicity
open LeanFormal.IUT.SourcePsiHilbertSamuelMultiplicity
open LeanFormal.IUT.SourcePsiAssociatedGradedActual
open WeierstrassCurve

universe u

variable {l : PrimeGeFive} (S : SourceDefinition31Data l)
  (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers S.arithmetic.F))

/-- Candidate Jacobian prime. -/
abbrev SourcePsiAGCCandidatePrime : Type u :=
  SourcePsiAGCandidatePrime S v

/-- Actual local ring at the candidate prime. -/
abbrev SourcePsiAGCLocalRing (q : SourcePsiAGCCandidatePrime S v) : Type u :=
  SourcePsiAGLocalRing S v q

/-- Actual maximal ideal. -/
abbrev SourcePsiAGCMaximalIdeal (q : SourcePsiAGCCandidatePrime S v) :
    Ideal (SourcePsiAGCLocalRing S v q) :=
  SourcePsiAGMaximalIdeal S v q

/-- The actual associated-graded piece m^n / m^{n+1}, as the quotient of the
submodule m^n by the image of m^{n+1}. -/
abbrev SourcePsiAGradedPiece
    (q : SourcePsiAGCCandidatePrime S v) (n : ℕ) : Type u :=
  ↥(SourcePsiAGCMaximalIdeal S v q ^ n : Submodule (SourcePsiAGCLocalRing S v q)
      (SourcePsiAGCLocalRing S v q)) ⧸
    Submodule.comap
      (Submodule.subtype
        (SourcePsiAGCMaximalIdeal S v q ^ n : Submodule (SourcePsiAGCLocalRing S v q)
          (SourcePsiAGCLocalRing S v q)))
      (SourcePsiAGCMaximalIdeal S v q ^ (n + 1) :
        Submodule (SourcePsiAGCLocalRing S v q) (SourcePsiAGCLocalRing S v q))

/-- The actual direct sum of the associated-graded pieces, as an additive
module. -/
abbrev SourcePsiAGradedDirectSum (q : SourcePsiAGCCandidatePrime S v) : Type u :=
  DirectSum ℕ (SourcePsiAGradedPiece S v q)

/-- The actual initial form of an element of m^n in m^n/m^{n+1}. -/
def SourcePsiAGInitialForm
    (q : SourcePsiAGCCandidatePrime S v) (x : SourcePsiAGCLocalRing S v q)
    (n : ℕ) (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n) :
    SourcePsiAGradedPiece S v q n :=
  Submodule.Quotient.mk
    (p := Submodule.comap
      (Submodule.subtype
        (SourcePsiAGCMaximalIdeal S v q ^ n : Submodule (SourcePsiAGCLocalRing S v q)
          (SourcePsiAGCLocalRing S v q)))
      (SourcePsiAGCMaximalIdeal S v q ^ (n + 1) :
        Submodule (SourcePsiAGCLocalRing S v q) (SourcePsiAGCLocalRing S v q)))
    ⟨x, hx⟩

/-- The initial form of zero is zero. -/
theorem SourcePsiAGInitialForm_zero
    (q : SourcePsiAGCCandidatePrime S v) (n : ℕ)
    (h0 : (0 : SourcePsiAGCLocalRing S v q) ∈
      SourcePsiAGCMaximalIdeal S v q ^ n) :
    SourcePsiAGInitialForm S v q 0 n h0 = 0 := by
  simp [SourcePsiAGInitialForm]

/-- The actual initial ideal candidate: the submodule of the graded direct sum
generated by initial forms of the local Jacobian ideal. -/
def SourcePsiAGInitialIdealCandidate
    (q : SourcePsiAGCCandidatePrime S v) :
    Submodule (SourcePsiAGCLocalRing S v q)
      (SourcePsiAGradedDirectSum S v q) :=
  Submodule.span (SourcePsiAGCLocalRing S v q)
    {y : SourcePsiAGradedDirectSum S v q |
      ∃ (n : ℕ) (x : SourcePsiAGCLocalRing S v q)
        (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n)
        (_hxJ : x ∈ SourcePsiAGLocalInitialIdeal S v q),
        SourcePsiAGInitialForm S v q x n hx = y}

/-- Membership form of the initial ideal candidate. -/
theorem SourcePsiAGInitialIdealCandidate_mem
    (q : SourcePsiAGCCandidatePrime S v)
    {y : SourcePsiAGradedDirectSum S v q}
    (h : y ∈ SourcePsiAGInitialIdealCandidate S v q) :
    y ∈ Submodule.span (SourcePsiAGCLocalRing S v q)
      {z : SourcePsiAGradedDirectSum S v q |
        ∃ (n : ℕ) (x : SourcePsiAGCLocalRing S v q)
          (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n)
          (_hxJ : x ∈ SourcePsiAGLocalInitialIdeal S v q),
          SourcePsiAGInitialForm S v q x n hx = z} :=
  h

/-- The actual initial ideal candidate is generated by the initial forms of the
local Jacobian ideal. -/
theorem SourcePsiAGInitialIdealCandidate_eq :
    SourcePsiAGInitialIdealCandidate S v q =
      Submodule.span (SourcePsiAGCLocalRing S v q)
        {y : SourcePsiAGradedDirectSum S v q |
          ∃ (n : ℕ) (x : SourcePsiAGCLocalRing S v q)
            (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n)
            (_hxJ : x ∈ SourcePsiAGLocalInitialIdeal S v q),
            SourcePsiAGInitialForm S v q x n hx = y} :=
  rfl

/-- Missing associated-graded construction fields.  The actual graded pieces,
direct sum, initial forms and initial-ideal candidate are present; the ring
multiplication, graded ring, initial-form map and leading coefficient are not. -/
structure SourcePsiAGradedConstructionObstruction
    (q : SourcePsiAGCCandidatePrime S v) where
  piece : ℕ → Type u
  piece_eq : ∀ n, piece n = SourcePsiAGradedPiece S v q n
  directSum : Type u
  directSum_eq : directSum = SourcePsiAGradedDirectSum S v q
  initialForm : ∀ (x : SourcePsiAGCLocalRing S v q) (n : ℕ),
    x ∈ SourcePsiAGCMaximalIdeal S v q ^ n → SourcePsiAGradedPiece S v q n
  initialForm_eq : initialForm = SourcePsiAGInitialForm S v q
  initialIdeal : Submodule (SourcePsiAGCLocalRing S v q)
    (SourcePsiAGradedDirectSum S v q)
  initialIdeal_eq : initialIdeal = SourcePsiAGInitialIdealCandidate S v q
  gradedRing : Prop
  homogeneousMultiplication : Prop
  initialIdealIsIdeal : Prop
  hilbertSamuelLeadingCoefficient : Prop

/-- The actual graded-construction obstruction record.  Missing fields are
recorded as False and are not asserted. -/
def SourcePsiAGradedConstructionObstruction.ofCandidate
    (q : SourcePsiAGCCandidatePrime S v) :
    SourcePsiAGradedConstructionObstruction S v q where
  piece := SourcePsiAGradedPiece S v q
  piece_eq := fun n => rfl
  directSum := SourcePsiAGradedDirectSum S v q
  directSum_eq := rfl
  initialForm := SourcePsiAGInitialForm S v q
  initialForm_eq := rfl
  initialIdeal := SourcePsiAGInitialIdealCandidate S v q
  initialIdeal_eq := rfl
  gradedRing := False
  homogeneousMultiplication := False
  initialIdealIsIdeal := False
  hilbertSamuelLeadingCoefficient := False

/-- Exact API statement for the associated-graded construction: actual pieces,
direct sum, initial forms and initial-ideal candidate exist; the graded ring and
multiplication are missing. -/
def SourcePsiAGradedConstructionAPIStatement
    (q : SourcePsiAGCCandidatePrime S v) : Prop :=
  (∀ n, SourcePsiAGradedPiece S v q n =
    ↥(SourcePsiAGCMaximalIdeal S v q ^ n : Submodule (SourcePsiAGCLocalRing S v q)
      (SourcePsiAGCLocalRing S v q)) ⧸
      Submodule.comap
        (Submodule.subtype
          (SourcePsiAGCMaximalIdeal S v q ^ n : Submodule (SourcePsiAGCLocalRing S v q)
            (SourcePsiAGCLocalRing S v q)))
        (SourcePsiAGCMaximalIdeal S v q ^ (n + 1) :
          Submodule (SourcePsiAGCLocalRing S v q) (SourcePsiAGCLocalRing S v q))) ∧
    Nonempty (SourcePsiAGradedConstructionObstruction S v q)

/-- The actual API statement is proved. -/
theorem SourcePsiAGradedConstructionAPIStatement_iff
    (q : SourcePsiAGCCandidatePrime S v) :
    SourcePsiAGradedConstructionAPIStatement S v q :=
  ⟨fun n => rfl, ⟨SourcePsiAGradedConstructionObstruction.ofCandidate S v q⟩⟩

/-- Initial-form comparison: the initial form of x in m^n is the quotient class
determined by x, and its vanishing is the next-power condition. -/
theorem SourcePsiAGInitialForm_eq_zero_iff
    (q : SourcePsiAGCCandidatePrime S v) (x : SourcePsiAGCLocalRing S v q)
    (n : ℕ) (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n) :
    SourcePsiAGInitialForm S v q x n hx = 0 ↔
      x ∈ SourcePsiAGCMaximalIdeal S v q ^ (n + 1) :=
  Submodule.Quotient.mk_eq_zero

/-- Exact residual: no named associated graded ring, homogeneous multiplication,
initial-form graded map, leading coefficient, geometric node/cusp classification
or component multiplicity.  No associated graded ring or multiplicity is
fabricated. -/
def SourcePsiAGradedConstructionResidual : Prop :=
  (∀ q : SourcePsiAGCCandidatePrime S v,
    Nonempty (SourcePsiAGradedConstructionObstruction S v q)) ∧
    (∀ q : SourcePsiAGCCandidatePrime S v,
      SourcePsiCandidateNode S v q ∨ SourcePsiCandidateCusp S v q)

/-- The residual is exactly the actual graded data and node/cusp dichotomy. -/
theorem SourcePsiAGradedConstructionResidual_iff :
    SourcePsiAGradedConstructionResidual S v :=
  ⟨fun q => ⟨SourcePsiAGradedConstructionObstruction.ofCandidate S v q⟩,
    fun q => SourcePsiCandidateNode_or_cusp S v q⟩



/-- The canonical quotient map from m^n to the graded piece m^n/m^{n+1}. -/
def SourcePsiAGradedPieceMk
    (q : SourcePsiAGCCandidatePrime S v) (n : ℕ)
    (x : ↥(SourcePsiAGCMaximalIdeal S v q ^ n :
      Submodule (SourcePsiAGCLocalRing S v q) (SourcePsiAGCLocalRing S v q))) :
    SourcePsiAGradedPiece S v q n :=
  Submodule.Quotient.mk x

/-- The quotient map sends x to its initial form. -/
theorem SourcePsiAGradedPieceMk_eq_initialForm
    (q : SourcePsiAGCCandidatePrime S v) (n : ℕ)
    (x : SourcePsiAGCLocalRing S v q)
    (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n) :
    SourcePsiAGradedPieceMk S v q n ⟨x, hx⟩ =
      SourcePsiAGInitialForm S v q x n hx := rfl

/-- The graded piece at level zero is the quotient R/m. -/
theorem SourcePsiAGradedPiece_zero_eq_quotient
    (q : SourcePsiAGCCandidatePrime S v) :
    SourcePsiAGradedPiece S v q 0 =
      (SourcePsiAGCLocalRing S v q ⧸
        (SourcePsiAGCMaximalIdeal S v q ^ 1 :
          Submodule (SourcePsiAGCLocalRing S v q) (SourcePsiAGCLocalRing S v q))) := by
  simp [SourcePsiAGradedPiece]

/-- Initial forms of the local Jacobian ideal generate the initial-ideal
candidate. -/
theorem SourcePsiAGInitialIdealCandidate_span
    (q : SourcePsiAGCCandidatePrime S v) :
    SourcePsiAGInitialIdealCandidate S v q =
      Submodule.span (SourcePsiAGCLocalRing S v q)
        {y : SourcePsiAGradedDirectSum S v q |
          ∃ (n : ℕ) (x : SourcePsiAGCLocalRing S v q)
            (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n)
            (_hxJ : x ∈ SourcePsiAGLocalInitialIdeal S v q),
            SourcePsiAGInitialForm S v q x n hx = y} := rfl

/-- A member of the initial-ideal candidate is a finite linear combination of
initial forms. -/
theorem SourcePsiAGInitialIdealCandidate_elim
    (q : SourcePsiAGCCandidatePrime S v)
    {y : SourcePsiAGradedDirectSum S v q}
    (h : y ∈ SourcePsiAGInitialIdealCandidate S v q) :
    y ∈ Submodule.span (SourcePsiAGCLocalRing S v q)
      {z : SourcePsiAGradedDirectSum S v q |
        ∃ (n : ℕ) (x : SourcePsiAGCLocalRing S v q)
          (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n)
          (_hxJ : x ∈ SourcePsiAGLocalInitialIdeal S v q),
          SourcePsiAGInitialForm S v q x n hx = z} :=
  h

/-- The actual direct sum contains each graded piece. -/
def SourcePsiAGradedDirectSumOfPiece
    (q : SourcePsiAGCCandidatePrime S v) (n : ℕ) :
    SourcePsiAGradedPiece S v q n → SourcePsiAGradedDirectSum S v q :=
  DirectSum.of (fun n => SourcePsiAGradedPiece S v q n) n

/-- The direct-sum inclusion of each piece is actual. -/
theorem SourcePsiAGradedDirectSumOfPiece_apply
    (q : SourcePsiAGCCandidatePrime S v) (n : ℕ)
    (y : SourcePsiAGradedPiece S v q n) :
    SourcePsiAGradedDirectSumOfPiece S v q n y =
      DirectSum.of (fun n => SourcePsiAGradedPiece S v q n) n y := rfl

/-- Consumer: the initial-form map exists for every element of m^n. -/
theorem SourcePsiAGradedConstructionObstruction_initialForm
    (q : SourcePsiAGCCandidatePrime S v)
    (D : SourcePsiAGradedConstructionObstruction S v q)
    (x : SourcePsiAGCLocalRing S v q) (n : ℕ)
    (hx : x ∈ SourcePsiAGCMaximalIdeal S v q ^ n) :
    D.initialForm x n hx = SourcePsiAGInitialForm S v q x n hx :=
  congrFun (congrFun (congrArg (fun f => f x) D.initialForm_eq) n) hx

/-- Consumer: the obstruction record exposes its direct sum. -/
theorem SourcePsiAGradedConstructionObstruction_directSum
    (q : SourcePsiAGCCandidatePrime S v)
    (D : SourcePsiAGradedConstructionObstruction S v q) :
    D.directSum = SourcePsiAGradedDirectSum S v q :=
  D.directSum_eq

/-- Consumer: the obstruction record exposes its initial ideal candidate. -/
theorem SourcePsiAGradedConstructionObstruction_initialIdeal
    (q : SourcePsiAGCCandidatePrime S v)
    (D : SourcePsiAGradedConstructionObstruction S v q) :
    D.initialIdeal = SourcePsiAGInitialIdealCandidate S v q :=
  D.initialIdeal_eq

/-- Hilbert-function data attached to the graded construction. -/
def SourcePsiAGHilbertFunction
    (q : SourcePsiAGCCandidatePrime S v) (n : ℕ) : ℕ∞ :=
  SourcePsiHSCandidateLength S v q n

/-- The leading-coefficient obstruction data: the Hilbert function is actual,
while the leading coefficient is not supplied by the API. -/
structure SourcePsiAGLeadingCoefficientObstruction
    (q : SourcePsiAGCCandidatePrime S v) where
  hilbertFunction : ℕ → ℕ∞
  hilbertFunction_eq : ∀ n, hilbertFunction n = SourcePsiAGHilbertFunction S v q n
  leadingCoefficient : Prop
  multiplicityValue : Prop

/-- The actual leading-coefficient obstruction record, with missing fields as
False. -/
def SourcePsiAGLeadingCoefficientObstruction.ofCandidate
    (q : SourcePsiAGCCandidatePrime S v) :
    SourcePsiAGLeadingCoefficientObstruction S v q where
  hilbertFunction := SourcePsiAGHilbertFunction S v q
  hilbertFunction_eq := fun n => rfl
  leadingCoefficient := False
  multiplicityValue := False

/-- The leading-coefficient API is exactly the missing part. -/
def SourcePsiAGLeadingCoefficientAPIStatement
    (q : SourcePsiAGCCandidatePrime S v) : Prop :=
  Nonempty (SourcePsiAGLeadingCoefficientObstruction S v q)

/-- The leading-coefficient API statement is inhabited by the actual Hilbert
function data. -/
theorem SourcePsiAGLeadingCoefficientAPIStatement_iff
    (q : SourcePsiAGCCandidatePrime S v) :
    SourcePsiAGLeadingCoefficientAPIStatement S v q :=
  ⟨SourcePsiAGLeadingCoefficientObstruction.ofCandidate S v q⟩

/-! ## Exact associated-graded construction boundary

Constructed:
- actual graded pieces m^n/m^{n+1};
- actual direct sum of the pieces;
- actual initial-form map from elements of m^n to the quotient piece;
- actual initial-ideal candidate generated by initial forms of the local Jacobian
  ideal;
- API obstruction record with pieces/direct sum/forms/initial ideal present and
  graded ring/multiplication/leading coefficient missing;
- initial-form vanishing criterion.

NOT constructed or asserted:
- named associated graded ring gr_m(A_q) with multiplication;
- homogeneous multiplication or graded ring structure;
- initial form as a degree-preserving ring map;
- Hilbert-Samuel multiplicity/leading coefficient;
- geometric node/cusp classification or component multiplicities;
- stable-reduction/source comparison.

These are exact residual objects.  No associated graded ring or multiplicity is
fabricated.
-/
end LeanFormal.IUT.SourcePsiAssociatedGradedConstruction

end
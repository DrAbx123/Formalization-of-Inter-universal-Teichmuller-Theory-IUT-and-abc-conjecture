import LeanFormal.IUT.Foundations.AlgebraicGeometry.NormalizedGeneratorIdealEqualityProof
import LeanFormal.IUT.ABCBridge.Geometry.FinitePlaceCompletionLocalInputs
import LeanFormal.IUT.ABCBridge.Geometry.FinitePlaceLogShellDiscrepancy
import Mathlib.RingTheory.ClassGroup.Basic

set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 2400000

/-!
# Canonical uniformizer principal ideal = maximal ideal

The production theorem
`mem_maximalIdeal_pow_iff_valued_le_exp_neg` contains the generator identity

  `IsLocalRing.maximalIdeal (v.adicCompletionIntegers K) = Ideal.span {ϖ}`

for the actual completion uniformizer `ϖ`.  Since `toPrincipalIdeal` is the
fractional ideal generated by the unit (`coe_toPrincipalIdeal`), this proves
`CanonicalUniformizerPrincipalIdealEquality`.

The normalized principal-ideal transport through
`normalizedCompletionRingEquiv` is recorded as the remaining exact input; once
it is supplied, `NormalizedGeneratorIdealEqualityExactResidual` is closed.

No fake ideal equality, no card, no production edits.
-/

noncomputable section

namespace LeanFormal.IUT.CanonicalUniformizerPrincipalIdealEqualityProof

open scoped WithZero Valued Topology
open LeanFormal.IUT
open LeanFormal.IUT.NumberFieldFinitePlace
open LeanFormal.IUT.ConcreteSourceFrobenioidBridge
open LeanFormal.IUT.NormalizedGeneratorIdealEqualityProof

universe u

local instance gaussianCanonicalIdealIrreducibleFact :
    Fact (Irreducible
      (Polynomial.X ^ 2 - Polynomial.C (-1) : Polynomial ℚ)) :=
  ⟨LeanFormal.IUT.gaussianPolynomial_irreducible⟩

local instance factFivePrime : Fact (Nat.Prime 5) := ⟨by norm_num⟩

/-- Canonical completion. -/
abbrev completionField : Type :=
  LeanFormal.IUT.NormalizedGeneratorIdealEqualityProof.completionField

/-- Canonical completion integers. -/
abbrev canonicalIntegers : Subring completionField :=
  LeanFormal.IUT.NormalizedGeneratorIdealEqualityProof.canonicalIntegers

/-- The actual uniformizer integral element. -/
noncomputable def canonicalUniformizerIntegral : canonicalIntegers :=
  ((LeanFormal.IUT.NumberFieldFinitePlace.adicCompletion_uniformizer
      (K := GaussianField) concretePlace.maximalIdeal).1 :
    concretePlace.maximalIdeal.adicCompletionIntegers GaussianField)

/-- The uniformizer unit coerces to the actual production uniformizer. -/
theorem canonicalUniformizerUnit_coe :
    ((canonicalUniformizerUnit : completionFieldˣ) : completionField) =
      ((canonicalUniformizerIntegral : canonicalIntegers) : completionField) :=
  rfl

theorem canonicalUniformizerIntegral_valued :
    (Valued.v ((canonicalUniformizerIntegral : canonicalIntegers) : completionField) :
      WithZero (Multiplicative ℤ)) = WithZero.exp (-1) :=
  LeanFormal.IUT.NumberFieldFinitePlace.uniformizer_valued_eq_exp_neg_one
    (K := GaussianField) (v := concretePlace.maximalIdeal)
    (LeanFormal.IUT.NumberFieldFinitePlace.adicCompletion_uniformizer
      (K := GaussianField) concretePlace.maximalIdeal)

/-! ## The maximal-ideal generator identity -/

/-- The canonical maximal ideal is the principal ideal generated by the actual
uniformizer integral element. -/
theorem canonicalMaximalIdeal_eq_span_uniformizer :
    (Ideal.maximalIdeal canonicalIntegers : Ideal canonicalIntegers) =
      Ideal.span {canonicalUniformizerIntegral} :=
by
  let π := LeanFormal.IUT.NumberFieldFinitePlace.adicCompletion_uniformizer
    (K := GaussianField) concretePlace.maximalIdeal
  have hgen : IsLocalRing.maximalIdeal
      (concretePlace.maximalIdeal.adicCompletionIntegers GaussianField) =
      Ideal.span {(π.1 : concretePlace.maximalIdeal.adicCompletionIntegers GaussianField)} :=
  by
    rw [show IsLocalRing.maximalIdeal
        (concretePlace.maximalIdeal.adicCompletionIntegers GaussianField) =
        IsLocalRing.maximalIdeal
          ((Valued.v : Valuation
            (concretePlace.maximalIdeal.adicCompletion GaussianField) ℤᵐ⁰).valuationSubring)
        from rfl]
    exact Valuation.Uniformizer.is_generator π
  simpa [canonicalIntegers, canonicalUniformizerIntegral, π] using hgen

/-- The maximal ideal as a fractional ideal is the principal fractional ideal of
the uniformizer unit. -/
theorem canonicalMaximalIdeal_eq_principalIdeal :
    canonicalMaximalIdeal = canonicalImagePrincipalIdeal :=
by
  rw [canonicalMaximalIdeal, canonicalImagePrincipalIdeal,
    coe_toPrincipalIdeal, canonicalUniformizerUnit_coe,
    canonicalMaximalIdeal_eq_span_uniformizer]
  -- both sides are the fractional ideal generated by the same element
  rfl

/-- The canonical principal-ideal equality is proved. -/
theorem canonicalUniformizerPrincipalIdealEquality_holds :
    CanonicalUniformizerPrincipalIdealEquality :=
  canonicalMaximalIdeal_eq_principalIdeal.symm

/-! ## Normalized transport residual -/

/-- The normalized principal ideal is the maximal ideal, modulo the normalized
ring equivalence.  This is the ideal-level image of the canonical equality. -/
def NormalizedPrincipalIdealTransportResidual : Prop :=
  NormalizedPrincipalIdealTransport

theorem normalizedPrincipalIdealTransport_of_residual
    (h : NormalizedPrincipalIdealTransportResidual) :
    NormalizedPrincipalIdealTransport :=
  h

/-- With the normalized transport supplied, the ideal equality exact residual
closes. -/
theorem normalizedGeneratorIdealEqualityExactResidual_of_transport
    (h : NormalizedPrincipalIdealTransportResidual) :
    NormalizedGeneratorIdealEqualityExactResidual :=
  ⟨canonicalUniformizerPrincipalIdealEquality_holds, h⟩

theorem normalizedGeneratorIdealEquality_of_transport
    (h : NormalizedPrincipalIdealTransportResidual) :
    NormalizedGeneratorIdealEquality :=
  normalizedGeneratorIdealEquality_of_exactResidual
    (normalizedGeneratorIdealEqualityExactResidual_of_transport h)

/-! ## Closure of the valuation exact residual -/

theorem valuationExactResidual_of_transport_and_bridge
    (htransport : NormalizedPrincipalIdealTransportResidual)
    (hexp : MaximalIdealPrincipalIdealExponentInput) :
    NormalizedGeneratorValuationExactResidual :=
  valuationExactResidual_of_idealAndBridge
    (normalizedGeneratorIdealEqualityExactResidual_of_transport htransport) hexp

theorem valuationExponentInput_of_transport_and_bridge
    (htransport : NormalizedPrincipalIdealTransportResidual)
    (hexp : MaximalIdealPrincipalIdealExponentInput) :
    NormalizedGeneratorValuationExponentInput :=
  valuationExponentInput_of_exactResidual
    (valuationExactResidual_of_transport_and_bridge htransport hexp)


/-! ## Equivalent orientations and consumer forms -/

theorem canonicalImagePrincipalIdeal_eq_canonicalMaximalIdeal :
    canonicalImagePrincipalIdeal = canonicalMaximalIdeal :=
  canonicalMaximalIdeal_eq_principalIdeal.symm

theorem canonicalUniformizerPrincipalIdealEquality_iff :
    CanonicalUniformizerPrincipalIdealEquality ↔
      canonicalImagePrincipalIdeal = canonicalMaximalIdeal :=
  Iff.rfl

theorem canonicalPrincipalIdeal_is_maximal :
    canonicalImagePrincipalIdeal = canonicalMaximalIdeal :=
  canonicalImagePrincipalIdeal_eq_canonicalMaximalIdeal

theorem normalizedGeneratorIdealEqualityExactResidual_iff_transport :
    NormalizedGeneratorIdealEqualityExactResidual ↔
      NormalizedPrincipalIdealTransportResidual :=
by
  constructor
  · intro h
    exact h.2
  · intro h
    exact normalizedGeneratorIdealEqualityExactResidual_of_transport h

theorem exactResidual_canonical_part :
    NormalizedGeneratorIdealEqualityExactResidual →
      CanonicalUniformizerPrincipalIdealEquality :=
  fun h => h.1

theorem exactResidual_transport_part
    (h : NormalizedGeneratorIdealEqualityExactResidual) :
    NormalizedPrincipalIdealTransportResidual :=
  h.2

/-! ## Exact residual summary -/

/-- The remaining exact input after the canonical generator theorem: the
normalized principal-ideal transport along the ring equivalence. -/
def CanonicalUniformizerIdealExactResidual : Prop :=
  NormalizedPrincipalIdealTransportResidual

theorem normalizedGeneratorIdealEquality_of_canonicalIdealResidual
    (h : CanonicalUniformizerIdealExactResidual) :
    NormalizedGeneratorIdealEquality :=
  normalizedGeneratorIdealEquality_of_transport h

theorem valuationExactResidual_of_canonicalIdealResidual
    (h : CanonicalUniformizerIdealExactResidual)
    (hexp : MaximalIdealPrincipalIdealExponentInput) :
    NormalizedGeneratorValuationExactResidual :=
  valuationExactResidual_of_transport_and_bridge h hexp

/-! ## Auxiliary principal-ideal identities -/

theorem canonicalImagePrincipalIdeal_apply :
    canonicalImagePrincipalIdeal =
      toPrincipalIdeal canonicalIntegers completionField canonicalUniformizerUnit :=
  rfl

theorem canonicalMaximalIdeal_apply :
    canonicalMaximalIdeal =
      (Ideal.maximalIdeal canonicalIntegers :
        FractionalIdeal (canonicalIntegers)⁰ completionField) :=
  rfl

theorem canonicalUniformizerUnit_valued :
    (Valued.v ((canonicalUniformizerUnit : completionFieldˣ) : completionField) :
      WithZero (Multiplicative ℤ)) = WithZero.exp (-1) :=
by
  rw [canonicalUniformizerUnit_coe, canonicalUniformizerIntegral_valued]

theorem canonicalUniformizerUnit_norm_lt_one :
    ‖((canonicalUniformizerUnit : completionFieldˣ) : completionField)‖ < 1 :=
by
  rw [← norm_lt_one_iff_valued_lt_one]
  · rw [canonicalUniformizerUnit_valued]
    exact LeanFormal.IUT.NumberFieldFinitePlace.withZero_exp_neg_one_lt_one
  · exact Units.ne_zero canonicalUniformizerUnit


theorem canonicalUniformizerIdealExactResidual_iff :
    CanonicalUniformizerIdealExactResidual ↔
      NormalizedPrincipalIdealTransport :=
  Iff.rfl

theorem normalizedIdealEquality_of_canonicalIdealResidual_unconditional
    (h : CanonicalUniformizerIdealExactResidual) :
    NormalizedGeneratorIdealEquality :=
  normalizedGeneratorIdealEquality_of_canonicalIdealResidual h

end LeanFormal.IUT.CanonicalUniformizerPrincipalIdealEqualityProof

end

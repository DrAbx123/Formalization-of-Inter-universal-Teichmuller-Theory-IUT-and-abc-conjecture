import LeanFormal.IUT.Foundations.LocalFields.IntegralUnits
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.NumberTheory.Padics.ProperSpace

/-!
# Finite carriers of algebraic integral units

An integral unit in an algebraic normed extension of the p-adic numbers lies in a
finite intermediate field. The inherited norm gives a proper carrier and an
integral unit whose image is the original unit.
-/

namespace LeanFormal.IUT.LocalFieldIntegralUnits

variable {Ω : Type*} [NormedField Ω] [IsUltrametricDist Ω]
variable {p : ℕ} [Fact p.Prime] [NormedAlgebra ℚ_[p] Ω]

/-- The intermediate field generated by the underlying value of an integral unit. -/
noncomputable def finiteUnitField (u : (Integers Ω)ˣ) : IntermediateField ℚ_[p] Ω :=
  IntermediateField.adjoin ℚ_[p] {(u.val : Ω)}

/-- Algebraicity makes the single-generator carrier finite dimensional. -/
instance finiteUnitField_finiteDimensional [Algebra.IsAlgebraic ℚ_[p] Ω]
    (u : (Integers Ω)ˣ) : FiniteDimensional ℚ_[p] (finiteUnitField (p := p) u) :=
  IntermediateField.adjoin.finiteDimensional
    (Algebra.IsAlgebraic.isAlgebraic (R := ℚ_[p]) (u.val : Ω)).isIntegral

/-- The finite carrier is proper, even when the ambient field is not. -/
instance finiteUnitField_properSpace [Algebra.IsAlgebraic ℚ_[p] Ω]
    (u : (Integers Ω)ˣ) : ProperSpace (finiteUnitField (p := p) u) :=
  FiniteDimensional.proper ℚ_[p] (finiteUnitField (p := p) u)

/-- The original unit, regarded as an integral unit of its finite carrier. -/
noncomputable def finiteUnitLift (u : (Integers Ω)ˣ) : (Integers (finiteUnitField (p := p) u))ˣ :=
  unitOfNormOne ⟨⟨(u.val : Ω), IntermediateField.mem_adjoin_simple_self ℚ_[p] _⟩,
    norm_unit_eq_one u⟩

/-- The lift has exactly the original underlying value in the ambient field. -/
@[simp] theorem finiteUnitLift_val (u : (Integers Ω)ˣ) :
    (((finiteUnitLift (p := p) u).val : finiteUnitField (p := p) u) : Ω) =
      (u.val : Ω) := rfl

end LeanFormal.IUT.LocalFieldIntegralUnits


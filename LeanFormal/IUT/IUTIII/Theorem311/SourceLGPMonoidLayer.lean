import LeanFormal.IUT.IUTIII.Theorem311.SourceProcessionCapsuleData
import LeanFormal.IUT.Foundations.Theta.GaussianKernel
import Mathlib.Tactic

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.checkUnivs false
set_option linter.style.whitespace false

/-!
# A finite LGP-monoid interface for the Gaussian/U_j layer

Source anchor: IUT III, pp. 30--37, 597--607, 1066--1087 and 5955--6018.
The paper's local LGP-monoids carry two multiplicative layers: a splitting
monoid generated by the theta values `q_v ^ (j^2)`, and labeled copies of
the multiplicative monoid `F_mod^` acting on tensor packets of log-shells.
The present file records that interface over the concrete capsule and tensor
packet data of `SourceProcessionCapsuleData`.

The file is deliberately a **source interface and finite model layer**:

* `LGPMonoid l` packages a carrier, a distinguished submonoid, a theta-value
  generator, and the proof that the distinguished submonoid is exactly the
  submonoid generated by the displayed theta values;
* `LGPMonoidAction` is a scalar character from the carrier to the coefficient
  ring, and `actionOnTensorPacket` is the induced monoid homomorphism into
  linear endomorphisms of the tensor packet;
* `ThetaPilotObject` records a generator together with the actual orbit of
  that generator under the splitting monoid (not an arbitrary set of points);
* the compatibility theorem with the existing `PolyIsoAction` follows from
  linearity of `PolyIsoAction.tensorMap`.

The standard inhabitant uses the coefficient field `Real`, the one-point
place model, the shell module `Real`, and the actual theta values
`realThetaValue 2 (j+1)` for `j = 0,...,lStar-1`.  This is a concrete finite
inhabitant of the interface.  It is **not** the paper's construction of the
global Gaussian `U_j`, does not construct the source `F_mod` copies, does not
construct the `1,circ U_{j,vQ}` regions, and does not assert that N4 or N5 is
closed.  The remaining source data are explicit parameters of the structures
below, not hidden assumptions.
-/

namespace LeanFormal.IUT
namespace Theorem311Source
namespace SourceLGPMonoidLayer

open scoped BigOperators TensorProduct

open SourceProcessionCapsule
  (Capsule DirectSumFactor TensorPacket PolyIsoAction tensorPacketEquiv
    LogShellFamily capsuleLevels SourceProcessionCapsuleContract)

noncomputable section

universe uM uR uVQ uPlace uShell uV uA uP uMono uI

/-! ## 1. The LGP carrier and its splitting monoid -/

/-- The source-level interface for one local LGP-monoid.  The carrier is an
    arbitrary multiplicative monoid.  `splittingMonoid` is required to be the
    submonoid generated by the displayed theta values, so `LGPMonoid` cannot
    be inhabited by silently declaring an unrelated one-point monoid while
    keeping the theta-value name. -/
structure LGPMonoid (l : PrimeGeFive) where
  Carrier : Type uM
  [commMonoid : CommMonoid Carrier]
  splittingMonoid : Submonoid Carrier
  thetaValueGenerator : Fin (lStar l.value) -> Carrier
  splittingMonoid_eq_closure :
    splittingMonoid = Submonoid.closure (Set.range thetaValueGenerator)

attribute [instance] LGPMonoid.commMonoid

namespace LGPMonoid

variable {l : PrimeGeFive} (G : LGPMonoid l)

/-- The theta-value generators lie in the splitting monoid by construction. -/
theorem thetaValueGenerator_mem (i : Fin (lStar l.value)) :
    G.thetaValueGenerator i ∈ G.splittingMonoid := by
  rw [G.splittingMonoid_eq_closure]
  exact Submonoid.subset_closure ⟨i, rfl⟩

/-- The distinguished submonoid is generated by the theta values. -/
theorem splittingMonoid_generated_by_thetaValues :
    G.splittingMonoid =
      Submonoid.closure (Set.range G.thetaValueGenerator) :=
  G.splittingMonoid_eq_closure

/-- The theta generator index type is nonempty for every prime label at least
    five.  This is the elementary index fact used by the standard inhabitant. -/
theorem thetaIndex_nonempty : Nonempty (Fin (lStar l.value)) := by
  refine ⟨⟨0, ?_⟩⟩
  have h5 : 5 <= l.value := l.ge_five
  have h2 : 2 <= l.value - 1 := by omega
  unfold lStar
  exact Nat.div_pos h2 (by norm_num)

end LGPMonoid

/-- The index `j = 1` in the paper, represented by the zero element of
    `Fin (lStar l.value)`. -/
def thetaIndexZero (l : PrimeGeFive) : Fin (lStar l.value) :=
  ⟨0, by
    have h5 : 5 <= l.value := l.ge_five
    have h2 : 2 <= l.value - 1 := by omega
    unfold lStar
    exact Nat.div_pos h2 (by norm_num)⟩

/-- The concrete theta value `q_v ^ (j+1)^2` used by the standard finite
    inhabitant.  The case `j = 0` is the source value for the first positive
    label `1`; the value `2` is the explicit finite choice of `q_v`. -/
def standardThetaValue (l : PrimeGeFive) (i : Fin (lStar l.value)) : Real :=
  realThetaValue 2 ((i.1 : Int) + 1)

@[simp] theorem standardThetaValue_zero (l : PrimeGeFive) :
    standardThetaValue l (thetaIndexZero l) = 2 := by
  simp [standardThetaValue, thetaIndexZero, realThetaValue, gaussExponent]

theorem standardThetaValue_zero_ne_one (l : PrimeGeFive) :
    Ne (standardThetaValue l (thetaIndexZero l)) 1 := by
  rw [standardThetaValue_zero]
  norm_num

theorem standardThetaValue_pos (l : PrimeGeFive)
    (i : Fin (lStar l.value)) :
    0 < standardThetaValue l i :=
  realThetaValue_pos (by norm_num : (0 : Real) < 2) ((i.1 : Int) + 1)

/-- The concrete finite LGP-monoid.  Its splitting monoid is, by definition,
    the closure of the actual real theta values; the proof field is therefore
    definitional and no choice of an unrelated monoid is hidden. -/
def standardLGPMonoid (l : PrimeGeFive) : LGPMonoid l where
  Carrier := Real
  commMonoid := inferInstance
  splittingMonoid :=
    Submonoid.closure (Set.range (standardThetaValue l))
  thetaValueGenerator := standardThetaValue l
  splittingMonoid_eq_closure := rfl

/-- The standard splitting monoid contains the first nonzero theta value. -/
theorem standardThetaValue_mem_splitting (l : PrimeGeFive) :
    standardThetaValue l (thetaIndexZero l) ∈
      (standardLGPMonoid l).splittingMonoid :=
  (standardLGPMonoid l).thetaValueGenerator_mem (thetaIndexZero l)

/-! ## 2. Actions on tensor packets -/

/-- A scalar character from an LGP carrier to the coefficient ring.  The
    paper's action has additional geometric content; at this interface layer
    the character is the explicit datum needed to define the induced linear
    action, and it is required to be multiplicative rather than an arbitrary
    function. -/
structure LGPMonoidAction {l : PrimeGeFive} (G : LGPMonoid.{uM} l)
    (R : Type uR) [CommSemiring R] {VQ : Type uVQ} {Place : VQ -> Type uPlace}
    {j : Nat} (L : LogShellFamily.{uR, uVQ, uPlace, uShell} R Place j) where
  scalar : MonoidHom G.Carrier R

namespace LGPMonoidAction

variable {l : PrimeGeFive} {G : LGPMonoid.{uM} l}
variable {R : Type uR} [CommSemiring R]
variable {VQ : Type uVQ} {Place : VQ -> Type uPlace} {j : Nat}
variable {L : LogShellFamily.{uR, uVQ, uPlace, uShell} R Place j}

/-- The actual action of the LGP carrier on a tensor packet: a carrier element
    is sent to scalar multiplication by its character value. -/
def actionOnTensorPacket (P : LGPMonoidAction G R L) (vQ : VQ) :
    MonoidHom G.Carrier (Module.End R (TensorPacket L vQ)) where
  toFun g := LinearMap.lsmul R (TensorPacket L vQ) (P.scalar g)
  map_one' := by
    ext x
    simp [LinearMap.lsmul_apply]
  map_mul' := by
    intro g h
    apply LinearMap.ext
    intro x
    rw [map_mul, Module.End.mul_apply, LinearMap.lsmul_apply,
      LinearMap.lsmul_apply, LinearMap.lsmul_apply, mul_smul]

@[simp] theorem actionOnTensorPacket_apply (P : LGPMonoidAction G R L)
    (vQ : VQ) (g : G.Carrier) (x : TensorPacket L vQ) :
    actionOnTensorPacket P vQ g x = P.scalar g • x :=
  rfl

/-- The action is compatible with the existing poly-isomorphism action: the
    induced map on tensor packets is linear over the coefficient ring, so it
    carries scalar multiplication to scalar multiplication.  This is the
    portion of the action/poly-isomorphism square that follows from the data
    already present in `SourceProcessionCapsuleData`. -/
theorem tensorMap_actionOnTensorPacket (P : LGPMonoidAction G R L)
    (A : PolyIsoAction L) (vQ : VQ) (g : G.Carrier)
    (x : TensorPacket L vQ) :
    A.tensorMap vQ (actionOnTensorPacket P vQ g x) =
      P.scalar g • A.tensorMap vQ x := by
  rw [actionOnTensorPacket_apply]
  exact (A.tensorMap vQ).map_smul (P.scalar g) x

/-- The action is compatible with the distribution equivalence of the tensor
    packet: distributing the packet after acting is the same as scalar
    multiplying the distributed packet. -/
theorem tensorPacketEquiv_actionOnTensorPacket
    (P : LGPMonoidAction G R L) (vQ : VQ) [Fintype (Place vQ)]
    (g : G.Carrier) (x : TensorPacket L vQ) :
    tensorPacketEquiv L vQ (actionOnTensorPacket P vQ g x) =
      P.scalar g • tensorPacketEquiv L vQ x := by
  rw [actionOnTensorPacket_apply]
  exact (tensorPacketEquiv L vQ).map_smul (P.scalar g) x

end LGPMonoidAction

/-! ## 3. Theta-pilot objects and their actual image orbits -/

/-- A finite model of the Θ-pilot object at one tensor packet.  The field
    `possibleImage` is not an arbitrary set: it is the exact orbit of the
    chosen generator under the splitting monoid.  This is the image layer used
    by the later hull construction, not the source `ThetaPilotObject` itself. -/
structure ThetaPilotObject {l : PrimeGeFive} {G : LGPMonoid.{uM} l}
    {R : Type uR} [CommSemiring R] {VQ : Type uVQ} {Place : VQ -> Type uPlace}
    {j : Nat} {L : LogShellFamily.{uR, uVQ, uPlace, uShell} R Place j}
    (P : LGPMonoidAction G R L) (vQ : VQ) where
  generator : TensorPacket L vQ
  possibleImage : Set (TensorPacket L vQ)
  possibleImage_eq_orbit :
    possibleImage =
      {x | exists g : G.Carrier, g ∈ G.splittingMonoid ∧
        x = (LGPMonoidAction.actionOnTensorPacket P vQ) g generator}

namespace ThetaPilotObject

variable {l : PrimeGeFive} {G : LGPMonoid.{uM} l}
variable {R : Type uR} [CommSemiring R]
variable {VQ : Type uVQ} {Place : VQ -> Type uPlace} {j : Nat}
variable {L : LogShellFamily.{uR, uVQ, uPlace, uShell} R Place j}
variable {P : LGPMonoidAction G R L} {vQ : VQ}

/-- The canonical theta-pilot object generated by any packet element.  The
    image is defined as the splitting-monoid orbit, so the construction is a
    real orbit rather than a free-standing set. -/
def ofGenerator (P : LGPMonoidAction G R L) (vQ : VQ)
    (generator : TensorPacket L vQ) : ThetaPilotObject P vQ where
  generator := generator
  possibleImage :=
    {x | exists g : G.Carrier, g ∈ G.splittingMonoid ∧
      x = (LGPMonoidAction.actionOnTensorPacket P vQ) g generator}
  possibleImage_eq_orbit := rfl

theorem mem_possibleImage_iff (T : ThetaPilotObject P vQ)
    (x : TensorPacket L vQ) :
    x ∈ T.possibleImage ↔
      exists g : G.Carrier, g ∈ G.splittingMonoid ∧
        x = (LGPMonoidAction.actionOnTensorPacket P vQ) g T.generator := by
  rw [T.possibleImage_eq_orbit]
  rfl

theorem generator_mem_possibleImage (T : ThetaPilotObject P vQ) :
    T.generator ∈ T.possibleImage := by
  rw [mem_possibleImage_iff]
  refine ⟨1, G.splittingMonoid.one_mem, ?_⟩
  simp

theorem possibleImage_nonempty (T : ThetaPilotObject P vQ) :
    T.possibleImage.Nonempty :=
  ⟨T.generator, generator_mem_possibleImage T⟩

theorem action_mem_possibleImage (T : ThetaPilotObject P vQ)
    {g : G.Carrier} (hg : g ∈ G.splittingMonoid)
    {x : TensorPacket L vQ} (hx : x ∈ T.possibleImage) :
    (LGPMonoidAction.actionOnTensorPacket P vQ) g x ∈ T.possibleImage := by
  rw [mem_possibleImage_iff] at hx ⊢
  rcases hx with ⟨h, hh, rfl⟩
  refine ⟨g * h, G.splittingMonoid.mul_mem hg hh, ?_⟩
  rw [map_mul]
  rfl

end ThetaPilotObject

/-! ## 4. A concrete finite inhabitant -/

/-- The one-point real log-shell family used by the standard finite model. -/
def standardRealLogShellFamily (j : Nat) :
    LogShellFamily.{0, 0, 0, 0} Real (fun _ : Unit => Unit) j where
  Shell := fun _ _ _ => Real
  addCommMonoid := fun _ _ _ => inferInstance
  module := fun _ _ _ => inferInstance

/-- The scalar character used by the standard finite model. -/
def standardLGPMonoidAction (l : PrimeGeFive) {VQ : Type uVQ} {Place : VQ -> Type uPlace}
    {j : Nat} (L : LogShellFamily.{0, uVQ, uPlace, 0} Real Place j) :
    LGPMonoidAction (standardLGPMonoid l) Real L where
  scalar := MonoidHom.id Real

/-- A concrete generator in the standard real tensor packet: the pure tensor
    whose every local factor is `1`. -/
def standardThetaPilotGenerator (j : Nat) :
    TensorPacket (standardRealLogShellFamily j) () :=
  PiTensorProduct.tprod Real (fun _ _ => (1 : Real))

/-- A concrete theta-pilot object in the standard finite model. -/
def standardThetaPilotObject (l : PrimeGeFive) (j : Nat) :
    ThetaPilotObject
      (standardLGPMonoidAction l (standardRealLogShellFamily j)) () :=
  ThetaPilotObject.ofGenerator
    (standardLGPMonoidAction l (standardRealLogShellFamily j)) ()
    (standardThetaPilotGenerator j)

/-- The standard theta-pilot image is nonempty. -/
theorem standardThetaPilotObject_nonempty (l : PrimeGeFive) (j : Nat) :
    (standardThetaPilotObject l j).possibleImage.Nonempty :=
  ThetaPilotObject.possibleImage_nonempty (standardThetaPilotObject l j)

/-! ## 5. Coupling to the P1 capsule contract -/

/-- The P2 data attached to the actual P1 contract: an LGP-monoid and a
    scalar action on every capsule level. -/
structure SourceLGPData (R : Type uR) [CommSemiring R]
    (l : PrimeGeFive) (V : Type uV) (I : OriginalInput.{uA, uV, uP, uMono, uI} l V) where
  capsule : SourceProcessionCapsuleContract.{uA, uV, uP, uMono, uI, uR, uVQ, uPlace, uShell} R l V I
  lgp : LGPMonoid.{uM} l
  action : (j : Fin (capsuleLevels l)) ->
    LGPMonoidAction.{uM, uR, uVQ, uPlace, uShell} lgp R (capsule.logShell j)

namespace SourceLGPData

variable {R : Type uR} [CommSemiring R]
variable {l : PrimeGeFive} {V : Type uV}
variable {I : OriginalInput.{uA, uV, uP, uMono, uI} l V}

/-- The tensor packet on which the P2 action acts. -/
abbrev tensorPacket (D : SourceLGPData R l V I)
    (j : Fin (capsuleLevels l)) (vQ : D.capsule.VQ) :=
  SourceProcessionCapsuleContract.tensorPacket R D.capsule j vQ

/-- The carrier action on the source tensor packet, obtained by transporting
    the abstract action through the P1 contract. -/
def actionOnTensorPacket (D : SourceLGPData R l V I)
    (j : Fin (capsuleLevels l)) (vQ : D.capsule.VQ) :
    MonoidHom D.lgp.Carrier (Module.End R (D.tensorPacket j vQ)) :=
  LGPMonoidAction.actionOnTensorPacket (D.action j) vQ

/-- The P2 action is compatible with the P1 poly-isomorphism at every capsule
    level and every valuation. -/
theorem tensorMap_actionOnTensorPacket (D : SourceLGPData R l V I)
    (j : Fin (capsuleLevels l)) (vQ : D.capsule.VQ)
    (g : D.lgp.Carrier) (x : D.tensorPacket j vQ) :
    (D.capsule.polyIso j).tensorMap vQ
        (D.actionOnTensorPacket j vQ g x) =
      (D.action j).scalar g •
        (D.capsule.polyIso j).tensorMap vQ x :=
  LGPMonoidAction.tensorMap_actionOnTensorPacket
    (D.action j) (D.capsule.polyIso j) vQ g x

end SourceLGPData

/-- The standard P2 data over the trivial P1 capsule contract.  This is a real
    inhabitant of the coupled interface, not a source-level construction of
    the global Gaussian object. -/
def standardSourceLGPData
    (I : OriginalInput.{uA, uV, uP, uMono, uI} l V) :
    SourceLGPData.{0, 0, 0, 0, 0, uV, uA, uP, uMono, uI} Real l V I :=
  let C := SourceProcessionCapsuleContract.trivial Real I
  { capsule := C
    lgp := standardLGPMonoid l
    action := fun j => standardLGPMonoidAction l (C.logShell j) }

theorem standardSourceLGPData_nonempty
    (I : OriginalInput.{uA, uV, uP, uMono, uI} l V) :
    Nonempty
      (SourceLGPData.{0, 0, 0, 0, 0, uV, uA, uP, uMono, uI}
        Real l V I) :=
  ⟨standardSourceLGPData I⟩

end

end SourceLGPMonoidLayer

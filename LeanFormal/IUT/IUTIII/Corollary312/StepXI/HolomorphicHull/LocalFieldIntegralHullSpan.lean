import LeanFormal.IUT.IUTIII.Corollary312.StepXI.HolomorphicHull.LocalFieldIntegralHull

/-!
# The actual integral-module span equals the compact nondegenerate hull

Coordinate maximizers of the input give generators after projection by
integral coordinate coefficients. Thus the smallest lambda*O region is
the actual O-module generated by the input, not only a region supplied
with closure laws. This is used for the finite logarithmic tensor image.
-/

namespace LeanFormal.IUT.LocalFieldProductHull

noncomputable section

variable {J : Type*} {E : J → Type*} [∀ j, NormedField (E j)]

theorem integralSpan_subset_hull
    (hna : ∀ j, IsNonarchimedean (Norm.norm : E j → ℝ)) (S : Set ((j : J) → E j)) :
    (Submodule.span (integralRing hna) S : Set ((j : J) → E j)) ⊆ hull S := by
  intro x hx lam _ hsub
  have hspan : Submodule.span (integralRing hna) S ≤ regionModule hna lam :=
    Submodule.span_le.mpr hsub
  exact hspan hx

theorem hull_subset_integralSpan [Finite J]
    (hna : ∀ j, IsNonarchimedean (Norm.norm : E j → ℝ))
    {S : Set ((j : J) → E j)} (hS : IsCompact S) (hne : S.Nonempty)
    (hcoord : ∀ j, ∃ x ∈ S, x j ≠ 0) :
    hull S ⊆ (Submodule.span (integralRing hna) S : Set ((j : J) → E j)) := by
  classical
  letI := Fintype.ofFinite J
  obtain ⟨lam, hrealized, hbound⟩ := exists_coordinate_maxima hS hne
  have hlam : ∀ j, lam j ≠ 0 := by
    intro j
    obtain ⟨w, hw, hwj⟩ := hcoord j
    exact norm_pos_iff.mp ((norm_pos_iff.mpr hwj).trans_le (hbound hw j))
  choose w hw hlamw using hrealized
  intro x hx
  have hxbound := hull_minimal hlam hbound hx
  let coefficient (j : J) : integralRing hna :=
    ⟨Pi.single j (x j / lam j), by
      intro k
      by_cases hkj : k = j
      · subst k
        simp only [Pi.single_eq_same]
        rw [norm_div, div_le_one (norm_pos_iff.mpr (hlam j))]
        exact hxbound j
      · simp only [Pi.single_eq_of_ne hkj, norm_zero, zero_le_one]⟩
  have hsingle : ∀ j, Pi.single j (x j) ∈ Submodule.span (integralRing hna) S := by
    intro j
    have hmem := Submodule.smul_mem (Submodule.span (integralRing hna) S)
      (coefficient j) (Submodule.subset_span (hw j))
    have heq : coefficient j • w j = Pi.single j (x j) := by
      ext k
      change (coefficient j : (j : J) → E j) k * w j k = (Pi.single j (x j)) k
      by_cases hkj : k = j
      · subst k
        change (Pi.single j (x j / lam j)) j * w j j = (Pi.single j (x j)) j
        simp only [Pi.single_eq_same]
        rw [← hlamw j]
        exact div_mul_cancel₀ _ (hlam j)
      · change (Pi.single j (x j / lam j)) k * w j k = (Pi.single j (x j)) k
        simp only [Pi.single_eq_of_ne hkj, zero_mul]
    exact heq ▸ hmem
  have hsum := Submodule.sum_mem (Submodule.span (integralRing hna) S)
    (fun j (_ : j ∈ (Finset.univ : Finset J)) => hsingle j)
  have heqsum : (∑ j : J, Pi.single j (x j)) = x := by
    ext j
    simp
  exact heqsum ▸ hsum

theorem integralSpan_eq_hull [Finite J]
    (hna : ∀ j, IsNonarchimedean (Norm.norm : E j → ℝ))
    {S : Set ((j : J) → E j)} (hS : IsCompact S) (hne : S.Nonempty)
    (hcoord : ∀ j, ∃ x ∈ S, x j ≠ 0) :
    (Submodule.span (integralRing hna) S : Set ((j : J) → E j)) = hull S :=
  Set.Subset.antisymm (integralSpan_subset_hull hna S)
    (hull_subset_integralSpan hna hS hne hcoord)

end

end LeanFormal.IUT.LocalFieldProductHull

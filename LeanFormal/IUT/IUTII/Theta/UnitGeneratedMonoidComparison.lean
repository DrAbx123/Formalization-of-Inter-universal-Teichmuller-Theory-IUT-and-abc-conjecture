import Mathlib.Algebra.Group.Submonoid.Basic
import Mathlib.Algebra.Group.TypeTags.Basic
import Mathlib.Algebra.Group.Prod
import Mathlib.Algebra.Group.Equiv.Basic
import Mathlib.Tactic

/-!
# Comparing monoids generated by a unit subgroup and one element

The unit groups in this file are independently supplied groups embedded in the
ambient commutative groups. They are not identified with all ambient elements
of degree zero. A degree homomorphism trivial on the supplied unit subgroup and
nonzero on the distinguished generator makes the expression `u(a) * q^n` unique.

An equivalence of the two supplied unit groups therefore induces an equivalence
of the actual generated submonoids. The two generator degrees need not agree.
The construction is natural under compatible ambient and unit monoid maps.

This is a conditional algebra theorem. It does not instantiate source local
fields, integral Frobenioid units, divisor degrees, or an IUT Theta-link.
-/

namespace LeanFormal.IUT.IUTII.Theta.UnitGeneratedMonoidComparison

open Multiplicative

section Representation

variable {U G : Type*} [Group U] [CommGroup G]

/-- The actual submonoid consisting of a supplied unit times a nonnegative
power of the distinguished generator. -/
def unitGeneratedSubmonoid (u : U →* G) (q : G) : Submonoid G where
  carrier := {x | ∃ a : U, ∃ n : ℕ, x = u a * q ^ n}
  one_mem' := ⟨1, 0, by simp⟩
  mul_mem' := by
    rintro x y ⟨a, m, rfl⟩ ⟨b, n, rfl⟩
    refine ⟨a * b, m + n, ?_⟩
    rw [map_mul, pow_add]
    ac_rfl

@[simp]
theorem mem_unitGeneratedSubmonoid (u : U →* G) (q x : G) :
    x ∈ unitGeneratedSubmonoid u q ↔ ∃ a : U, ∃ n : ℕ, x = u a * q ^ n :=
  Iff.rfl

/-- A unit-power expression viewed as an element of the generated submonoid. -/
def unitPowerElement (u : U →* G) (q : G) (a : U) (n : ℕ) :
    unitGeneratedSubmonoid u q :=
  ⟨u a * q ^ n, a, n, rfl⟩

@[simp]
theorem unitPowerElement_coe (u : U →* G) (q : G) (a : U) (n : ℕ) :
    (unitPowerElement u q a n : G) = u a * q ^ n := rfl

/-- The original unit embedding with its codomain restricted to the monoid. -/
def embeddedUnit (u : U →* G) (q : G) : U →* unitGeneratedSubmonoid u q where
  toFun a := ⟨u a, a, 0, by simp⟩
  map_one' := Subtype.ext (map_one u)
  map_mul' a b := Subtype.ext (map_mul u a b)

@[simp]
theorem embeddedUnit_coe (u : U →* G) (q : G) (a : U) :
    (embeddedUnit u q a : G) = u a := rfl

/-- The distinguished generator as an element of the generated submonoid. -/
def distinguishedGenerator (u : U →* G) (q : G) : unitGeneratedSubmonoid u q :=
  ⟨q, 1, 1, by simp⟩

@[simp]
theorem distinguishedGenerator_coe (u : U →* G) (q : G) :
    (distinguishedGenerator u q : G) = q := rfl

theorem unitPowerElement_eq (u : U →* G) (q : G) (a : U) (n : ℕ) :
    unitPowerElement u q a n = embeddedUnit u q a * distinguishedGenerator u q ^ n :=
  Subtype.ext rfl

/-- Nonzero generator degree separates the nonnegative powers, and the
injective unit embedding then separates the unit factors. -/
theorem unitPower_eq_iff (u : U →* G) (q : G)
    (degree : G →* Multiplicative ℤ) (hu : Function.Injective u)
    (hunit : ∀ a, degree (u a) = 1) (hq : (degree q).toAdd ≠ 0)
    (a b : U) (m n : ℕ) :
    u a * q ^ m = u b * q ^ n ↔ a = b ∧ m = n := by
  constructor
  · intro hab
    have hdegrees : (m : ℤ) * (degree q).toAdd =
        (n : ℤ) * (degree q).toAdd := by
      have h := congrArg (fun x : G => (degree x).toAdd) hab
      simpa only [map_mul, map_pow, hunit, one_mul, toAdd_pow, nsmul_eq_mul] using h
    have hmn : m = n := by
      exact_mod_cast (mul_right_cancel₀ hq hdegrees)
    subst n
    exact ⟨hu (mul_right_cancel hab), rfl⟩
  · rintro ⟨rfl, rfl⟩
    rfl

/-- Every element of the actual submonoid has a unique unit-power expression. -/
theorem existsUnique_unitPower (u : U →* G) (q : G)
    (degree : G →* Multiplicative ℤ) (hu : Function.Injective u)
    (hunit : ∀ a, degree (u a) = 1) (hq : (degree q).toAdd ≠ 0)
    (x : unitGeneratedSubmonoid u q) :
    ∃! r : U × ℕ, (x : G) = u r.1 * q ^ r.2 := by
  obtain ⟨a, n, hx⟩ := x.property
  refine ⟨(a, n), hx, ?_⟩
  rintro ⟨b, m⟩ hbm
  obtain ⟨hba, hmn⟩ := (unitPower_eq_iff u q degree hu hunit hq b a m n).mp
    (hbm.symm.trans hx)
  exact Prod.ext hba hmn

/-- Multiplicative coordinates for the unit-power expression. -/
def unitPowerRepresentation (u : U →* G) (q : G) :
    U × Multiplicative ℕ →* unitGeneratedSubmonoid u q where
  toFun r := unitPowerElement u q r.1 r.2.toAdd
  map_one' := Subtype.ext (by simp [unitPowerElement])
  map_mul' r s := by
    apply Subtype.ext
    change u (r.1 * s.1) * q ^ (r.2.toAdd + s.2.toAdd) =
      (u r.1 * q ^ r.2.toAdd) * (u s.1 * q ^ s.2.toAdd)
    rw [map_mul, pow_add]
    ac_rfl

theorem unitPowerRepresentation_injective (u : U →* G) (q : G)
    (degree : G →* Multiplicative ℤ) (hu : Function.Injective u)
    (hunit : ∀ a, degree (u a) = 1) (hq : (degree q).toAdd ≠ 0) :
    Function.Injective (unitPowerRepresentation u q) := by
  intro r s hrs
  obtain ⟨hunitCoord, hpowerCoord⟩ :=
    (unitPower_eq_iff u q degree hu hunit hq r.1 s.1 r.2.toAdd s.2.toAdd).mp
      (congrArg Subtype.val hrs)
  exact Prod.ext hunitCoord (Multiplicative.toAdd.injective hpowerCoord)

theorem unitPowerRepresentation_surjective (u : U →* G) (q : G) :
    Function.Surjective (unitPowerRepresentation u q) := by
  intro x
  obtain ⟨a, n, hx⟩ := x.property
  exact ⟨(a, Multiplicative.ofAdd n), Subtype.ext hx.symm⟩

/-- The unique unit-power coordinates identify the generated monoid with
`U × Multiplicative ℕ`. -/
noncomputable def unitPowerEquiv (u : U →* G) (q : G)
    (degree : G →* Multiplicative ℤ) (hu : Function.Injective u)
    (hunit : ∀ a, degree (u a) = 1) (hq : (degree q).toAdd ≠ 0) :
    (U × Multiplicative ℕ) ≃* unitGeneratedSubmonoid u q :=
  MulEquiv.ofBijective (unitPowerRepresentation u q)
    ⟨unitPowerRepresentation_injective u q degree hu hunit hq,
      unitPowerRepresentation_surjective u q⟩

@[simp]
theorem unitPowerEquiv_apply (u : U →* G) (q : G)
    (degree : G →* Multiplicative ℤ) (hu : Function.Injective u)
    (hunit : ∀ a, degree (u a) = 1) (hq : (degree q).toAdd ≠ 0)
    (r : U × Multiplicative ℕ) :
    unitPowerEquiv u q degree hu hunit hq r = unitPowerElement u q r.1 r.2.toAdd := rfl

end Representation

section Comparison

variable {U V G H : Type*} [Group U] [Group V] [CommGroup G] [CommGroup H]
variable (u : U →* G) (v : V →* H) (q : G) (theta : H)
variable (degreeG : G →* Multiplicative ℤ) (degreeH : H →* Multiplicative ℤ)
variable (hu : Function.Injective u) (hv : Function.Injective v)
variable (hunitG : ∀ a, degreeG (u a) = 1) (hunitH : ∀ b, degreeH (v b) = 1)
variable (hq : (degreeG q).toAdd ≠ 0) (htheta : (degreeH theta).toAdd ≠ 0)

/-- Compare the actual generated monoids by the given equivalence of their
unit groups and the same nonnegative exponent. Generator degrees may differ. -/
noncomputable def comparisonEquiv (e : U ≃* V) :
    unitGeneratedSubmonoid u q ≃* unitGeneratedSubmonoid v theta :=
  (unitPowerEquiv u q degreeG hu hunitG hq).symm.trans
    ((e.prodCongr (MulEquiv.refl (Multiplicative ℕ))).trans
      (unitPowerEquiv v theta degreeH hv hunitH htheta))

@[simp]
theorem comparisonEquiv_unitPower (e : U ≃* V) (a : U) (n : ℕ) :
    comparisonEquiv u v q theta degreeG degreeH hu hv hunitG hunitH hq htheta e
        (unitPowerElement u q a n) = unitPowerElement v theta (e a) n := by
  change (unitPowerEquiv v theta degreeH hv hunitH htheta)
    ((e.prodCongr (MulEquiv.refl (Multiplicative ℕ)))
      ((unitPowerEquiv u q degreeG hu hunitG hq).symm
        ((unitPowerEquiv u q degreeG hu hunitG hq) (a, Multiplicative.ofAdd n)))) = _
  rw [MulEquiv.symm_apply_apply]
  rfl

/-- Exact law on the embedded supplied unit group. -/
@[simp]
theorem comparisonEquiv_embeddedUnit (e : U ≃* V) (a : U) :
    comparisonEquiv u v q theta degreeG degreeH hu hv hunitG hunitH hq htheta e
        (embeddedUnit u q a) = embeddedUnit v theta (e a) := by
  have h := comparisonEquiv_unitPower u v q theta degreeG degreeH hu hv
    hunitG hunitH hq htheta e a 0
  simpa [unitPowerElement, embeddedUnit] using h

/-- Exact law on the distinguished generator. -/
@[simp]
theorem comparisonEquiv_generator (e : U ≃* V) :
    comparisonEquiv u v q theta degreeG degreeH hu hv hunitG hunitH hq htheta e
        (distinguishedGenerator u q) = distinguishedGenerator v theta := by
  have h := comparisonEquiv_unitPower u v q theta degreeG degreeH hu hv
    hunitG hunitH hq htheta e 1 1
  simpa [unitPowerElement, distinguishedGenerator] using h

/-- The comparison written in the two ambient groups. -/
theorem comparisonEquiv_coe_unitPower (e : U ≃* V) (a : U) (n : ℕ) :
    (comparisonEquiv u v q theta degreeG degreeH hu hv hunitG hunitH hq htheta e
        (unitPowerElement u q a n) : H) = v (e a) * theta ^ n := by
  rw [comparisonEquiv_unitPower]
  rfl

end Comparison

section AmbientMap

variable {U U' G G' : Type*} [Group U] [Group U'] [CommGroup G] [CommGroup G']

/-- Restrict a compatible ambient map to the two actual generated submonoids.
Neither this construction nor its formula requires degree preservation. -/
def inducedMonoidMap (u : U →* G) (u' : U' →* G') (q : G) (q' : G')
    (ambient : G →* G') (units : U →* U')
    (hunits : ∀ a, ambient (u a) = u' (units a)) (hgenerator : ambient q = q') :
    unitGeneratedSubmonoid u q →* unitGeneratedSubmonoid u' q' where
  toFun x := ⟨ambient x, by
    obtain ⟨a, n, hx⟩ := x.property
    refine ⟨units a, n, ?_⟩
    rw [hx, map_mul, map_pow, hunits, hgenerator]⟩
  map_one' := Subtype.ext (map_one ambient)
  map_mul' x y := Subtype.ext (map_mul ambient (x : G) (y : G))

@[simp]
theorem inducedMonoidMap_coe (u : U →* G) (u' : U' →* G') (q : G) (q' : G')
    (ambient : G →* G') (units : U →* U')
    (hunits : ∀ a, ambient (u a) = u' (units a)) (hgenerator : ambient q = q')
    (x : unitGeneratedSubmonoid u q) :
    (inducedMonoidMap u u' q q' ambient units hunits hgenerator x : G') = ambient x := rfl

@[simp]
theorem inducedMonoidMap_unitPower (u : U →* G) (u' : U' →* G') (q : G) (q' : G')
    (ambient : G →* G') (units : U →* U')
    (hunits : ∀ a, ambient (u a) = u' (units a)) (hgenerator : ambient q = q')
    (a : U) (n : ℕ) :
    inducedMonoidMap u u' q q' ambient units hunits hgenerator (unitPowerElement u q a n) =
      unitPowerElement u' q' (units a) n := by
  apply Subtype.ext
  change ambient (u a * q ^ n) = u' (units a) * q' ^ n
  rw [map_mul, map_pow, hunits, hgenerator]

end AmbientMap

section Naturality

variable {U V G H U' V' G' H' : Type*}
variable [Group U] [Group V] [CommGroup G] [CommGroup H]
variable [Group U'] [Group V'] [CommGroup G'] [CommGroup H']

/-- Full naturality square for two pairs of presentations. The ambient maps
preserve the distinguished generators, the unit maps commute with the supplied
unit embeddings, and the two equivalences of unit groups intertwine those unit
maps. All four generator degrees are only required to be nonzero. -/
theorem comparisonEquiv_natural
    (u : U →* G) (v : V →* H) (q : G) (theta : H)
    (degreeG : G →* Multiplicative ℤ) (degreeH : H →* Multiplicative ℤ)
    (hu : Function.Injective u) (hv : Function.Injective v)
    (hunitG : ∀ a, degreeG (u a) = 1) (hunitH : ∀ b, degreeH (v b) = 1)
    (hq : (degreeG q).toAdd ≠ 0) (htheta : (degreeH theta).toAdd ≠ 0)
    (u' : U' →* G') (v' : V' →* H') (q' : G') (theta' : H')
    (degreeG' : G' →* Multiplicative ℤ) (degreeH' : H' →* Multiplicative ℤ)
    (hu' : Function.Injective u') (hv' : Function.Injective v')
    (hunitG' : ∀ a, degreeG' (u' a) = 1) (hunitH' : ∀ b, degreeH' (v' b) = 1)
    (hq' : (degreeG' q').toAdd ≠ 0) (htheta' : (degreeH' theta').toAdd ≠ 0)
    (e : U ≃* V) (e' : U' ≃* V')
    (ambientG : G →* G') (ambientH : H →* H')
    (unitsU : U →* U') (unitsV : V →* V')
    (hunitsG : ∀ a, ambientG (u a) = u' (unitsU a))
    (hunitsH : ∀ b, ambientH (v b) = v' (unitsV b))
    (hgeneratorG : ambientG q = q') (hgeneratorH : ambientH theta = theta')
    (hcompat : ∀ a, unitsV (e a) = e' (unitsU a))
    (x : unitGeneratedSubmonoid u q) :
    inducedMonoidMap v v' theta theta' ambientH unitsV hunitsH hgeneratorH
        (comparisonEquiv u v q theta degreeG degreeH hu hv hunitG hunitH hq htheta e x) =
      comparisonEquiv u' v' q' theta' degreeG' degreeH' hu' hv' hunitG' hunitH'
        hq' htheta' e'
        (inducedMonoidMap u u' q q' ambientG unitsU hunitsG hgeneratorG x) := by
  obtain ⟨a, n, hx⟩ := x.property
  have hxElement : x = unitPowerElement u q a n := Subtype.ext hx
  rw [hxElement, comparisonEquiv_unitPower, inducedMonoidMap_unitPower,
    inducedMonoidMap_unitPower, comparisonEquiv_unitPower, hcompat]

end Naturality

end LeanFormal.IUT.IUTII.Theta.UnitGeneratedMonoidComparison

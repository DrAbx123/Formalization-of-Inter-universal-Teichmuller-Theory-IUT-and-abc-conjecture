namespace LeanFormal.IUT.IUTII.Frobenioid
namespace Example36

open CategoryTheory CommAlgCat
open GaloisCorrespondence EtaleCoverFoundations GSetToEtaleAlgebra

universe u

variable (K : Type u) [Field K]

/-- The actual multiplicative equivalence between the profinite-group carrier of
`Iut.AbsoluteGaloisProfinite K` and `Gal(SeparableClosure K/K)`.  The underlying
type is the same and the group structures agree definitionally. -/
noncomputable def absoluteGaloisProfiniteMulEquivGaloisGroup :
    ↥(Iut.AbsoluteGaloisProfinite K) ≃*
      (SeparableClosure K ≃ₐ[K] SeparableClosure K) where
  toEquiv := Equiv.refl _
  map_mul' _ _ := rfl

/-- The actual action of the Galois group on the fiber `Hom_K(A, Kbar)` by
postcomposition with the induced automorphism of the separable closure. -/
noncomputable instance galoisActionOnFiber (A : CommAlgCat.FiniteEtale.{u} K) :
    MulAction (SeparableClosure K ≃ₐ[K] SeparableClosure K)
      (A.obj →ₐ[K] SeparableClosure K) where
  smul σ f := σ.toAlgHom.comp f
  one_smul f := by ext a; rfl
  mul_smul σ τ f := by ext a; rfl

/-- The finite-dimensional intermediate field generated by the image of a finite
K-basis of A under the point `f : A -> Kbar`.  This is the field whose fixing
subgroup is the stabilizer of `f` (the continuity input). -/
noncomputable def finiteEtaleFiberAdjoinField (A : CommAlgCat.FiniteEtale.{u} K)
    (f : A.obj →ₐ[K] SeparableClosure K) :
    IntermediateField K (SeparableClosure K) :=
  IntermediateField.adjoin K
    (Set.range (fun i : Fin (Module.finrank K A.obj) =>
      f (Module.finBasis K A.obj i)))

/-- The adjoin field is finite dimensional over K: the images of a finite K-basis
are integral (finite module over a field), and a finite-dimensional intermediate
field of the separable closure is generated by finitely many integral elements. -/
theorem finiteEtaleFiberAdjoinField_finiteDimensional
    (A : CommAlgCat.FiniteEtale.{u} K)
    (f : A.obj →ₐ[K] SeparableClosure K) :
    FiniteDimensional K (finiteEtaleFiberAdjoinField K A f) := by
  haveI : Algebra.IsIntegral K A.obj := Algebra.IsIntegral.of_finite K A.obj
  let b := Module.finBasis K A.obj
  have hSint : ∀ x ∈ Set.range (fun i => f (b i)), IsIntegral K x := by
    rintro x ⟨i, rfl⟩
    exact IsIntegral.map f (Algebra.IsIntegral.isIntegral (b i))
  haveI : Finite (Set.range (fun i => f (b i))) := (Set.finite_range _).to_subtype
  exact IntermediateField.finiteDimensional_adjoin hSint

lemma carrierSmulEqGalSmul (A : CommAlgCat.FiniteEtale.{u} K)
    (σ : ↥(Iut.AbsoluteGaloisProfinite K)) (x : ↥(finiteEtaleFiberSet (K := K) A)) :
    (show A.obj →ₐ[K] SeparableClosure K from
      (letI := finiteEtaleFiberSetMulAction (K := K) A; σ • x)) =
      (galoisActionOnFiber K A).smul (absoluteGaloisProfiniteMulEquivGaloisGroup K σ)
        (show A.obj →ₐ[K] SeparableClosure K from x) := rfl

theorem mem_stabilizer_iff_fixingSubgroup (A : CommAlgCat.FiniteEtale.{u} K)
    (x : ↥(finiteEtaleFiberSet (K := K) A)) (σ : ↥(Iut.AbsoluteGaloisProfinite K)) :
    σ ∈ MulAction.stabilizer (Iut.AbsoluteGaloisProfinite K) x ↔
      (absoluteGaloisProfiniteMulEquivGaloisGroup K σ) ∈
        (finiteEtaleFiberAdjoinField K A
          (show A.obj →ₐ[K] SeparableClosure K from x)).fixingSubgroup := by
  classical
  let f : A.obj →ₐ[K] SeparableClosure K := show A.obj →ₐ[K] SeparableClosure K from x
  let b := Module.finBasis K A.obj
  let L := finiteEtaleFiberAdjoinField K A f
  haveI hdim : FiniteDimensional K L := finiteEtaleFiberAdjoinField_finiteDimensional K A f
  rw [MulAction.mem_stabilizer_iff, IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro hσ y hy
    have hgal : (galoisActionOnFiber K A).smul
        (absoluteGaloisProfiniteMulEquivGaloisGroup K σ) f = f := by
      rw [← carrierSmulEqGalSmul (K := K) A σ x]
      exact congrArg (show A.obj →ₐ[K] SeparableClosure K from ·) hσ
    refine IntermediateField.adjoin_induction (F := K) (s := Set.range (fun i => f (b i)))
      (p := fun y _ => (absoluteGaloisProfiniteMulEquivGaloisGroup K σ) y = y)
      ?_ ?_ ?_ ?_ ?_ hy
    · rintro y ⟨i, rfl⟩
      exact congrArg (fun g : A.obj →ₐ[K] SeparableClosure K => g (b i)) hgal
    · intro a
      exact (absoluteGaloisProfiniteMulEquivGaloisGroup K σ).commutes a
    · intro y z hy hz hpy hpz
      rw [map_add, hpy, hpz]
    · intro y hy hpy
      rw [map_inv₀, hpy]
    · intro y z hy hz hpy hpz
      rw [map_mul, hpy, hpz]
  · intro hfix
    have hgal : (galoisActionOnFiber K A).smul
        (absoluteGaloisProfiniteMulEquivGaloisGroup K σ) f = f := by
      ext a
      haveI : Algebra.IsIntegral K A.obj := Algebra.IsIntegral.of_finite K A.obj
      have hmem : f a ∈ L := by
        have ha : a ∈ Submodule.span K (Set.range b) := by
          rw [b.span_eq]; exact Submodule.mem_top
        refine Submodule.span_induction (p := fun y _ => f y ∈ L) ?_ ?_ ?_ ?_ ha
        · rintro y ⟨i, rfl⟩
          exact IntermediateField.subset_adjoin K _ (Set.mem_range_self i)
        · simp
        · intro y z hy hz hpy hpz
          rw [map_add]; exact add_mem hpy hpz
        · intro c y hy hpy
          have hmap : f (c • y) = algebraMap K (SeparableClosure K) c * f y := by
            rw [Algebra.smul_def, map_mul, f.commutes]
          rw [hmap]
          exact mul_mem (IntermediateField.algebraMap_mem L c) hpy
      rw [show (galoisActionOnFiber K A).smul
          (absoluteGaloisProfiniteMulEquivGaloisGroup K σ) f =
            (absoluteGaloisProfiniteMulEquivGaloisGroup K σ).toAlgHom.comp f from rfl]
      change ((absoluteGaloisProfiniteMulEquivGaloisGroup K σ) (f a) : AlgebraicClosure K) =
        (f a : AlgebraicClosure K)
      exact congrArg (fun y : SeparableClosure K => (y : AlgebraicClosure K)) (hfix (f a) hmem)
    have hx : (letI := finiteEtaleFiberSetMulAction (K := K) A; σ • x) = x := by
      change (show A.obj →ₐ[K] SeparableClosure K from
        (letI := finiteEtaleFiberSetMulAction (K := K) A; σ • x)) = f
      rw [carrierSmulEqGalSmul]
      exact hgal
    exact hx

theorem finiteEtaleFiberStabilizer_isOpen (A : CommAlgCat.FiniteEtale.{u} K)
    (x : ↥(finiteEtaleFiberSet (K := K) A)) :
    IsOpen (MulAction.stabilizer (Iut.AbsoluteGaloisProfinite K) x :
      Set (Iut.AbsoluteGaloisProfinite K)) := by
  let f : A.obj →ₐ[K] SeparableClosure K := show A.obj →ₐ[K] SeparableClosure K from x
  let L := finiteEtaleFiberAdjoinField K A f
  haveI hdim : FiniteDimensional K L := finiteEtaleFiberAdjoinField_finiteDimensional K A f
  have hgal : IsOpen (L.fixingSubgroup : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) :=
    IntermediateField.fixingSubgroup_isOpen L
  have hset : (MulAction.stabilizer (Iut.AbsoluteGaloisProfinite K) x :
      Set (Iut.AbsoluteGaloisProfinite K)) =
      (absoluteGaloisProfiniteMulEquivGaloisGroup K) ⁻¹'
        (L.fixingSubgroup : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) := by
    ext σ
    exact mem_stabilizer_iff_fixingSubgroup K A x σ
  rw [hset]
  have hcont : Continuous (fun σ : ↥(Iut.AbsoluteGaloisProfinite K) =>
      ((absoluteGaloisProfiniteMulEquivGaloisGroup K) σ :
        SeparableClosure K ≃ₐ[K] SeparableClosure K)) := by
    change Continuous (id : ↥(Iut.AbsoluteGaloisProfinite K) →
      (SeparableClosure K ≃ₐ[K] SeparableClosure K))
    exact continuous_id
  exact hcont.isOpen_preimage _ hgal

theorem finiteEtaleObjectToGSet_isContinuous (A : CommAlgCat.FiniteEtale.{u} K) :
    EtaleCoverFoundations.IsContinuousFiniteGaloisSet (K := K)
      (finiteEtaleObjectToGSet K A) := by
  intro x
  exact finiteEtaleFiberStabilizer_isOpen K A x

noncomputable def finiteEtaleToContinuousGSet (A : CommAlgCat.FiniteEtale.{u} K) :
    EtaleCoverFoundations.FiniteContinuousGaloisSetCategory K :=
  ⟨finiteEtaleObjectToGSet K A, finiteEtaleObjectToGSet_isContinuous K A⟩


noncomputable def finiteEtaleFiberActionHom (A B : CommAlgCat.FiniteEtale.{u} K)
    (f : Opposite.op A ⟶ Opposite.op B) :
    finiteEtaleObjectToGSet K A ⟶ finiteEtaleObjectToGSet K B where
  hom := (fieldFiber K).map f
  comm g := by
    letI : MulAction ↥(Iut.AbsoluteGaloisProfinite K)
        (A.obj →ₐ[K] SeparableClosure K) := finiteEtaleFiberSetMulAction (K := K) A
    letI : MulAction ↥(Iut.AbsoluteGaloisProfinite K)
        (B.obj →ₐ[K] SeparableClosure K) := finiteEtaleFiberSetMulAction (K := K) B
    apply FintypeCat.hom_ext
    intro x
    rw [FintypeCat.comp_apply, FintypeCat.comp_apply]
    change (fieldFiber K).map f (g • x) = g • ((fieldFiber K).map f x)
    rw [CommAlgCat.FiniteEtale.fiber_map]
    change (AlgHom.comp (g • x) (Hom.hom f.unop.hom)) =
      g • (AlgHom.comp x (Hom.hom f.unop.hom))
    change (((g : SeparableClosure K ≃ₐ[K] SeparableClosure K).toAlgHom.comp x).comp
        (Hom.hom f.unop.hom)) =
      (g : SeparableClosure K ≃ₐ[K] SeparableClosure K).toAlgHom.comp
        (x.comp (Hom.hom f.unop.hom))
    rfl

noncomputable def finiteEtaleToActionFunctor :
    (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ ⥤ FiniteGaloisSetCategory K where
  obj X := finiteEtaleObjectToGSet K X.unop
  map {X Y} f := finiteEtaleFiberActionHom K X.unop Y.unop f
  map_id X := by
    apply Action.Hom.ext
    apply FintypeCat.hom_ext
    intro x
    rfl
  map_comp {X Y Z} f g := by
    apply Action.Hom.ext
    apply FintypeCat.hom_ext
    intro x
    rfl

noncomputable def finiteEtaleToContinuousFunctor :
    (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ ⥤ FiniteContinuousGaloisSetCategory K :=
  ObjectProperty.lift (fun X : FiniteGaloisSetCategory K => IsContinuousFiniteGaloisSet (K := K) X)
    (finiteEtaleToActionFunctor K)
    (fun X => finiteEtaleObjectToGSet_isContinuous K X.unop)


noncomputable def finiteContinuousGaloisSetCategoryToOpenStabilizers :
    FiniteContinuousGaloisSetCategory K ⥤
      openStabilizerActions (Iut.AbsoluteGaloisProfinite K) :=
  ObjectProperty.lift (fun X : FiniteGaloisSetCategory K =>
      HasOpenStabilizers (Iut.AbsoluteGaloisProfinite K) X)
    (forgetFiniteContinuousGaloisSet (K := K))
    (fun X => by
      intro x
      exact X.2 x)

noncomputable def finiteContinuousGaloisSetCategoryToContinuous :
    FiniteContinuousGaloisSetCategory K ⥤
      finiteContinuousGaloisSets (Iut.AbsoluteGaloisProfinite K) :=
  finiteContinuousGaloisSetCategoryToOpenStabilizers K
    ⋙ openStabilizerActionsToContinuous (Iut.AbsoluteGaloisProfinite K)

noncomputable def finiteEtaleToContinuousGaloisSetsFunctor :
    (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ ⥤
      finiteContinuousGaloisSets (Iut.AbsoluteGaloisProfinite K) :=
  finiteEtaleToContinuousFunctor K ⋙ finiteContinuousGaloisSetCategoryToContinuous K

noncomputable def finiteEtaleFiberIsoContinuous :
    fieldFiber K ≅
      finiteEtaleToContinuousGaloisSetsFunctor K
        ⋙ finiteContinuousGaloisSetFiber (Iut.AbsoluteGaloisProfinite K) :=
  NatIso.ofComponents (fun A => Iso.refl _) (fun f => by ext x; rfl)


/-- The actual reverse object map at the level of the finite continuous G_K-set
category: a continuous action is a `FiniteContinuousGSet` because its point
stabilizers are open (the `ContAction` continuity condition is exactly the
open-stabilizer condition). -/
noncomputable def continuousGSetToFiniteContinuousGSet
    (X : finiteContinuousGaloisSets (Iut.AbsoluteGaloisProfinite K)) :
    FiniteContinuousGSet K where
  toGSet := X.obj
  stabilizer_isOpen := by
    intro x
    exact hasOpenStabilizers_of_action_isContinuous
      (Iut.AbsoluteGaloisProfinite K) X.obj X.2 x

/-- The actual reverse object map: a finite continuous G_K-set yields the finite
etale K-algebra A_X (the product of the fixed fields of its orbit stabilizers,
from the task-78 actual object construction). -/
noncomputable def continuousGSetToFiniteEtaleObject
    (X : finiteContinuousGaloisSets (Iut.AbsoluteGaloisProfinite K)) :
    CommAlgCat.FiniteEtale.{u} K :=
  FiniteContinuousGSet.gSetToFiniteEtaleObject
    (continuousGSetToFiniteContinuousGSet K X)

noncomputable def orbitImage (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) : Y.orbitIndex :=
  Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥Y.toGSet.V)
    (show ↥Y.toGSet.V from f.hom q.out)

theorem orbitImage_out_mem (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) :
    ∃ g : galoisGroup K,
      g • (Quotient.out (orbitImage K X Y f q)) =
        (show ↥Y.toGSet.V from f.hom q.out) := by
  classical
  have hq : Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥Y.toGSet.V)
        (show ↥Y.toGSet.V from f.hom q.out) =
      Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥Y.toGSet.V)
        (Quotient.out (orbitImage K X Y f q)) := by
    calc Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥Y.toGSet.V)
          (show ↥Y.toGSet.V from f.hom q.out) = orbitImage K X Y f q := rfl
      _ = Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥Y.toGSet.V)
            (Quotient.out (orbitImage K X Y f q)) :=
        (Quotient.out_eq' (s₁ := MulAction.orbitRel (galoisGroup K) ↥Y.toGSet.V)
          (orbitImage K X Y f q)).symm
  have hrel : (show ↥Y.toGSet.V from f.hom q.out) ∈
      MulAction.orbit (galoisGroup K) (Quotient.out (orbitImage K X Y f q)) := by
    rw [← MulAction.orbitRel_apply]
    exact Quotient.exact hq
  exact MulAction.mem_orbit_iff.mp hrel

noncomputable def orbitTwist (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) : galoisGroup K :=
  Classical.choose (orbitImage_out_mem K X Y f q)

theorem orbitTwist_spec (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) :
    orbitTwist K X Y f q • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out) :=
  Classical.choose_spec (orbitImage_out_mem K X Y f q)

lemma actionHom_smul_apply (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (g : galoisGroup K) (x : ↥X.toGSet.V) :
    (show ↥Y.toGSet.V from f.hom (g • x)) = g • (show ↥Y.toGSet.V from f.hom x) := by
  have h := congrFun (congrArg (fun k : X.toGSet.V ⟶ Y.toGSet.V =>
    (k : ↥X.toGSet.V → ↥Y.toGSet.V)) (Action.Hom.comm f g)) x
  change (ConcreteCategory.hom f.hom)
      ((ConcreteCategory.hom (X.toGSet.ρ g)) x) =
    (ConcreteCategory.hom (Y.toGSet.ρ g))
      ((ConcreteCategory.hom f.hom) x)
  simpa [FintypeCat.comp_apply] using h

theorem orbitStabilizer_conj_mem (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) :
    ∀ h : galoisGroup K, h ∈ (X.orbitStabilizer q).toSubgroup →
      (orbitTwist K X Y f q)⁻¹ * h * orbitTwist K X Y f q ∈
        (Y.orbitStabilizer (orbitImage K X Y f q)).toSubgroup := by
  intro h hh
  have hh' : h • (Quotient.out q) = Quotient.out q := by
    simpa [FiniteContinuousGSet.orbitStabilizer, MulAction.mem_stabilizer_iff] using hh
  let g := orbitTwist K X Y f q
  let r := orbitImage K X Y f q
  change (g⁻¹ * h * g) • (Quotient.out r) = Quotient.out r
  calc (g⁻¹ * h * g) • (Quotient.out r)
      = g⁻¹ • (h • (g • (Quotient.out r))) := by rw [mul_smul, mul_smul]
    _ = g⁻¹ • (h • (show ↥Y.toGSet.V from f.hom (Quotient.out q))) := by
        rw [orbitTwist_spec K X Y f q]
    _ = g⁻¹ • (show ↥Y.toGSet.V from f.hom (h • (Quotient.out q))) := by
        rw [← actionHom_smul_apply K X Y f h (Quotient.out q)]
    _ = g⁻¹ • (show ↥Y.toGSet.V from f.hom (Quotient.out q)) := by rw [hh']
    _ = Quotient.out r := by
        rw [← orbitTwist_spec K X Y f q]
        exact inv_smul_smul g (Quotient.out r)

theorem orbitFixedFieldMap_mem (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex)
    (y : ↥(Y.orbitFixedField (orbitImage K X Y f q))) :
    (galoisGroupToAlgEquiv K (orbitTwist K X Y f q)) (y : SeparableClosure K) ∈
      (X.orbitFixedField q) := by
  let g := orbitTwist K X Y f q
  let r := orbitImage K X Y f q
  change (galoisGroupToAlgEquiv K g) (y : SeparableClosure K) ∈
    IntermediateField.fixedField (X.orbitStabilizer q).toSubgroup
  rw [IntermediateField.mem_fixedField_iff]
  intro h hh
  let h' : galoisGroup K := show galoisGroup K from h
  have hh' : h' ∈ (X.orbitStabilizer q).toSubgroup := show h ∈ (X.orbitStabilizer q).toSubgroup from hh
  have hconj := orbitStabilizer_conj_mem K X Y f q h' hh'
  have hyfix : galoisGroupToAlgEquiv K (g⁻¹ * h' * g) (y : SeparableClosure K) =
      (y : SeparableClosure K) := by
    have hy : (y : SeparableClosure K) ∈
        IntermediateField.fixedField (Y.orbitStabilizer r).toSubgroup := y.2
    rw [IntermediateField.mem_fixedField_iff] at hy
    exact hy (g⁻¹ * h' * g) hconj
  have hmul : galoisGroupToAlgEquiv K h' * galoisGroupToAlgEquiv K g =
      galoisGroupToAlgEquiv K g * galoisGroupToAlgEquiv K (g⁻¹ * h' * g) := by
    rw [← galoisGroupToAlgEquiv_mul, ← galoisGroupToAlgEquiv_mul]
    congr 1
    group
  calc galoisGroupToAlgEquiv K h' (galoisGroupToAlgEquiv K g (y : SeparableClosure K))
      = (galoisGroupToAlgEquiv K h' * galoisGroupToAlgEquiv K g)
          (y : SeparableClosure K) := rfl
    _ = (galoisGroupToAlgEquiv K g * galoisGroupToAlgEquiv K (g⁻¹ * h' * g))
          (y : SeparableClosure K) := by rw [hmul]
    _ = galoisGroupToAlgEquiv K g (galoisGroupToAlgEquiv K (g⁻¹ * h' * g) (y : SeparableClosure K)) := rfl
    _ = galoisGroupToAlgEquiv K g (y : SeparableClosure K) := by rw [hyfix]

noncomputable def orbitFixedFieldMap (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) :
    ↥(Y.orbitFixedField (orbitImage K X Y f q)) →ₐ[K] ↥(X.orbitFixedField q) where
  toFun y := ⟨(galoisGroupToAlgEquiv K (orbitTwist K X Y f q)) (y : SeparableClosure K),
    orbitFixedFieldMap_mem K X Y f q y⟩
  map_one' := by ext; simp
  map_mul' x y := by ext; simp
  map_zero' := by ext; simp
  map_add' x y := by ext; simp
  commutes' a := by ext; simp

noncomputable def gSetToFiniteEtaleObjectMap (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) :
    ↥(Y.gSetToFiniteEtaleObject) →ₐ[K] ↥(X.gSetToFiniteEtaleObject) := by
  classical
  haveI : ∀ r : Y.orbitIndex, FiniteDimensional K ↥(Y.orbitFixedField r) :=
    fun r => Y.orbitFixedField_finiteDimensional r
  let Fpi : (Π r : Y.orbitIndex, ↥(Y.orbitFixedField r)) →ₐ[K]
      (Π q : X.orbitIndex, ↥(X.orbitFixedField q)) :=
    AlgHom.pi (fun q =>
      (algHomPiToSigmaEquiv K (fun r => ↥(Y.orbitFixedField r))
        (F := ↥(X.orbitFixedField q))).symm
        ⟨orbitImage K X Y f q, orbitFixedFieldMap K X Y f q⟩)
  exact (FiniteContinuousGSet.gSetToFiniteEtaleObjectAlgEquiv (K := K) X).symm.toAlgHom.comp
    (Fpi.comp (FiniteContinuousGSet.gSetToFiniteEtaleObjectAlgEquiv (K := K) Y).toAlgHom)


lemma orbitImage_id (X : FiniteContinuousGSet K) (q : X.orbitIndex) :
    orbitImage K X X (𝟙 X.toGSet) q = q := by
  change Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥X.toGSet.V) (Quotient.out q) = q
  exact Quotient.out_eq' q

lemma orbitFixedFieldMap_id_apply (X : FiniteContinuousGSet K) (q : X.orbitIndex)
    (a : ↥(X.orbitFixedField q)) :
    orbitFixedFieldMap K X X (𝟙 X.toGSet) q
        (cast (congrArg (fun r => ↥(X.orbitFixedField r)) (orbitImage_id K X q).symm) a) = a := by
  let h : q = orbitImage K X X (𝟙 X.toGSet) q := (orbitImage_id K X q).symm
  let g : galoisGroup K := orbitTwist K X X (𝟙 X.toGSet) q
  have hgmem : g ∈ (X.orbitStabilizer q).toSubgroup := by
    have hspec := orbitTwist_spec K X X (𝟙 X.toGSet) q
    rw [orbitImage_id K X q] at hspec
    change g ∈ MulAction.stabilizer (galoisGroup K) (Quotient.out q)
    rw [MulAction.mem_stabilizer_iff]
    simpa using hspec
  have hgfix : galoisGroupToAlgEquiv K g (a : SeparableClosure K) =
      (a : SeparableClosure K) := by
    have ha : (a : SeparableClosure K) ∈
        IntermediateField.fixedField (X.orbitStabilizer q).toSubgroup := a.2
    rw [IntermediateField.mem_fixedField_iff] at ha
    exact ha g hgmem
  have hval :
      (((cast (congrArg (fun r => ↥(X.orbitFixedField r)) h) a :
          ↥(X.orbitFixedField (orbitImage K X X (𝟙 X.toGSet) q))) : SeparableClosure K)) =
        (a : SeparableClosure K) := by
    rw [set_coe_cast (H' := congrArg (fun r => (X.orbitFixedField r : Set (SeparableClosure K))) h)]
  apply Subtype.ext
  change galoisGroupToAlgEquiv K g
      (((cast (congrArg (fun r => ↥(X.orbitFixedField r)) h) a :
          ↥(X.orbitFixedField (orbitImage K X X (𝟙 X.toGSet) q))) : SeparableClosure K)) =
    (a : SeparableClosure K)
  rw [hval, hgfix]


theorem gSetToFiniteEtaleObjectMap_id (X : FiniteContinuousGSet K) :
    gSetToFiniteEtaleObjectMap K X X (𝟙 X.toGSet) =
      AlgHom.id K (↥(X.gSetToFiniteEtaleObject)) := by
  classical
  haveI : ∀ r : X.orbitIndex, FiniteDimensional K ↥(X.orbitFixedField r) :=
    fun r => X.orbitFixedField_finiteDimensional r
  let e := FiniteContinuousGSet.gSetToFiniteEtaleObjectAlgEquiv (K := K) X
  let Fpi : (Π r : X.orbitIndex, ↥(X.orbitFixedField r)) →ₐ[K]
      (Π q : X.orbitIndex, ↥(X.orbitFixedField q)) :=
    AlgHom.pi (fun q =>
      (algHomPiToSigmaEquiv K (fun r => ↥(X.orbitFixedField r))
        (F := ↥(X.orbitFixedField q))).symm
        ⟨orbitImage K X X (𝟙 X.toGSet) q, orbitFixedFieldMap K X X (𝟙 X.toGSet) q⟩)
  have hmap : gSetToFiniteEtaleObjectMap K X X (𝟙 X.toGSet) =
      e.symm.toAlgHom.comp (Fpi.comp e.toAlgHom) := rfl
  have hcast : ∀ {i j : X.orbitIndex} (h : i = j)
      (b : Π r : X.orbitIndex, ↥(X.orbitFixedField r)),
      cast (congrArg (fun r => ↥(X.orbitFixedField r)) h) (b i) = b j := by
    intro i j h b
    cases h
    rfl
  have hFpi : ∀ (q : X.orbitIndex)
      (b : Π r : X.orbitIndex, ↥(X.orbitFixedField r)), Fpi b q = b q := by
    intro q b
    dsimp only [Fpi]
    rw [AlgHom.pi_apply]
    rw [algHomPiToSigmaEquiv_symm_apply]
    dsimp only [algHomPiInverse]
    rw [AlgHom.comp_apply, Pi.evalAlgHom_apply]
    have harg : cast (congrArg (fun r => ↥(X.orbitFixedField r))
        (orbitImage_id K X q).symm) (b q) =
        b (orbitImage K X X (𝟙 X.toGSet) q) :=
      hcast (orbitImage_id K X q).symm b
    rw [← harg]
    exact orbitFixedFieldMap_id_apply K X q (b q)
  rw [hmap]
  apply AlgHom.ext
  intro a
  change e.symm (Fpi (e a)) = a
  rw [AlgEquiv.symm_apply_eq]
  funext q
  exact hFpi q (e a)


lemma orbitFixedField_cast_coe {X : FiniteContinuousGSet K} {q q' : X.orbitIndex}
    (h : q = q') (y : ↥(X.orbitFixedField q)) :
    ((cast (congrArg (fun r => ↥(X.orbitFixedField r)) h) y :
        ↥(X.orbitFixedField q')) : SeparableClosure K) = (y : SeparableClosure K) := by
  cases h
  rfl
/-! ## Composition of orbit images -/
/-- The image orbit of a composite morphism is the composite of the image orbits. -/
theorem orbitImage_comp (X Y Z : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (h : Y.toGSet ⟶ Z.toGSet) (q : X.orbitIndex) :
    orbitImage K X Z (f ≫ h) q =
      orbitImage K Y Z h (orbitImage K X Y f q) := by
  classical
  let r : Y.orbitIndex := orbitImage K X Y f q
  obtain ⟨g, hg⟩ := orbitImage_out_mem K X Y f q
  have hg' : g • (Quotient.out r) = (show ↥Y.toGSet.V from f.hom q.out) := hg
  change Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥Z.toGSet.V)
      (show ↥Z.toGSet.V from (f ≫ h).hom q.out) =
    Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥Z.toGSet.V)
      (show ↥Z.toGSet.V from h.hom (Quotient.out r))
  have hcomp : (show ↥Z.toGSet.V from (f ≫ h).hom q.out) =
      (show ↥Z.toGSet.V from h.hom (show ↥Y.toGSet.V from f.hom q.out)) := rfl
  rw [hcomp]
  have hmem : (show ↥Z.toGSet.V from h.hom (show ↥Y.toGSet.V from f.hom q.out)) ∈
      MulAction.orbit (galoisGroup K)
        (show ↥Z.toGSet.V from h.hom (Quotient.out r)) := by
    refine MulAction.mem_orbit_iff.mpr ⟨g, ?_⟩
    rw [← hg']
    exact (actionHom_smul_apply K Y Z h g (Quotient.out r)).symm
  exact Quotient.sound (MulAction.orbitRel_apply.mpr hmem)
/-! ## The group-theoretic core of twist independence -/
/-- If two absolute Galois automorphisms satisfy the subgroup relation
g2 inverse times g1 in H, then they agree on the fixed field of H pointwise.
This is the subgroup/core statement behind the independence of the orbit twist. -/
lemma galoisGroupToAlgEquiv_apply_eq_of_mul_mem
    (H : OpenSubgroup (Iut.AbsoluteGaloisProfinite K)) (g1 g2 : galoisGroup K)
    (hmem : g2⁻¹ * g1 ∈ (H : Subgroup (galoisGroup K)))
    (y : ↥(openSubgroupFixedField K H)) :
    (galoisGroupToAlgEquiv K g1) (y : SeparableClosure K) =
      (galoisGroupToAlgEquiv K g2) (y : SeparableClosure K) := by
  have hyfix : galoisGroupToAlgEquiv K (g2⁻¹ * g1) (y : SeparableClosure K) =
      (y : SeparableClosure K) := by
    have hy : (y : SeparableClosure K) ∈
        IntermediateField.fixedField (H : Subgroup (galoisGroup K)) := y.2
    rw [IntermediateField.mem_fixedField_iff] at hy
    exact hy (g2⁻¹ * g1) hmem
  have hg1 : galoisGroupToAlgEquiv K g1 =
      galoisGroupToAlgEquiv K g2 * galoisGroupToAlgEquiv K (g2⁻¹ * g1) := by
    conv_lhs => rw [show g1 = g2 * (g2⁻¹ * g1) from by group]
    rw [galoisGroupToAlgEquiv_mul]
  rw [hg1, algEquiv_mul_apply, hyfix]
/-! ## Fixed-field maps attached to an arbitrary twist -/
/-- The membership needed for the fixed-field map attached to an arbitrary
Galois element g satisfying the image condition.  The proof is the same as
for the canonical orbitTwist, with the twist specification hg in place of
orbitTwist_spec. -/
lemma orbitFixedFieldMapOfTwist_mem (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex)
    (g : galoisGroup K)
    (hg : g • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out))
    (y : ↥(Y.orbitFixedField (orbitImage K X Y f q))) :
    (galoisGroupToAlgEquiv K g) (y : SeparableClosure K) ∈ (X.orbitFixedField q) := by
  let r := orbitImage K X Y f q
  have hg' : g • (Quotient.out r) = (show ↥Y.toGSet.V from f.hom q.out) := hg
  change (galoisGroupToAlgEquiv K g) (y : SeparableClosure K) ∈
    IntermediateField.fixedField (X.orbitStabilizer q).toSubgroup
  rw [IntermediateField.mem_fixedField_iff]
  intro h hh
  let h' : galoisGroup K := show galoisGroup K from h
  have hh' : h' ∈ (X.orbitStabilizer q).toSubgroup := show h ∈ (X.orbitStabilizer q).toSubgroup from hh
  have hh'fix : h' • (Quotient.out q) = Quotient.out q := by
    simpa [FiniteContinuousGSet.orbitStabilizer, MulAction.mem_stabilizer_iff] using hh'
  have hconj : g⁻¹ * h' * g ∈ (Y.orbitStabilizer r).toSubgroup := by
    change (g⁻¹ * h' * g) • (Quotient.out r) = Quotient.out r
    calc (g⁻¹ * h' * g) • (Quotient.out r)
        = g⁻¹ • (h' • (g • (Quotient.out r))) := by rw [mul_smul, mul_smul]
      _ = g⁻¹ • (h' • (show ↥Y.toGSet.V from f.hom q.out)) := by rw [hg']
      _ = g⁻¹ • (show ↥Y.toGSet.V from f.hom (h' • (Quotient.out q))) := by
            rw [← actionHom_smul_apply K X Y f h' (Quotient.out q)]
      _ = g⁻¹ • (show ↥Y.toGSet.V from f.hom (Quotient.out q)) := by rw [hh'fix]
      _ = Quotient.out r := by
            rw [← hg']
            exact inv_smul_smul g (Quotient.out r)
  have hyfix : galoisGroupToAlgEquiv K (g⁻¹ * h' * g) (y : SeparableClosure K) =
      (y : SeparableClosure K) := by
    have hy : (y : SeparableClosure K) ∈
        IntermediateField.fixedField (Y.orbitStabilizer r).toSubgroup := y.2
    rw [IntermediateField.mem_fixedField_iff] at hy
    exact hy (g⁻¹ * h' * g) hconj
  have hmul : galoisGroupToAlgEquiv K h' * galoisGroupToAlgEquiv K g =
      galoisGroupToAlgEquiv K g * galoisGroupToAlgEquiv K (g⁻¹ * h' * g) := by
    rw [← galoisGroupToAlgEquiv_mul, ← galoisGroupToAlgEquiv_mul]
    congr 1
    group
  calc galoisGroupToAlgEquiv K h' (galoisGroupToAlgEquiv K g (y : SeparableClosure K))
      = (galoisGroupToAlgEquiv K h' * galoisGroupToAlgEquiv K g) (y : SeparableClosure K) := rfl
    _ = (galoisGroupToAlgEquiv K g * galoisGroupToAlgEquiv K (g⁻¹ * h' * g))
          (y : SeparableClosure K) := by rw [hmul]
    _ = galoisGroupToAlgEquiv K g (galoisGroupToAlgEquiv K (g⁻¹ * h' * g) (y : SeparableClosure K)) := rfl
    _ = galoisGroupToAlgEquiv K g (y : SeparableClosure K) := by rw [hyfix]
/-- The fixed-field map attached to an arbitrary Galois element satisfying the
image condition. -/
noncomputable def orbitFixedFieldMapOfTwist (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) (g : galoisGroup K)
    (hg : g • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out)) :
    ↥(Y.orbitFixedField (orbitImage K X Y f q)) →ₐ[K] ↥(X.orbitFixedField q) where
  toFun y := ⟨(galoisGroupToAlgEquiv K g) (y : SeparableClosure K),
    orbitFixedFieldMapOfTwist_mem K X Y f q g hg y⟩
  map_one' := by ext; simp
  map_mul' x y := by ext; simp
  map_zero' := by ext; simp
  map_add' x y := by ext; simp
  commutes' a := by ext; simp
/-- Value of the twist fixed-field map on the separable closure. -/
lemma orbitFixedFieldMapOfTwist_coe_apply (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) (g : galoisGroup K)
    (hg : g • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out))
    (y : ↥(Y.orbitFixedField (orbitImage K X Y f q))) :
    ((orbitFixedFieldMapOfTwist K X Y f q g hg y : ↥(X.orbitFixedField q)) :
        SeparableClosure K) =
      galoisGroupToAlgEquiv K g (y : SeparableClosure K) := rfl
/-- Twist independence on fixed-field points: two twists satisfying the same
image condition act identically on the fixed field of the target orbit. -/
lemma orbitFixedFieldMapOfTwist_apply_eq (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) {g1 g2 : galoisGroup K}
    (hg1 : g1 • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out))
    (hg2 : g2 • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out))
    (y : ↥(Y.orbitFixedField (orbitImage K X Y f q))) :
    (galoisGroupToAlgEquiv K g1) (y : SeparableClosure K) =
      (galoisGroupToAlgEquiv K g2) (y : SeparableClosure K) := by
  let r := orbitImage K X Y f q
  have hg1' : g1 • (Quotient.out r) = (show ↥Y.toGSet.V from f.hom q.out) := hg1
  have hg2' : g2 • (Quotient.out r) = (show ↥Y.toGSet.V from f.hom q.out) := hg2
  have hmem : g2⁻¹ * g1 ∈ (Y.orbitStabilizer r).toSubgroup := by
    change g2⁻¹ * g1 ∈ MulAction.stabilizer (galoisGroup K) (Quotient.out r)
    rw [MulAction.mem_stabilizer_iff]
    calc (g2⁻¹ * g1) • (Quotient.out r)
        = g2⁻¹ • (g1 • (Quotient.out r)) := by rw [mul_smul]
      _ = g2⁻¹ • (show ↥Y.toGSet.V from f.hom q.out) := by rw [hg1']
      _ = g2⁻¹ • (g2 • (Quotient.out r)) := by rw [← hg2']
      _ = Quotient.out r := by rw [inv_smul_smul]
  exact galoisGroupToAlgEquiv_apply_eq_of_mul_mem K (Y.orbitStabilizer r) g1 g2 hmem y
/-- Twist independence as an equality of algebra homomorphisms. -/
theorem orbitFixedFieldMapOfTwist_eq (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) {g1 g2 : galoisGroup K}
    (hg1 : g1 • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out))
    (hg2 : g2 • (Quotient.out (orbitImage K X Y f q)) =
      (show ↥Y.toGSet.V from f.hom q.out)) :
    orbitFixedFieldMapOfTwist K X Y f q g1 hg1 =
      orbitFixedFieldMapOfTwist K X Y f q g2 hg2 := by
  apply AlgHom.ext
  intro y
  apply Subtype.ext
  exact orbitFixedFieldMapOfTwist_apply_eq K X Y f q hg1 hg2 y
/-- The canonical orbit twist map is the twist map attached to orbitTwist. -/
lemma orbitFixedFieldMap_eq_ofTwist (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) :
    orbitFixedFieldMap K X Y f q =
      orbitFixedFieldMapOfTwist K X Y f q (orbitTwist K X Y f q)
        (orbitTwist_spec K X Y f q) := by
  apply AlgHom.ext
  intro y
  apply Subtype.ext
  rfl
/-- Value of the canonical orbit fixed-field map on the separable closure. -/
lemma orbitFixedFieldMap_coe_apply (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex)
    (y : ↥(Y.orbitFixedField (orbitImage K X Y f q))) :
    ((orbitFixedFieldMap K X Y f q y : ↥(X.orbitFixedField q)) : SeparableClosure K) =
      galoisGroupToAlgEquiv K (orbitTwist K X Y f q) (y : SeparableClosure K) := rfl
/-- Compatibility of the orbit fixed-field maps with composition of morphisms:
after transporting the domain along the image-orbit relation, the composite
fixed-field map is the composition of the two fixed-field maps. -/
theorem orbitFixedFieldMap_comp (X Y Z : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (h : Y.toGSet ⟶ Z.toGSet) (q : X.orbitIndex) :
    AlgHom.castDomain (A := fun r => ↥(Z.orbitFixedField r)) (F := ↥(X.orbitFixedField q))
        (orbitImage_comp K X Y Z f h q)
        (orbitFixedFieldMap K X Z (f ≫ h) q) =
      (orbitFixedFieldMap K X Y f q).comp
        (orbitFixedFieldMap K Y Z h (orbitImage K X Y f q)) := by
  apply AlgHom.ext
  intro y
  apply Subtype.ext
  rw [AlgHom.castDomain_apply (A := fun r => ↥(Z.orbitFixedField r)) (F := ↥(X.orbitFixedField q))]
  rw [AlgHom.comp_apply]
  rw [orbitFixedFieldMap_coe_apply]
  rw [orbitFixedFieldMap_coe_apply]
  rw [orbitFixedFieldMap_coe_apply]
  have hcast :
      ((cast (congrArg (fun r => ↥(Z.orbitFixedField r))
          (orbitImage_comp K X Y Z f h q).symm) y :
        ↥(Z.orbitFixedField (orbitImage K X Z (f ≫ h) q))) : SeparableClosure K) =
      (y : SeparableClosure K) :=
    orbitFixedField_cast_coe (K := K) (orbitImage_comp K X Y Z f h q).symm y
  rw [hcast]
  set gxz : galoisGroup K := orbitTwist K X Z (f ≫ h) q with hgxz
  set gxy : galoisGroup K := orbitTwist K X Y f q with hgxy
  set gyz : galoisGroup K := orbitTwist K Y Z h (orbitImage K X Y f q) with hgyz
  let r : Y.orbitIndex := orbitImage K X Y f q
  let r' : Z.orbitIndex := orbitImage K Y Z h r
  let r'' : Z.orbitIndex := orbitImage K X Z (f ≫ h) q
  have hA : r'' = r' := orbitImage_comp K X Y Z f h q
  have hspec_comp : gxz • (Quotient.out r') =
      (show ↥Z.toGSet.V from (f ≫ h).hom q.out) := by
    rw [← hA]
    exact orbitTwist_spec K X Z (f ≫ h) q
  have hspec_prod : (gxy * gyz) • (Quotient.out r') =
      (show ↥Z.toGSet.V from (f ≫ h).hom q.out) := by
    calc (gxy * gyz) • (Quotient.out r')
        = gxy • (gyz • (Quotient.out r')) := by rw [mul_smul]
      _ = gxy • (show ↥Z.toGSet.V from h.hom (Quotient.out r)) := by
            congr 1
            rw [hgyz]
            exact orbitTwist_spec K Y Z h r
      _ = (show ↥Z.toGSet.V from h.hom (gxy • (Quotient.out r))) := by
            rw [hgxy]
            exact (actionHom_smul_apply K Y Z h (orbitTwist K X Y f q) (Quotient.out r)).symm
      _ = (show ↥Z.toGSet.V from h.hom (show ↥Y.toGSet.V from f.hom q.out)) := by
            rw [orbitTwist_spec K X Y f q]
      _ = (show ↥Z.toGSet.V from (f ≫ h).hom q.out) := rfl
  have hmem : (gxy * gyz)⁻¹ * gxz ∈ (Z.orbitStabilizer r').toSubgroup := by
    change (gxy * gyz)⁻¹ * gxz ∈ MulAction.stabilizer (galoisGroup K) (Quotient.out r')
    rw [MulAction.mem_stabilizer_iff]
    calc ((gxy * gyz)⁻¹ * gxz) • (Quotient.out r')
        = (gxy * gyz)⁻¹ • (gxz • (Quotient.out r')) := by rw [mul_smul]
      _ = (gxy * gyz)⁻¹ • (show ↥Z.toGSet.V from (f ≫ h).hom q.out) := by rw [hspec_comp]
      _ = (gxy * gyz)⁻¹ • ((gxy * gyz) • (Quotient.out r')) := by rw [← hspec_prod]
      _ = Quotient.out r' := by rw [inv_smul_smul]
  have htwist := galoisGroupToAlgEquiv_apply_eq_of_mul_mem K (Z.orbitStabilizer r')
    gxz (gxy * gyz) hmem y
  rw [htwist, galoisGroupToAlgEquiv_mul, algEquiv_mul_apply]
/-! ## The Pi-level product map and functoriality -/
/-- Casting a dependent function value along an equality of indices gives the
value at the second index. -/
lemma cast_pi_apply {ι : Type u} {A : ι → Type u} {i j : ι} (h : i = j)
    (x : Π i, A i) : cast (congrArg A h) (x i) = x j := by
  cases h
  rfl
/-- The Pi-level form of the object map: the product of the orbit fixed-field
maps, before transport through the identity algebra equivalence of the orbit
product. -/
noncomputable def orbitFixedFieldProductMap (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) :
    (Π r : Y.orbitIndex, ↥(Y.orbitFixedField r)) →ₐ[K]
      (Π q : X.orbitIndex, ↥(X.orbitFixedField q)) := by
  classical
  haveI : ∀ r : Y.orbitIndex, FiniteDimensional K ↥(Y.orbitFixedField r) :=
    fun r => Y.orbitFixedField_finiteDimensional r
  exact AlgHom.pi (fun q =>
    (algHomPiToSigmaEquiv K (fun r => ↥(Y.orbitFixedField r))
      (F := ↥(X.orbitFixedField q))).symm
      ⟨orbitImage K X Y f q, orbitFixedFieldMap K X Y f q⟩)
/-- The object map is the Pi-level product map conjugated by the identity
algebra equivalences of the orbit products. -/
lemma gSetToFiniteEtaleObjectMap_eq_productMap (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) :
    gSetToFiniteEtaleObjectMap K X Y f =
      (X.gSetToFiniteEtaleObjectAlgEquiv).symm.toAlgHom.comp
        ((orbitFixedFieldProductMap K X Y f).comp
          (Y.gSetToFiniteEtaleObjectAlgEquiv).toAlgHom) := by
  rfl
/-- Component formula for the Pi-level product map. -/
lemma orbitFixedFieldProductMap_apply (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet)
    (x : Π r : Y.orbitIndex, ↥(Y.orbitFixedField r)) (q : X.orbitIndex) :
    orbitFixedFieldProductMap K X Y f x q =
      orbitFixedFieldMap K X Y f q (x (orbitImage K X Y f q)) := by
  classical
  haveI : ∀ r : Y.orbitIndex, FiniteDimensional K ↥(Y.orbitFixedField r) :=
    fun r => Y.orbitFixedField_finiteDimensional r
  simp only [orbitFixedFieldProductMap, AlgHom.pi_apply, algHomPiToSigmaEquiv_symm_apply,
    algHomPiInverse, AlgHom.comp_apply, Pi.evalAlgHom_apply]
/-- Pointwise functoriality of the object map on morphisms. -/
lemma gSetToFiniteEtaleObjectMap_comp_apply (X Y Z : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (h : Y.toGSet ⟶ Z.toGSet)
    (x : ↥(Z.gSetToFiniteEtaleObject)) :
    gSetToFiniteEtaleObjectMap K X Z (f ≫ h) x =
      gSetToFiniteEtaleObjectMap K X Y f
        (gSetToFiniteEtaleObjectMap K Y Z h x) := by
  apply (X.gSetToFiniteEtaleObjectAlgEquiv).injective
  change orbitFixedFieldProductMap K X Z (f ≫ h) x =
    orbitFixedFieldProductMap K X Y f (orbitFixedFieldProductMap K Y Z h x)
  funext q
  simp only [orbitFixedFieldProductMap_apply]
  have hcast : cast (congrArg (fun r => ↥(Z.orbitFixedField r))
      (orbitImage_comp K X Y Z f h q).symm)
      (x (orbitImage K Y Z h (orbitImage K X Y f q))) =
      x (orbitImage K X Z (f ≫ h) q) :=
    cast_pi_apply (A := fun r => ↥(Z.orbitFixedField r))
      (orbitImage_comp K X Y Z f h q).symm x
  have hLHS :
      (AlgHom.castDomain (A := fun r => ↥(Z.orbitFixedField r)) (F := ↥(X.orbitFixedField q))
        (orbitImage_comp K X Y Z f h q)
        (orbitFixedFieldMap K X Z (f ≫ h) q))
        (x (orbitImage K Y Z h (orbitImage K X Y f q))) =
      orbitFixedFieldMap K X Z (f ≫ h) q (x (orbitImage K X Z (f ≫ h) q)) := by
    rw [AlgHom.castDomain_apply (A := fun r => ↥(Z.orbitFixedField r)) (F := ↥(X.orbitFixedField q))]
    rw [hcast]
  rw [← hLHS]
  rw [orbitFixedFieldMap_comp]
  rw [AlgHom.comp_apply]
/-- Functoriality (covariance) of the reverse object map: the object map sends
a composite of Galois-set morphisms to the composite of the reverse algebra
maps, in the opposite order. -/
theorem gSetToFiniteEtaleObjectMap_comp (X Y Z : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (h : Y.toGSet ⟶ Z.toGSet) :
    gSetToFiniteEtaleObjectMap K X Z (f ≫ h) =
      (gSetToFiniteEtaleObjectMap K X Y f).comp
        (gSetToFiniteEtaleObjectMap K Y Z h) := by
  apply AlgHom.ext
  intro x
  exact gSetToFiniteEtaleObjectMap_comp_apply K X Y Z f h x

lemma forget_obj (X : FiniteContinuousGaloisSetCategory K) :
    (forgetFiniteContinuousGaloisSet (K := K)).obj X = X.obj := rfl

noncomputable def forgetHom {X Y : FiniteContinuousGaloisSetCategory K} (f : X ⟶ Y) :
    (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X).toGSet ⟶
      (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y).toGSet :=
  by simpa [FiniteContinuousGSet.ofContinuousGaloisSet_toGSet, forget_obj] using
    ((forgetFiniteContinuousGaloisSet (K := K)).map f)

@[simp] lemma forgetHom_id (X : FiniteContinuousGaloisSetCategory K) :
    forgetHom (K := K) (𝟙 X) =
      𝟙 (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X).toGSet := by
  unfold forgetHom
  simp [FiniteContinuousGSet.ofContinuousGaloisSet_toGSet, forget_obj]

lemma forgetHom_comp {X Y Z : FiniteContinuousGaloisSetCategory K} (f : X ⟶ Y) (h : Y ⟶ Z) :
    forgetHom (K := K) (f ≫ h) = forgetHom (K := K) f ≫ forgetHom (K := K) h := by
  unfold forgetHom
  simp [FiniteContinuousGSet.ofContinuousGaloisSet_toGSet, forget_obj, Functor.map_comp]

noncomputable def continuousGaloisSetToFiniteEtaleFunctor :
    FiniteContinuousGaloisSetCategory K ⥤ (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ where
  obj Y := Opposite.op (FiniteContinuousGSet.gSetToFiniteEtaleObject
    (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y))
  map {X Y} f :=
    (CommAlgCat.FiniteEtale.ofHom
      (gSetToFiniteEtaleObjectMap K
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X)
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y)
        (forgetHom (K := K) f))).op
  map_id X := by
    apply Quiver.Hom.unop_inj
    rw [forgetHom_id, gSetToFiniteEtaleObjectMap_id]
    rfl
  map_comp {X Y Z} f h := by
    apply Quiver.Hom.unop_inj
    rw [forgetHom_comp, gSetToFiniteEtaleObjectMap_comp]
    rfl


noncomputable def fiberActionIsoFull (Y : FiniteContinuousGaloisSetCategory K) :
    (finiteEtaleToContinuousFunctor K).obj
      ((continuousGaloisSetToFiniteEtaleFunctor K).obj Y) ≅ Y :=
  ObjectProperty.isoMk _ (FiniteContinuousGSet.fiberActionIso K
    (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y))

noncomputable def continuousGaloisSetUnit (Y : FiniteContinuousGaloisSetCategory K) :
    Y ≅ (finiteEtaleToContinuousFunctor K).obj
      ((continuousGaloisSetToFiniteEtaleFunctor K).obj Y) :=
  (fiberActionIsoFull (K := K) Y).symm

noncomputable def essentialImageCounit (Y : FiniteContinuousGaloisSetCategory K) :
    (continuousGaloisSetToFiniteEtaleFunctor K).obj Y ≅
      (continuousGaloisSetToFiniteEtaleFunctor K).obj
        ((finiteEtaleToContinuousFunctor K).obj
          ((continuousGaloisSetToFiniteEtaleFunctor K).obj Y)) :=
  ((continuousGaloisSetToFiniteEtaleFunctor K).mapIso (fiberActionIsoFull (K := K) Y)).symm


noncomputable def finiteEtaleContinuousEquivalence
    (unitIso : Functor.id ((CommAlgCat.FiniteEtale.{u} K)ᵒᵖ) ≅
      (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K))
    (counitIso : (continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K) ≅
      Functor.id (FiniteContinuousGaloisSetCategory K))
    (triangle : ∀ X : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ,
      (finiteEtaleToContinuousFunctor K).map (unitIso.hom.app X) ≫
        counitIso.hom.app ((finiteEtaleToContinuousFunctor K).obj X) =
      𝟙 ((finiteEtaleToContinuousFunctor K).obj X)) :
    (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ ≌ FiniteContinuousGaloisSetCategory K where
  functor := finiteEtaleToContinuousFunctor K
  inverse := continuousGaloisSetToFiniteEtaleFunctor K
  unitIso := unitIso
  counitIso := counitIso
  functor_unitIso_comp := triangle


noncomputable def counitOfComponents
    (naturality : ∀ {X Y : FiniteContinuousGaloisSetCategory K} (f : X ⟶ Y),
      (fiberActionIsoFull (K := K) X).hom ≫ f =
        ((continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K).map f) ≫
          (fiberActionIsoFull (K := K) Y).hom) :
    (continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K) ≅
      𝟭 (FiniteContinuousGaloisSetCategory K) :=
  NatIso.ofComponents (fun X => fiberActionIsoFull (K := K) X)
    (fun f => (naturality f).symm)

noncomputable def unitOfComponents
    (component : ∀ A : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ,
      A ≅ (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).obj A)
    (naturality : ∀ {A B : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ} (f : A ⟶ B),
      (component A).hom ≫ (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).map f =
        f ≫ (component B).hom) :
    (𝟭 ((CommAlgCat.FiniteEtale.{u} K)ᵒᵖ)) ≅
      (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K) :=
  NatIso.ofComponents (fun A => component A) (fun f => (naturality f).symm)


lemma finiteEtaleToContinuousFunctor_obj_eq (A : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ) :
    ((finiteEtaleToContinuousFunctor K).obj A).obj = finiteEtaleObjectToGSet K A.unop := rfl

theorem finiteEtaleToContinuousFunctor_fiber_compatibility
    (A : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ) :
    Nonempty ((((finiteEtaleToContinuousFunctor K).obj A).obj) ≅ finiteEtaleObjectToGSet K A.unop) :=
  ⟨Iso.refl _⟩


noncomputable def finiteEtaleContinuousEquivalenceOfComponents
    (unitComponent : ∀ A : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ,
      A ≅ (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).obj A)
    (unitNat : ∀ {A B : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ} (f : A ⟶ B),
      (unitComponent A).hom ≫ (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).map f =
        f ≫ (unitComponent B).hom)
    (counitNat : ∀ {X Y : FiniteContinuousGaloisSetCategory K} (f : X ⟶ Y),
      (fiberActionIsoFull (K := K) X).hom ≫ f =
        ((continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K).map f) ≫
          (fiberActionIsoFull (K := K) Y).hom)
    (triangle : ∀ X : (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ,
      (finiteEtaleToContinuousFunctor K).map
          ((unitOfComponents (K := K) unitComponent unitNat).hom.app X) ≫
        (counitOfComponents (K := K) counitNat).hom.app
          ((finiteEtaleToContinuousFunctor K).obj X) =
      𝟙 ((finiteEtaleToContinuousFunctor K).obj X)) :
    (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ ≌ FiniteContinuousGaloisSetCategory K :=
  finiteEtaleContinuousEquivalence (K := K)
    (unitOfComponents (K := K) unitComponent unitNat)
    (counitOfComponents (K := K) counitNat) triangle


end Example36
end LeanFormal.IUT.IUTII.Frobenioid

noncomputable section
namespace LeanFormal.IUT.IUTII.Frobenioid.Example36
namespace AlgebraRoundtripGalois

open CategoryTheory CommAlgCat
open GaloisCorrespondence EtaleCoverFoundations GSetToEtaleAlgebra

set_option maxHeartbeats 1000000

universe u
variable {K : Type u} [Field K]

theorem fixedField_fixingSubgroup_of_intermediateField
    (L : IntermediateField K (SeparableClosure K)) :
    IntermediateField.fixedField L.fixingSubgroup = L :=
  InfiniteGalois.fixedField_fixingSubgroup L

theorem exists_algHom_separableClosure_extension_of_finiteDimensional
    (L : IntermediateField K (SeparableClosure K)) [FiniteDimensional K L]
    (f : L →ₐ[K] SeparableClosure K) :
    ∃ ψ : SeparableClosure K →ₐ[K] SeparableClosure K,
      AlgHom.restrictDomain L ψ = f := by
  haveI : Algebra.IsAlgebraic K (SeparableClosure K) :=
    separableClosure.isAlgebraic K (AlgebraicClosure K)
  haveI : Algebra.IsAlgebraic L (SeparableClosure K) :=
    Algebra.IsAlgebraic.tower_top (K := K) L
  haveI : Algebra.IsSeparable K (SeparableClosure K) :=
    separableClosure.isSeparable K (AlgebraicClosure K)
  haveI : Algebra.IsSeparable L (SeparableClosure K) :=
    Algebra.isSeparable_tower_top_of_isSeparable (F := K) (L := L) (E := SeparableClosure K)
  refine IntermediateField.exists_algHom_of_splits' (F := K) (E := SeparableClosure K)
    (K := SeparableClosure K) (L := L) f ?_
  intro s
  refine ⟨(Algebra.IsAlgebraic.isIntegral (K := L)).1 s, ?_⟩
  exact IsSepClosed.splits_codomain (f := f.toRingHom) (minpoly L s)
    (Algebra.IsSeparable.isSeparable L s)

/-- Transitivity of the action of the absolute Galois group on the set of
embeddings of a finite separable field extension into the separable closure. -/
theorem exists_galoisGroup_comp_eq
    (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] (f g : L →ₐ[K] SeparableClosure K) :
    ∃ σ : galoisGroup K, (galoisGroupToAlgEquiv K σ).toAlgHom.comp f = g := by
  classical
  haveI hfd : FiniteDimensional K f.fieldRange := by
    exact Module.Finite.of_surjective
      (f.equivFieldRange : L ≃ₐ[K] ↥f.fieldRange).toLinearMap
      (f.equivFieldRange.surjective)
  let h : ↥f.fieldRange →ₐ[K] SeparableClosure K :=
    g.comp (f.equivFieldRange).symm.toAlgHom
  obtain ⟨ψ, hψ⟩ :=
    exists_algHom_separableClosure_extension_of_finiteDimensional f.fieldRange h
  let σ : galoisGroup K :=
    galoisGroupOfAlgEquiv K
      (AlgEquiv.ofBijective ψ (separableClosureEndomorphism_bijective K ψ))
  refine ⟨σ, ?_⟩
  ext x
  have hψx : ψ (f x) = g x := by
    have h1 := congrArg (fun k : ↥f.fieldRange →ₐ[K] SeparableClosure K =>
      k ⟨f x, AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩⟩) hψ
    have h2 : (f.equivFieldRange).symm ⟨f x, AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩⟩ = x := by
      apply (f.equivFieldRange).injective
      rw [AlgEquiv.apply_symm_apply]
      rfl
    simpa [h, h2, AlgHom.restrictDomain, AlgHom.comp_apply] using h1
  have hσ : galoisGroupToAlgEquiv K σ =
      AlgEquiv.ofBijective ψ (separableClosureEndomorphism_bijective K ψ) := rfl
  rw [hσ]
  exact congrArg Subtype.val hψx


/-! ## 2. Product decomposition data and the fiber-to-Sigma comparison -/

section ProductDecomposition

variable {A : CommAlgCat.FiniteEtale.{u} K}
variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable (B : ι → Type u) [∀ i, Field (B i)] [∀ i, Algebra K (B i)]
variable [∀ i, FiniteDimensional K (B i)]
variable (e : A.obj ≃ₐ[K] (Π i, B i))

noncomputable def fiberToSigma
    (x : A.obj →ₐ[K] SeparableClosure K) : Σ i, B i →ₐ[K] SeparableClosure K :=
  algHomPiToSigmaEquiv K B (F := SeparableClosure K) (x.comp e.symm.toAlgHom)

noncomputable def sigmaToFiber
    (s : Σ i, B i →ₐ[K] SeparableClosure K) : A.obj →ₐ[K] SeparableClosure K :=
  ((algHomPiToSigmaEquiv K B (F := SeparableClosure K)).symm s).comp e.toAlgHom

theorem sigmaToFiber_apply (s : Σ i, B i →ₐ[K] SeparableClosure K) :
    sigmaToFiber B e s =
      s.2.comp ((Pi.evalAlgHom K B s.1).comp e.toAlgHom) := by
  rw [sigmaToFiber, algHomPiToSigmaEquiv_symm_apply]
  rfl

theorem fiberToSigma_sigmaToFiber (s : Σ i, B i →ₐ[K] SeparableClosure K) :
    fiberToSigma B e (sigmaToFiber B e s) = s := by
  have hcomp : (((algHomPiToSigmaEquiv K B (F := SeparableClosure K)).symm s).comp
      e.toAlgHom).comp e.symm.toAlgHom =
      (algHomPiToSigmaEquiv K B (F := SeparableClosure K)).symm s := by
    rw [AlgHom.comp_assoc]
    simp
  simp [fiberToSigma, sigmaToFiber, hcomp]

theorem sigmaToFiber_fiberToSigma (x : A.obj →ₐ[K] SeparableClosure K) :
    sigmaToFiber B e (fiberToSigma B e x) = x := by
  have hcomp : ((algHomPiToSigmaEquiv K B (F := SeparableClosure K)).symm
      ((algHomPiToSigmaEquiv K B (F := SeparableClosure K))
        (x.comp e.symm.toAlgHom))).comp e.toAlgHom = x := by
    rw [Equiv.symm_apply_apply, AlgHom.comp_assoc]
    simp
  simpa [fiberToSigma, sigmaToFiber] using hcomp

theorem fiberToSigma_injective : Function.Injective (fiberToSigma B e) := by
  intro x y h
  have h' := congrArg (sigmaToFiber B e) h
  simpa [sigmaToFiber_fiberToSigma] using h'

theorem fiberToSigma_surjective : Function.Surjective (fiberToSigma B e) := by
  intro s
  exact ⟨sigmaToFiber B e s, fiberToSigma_sigmaToFiber B e s⟩

noncomputable def fiberToSigmaEquiv :
    (A.obj →ₐ[K] SeparableClosure K) ≃
      (Σ i, B i →ₐ[K] SeparableClosure K) :=
  Equiv.ofBijective (fiberToSigma B e)
    ⟨fiberToSigma_injective B e, fiberToSigma_surjective B e⟩

noncomputable def sigmaSmul (σ : galoisGroup K)
    (s : Σ i, B i →ₐ[K] SeparableClosure K) :
    Σ i, B i →ₐ[K] SeparableClosure K :=
  ⟨s.1, (galoisGroupToAlgEquiv K σ).toAlgHom.comp s.2⟩

theorem sigmaToFiber_smul (σ : galoisGroup K)
    (s : Σ i, B i →ₐ[K] SeparableClosure K) :
    sigmaToFiber B e (sigmaSmul B σ s) =
      (galoisGroupToAlgEquiv K σ).toAlgHom.comp (sigmaToFiber B e s) := by
  rw [sigmaToFiber_apply, sigmaToFiber_apply]
  rfl

noncomputable def fiberPointToSigma
    (x : ↥(finiteEtaleFiberSet (K := K) A)) :
    Σ i, B i →ₐ[K] SeparableClosure K :=
  fiberToSigma B e (show A.obj →ₐ[K] SeparableClosure K from x)

noncomputable def sigmaToFiberPoint
    (s : Σ i, B i →ₐ[K] SeparableClosure K) :
    ↥(finiteEtaleFiberSet (K := K) A) :=
  sigmaToFiber B e s

@[simp] theorem sigmaToFiberPoint_coe
    (s : Σ i, B i →ₐ[K] SeparableClosure K) :
    (show A.obj →ₐ[K] SeparableClosure K from sigmaToFiberPoint B e s) =
      sigmaToFiber B e s := rfl

theorem fiberPointToSigma_sigmaToFiberPoint
    (s : Σ i, B i →ₐ[K] SeparableClosure K) :
    fiberPointToSigma B e (sigmaToFiberPoint B e s) = s :=
  fiberToSigma_sigmaToFiber B e s

theorem sigmaToFiberPoint_fiberPointToSigma
    (x : ↥(finiteEtaleFiberSet (K := K) A)) :
    sigmaToFiberPoint B e (fiberPointToSigma B e x) = x :=
  sigmaToFiber_fiberToSigma B e (show A.obj →ₐ[K] SeparableClosure K from x)

noncomputable def fiberPointToSigmaEquiv :
    ↥(finiteEtaleFiberSet (K := K) A) ≃
      (Σ i, B i →ₐ[K] SeparableClosure K) :=
  Equiv.ofBijective (fiberPointToSigma B e)
    ⟨fun x y h => by
      have h' : fiberPointToSigma B e x = fiberPointToSigma B e y := h
      have h2 := congrArg (sigmaToFiber B e) h'
      simp only [fiberPointToSigma] at h2
      rw [sigmaToFiber_fiberToSigma, sigmaToFiber_fiberToSigma] at h2
      exact h2,
     fun s => ⟨sigmaToFiberPoint B e s, fiberPointToSigma_sigmaToFiberPoint B e s⟩⟩

end ProductDecomposition


/-! ## 3. Stabilizers of fiber points and their fixed fields -/

section FiberStabilizers

variable {A : CommAlgCat.FiniteEtale.{u} K}
variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable (B : ι → Type u) [∀ i, Field (B i)] [∀ i, Algebra K (B i)]
variable [∀ i, FiniteDimensional K (B i)]
variable (e : A.obj ≃ₐ[K] (Π i, B i))

/-- A Galois automorphism fixes a field embedding iff it lies in the fixing
subgroup of the range of the embedding. -/
theorem algHom_comp_eq_self_iff_mem_fixingSubgroup
    (L : Type u) [Field L] [Algebra K L] (τ : L →ₐ[K] SeparableClosure K)
    (σ : galoisGroup K) :
    (galoisGroupToAlgEquiv K σ).toAlgHom.comp τ = τ ↔
      (galoisGroupToAlgEquiv K σ) ∈ τ.fieldRange.fixingSubgroup := by
  constructor
  · intro h
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro y hy
    obtain ⟨x, rfl⟩ := AlgHom.mem_fieldRange.mp hy
    have h' := congrArg (fun k : L →ₐ[K] SeparableClosure K => k x) h
    simpa using h'
  · intro h
    ext x
    have hx := (IntermediateField.mem_fixingSubgroup_iff τ.fieldRange
      (galoisGroupToAlgEquiv K σ)).mp h (τ x) (AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩)
    exact congrArg Subtype.val hx

/-- The stabilizer of a point of the form sigmaToFiberPoint of a factor map is
the fixing subgroup of the range field of that factor map. -/
@[simp] theorem fiber_smul_coe (σ : galoisGroup K)
    (x : ↥(finiteEtaleFiberSet (K := K) A)) :
    (show A.obj →ₐ[K] SeparableClosure K from (σ • x)) =
      (galoisGroupToAlgEquiv K σ).toAlgHom.comp
        (show A.obj →ₐ[K] SeparableClosure K from x) := rfl

theorem smul_sigmaToFiberPoint (σ : galoisGroup K) (i : ι)
    (τ : B i →ₐ[K] SeparableClosure K) :
    σ • sigmaToFiberPoint B e ⟨i, τ⟩ =
      sigmaToFiberPoint B e (sigmaSmul B σ ⟨i, τ⟩) := by
  have h : (show A.obj →ₐ[K] SeparableClosure K from
      (σ • sigmaToFiberPoint B e ⟨i, τ⟩)) =
      (show A.obj →ₐ[K] SeparableClosure K from
        sigmaToFiberPoint B e (sigmaSmul B σ ⟨i, τ⟩)) := by
    rw [fiber_smul_coe]
    rw [sigmaToFiberPoint_coe]
    rw [sigmaToFiberPoint_coe]
    exact (sigmaToFiber_smul B e σ ⟨i, τ⟩).symm
  exact h

theorem stabilizer_sigmaToFiberPoint (i : ι)
    (τ : B i →ₐ[K] SeparableClosure K) :
    MulAction.stabilizer (galoisGroup K) (sigmaToFiberPoint B e ⟨i, τ⟩) =
      τ.fieldRange.fixingSubgroup := by
  have hsurj : Function.Surjective (fun a : A.obj => (e a) i) :=
    (Function.surjective_eval i).comp e.surjective
  have hx : ∀ a : A.obj,
      (show A.obj →ₐ[K] SeparableClosure K from sigmaToFiberPoint B e ⟨i, τ⟩) a =
        τ ((e a) i) := by
    intro a
    rw [sigmaToFiberPoint_coe, sigmaToFiber_apply]
    rfl
  apply Subgroup.ext
  intro σ
  rw [MulAction.mem_stabilizer_iff]
  constructor
  · intro h
    refine (IntermediateField.mem_fixingSubgroup_iff τ.fieldRange
      (galoisGroupToAlgEquiv K σ)).mpr ?_
    intro y hy
    obtain ⟨a, rfl⟩ := AlgHom.mem_fieldRange.mp hy
    obtain ⟨b, hb⟩ := hsurj a
    have h2 : (galoisGroupToAlgEquiv K σ)
        ((show A.obj →ₐ[K] SeparableClosure K from
          sigmaToFiberPoint B e ⟨i, τ⟩) b) =
        (show A.obj →ₐ[K] SeparableClosure K from
          sigmaToFiberPoint B e ⟨i, τ⟩) b :=
      congrArg (fun k : A.obj →ₐ[K] SeparableClosure K => k b) h
    rw [hx b] at h2
    rw [show e b i = a from hb] at h2
    exact h2
  · intro h
    conv_lhs => rw [← sigmaToFiberPoint_fiberPointToSigma B e
      (sigmaToFiberPoint B e ⟨i, τ⟩)]
    rw [smul_sigmaToFiberPoint]
    rw [fiberPointToSigma_sigmaToFiberPoint]
    congr 1
    refine Sigma.ext_iff.mpr ⟨rfl, heq_of_eq ?_⟩
    exact (algHom_comp_eq_self_iff_mem_fixingSubgroup (B i) τ σ).mpr h

/-- The stabilizer of an arbitrary fiber point is the fixing subgroup of the
range field of its second Sigma coordinate. -/
theorem stabilizer_fiberPoint_eq_fixingSubgroup
    (x : ↥(finiteEtaleFiberSet (K := K) A)) :
    MulAction.stabilizer (galoisGroup K) x =
      (fiberPointToSigma B e x).2.fieldRange.fixingSubgroup := by
  conv_lhs => rw [← sigmaToFiberPoint_fiberPointToSigma B e x]
  exact stabilizer_sigmaToFiberPoint B e (fiberPointToSigma B e x).1
    (fiberPointToSigma B e x).2

/-- The open subgroup of the absolute Galois group attached to an orbit of the
fiber of a finite etale algebra. -/
noncomputable def fiberOrbitStabilizer
    (q : MulAction.orbitRel.Quotient (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A)) : OpenSubgroup (galoisGroup K) where
  toSubgroup := MulAction.stabilizer (galoisGroup K) (Quotient.out q)
  isOpen' := by
    haveI hfd : FiniteDimensional K
        (fiberPointToSigma B e (Quotient.out q)).2.fieldRange :=
      Module.Finite.of_surjective
        ((fiberPointToSigma B e (Quotient.out q)).2.equivFieldRange).toLinearMap
        ((fiberPointToSigma B e (Quotient.out q)).2.equivFieldRange).surjective
    rw [stabilizer_fiberPoint_eq_fixingSubgroup B e (Quotient.out q)]
    exact IntermediateField.fixingSubgroup_isOpen _

/-- The fixed field of the orbit stabilizer is the range field of the second
Sigma coordinate of the orbit representative. -/
theorem openSubgroupFixedField_fiberOrbitStabilizer_eq
    (q : MulAction.orbitRel.Quotient (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A)) :
    openSubgroupFixedField K (fiberOrbitStabilizer B e q) =
      (fiberPointToSigma B e (Quotient.out q)).2.fieldRange := by
  change IntermediateField.fixedField
      (MulAction.stabilizer (galoisGroup K) (Quotient.out q)) = _
  rw [stabilizer_fiberPoint_eq_fixingSubgroup B e (Quotient.out q)]
  exact fixedField_fixingSubgroup_of_intermediateField _

end FiberStabilizers


/-! ## 4. The orbit index of a fiber point and the bijection with the product index -/

section OrbitIndex

variable {A : CommAlgCat.FiniteEtale.{u} K}
variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable (B : ι → Type u) [∀ i, Field (B i)] [∀ i, Algebra K (B i)]
variable [∀ i, FiniteDimensional K (B i)] [∀ i, Algebra.IsSeparable K (B i)]
variable (e : A.obj ≃ₐ[K] (Π i, B i))

/-- A chosen embedding of a factor into the separable closure. -/
noncomputable def chosenEmbedding (i : ι) : B i →ₐ[K] SeparableClosure K :=
  IsSepClosed.lift

/-- The fiber point attached to a factor, given by the chosen embedding of the
factor followed by the product projection. -/
noncomputable def chosenFiberPoint (i : ι) :
    ↥(finiteEtaleFiberSet (K := K) A) :=
  sigmaToFiberPoint B e ⟨i, chosenEmbedding B i⟩

/-- The product index attached to an orbit of the fiber. -/
noncomputable def orbitToIndex
    (q : MulAction.orbitRel.Quotient (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A)) : ι :=
  (fiberPointToSigma B e (Quotient.out q)).1

/-- The orbit of the chosen fiber point attached to a product index. -/
noncomputable def indexToOrbit (i : ι) :
    MulAction.orbitRel.Quotient (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A) :=
  Quotient.mk (MulAction.orbitRel (galoisGroup K) ↥(finiteEtaleFiberSet (K := K) A))
    (chosenFiberPoint B e i)

theorem indexToOrbit_orbitToIndex (i : ι) :
    orbitToIndex B e (indexToOrbit B e i) = i := by
  set q := indexToOrbit B e i with hq
  have hrel : (Quotient.out q) ∈ MulAction.orbit (galoisGroup K)
      (chosenFiberPoint B e i) := by
    have hq' : Quotient.mk (MulAction.orbitRel (galoisGroup K)
        ↥(finiteEtaleFiberSet (K := K) A)) (Quotient.out q) =
        Quotient.mk (MulAction.orbitRel (galoisGroup K)
          ↥(finiteEtaleFiberSet (K := K) A)) (chosenFiberPoint B e i) := by
      exact (Quotient.out_eq' q).trans rfl
    exact MulAction.orbitRel_apply.mp (Quotient.exact hq')
  obtain ⟨σ, hσ⟩ := MulAction.mem_orbit_iff.mp hrel
  rw [orbitToIndex]
  rw [← hσ]
  rw [show chosenFiberPoint B e i =
      sigmaToFiberPoint B e ⟨i, chosenEmbedding B i⟩ from rfl]
  rw [smul_sigmaToFiberPoint]
  rw [fiberPointToSigma_sigmaToFiberPoint]
  rfl

theorem orbit_sigmaToFiberPoint_eq_indexToOrbit (i : ι)
    (τ : B i →ₐ[K] SeparableClosure K) :
    Quotient.mk (MulAction.orbitRel (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A)) (sigmaToFiberPoint B e ⟨i, τ⟩) =
      indexToOrbit B e i := by
  obtain ⟨σ, hσ⟩ := exists_galoisGroup_comp_eq (K := K) (L := B i) τ
    (chosenEmbedding B i)
  have hcomp_id : (galoisGroupToAlgEquiv K σ⁻¹).toAlgHom.comp
      (galoisGroupToAlgEquiv K σ).toAlgHom =
        AlgHom.id K (SeparableClosure K) := by
    rw [galoisGroupToAlgEquiv_inv]
    exact AlgEquiv.symm_comp _
  have hσinv : (galoisGroupToAlgEquiv K σ⁻¹).toAlgHom.comp (chosenEmbedding B i) = τ := by
    rw [← hσ, ← AlgHom.comp_assoc, hcomp_id, AlgHom.id_comp]
  have hchosen : σ⁻¹ • chosenFiberPoint B e i = sigmaToFiberPoint B e ⟨i, τ⟩ := by
    rw [show chosenFiberPoint B e i =
      sigmaToFiberPoint B e ⟨i, chosenEmbedding B i⟩ from rfl]
    rw [smul_sigmaToFiberPoint]
    congr 1
    refine Sigma.ext_iff.mpr ⟨rfl, heq_of_eq ?_⟩
    exact hσinv
  apply Quotient.sound
  exact MulAction.orbitRel_apply.mpr (MulAction.mem_orbit_iff.mpr ⟨σ⁻¹, hchosen⟩)

theorem orbitToIndex_indexToOrbit
    (q : MulAction.orbitRel.Quotient (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A)) :
    indexToOrbit B e (orbitToIndex B e q) = q := by
  have hx : Quotient.out q = sigmaToFiberPoint B e
      ⟨orbitToIndex B e q, (fiberPointToSigma B e (Quotient.out q)).2⟩ := by
    have h1 := sigmaToFiberPoint_fiberPointToSigma B e (Quotient.out q)
    rw [show fiberPointToSigma B e (Quotient.out q) =
      ⟨orbitToIndex B e q, (fiberPointToSigma B e (Quotient.out q)).2⟩ from rfl] at h1
    exact h1.symm
  conv_rhs => rw [← Quotient.out_eq' q, hx]
  exact (orbit_sigmaToFiberPoint_eq_indexToOrbit B e (orbitToIndex B e q)
    (fiberPointToSigma B e (Quotient.out q)).2).symm

theorem orbitToIndex_bijective : Function.Bijective (orbitToIndex B e) := by
  constructor
  · intro q1 q2 h
    have h1 := orbitToIndex_indexToOrbit B e q1
    have h2 := orbitToIndex_indexToOrbit B e q2
    rw [h] at h1
    exact h1.symm.trans h2
  · intro i
    exact ⟨indexToOrbit B e i, indexToOrbit_orbitToIndex B e i⟩

/-- The orbit quotient of the fiber is the product index. -/
noncomputable def orbitToIndexEquiv :
    (MulAction.orbitRel.Quotient (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A)) ≃ ι :=
  Equiv.ofBijective (orbitToIndex B e) (orbitToIndex_bijective B e)

/-- The fixed field of an orbit stabilizer is the corresponding product factor. -/
noncomputable def orbitFixedFieldAlgEquiv
    (q : MulAction.orbitRel.Quotient (galoisGroup K)
      ↥(finiteEtaleFiberSet (K := K) A)) :
    ↥(openSubgroupFixedField K (fiberOrbitStabilizer B e q)) ≃ₐ[K]
      B (orbitToIndex B e q) :=
  (IntermediateField.equivOfEq
    (openSubgroupFixedField_fiberOrbitStabilizer_eq B e q)).trans
    ((fiberPointToSigma B e (Quotient.out q)).2.equivFieldRange.symm)

end OrbitIndex

/-! ## 5. Continuity of the fiber action and the algebra roundtrip -/

section Roundtrip

/-- The open-stabilizer continuity condition for the fiber of a finite etale
algebra, proved from the product decomposition. -/
theorem finiteEtaleObjectToGSet_isContinuous
    (A : CommAlgCat.FiniteEtale.{u} K) :
    IsContinuousFiniteGaloisSet (K := K) (finiteEtaleObjectToGSet K A) := by
  classical
  obtain ⟨ι, hι, B, hfield, hAlg, e, hfin⟩ := finiteEtale_decomposition K A
  letI : Fintype ι := Fintype.ofFinite ι
  haveI : ∀ i, FiniteDimensional K (B i) := fun i => (hfin i).1
  haveI : ∀ i, Algebra.IsSeparable K (B i) := fun i => (hfin i).2
  intro x
  haveI hfd : FiniteDimensional K (fiberPointToSigma B e x).2.fieldRange :=
    Module.Finite.of_surjective
      ((fiberPointToSigma B e x).2.equivFieldRange).toLinearMap
      ((fiberPointToSigma B e x).2.equivFieldRange).surjective
  change IsOpen (MulAction.stabilizer (galoisGroup K) x : Set (galoisGroup K))
  have hfix : (show Subgroup (galoisGroup K) from
      (fiberPointToSigma B e x).2.fieldRange.fixingSubgroup) =
      MulAction.stabilizer (galoisGroup K) x :=
    (stabilizer_fiberPoint_eq_fixingSubgroup B e x).symm
  have hopen : IsOpen ((show Subgroup (galoisGroup K) from
      (fiberPointToSigma B e x).2.fieldRange.fixingSubgroup) :
        Set (galoisGroup K)) :=
    IntermediateField.fixingSubgroup_isOpen _
  rw [← hfix]
  exact hopen

/-- The actual object map from finite etale algebras to finite continuous
G_K-sets, reconstructed here from the product decomposition. -/
noncomputable def finiteEtaleToContinuousGSet
    (A : CommAlgCat.FiniteEtale.{u} K) :
    FiniteContinuousGaloisSetCategory K :=
  ObjectProperty.FullSubcategory.mk (finiteEtaleObjectToGSet K A)
    (finiteEtaleObjectToGSet_isContinuous (K := K) A)

/-- **Algebra roundtrip, for an arbitrary continuity proof.**  The proof only
uses the underlying fiber G-set of the finite etale algebra, so any continuity
proof for that G-set yields the same algebra roundtrip. -/
theorem algebraRoundtripOfContinuous (A : CommAlgCat.FiniteEtale.{u} K)
    (hcont : IsContinuousFiniteGaloisSet (K := K) (finiteEtaleObjectToGSet K A)) :
    Nonempty (A ≅ FiniteContinuousGSet.gSetToFiniteEtaleObject
      (FiniteContinuousGSet.ofContinuousGaloisSet K
        ⟨finiteEtaleObjectToGSet K A, hcont⟩)) := by
  classical
  obtain ⟨ι, hι, B, hfield, hAlg, e, hfin⟩ := finiteEtale_decomposition K A
  letI : Fintype ι := Fintype.ofFinite ι
  haveI : ∀ i, FiniteDimensional K (B i) := fun i => (hfin i).1
  haveI : ∀ i, Algebra.IsSeparable K (B i) := fun i => (hfin i).2
  let X : FiniteContinuousGSet K :=
    FiniteContinuousGSet.ofContinuousGaloisSet K
      ⟨finiteEtaleObjectToGSet K A, hcont⟩
  let idx : X.orbitIndex ≃ ι := orbitToIndexEquiv B e
  let eMid :
      (Π i : ι, B i) ≃ₐ[K]
        (Π q : X.orbitIndex,
          ↥(openSubgroupFixedField K (X.orbitStabilizer q))) :=
    (AlgEquiv.piCongrLeft K B idx).symm.trans
      (AlgEquiv.piCongrRight (fun q =>
        (orbitFixedFieldAlgEquiv B e q).symm))
  let eObj :
      (Π q : X.orbitIndex,
          ↥(openSubgroupFixedField K (X.orbitStabilizer q))) ≃ₐ[K]
        ↥(FiniteContinuousGSet.gSetToFiniteEtaleObject X).obj :=
    (FiniteContinuousGSet.gSetToFiniteEtaleObjectAlgEquiv X).symm
  exact ⟨CommAlgCat.FiniteEtale.isoMk (e.trans (eMid.trans eObj))⟩

/-- **Algebra roundtrip.**  A finite etale K-algebra is K-algebra isomorphic to
the finite etale algebra attached to the finite continuous G_K-set of its
K-algebra maps to the separable closure. -/
theorem algebraRoundtrip (A : CommAlgCat.FiniteEtale.{u} K) :
    Nonempty (A ≅ FiniteContinuousGSet.gSetToFiniteEtaleObject
      (FiniteContinuousGSet.ofContinuousGaloisSet K
        (finiteEtaleToContinuousGSet (K := K) A))) :=
  algebraRoundtripOfContinuous A (finiteEtaleObjectToGSet_isContinuous (K := K) A)

end Roundtrip

end AlgebraRoundtripGalois
end LeanFormal.IUT.IUTII.Frobenioid.Example36

noncomputable section

namespace LeanFormal.IUT.IUTII.Frobenioid.Example36

open CategoryTheory CommAlgCat
open GaloisCorrespondence EtaleCoverFoundations GSetToEtaleAlgebra

universe u

variable (K : Type u) [Field K]

/-- The formula for the inverse fiber-product equivalence on a representative
coset: on a point b of the algebra it is the restriction of sigma to the
q-th fixed-field component. -/
theorem fiberProductSigmaEquiv_symm_mk_apply (X : FiniteContinuousGSet K)
    (q : X.orbitIndex) (σ : galoisGroup K)
    (b : ↥(X.gSetToFiniteEtaleObject)) :
    (FiniteContinuousGSet.fiberProductSigmaEquiv K X).symm
        ⟨q, Quotient.mk (leftCosetSetoid K (X.orbitStabilizer q)) σ⟩ b =
      galoisRestrictFixedField K (X.orbitStabilizer q) σ
        (X.gSetToFiniteEtaleObjectAlgEquiv b q) := by
  rw [FiniteContinuousGSet.fiberProductSigmaEquiv_eq_arrowCongr_trans,
    Equiv.symm_trans_apply,
    FiniteContinuousGSet.fiberProductSigmaEquivPi_symm_apply]
  rw [AlgEquiv.arrowCongr_symm, AlgEquiv.arrowCongr_apply]
  simp only [AlgEquiv.symm_symm, AlgHom.comp_apply, algHomPiInverse,
    Pi.evalAlgHom_apply]
  change galoisCosetAlgHomEquiv K (X.orbitStabilizer q)
      (Quotient.mk (leftCosetSetoid K (X.orbitStabilizer q)) σ)
      (X.gSetToFiniteEtaleObjectAlgEquiv b q) =
    galoisRestrictFixedField K (X.orbitStabilizer q) σ
      (X.gSetToFiniteEtaleObjectAlgEquiv b q)
  rfl

/-- Component formula for the object map: the q-th component of the image of
b is the q-th orbit fixed-field map applied to the orbitImage-component
of b. -/
lemma gSetToFiniteEtaleObjectMap_component_apply (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (b : ↥(Y.gSetToFiniteEtaleObject)) (q : X.orbitIndex) :
    X.gSetToFiniteEtaleObjectAlgEquiv (gSetToFiniteEtaleObjectMap K X Y f b) q =
      orbitFixedFieldMap K X Y f q
        (Y.gSetToFiniteEtaleObjectAlgEquiv b (orbitImage K X Y f q)) := by
  rw [gSetToFiniteEtaleObjectMap_eq_productMap]
  change orbitFixedFieldProductMap K X Y f
        (Y.gSetToFiniteEtaleObjectAlgEquiv b) q =
      orbitFixedFieldMap K X Y f q
        (Y.gSetToFiniteEtaleObjectAlgEquiv b (orbitImage K X Y f q))
  rw [orbitFixedFieldProductMap_apply]

/-- The map on the Sigma of coset spaces induced by a morphism of finite
continuous G_K-sets: the orbit image together with right multiplication by the
orbit twist (well defined by the conjugation of stabilizers). -/
noncomputable def orbitSigmaMap (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) :
    (Σ q : X.orbitIndex, leftCosetQuotient K (X.orbitStabilizer q)) →
      (Σ r : Y.orbitIndex, leftCosetQuotient K (Y.orbitStabilizer r)) :=
  fun s => ⟨orbitImage K X Y f s.1,
    Quotient.map (fun σ : galoisGroup K => σ * orbitTwist K X Y f s.1) (by
      intro a b hab
      change galoisGroupToAlgEquiv K
          ((a * orbitTwist K X Y f s.1)⁻¹ * (b * orbitTwist K X Y f s.1)) ∈
        (openSubgroupFixedField K
          (Y.orbitStabilizer (orbitImage K X Y f s.1))).fixingSubgroup
      rw [openSubgroupFixedField_fixingSubgroup_eq]
      have hmem : a⁻¹ * b ∈ (X.orbitStabilizer s.1).toSubgroup := by
        have h := hab
        change galoisGroupToAlgEquiv K (a⁻¹ * b) ∈
          (openSubgroupFixedField K (X.orbitStabilizer s.1)).fixingSubgroup at h
        rw [openSubgroupFixedField_fixingSubgroup_eq] at h
        exact h
      have hgroup :
          (a * orbitTwist K X Y f s.1)⁻¹ * (b * orbitTwist K X Y f s.1) =
            (orbitTwist K X Y f s.1)⁻¹ * (a⁻¹ * b) * orbitTwist K X Y f s.1 := by
        group
      rw [hgroup]
      exact orbitStabilizer_conj_mem K X Y f s.1 (a⁻¹ * b) hmem) s.2⟩

lemma orbitSigmaMap_mk (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet) (q : X.orbitIndex) (σ : galoisGroup K) :
    orbitSigmaMap K X Y f
        ⟨q, Quotient.mk (leftCosetSetoid K (X.orbitStabilizer q)) σ⟩ =
      ⟨orbitImage K X Y f q,
        Quotient.mk (leftCosetSetoid K (Y.orbitStabilizer (orbitImage K X Y f q)))
          (σ * orbitTwist K X Y f q)⟩ :=
  rfl

/-- The orbit decomposition inverse intertwines the Sigma map induced by a
morphism with the underlying map of finite G_K-sets. -/
theorem orbitDecomposition_symm_orbitSigmaMap (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet)
    (s : Σ q : X.orbitIndex, leftCosetQuotient K (X.orbitStabilizer q)) :
    (orbitDecomposition K Y).symm (orbitSigmaMap K X Y f s) =
      (show ↥Y.toGSet.V from
        f.hom (show ↥X.toGSet.V from (orbitDecomposition K X).symm s)) := by
  obtain ⟨q, c⟩ := s
  induction c using Quotient.inductionOn with
  | h σ =>
    rw [orbitSigmaMap_mk]
    rw [existingDecompositionInverse_representative]
    rw [existingDecompositionInverse_representative]
    rw [actionHom_smul_apply]
    rw [← orbitTwist_spec]
    rw [mul_smul]


/-- Inverse form of the naturality of the fiber-product equivalence: the inverse
on the Sigma of cosets of the image point is the inverse of the source point
composed with the object map. -/
theorem fiberProductSigmaEquiv_symm_orbitSigmaMap (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet)
    (s : Σ q : X.orbitIndex, leftCosetQuotient K (X.orbitStabilizer q)) :
    (FiniteContinuousGSet.fiberProductSigmaEquiv K Y).symm (orbitSigmaMap K X Y f s) =
      ((FiniteContinuousGSet.fiberProductSigmaEquiv K X).symm s).comp
        (gSetToFiniteEtaleObjectMap K X Y f) := by
  apply AlgHom.ext
  intro b
  obtain ⟨q, c⟩ := s
  induction c using Quotient.inductionOn with
  | h σ =>
    rw [AlgHom.comp_apply]
    rw [orbitSigmaMap_mk]
    rw [fiberProductSigmaEquiv_symm_mk_apply K Y (orbitImage K X Y f q)
      (σ * orbitTwist K X Y f q) b]
    rw [fiberProductSigmaEquiv_symm_mk_apply K X q σ
      (gSetToFiniteEtaleObjectMap K X Y f b)]
    rw [galoisRestrictFixedField_apply, galoisRestrictFixedField_apply]
    rw [gSetToFiniteEtaleObjectMap_component_apply]
    rw [orbitFixedFieldMap_coe_apply]
    rw [galoisGroupToAlgEquiv_mul, algEquiv_mul_apply]

/-- Naturality of the fiber-product Sigma equivalence with respect to a morphism
of finite continuous G_K-sets. -/
theorem fiberProductSigmaEquiv_natural (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet)
    (φ : ↥(FiniteContinuousGSet.gSetToFiniteEtaleObject X) →ₐ[K] SeparableClosure K) :
    FiniteContinuousGSet.fiberProductSigmaEquiv K Y
        (φ.comp (gSetToFiniteEtaleObjectMap K X Y f)) =
      orbitSigmaMap K X Y f (FiniteContinuousGSet.fiberProductSigmaEquiv K X φ) := by
  apply (FiniteContinuousGSet.fiberProductSigmaEquiv K Y).symm.injective
  rw [Equiv.symm_apply_apply, fiberProductSigmaEquiv_symm_orbitSigmaMap,
    Equiv.symm_apply_apply]

/-- Naturality of the fiber action equivalence: the comparison of the fiber of
the orbit-product algebra with the finite G_K-set is natural in the G_K-set. -/
theorem fiberActionEquiv_natural (X Y : FiniteContinuousGSet K)
    (f : X.toGSet ⟶ Y.toGSet)
    (φ : ↥(FiniteContinuousGSet.gSetToFiniteEtaleObject X) →ₐ[K] SeparableClosure K) :
    FiniteContinuousGSet.fiberActionEquiv K Y
        (φ.comp (gSetToFiniteEtaleObjectMap K X Y f)) =
      (show ↥Y.toGSet.V from f.hom (show ↥X.toGSet.V from
        FiniteContinuousGSet.fiberActionEquiv K X φ)) := by
  rw [FiniteContinuousGSet.fiberActionEquiv, FiniteContinuousGSet.fiberActionEquiv,
    Equiv.trans_apply, Equiv.trans_apply, fiberProductSigmaEquiv_natural,
    orbitDecomposition_symm_orbitSigmaMap]

end LeanFormal.IUT.IUTII.Frobenioid.Example36


noncomputable def finiteEtaleContinuousEquivalenceFinal :
    (CommAlgCat.FiniteEtale.{u} K)ᵒᵖ ≌ FiniteContinuousGaloisSetCategory K :=
  CategoryTheory.Equivalence.mk
    (finiteEtaleToContinuousFunctor K)
    (continuousGaloisSetToFiniteEtaleFunctor K)
    (UnitNaturality.unitNatIso K)
    (continuousGaloisSetCounitNat (K := K))

noncomputable def fieldGaloisCorrespondenceFinal :
    FieldGaloisCorrespondence K :=
  GSetToEtaleAlgebra.fieldGaloisCorrespondenceOfEquivalence K
    (finiteEtaleContinuousEquivalenceFinal (K := K))

noncomputable def galoisNaturalityCardFinal :
    GaloisNaturalityCard K :=
  GSetToEtaleAlgebra.galoisNaturalityCardOfEquivalence K
    (finiteEtaleContinuousEquivalenceFinal (K := K))
    (finiteEtaleToContinuousFunctor_fiber_compatibility (K := K))

end LeanFormal.IUT.IUTII.Frobenioid.Example36

namespace LeanFormal.IUT.IUTII.Frobenioid.Example36


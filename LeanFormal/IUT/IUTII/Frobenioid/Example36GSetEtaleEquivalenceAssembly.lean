    GSetToEtaleNaturalityCard K :=
  GSetToEtaleAlgebra.gSetToEtaleNaturalityCardOfFieldCorrespondence K
    (fieldGaloisCorrespondenceFinal (K := K))
    (finiteEtaleToContinuousFunctor_fiber_compatibility (K := K))


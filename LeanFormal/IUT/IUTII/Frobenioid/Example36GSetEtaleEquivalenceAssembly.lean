open CategoryTheory CommAlgCat
open GaloisCorrespondence EtaleCoverFoundations GSetToEtaleAlgebra

universe u
variable {K : Type u} [Field K]

lemma finiteEtaleToContinuousFunctor_map_apply
    (X Y : FiniteContinuousGaloisSetCategory K) (f : X ⟶ Y)
    (x : ((finiteEtaleToContinuousFunctor K).obj
      ((continuousGaloisSetToFiniteEtaleFunctor K).obj X)).obj.V.obj) :
    ((continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K).map f).hom.hom x =
      x.comp (gSetToFiniteEtaleObjectMap K
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X)
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y)
        (forgetHom (K := K) f)) := by
  simp [continuousGaloisSetToFiniteEtaleFunctor, finiteEtaleToContinuousFunctor,
    finiteEtaleToActionFunctor, finiteEtaleFiberActionHom, forgetHom, fieldFiber]
  rfl

lemma fiberActionIso_hom_apply (X : FiniteContinuousGaloisSetCategory K)
    (x : ((finiteEtaleToContinuousFunctor K).obj
      ((continuousGaloisSetToFiniteEtaleFunctor K).obj X)).obj.V.obj) :
    (FiniteContinuousGSet.fiberActionIso K
      (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X)).hom.hom x =
      FiniteContinuousGSet.fiberActionEquiv K
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X) x := by
  rfl

theorem fiberActionIsoFull_natural {X Y : FiniteContinuousGaloisSetCategory K} (f : X ⟶ Y) :
    (fiberActionIsoFull (K := K) X).hom ≫ f =
      ((continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K).map f) ≫
        (fiberActionIsoFull (K := K) Y).hom := by
  apply ObjectProperty.hom_ext
  apply Action.Hom.ext
  apply FintypeCat.hom_ext
  intro x
  simp only [ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.homMk_hom,
    Action.comp_hom, fiberActionIsoFull, ObjectProperty.isoMk_hom]
  change (ConcreteCategory.hom ((FiniteContinuousGSet.fiberActionIso K
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X)).hom.hom
        ≫ f.hom.hom)) x =
      (ConcreteCategory.hom (((continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K).map f).hom.hom
        ≫ (FiniteContinuousGSet.fiberActionIso K
          (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y)).hom.hom)) x
  rw [FintypeCat.comp_apply, FintypeCat.comp_apply]
  rw [fiberActionIso_hom_apply, finiteEtaleToContinuousFunctor_map_apply]
  change (ConcreteCategory.hom (forgetHom (K := K) f).hom)
      ((FiniteContinuousGSet.fiberActionEquiv K
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X)) x) =
    FiniteContinuousGSet.fiberActionEquiv K
      (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y)
      (x.comp (gSetToFiniteEtaleObjectMap K
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X)
        (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y)
        (forgetHom (K := K) f)))
  exact (fiberActionEquiv_natural K
    (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) X)
    (FiniteContinuousGSet.ofContinuousGaloisSet (K := K) Y)
    (forgetHom (K := K) f) x).symm

noncomputable def continuousGaloisSetCounitNat :
    (continuousGaloisSetToFiniteEtaleFunctor K ⋙ finiteEtaleToContinuousFunctor K) ≅
      𝟭 (FiniteContinuousGaloisSetCategory K) :=
  counitOfComponents (K := K)
    (fun f => fiberActionIsoFull_natural (K := K) f)

end LeanFormal.IUT.IUTII.Frobenioid.Example36

noncomputable section

set_option linter.unnecessarySimpa false
set_option linter.unusedTactic false
set_option linter.unusedSimpArgs false

namespace LeanFormal.IUT.IUTII.Frobenioid.Example36
namespace UnitNaturality

open CategoryTheory CommAlgCat
open GSetToEtaleAlgebra EtaleCoverFoundations GaloisCorrespondence
open LeanFormal.IUT.IUTII.Frobenioid.Example36.AlgebraRoundtripGalois

set_option maxHeartbeats 1000000

universe u
variable (K : Type u) [Field K]

/-! ## The evaluation map from a finite etale algebra to its orbit product -/

noncomputable abbrev fiberGSet (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) : FiniteContinuousGSet K :=
  FiniteContinuousGSet.ofContinuousGaloisSet K ((finiteEtaleToContinuousFunctor K).obj A)

noncomputable def fiberToAlgHom (A : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (x : ↥(fiberGSet K A).toGSet.V) : ↥(A.unop).obj →ₐ[K] SeparableClosure K :=
  (show ↥(finiteEtaleFiberSet (K := K) A.unop) from x)

lemma smul_apply_eq_orbit (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) (σ : galoisGroup K)
    (x : ↥(fiberGSet K A).toGSet.V) (a : ↥(A.unop).obj) :
    galoisGroupToAlgEquiv K σ (fiberToAlgHom K A x a) = fiberToAlgHom K A (σ • x) a := rfl

noncomputable def orbitFiberPoint (A : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (q : (fiberGSet K A).orbitIndex) : ↥(A.unop).obj →ₐ[K] SeparableClosure K :=
  fiberToAlgHom K A q.out

lemma orbitFiberPoint_apply (A : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (q : (fiberGSet K A).orbitIndex) (a : ↥(A.unop).obj) :
    orbitFiberPoint K A q a = fiberToAlgHom K A q.out a := rfl

theorem orbitFiberPoint_mem (A : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (q : (fiberGSet K A).orbitIndex) (a : ↥(A.unop).obj) :
    orbitFiberPoint K A q a ∈ (fiberGSet K A).orbitFixedField q := by
  rw [FiniteContinuousGSet.orbitFixedField, openSubgroupFixedField,
    IntermediateField.mem_fixedField_iff]
  intro σ hσ
  let σ' : galoisGroup K := σ
  have hσ' : σ' ∈ (fiberGSet K A).orbitStabilizer q := hσ
  have hfix : σ' • q.out = q.out := MulAction.mem_stabilizer_iff.mp hσ'
  change galoisGroupToAlgEquiv K σ' (orbitFiberPoint K A q a) = orbitFiberPoint K A q a
  rw [orbitFiberPoint_apply, smul_apply_eq_orbit K A σ' q.out a, hfix]

noncomputable def orbitEvalAlgHom (A : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (q : (fiberGSet K A).orbitIndex) :
    ↥(A.unop).obj →ₐ[K] ↥((fiberGSet K A).orbitFixedField q) where
  toFun a := ⟨orbitFiberPoint K A q a, orbitFiberPoint_mem K A q a⟩
  map_one' := Subtype.ext (map_one (orbitFiberPoint K A q))
  map_mul' x y := Subtype.ext (map_mul (orbitFiberPoint K A q) x y)
  map_zero' := Subtype.ext (map_zero (orbitFiberPoint K A q))
  map_add' x y := Subtype.ext (map_add (orbitFiberPoint K A q) x y)
  commutes' k := Subtype.ext (AlgHom.commutes (orbitFiberPoint K A q) k)

noncomputable def fiberEvalPi (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    ↥(A.unop).obj →ₐ[K]
      (Π q : (fiberGSet K A).orbitIndex, ↥((fiberGSet K A).orbitFixedField q)) :=
  AlgHom.pi (fun q => orbitEvalAlgHom K A q)

@[simp] lemma fiberEvalPi_apply_coe (A : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (a : ↥(A.unop).obj) (q : (fiberGSet K A).orbitIndex) :
    ((fiberEvalPi K A a) q : SeparableClosure K) = orbitFiberPoint K A q a := rfl

lemma fiberGSetMap_apply (A B : (CommAlgCat.FiniteEtale K)ᵒᵖ) (f : A ⟶ B)
    (x : ↥(fiberGSet K A).toGSet.V) :
    fiberToAlgHom K B
        ((ConcreteCategory.hom (forgetHom K ((finiteEtaleToContinuousFunctor K).map f)).hom) x)
      = (fiberToAlgHom K A x).comp f.unop.hom.hom := rfl

lemma smul_point_eval (B : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (σ : galoisGroup K) (r : (fiberGSet K B).orbitIndex) (b : ↥(B.unop).obj) :
    galoisGroupToAlgEquiv K σ (orbitFiberPoint K B r b)
      = fiberToAlgHom K B (σ • Quotient.out r) b :=
  smul_apply_eq_orbit K B σ (Quotient.out r) b

theorem fiberEvalPi_naturality {A B : (CommAlgCat.FiniteEtale K)ᵒᵖ} (f : A ⟶ B) :
    (orbitFixedFieldProductMap K (fiberGSet K A) (fiberGSet K B)
        (forgetHom K ((finiteEtaleToContinuousFunctor K).map f))).comp (fiberEvalPi K B)
      = (fiberEvalPi K A).comp (f.unop.hom.hom) := by
  apply AlgHom.ext
  intro b
  funext q
  apply Subtype.ext
  rw [AlgHom.comp_apply, AlgHom.comp_apply]
  rw [orbitFixedFieldProductMap_apply, orbitFixedFieldMap_coe_apply, fiberEvalPi_apply_coe,
    smul_point_eval K B, orbitTwist_spec K (fiberGSet K A) (fiberGSet K B)
      (forgetHom K ((finiteEtaleToContinuousFunctor K).map f)) q, fiberGSetMap_apply K A B f,
    AlgHom.comp_apply, fiberEvalPi_apply_coe, orbitFiberPoint_apply]

/-! ## Transport to the roundtrip algebra -/

noncomputable def fiberEvalAlgHom (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    ↥(A.unop).obj →ₐ[K]
      ↥(((finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).obj A).unop).obj :=
  ((fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.symm).toAlgHom.comp (fiberEvalPi K A)

lemma fiberEvalAlgHom_apply (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) (a : ↥(A.unop).obj) :
    fiberEvalAlgHom K A a
      = ((fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.symm) (fiberEvalPi K A a) := rfl

lemma roundtripMap_eq_product (A B : (CommAlgCat.FiniteEtale K)ᵒᵖ) (f : A ⟶ B) :
    (((continuousGaloisSetToFiniteEtaleFunctor K).map
        ((finiteEtaleToContinuousFunctor K).map f)).unop.hom.hom)
      = gSetToFiniteEtaleObjectMap K (fiberGSet K A) (fiberGSet K B)
          (forgetHom K ((finiteEtaleToContinuousFunctor K).map f)) := rfl


/-!
## What is proved here and what remains

Proved (axioms propext, Classical.choice, Quot.sound):

* fiberEvalPi K A : a map from the algebra to the product of the orbit fixed fields,
  the explicit evaluation sending an element a to the tuple q ↦ (Quotient.out q) a,
  with its value lemmas fiberEvalPi_apply_coe, fiberGSetMap_apply, smul_point_eval,
  orbitFiberPoint_mem and smul_apply_eq_orbit;
* fiberEvalPi_naturality: the crux naturality
  P.comp (fiberEvalPi K B) = (fiberEvalPi K A).comp f.unop.hom.hom,
  where P is the orbit product map attached to the induced G-set map of fibers,
  proved from orbitFixedFieldProductMap_apply, orbitFixedFieldMap_coe_apply,
  orbitTwist_spec and the point formula for finiteEtaleToContinuousFunctor;
* the definition of the evaluation map fiberEvalAlgHom into the roundtrip algebra and the
  identification roundtripMap_eq_product of the functor's algebra map on morphisms.

Remaining steps towards unitOfComponents, with the exact obstructions found:

1. fiberEvalAlgHom_naturality, the transport of fiberEvalPi_naturality through
   gSetToFiniteEtaleObjectMap_eq_productMap.  Obstruction: the two descriptions of the
   orbit product, (q : X.orbitIndex) -> X.orbitFixedField q and
   (q : X.orbitIndex) -> openSubgroupFixedField K (X.orbitStabilizer q), are equal only by
   unfolding orbitFixedField, i.e. definitionally at *default* transparency and not at
   instances transparency.  Hence the intermediate goal
   ((eA.symm).comp ((P).comp eB)).comp ((eB.symm).comp (fiberEvalPi K B)) = ...
   is rejected by rw / AlgHom.comp_apply with the message "the target expression is not
   type-correct under the instances transparency level".  A fix is to restate fiberEvalPi
   and the product map in the openSubgroupFixedField K (orbitStabilizer q) form so that
   the types match syntactically.
2. Injectivity of fiberEvalPi: the intended proof (decompose A.unop with
   finiteEtale_decomposition, pick a nonzero factor, embed that factor into
   SeparableClosure K, and use that the orbit representative differs from the chosen point
   by a Galois element) is laid out but hits the haveI instance-mismatch error
   "synthesized type class instance is not definitionally equal" when installing the
   Field / Algebra / Module.Finite / IsSeparable instances of the decomposition.
3. finrank K (A.unop.obj) = finrank K ((F ⋙ G).obj A).unop.obj from algebraRoundtrip
   (which has exactly the unit target type); extracting an AlgEquiv from the FiniteEtale
   isomorphism needs e.hom.hom.hom (three projections) plus the two composition identities
   from Iso.hom_inv_id and Iso.inv_hom_id.
4. Bijectivity of the evaluation, the resulting AlgEquiv, the unit component
   A ≅ (F ⋙ G).obj A and NatIso.ofComponents for the unit, whose naturality is the dual of
   fiberEvalPi_naturality (ev_A⁻¹ ≫ M = f.unop ≫ ev_B⁻¹, from the same square).
-/

theorem fiberEvalPi_eq_zero (A : (CommAlgCat.FiniteEtale K)ᵒᵖ)
    (a : ↥(A.unop).obj) (h : fiberEvalPi K A a = 0) : a = 0 := by
  classical
  obtain ⟨ι, hι, B, hfield, hAlg, e, hfin⟩ := finiteEtale_decomposition K A.unop
  letI : Fintype ι := Fintype.ofFinite ι
  letI : DecidableEq ι := Classical.decEq ι
  haveI : ∀ i, FiniteDimensional K (B i) := fun i => (hfin i).1
  haveI : ∀ i, Algebra.IsSeparable K (B i) := fun i => (hfin i).2
  by_contra ha
  have hea : e a ≠ 0 := by
    intro h0
    exact ha (e.injective (by simpa [h0]))
  obtain ⟨i0, hi0⟩ : ∃ i, (e a) i ≠ 0 := by
    by_contra h'
    push Not at h'
    exact hea (by ext i; exact h' i)
  let q : (fiberGSet K A).orbitIndex := indexToOrbit B e i0
  have hq : orbitToIndex B e q = i0 := by
    simpa [q] using indexToOrbit_orbitToIndex B e i0
  let x : ↥(A.unop).obj →ₐ[K] SeparableClosure K :=
    (show ↥(finiteEtaleFiberSet (K := K) A.unop) from Quotient.out q)
  let s := fiberPointToSigma B e x
  have hfirst : s.1 = i0 := by
    dsimp [s, x]
    change (fiberPointToSigma B e (Quotient.out q)).1 = i0
    rw [show (fiberPointToSigma B e (Quotient.out q)).1 = orbitToIndex B e q from rfl, hq]
  have hrepr : x = sigmaToFiber B e s :=
    (sigmaToFiber_fiberToSigma B e x).symm
  have hx := congrArg (fun f : ↥(A.unop).obj →ₐ[K] SeparableClosure K => f a) hrepr
  rw [sigmaToFiber_apply] at hx
  simp only [AlgHom.comp_apply] at hx
  have hpoint : (show ↥(A.unop).obj →ₐ[K] SeparableClosure K from Quotient.out q) a =
      s.2 ((e a) s.1) := hx
  have hzero : ((fiberEvalPi K A a) q : SeparableClosure K) = 0 := by rw [h]; rfl
  rw [fiberEvalPi_apply_coe] at hzero
  have hne : s.2 ((e a) s.1) ≠ 0 := by
    intro h0
    have hb : (e a) s.1 = 0 := s.2.injective (by simpa using h0)
    exact hi0 (by rwa [hfirst] at hb)
  apply hne
  rw [← hpoint]
  exact hzero

theorem fiberEvalPi_injective (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    Function.Injective (fiberEvalPi K A) := by
  intro a a' h
  have h0 : fiberEvalPi K A (a - a') = 0 := by rw [map_sub, h, sub_self]
  exact sub_eq_zero.mp (fiberEvalPi_eq_zero K A (a - a') h0)

theorem finrank_eval_target (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    Module.finrank K ↥(A.unop).obj =
      Module.finrank K (Π q : (fiberGSet K A).orbitIndex, ↥((fiberGSet K A).orbitFixedField q)) := by
  obtain ⟨e⟩ := AlgebraRoundtripGalois.algebraRoundtrip (K := K) A.unop
  let eι := (ObjectProperty.ι (CommAlgCat.finiteEtale K)).mapIso e
  have eAlg := CommAlgCat.algEquivOfIso eι
  have h1 := eAlg.toLinearEquiv.finrank_eq
  have h2 := (FiniteContinuousGSet.gSetToFiniteEtaleObjectAlgEquiv (fiberGSet K A)).toLinearEquiv.finrank_eq
  exact h1.trans h2.symm

theorem fiberEvalPi_surjective (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    Function.Surjective (fiberEvalPi K A) := by
  haveI : ∀ q : (fiberGSet K A).orbitIndex, FiniteDimensional K ↥((fiberGSet K A).orbitFixedField q) :=
    fun q => (fiberGSet K A).orbitFixedField_finiteDimensional q
  have h := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (f := (fiberEvalPi K A).toLinearMap) (finrank_eval_target K A)).mp
    (fiberEvalPi_injective K A)
  simpa using h

theorem fiberEvalPi_bijective (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    Function.Bijective (fiberEvalPi K A) :=
  ⟨fiberEvalPi_injective K A, fiberEvalPi_surjective K A⟩


noncomputable def fiberEvalPiEquiv (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    ↥(A.unop).obj ≃ₐ[K]
      (Π q : (fiberGSet K A).orbitIndex, ↥((fiberGSet K A).orbitFixedField q)) :=
  AlgEquiv.ofBijective (fiberEvalPi K A) (fiberEvalPi_bijective K A)

noncomputable def fiberEvalAlgEquiv (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    ↥(A.unop).obj ≃ₐ[K]
      ↥(FiniteContinuousGSet.gSetToFiniteEtaleObject (fiberGSet K A)).obj :=
  AlgEquiv.ofBijective (fiberEvalAlgHom K A) (by
    have hp := fiberEvalPi_bijective K A
    have hb : Function.Bijective
        ((fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.symm).toAlgHom :=
      ⟨((fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.symm).injective,
        ((fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.symm).surjective⟩
    exact ⟨hb.1.comp hp.1, hb.2.comp hp.2⟩)

noncomputable def gfToIdComponent (A : (CommAlgCat.FiniteEtale K)ᵒᵖ) :
    (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).obj A ≅ A :=
  (CommAlgCat.FiniteEtale.isoMk (fiberEvalAlgEquiv K A)).op



theorem fiberEvalAlgHom_naturality (A B : (CommAlgCat.FiniteEtale K)ᵒᵖ) (f : A ⟶ B) :
    ((gSetToFiniteEtaleObjectMap K (fiberGSet K A) (fiberGSet K B)
        (forgetHom K ((finiteEtaleToContinuousFunctor K).map f))).comp
      (fiberEvalAlgHom K B) :
        ↥(B.unop).obj →ₐ[K] ↥((fiberGSet K A).gSetToFiniteEtaleObject).obj)
    = ((fiberEvalAlgHom K A).comp (f.unop.hom.hom) :
        ↥(B.unop).obj →ₐ[K] ↥((fiberGSet K A).gSetToFiniteEtaleObject).obj) := by
  apply AlgHom.ext
  intro b
  apply (fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.injective
  simp only [AlgHom.comp_apply, fiberEvalAlgHom, AlgEquiv.apply_symm_apply]
  rw [gSetToFiniteEtaleObjectMap_eq_productMap]
  simp only [AlgHom.comp_apply, AlgEquiv.apply_symm_apply]
  change (fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv
      ((fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.symm
        ((orbitFixedFieldProductMap K (fiberGSet K A) (fiberGSet K B)
            (forgetHom K ((finiteEtaleToContinuousFunctor K).map f)))
          ((fiberEvalPi K B) b)))
    = (fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv
      ((fiberGSet K A).gSetToFiniteEtaleObjectAlgEquiv.symm
        ((fiberEvalPi K A) ((f.unop.hom.hom) b)))
  rw [AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
  exact congrArg (fun h => h b) (fiberEvalPi_naturality K f)



theorem gfToIdComponent_naturality (A B : (CommAlgCat.FiniteEtale K)ᵒᵖ) (f : A ⟶ B) :
    (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).map f ≫
        (gfToIdComponent K B).hom
      = (gfToIdComponent K A).hom ≫ f := by
  refine Quiver.Hom.unop_inj ?_
  apply ObjectProperty.hom_ext (CommAlgCat.finiteEtale K)
  apply CommAlgCat.hom_ext
  simp only [Iso.op_hom, Iso.op_inv, unop_comp, Quiver.Hom.unop_op,
    gfToIdComponent, fiberEvalAlgEquiv, roundtripMap_eq_product]
  exact fiberEvalAlgHom_naturality K A B f

noncomputable def gfToIdNatIso :
    (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K) ≅
      𝟭 (CommAlgCat.FiniteEtale K)ᵒᵖ :=
  NatIso.ofComponents (fun A => gfToIdComponent K A)
    (fun f => gfToIdComponent_naturality K _ _ f)

noncomputable def unitNatIso :
    𝟭 (CommAlgCat.FiniteEtale K)ᵒᵖ ≅
      (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K) :=
  (gfToIdNatIso K).symm

theorem unitNat {A B : (CommAlgCat.FiniteEtale K)ᵒᵖ} (f : A ⟶ B) :
    ((unitNatIso K).app A).hom ≫
        (finiteEtaleToContinuousFunctor K ⋙ continuousGaloisSetToFiniteEtaleFunctor K).map f
      = f ≫ ((unitNatIso K).app B).hom :=
  (((gfToIdNatIso K).symm).hom.naturality f).symm

end UnitNaturality
end LeanFormal.IUT.IUTII.Frobenioid.Example36


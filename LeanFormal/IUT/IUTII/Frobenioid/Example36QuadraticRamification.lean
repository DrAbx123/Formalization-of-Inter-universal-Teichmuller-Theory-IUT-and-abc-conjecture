import LeanFormal.IUT.IUTII.Frobenioid.Example36TransportInstance
import Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas
import Mathlib.Tactic

/-!
# Ramification above (2) in Q(sqrt 2): concrete computations

This file works with the concrete quadratic number field
`K = squareRootField ℚ 2` of the tree and computes the arithmetic of the
element `sqrt 2` inside the ring of integers `𝓞 K`.

Proved here:
* `sqrtTwoInField` is a square root of `2` in `K` and is integral over `ℤ`;
* `sqrtTwoInteger` is the corresponding element of `𝓞 K`, with
  `sqrtTwoInteger^2 = 2` (as an equality in `𝓞 K`);
* the principal ideal `(sqrtTwoInteger)` squares to the ideal `(2)` of `𝓞 K`.

Boundary: the primality of the ideal `(sqrtTwoInteger)` (equivalently, that its
residue ring is `ZMod 2`) is NOT proved in this file; it is recorded as the
explicit missing proposition `quadraticSqrtTwoPrimeMissing`.  Consequently the
numerical ramification-index statement `e = 2` remains the missing computation
`quadraticSqrtTwoRamificationMissing`; no conclusion is assumed as a field.
-/

noncomputable section

namespace LeanFormal.IUT.IUTII.Frobenioid
namespace Example36

open scoped NumberField
open Polynomial IsDedekindDomain
open LeanFormal.IUT.LegendreQuadraticParameterFields

/-- The concrete quadratic number field `Q(sqrt 2)` used by the transport
instance. -/
abbrev quadraticSqrtTwoField : Type := squareRootField ℚ (2 : ℚ)

/-- The element `sqrt 2` in `Q(sqrt 2)`. -/
def sqrtTwoInField : quadraticSqrtTwoField :=
  squareRoot ℚ (2 : ℚ)

/-- The defining square relation for `sqrt 2` in `Q(sqrt 2)`. -/
theorem sqrtTwoInField_sq :
    sqrtTwoInField ^ 2 = algebraMap ℚ quadraticSqrtTwoField (2 : ℚ) :=
  squareRoot_sq ℚ (2 : ℚ)

/-- `sqrt 2` is a nonzero element of `Q(sqrt 2)`. -/
theorem sqrtTwoInField_ne_zero : sqrtTwoInField ≠ 0 := by
  intro hzero
  have hsq : (0 : quadraticSqrtTwoField) = algebraMap ℚ quadraticSqrtTwoField (2 : ℚ) := by
    rw [← sqrtTwoInField_sq, hzero]
    norm_num
  have htwo : (2 : ℚ) = 0 := by
    apply (algebraMap ℚ quadraticSqrtTwoField).injective
    simpa using hsq.symm
  norm_num at htwo

/-- `sqrt 2` is integral over `ℤ`, witnessed by the monic polynomial
`X^2 - 2`. -/
theorem sqrtTwoInField_isIntegral : IsIntegral ℤ sqrtTwoInField := by
  refine ⟨X ^ 2 - C (2 : ℤ), monic_X_pow_sub_C (2 : ℤ) (by decide), ?_⟩
  simp only [eval₂_sub, eval₂_pow, eval₂_X, eval₂_C, sqrtTwoInField_sq]
  rw [IsScalarTower.algebraMap_apply ℤ ℚ quadraticSqrtTwoField (2 : ℤ)]
  norm_num

/-- The element `sqrt 2` in the ring of integers of `Q(sqrt 2)`. -/
def sqrtTwoInteger : 𝓞 quadraticSqrtTwoField :=
  Classical.choose (IsIntegralClosure.isIntegral_iff.mp
    (sqrtTwoInField_isIntegral))

/-- `sqrtTwoInteger` maps to `sqrt 2` in the field. -/
theorem algebraMap_sqrtTwoInteger :
    algebraMap (𝓞 quadraticSqrtTwoField) quadraticSqrtTwoField sqrtTwoInteger =
      sqrtTwoInField :=
  Classical.choose_spec (IsIntegralClosure.isIntegral_iff.mp
    (sqrtTwoInField_isIntegral))

/-- The square of `sqrt 2` in the ring of integers is the image of `2`. -/
theorem sqrtTwoInteger_sq :
    sqrtTwoInteger * sqrtTwoInteger =
      algebraMap ℤ (𝓞 quadraticSqrtTwoField) (2 : ℤ) := by
  apply IsIntegralClosure.algebraMap_injective
    (A := 𝓞 quadraticSqrtTwoField) (R := ℤ) (B := quadraticSqrtTwoField)
  rw [map_mul, algebraMap_sqrtTwoInteger, ← sq, sqrtTwoInField_sq]
  rw [← IsScalarTower.algebraMap_apply ℤ (𝓞 quadraticSqrtTwoField) quadraticSqrtTwoField (2 : ℤ)]
  rw [IsScalarTower.algebraMap_apply ℤ ℚ quadraticSqrtTwoField (2 : ℤ)]
  norm_num

/-- The principal ideal generated by `sqrt 2` squares to the ideal `(2)` in
the ring of integers of `Q(sqrt 2)`. -/
theorem sqrtTwoIdeal_sq :
    (Ideal.span {sqrtTwoInteger} : Ideal (𝓞 quadraticSqrtTwoField)) ^ 2 =
      Ideal.span {(2 : 𝓞 quadraticSqrtTwoField)} := by
  rw [pow_two, Ideal.span_singleton_mul_span_singleton, sqrtTwoInteger_sq]
  norm_num

/-- The ideal `(sqrt 2)` is nonzero. -/
theorem sqrtTwoIdeal_ne_bot :
    (Ideal.span {sqrtTwoInteger} : Ideal (𝓞 quadraticSqrtTwoField)) ≠ ⊥ := by
  intro hbot
  have hmem : sqrtTwoInteger ∈ (⊥ : Ideal (𝓞 quadraticSqrtTwoField)) := by
    rw [← hbot]
    exact Ideal.subset_span rfl
  rw [Ideal.mem_bot] at hmem
  have hmap : algebraMap (𝓞 quadraticSqrtTwoField) quadraticSqrtTwoField sqrtTwoInteger = 0 := by
    rw [hmem, map_zero]
  rw [algebraMap_sqrtTwoInteger] at hmap
  exact sqrtTwoInField_ne_zero hmap

/-- Exact missing lemma: the principal ideal `(sqrt 2)` is prime, equivalently
its residue ring is `ZMod 2`.  This is the only arithmetic input missing for the
ramification-index computation `e = 2` above `(2)`. -/
def quadraticSqrtTwoPrimeMissing : Prop :=
  (Ideal.span {sqrtTwoInteger} : Ideal (𝓞 quadraticSqrtTwoField)).IsPrime

/-- Exact missing computation: there is an upper place of `Q(sqrt 2)` above
`(2)` whose ramification index for the transport datum is `2`.  Its proof
requires `quadraticSqrtTwoPrimeMissing` together with the standard factor-count
lemma `Ideal.IsDedekindDomain.ramificationIdx'_eq_factors_count`; it is recorded
here, not assumed. -/
def quadraticSqrtTwoRamificationMissing : Prop :=
  ∃ w : HeightOneSpectrum (𝓞 quadraticSqrtTwoField),
    ramificationIndexAtUpperPlace (F := ℚ) (F' := quadraticSqrtTwoField) w = 2

end Example36
end LeanFormal.IUT.IUTII.Frobenioid
end

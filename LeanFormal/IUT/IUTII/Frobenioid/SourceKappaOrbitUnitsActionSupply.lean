import LeanFormal.IUT.IUTI.HodgeTheater.PrimeStripCore
import LeanFormal.IUT.IUTII.Kummer.TimesMuIsm
import LeanFormal.IUT.Audit.Status
import Mathlib.Tactic

/-!
# Kappa-orbit source data supplying the strip-level units actions (IUT II, Definition 4.9)

Source anchor: IUT II, Definition 4.9, (i) (local corpus text `Inter-universal
Teichmuller Theory II.txt`, lines 10035-10098).  A `x`-Kummer structure
(respectively, `x mu`-Kummer structure) on a Frobenioid is a `Zhat^x`-
(respectively, `Ism`) orbit of isomorphisms `kappa^x : O^x(G) ~> O^x(A)`
(respectively, `kappa^{x mu} : O^{x mu}(G) ~> O^{x mu}(A)`) of ind-topological
`G`-modules; the `x mu`-Kummer structure determines, and is completely
determined by, the submodules `I^kappa_H(A) = Im(O^x(G)^H)` for `H` open in `G`
(lines 10072-10093).  The subgroup `Ism` is the compact group of
`G`-isometries of `O^{x mu}(G)`, i.e. `G`-equivariant automorphisms that, for
each open `H`, preserve the lattice in `O^{x mu}(G)^H` determined by the image
of `O^x(G)^H` (IUT II, Example 1.8, (iv), lines 2192-2196).

The split-case packaging and the identification used for the factorization
below are Definition 4.9, (ii) (lines 10099-10144): for a split Frobenioid,
`Aut(A)` of a universal covering is a profinite group isomorphic to `G_w`,
`O^perp` is generated by the `2l`-torsion and the splitting images,
`O^triangleright = O^perp/mu_2l`, all these monoids carry natural actions, and
the group-theoretic algorithm induces the `Ism`-orbit `kappa^{x mu}`.  The
ambient F-prime-strip context is Definition 4.9, (viii) (lines 10293-10308).

This module is the source-side supply routed to the source-input line by the
SHE transport chain (sections 19.2-19.4 of
`logs/coordination/outsider-survey-transport-20261016.md`): per strip and per
place `v`, the factorization `g : G →* toDPrimeStrip.Pi v` together with the
orbit laws, so that the strip-side conditional constructor
(`IUTII/Frobenioid/PrimeStripUnitsActionFactorization.lean`, in flight, not
imported here) yields `sourceAction v = (F.unitsAction v).comp (g v)` for the
`SourceTimesMuKummerLayer` and `SourceEvaluationUnitPortion` slots
(`IUTIII/Theorem311/SourceKummerEvaluationArrows.lean`, lines 130-139 and
249-259).  Cited context for IUT III, Theorem 3.11, (ii), is recorded in
`logs/coordination/wild-brainstorm-20261017.md`, section 20C.

## Reduction notes

* The group-theoretic algorithm `G ↦ (G : O^x(G))` (IUT II, Example 1.8,
  (iii)) is not constructed here: `sourceUnits` enters as frozen interface
  data carrying its `G`-action.
* The ind-topology is modeled only through the topology on `G`, exactly as in
  the existing torsion-quotient and `Ism` modules
  (`Kummer/TimesMuQuotient.lean`, `Kummer/TimesMuIsm.lean`).
* One abstract group `G` acts at every place; the factorization `G →* Pi v`
  freezes the Definition 4.9, (ii)-style identification of the abstract group
  with the strip group `Pi v`.
* Every orbit statement is proved with the existing `TimesMuKummer.Isomorphism`,
  `Ism` and `Orbit` objects of `Kummer/TimesMuIsm.lean`; no new orbit theory is
  introduced.
* `KappaOrbitUnitsActionPairDatum.layerKummer` is the canonical composite of
  the lower and upper representatives over a common group-theoretic module.
  Its identification with the paper's vertical Kummer arrow is NOT claimed
  here; that remains with the SHE consumption line.
* Canonical completion (gate-only, in the pattern of
  `Kummer/K1K2BoundaryReduction.lean`): from the factorization `g` alone
  the datum is inhabited by
  `KappaOrbitUnitsActionDatum.canonicalDatumOfFactorization` (strip units
  as the group-theoretic module, identity representative).  Thus the
  residual *interface* obligation of the actions sub-obligation is
  exactly the factorization `g`; the arithmetic identifications behind
  `g` and the arithmetic content of `kappa` are not discharged by the
  completion.
-/

namespace LeanFormal.IUT

universe uG uU uW vV

namespace TimesMuKummer.Isomorphism

variable {G : Type uG} [Group G] [TopologicalSpace G]
variable {U : Type uU} [CommGroup U] {W : Type uW} [CommGroup W]

/-- The `G`-action on the torsion quotient of `W` transported along a Kummer
isomorphism `kappa`, i.e. the conjugate `kappa o rho(-) o kappa^{-1}` of the
source action by `kappa`.  This is the "action given by a representative" of
the paper's `Ism`-orbit (IUT II, Definition 4.9, (i)). -/
noncomputable def transportedTargetAction
    {source : G →* MulAut U} {target : G →* MulAut W}
    (κ : Isomorphism source target) : G →* MulAut (TimesMuQuotient W) where
  toFun γ := MulAut.congr κ.equiv (TimesMuQuotient.action source γ)
  map_one' := by
    rw [(TimesMuQuotient.action source).map_one]
    exact (MulAut.congr κ.equiv).map_one
  map_mul' := fun γ δ => by
    rw [(TimesMuQuotient.action source).map_mul]
    exact (MulAut.congr κ.equiv).map_mul _ _

/-- Orbit-invariance in the strict form: every representative of the Kummer
isomorphism transports the source action to exactly the given target action.
This is the "isomorphism of `G`-modules" content of IUT II, Definition 4.9,
(i), read at one representative. -/
theorem transportedTargetAction_eq_action
    {source : G →* MulAut U} {target : G →* MulAut W}
    (κ : Isomorphism source target) :
    transportedTargetAction κ = TimesMuQuotient.action target := by
  apply MonoidHom.ext
  intro γ
  apply MulEquiv.ext
  intro x
  change κ.equiv (TimesMuQuotient.action source γ (κ.equiv.symm x)) =
    TimesMuQuotient.action target γ x
  rw [κ.equivariant γ (κ.equiv.symm x), MulEquiv.apply_symm_apply]

/-- Orbit-invariance in the `Ism` form: replacing a representative by any
`Ism`-multiple does not change the transported action.  Combined with
`transportedTargetAction_eq_action`, the action of `G` on the `x mu`-layer is
independent of the choice of representative; the representative difference
itself is an `Ism` (inner) element (see
`KappaOrbitUnitsActionDatum.representativeDifference_isKummerIsometry`). -/
theorem transportedTargetAction_smul_ism
    {source : G →* MulAut U} {target : G →* MulAut W}
    (κ : Isomorphism source target) (θ : Ism source) :
    transportedTargetAction (θ • κ) = transportedTargetAction κ := by
  rw [transportedTargetAction_eq_action, transportedTargetAction_eq_action]

end TimesMuKummer.Isomorphism

/-- The `x mu`-`Ism`-orbit source datum of IUT II, Definition 4.9, (i), in the
minimal usable form for the `G1-SRC-a` actions sub-obligation.

Fields, per place `v` (all frozen interface data of the source-input line):

* `sourceUnits v`: the carrier of the group-theoretic module `O^x(G)`; the
  group-theoretic algorithm itself is not constructed here.
* `sourceAction v`: the canonical `G`-action `G : O^x(G)` of that algorithm.
* `factor v`: the identification `G →* toDPrimeStrip.Pi v` of the abstract
  group with the strip group at `v` (Definition 4.9, (ii), there `Aut(A)` of a
  universal covering, isomorphic to `G_w`).
* `kappa v`: a representative of the `Ism`-orbit of `G`-equivariant
  isomorphisms `O^{x mu}(G) ~> O^{x mu}(A_v)` of ind-topological modules,
  encoded by the existing `TimesMuKummer.Isomorphism`: equivariance in the
  sense of `Kummer/TimesMuIsm.lean` plus the invariant-image law
  `kappa '' I_H(G) = I_H(A_v)` (the paper's `{I^kappa_H(A)}_H`, which
  completely determines the structure).

Nothing here asserts that such data exist; existence is exactly the remaining
arithmetic source obligation recorded for `G1-SRC-a`. -/
structure KappaOrbitUnitsActionDatum (G : Type uG) [Group G] [TopologicalSpace G]
    {V : Type vV} (upper : FPrimeStrip V) where
  /-- carrier of the group-theoretic module `O^x(G)` at `v` (frozen interface
  data; the group-theoretic algorithm itself is not constructed) -/
  sourceUnits : V → Type uU
  [commGroupSourceUnits : ∀ v, CommGroup (sourceUnits v)]
  /-- the canonical `G`-action `G : O^x(G)` of the group-theoretic algorithm -/
  sourceAction : ∀ v, G →* MulAut (sourceUnits v)
  /-- the identification of the abstract group with the strip's `Pi` at `v`
  (Definition 4.9, (ii), there `Aut(A)` of a universal covering) -/
  factor : ∀ v, G →* upper.toDPrimeStrip.Pi v
  /-- a representative of the `Ism`-orbit of `G`-equivariant isomorphisms
  `O^{x mu}(G) ~> O^{x mu}(A_v)`, with the invariant-image law
  `kappa '' I_H(G) = I_H(A_v)` (the paper's `{I^kappa_H(A)}_H`; Definition
  4.9, (i)) -/
  kappa : ∀ v, TimesMuKummer.Isomorphism (sourceAction v)
    ((upper.unitsAction v).comp (factor v))

attribute [instance] KappaOrbitUnitsActionDatum.commGroupSourceUnits

namespace KappaOrbitUnitsActionDatum

variable {G : Type uG} [Group G] [TopologicalSpace G]
variable {V : Type vV} {upper : FPrimeStrip V}

/-- The strip-level units action supplied by the datum at `v`, namely
`(F.unitsAction v).comp (g v)` for the factorization `g = D.factor`: the
consumer shape of the `G1-SRC-a` actions sub-obligation. -/
def suppliedUnitsAction (D : KappaOrbitUnitsActionDatum G upper) (v : V) :
    G →* MulAut ((upper.Mon v)ˣ) :=
  (upper.unitsAction v).comp (D.factor v)

/-- Apply law of `suppliedUnitsAction`. -/
theorem suppliedUnitsAction_apply (D : KappaOrbitUnitsActionDatum G upper)
    (v : V) (γ : G) (u : (upper.Mon v)ˣ) :
    D.suppliedUnitsAction v γ u = upper.unitsAction v (D.factor v γ) u := rfl

/-- Descent law: the induced action on the times-mu layer of the strip is the
strip's own times-mu action precomposed with the factorization. -/
theorem suppliedUnitsAction_descent (D : KappaOrbitUnitsActionDatum G upper)
    (v : V) :
    TimesMuQuotient.action (D.suppliedUnitsAction v) =
      (upper.timesMuAction v).comp (D.factor v) := rfl

/-- The representative `kappa_v` is an isomorphism of `G`-modules for the
supplied action: the action-agreement law connecting the source data to the
strip-level action. -/
theorem kappa_equivariant (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (γ : G) (x : TimesMuQuotient (D.sourceUnits v)) :
    (D.kappa v).equiv (TimesMuQuotient.action (D.sourceAction v) γ x) =
      TimesMuQuotient.action (D.suppliedUnitsAction v) γ ((D.kappa v).equiv x) :=
  (D.kappa v).equivariant γ x

/-- The invariant-image law `{I^kappa_H(A)}_H` of Definition 4.9, (i), read at
the supplied action. -/
theorem kappa_invariantImage (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (H : OpenSubgroup G) :
    (D.kappa v).equiv '' (TimesMuKummer.invariantImage (D.sourceAction v) H :
        Set (TimesMuQuotient (D.sourceUnits v))) =
      (TimesMuKummer.invariantImage (D.suppliedUnitsAction v) H :
        Set (TimesMuQuotient ((upper.Mon v)ˣ))) :=
  (D.kappa v).invariantImage H

/-- The transported action of the representative is the strip's times-mu
action of the factorization: `transportedTargetAction kappa =
timesMuAction o factor`. -/
theorem kappa_transports_action (D : KappaOrbitUnitsActionDatum G upper)
    (v : V) :
    TimesMuKummer.Isomorphism.transportedTargetAction (D.kappa v) =
      (upper.timesMuAction v).comp (D.factor v) :=
  TimesMuKummer.Isomorphism.transportedTargetAction_eq_action (D.kappa v)

/-- The `x mu`-Kummer structure determined by the datum at `v`: the `Ism`-orbit
of the representative. -/
noncomputable def structureOrbit (D : KappaOrbitUnitsActionDatum G upper)
    (v : V) :
    TimesMuKummer.Isomorphism.Orbit (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v)) :=
  TimesMuKummer.Isomorphism.orbitOf (D.kappa v)

/-- Any representative determines the same `x mu`-Kummer structure (`Ism`-orbit
uniqueness; the "completely determined by the `{I^kappa_H(A)}_H`" law of
Definition 4.9, (i)). -/
theorem representative_orbit_eq (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (κ : TimesMuKummer.Isomorphism (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v))) :
    TimesMuKummer.Isomorphism.orbitOf κ = D.structureOrbit v :=
  TimesMuKummer.Isomorphism.orbitOf_eq κ (D.kappa v)

/-- The difference automorphism relating two representatives of the same
orbit. -/
def representativeDifference (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (κ₁ κ₂ : TimesMuKummer.Isomorphism (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v))) :
    MulAut (TimesMuQuotient (D.sourceUnits v)) :=
  (TimesMuKummer.Isomorphism.sourceDifference κ₁ κ₂).1

/-- The representative difference is a `G`-isometry of the ind-topological
module: `G`-equivariant with every invariant-image lattice preserved, i.e. an
element of `Ism` (the "inner" subgroup) of IUT II, Example 1.8, (iv). -/
theorem representativeDifference_isKummerIsometry
    (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (κ₁ κ₂ : TimesMuKummer.Isomorphism (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v))) :
    TimesMuKummer.IsKummerIsometry (D.sourceAction v)
      (D.representativeDifference v κ₁ κ₂) :=
  (TimesMuKummer.Isomorphism.sourceDifference κ₁ κ₂).2

/-- First law of `representativeDifference_isKummerIsometry`: the
representative difference commutes with the source action. -/
theorem representativeDifference_equivariant
    (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (κ₁ κ₂ : TimesMuKummer.Isomorphism (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v))) :
    ∀ (γ : G) (x : TimesMuQuotient (D.sourceUnits v)),
      D.representativeDifference v κ₁ κ₂
          (TimesMuQuotient.action (D.sourceAction v) γ x) =
        TimesMuQuotient.action (D.sourceAction v) γ
          (D.representativeDifference v κ₁ κ₂ x) :=
  (D.representativeDifference_isKummerIsometry v κ₁ κ₂).1

/-- Second law of `representativeDifference_isKummerIsometry`: the
representative difference preserves every invariant-image lattice. -/
theorem representativeDifference_invariantImage
    (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (κ₁ κ₂ : TimesMuKummer.Isomorphism (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v))) (H : OpenSubgroup G) :
    D.representativeDifference v κ₁ κ₂ ''
        (TimesMuKummer.invariantImage (D.sourceAction v) H) =
      (TimesMuKummer.invariantImage (D.sourceAction v) H) :=
  (D.representativeDifference_isKummerIsometry v κ₁ κ₂).2 H

/-- The representative indeterminacy is exactly an `Ism`-multiple: the
difference element acts on the second representative to give the first (the
`Ism`-orbit action of `Kummer/TimesMuIsm.lean`). -/
theorem representativeDifference_smul_eq
    (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (κ₁ κ₂ : TimesMuKummer.Isomorphism (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v))) :
    TimesMuKummer.Isomorphism.sourceDifference κ₂ κ₁ • κ₂ = κ₁ :=
  TimesMuKummer.Isomorphism.sourceDifference_smul_first κ₂ κ₁

/-- Orbit-invariance of the action in the representative form: any two
representatives transport the source action to the same action of `G` on the
`x mu`-layer of the strip ("any representative gives the same action"; the
inner-sense difference is recorded in
`representativeDifference_isKummerIsometry`). -/
theorem representative_transport_eq
    (D : KappaOrbitUnitsActionDatum G upper) (v : V)
    (κ₁ κ₂ : TimesMuKummer.Isomorphism (D.sourceAction v)
      ((upper.unitsAction v).comp (D.factor v))) :
    TimesMuKummer.Isomorphism.transportedTargetAction κ₁ =
      TimesMuKummer.Isomorphism.transportedTargetAction κ₂ := by
  rw [TimesMuKummer.Isomorphism.transportedTargetAction_eq_action,
      TimesMuKummer.Isomorphism.transportedTargetAction_eq_action]

/-- Canonical completion of the source datum from the factorization alone.

Given an identification `factor v : G →* Pi v` of the abstract group with the
strip groups, the remaining fields of `KappaOrbitUnitsActionDatum` are
canonically inhabited by taking the units of the strip itself as the
group-theoretic module and the identity as the representative.  The completion
is gate-only in the pattern of `Kummer/K1K2BoundaryReduction.lean`: it shows
that the irreducible residual *interface* obligation of the `G1-SRC-a` actions
sub-obligation is exactly the factorization `g`, while carrying no arithmetic
comparison of a group-theoretic module `O^x(G)` with the Frobenioid `A`. -/
noncomputable def canonicalDatumOfFactorization
    (factor : ∀ v : V, G →* upper.toDPrimeStrip.Pi v) :
    KappaOrbitUnitsActionDatum G upper where
  sourceUnits := fun v => (upper.Mon v)ˣ
  commGroupSourceUnits := fun _ => inferInstance
  sourceAction := fun v => (upper.unitsAction v).comp (factor v)
  factor := factor
  kappa := fun v =>
    TimesMuKummer.Isomorphism.refl ((upper.unitsAction v).comp (factor v))

/-- The canonical completion supplies exactly the composed action
`(unitsAction v).comp (factor v)` at every place. -/
@[simp] theorem canonicalDatumOfFactorization_suppliedUnitsAction
    (factor : ∀ v : V, G →* upper.toDPrimeStrip.Pi v) (v : V) :
    (canonicalDatumOfFactorization factor).suppliedUnitsAction v =
      (upper.unitsAction v).comp (factor v) := rfl

end KappaOrbitUnitsActionDatum

/-- Two-strip form of the source datum over a common group-theoretic module:
the per-strip data of `KappaOrbitUnitsActionDatum` for an upper and a lower
strip, sharing `sourceUnits` and `sourceAction`.  This is the shape consumed
by the `SourceTimesMuKummerLayer` / `SourceEvaluationUnitPortion` slots
(upper -> lower). -/
structure KappaOrbitUnitsActionPairDatum (G : Type uG) [Group G]
    [TopologicalSpace G] {V : Type vV} (upper lower : FPrimeStrip V) where
  sourceUnits : V → Type uU
  [commGroupSourceUnits : ∀ v, CommGroup (sourceUnits v)]
  sourceAction : ∀ v, G →* MulAut (sourceUnits v)
  factorUpper : ∀ v, G →* upper.toDPrimeStrip.Pi v
  factorLower : ∀ v, G →* lower.toDPrimeStrip.Pi v
  kappaUpper : ∀ v, TimesMuKummer.Isomorphism (sourceAction v)
    ((upper.unitsAction v).comp (factorUpper v))
  kappaLower : ∀ v, TimesMuKummer.Isomorphism (sourceAction v)
    ((lower.unitsAction v).comp (factorLower v))

attribute [instance] KappaOrbitUnitsActionPairDatum.commGroupSourceUnits

namespace KappaOrbitUnitsActionPairDatum

variable {G : Type uG} [Group G] [TopologicalSpace G]
variable {V : Type vV} {upper lower : FPrimeStrip V}

/-- The upper-strip datum. -/
def toUpper (D : KappaOrbitUnitsActionPairDatum G upper lower) :
    KappaOrbitUnitsActionDatum G upper where
  sourceUnits := D.sourceUnits
  commGroupSourceUnits := D.commGroupSourceUnits
  sourceAction := D.sourceAction
  factor := D.factorUpper
  kappa := D.kappaUpper

/-- The lower-strip datum. -/
def toLower (D : KappaOrbitUnitsActionPairDatum G upper lower) :
    KappaOrbitUnitsActionDatum G lower where
  sourceUnits := D.sourceUnits
  commGroupSourceUnits := D.commGroupSourceUnits
  sourceAction := D.sourceAction
  factor := D.factorLower
  kappa := D.kappaLower

/-- The two-strip `x mu`-layer isomorphism assembled from the two
representatives over the common group-theoretic module, at each place: the
`kummer` slot shape of `SourceTimesMuKummerLayer` (upper -> lower).  Not
claimed here to be identified with the paper's vertical Kummer arrow. -/
def layerKummer (D : KappaOrbitUnitsActionPairDatum G upper lower) (v : V) :
    TimesMuKummer.Isomorphism (D.toUpper.suppliedUnitsAction v)
      (D.toLower.suppliedUnitsAction v) where
  equiv := (D.kappaUpper v).equiv.symm.trans (D.kappaLower v).equiv
  equivariant := by
    intro γ x
    rw [MulEquiv.trans_apply]
    change (D.kappaLower v).equiv ((D.kappaUpper v).equiv.symm
        (TimesMuQuotient.action ((upper.unitsAction v).comp (D.factorUpper v)) γ x)) =
      TimesMuQuotient.action ((lower.unitsAction v).comp (D.factorLower v)) γ
        ((D.kappaLower v).equiv ((D.kappaUpper v).equiv.symm x))
    have hsymm : (D.kappaUpper v).equiv.symm
        (TimesMuQuotient.action ((upper.unitsAction v).comp (D.factorUpper v)) γ x) =
        TimesMuQuotient.action (D.sourceAction v) γ
          ((D.kappaUpper v).equiv.symm x) := by
      have h := (D.kappaUpper v).equivariant γ ((D.kappaUpper v).equiv.symm x)
      rw [MulEquiv.apply_symm_apply] at h
      rw [← h, MulEquiv.symm_apply_apply]
    rw [hsymm]
    exact (D.kappaLower v).equivariant γ ((D.kappaUpper v).equiv.symm x)
  invariantImage := by
    intro H
    change ((D.kappaLower v).equiv ∘ (D.kappaUpper v).equiv.symm) ''
        (TimesMuKummer.invariantImage
          ((upper.unitsAction v).comp (D.factorUpper v)) H :
            Set (TimesMuQuotient ((upper.Mon v)ˣ))) =
      (TimesMuKummer.invariantImage
        ((lower.unitsAction v).comp (D.factorLower v)) H :
          Set (TimesMuQuotient ((lower.Mon v)ˣ)))
    rw [Set.image_comp, ← (D.kappaUpper v).invariantImage H]
    have hsymm : (D.kappaUpper v).equiv.symm ''
        ((D.kappaUpper v).equiv ''
          TimesMuKummer.invariantImage (D.sourceAction v) H) =
        TimesMuKummer.invariantImage (D.sourceAction v) H :=
      Equiv.symm_image_image (D.kappaUpper v).equiv.toEquiv _
    rw [hsymm]
    exact (D.kappaLower v).invariantImage H

end KappaOrbitUnitsActionPairDatum

end LeanFormal.IUT

namespace LeanFormal.IUT.Audit

/-- Source-side supply of the `G1-SRC-a` actions sub-obligation: the
`kappa^{x mu}`-`Ism`-orbit datum of IUT II, Definition 4.9, (i), the orbit
invariance laws for any representative, and the conditional bridge to the
strip-level actions and to the two-strip layer isomorphism. -/
def kappaOrbitUnitsActionSupply : Obligation :=
  { id := "IUT-II.kappa-orbit-units-action-supply"
    source :=
      "IUT II, Definition 4.9, (i), (ii), (viii); IUT II, Example 1.8, (iv); " ++
        "IUT III, Theorem 3.11, (ii)"
    status := VerificationStatus.interface
    note :=
      "CONDITIONAL source-side supply for the actions sub-obligation of " ++
        "G1-SRC-a. The datum freezes, per strip and place, the group-theoretic " ++
        "module O^x(G) with its G-action, the factorization G -> Pi v of " ++
        "Definition 4.9, (ii), and a representative of the Ism-orbit of " ++
        "equivariant invariant-image-preserving Kummer isomorphisms of " ++
        "Definition 4.9, (i). Proved: the transported-action laws " ++
        "(transportedTargetAction_eq_action, transportedTargetAction_smul_ism), " ++
        "the descent of the supplied units action, the kappa-equivariance and " ++
        "invariant-image laws at the supplied action, the representative " ++
        "difference laws (Ism element commuting with the source action and " ++
        "preserving every invariant-image lattice, acting by precomposition), " ++
        "the two-strip layer isomorphism layerKummer, and the canonical " ++
        "completion from a supplied factorization " ++
        "(canonicalDatumOfFactorization). NOT CLAIMED: " ++
        "existence of the factorization itself; the group-theoretic " ++
        "algorithm; the " ++
        "ind-topology beyond the topology of G; identification of layerKummer " ++
        "with the paper's vertical Kummer arrow."
    dependsOn :=
      [ "IUT-II.times-mu-torsion-quotient", "IUT-II.times-mu-ism-orbit" ] }

end LeanFormal.IUT.Audit

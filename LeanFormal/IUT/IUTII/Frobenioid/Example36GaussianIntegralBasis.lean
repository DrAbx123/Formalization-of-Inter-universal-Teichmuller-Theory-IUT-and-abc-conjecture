import Mathlib.NumberTheory.Zsqrtd.GaussianInt
import LeanFormal.IUT.IUTI.InitialTheta.ConcreteArithmeticExample
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.RingTheory.Finiteness.Basic

/-!
# Gaussian integral basis and the ring of integers of Q(i)

Task-122: explicit rank-2 integral basis {1, i} of the Gaussian integers, the
integrality of Z[i] over Z, and the actual ring-of-integers equivalence
NumberField.RingOfIntegers (AdjoinRoot (X^2+1)) ≃+* GaussianInt.

No card/refl: the equivalence is the IsIntegralClosure.equiv between two actual
integral closures of Z in the same field GaussianField.
-/

noncomputable section

namespace LeanFormal.IUT.IUTII.Frobenioid.Example36

open Polynomial

local instance gaussianIntegralBasisIrreducible :
    Fact (Irreducible (Polynomial.X ^ 2 - Polynomial.C (-1) : Polynomial ℚ)) :=
  Fact.mk (by
    apply X_pow_sub_C_irreducible_of_prime (p := 2) Nat.prime_two
    intro b hb
    have hnonneg : 0 ≤ b ^ 2 := sq_nonneg b
    rw [hb] at hnonneg
    exact (not_le_of_gt (neg_lt_zero.mpr zero_lt_one)) hnonneg)

/-- The actual AdjoinRoot root of X^2+1 in GaussianField. -/
def gaussianFieldSqrtNegOne : GaussianField :=
  AdjoinRoot.root gaussianPolynomial

theorem gaussianFieldSqrtNegOne_sq :
    gaussianFieldSqrtNegOne * gaussianFieldSqrtNegOne = -1 := by
  have h := root_X_pow_sub_C_pow (K := ℚ) 2 (-1)
  simpa [gaussianFieldSqrtNegOne, gaussianPolynomial, pow_two] using h

/-- The Gaussian integer sqrt(-1) as a root datum for Zsqrtd.lift. -/
def gaussianIntLiftRoot :
    { r : GaussianField // r * r = ((-1 : ℤ) : GaussianField) } :=
  ⟨gaussianFieldSqrtNegOne, by simpa using gaussianFieldSqrtNegOne_sq⟩

/-- The ring hom Z[i] -> GaussianField sending i to the chosen root of -1. -/
noncomputable def gaussianIntToGaussianField : GaussianInt →+* GaussianField :=
  Zsqrtd.lift gaussianIntLiftRoot

noncomputable instance gaussianFieldAlgebraGaussianInt :
    Algebra GaussianInt GaussianField :=
  gaussianIntToGaussianField.toAlgebra

theorem gaussianIntToGaussianField_sqrtd :
    gaussianIntToGaussianField Zsqrtd.sqrtd = gaussianFieldSqrtNegOne := by
  simp [gaussianIntToGaussianField, gaussianIntLiftRoot, Zsqrtd.lift_apply_apply]

theorem algebraMap_gaussianInt_sqrtd :
    algebraMap GaussianInt GaussianField (Zsqrtd.sqrtd (d := -1)) =
      gaussianFieldSqrtNegOne := by
  change gaussianIntToGaussianField (Zsqrtd.sqrtd (d := -1)) = gaussianFieldSqrtNegOne
  exact gaussianIntToGaussianField_sqrtd

/-! ## 1. Explicit Z-basis {1, i} and module finiteness -/

/-- Every Gaussian integer is x.re + sqrt(-1) * x.im, so {1, sqrt(-1)} spans
Z[i] as a Z-module. -/
theorem gaussianInt_span_one_sqrtd :
    Submodule.span ℤ ({1, Zsqrtd.sqrtd} : Set GaussianInt) = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro x
  have hx : x = ((x.re : ℤ) : GaussianInt) +
      Zsqrtd.sqrtd * ((x.im : ℤ) : GaussianInt) := by
    conv_lhs => rw [show x = (⟨x.re, x.im⟩ : GaussianInt) from rfl]
    rw [Zsqrtd.decompose]
  rw [hx]
  refine Submodule.add_mem _ ?_ ?_
  · have h : ((x.re : ℤ) : GaussianInt) = (x.re : ℤ) • (1 : GaussianInt) := by simp
    rw [h]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
  · have h : Zsqrtd.sqrtd * ((x.im : ℤ) : GaussianInt) =
        (x.im : ℤ) • Zsqrtd.sqrtd := by
      rw [mul_comm, zsmul_eq_mul]
    rw [h]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

/-- Z[i] is a finite Z-module (rank two, generated by 1 and sqrt(-1)). -/
instance gaussianIntModuleFinite : Module.Finite ℤ GaussianInt :=
  ⟨by
    rw [← gaussianInt_span_one_sqrtd]
    exact Submodule.fg_span (Set.toFinite _)⟩

/-- Z[i] is integral over Z, from the finite module structure. -/
instance gaussianIntAlgebraIntegral : Algebra.IsIntegral ℤ GaussianInt :=
  ⟨fun x => IsIntegral.of_finite ℤ x⟩

/-- Z[i] is integrally closed (it is a Euclidean domain, hence a UFD). -/
instance gaussianIntIsIntegrallyClosed : IsIntegrallyClosed GaussianInt :=
  inferInstance


/-- Injectivity of the Gaussian-integer embedding into GaussianField. This is the
algebraMap_injective input for the integral-closure structure. -/
theorem gaussianIntToGaussianField_injective :
    Function.Injective gaussianIntToGaussianField := by
  refine Zsqrtd.lift_injective gaussianIntLiftRoot ?_
  intro n hn
  have hnonneg : (0 : ℤ) ≤ n * n := mul_self_nonneg n
  omega


/-- The polynomial X^2+1 is monic over Q. -/
theorem gaussianPolynomial_monic : gaussianPolynomial.Monic := by
  simpa [gaussianPolynomial] using
    (monic_X_pow_sub_C (-1 : ℚ) (by norm_num : (2 : ℕ) ≠ 0))

/-- Every element of GaussianField is a Q-linear combination of 1 and the
AdjoinRoot root, with explicit rational coefficients. This is the coefficient
extraction used for the IsFractionRing construction. -/
theorem gaussianField_eq_linear_combination (z : GaussianField) :
    ∃ a b : ℚ, z = algebraMap ℚ GaussianField a +
      algebraMap ℚ GaussianField b * gaussianFieldSqrtNegOne := by
  let g := gaussianPolynomial
  have hg : g.Monic := gaussianPolynomial_monic
  have hgne : g ≠ 1 := by
    intro h
    have hdeg : g.natDegree = 2 := by
      simpa [g, gaussianPolynomial] using
        (natDegree_X_pow_sub_C (n := 2) (r := (-1 : ℚ)))
    rw [h, natDegree_one] at hdeg
    omega
  obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective (g := g) z
  let p : ℚ[X] := AdjoinRoot.modByMonicHom hg (AdjoinRoot.mk g q)
  have hp_eq : p = q %ₘ g := by
    simp [p, AdjoinRoot.modByMonicHom_mk]
  have hpdeg : p.natDegree < 2 := by
    rw [hp_eq]
    have hlt := natDegree_modByMonic_lt q hg hgne
    rwa [show g.natDegree = 2 by
      simpa [g, gaussianPolynomial] using
        (natDegree_X_pow_sub_C (n := 2) (r := (-1 : ℚ)))] at hlt
  have hp : p = C (p.coeff 0) + C (p.coeff 1) * X := by
    conv_lhs => rw [p.as_sum_range_C_mul_X_pow' hpdeg]
    simp [Finset.sum_range_succ, pow_one]
  have hmk : AdjoinRoot.mk g p = AdjoinRoot.mk g q :=
    AdjoinRoot.mk_leftInverse hg (AdjoinRoot.mk g q)
  have hmp : AdjoinRoot.mk g p =
      algebraMap ℚ GaussianField (p.coeff 0) +
        algebraMap ℚ GaussianField (p.coeff 1) * gaussianFieldSqrtNegOne := by
    conv_lhs => rw [hp]
    change (AdjoinRoot.mk g) (C (p.coeff 0) + C (p.coeff 1) * X) = _
    rw [map_add, map_mul, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
    rfl
  refine ⟨p.coeff 0, p.coeff 1, ?_⟩
  exact hmk.symm.trans hmp



/-- Every element of GaussianField is a fraction m1/d + (m2/d)*root with a
common nonzero integer denominator d. -/
theorem gaussianField_fraction_form (z : GaussianField) :
    ∃ (m1 m2 d : ℤ), d ≠ 0 ∧ z * (d : GaussianField) =
      (m1 : GaussianField) + (m2 : GaussianField) * gaussianFieldSqrtNegOne := by
  obtain ⟨a, b, hz⟩ := gaussianField_eq_linear_combination z
  refine ⟨a.num * (b.den : ℤ), b.num * (a.den : ℤ),
    (a.den : ℤ) * (b.den : ℤ), ?_, ?_⟩
  · have ha : (a.den : ℤ) ≠ 0 := by exact_mod_cast a.den_nz
    have hb : (b.den : ℤ) ≠ 0 := by exact_mod_cast b.den_nz
    exact mul_ne_zero ha hb
  · have hda : (a.den : ℤ) ≠ 0 := by exact_mod_cast a.den_nz
    have hdb : (b.den : ℤ) ≠ 0 := by exact_mod_cast b.den_nz
    have hd : ((a.den : ℤ) * (b.den : ℤ) : ℤ) ≠ 0 := mul_ne_zero hda hdb
    have hdQ : (((a.den : ℤ) * (b.den : ℤ) : ℤ) : ℚ) ≠ 0 := by
      exact_mod_cast hd
    have hdK : algebraMap ℚ GaussianField
        (((a.den : ℤ) * (b.den : ℤ) : ℤ) : ℚ) ≠ 0 := by
      intro h
      apply hdQ
      exact (algebraMap ℚ GaussianField).injective (by simpa using h)
    have ha : (a : ℚ) = ((a.num * (b.den : ℤ) : ℤ) : ℚ) /
        (((a.den : ℤ) * (b.den : ℤ) : ℤ) : ℚ) := by
      conv_lhs => rw [← Rat.num_divInt_den a]
      rw [Rat.divInt_eq_div]
      push_cast
      field_simp [show (a.den : ℚ) ≠ 0 by exact_mod_cast a.den_nz,
        show (b.den : ℚ) ≠ 0 by exact_mod_cast b.den_nz]
    have hb : (b : ℚ) = ((b.num * (a.den : ℤ) : ℤ) : ℚ) /
        (((a.den : ℤ) * (b.den : ℤ) : ℤ) : ℚ) := by
      conv_lhs => rw [← Rat.num_divInt_den b]
      rw [Rat.divInt_eq_div]
      push_cast
      field_simp [show (a.den : ℚ) ≠ 0 by exact_mod_cast a.den_nz,
        show (b.den : ℚ) ≠ 0 by exact_mod_cast b.den_nz]
    have haK : algebraMap ℚ GaussianField a =
        algebraMap ℚ GaussianField (((a.num * (b.den : ℤ) : ℤ) : ℚ)) /
          algebraMap ℚ GaussianField ((((a.den : ℤ) * (b.den : ℤ) : ℤ) : ℚ)) := by
      have h := congrArg (algebraMap ℚ GaussianField) ha
      simpa [map_div₀] using h
    have hbK : algebraMap ℚ GaussianField b =
        algebraMap ℚ GaussianField (((b.num * (a.den : ℤ) : ℤ) : ℚ)) /
          algebraMap ℚ GaussianField ((((a.den : ℤ) * (b.den : ℤ) : ℤ) : ℚ)) := by
      have h := congrArg (algebraMap ℚ GaussianField) hb
      simpa [map_div₀] using h
    rw [hz]
    rw [haK, hbK]
    field_simp [hdK]
    ac_rfl

/-- The Gaussian integers are the fraction ring of the Gaussian field. -/
noncomputable instance gaussianIntIsFractionRing :
    IsFractionRing GaussianInt GaussianField where
  map_units := by
    rintro ⟨x, hx⟩
    rw [mem_nonZeroDivisors_iff_ne_zero] at hx
    change IsUnit (gaussianIntToGaussianField (x : GaussianInt))
    rw [isUnit_iff_ne_zero]
    intro hzero
    apply hx
    apply gaussianIntToGaussianField_injective
    simpa using hzero
  surj := by
    intro z
    obtain ⟨m1, m2, d, hd, hz⟩ := gaussianField_fraction_form z
    refine ⟨((⟨m1, m2⟩ : GaussianInt),
      ⟨d, mem_nonZeroDivisors_iff_ne_zero.mpr (by exact_mod_cast hd)⟩), ?_⟩
    change z * gaussianIntToGaussianField ((d : ℤ) : GaussianInt) =
      gaussianIntToGaussianField (⟨m1, m2⟩ : GaussianInt)
    have hphi_d : gaussianIntToGaussianField ((d : ℤ) : GaussianInt) =
        ((d : ℤ) : GaussianField) := by
      simp [gaussianIntToGaussianField, gaussianIntLiftRoot,
        Zsqrtd.lift_apply_apply]
    have hphi_m : gaussianIntToGaussianField (⟨m1, m2⟩ : GaussianInt) =
        (m1 : GaussianField) + (m2 : GaussianField) * gaussianFieldSqrtNegOne := by
      simp [gaussianIntToGaussianField, gaussianIntLiftRoot,
        Zsqrtd.lift_apply_apply]
    rw [hphi_d, hphi_m]
    simpa using hz
  exists_of_eq := by
    intro x y hxy
    refine ⟨1, ?_⟩
    have h : x = y := gaussianIntToGaussianField_injective (by
      change gaussianIntToGaussianField x = gaussianIntToGaussianField y at hxy
      exact hxy)
    simp [h]

/-- The scalar tower Z -> Z[i] -> GaussianField. -/
instance gaussianFieldScalarTower : IsScalarTower ℤ GaussianInt GaussianField := by
  refine IsScalarTower.of_algebraMap_eq ?_
  intro n
  simp [gaussianFieldAlgebraGaussianInt, RingHom.toAlgebra, gaussianIntToGaussianField]

/-- Z[i] is the integral closure of Z in GaussianField. -/
noncomputable instance gaussianIntIsIntegralClosure :
    IsIntegralClosure GaussianInt ℤ GaussianField :=
  IsIntegralClosure.of_isIntegrallyClosed GaussianInt ℤ GaussianField

/-- The actual ring-of-integers equivalence. -/
noncomputable def gaussianRingOfIntegersEquivGaussianInt :
    NumberField.RingOfIntegers GaussianField ≃+* GaussianInt :=
  (IsIntegralClosure.equiv (R := ℤ) (B := GaussianField)
    (A := NumberField.RingOfIntegers GaussianField) (A' := GaussianInt)).toRingEquiv

/-- Compatibility of the equivalence with the embeddings into GaussianField. -/
theorem gaussianRingOfIntegersEquivGaussianInt_algebraMap
    (x : NumberField.RingOfIntegers GaussianField) :
    algebraMap GaussianInt GaussianField (gaussianRingOfIntegersEquivGaussianInt x) =
      algebraMap (NumberField.RingOfIntegers GaussianField) GaussianField x :=
  IsIntegralClosure.algebraMap_equiv (R := ℤ) (B := GaussianField)
    (A := NumberField.RingOfIntegers GaussianField) (A' := GaussianInt) x

theorem gaussianFieldSqrtNegOne_integral : IsIntegral ℤ gaussianFieldSqrtNegOne := by
  have h := IsIntegral.map (IsScalarTower.toAlgHom ℤ GaussianInt GaussianField)
    (IsIntegral.of_finite ℤ (Zsqrtd.sqrtd (d := -1)))
  simpa [algebraMap_gaussianInt_sqrtd] using h

/-- The integral element corresponding to the root of -1. -/
def gaussianIntegralRoot : NumberField.RingOfIntegers GaussianField :=
  IsIntegralClosure.mk' (NumberField.RingOfIntegers GaussianField)
    gaussianFieldSqrtNegOne gaussianFieldSqrtNegOne_integral

/-- Generator compatibility: the integral root of -1 is sent to i = sqrt(-1). -/
theorem gaussianRingOfIntegersEquivGaussianInt_generator :
    gaussianRingOfIntegersEquivGaussianInt gaussianIntegralRoot =
      Zsqrtd.sqrtd (d := -1) := by
  apply IsIntegralClosure.algebraMap_injective GaussianInt ℤ GaussianField
  rw [gaussianRingOfIntegersEquivGaussianInt_algebraMap]
  unfold gaussianIntegralRoot
  rw [IsIntegralClosure.algebraMap_mk']
  exact algebraMap_gaussianInt_sqrtd.symm

/-! ## 2. The equivalence in the GaussianInt -> ring-of-integers direction

The arithmetic split-place file needs the equivalence in the direction
`GaussianInt -> RingOfIntegers (AdjoinRoot (X^2+1))` (the direction of the
residue computation), together with its mutual-inverse and `algebraMap`
compatibility laws.  These are the same integral-closure equivalence, read in
the other direction. -/

/-- The AdjoinRoot model of the Gaussian field is the polynomial `X^2 + 1`. -/
theorem gaussianPolynomial_eq_X_sq_add_one :
    gaussianPolynomial = Polynomial.X ^ 2 + 1 := by
  simp [gaussianPolynomial]

/-- The actual ring-of-integers equivalence in the direction
`GaussianInt -> RingOfIntegers (AdjoinRoot (X^2+1))`. -/
noncomputable def gaussianIntEquivRingOfIntegers :
    GaussianInt ≃+* NumberField.RingOfIntegers GaussianField :=
  gaussianRingOfIntegersEquivGaussianInt.symm

/-- The inverse of `gaussianIntEquivRingOfIntegers` is the integral-closure
equivalence of section 1. -/
@[simp] theorem gaussianIntEquivRingOfIntegers_symm :
    gaussianIntEquivRingOfIntegers.symm = gaussianRingOfIntegersEquivGaussianInt :=
  rfl

/-- First inverse law: mapping `i` up to the ring of integers and back is the
identity. -/
@[simp] theorem gaussianIntEquivRingOfIntegers_apply_symm_apply
    (x : NumberField.RingOfIntegers GaussianField) :
    gaussianIntEquivRingOfIntegers
        (gaussianRingOfIntegersEquivGaussianInt x) = x :=
  RingEquiv.symm_apply_apply gaussianRingOfIntegersEquivGaussianInt x

/-- Second inverse law: mapping an integral element down to `GaussianInt` and
back is the identity. -/
@[simp] theorem gaussianRingOfIntegersEquivGaussianInt_apply_symm_apply
    (x : GaussianInt) :
    gaussianRingOfIntegersEquivGaussianInt
        (gaussianIntEquivRingOfIntegers x) = x :=
  RingEquiv.apply_symm_apply gaussianRingOfIntegersEquivGaussianInt x

/-- The direction-reversed equivalence is compatible with the two embeddings
into the Gaussian field: the `GaussianInt`-algebra map of `x` is the
ring-of-integers algebra map of its image. -/
theorem gaussianIntEquivRingOfIntegers_algebraMap (x : GaussianInt) :
    algebraMap GaussianInt GaussianField x =
      algebraMap (NumberField.RingOfIntegers GaussianField) GaussianField
        (gaussianIntEquivRingOfIntegers x) := by
  obtain ⟨y, rfl⟩ := gaussianRingOfIntegersEquivGaussianInt.surjective x
  simp [gaussianIntEquivRingOfIntegers,
    gaussianRingOfIntegersEquivGaussianInt_algebraMap]

/-- The chosen generator `i` of `GaussianInt` is sent to the integral root of
`-1` in `RingOfIntegers GaussianField`. -/
theorem gaussianIntEquivRingOfIntegers_sqrtd :
    gaussianIntEquivRingOfIntegers (Zsqrtd.sqrtd (d := -1)) =
      gaussianIntegralRoot := by
  rw [gaussianIntEquivRingOfIntegers, RingEquiv.symm_apply_eq,
    gaussianRingOfIntegersEquivGaussianInt_generator]

end LeanFormal.IUT.IUTII.Frobenioid.Example36
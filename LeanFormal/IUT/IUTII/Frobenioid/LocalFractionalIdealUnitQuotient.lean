import Mathlib.RingTheory.ClassGroup.Basic
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Local unit quotients and actual fractional ideals

The nonarchimedean local dictionary in IUT III, Example 3.6: a local
trivialization modulo integral units determines a nonzero fractional ideal.
The ideal is Mathlib's actual fractional ideal, not a degree-only carrier.

The quotient identification requires a principal ideal domain. The kernel
and elementary-morphism integrality criterion hold for any integral domain
with the indicated fraction field. This file does not construct the global
torsor category, archimedean factors, or the Hodge-theater source objects.
-/

noncomputable section

open scoped nonZeroDivisors

namespace LeanFormal.IUT.LocalFractionalIdealUnitQuotient

variable (R K : Type*) [CommRing R] [IsDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]

/-- Integral units inside the multiplicative group of the actual fraction field. -/
def integralUnitImage : Subgroup Kˣ :=
  (Units.map (algebraMap R K).toMonoidHom).range

/-- Two generators define the same ideal precisely up to integral units. -/
theorem principalIdeal_ker_eq_integralUnitImage :
    (toPrincipalIdeal R K).ker = integralUnitImage R K := by
  ext x
  change toPrincipalIdeal R K x = 1 ↔
    ∃ u : Rˣ, Units.map (algebraMap R K).toMonoidHom u = x
  constructor
  · intro hx
    have hspan : FractionalIdeal.spanSingleton R⁰ (1 : K) =
        FractionalIdeal.spanSingleton R⁰ (x : K) := by
      simpa using congrArg (fun I : (FractionalIdeal R⁰ K)ˣ => (I : FractionalIdeal R⁰ K))
        hx.symm
    obtain ⟨u, hu⟩ := FractionalIdeal.spanSingleton_eq_spanSingleton.mp hspan
    change (u : R) • (1 : K) = (x : K) at hu
    exact ⟨u, Units.ext (by simpa [Algebra.smul_def] using hu)⟩
  · rintro ⟨u, rfl⟩
    apply Units.ext
    simp only [coe_toPrincipalIdeal, Units.val_one]
    have hspan : FractionalIdeal.spanSingleton R⁰ (1 : K) =
        FractionalIdeal.spanSingleton R⁰
          (Units.map (algebraMap R K).toMonoidHom u : K) :=
      FractionalIdeal.spanSingleton_eq_spanSingleton.mpr
        ⟨u, by
          change (u : R) • (1 : K) = algebraMap R K (u : R)
          simp [Algebra.smul_def]⟩
    simpa using hspan.symm

/-- Over a PID every invertible fractional ideal is generated by a nonzero field element. -/
theorem principalIdeal_surjective [IsPrincipalIdealRing R] :
    Function.Surjective (toPrincipalIdeal R K) := by
  intro I
  obtain ⟨x, hx⟩ :=
    (FractionalIdeal.isPrincipal_iff (I : FractionalIdeal R⁰ K)).mp inferInstance
  have hxn : x ≠ 0 := by
    intro hzero
    apply I.ne_zero
    rw [hx, hzero, FractionalIdeal.spanSingleton_zero]
  refine ⟨Units.mk0 x hxn, Units.ext ?_⟩
  simpa using hx.symm

/-- The actual local value-group quotient is the group of fractional ideals. -/
def localUnitQuotientEquivFractionalIdeals [IsPrincipalIdealRing R] :
    Kˣ ⧸ integralUnitImage R K ≃* (FractionalIdeal R⁰ K)ˣ :=
  (QuotientGroup.quotientMulEquivOfEq
    (principalIdeal_ker_eq_integralUnitImage R K).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (toPrincipalIdeal R K)
      (principalIdeal_surjective R K))

@[simp]
theorem localUnitQuotientEquivFractionalIdeals_mk [IsPrincipalIdealRing R] (x : Kˣ) :
    localUnitQuotientEquivFractionalIdeals R K (QuotientGroup.mk x) =
      toPrincipalIdeal R K x := rfl

/-- Equality of actual ideals gives a unique integral unit relating their generators. -/
theorem principalIdeal_eq_iff_existsUnique_integralUnit (x y : Kˣ) :
    toPrincipalIdeal R K x = toPrincipalIdeal R K y ↔
      ∃! u : Rˣ, Units.map (algebraMap R K).toMonoidHom u * x = y := by
  constructor
  · intro hxy
    have hspan : FractionalIdeal.spanSingleton R⁰ (x : K) =
        FractionalIdeal.spanSingleton R⁰ (y : K) := by
      simpa using congrArg (fun I : (FractionalIdeal R⁰ K)ˣ => (I : FractionalIdeal R⁰ K)) hxy
    obtain ⟨u, hu⟩ := FractionalIdeal.spanSingleton_eq_spanSingleton.mp hspan
    change (u : R) • (x : K) = (y : K) at hu
    have hunit : Units.map (algebraMap R K).toMonoidHom u * x = y :=
      Units.ext (by simpa [Algebra.smul_def] using hu)
    refine ⟨u, hunit, ?_⟩
    intro w hw
    have hmap := mul_right_cancel (hw.trans hunit.symm)
    apply Units.ext
    apply IsFractionRing.injective R K
    exact congrArg (fun z : Kˣ => (z : K)) hmap
  · rintro ⟨u, hu, _⟩
    apply Units.ext
    simp only [coe_toPrincipalIdeal]
    apply FractionalIdeal.spanSingleton_eq_spanSingleton.mpr
    refine ⟨u, ?_⟩
    change (u : R) • (x : K) = (y : K)
    simpa [Algebra.smul_def] using congrArg (fun z : Kˣ => (z : K)) hu

/-- The actual set of generators of a fixed invertible fractional ideal. -/
def Generators (I : (FractionalIdeal R⁰ K)ˣ) :=
  {x : Kˣ // toPrincipalIdeal R K x = I}

theorem generators_nonempty [IsPrincipalIdealRing R] (I : (FractionalIdeal R⁰ K)ˣ) :
    Nonempty (Generators R K I) := by
  obtain ⟨x, hx⟩ := principalIdeal_surjective R K I
  exact ⟨⟨x, hx⟩⟩

/-- Integral units act on genuine generators, with no supplied torsor law. -/
def integralUnitMulGenerator {I : (FractionalIdeal R⁰ K)ˣ}
    (x : Generators R K I) (u : Rˣ) : Generators R K I := by
  refine ⟨Units.map (algebraMap R K).toMonoidHom u * x.val, ?_⟩
  have hu : Units.map (algebraMap R K).toMonoidHom u ∈ (toPrincipalIdeal R K).ker := by
    rw [principalIdeal_ker_eq_integralUnitImage]
    exact ⟨u, rfl⟩
  change toPrincipalIdeal R K (Units.map (algebraMap R K).toMonoidHom u) = 1 at hu
  rw [map_mul, hu, one_mul, x.property]

/-- Each generator supplies a chart identifying its entire generator torsor with integral units. -/
def generatorChart {I : (FractionalIdeal R⁰ K)ˣ} (x : Generators R K I) :
    Rˣ ≃ Generators R K I :=
  Equiv.ofBijective (integralUnitMulGenerator R K x) (by
    constructor
    · intro u w h
      have hm : Units.map (algebraMap R K).toMonoidHom u * x.val =
          Units.map (algebraMap R K).toMonoidHom w * x.val := congrArg Subtype.val h
      apply Units.ext
      apply IsFractionRing.injective R K
      exact congrArg (fun z : Kˣ => (z : K)) (mul_right_cancel hm)
    · intro y
      obtain ⟨u, hu, _⟩ :=
        (principalIdeal_eq_iff_existsUnique_integralUnit R K x.val y.val).mp
          (x.property.trans y.property.symm)
      exact ⟨u, Subtype.ext hu⟩)

@[simp]
theorem generatorChart_apply {I : (FractionalIdeal R⁰ K)ˣ}
    (x : Generators R K I) (u : Rˣ) :
    (generatorChart R K x u).val =
      Units.map (algebraMap R K).toMonoidHom u * x.val := rfl

omit [IsDomain R] in
/-- Integral elementary arrows are exactly inclusions of their actual local ideals. -/
theorem principalIdeal_le_iff_div_mem_integralImage (x y : Kˣ) :
    (toPrincipalIdeal R K x : FractionalIdeal R⁰ K) ≤
        (toPrincipalIdeal R K y : FractionalIdeal R⁰ K) ↔
      (x : K) / (y : K) ∈ (algebraMap R K).range := by
  simp only [coe_toPrincipalIdeal, FractionalIdeal.spanSingleton_le_iff_mem,
    FractionalIdeal.mem_spanSingleton]
  change (∃ r : R, r • (y : K) = (x : K)) ↔
    ∃ r : R, algebraMap R K r = (x : K) / (y : K)
  constructor
  · rintro ⟨r, hr⟩
    exact ⟨r, (eq_div_iff (Units.ne_zero y)).mpr (by
      simpa [Algebra.smul_def] using hr)⟩
  · rintro ⟨r, hr⟩
    exact ⟨r, by simpa [Algebra.smul_def] using
      (eq_div_iff (Units.ne_zero y)).mp hr⟩

omit [IsDomain R] in
/-- The positive-degree morphism condition of Example 3.6 on local generators.
It also holds for degree zero; the Frobenioid category uses positive degrees. -/
theorem principalIdeal_morphism_iff (f x y : Kˣ) (n : ℕ) :
    (toPrincipalIdeal R K f : FractionalIdeal R⁰ K) *
        (toPrincipalIdeal R K x : FractionalIdeal R⁰ K) ^ n ≤
        (toPrincipalIdeal R K y : FractionalIdeal R⁰ K) ↔
      ((f : K) * (x : K) ^ n) / (y : K) ∈ (algebraMap R K).range := by
  simpa using principalIdeal_le_iff_div_mem_integralImage R K (f * x ^ n) y

omit [IsDomain R] in
/-- Actual ideal morphisms compose with the Frobenioid rule `(n,f);(m,g) = (nm,g*f^m)`. -/
theorem fractionalIdeal_morphism_comp
    (I J H : (FractionalIdeal R⁰ K)ˣ) (f g : Kˣ) (n m : ℕ)
    (hf : (toPrincipalIdeal R K f : FractionalIdeal R⁰ K) *
      (I : FractionalIdeal R⁰ K) ^ n ≤ (J : FractionalIdeal R⁰ K))
    (hg : (toPrincipalIdeal R K g : FractionalIdeal R⁰ K) *
      (J : FractionalIdeal R⁰ K) ^ m ≤ (H : FractionalIdeal R⁰ K)) :
    (toPrincipalIdeal R K (g * f ^ m) : FractionalIdeal R⁰ K) *
      (I : FractionalIdeal R⁰ K) ^ (n * m) ≤ (H : FractionalIdeal R⁰ K) := by
  calc
    _ = (toPrincipalIdeal R K g : FractionalIdeal R⁰ K) *
        ((toPrincipalIdeal R K f : FractionalIdeal R⁰ K) *
          (I : FractionalIdeal R⁰ K) ^ n) ^ m := by
      simp only [map_mul, map_pow, Units.val_mul, Units.val_pow_eq_pow_val,
        mul_pow, pow_mul, mul_assoc]
    _ ≤ (toPrincipalIdeal R K g : FractionalIdeal R⁰ K) *
        (J : FractionalIdeal R⁰ K) ^ m := mul_le_mul_right (pow_le_pow_left' hf m) _
    _ ≤ _ := hg

end LeanFormal.IUT.LocalFractionalIdealUnitQuotient

  "new_or_materially_updated_findings": [
    {
      "id": "spectral_vs_integer_order",
      "section": "2.1",
      "finding": "c_norm is defined by normalized norm. New thetaMWeight algebra is not a proof of the correct arithmetic normalization."
    },
    {
      "id": "height_normalization",
      "section": "2.2",
      "finding": "Mathlib number-field logHeight is an unnormalized place sum while discOver/truncConductor are normalized; consumers require coherent conversion."
    },
    {
      "id": "singleton_projective_height",
      "section": "2.3 / 8.4",
      "finding": "F4 hDivP is Height.logHeight of a Unit-indexed tuple; Mathlib logHeight_eq_zero_of_subsingleton applies. Use actual local Weil functions and a multi-section construction."
    },
    {
      "id": "ceiling_direction",
      "section": "3",
      "finding": "The existing lower bound is -Sceil<=theta; ceil>=root does not establish the needed Sceil<=M. Three distinct routes are provided."
    },
    {
      "id": "union_vs_average",
      "section": "4",
      "finding": "Current nonzero-label union hull is not identified with a procession average; hHpkt in terminal is reflexive expansion, not theta transport."
    },
    {
      "id": "packet_selected_place",
      "section": "4.1",
      "finding": "PacketActualInstance upper-bound conclusion uses urActualB T rather than arbitrary parameter b."
    },
    {
      "id": "primorial_vs_support",
      "section": "4.4",
      "finding": "An upper bound for actual bad-prime product does not upper-bound the whole primorial through max bad prime. Grouping by p yields sum_{b|p,bad} w_b<=1 and a direct weighted prime-support bound; replace the extra total-weight times primorial bound in the intermediate consumer."
    },
    {
      "id": "certificate_equality",
      "section": "4.5",
      "finding": "S2953 additionally asks for equality of CTheta with theta/M. The weaker existing consumer avoids this unnecessary equality."
    },
    {
      "id": "protected_points_cover",
      "section": "6",
      "finding": "Fixed rational T/full affine chart RRData does not realize general protected points. Section-dependent open cover and rational map recursion are needed."
    },
    {
      "id": "projective_distance",
      "section": "7.2",
      "finding": "Nonconstant actual map with poles cannot be supplied as a global continuous affine-coordinate function; use P1-valued maps and scale-invariant boundary distance."
    },
    {
      "id": "uniform_different_bound",
      "section": "7.1",
      "finding": "m<=d does not imply m*v_p(m)<=d*v_p(d); use a finite maximum or a monotone coarse bound."
    },
    {
      "id": "same_field_height_route",
      "section": "8.1",
      "finding": "Apply normalized D1 on point field L and use arithmetic extension comparison in R3, pruning unnecessary general geometric different-transport tasks."
    }
  ],
